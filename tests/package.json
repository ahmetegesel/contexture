{
  "name": "contexture-tests",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "test": "vitest run",
    "test:harness": "vitest run --project harness",
    "test:drivers": "vitest run --project drivers",
    "test:storage-fts5": "vitest run --project storage-fts5",
    "test:drivers:posix": "VITEST_DRIVERS=posix vitest run --project drivers",
    "test:unit-record": "vitest run --project unit-record",
    "test:unit-verbs": "vitest run --project unit-verbs",
    "test:unit": "vitest run --project 'unit-*'",
    "test:governance": "vitest run --project governance",
    "test:filters": "vitest run --project filters",
    "test:toolchain-filters": "vitest run --project toolchain-filters",
    "test:docs-discipline": "vitest run --project docs-discipline",
    "test:ast-doc-graph": "vitest run --project ast-doc-graph",
    "test:engine": "vitest run --project engine",
    "test:hooks": "vitest run --project hooks",
    "test:laws": "vitest run --project laws",
    "test:packages": "vitest run --project packages",
    "test:base": "vitest run --project base",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
