{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@support/*": ["./support/*"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "../plugins/*/tests/**/*.ts"],
  "exclude": ["node_modules"]
}
