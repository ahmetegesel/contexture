#!/bin/sh
# drivers/fts5: the SQLite FTS5 storage driver (contract 2, docs/the-engine.md, The storage
# contract). One sh entry point over the sqlite3 command line: the store is one database at
# schema version 4 (schema.sql, the typed tables of the record data model holding the fields
# the functions write, no stored text; db-init.sh opens it, lays the schema in a new or empty
# file, and refuses a store at any other schema), and every one of the 38 record functions
# answers natively in SQL, one script per function under sql/fn/ over the shared pieces of
# sql/lib/ (the call prelude and the payload, the refusal point, the derived fields and the
# JSON of the schemas), beside the search tables derive.sql rebuilds in the transaction of
# every write. No function reads markdown or reaches another driver; the store holds only
# what the functions write, and every read renders it in the canonical layout.
#
# The wire: argv carries the function and its bounded identifiers, checked here with the
# posix driver's messages in its refusal order (the argv shape, the unit, CLOSED, then the
# function's own rules, those in SQL); the free-text fields arrive on stdin as escaped
# key=value payload lines, staged in a per-call scratch folder under the workspace's
# .contexture/tmp and read by the SQL with readfile(); a document (a recipe, a report)
# arrives raw. The answer is one compact JSON line built with json_object in the
# contract key order; a refusal is one stderr line "<function>: error: <message> (<CODE>)"
# with nothing on stdout. Exit tiers: 0 ok, 1 semantic, 2 storage or driver.
#
# Writes: one transaction each (BEGIN IMMEDIATE to COMMIT, whole or nothing), under the unit
# write lock (.contexture/tmp/locks/fts5-<unit>.lock) so writers of one unit serialize; the
# answer prints only after the commit. Module data is served by the seven generic store
# functions over the module data files (list, get, put, delete, changes, batch, scan) plus
# the store search entry; the docs corpus reaches this driver through them.

set -u

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'fts5-driver: error: sqlite3 executable not found (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
MODULE_DIR=$(CDPATH="" cd "$SCRIPT_DIR/.." && pwd)
SCHEMA_SQL="$MODULE_DIR/schema.sql"
SQL_DIR="$MODULE_DIR/sql"
LC_ALL=C
export LC_ALL

find_workspace_root() {
  curr="$PWD"
  while [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

ROOT=$(find_workspace_root)

if [ -n "${CTX_STORAGE_SQLITE_PATH:-}" ]; then
  DB_PATH="$CTX_STORAGE_SQLITE_PATH"
elif [ -f "$ROOT/.contexture/config" ] && grep -Eq '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" 2>/dev/null; then
  val=$(grep -E '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" | head -n1 | sed -E 's/^(session\.)?storage\.database[:=[:space:]]+//' | tr -d ' \t\r\n"')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
elif [ -f "$ROOT/.contexture/storage.conf" ] && grep -Eq '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" 2>/dev/null; then
  val=$(grep -E '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" | head -n1 | sed -E 's/^storage\.database[:[:space:]]+//')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
else
  DB_PATH="$ROOT/.contexture/sessions.db"
fi

# scratch lives in the workspace drawer when it is writable
DB_TMP="$ROOT/.contexture/tmp"
if ! mkdir -p "$DB_TMP" 2>/dev/null || [ ! -w "$DB_TMP" ]; then
  DB_TMP="${TMPDIR:-/tmp}"
fi

# scratch_base: the per-verb root ctx exported (created on first use), else the drawer;
# every transient file stages here so a killed verb's root holds its residue
scratch_base() {
  if [ -n "${CTX_SCRATCH_ROOT:-}" ] && mkdir -p "$CTX_SCRATCH_ROOT" 2>/dev/null \
    && [ -d "$CTX_SCRATCH_ROOT" ] && [ -w "$CTX_SCRATCH_ROOT" ]; then
    printf '%s\n' "$CTX_SCRATCH_ROOT"
  else
    printf '%s\n' "$DB_TMP"
  fi
}

# the open path (a fresh schema; a store at another schema refused)
. "$MODULE_DIR/db-init.sh"

sql_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# a written unit, task, lane slug: ^[A-Za-z0-9][A-Za-z0-9_-]*$
slug_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# the entry slug and the finding NAME a read addresses: the legacy shapes stay addressable
name_valid() {
  case "$1" in
    ""|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

# a read never creates the store: without a database file there is nothing to read
db_open_read() {
  [ -f "$DB_PATH" ] || return 1
  db_init
  return 0
}

SCRATCH=""
LOCK_DIR=""
cleanup() {
  [ -n "$SCRATCH" ] && rm -rf "$SCRATCH"
  [ -n "$LOCK_DIR" ] && rm -rf "$LOCK_DIR"
  return 0
}
trap cleanup EXIT
# a HUP, INT, or TERM exits through the EXIT trap (dash runs no EXIT trap on a signal it
# does not trap), so an interrupted function leaves no scratch and no held lock; an open
# transaction rolls back with its connection
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

scratch() {
  if [ -z "$SCRATCH" ]; then
    SCRATCH=$(mktemp -d "$(scratch_base)/fts5-ws.XXXXXX") || {
      printf '%s: error: cannot create a scratch folder (ERR_STORAGE_WRITE)\n' "$CMD" >&2
      exit 2
    }
  fi
}

# the unit write lock: the writers of one unit serialize (beside the transaction itself, so a
# held lock is the one lever a probe can hold them with). The folder carries its holder pid;
# a waiter removes a lock whose pid is gone (a SIGKILLed writer), and gives a lock with no
# pid file a second's grace for its holder to write one; a live holder still refuses after
# ten seconds.
acquire_lock() {
  mkdir -p "$DB_TMP/locks" 2>/dev/null || true
  lk="$DB_TMP/locks/fts5-$1.lock"
  lk_n=0
  lk_miss=0
  while ! mkdir "$lk" 2>/dev/null; do
    lk_pid=$(cat "$lk/pid" 2>/dev/null)
    case "$lk_pid" in
      ""|*[!0-9]*)
        lk_miss=$((lk_miss + 1))
        if [ "$lk_miss" -ge 10 ]; then rm -rf "$lk" 2>/dev/null; lk_miss=0; continue; fi
        ;;
      *)
        if kill -0 "$lk_pid" 2>/dev/null; then lk_miss=0
        else rm -rf "$lk" 2>/dev/null; continue
        fi
        ;;
    esac
    lk_n=$((lk_n + 1))
    if [ "$lk_n" -ge 100 ]; then
      printf "%s: error: failed to acquire the write lock of unit '%s' after 10s (ERR_STORAGE_LOCKED)\n" "$CMD" "$1" >&2
      exit 2
    fi
    sleep 0.1 2>/dev/null || sleep 1
  done
  printf '%s\n' "$$" > "$lk/pid" 2>/dev/null || {
    rm -rf "$lk" 2>/dev/null
    printf "%s: error: cannot write the unit lock holder pid (ERR_STORAGE_WRITE)\n" "$CMD" >&2
    exit 2
  }
  LOCK_DIR="$lk"
}

if [ $# -eq 0 ]; then
  printf 'fts5-driver: error: missing command (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

CMD="$1"
shift


# ==============================================================================
# The generic module store (the storage module's store contract)
# ==============================================================================
# Seven data functions over a module's declared data file: store.list, store.get,
# store.put, store.delete, store.changes, store.batch, and store.scan. The data file
# (modules/<module>/data) is read and validated by the storage module's private store-data
# script; the value is opaque bytes in the `store` table keyed by (namespace, key), and
# every put and delete lands its row in `store_changes` in the same transaction. Keys are
# exact, ASCII-case-fold twins never coexist, list is bytewise and filtered by the module
# pattern, put is one transaction,
# and the change log is optional per namespace (a namespace declaring changes: false
# refuses store.changes). The batch takes one namespace scope lock, validates its whole
# action list, and runs every action in one BEGIN IMMEDIATE transaction with one
# store_changes row per action; the scan answers every admitted key with its raw value in
# base64. The legacy docs tables stay untouched and unread by the store.
# The posix driver's messages and exit tiers are kept, so a caller never branches.
STORE_LOCK=""
STORE_TMP=""

store_cleanup() {
  [ -n "${STORE_TMP:-}" ] && rm -f "$STORE_TMP" 2>/dev/null
  STORE_TMP=""
  store_unlock
  cleanup
  return 0
}

store_unlock() {
  [ -n "${STORE_LOCK:-}" ] || return 0
  su_lock=$STORE_LOCK
  STORE_LOCK=""
  rm -rf "$su_lock" 2>/dev/null
  su_base="$DB_TMP/locks"
  su_p=$(dirname "$su_lock")
  while [ "$su_p" != "$su_base" ] && [ "$su_p" != "/" ]; do
    rmdir "$su_p" 2>/dev/null || break
    su_p=$(dirname "$su_p")
  done
  return 0
}

# store_lock <namespace>: one namespace scope lock shared by store.put, store.delete, and
# store.batch, a folder under the drawer's lock folder, held until store_unlock; five
# seconds of retries then rc 2 ERR_STORAGE_LOCKED. The folder
# carries its holder pid; a waiter removes a lock whose pid is gone, and gives a lock with no
# pid file a second's grace for its holder to write one.
store_lock() {
  STORE_LOCK="$DB_TMP/locks/store-$1.lock"
  mkdir -p "$(dirname "$STORE_LOCK")" 2>/dev/null || {
    STORE_LOCK=""
    refuse 2 ERR_STORAGE_WRITE "cannot make the store lock folder"
  }
  sl_n=0
  sl_miss=0
  while [ "$sl_n" -lt 50 ]; do
    if mkdir "$STORE_LOCK" 2>/dev/null; then
      printf '%s\n' "$$" > "$STORE_LOCK/pid" 2>/dev/null || {
        rm -rf "$STORE_LOCK" 2>/dev/null
        STORE_LOCK=""
        refuse 2 ERR_STORAGE_WRITE "cannot write the store lock holder pid"
      }
      return 0
    fi
    sl_pid=$(cat "$STORE_LOCK/pid" 2>/dev/null)
    case "$sl_pid" in
      ""|*[!0-9]*)
        sl_miss=$((sl_miss + 1))
        if [ "$sl_miss" -ge 10 ]; then rm -rf "$STORE_LOCK" 2>/dev/null; sl_miss=0; continue; fi
        ;;
      *)
        if kill -0 "$sl_pid" 2>/dev/null; then sl_miss=0
        else rm -rf "$STORE_LOCK" 2>/dev/null; continue
        fi
        ;;
    esac
    sl_n=$((sl_n + 1))
    sleep 0.1 2>/dev/null || sleep 1
  done
  STORE_LOCK=""
  refuse 2 ERR_STORAGE_LOCKED "the store namespace '$1' is locked (5 s timeout)"
}

# store_data <function> <namespace>: the validated fields of the namespace's data file in
# SD_NS, SD_ROOT, SD_SUFFIX, SD_KEYPAT, SD_CHANGES; the storage core's store-data script
# owns the grammar (the core is base, never the docs module: no module's parser
# enters base)
store_data() {
  FN=$1
  sd_ns=$2
  sd_script=""
  for sd_c in "$MODULE_DIR/../../storage/scripts/store-data" \
              "$ROOT/.contexture/storage/scripts/store-data" \
              "$ROOT/base/.contexture/storage/scripts/store-data"; do
    if [ -x "$sd_c" ]; then sd_script=$sd_c; break; fi
  done
  [ -n "$sd_script" ] || refuse 2 ERR_STORAGE_READ "the storage core data reader is not installed"
  sd_err=$(mktemp "$(scratch_base)/store-data.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  sd_out=$(CTX_STORE_WORKSPACE="$ROOT" "$sd_script" "$sd_ns" 2>"$sd_err")
  sd_rc=$?
  sd_msg=$(head -n 1 "$sd_err" 2>/dev/null)
  rm -f "$sd_err"
  case "$sd_msg" in store-data:\ *) sd_msg=${sd_msg#store-data: } ;; esac
  [ -n "$sd_msg" ] || sd_msg="the namespace '$sd_ns' is not declared by a usable data file"
  case "$sd_rc" in
    0) ;;
    3) refuse 1 ERR_ENTITY_NOT_FOUND "$sd_msg" ;;
    2) refuse 2 ERR_STORAGE_READ "$sd_msg" ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "$sd_msg" ;;
  esac
  SD_NS=$(printf '%s\n' "$sd_out" | sed -n '1p')
  SD_ROOT=$(printf '%s\n' "$sd_out" | sed -n '2p')
  SD_SUFFIX=$(printf '%s\n' "$sd_out" | sed -n '3p')
  SD_KEYPAT=$(printf '%s\n' "$sd_out" | sed -n '4p')
  SD_CHANGES=$(printf '%s\n' "$sd_out" | sed -n '5p')
  SD_FILE=$(printf '%s\n' "$sd_out" | sed -n '6p')
  SD_FORM=$(printf '%s\n' "$sd_out" | sed -n '7p')
  SD_FORMAT=$(printf '%s\n' "$sd_out" | sed -n '8p')
  SD_FIELDS=$(printf '%s\n' "$sd_out" | sed -n '9p')
  SD_TITLE=$(printf '%s\n' "$sd_out" | sed -n '10p')
  SD_SNIPPET=$(printf '%s\n' "$sd_out" | sed -n '11p')
  SD_MODES=$(printf '%s\n' "$sd_out" | sed -n '12p')
  SD_DOCS=$(printf '%s\n' "$sd_out" | sed -n '13,$p')
  SD_SIG=$(printf '%s\n' "$SD_FORM" "$SD_FORMAT" "$SD_FIELDS" "$SD_TITLE" "$SD_SNIPPET" "$SD_MODES" "$SD_DOCS" | cksum | awk '{ print $1 "-" $2 }')
}

# store_key_ok <key>: the generic key rule: no blanks, control characters, leading slash,
# backslash, or . or .. segment, and every segment non-empty (exact, not folded)
store_key_ok() {
  SK_KEY="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SK_KEY"]
    if (s == "") exit 1
    if (substr(s, 1, 1) == "/" || substr(s, length(s), 1) == "/") exit 1
    if (s ~ /[[:cntrl:]]/ || index(s, " ") || index(s, "\\")) exit 1
    n = split(s, p, "/")
    for (i = 1; i <= n; i++) if (p[i] == "" || p[i] == "." || p[i] == "..") exit 1
    exit 0
  }'
}

# store_key_shape <pattern> <key>: the key's segments match the module's pattern; every
# pattern segment is a <name> placeholder and the key's segment count equals the pattern's,
# except that a final <name...> placeholder admits one or more segments (the variable-depth
# key that lets a module's main files and its deeper lane files share one pattern)
store_key_shape() {
  SSP_P="$1" SSP_K="$2" LC_ALL=C awk 'BEGIN {
    m = split(ENVIRON["SSP_P"], p, "/")
    n = split(ENVIRON["SSP_K"], k, "/")
    if (m < 1) exit 1
    multi = (p[m] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/)
    if (multi) { if (n < m) exit 1 } else { if (n != m) exit 1 }
    for (i = 1; i < m; i++) {
      if (p[i] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) exit 1
      if (k[i] == "") exit 1
    }
    if (multi) {
      for (i = m; i <= n; i++) if (k[i] == "") exit 1
    } else {
      if (p[m] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) exit 1
      if (k[m] == "") exit 1
    }
    exit 0
  }'
}

# store_key_for <function> <namespace> <key>: the key rule and the module pattern before a
# key reaches the database
store_key_for() {
  FN=$1
  sk_key=$3
  store_key_ok "$sk_key" || refuse 1 ERR_INVALID_ARGUMENT "malformed key '$sk_key'"
  store_key_shape "$SD_KEYPAT" "$sk_key" || refuse 1 ERR_INVALID_ARGUMENT "key '$sk_key' does not match the namespace pattern '$SD_KEYPAT'"
}

# store_flags <function> <default op> [flags]: --op=<op> and --head=<sha|none>, bounded
store_flags() {
  sf_fn=$1; SF_OP=$2
  shift 2
  SF_HEAD=none
  for sf_a in "$@"; do
    case "$sf_a" in
      --op=*) SF_OP=${sf_a#--op=} ;;
      --head=*) SF_HEAD=${sf_a#--head=} ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown argument '$sf_a'" ;;
    esac
  done
  case "$SF_OP" in
    ''|*[!A-Za-z0-9._-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed op '$SF_OP'" ;;
  esac
  case "$SF_HEAD" in
    none) ;;
    ''|*[!0-9a-fA-F]*) refuse 1 ERR_INVALID_ARGUMENT "--head takes a commit id or none: '$SF_HEAD'" ;;
  esac
}

# store_exists <namespace> <key>: the exact key the store holds (a case twin is absent)
store_exists() {
  [ "$(sq "$DB_PATH" "SELECT count(*) FROM store WHERE namespace = '$(sql_escape "$1")' AND key = '$(sql_escape "$2")';" 2>/dev/null)" = "1" ]
}

# store_twin <namespace> <key>: a stored key that folds onto <key> under ASCII case without
# matching it, else nothing; SQLite's lower() folds ASCII only, as the posix rule does
store_twin() {
  sq -bail "$DB_PATH" "SELECT key FROM store WHERE namespace = '$(sql_escape "$1")' AND lower(key) = lower('$(sql_escape "$2")') AND key <> '$(sql_escape "$2")' ORDER BY key COLLATE BINARY LIMIT 1;"
}

# store_json <value>: a JSON string body for the bounded store identifiers (a key may hold
# a double quote; the namespace, op, and head are tokens; no key holding a backslash or a
# control character is ever admitted, and a planted one is filtered out of list)
store_json() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

store_list() {
  FN=store.list
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.list takes one argument, the namespace"
  sn_ns=$1
  store_data store.list "$sn_ns"
  sn_tmp=$(mktemp "$(scratch_base)/store-keys.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  if [ -f "$DB_PATH" ]; then
    db_init
    if ! sq -bail "$DB_PATH" "SELECT key FROM store WHERE namespace = '$(sql_escape "$sn_ns")' ORDER BY key COLLATE BINARY;" > "$sn_tmp" 2>/dev/null; then
      rm -f "$sn_tmp"
      refuse 2 ERR_STORAGE_READ "the storage read failed"
    fi
  else
    : > "$sn_tmp"
  fi
  printf '{"namespace":"%s","keys":[' "$(store_json "$sn_ns")"
  sn_first=1
  while IFS= read -r sn_key; do
    [ -n "$sn_key" ] || continue
    store_key_ok "$sn_key" || continue
    store_key_shape "$SD_KEYPAT" "$sn_key" || continue
    if [ "$sn_first" -eq 1 ]; then
      printf '"%s"' "$(store_json "$sn_key")"
      sn_first=0
    else
      printf ',"%s"' "$(store_json "$sn_key")"
    fi
  done < "$sn_tmp"
  rm -f "$sn_tmp"
  printf ']}\n'
  exit 0
}

store_get() {
  FN=store.get
  [ $# -eq 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.get takes the namespace and the key"
  sg_ns=$1; sg_key=$2
  store_data store.get "$sg_ns"
  store_key_for store.get "$sg_ns" "$sg_key"
  if [ ! -f "$DB_PATH" ] || ! store_exists "$sg_ns" "$sg_key"; then
    refuse 1 ERR_ENTITY_NOT_FOUND "key '$sg_key' not found in namespace '$sg_ns'"
  fi
  scratch
  : > "$SCRATCH/key"
  sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$SCRATCH/key")', value) FROM store WHERE namespace = '$(sql_escape "$sg_ns")' AND key = '$(sql_escape "$sg_key")';" > /dev/null 2>&1 || {
    refuse 2 ERR_STORAGE_READ "cannot read key '$sg_key' in namespace '$sg_ns'"
  }
  cat "$SCRATCH/key"
  exit 0
}

store_put() {
  FN=store.put
  [ $# -ge 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.put takes the namespace, the key, and optional flags"
  sp_ns=$1; sp_key=$2
  shift 2
  store_flags store.put write "$@"
  store_data store.put "$sp_ns"
  store_key_for store.put "$sp_ns" "$sp_key"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  store_lock "$sp_ns"
  scratch
  cat > "$SCRATCH/value" || {
    store_cleanup
    refuse 2 ERR_STORAGE_READ "cannot read the value"
  }
  db_init
  store_docs_ensure "$sp_ns" "$SD_SIG"
  if ! sp_twin=$(store_twin "$sp_ns" "$sp_key"); then
    store_cleanup
    refuse 2 ERR_STORAGE_READ "the storage read failed"
  fi
  if [ -n "$sp_twin" ]; then
    store_cleanup
    refuse 1 ERR_ENTITY_EXISTS "key '$sp_key' folds onto '$sp_twin' under ASCII case; keys differing only by case never coexist in namespace '$sp_ns'"
  fi
  sp_core=$(store_search_core) || {
    store_cleanup
    refuse 2 ERR_STORAGE_READ "the storage core search engine is not installed"
  }
  if ! "$sp_core" docs "$SD_FILE" "$sp_ns" "$sp_key" "$SCRATCH/value" "$SD_SIG" > "$SCRATCH/docs.sql"; then
    store_cleanup
    refuse 2 ERR_STORAGE_WRITE "cannot derive the store search documents"
  fi
  sp_now=$(now_utc)
  {
    printf 'BEGIN IMMEDIATE;\n'
    printf "INSERT INTO store_changes (at, namespace, key, op, head, prior) VALUES ('%s', '%s', '%s', '%s', '%s', CASE WHEN EXISTS (SELECT 1 FROM store WHERE namespace = '%s' AND key = '%s') THEN 'present' ELSE 'absent' END);\n" \
      "$sp_now" "$(sql_escape "$sp_ns")" "$(sql_escape "$sp_key")" "$(sql_escape "$SF_OP")" "$(sql_escape "$SF_HEAD")" "$(sql_escape "$sp_ns")" "$(sql_escape "$sp_key")"
    printf "INSERT INTO store (namespace, key, value, updated_at) VALUES ('%s', '%s', readfile('%s'), '%s') ON CONFLICT(namespace, key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at;\n" \
      "$(sql_escape "$sp_ns")" "$(sql_escape "$sp_key")" "$(sql_escape "$SCRATCH/value")" "$sp_now"
    cat "$SCRATCH/docs.sql"
    printf 'COMMIT;\n'
  } > "$SCRATCH/store.sql"
  if ! sq -bail "$DB_PATH" < "$SCRATCH/store.sql" > /dev/null 2>&1; then
    store_cleanup
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  fi
  store_cleanup
  printf '{"namespace":"%s","key":"%s","op":"%s"}\n' "$(store_json "$sp_ns")" "$(store_json "$sp_key")" "$(store_json "$SF_OP")"
  exit 0
}

store_delete() {
  FN=store.delete
  [ $# -ge 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.delete takes the namespace, the key, and optional flags"
  sx_ns=$1; sx_key=$2
  shift 2
  store_flags store.delete remove "$@"
  store_data store.delete "$sx_ns"
  store_key_for store.delete "$sx_ns" "$sx_key"
  if [ ! -f "$DB_PATH" ] || ! store_exists "$sx_ns" "$sx_key"; then
    refuse 1 ERR_ENTITY_NOT_FOUND "key '$sx_key' not found in namespace '$sx_ns'"
  fi
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  store_lock "$sx_ns"
  db_init
  store_docs_ensure "$sx_ns" "$SD_SIG"
  scratch
  {
    printf 'BEGIN IMMEDIATE;\n'
    printf "INSERT INTO store_changes (at, namespace, key, op, head, prior) VALUES ('%s', '%s', '%s', '%s', '%s', 'present');\n" \
      "$(now_utc)" "$(sql_escape "$sx_ns")" "$(sql_escape "$sx_key")" "$(sql_escape "$SF_OP")" "$(sql_escape "$SF_HEAD")"
    printf "DELETE FROM store WHERE namespace = '%s' AND key = '%s';\n" "$(sql_escape "$sx_ns")" "$(sql_escape "$sx_key")"
    printf 'DELETE FROM store_docs WHERE namespace = %s AND key = %s;\n' "$(store_sqlq "$sx_ns")" "$(store_sqlq "$sx_key")"
    printf 'COMMIT;\n'
  } > "$SCRATCH/store.sql"
  if ! sq -bail "$DB_PATH" < "$SCRATCH/store.sql" > /dev/null 2>&1; then
    store_cleanup
    refuse 2 ERR_STORAGE_WRITE "the storage remove of key '$sx_key' failed"
  fi
  store_cleanup
  printf '{"namespace":"%s","key":"%s","op":"%s"}\n' "$(store_json "$sx_ns")" "$(store_json "$sx_key")" "$(store_json "$SF_OP")"
  exit 0
}

store_changes() {
  FN=store.changes
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.changes takes one argument, the namespace"
  sc_ns=$1
  store_data store.changes "$sc_ns"
  if [ "$SD_CHANGES" != "true" ]; then
    refuse 1 ERR_CAPABILITY_UNSUPPORTED "the namespace '$sc_ns' declares no change log (changes: false)"
  fi
  scratch
  cat > "$SCRATCH/heads" || refuse 2 ERR_STORAGE_READ "cannot read the heads"
  printf 'CREATE TEMP TABLE want_heads (head TEXT PRIMARY KEY);\n' > "$SCRATCH/changes.sql"
  while IFS= read -r ch_l || [ -n "$ch_l" ]; do
    [ -n "$ch_l" ] || continue
    case "$ch_l" in
      head=*) ch_h=${ch_l#head=} ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown payload line '$ch_l' (head=<sha> lines only)" ;;
    esac
    case "$ch_h" in
      none) ;;
      ""|*[!0-9a-fA-F]*) refuse 1 ERR_INVALID_ARGUMENT "a head is a commit id or none: '$ch_h'" ;;
    esac
    printf "INSERT OR IGNORE INTO want_heads VALUES ('%s');\n" "$ch_h" >> "$SCRATCH/changes.sql"
  done < "$SCRATCH/heads"
  if [ ! -f "$DB_PATH" ]; then
    printf '{"namespace":"%s","changes":[]}\n' "$(store_json "$sc_ns")"
    exit 0
  fi
  db_init
  printf "SELECT '{\"namespace\":' || json_quote('%s') || ',\"changes\":' || coalesce(json_group_array(json_object('seq', seq, 'at', at, 'key', key, 'op', op, 'head', head, 'prior', prior)), '[]') || '}' FROM (SELECT seq, at, key, op, head, prior FROM store_changes WHERE namespace = '%s' AND head IN (SELECT head FROM want_heads) ORDER BY seq);\n" \
    "$(sql_escape "$sc_ns")" "$(sql_escape "$sc_ns")" >> "$SCRATCH/changes.sql"
  if ! sq -bail "$DB_PATH" < "$SCRATCH/changes.sql"; then
    refuse 2 ERR_STORAGE_READ "the storage read failed"
  fi
  exit 0
}

# store_sqlq <value>: a single-quoted SQL string
store_sqlq() {
  printf "'%s'" "$(sql_escape "$1")"
}

# ==============================================================================
# The transactional batch and the scan
# ==============================================================================
# The batch wire (stdin, the escaped payload format): an action=put or action=delete line
# opens an action, then key=<escaped key>, head=<sha|none> (default none), and, for a put,
# value_b64=<base64>. The action list is validated whole under the namespace lock, then
# every action runs in one BEGIN IMMEDIATE transaction with one store_changes row per
# action; the first failure prints store.batch: error: action <n> (<op> '<key>'): <message>
# (<CODE>), 1-based, and the transaction leaves nothing written.
batch_unescape() {
  BU_RAW="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["BU_RAW"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n") out = out "\n"
        else if (c == "t") out = out "\t"
        else if (c == "r") out = out "\r"
        else out = out c
      } else out = out c
    }
    printf "%s", out
  }'
}

# batch_decode <base64> <out>: decode one value; the base64 command differs only in its
# decode flag, so the GNU/Darwin spelling is tried first and the BSD one second
batch_decode() {
  printf '%s' "$1" | base64 -d > "$2" 2>/dev/null && return 0
  printf '%s' "$1" | base64 -D > "$2" 2>/dev/null && return 0
  rm -f "$2" 2>/dev/null
  return 1
}

# batch_refuse <rc> <n> <op> <key> <CODE> <message>: the batch's one failure line
batch_refuse() {
  printf 'store.batch: error: action %s (%s '\''%s'\''): %s (%s)\n' "$2" "$3" "$4" "$6" "$5" >&2
  exit "$1"
}

# batch_key_for <n> <op> <key>: the key rule and the module pattern, framed by the action
batch_key_for() {
  bk_key=$3
  store_key_ok "$bk_key" || batch_refuse 1 "$1" "$2" "$bk_key" ERR_INVALID_ARGUMENT "malformed key '$bk_key'"
  store_key_shape "$SD_KEYPAT" "$bk_key" || batch_refuse 1 "$1" "$2" "$bk_key" ERR_INVALID_ARGUMENT "key '$bk_key' does not match the namespace pattern '$SD_KEYPAT'"
}

# batch_close_action: validate the action being parsed and append it to the manifest
# (n, op, key, head, value path, tab separated; a key never holds a tab)
batch_close_action() {
  [ "$sb_open" -eq 1 ] || return 0
  sb_open=0
  sb_n=$((sb_n + 1))
  [ "$sb_seen_key" -eq 1 ] && [ -n "$sb_key" ] || batch_refuse 1 "$sb_n" "$sb_op" "?" ERR_INVALID_ARGUMENT "the action carries no key"
  batch_key_for "$sb_n" "$sb_op" "$sb_key"
  case "$sb_head" in
    none) ;;
    ''|*[!0-9a-fA-F]*) batch_refuse 1 "$sb_n" "$sb_op" "$sb_key" ERR_INVALID_ARGUMENT "--head takes a commit id or none: '$sb_head'" ;;
  esac
  case "$sb_op" in
    put)
      [ "$sb_seen_val" -eq 1 ] || batch_refuse 1 "$sb_n" put "$sb_key" ERR_INVALID_ARGUMENT "a put carries no value"
      sb_v="$SCRATCH/batch-val.$sb_n"
      batch_decode "$sb_val" "$sb_v" || batch_refuse 1 "$sb_n" put "$sb_key" ERR_INVALID_ARGUMENT "malformed base64 value"
      printf '%s\t%s\t%s\t%s\t%s\n' "$sb_n" put "$sb_key" "$sb_head" "$sb_v" >> "$SCRATCH/man"
      ;;
    delete)
      [ "$sb_seen_val" -eq 0 ] || batch_refuse 1 "$sb_n" delete "$sb_key" ERR_INVALID_ARGUMENT "a delete carries no value"
      printf '%s\t%s\t%s\t%s\t\n' "$sb_n" delete "$sb_key" "$sb_head" >> "$SCRATCH/man"
      ;;
  esac
}

# batch_parse: read the action payload from stdin into the manifest; values stage in the
# per-call scratch folder
batch_parse() {
  : > "$SCRATCH/man"
  sb_n=0
  sb_open=0
  sb_op=""; sb_key=""; sb_head=""; sb_val=""; sb_seen_key=0; sb_seen_head=0; sb_seen_val=0
  while IFS= read -r sb_l || [ -n "$sb_l" ]; do
    sb_l=${sb_l%"$cr_byte"}
    case "$sb_l" in
      '') continue ;;
      action=*)
        batch_close_action
        sb_open=1
        sb_op=${sb_l#action=}
        case "$sb_op" in
          put|delete) ;;
          *) batch_refuse 1 "$((sb_n + 1))" "$sb_op" "?" ERR_INVALID_ARGUMENT "unknown action '$sb_op' (put or delete)" ;;
        esac
        sb_key=""; sb_head=none; sb_val=""; sb_seen_key=0; sb_seen_head=0; sb_seen_val=0
        ;;
      key=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_key" -eq 0 ] || batch_refuse 1 "$sb_n" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'key='"
        sb_seen_key=1
        sb_key=$(batch_unescape "${sb_l#key=}")
        ;;
      head=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_head" -eq 0 ] || batch_refuse 1 "$sb_n" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'head='"
        sb_seen_head=1
        sb_head=${sb_l#head=}
        ;;
      value_b64=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_val" -eq 0 ] || batch_refuse 1 "$sb_n" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'value_b64='"
        sb_seen_val=1
        sb_val=${sb_l#value_b64=}
        ;;
      *) batch_refuse 1 "$sb_n" "${sb_op:-?}" "${sb_key:-?}" ERR_INVALID_ARGUMENT "unknown payload line '$sb_l'" ;;
    esac
  done
  if [ "$sb_open" -eq 1 ]; then batch_close_action; fi
  [ "$sb_n" -gt 0 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "the batch carries no actions"
}

# batch_validate: the whole action list against the live key set, under the namespace lock;
# a delete must find the key present at its place in the order, and a put never coexists
# with an ASCII case twin
batch_validate() {
  : > "$SCRATCH/live"
  if [ -f "$DB_PATH" ]; then
    db_init
    if ! sq -bail "$DB_PATH" "SELECT key FROM store WHERE namespace = $(store_sqlq "$sb_ns") ORDER BY key COLLATE BINARY;" > "$SCRATCH/live" 2>/dev/null; then
      refuse 2 ERR_STORAGE_READ "the storage read failed"
    fi
  fi
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    case "$sb_op" in
      put)
        sb_twin=$(SB_T="$sb_key" LC_ALL=C awk 'BEGIN { t = ENVIRON["SB_T"] } { if ($0 != t && tolower($0) == tolower(t)) { print; exit } }' "$SCRATCH/live")
        [ -z "$sb_twin" ] || batch_refuse 1 "$sb_i" put "$sb_key" ERR_ENTITY_EXISTS "key '$sb_key' folds onto '$sb_twin' under ASCII case; keys differing only by case never coexist in namespace '$sb_ns'"
        printf '%s\n' "$sb_key" >> "$SCRATCH/live"
        LC_ALL=C sort -u "$SCRATCH/live" -o "$SCRATCH/live"
        ;;
      delete)
        grep -F -q -x -e "$sb_key" "$SCRATCH/live" || batch_refuse 1 "$sb_i" delete "$sb_key" ERR_ENTITY_NOT_FOUND "key '$sb_key' not found in namespace '$sb_ns'"
        grep -F -v -x -e "$sb_key" "$SCRATCH/live" > "$SCRATCH/live.next" || true
        mv -f "$SCRATCH/live.next" "$SCRATCH/live"
        ;;
    esac
  done < "$SCRATCH/man"
}

# batch_sql: the one transaction script; each action's first statement line is recorded so
# a sqlite3 failure names the action that failed
batch_sql() {
  sbs_core=$(store_search_core) || refuse 2 ERR_STORAGE_READ "the storage core search engine is not installed"
  sbs_now=$(now_utc)
  : > "$SCRATCH/store.sql"
  : > "$SCRATCH/action-lines"
  printf 'BEGIN IMMEDIATE;\n' >> "$SCRATCH/store.sql"
  while IFS='	' read -r sbs_i sbs_op sbs_key sbs_head sbs_val; do
    sbs_start=$(( $(wc -l < "$SCRATCH/store.sql") + 1 ))
    printf '%s\t%s\n' "$sbs_start" "$sbs_i" >> "$SCRATCH/action-lines"
    printf "INSERT INTO store_changes (at, namespace, key, op, head, prior) VALUES ('%s', '%s', '%s', '%s', '%s', CASE WHEN EXISTS (SELECT 1 FROM store WHERE namespace = '%s' AND key = '%s') THEN 'present' ELSE 'absent' END);\n" \
      "$sbs_now" "$(sql_escape "$sb_ns")" "$(sql_escape "$sbs_key")" "$(sql_escape "$sbs_op")" "$(sql_escape "$sbs_head")" "$(sql_escape "$sb_ns")" "$(sql_escape "$sbs_key")" >> "$SCRATCH/store.sql"
    case "$sbs_op" in
      put)
        printf "INSERT INTO store (namespace, key, value, updated_at) VALUES ('%s', '%s', readfile('%s'), '%s') ON CONFLICT(namespace, key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at;\n" \
          "$(sql_escape "$sb_ns")" "$(sql_escape "$sbs_key")" "$(sql_escape "$sbs_val")" "$sbs_now" >> "$SCRATCH/store.sql"
        printf "DELETE FROM store_docs WHERE namespace = '%s' AND key = '%s';\n" "$(sql_escape "$sb_ns")" "$(sql_escape "$sbs_key")" >> "$SCRATCH/store.sql"
        if ! "$sbs_core" docs "$SD_FILE" "$sb_ns" "$sbs_key" "$sbs_val" "$SD_SIG" >> "$SCRATCH/store.sql"; then
          batch_refuse 2 "$sbs_i" put "$sbs_key" ERR_STORAGE_WRITE "cannot derive the store search documents"
        fi
        ;;
      delete)
        printf "DELETE FROM store WHERE namespace = '%s' AND key = '%s';\n" "$(sql_escape "$sb_ns")" "$(sql_escape "$sbs_key")" >> "$SCRATCH/store.sql"
        printf "DELETE FROM store_docs WHERE namespace = '%s' AND key = '%s';\n" "$(sql_escape "$sb_ns")" "$(sql_escape "$sbs_key")" >> "$SCRATCH/store.sql"
        ;;
    esac
  done < "$SCRATCH/man"
  printf 'COMMIT;\n' >> "$SCRATCH/store.sql"
}

store_batch() {
  FN=store.batch
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.batch takes one argument, the namespace"
  sb_ns=$1
  store_data store.batch "$sb_ns"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  scratch
  batch_parse
  store_lock "$sb_ns"
  batch_validate
  db_init
  store_docs_ensure "$sb_ns" "$SD_SIG"
  batch_sql
  if ! sq -bail "$DB_PATH" < "$SCRATCH/store.sql" > /dev/null 2> "$SCRATCH/err"; then
    sb_line=$(sed -n 's/.*near line \([0-9][0-9]*\):.*/\1/p' "$SCRATCH/err" | head -n 1)
    [ -n "$sb_line" ] || sb_line=999999999
    sb_act=$(awk -v n="$sb_line" '$1 <= n { a = $2 } END { if (a == "") a = 1; printf "%s", a }' "$SCRATCH/action-lines")
    sb_meta=$(awk -F '	' -v a="$sb_act" '$1 == a { print $2 "\t" $3; exit }' "$SCRATCH/man")
    sb_op=${sb_meta%%	*}
    sb_key=${sb_meta#*	}
    if [ "$sb_op" = delete ]; then
      batch_refuse 2 "$sb_act" delete "$sb_key" ERR_STORAGE_WRITE "the storage remove of key '$sb_key' failed"
    fi
    batch_refuse 2 "$sb_act" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
  fi
  store_cleanup
  printf '{"namespace":"%s","actions":%s}\n' "$(store_json "$sb_ns")" "$sb_n"
  exit 0
}

# store_scan: every key the module pattern admits with its raw value in base64, bytewise,
# one compact JSON answer; no limit (the module stops after the keys it needs). The answer
# is staged and printed whole, so a read failure mid-scan prints nothing on stdout: the
# refusal is the one stderr line and the call is all or none.
store_scan() {
  FN=store.scan
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.scan takes one argument, the namespace"
  sns_ns=$1
  store_data store.scan "$sns_ns"
  sns_b64=""
  for sns_c in "$MODULE_DIR/../../storage/scripts/store-b64" \
               "$ROOT/.contexture/storage/scripts/store-b64" \
               "$ROOT/base/.contexture/storage/scripts/store-b64"; do
    if [ -x "$sns_c" ]; then sns_b64=$sns_c; break; fi
  done
  [ -n "$sns_b64" ] || refuse 2 ERR_STORAGE_READ "the storage core base64 encoder is not installed"
  scratch
  if [ -f "$DB_PATH" ]; then
    db_init
    if ! sq -bail "$DB_PATH" "SELECT key FROM store WHERE namespace = $(store_sqlq "$sns_ns") ORDER BY key COLLATE BINARY;" > "$SCRATCH/keys" 2>/dev/null; then
      refuse 2 ERR_STORAGE_READ "the storage read failed"
    fi
  else
    : > "$SCRATCH/keys"
  fi
  : > "$SCRATCH/scan-out"
  printf '{"namespace":"%s","items":[' "$(store_json "$sns_ns")" >> "$SCRATCH/scan-out"
  sns_first=1
  while IFS= read -r sns_key || [ -n "$sns_key" ]; do
    [ -n "$sns_key" ] || continue
    store_key_ok "$sns_key" || continue
    store_key_shape "$SD_KEYPAT" "$sns_key" || continue
    if ! sq -bail "$DB_PATH" "SELECT writefile($(store_sqlq "$SCRATCH/value"), value) FROM store WHERE namespace = $(store_sqlq "$sns_ns") AND key = $(store_sqlq "$sns_key");" > /dev/null 2>&1; then
      refuse 2 ERR_STORAGE_READ "cannot read key '$sns_key' in namespace '$sns_ns'"
    fi
    sns_v=$("$sns_b64" "$SCRATCH/value" 2>/dev/null) || refuse 2 ERR_STORAGE_READ "cannot read key '$sns_key' in namespace '$sns_ns'"
    if [ "$sns_first" -eq 1 ]; then sns_first=0; else printf ',' >> "$SCRATCH/scan-out"; fi
    printf '{"key":"%s","value_b64":"%s"}' "$(store_json "$sns_key")" "$sns_v" >> "$SCRATCH/scan-out"
  done < "$SCRATCH/keys"
  printf ']}\n' >> "$SCRATCH/scan-out"
  cat "$SCRATCH/scan-out"
  exit 0
}

# store_search_core: the storage core's private search engine
store_search_core() {
  for ssc_c in "$MODULE_DIR/../../storage/scripts/store-search" \
               "$ROOT/.contexture/storage/scripts/store-search" \
               "$ROOT/base/.contexture/storage/scripts/store-search"; do
    if [ -x "$ssc_c" ]; then printf '%s\n' "$ssc_c"; return 0; fi
  done
  return 1
}

# store_query_read: the query payload line, decoded, with a sentinel so a trailing newline
# survives the command substitution
cr_byte=$(printf '\r')
store_query_read() {
  sq_seen=0; sq_raw=""
  while IFS= read -r sq_l || [ -n "$sq_l" ]; do
    sq_l=${sq_l%"$cr_byte"}
    case "$sq_l" in
      query=*)
        [ "$sq_seen" -eq 0 ] || refuse 1 ERR_INVALID_ARGUMENT "duplicate payload line 'query='"
        sq_seen=1; sq_raw=${sq_l#query=} ;;
      '') ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown payload line '$sq_l' (query= only)" ;;
    esac
  done
  [ "$sq_seen" -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the query payload"
  SQ_RAW="$sq_raw" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SQ_RAW"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n") out = out "\n"
        else if (c == "t") out = out "\t"
        else if (c == "r") out = out "\r"
        else out = out c
      } else out = out c
    }
    printf "%sX", out
  }'
}

# store_docs_ensure <namespace> <sig>: the derived documents are current for the search
# schema; a namespace whose stored signature differs is re-derived whole from its values
store_docs_ensure() {
  sde_ns=$1; sde_sig=$2
  [ -f "$DB_PATH" ] || return 0
  db_init
  sde_now=$(sq "$DB_PATH" "SELECT sig FROM store_docs_schema WHERE namespace = $(store_sqlq "$sde_ns");" 2>/dev/null)
  [ "$sde_now" = "$sde_sig" ] && return 0
  sde_core=$(store_search_core) || refuse 2 ERR_STORAGE_READ "the storage core search engine is not installed"
  scratch
  mkdir -p "$SCRATCH/values" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch folder"
  sde_sql="$SCRATCH/docs-ensure.sql"
  printf 'BEGIN IMMEDIATE;\nDELETE FROM store_docs WHERE namespace = %s;\n' "$(store_sqlq "$sde_ns")" > "$sde_sql"
  if ! sq -bail "$DB_PATH" "SELECT key FROM store WHERE namespace = $(store_sqlq "$sde_ns") ORDER BY key COLLATE BINARY;" > "$SCRATCH/keys" 2>/dev/null; then
    refuse 2 ERR_STORAGE_READ "the storage read failed"
  fi
  sde_n=0
  while IFS= read -r sde_key || [ -n "$sde_key" ]; do
    [ -n "$sde_key" ] || continue
    sde_n=$((sde_n + 1))
    sde_val="$SCRATCH/values/$sde_n"
    if ! sq -bail "$DB_PATH" "SELECT writefile($(store_sqlq "$sde_val"), value) FROM store WHERE namespace = $(store_sqlq "$sde_ns") AND key = $(store_sqlq "$sde_key");" > /dev/null 2>&1; then
      refuse 2 ERR_STORAGE_READ "cannot read the store values"
    fi
    if ! "$sde_core" docs "$SD_FILE" "$sde_ns" "$sde_key" "$sde_val" "$sde_sig" >> "$sde_sql" 2>/dev/null; then
      refuse 2 ERR_STORAGE_WRITE "cannot derive the store search documents"
    fi
  done < "$SCRATCH/keys"
  printf "INSERT INTO store_docs_schema (namespace, sig) VALUES (%s, %s) ON CONFLICT(namespace) DO UPDATE SET sig = excluded.sig;\nCOMMIT;\n" \
    "$(store_sqlq "$sde_ns")" "$(store_sqlq "$sde_sig")" >> "$sde_sql"
  if ! sq -bail "$DB_PATH" < "$sde_sql" > /dev/null 2>&1; then
    refuse 2 ERR_STORAGE_WRITE "cannot derive the store search documents"
  fi
}

# store_search_ranked <namespace> <query> <mode> <limit>
store_search_ranked() {
  sr_ns=$1; sr_q=$2; sr_mode=$3; sr_lim=$4
  scratch
  {
    printf 'BEGIN;\n'
    printf "CREATE TEMP TABLE ssr AS SELECT %s AS ns, %s AS q, %s AS mode, %d AS lim;\n" \
      "$(store_sqlq "$sr_ns")" "$(store_sqlq "$sr_q")" "$(store_sqlq "$sr_mode")" "$sr_lim"
    printf "CREATE TEMP TABLE sst AS SELECT group_concat('\"' || replace(t.value, '\"', '\"\"') || '\"', ' ' ORDER BY t.key) AS m FROM json_each('[\"' || replace(replace(replace(replace(replace(replace((SELECT q FROM temp.ssr), '\\', '\\\\'), '\"', '\\\"'), char(9), ' '), char(10), ' '), char(13), ' '), ' ', '\",\"') || '\"]') t WHERE t.value <> '';\n"
    cat <<'RANKED'
CREATE TEMP TABLE ssres (doc_id INTEGER, key TEXT, section TEXT, score REAL, snippet TEXT);
INSERT INTO temp.ssres
WITH
  raw_prose AS (SELECT d.rowid AS doc_id, d.key AS key, d.section AS section, f.rank AS rank,
      snippet(store_fts_prose, -1, '<b>', '</b>', '...', 12) AS snip
    FROM store_fts_prose f JOIN store_docs d ON d.rowid = f.rowid, temp.ssr s
    WHERE s.mode = 'hybrid' AND f.store_fts_prose MATCH (SELECT m FROM temp.sst) AND d.namespace = s.ns),
  ranked_prose AS (SELECT doc_id, key, section, row_number() OVER (ORDER BY rank) AS rnk, snip FROM raw_prose),
  raw_code AS (SELECT d.rowid AS doc_id, d.key AS key, d.section AS section, f.rank AS rank,
      snippet(store_fts_code, -1, '<b>', '</b>', '...', 12) AS snip
    FROM store_fts_code f JOIN store_docs d ON d.rowid = f.rowid, temp.ssr s
    WHERE s.mode IN ('hybrid', 'trigram') AND f.store_fts_code MATCH (SELECT m FROM temp.sst) AND d.namespace = s.ns),
  ranked_code AS (SELECT doc_id, key, section, row_number() OVER (ORDER BY rank) AS rnk, snip FROM raw_code),
  combined AS (SELECT doc_id, key, section, 1.0 / (60.0 + rnk) AS score, snip FROM ranked_prose
    UNION ALL SELECT doc_id, key, section, 1.0 / (60.0 + rnk) AS score, snip FROM ranked_code),
  fused AS (SELECT doc_id, key, section, round(sum(score), 6) AS score, max(snip) AS snippet FROM combined GROUP BY doc_id, key, section)
SELECT doc_id, key, section, score, snippet FROM fused;
SELECT json_object('namespace', s.ns, 'query', s.q, 'mode', s.mode, 'total_matches', (SELECT count(*) FROM temp.ssres),
  'results', json((SELECT json_group_array(json(json_object('key', key, 'section', section, 'snippet', snippet, 'score', score)) ORDER BY score DESC, doc_id)
    FROM (SELECT * FROM temp.ssres ORDER BY score DESC, doc_id LIMIT (SELECT lim FROM temp.ssr)))))
FROM temp.ssr s;
COMMIT;
RANKED
  } > "$SCRATCH/store-search.sql"
  if ! sq -bail "$DB_PATH" < "$SCRATCH/store-search.sql"; then
    refuse 2 ERR_STORAGE_READ "the storage search failed"
  fi
}

# store_search <namespace> <mode> [<limit>]: exact over the raw stored values, and the
# ranked modes over the derived store documents when the driver declares search.schema.
store_search() {
  FN=store.search
  [ $# -ge 2 ] && [ $# -le 3 ] || refuse 1 ERR_INVALID_ARGUMENT "store.search takes the namespace, the mode, and an optional limit"
  ss_ns=$1; ss_mode=$2; ss_lim=${3:-20}
  case "$ss_mode" in
    ''|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$ss_mode'" ;;
  esac
  case "$ss_lim" in
    ''|*[!0-9]*|0) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a positive number: '$ss_lim'" ;;
  esac
  store_data store.search "$ss_ns"
  case ",$SD_MODES," in
    *",$ss_mode,"*) ;;
    *) refuse 1 ERR_CAPABILITY_UNSUPPORTED "mode '$ss_mode' is not declared by namespace '$ss_ns'; declared modes: $SD_MODES" ;;
  esac
  case "$ss_mode" in
    exact|hybrid|trigram) ;;
    *) refuse 1 ERR_CAPABILITY_UNSUPPORTED "mode '$ss_mode' is not supported; declared modes: exact, hybrid, trigram" ;;
  esac
  ss_q=$(store_query_read) || exit $?
  ss_q=${ss_q%X}
  case "$ss_q" in *[![:space:]]*) ;; *) refuse 1 ERR_INVALID_ARGUMENT "the search query is empty" ;; esac
  if [ "$ss_mode" = exact ]; then
    ss_core=$(store_search_core) || refuse 2 ERR_STORAGE_READ "the storage core search engine is not installed"
    scratch
    : > "$SCRATCH/man"
    ss_err="$SCRATCH/search-err"
    if [ -f "$DB_PATH" ]; then
      db_init
      mkdir -p "$SCRATCH/values" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch folder"
      if ! sq -bail "$DB_PATH" "SELECT key FROM store WHERE namespace = $(store_sqlq "$ss_ns") ORDER BY key COLLATE BINARY;" > "$SCRATCH/keys" 2>/dev/null; then
        refuse 2 ERR_STORAGE_READ "the storage read failed"
      fi
      ss_n=0
      while IFS= read -r ss_k || [ -n "$ss_k" ]; do
        [ -n "$ss_k" ] || continue
        ss_n=$((ss_n + 1))
        ss_v="$SCRATCH/values/$ss_n"
        if ! sq -bail "$DB_PATH" "SELECT writefile($(store_sqlq "$ss_v"), value) FROM store WHERE namespace = $(store_sqlq "$ss_ns") AND key = $(store_sqlq "$ss_k");" > /dev/null 2>&1; then
          refuse 2 ERR_STORAGE_READ "cannot read the store values"
        fi
        printf '%s\t%s\n' "$ss_k" "$ss_v" >> "$SCRATCH/man"
      done < "$SCRATCH/keys"
    fi
    ss_out=$("$ss_core" exact "$SD_FILE" "$ss_ns" "$ss_q" "$ss_lim" "$SCRATCH/man" 2>"$ss_err")
    ss_rc=$?
    if [ "$ss_rc" -ne 0 ]; then
      ss_msg=$(head -n 1 "$ss_err" 2>/dev/null)
      case "$ss_msg" in store-search:\ error:\ *) ss_msg=${ss_msg#store-search: error: } ;; esac
      [ -n "$ss_msg" ] || ss_msg="the store search failed"
      ss_code=""
      case "$ss_msg" in
        *' ('*')')
          ss_code=${ss_msg##*' ('}
          ss_code=${ss_code%)}
          ss_msg=${ss_msg%' ('*}
          ;;
      esac
      [ -n "$ss_code" ] || ss_code=ERR_STORAGE_READ
      [ "$ss_rc" -eq 1 ] || ss_rc=2
      refuse "$ss_rc" "$ss_code" "$ss_msg"
    fi
    printf '%s\n' "$ss_out"
    exit 0
  fi
  if [ ! -f "$DB_PATH" ]; then
    printf '{"namespace":"%s","query":"%s","mode":"%s","total_matches":0,"results":[]}\n' \
      "$(store_json "$ss_ns")" "$(store_json "$ss_q")" "$(store_json "$ss_mode")"
    exit 0
  fi
  store_docs_ensure "$ss_ns" "$SD_SIG"
  store_search_ranked "$ss_ns" "$ss_q" "$ss_mode" "$ss_lim"
  exit 0
}

# ==============================================================================
# The refusal and the unit checks every record function shares
# ==============================================================================
# A refusal is one stderr line "<function>: error: <message> (<CODE>)" with nothing on
# stdout.

refuse() {
  printf '%s: error: %s (%s)\n' "$CMD" "$3" "$2" >&2
  exit "$1"
}

want_unit() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  slug_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$1'"
}

# unit_held <unit>: the store holds the unit (its state row)
unit_held() {
  [ "$(sq "$DB_PATH" "SELECT count(*) FROM units WHERE unit = '$(sql_escape "$1")';" 2>/dev/null)" = "1" ]
}

# ==============================================================================
# The record functions (contract 2): the argv shape here, every record rule in SQL
# ==============================================================================
# A call runs one sqlite3 process over one script: the call header (temp.arg: the function,
# the unit, the other argv tokens a1..aN, the staged payload and document files), then
# sql/lib/prelude.sql and sql/fn/<function>.sql, with sqlite3 working in sql/ so the scripts
# read their pieces by relative path. A script refuses by printing one ERR|<rc>|<code>|<msg>
# line and stopping (sql/lib/stop.sql); a write prints its answer inside its transaction
# and commits after, so an answer reaches stdout only when sqlite3 exits 0.
CALL=""
call_begin() {
  scratch
  CALL="$SCRATCH/call.sql"
  printf 'PRAGMA foreign_keys = ON;\nCREATE TEMP TABLE arg (k TEXT PRIMARY KEY, v TEXT);\n' > "$CALL"
  call_arg fn "$CMD"
}

call_arg() {
  printf "INSERT INTO temp.arg VALUES ('%s', '%s');\n" "$1" "$(sql_escape "$2")" >> "$CALL"
}

# call_argv <token...>: the argv after the unit as a1..aN, na their count
call_argv() {
  ca_i=0
  for ca_v in "$@"; do
    ca_i=$((ca_i + 1))
    call_arg "a$ca_i" "$ca_v"
  done
  call_arg na "$ca_i"
}

# the payload lines, staged whole; the SQL decodes them
call_payload() {
  cat > "$SCRATCH/pay" || refuse 2 ERR_STORAGE_READ "cannot read the payload"
  call_arg pay "$SCRATCH/pay"
}

# a raw document (a recipe, a report), staged whole with its byte count
call_doc() {
  cat > "$SCRATCH/doc" || refuse 2 ERR_STORAGE_READ "cannot read the document"
  call_arg doc "$SCRATCH/doc"
  call_arg docsize "$(wc -c < "$SCRATCH/doc" | tr -d ' ')"
}

# call_run <function script> <read|write>: the script over the store; its refusal, a storage
# failure, or its answer
call_run() {
  printf '.read lib/prelude.sql\n.read fn/%s.sql\n' "$1" >> "$CALL"
  (cd "$SQL_DIR" && sq -bail "$DB_PATH" < "$CALL" > "$SCRATCH/out" 2> "$SCRATCH/err")
  cr_rc=$?
  case "$(sed -n '1p' "$SCRATCH/out")" in
    'ERR|'*)
      cr_l=$(cat "$SCRATCH/out")
      cr_l=${cr_l#ERR|}
      cr_t=${cr_l%%|*}
      cr_l=${cr_l#*|}
      cr_c=${cr_l%%|*}
      cr_m=${cr_l#*|}
      printf '%s: error: %s (%s)\n' "$CMD" "$cr_m" "$cr_c" >&2
      exit "$cr_t"
      ;;
  esac
  if [ "$cr_rc" -ne 0 ]; then
    cr_e=$(sed -n '1p' "$SCRATCH/err")
    # a signal ended the sqlite3 (rc above 128): its first stderr line is the shell's job
    # line, which names the plugin's files; the message names the interruption instead
    [ "$cr_rc" -gt 128 ] && cr_e="sqlite3 was interrupted (exit $cr_rc); the transaction rolled back"
    case "$cr_e" in
      *"database is locked"*|*"database table is locked"*) refuse 2 ERR_STORAGE_LOCKED "the store is locked by another writer" ;;
    esac
    [ "$2" = write ] && refuse 2 ERR_STORAGE_WRITE "the storage write failed: $cr_e"
    refuse 2 ERR_STORAGE_READ "the storage read failed: $cr_e"
  fi
  cat "$SCRATCH/out"
  exit 0
}

# px_extra <n> <argv...>: no argument beyond the n the function takes
px_extra() {
  pe_n=$1
  shift
  [ $# -le "$pe_n" ] || refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$(eval "printf '%s' \"\${$((pe_n + 1))}\"")'"
}

# want_held <unit>: a well formed unit the store holds (a read of a store without a database
# file finds no unit)
want_held() {
  want_unit "${1:-}"
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
  unit_held "$1" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
}

# rec_read <function> <unit> <argv after the unit...>: a read of one unit (the held check in
# SQL, lib/held.sql)
rec_read() {
  rr_f=$1
  rr_u=$2
  shift 2
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$rr_u' not found"
  call_begin
  call_arg unit "$rr_u"
  call_argv "$@"
  call_run "$rr_f" read
}

# rec_write <function> <unit> <payload|doc|none> <argv after the unit...>: a write of one unit,
# its input staged, under the unit write lock, in one transaction
rec_write() {
  rw_f=$1
  rw_u=$2
  rw_in=$3
  shift 3
  [ -f "$DB_PATH" ] || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$rw_u' not found"
  call_begin
  call_arg unit "$rw_u"
  call_argv "$@"
  case "$rw_in" in
    payload) call_payload ;;
    doc) call_doc ;;
  esac
  acquire_lock "$rw_u"
  db_init
  call_run "$rw_f" write
}

want_task_slug() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the task slug"
  slug_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed task slug '$1'"
}

want_lane() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
  slug_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$1'"
}

capability() {
  printf '{"driver":"fts5","version":"3.0.0","contract":"2","functions":["capability","storage.health","session.create","session.list","session.load","session.refload","session.board","session.audit","session.stamp","session.next","session.refs","session.close","session.reopen","session.units","session.refs_to","task.add","task.update","task.start","task.complete","task.reopen","task.drop","task.list","task.get","entry.record","entry.get","entry.list","entry.closure","finding.add","finding.update","finding.supersede","finding.drop","finding.get","finding.list","lane.create","lane.record","lane.write_report","lane.get","search.query"],"store":["list","get","put","delete","changes","batch","scan"],"search_modes":["exact","hybrid","trigram"],"optional":["store","store.changelog","search.schema"]}\n'
}

# storage.health: a probe, never a write: an absent database reports degraded with store
# absent (the store starts at the first bootstrap), and a store at another schema reports
# error
storage_health() {
  # an sqlite3 older than the driver's minimum serves no function (db_init refuses each), so
  # the probe reports error naming it, never ok (lanes/si-f5-fts5-review/report F3)
  sh_sv=$(sq :memory: "SELECT sqlite_version();" 2>/dev/null)
  sh_svn=$(printf '%s\n' "$sh_sv" | awk -F. '{ printf "%d", ($1 * 1000000) + ($2 * 1000) + $3 }')
  if [ "${sh_svn:-0}" -lt "$DB_SQLITE_MIN" ]; then
    sh_st=absent; sh_a=0
    if [ -f "$DB_PATH" ]; then
      sh_st=present
      sh_a=$(sq "$DB_PATH" "SELECT count(*) FROM units WHERE status = 'ACTIVE';" 2>/dev/null) || sh_a=0
      case "$sh_a" in ""|*[!0-9]*) sh_a=0 ;; esac
    fi
    printf '{"driver":"fts5","health":"error","detail":"sqlite3 %s is older than the 3.44 the driver needs","store":"%s","active_units":%s}\n' "${sh_sv:-unknown}" "$sh_st" "$sh_a"
    exit 0
  fi
  if [ ! -f "$DB_PATH" ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database not created yet (will be initialized on bootstrap)","store":"absent","active_units":0}\n'
    exit 0
  fi
  sh_p=$(sq "$DB_PATH" "SELECT (SELECT user_version FROM pragma_user_version) || '|' || (SELECT count(*) FROM sqlite_master WHERE type = 'table');" 2>/dev/null) || {
    printf '{"driver":"fts5","health":"error","detail":"database unreadable","store":"absent","active_units":0}\n'
    exit 0
  }
  sh_v=${sh_p%%|*}
  sh_t=${sh_p#*|}
  if [ "$sh_t" = 0 ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database present, no unit stored yet","store":"absent","active_units":0}\n'
    exit 0
  fi
  if [ "$sh_v" != "$DB_SCHEMA_VERSION" ]; then
    # a store at another schema serves no function (db_init refuses each), so the probe
    # reports error naming its version, never degraded or ok
    printf '{"driver":"fts5","health":"error","detail":"database at schema %s; this driver reads %s and has no upgrade path","store":"present","active_units":0}\n' "$sh_v" "$DB_SCHEMA_VERSION"
    exit 0
  fi
  sh_c=$(sq "$DB_PATH" "SELECT count(*) || '|' || (SELECT count(*) FROM units WHERE status = 'ACTIVE') FROM units;" 2>/dev/null) || sh_c="0|0"
  sh_n=${sh_c%%|*}
  sh_a=${sh_c#*|}
  if [ "$sh_n" = 0 ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database present, no unit stored yet","store":"absent","active_units":0}\n'
  elif [ ! -w "$DB_PATH" ]; then
    printf '{"driver":"fts5","health":"error","detail":"database file not writable","store":"present","active_units":%s}\n' "$sh_a"
  elif ! sq "$DB_PATH" "PRAGMA quick_check;" 2>/dev/null | grep -q '^ok$'; then
    printf '{"driver":"fts5","health":"error","detail":"database integrity check failed","store":"present","active_units":%s}\n' "$sh_a"
  else
    printf '{"driver":"fts5","health":"ok","detail":"database present and writable","store":"present","active_units":%s}\n' "$sh_a"
  fi
  exit 0
}

# search.query <unit> [--limit=N] [--entity=T] [--mode=M] | query: the shapes here, the
# exact rule over the lines table and the ranked modes over the FTS5 tables in SQL
search_query() {
  want_unit "${1:-}"
  sq_u=$1
  shift
  sq_limit=20
  sq_entity=all
  sq_mode=exact
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$sq_a'" ;;
    esac
  done
  case "$sq_limit" in
    ""|*[!0-9]*|0) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a positive number: '$sq_limit'" ;;
  esac
  case "$sq_entity" in
    all|session|task|entry|finding|lane|lane_entry) ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "unknown entity type '$sq_entity' (session, task, entry, finding, lane, lane_entry, all)" ;;
  esac
  case "$sq_mode" in
    ""|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$sq_mode'" ;;
  esac
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sq_u' not found"
  call_begin
  call_arg unit "$sq_u"
  call_arg limit "$sq_limit"
  call_arg entity "$sq_entity"
  call_arg mode "$sq_mode"
  call_payload
  case "$sq_mode" in
    hybrid|trigram) call_run search.ranked read ;;
    *) call_run search.query read ;;
  esac
}

# session.refload <unit>...: every named unit well formed and held, in argv order
session_refload() {
  [ $# -ge 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  db_open_read || { want_unit "$1"; refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"; }
  sr_held=" $(sq "$DB_PATH" "SELECT group_concat(unit, ' ') FROM units;" 2>/dev/null) "
  for sr_u in "$@"; do
    want_unit "$sr_u"
    case "$sr_held" in *" $sr_u "*) ;; *) refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sr_u' not found" ;; esac
  done
  call_begin
  call_arg unit "$1"
  shift
  call_argv "$@"
  call_run session.refload read
}

case "$CMD" in
  capability) capability; exit 0 ;;
  store.list) store_list "$@" ;;
  store.get) store_get "$@" ;;
  store.put) store_put "$@" ;;
  store.delete) store_delete "$@" ;;
  store.changes) store_changes "$@" ;;
  store.batch) store_batch "$@" ;;
  store.scan) store_scan "$@" ;;
  store.search) store_search "$@" ;;

  storage.health)
    px_extra 0 "$@"
    storage_health
    ;;
  session.create)
    want_unit "${1:-}"
    px_extra 1 "$@"
    call_begin
    call_arg unit "$1"
    call_payload
    acquire_lock "$1"
    db_init
    call_run session.create write
    ;;
  session.list)
    px_extra 0 "$@"
    if [ ! -f "$DB_PATH" ]; then
      printf '{"store":"absent","units":[]}\n'
      exit 0
    fi
    db_init
    call_begin
    call_run session.list read
    ;;
  session.load)
    [ $# -gt 1 ] && want_held "${1:-}"
    want_unit "${1:-}"
    px_extra 1 "$@"
    rec_read session.load "$1"
    ;;
  session.refload) session_refload "$@" ;;
  session.board|session.audit)
    px_extra 1 "$@"
    want_unit "${1:-}"
    rec_read "$CMD" "$1"
    ;;
  session.stamp|session.next|session.close|session.reopen)
    px_extra 1 "$@"
    want_unit "${1:-}"
    rec_write "$CMD" "$1" payload
    ;;
  session.refs)
    want_unit "${1:-}"
    sf_u=$1
    shift
    sf_bad=""
    for sf_r in "$@"; do
      if [ -z "$sf_bad" ] && ! slug_valid "$sf_r"; then sf_bad=$sf_r; sf_badset=1; fi
    done
    [ -f "$DB_PATH" ] || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sf_u' not found"
    call_begin
    call_arg unit "$sf_u"
    call_argv "$@"
    [ -n "${sf_badset:-}" ] && call_arg badref "$sf_bad"
    call_payload
    acquire_lock "$sf_u"
    db_init
    call_run session.refs write
    ;;
  session.units)
    [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the repo"
    case "$1" in
      [!A-Za-z0-9._-]*|*[!A-Za-z0-9._/-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed repo '$1'" ;;
    esac
    px_extra 1 "$@"
    if [ ! -f "$DB_PATH" ]; then
      printf '{"repo":"%s","units":[],"known_repos":[]}\n' "$1"
      exit 0
    fi
    db_init
    call_begin
    call_arg unit "$1"
    call_run session.units read
    ;;
  session.refs_to)
    want_unit "${1:-}"
    px_extra 1 "$@"
    if [ ! -f "$DB_PATH" ]; then
      printf '{"unit":"%s","referrers":[]}\n' "$1"
      exit 0
    fi
    db_init
    call_begin
    call_arg unit "$1"
    call_run session.refs_to read
    ;;
  task.add|task.update|task.start|task.complete|task.reopen|task.drop|task.get)
    px_extra 2 "$@"
    want_unit "${1:-}"
    want_task_slug "${2:-}"
    case "$CMD" in
      task.get) rec_read "$CMD" "$1" "$2" ;;
      *) rec_write "$CMD" "$1" payload "$2" ;;
    esac
    ;;
  task.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      TODO|IN_PROGRESS|DONE|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "task.list takes TODO, IN_PROGRESS, DONE, or all: '${2:-}'" ;;
    esac
    rec_read "$CMD" "$1" "$2"
    ;;
  entry.record)
    px_extra 1 "$@"
    want_unit "${1:-}"
    rec_write "$CMD" "$1" payload
    ;;
  entry.get|entry.closure)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the entry slug"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed entry slug '$2'"
    rec_read "$CMD" "$1" "$2"
    ;;
  entry.list)
    want_unit "${1:-}"
    el_u=$1
    shift
    for el_a in "$@"; do
      case "$el_a" in
        --anchor=A[0-9]*) case "${el_a#--anchor=A}" in *[!0-9]*) refuse 1 ERR_INVALID_ARGUMENT "--anchor takes A<N>: '$el_a'" ;; esac ;;
        --group=?*) case "${el_a#--group=}" in [!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed group in '$el_a'" ;; esac ;;
        *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$el_a'" ;;
      esac
    done
    rec_read "$CMD" "$el_u" "$@"
    ;;
  finding.add|finding.update|finding.drop|finding.get)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the finding NAME"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$2'"
    case "$CMD" in
      finding.get) rec_read "$CMD" "$1" "$2" ;;
      *) rec_write "$CMD" "$1" payload "$2" ;;
    esac
    ;;
  finding.supersede)
    px_extra 3 "$@"
    want_unit "${1:-}"
    for fs_n in "${2:-}" "${3:-}"; do
      [ -n "$fs_n" ] || refuse 1 ERR_INVALID_ARGUMENT "finding.supersede takes the unit, OLD, and NEW"
      name_valid "$fs_n" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$fs_n'"
    done
    rec_write "$CMD" "$1" payload "$2" "$3"
    ;;
  finding.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      active|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "finding.list takes active or all: '${2:-}'" ;;
    esac
    rec_read "$CMD" "$1" "$2"
    ;;
  lane.create|lane.write_report)
    px_extra 2 "$@"
    want_held "${1:-}"
    want_lane "${2:-}"
    rec_write "$CMD" "$1" doc "$2"
    ;;
  lane.record)
    px_extra 2 "$@"
    want_unit "${1:-}"
    want_lane "${2:-}"
    rec_write "$CMD" "$1" payload "$2"
    ;;
  lane.get)
    px_extra 3 "$@"
    want_unit "${1:-}"
    want_lane "${2:-}"
    case "${3:-}" in
      recipe|journal|report) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "lane.get takes recipe, journal, or report: '${3:-}'" ;;
    esac
    rec_read "$CMD" "$1" "$2" "$3"
    ;;
  search.query) search_query "$@" ;;

  *)
    refuse 2 ERR_CAPABILITY_UNSUPPORTED "unknown function '$CMD'"
    ;;
esac
exit 0
