#!/bin/sh
# SQLite FTS5 storage driver implementing the Storage Provider Interface (SPI).
#
# The store keeps every artifact's canonical text verbatim (the artifacts table) and a
# derived relational index rebuilt from that text (index.sh), which feeds the dual FTS5
# tables and the pure SQL RRF search. Native methods: capability, storage.health,
# artifact.read, artifact.write, artifact.list, session.create, session.list, and
# search.query. Every other method (session.*, task.*, entry.*, finding.*, lane.*,
# resolve.ref) is the record grammar itself: it runs through the reference serialization
# (the posix driver) over the unit materialized from the store into a scratch workspace,
# and every artifact it changed is stored back with its reindex in one transaction, so
# the two drivers answer every method alike by construction.
#
# Transport: argv carries the method and its identifiers; free-text fields arrive on
# stdin as payload lines key=value (escaped), a single-document write as raw stdin.
# Exit tiers: 0 ok, 1 semantic (bad argument, absent entity), 2 storage or driver.

set -u

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'fts5-driver: error: sqlite3 executable not found (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
MODULE_DIR=$(CDPATH="" cd "$SCRIPT_DIR/.." && pwd)
SCHEMA_SQL="$MODULE_DIR/schema.sql"

find_workspace_root() {
  curr="$PWD"
  while [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

ROOT=$(find_workspace_root)

if [ -n "${CTX_STORAGE_SQLITE_PATH:-}" ]; then
  DB_PATH="$CTX_STORAGE_SQLITE_PATH"
elif [ -f "$ROOT/.contexture/config" ] && grep -Eq '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" 2>/dev/null; then
  val=$(grep -E '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" | head -n1 | sed -E 's/^(session\.)?storage\.database[:=[:space:]]+//' | tr -d ' \t\r\n"')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
elif [ -f "$ROOT/.contexture/storage.conf" ] && grep -Eq '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" 2>/dev/null; then
  val=$(grep -E '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" | head -n1 | sed -E 's/^storage\.database[:[:space:]]+//')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
else
  DB_PATH="$ROOT/.contexture/sessions.db"
fi

# scratch lives in the workspace drawer when it is writable
DB_TMP="$ROOT/.contexture/tmp"
if ! mkdir -p "$DB_TMP" 2>/dev/null || [ ! -w "$DB_TMP" ]; then
  DB_TMP="${TMPDIR:-/tmp}"
fi

# the open path (fresh schema, the upgrades, later tables): one home for driver and migration
. "$MODULE_DIR/db-init.sh"
# the derived index rebuilt from an artifact's text: one home for driver and migration
. "$MODULE_DIR/index.sh"

sql_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

slug_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# a write that sqlite3 refuses (a constraint, a lock, a full disk) must never print its
# success payload: storage-tier error, rc 2; -bail stops at the first failing statement
write_failed() {
  printf '%s: error: the storage write failed (ERR_STORAGE_WRITE)\n' "$CMD" >&2
  exit 2
}

unit_exists() {
  [ -f "$DB_PATH" ] || return 1
  [ "$(sq "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$1")';")" -gt 0 ] 2>/dev/null
}

# a read never creates the store: without a database file there is nothing to read
db_open_read() {
  [ -f "$DB_PATH" ] || return 1
  db_init
  return 0
}

SCRATCH=""
cleanup() {
  [ -n "$SCRATCH" ] && rm -rf "$SCRATCH"
  [ -n "${LOCK_DIR:-}" ] && rm -rf "$LOCK_DIR"
  return 0
}
trap cleanup EXIT
# a HUP, INT, or TERM exits through the EXIT trap (dash runs no EXIT trap on a signal it
# does not trap), so an interrupted method leaves no scratch unit and no held lock
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

scratch() {
  if [ -z "$SCRATCH" ]; then
    SCRATCH=$(mktemp -d "$DB_TMP/fts5-ws.XXXXXX") || {
      printf '%s: error: cannot create a scratch folder (ERR_STORAGE_WRITE)\n' "$CMD" >&2
      exit 2
    }
  fi
}

# a unit write lock: the materialize, render, store sequence of one writer is serialized
LOCK_DIR=""
acquire_lock() {
  mkdir -p "$DB_TMP/locks" 2>/dev/null || true
  lk="$DB_TMP/locks/fts5-$1.lock"
  lk_n=0
  while ! mkdir "$lk" 2>/dev/null; do
    lk_n=$((lk_n + 1))
    if [ "$lk_n" -ge 100 ]; then
      printf "%s: error: failed to acquire the write lock of unit '%s' after 10s (ERR_STORAGE_LOCKED)\n" "$CMD" "$1" >&2
      exit 2
    fi
    sleep 0.1 2>/dev/null || sleep 1
  done
  LOCK_DIR="$lk"
}

# key_of <path below a unit folder>: the artifact key (state, lane/<l>/journal, ...)
key_of() {
  case "$1" in
    state.md|backlog.md|knowledge.md|journal.md) printf '%s\n' "${1%.md}" ;;
    lanes/*/recipe.md|lanes/*/journal.md|lanes/*/report.md)
      ko=${1#lanes/}
      printf 'lane/%s\n' "${ko%.md}"
      ;;
    *) return 1 ;;
  esac
}

if [ $# -eq 0 ]; then
  printf 'fts5-driver: error: missing command (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

CMD="$1"
shift

# ==============================================================================
# The reference serialization: the record grammar over the materialized unit
# ==============================================================================
find_reference() {
  if [ -n "${CTX_REFERENCE_DRIVER:-}" ] && [ -x "$CTX_REFERENCE_DRIVER" ]; then
    printf '%s\n' "$CTX_REFERENCE_DRIVER"; return 0
  fi
  for rf in "$ROOT/.contexture/modules/session/drivers/posix/driver" \
            "$MODULE_DIR/../session/drivers/posix/driver"; do
    if [ -x "$rf" ]; then printf '%s\n' "$rf"; return 0; fi
  done
  return 1
}

# materialize <unit> <lane>: the unit's main artifacts (and one lane's, when named) as
# files of a scratch workspace; an absent unit leaves no folder, so the grammar reports it
materialize() {
  mt_u=$1
  mt_l=$2
  mkdir -p "$SCRATCH/ws/.contexture/tmp" "$SCRATCH/ws/.contexture/sessions"
  unit_exists "$mt_u" || return 0
  mt_d="$SCRATCH/ws/.contexture/sessions/$mt_u"
  mkdir -p "$mt_d"
  mt_q=$(sql_escape "$mt_u")
  sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$mt_d")/' || name || '.md', body) FROM artifacts WHERE unit = '$mt_q' AND lane_slug = '';" >/dev/null || exit 2
  if [ -n "$mt_l" ] && slug_valid "$mt_l"; then
    mt_lq=$(sql_escape "$mt_l")
    if [ "$(sq "$DB_PATH" "SELECT count(*) FROM lanes WHERE unit = '$mt_q' AND lane_slug = '$mt_lq';")" -gt 0 ]; then
      mkdir -p "$mt_d/lanes/$mt_l"
      sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$mt_d/lanes/$mt_l")/' || name || '.md', body) FROM artifacts WHERE unit = '$mt_q' AND lane_slug = '$mt_lq';" >/dev/null || exit 2
    fi
  fi
}

delegate() {
  dl_ref=$(find_reference) || {
    printf '%s: error: the reference serialization (the posix driver) was not found; set CTX_REFERENCE_DRIVER (ERR_DRIVER_NOT_FOUND)\n' "$CMD" >&2
    exit 2
  }
  scratch
  dl_u="${1:-}"
  dl_lane=""
  case "$CMD" in
    lane.*) dl_lane="${2:-}" ;;
    resolve.ref)
      case "${2:-}" in
        lane\#*/report\#*) dl_lane="${2#lane#}"; dl_lane="${dl_lane%%/*}" ;;
        lanes/*) dl_lane="${2#lanes/}"; dl_lane="${dl_lane%%/*}" ;;
      esac
      ;;
  esac
  # the payload: the fields of a payload method, the raw body of a document write
  dl_in=/dev/null
  case "$CMD" in
    session.init|session.stamp|session.pointer|task.add|task.update|task.start|task.complete|task.drop|entry.record|finding.add|finding.update|finding.supersede|lane.create|lane.record|lane.close)
      dl_in="$SCRATCH/payload"; cat > "$dl_in" ;;
    lane.report)
      for dl_a in "$@"; do [ "$dl_a" = "--write" ] && { dl_in="$SCRATCH/payload"; cat > "$dl_in"; }; done ;;
  esac
  dl_write=1
  case "$CMD" in
    session.load|session.board|session.audit|task.list|task.show|entry.show|entry.list|entry.anchors|finding.show|finding.list|lane.show|lane.status|resolve.ref) dl_write=0 ;;
    lane.report) [ "$dl_in" = /dev/null ] && dl_write=0 ;;
  esac
  if [ "$dl_write" -eq 1 ]; then
    db_init
    slug_valid "$dl_u" && acquire_lock "$dl_u"
  else
    db_open_read || true
  fi
  materialize "$dl_u" "$dl_lane"
  if [ "$dl_write" -eq 1 ]; then
    cp -R "$SCRATCH/ws/.contexture/sessions" "$SCRATCH/pre"
  fi
  (cd "$SCRATCH/ws" && "$dl_ref" "$CMD" "$@" < "$dl_in" > "$SCRATCH/out" 2> "$SCRATCH/err")
  dl_rc=$?
  if [ "$dl_rc" -eq 0 ] && [ "$dl_write" -eq 1 ] && slug_valid "$dl_u" && [ -d "$SCRATCH/ws/.contexture/sessions/$dl_u" ]; then
    dl_now=$(now_utc)
    dl_sql="$SCRATCH/store.sql"
    dl_n=0
    {
      printf 'PRAGMA foreign_keys = ON;\nBEGIN IMMEDIATE;\n'
      printf "INSERT OR IGNORE INTO sessions (unit, status, current_anchor, objective, next_action, repos, ref_sessions, created_at) VALUES ('%s', 'ACTIVE', 'A1', '', 'plan the next move', '[]', '[]', '%s');\n" "$(sql_escape "$dl_u")" "$dl_now"
    } > "$dl_sql"
    dl_files=$(cd "$SCRATCH/ws/.contexture/sessions/$dl_u" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)
    for dl_f in $dl_files; do
      dl_key=$(key_of "$dl_f") || continue
      dl_path="$SCRATCH/ws/.contexture/sessions/$dl_u/$dl_f"
      if [ -f "$SCRATCH/pre/$dl_u/$dl_f" ] && cmp -s "$dl_path" "$SCRATCH/pre/$dl_u/$dl_f"; then
        continue
      fi
      idx_artifact_sql "$dl_u" "$dl_key" "$dl_path" "$dl_now" >> "$dl_sql"
      dl_n=$((dl_n + 1))
    done
    printf 'COMMIT;\n' >> "$dl_sql"
    if [ "$dl_n" -gt 0 ]; then
      sq -bail "$DB_PATH" < "$dl_sql" > /dev/null || write_failed
    fi
  fi
  cat "$SCRATCH/out"
  cat "$SCRATCH/err" >&2
  exit "$dl_rc"
}

# ==============================================================================
# Search: the uniform result shape over the FTS5 index
# ==============================================================================
sanitize_fts_query() {
  # each token quoted, so a hyphen or punctuation never reads as FTS5 syntax; Turkish
  # characters and symbols pass unchanged
  printf '%s' "$1" | awk '{
    for (i = 1; i <= NF; i++) {
      gsub(/"/, "\"\"", $i);
      printf "\"%s\"%s", $i, (i == NF ? "" : " ");
    }
  }'
}

search_query() {
  sq_u="${1:-}"
  [ $# -gt 0 ] && shift
  sq_limit=20
  sq_entity=""
  sq_mode="hybrid"
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *) printf "search.query: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$sq_a" >&2; exit 1 ;;
    esac
  done
  scratch
  cat > "$SCRATCH/payload"
  sq_q=$(awk 'index($0, "query=") == 1 { v = substr($0, 7); gsub(/\\\\/, "\001", v); gsub(/\\n/, "\n", v); gsub(/\\t/, "\t", v); gsub(/\\r/, "\r", v); gsub(/\001/, "\\", v); printf "%s", v; exit }' "$SCRATCH/payload"; printf x)
  sq_q=${sq_q%x}
  if [ -z "$sq_u" ] || [ -z "$(printf '%s' "$sq_q" | tr -d ' \t\n')" ]; then
    printf 'search.query: error: missing required arguments (unit, query) (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  case "$sq_limit" in
    ""|*[!0-9]*|0) printf "search.query: error: --limit takes a positive number: '%s' (ERR_INVALID_ARGUMENT)\n" "$sq_limit" >&2; exit 1 ;;
  esac
  case "$sq_entity" in
    all) sq_entity="" ;;
    ""|session|task|entry|finding|lane|lane_entry) ;;
    *) printf "search.query: error: unknown entity type '%s' (session, task, entry, finding, lane, lane_entry, all) (ERR_INVALID_ARGUMENT)\n" "$sq_entity" >&2; exit 1 ;;
  esac
  case "$sq_mode" in
    hybrid|trigram|exact) ;;
    *) printf "search.query: error: unknown mode '%s' (exact, hybrid, trigram) (ERR_INVALID_ARGUMENT)\n" "$sq_mode" >&2; exit 1 ;;
  esac
  db_open_read || true
  if ! unit_exists "$sq_u"; then
    printf "search.query: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$sq_u" >&2
    exit 1
  fi
  sq_uq=$(sql_escape "$sq_u")
  sq_eq=$(sql_escape "$sq_entity")
  sq_qq=$(sql_escape "$sq_q")
  sq_safe=$(sql_escape "$(sanitize_fts_query "$sq_q")")
  sq_filter="s.unit = '$sq_uq' AND ('$sq_eq' = '' OR s.entity_type = '$sq_eq')"
  case "$sq_mode" in
    exact)
      # a case-insensitive substring over the document text, in record order; the snippet
      # is trimmed of the blank padding a document body carries (spaces, tabs, newlines)
      sq "$DB_PATH" <<EOF
WITH hits AS (
  SELECT s.doc_id, s.entity_type, s.entity_id, s.section, s.body,
         instr(lower(s.body), lower('$sq_qq')) AS pos
  FROM search_documents s
  WHERE $sq_filter AND (instr(lower(s.body), lower('$sq_qq')) > 0 OR instr(lower(s.title), lower('$sq_qq')) > 0)
),
shown AS (SELECT * FROM hits ORDER BY doc_id LIMIT $sq_limit)
SELECT json_object(
  'unit', '$sq_uq',
  'query', '$sq_qq',
  'mode', 'exact',
  'total_matches', (SELECT count(*) FROM hits),
  'results', coalesce((
    SELECT json_group_array(json_object(
      'entity_type', entity_type, 'entity_id', entity_id, 'section', section,
      'snippet', CASE WHEN pos > 0 THEN trim(substr(body, max(1, pos - 40), 120), ' ' || char(9) || char(10) || char(13)) ELSE trim(substr(body, 1, 120), ' ' || char(9) || char(10) || char(13)) END))
    FROM (SELECT * FROM shown ORDER BY doc_id)
  ), json_array())
);
EOF
      ;;
    trigram)
      sq "$DB_PATH" <<EOF
WITH
  raw AS (
    SELECT rowid AS doc_id, rank, snippet(fts_code, -1, '<b>', '</b>', '...', 12) AS snip
    FROM fts_code WHERE fts_code MATCH '$sq_safe'
  ),
  ranked AS (SELECT doc_id, row_number() OVER (ORDER BY rank) AS rnk, snip FROM raw),
  hits AS (
    SELECT r.doc_id, s.entity_type, s.entity_id, s.section, round(1.0 / (60.0 + r.rnk), 6) AS rrf_score, 1 AS sources, r.snip AS snippet
    FROM ranked r JOIN search_documents s ON s.doc_id = r.doc_id
    WHERE $sq_filter
  ),
  shown AS (SELECT * FROM hits ORDER BY rrf_score DESC, doc_id LIMIT $sq_limit)
SELECT json_object(
  'unit', '$sq_uq',
  'query', '$sq_qq',
  'mode', 'trigram',
  'total_matches', (SELECT count(*) FROM hits),
  'results', coalesce((
    SELECT json_group_array(json_object(
      'entity_type', entity_type, 'entity_id', entity_id, 'section', section, 'snippet', snippet,
      'rrf_score', rrf_score, 'sources', sources))
    FROM (SELECT * FROM shown ORDER BY rrf_score DESC, doc_id)
  ), json_array())
);
EOF
      ;;
    hybrid)
      # Reciprocal Rank Fusion of the porter table and the trigram table
      sq "$DB_PATH" <<EOF
WITH
  raw_prose AS (
    SELECT rowid AS doc_id, rank, snippet(fts_prose, -1, '<b>', '</b>', '...', 12) AS snip
    FROM fts_prose WHERE fts_prose MATCH '$sq_safe'
  ),
  ranked_prose AS (SELECT doc_id, row_number() OVER (ORDER BY rank) AS rnk, snip FROM raw_prose),
  raw_code AS (
    SELECT rowid AS doc_id, rank, snippet(fts_code, -1, '<b>', '</b>', '...', 12) AS snip
    FROM fts_code WHERE fts_code MATCH '$sq_safe'
  ),
  ranked_code AS (SELECT doc_id, row_number() OVER (ORDER BY rank) AS rnk, snip FROM raw_code),
  combined AS (
    SELECT doc_id, 1.0 / (60.0 + rnk) AS score, snip FROM ranked_prose
    UNION ALL
    SELECT doc_id, 1.0 / (60.0 + rnk) AS score, snip FROM ranked_code
  ),
  fused AS (
    SELECT c.doc_id, round(sum(c.score), 6) AS rrf_score, count(c.doc_id) AS sources, max(c.snip) AS snippet
    FROM combined c GROUP BY c.doc_id
  ),
  hits AS (
    SELECT f.doc_id, s.entity_type, s.entity_id, s.section, f.rrf_score, f.sources, f.snippet
    FROM fused f JOIN search_documents s ON s.doc_id = f.doc_id
    WHERE $sq_filter
  ),
  shown AS (SELECT * FROM hits ORDER BY rrf_score DESC, doc_id LIMIT $sq_limit)
SELECT json_object(
  'unit', '$sq_uq',
  'query', '$sq_qq',
  'mode', 'hybrid',
  'total_matches', (SELECT count(*) FROM hits),
  'results', coalesce((
    SELECT json_group_array(json_object(
      'entity_type', entity_type, 'entity_id', entity_id, 'section', section, 'snippet', snippet,
      'rrf_score', rrf_score, 'sources', sources))
    FROM (SELECT * FROM shown ORDER BY rrf_score DESC, doc_id)
  ), json_array())
);
EOF
      ;;
  esac
  exit 0
}

# ==============================================================================
# The native methods
# ==============================================================================
case "$CMD" in
  capability)
    cat <<'EOF'
{
  "driver": "fts5",
  "version": "2.0.0",
  "capabilities": [
    "session.lifecycle",
    "task.crud",
    "task.atomic_completion",
    "entry.journal",
    "finding.crud",
    "finding.knowledge",
    "lane.artifacts",
    "lane.lifecycle",
    "resolve.symbolic",
    "search.keyword",
    "search.fts5",
    "search.rrf",
    "search.trigram",
    "artifact.store"
  ]
}
EOF
    exit 0
    ;;

  storage.health)
    # a probe, never a write: an absent database, or one that holds no unit yet, reports
    # degraded (the store starts at the first bootstrap), and is never created here
    if [ ! -f "$DB_PATH" ]; then
      printf '{"driver":"fts5","health":"degraded","detail":"database not created yet (will be initialized on bootstrap)"}\n'
    elif [ "$(sq "$DB_PATH" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='sessions';" 2>/dev/null)" != "1" ] || [ "$(sq "$DB_PATH" "SELECT count(*) FROM sessions;" 2>/dev/null)" = "0" ]; then
      printf '{"driver":"fts5","health":"degraded","detail":"database present, no session stored yet"}\n'
    elif [ ! -w "$DB_PATH" ]; then
      printf '{"driver":"fts5","health":"error","detail":"database file not writable"}\n'
    elif ! sq "$DB_PATH" "PRAGMA quick_check;" 2>/dev/null | grep -q '^ok$'; then
      printf '{"driver":"fts5","health":"error","detail":"database integrity check failed"}\n'
    else
      printf '{"driver":"fts5","health":"ok","detail":"database present and writable"}\n'
    fi
    exit 0
    ;;

  artifact.read)
    ar_u="${1:-}"
    ar_key="${2:-}"
    if [ -z "$ar_u" ] || [ -z "$ar_key" ]; then
      printf 'artifact.read: error: missing required arguments (unit, key) (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    case "$ar_key" in
      state|backlog|knowledge|journal) ar_lane=""; ar_name="$ar_key" ;;
      lane/*/recipe|lane/*/journal|lane/*/report) ar_rest=${ar_key#lane/}; ar_lane=${ar_rest%/*}; ar_name=${ar_rest##*/} ;;
      *) printf "artifact.read: error: unknown artifact key '%s' (ERR_INVALID_ARGUMENT)\n" "$ar_key" >&2; exit 1 ;;
    esac
    if ! db_open_read; then
      printf "artifact.read: error: artifact '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$ar_key" "$ar_u" >&2
      exit 1
    fi
    scratch
    sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$SCRATCH/art")', body) FROM artifacts WHERE unit = '$(sql_escape "$ar_u")' AND lane_slug = '$(sql_escape "$ar_lane")' AND name = '$(sql_escape "$ar_name")';" > /dev/null || exit 2
    if [ ! -f "$SCRATCH/art" ]; then
      printf "artifact.read: error: artifact '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$ar_key" "$ar_u" >&2
      exit 1
    fi
    cat "$SCRATCH/art"
    exit 0
    ;;

  artifact.write)
    aw_u="${1:-}"
    aw_key="${2:-}"
    if [ -z "$aw_u" ] || [ -z "$aw_key" ]; then
      printf 'artifact.write: error: missing required arguments (unit, key) (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    case "$aw_key" in
      state|backlog|knowledge|journal) ;;
      lane/*/recipe|lane/*/journal|lane/*/report)
        aw_l=${aw_key#lane/}; aw_l=${aw_l%/*}
        slug_valid "$aw_l" || { printf "artifact.write: error: unknown artifact key '%s' (ERR_INVALID_ARGUMENT)\n" "$aw_key" >&2; exit 1; }
        ;;
      *) printf "artifact.write: error: unknown artifact key '%s' (ERR_INVALID_ARGUMENT)\n" "$aw_key" >&2; exit 1 ;;
    esac
    db_init
    if ! unit_exists "$aw_u"; then
      printf "artifact.write: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$aw_u" >&2
      exit 1
    fi
    scratch
    cat > "$SCRATCH/body" || write_failed
    { printf 'PRAGMA foreign_keys = ON;\nBEGIN IMMEDIATE;\n'; idx_artifact_sql "$aw_u" "$aw_key" "$SCRATCH/body" "$(now_utc)"; printf 'COMMIT;\n'; } > "$SCRATCH/store.sql"
    sq -bail "$DB_PATH" < "$SCRATCH/store.sql" > /dev/null || write_failed
    exit 0
    ;;

  artifact.list)
    al_u="${1:-}"
    if [ -z "$al_u" ]; then
      printf 'artifact.list: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_open_read || true
    if ! unit_exists "$al_u"; then
      printf "artifact.list: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$al_u" >&2
      exit 1
    fi
    al_q=$(sql_escape "$al_u")
    sq "$DB_PATH" <<EOF
SELECT name FROM artifacts WHERE unit = '$al_q' AND lane_slug = ''
  ORDER BY CASE name WHEN 'state' THEN 1 WHEN 'backlog' THEN 2 WHEN 'knowledge' THEN 3 ELSE 4 END;
SELECT k FROM (
  SELECT lane_slug AS l, 0 AS o, 'lane/' || lane_slug AS k FROM lanes WHERE unit = '$al_q'
  UNION ALL
  SELECT lane_slug AS l, CASE name WHEN 'recipe' THEN 1 WHEN 'journal' THEN 2 ELSE 3 END AS o, 'lane/' || lane_slug || '/' || name AS k
    FROM artifacts WHERE unit = '$al_q' AND lane_slug != ''
) ORDER BY l, o;
EOF
    exit 0
    ;;

  session.create)
    sc_u="${1:-}"
    if [ -z "$sc_u" ] || ! slug_valid "$sc_u"; then
      printf "session.create: error: malformed or missing unit '%s' (ERR_INVALID_ARGUMENT)\n" "$sc_u" >&2
      exit 1
    fi
    db_init
    if unit_exists "$sc_u"; then
      printf "session.create: error: session '%s' already exists (ERR_ENTITY_EXISTS)\n" "$sc_u" >&2
      exit 1
    fi
    sq -bail "$DB_PATH" "INSERT INTO sessions (unit, status, current_anchor, objective, next_action, repos, ref_sessions, created_at) VALUES ('$(sql_escape "$sc_u")', 'ACTIVE', 'A1', '', 'plan the next move', '[]', '[]', '$(now_utc)');" || write_failed
    printf '{"status":"ok","unit":"%s"}\n' "$sc_u"
    exit 0
    ;;

  session.list)
    # bytewise by unit, as the posix drawer lists; a unit without a state has no status
    if ! db_open_read; then
      printf '{"sessions":[]}\n'
      exit 0
    fi
    sq "$DB_PATH" <<EOF
SELECT json_object(
  'sessions', coalesce((
    SELECT json_group_array(json_object('unit', unit, 'status', st)) FROM (
      SELECT s.unit AS unit, CASE WHEN EXISTS (SELECT 1 FROM artifacts a WHERE a.unit = s.unit AND a.lane_slug = '' AND a.name = 'state') THEN s.status ELSE '' END AS st
      FROM sessions s ORDER BY s.unit)
  ), json_array())
);
EOF
    exit 0
    ;;

  search.query)
    search_query "$@"
    ;;

  session.*|task.*|entry.*|finding.*|lane.*|resolve.ref)
    delegate "$@"
    ;;

  *)
    printf 'fts5-driver: error: unknown subsystem or method '\''%s'\'' (ERR_CAPABILITY_UNSUPPORTED)\n' "$CMD" >&2
    exit 2
    ;;
esac
