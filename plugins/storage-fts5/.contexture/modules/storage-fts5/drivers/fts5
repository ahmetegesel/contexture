#!/bin/sh
# SQLite FTS5 storage driver implementing Storage Provider Interface (SPI).
# Normalized relational schema with dual FTS5 virtual tables and pure SQL RRF search.

set -u

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'fts5-driver: error: sqlite3 executable not found (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
MODULE_DIR=$(CDPATH="" cd "$SCRIPT_DIR/.." && pwd)
SCHEMA_SQL="$MODULE_DIR/schema.sql"

find_workspace_root() {
  curr="$PWD"
  while [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

ROOT=$(find_workspace_root)

if [ -n "${CTX_STORAGE_SQLITE_PATH:-}" ]; then
  DB_PATH="$CTX_STORAGE_SQLITE_PATH"
elif [ -f "$ROOT/.contexture/config" ] && grep -Eq '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" 2>/dev/null; then
  val=$(grep -E '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" | head -n1 | sed -E 's/^(session\.)?storage\.database[:=[:space:]]+//' | tr -d ' \t\r\n"')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
elif [ -f "$ROOT/.contexture/storage.conf" ] && grep -Eq '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" 2>/dev/null; then
  val=$(grep -E '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" | head -n1 | sed -E 's/^storage\.database[:[:space:]]+//')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
else
  DB_PATH="$ROOT/.contexture/sessions.db"
fi

db_init() {
  mkdir -p "$(dirname "$DB_PATH")"
  has_sessions=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='sessions';" 2>/dev/null || echo "0")
  if [ "$has_sessions" != "1" ]; then
    if [ -f "$SCHEMA_SQL" ]; then
      sqlite3 "$DB_PATH" < "$SCHEMA_SQL" >/dev/null 2>&1
    fi
  fi
}

sql_exec() {
  sqlite3 -bail "$DB_PATH" "$1"
}

sql_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

sanitize_fts_query() {
  # Wrap each token in double quotes to prevent FTS5 syntax errors with hyphens or punctuation
  # Preserves Turkish characters and symbols cleanly
  printf '%s' "$1" | awk '{
    for (i = 1; i <= NF; i++) {
      gsub(/"/, "\"\"", $i);
      printf "\"%s\"%s", $i, (i == NF ? "" : " ");
    }
  }'
}

if [ $# -eq 0 ]; then
  printf 'fts5-driver: error: missing command (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

CMD="$1"
shift

case "$CMD" in
  capability)
    cat <<'EOF'
{
  "driver": "fts5",
  "version": "1.0.0",
  "capabilities": [
    "session.lifecycle",
    "task.crud",
    "task.atomic_completion",
    "entry.journal",
    "finding.crud",
    "finding.knowledge",
    "lane.artifacts",
    "lane.lifecycle",
    "resolve.symbolic",
    "search.keyword",
    "search.fts5",
    "search.rrf",
    "search.trigram"
  ]
}
EOF
    exit 0
    ;;

  session.init)
    if [ $# -lt 2 ]; then
      printf 'session.init: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    obj="$2"
    repos="${3:-[]}"
    refs="${4:-[]}"
    exists=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists" -gt 0 ]; then
      printf 'session.init: error: session '\''%s'\'' already exists (ERR_ENTITY_EXISTS)\n' "$u" >&2
      exit 1
    fi
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" <<EOF
INSERT INTO sessions (unit, status, current_anchor, objective, next_action, repos, ref_sessions, created_at)
VALUES ('$(sql_escape "$u")', 'ACTIVE', 'A1', '$(sql_escape "$obj")', 'plan the next move', '$(sql_escape "$repos")', '$(sql_escape "$refs")', '$now');
EOF
    sqlite3 "$DB_PATH" <<EOF
SELECT json_object(
  'status', 'ok',
  'unit', unit,
  'anchor', current_anchor,
  'state', json_object(
    'status', status,
    'current_anchor', current_anchor,
    'next_action', next_action,
    'objective', objective,
    'repos', json(repos),
    'ref_sessions', json(ref_sessions)
  )
) FROM sessions WHERE unit = '$(sql_escape "$u")';
EOF
    exit 0
    ;;

  session.load)
    if [ $# -lt 1 ]; then
      printf 'session.load: error: missing unit argument (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    page="${2:-1}"
    compact="${3:-false}"
    exists=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists" -eq 0 ]; then
      printf 'session.load: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    filter_done=0
    if [ "$compact" = "true" ] || [ "$compact" = "1" ]; then
      filter_done=1
    fi
    sqlite3 "$DB_PATH" <<EOF
SELECT json_object(
  'unit', s.unit,
  'page', $page,
  'total_pages', 1,
  'complete', json('true'),
  'state', json_object(
    'status', s.status,
    'current_anchor', s.current_anchor,
    'next_action', s.next_action,
    'objective', s.objective,
    'repos', json(s.repos),
    'ref_sessions', json(s.ref_sessions)
  ),
  'backlog', coalesce((
    SELECT json_group_array(
      json_object(
        'slug', t.slug,
        'status', t.status,
        'objective', t.objective,
        'description', t.description,
        'criteria', t.acceptance_criteria,
        'details', t.implementation_details,
        'refs', json(t.refs)
      )
    ) FROM tasks t
    WHERE t.unit = s.unit AND ($filter_done = 0 OR t.status != 'DONE')
    ORDER BY t.sort_order ASC, t.id ASC
  ), json_array()),
  'knowledge', coalesce((
    SELECT json_group_array(
      json_object(
        'name', f.name,
        'summary', f.summary,
        'ref', f.ref
      )
    ) FROM findings f
    WHERE f.unit = s.unit AND f.status = 'ACTIVE'
    ORDER BY f.id ASC
  ), json_array()),
  'board_entries', coalesce((
    SELECT json_group_array(
      json_object(
        'slug', e.slug,
        'anchor', e.anchor,
        'what', e.what,
        'group', e.entry_group,
        'thread', e.thread
      )
    ) FROM entries e
    WHERE e.unit = s.unit AND e.entry_type = 'ENTRY'
      AND e.slug NOT IN (
        SELECT closes FROM entries WHERE unit = s.unit AND closes IS NOT NULL AND closes != ''
        UNION
        SELECT supersedes FROM entries WHERE unit = s.unit AND supersedes IS NOT NULL AND supersedes != ''
      )
    ORDER BY e.id ASC
  ), json_array()),
  'ref_sessions', json(s.ref_sessions)
)
FROM sessions s
WHERE s.unit = '$(sql_escape "$u")';
EOF
    exit 0
    ;;

  session.board)
    if [ $# -lt 1 ]; then
      printf 'session.board: error: missing unit argument (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    exists=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists" -eq 0 ]; then
      printf 'session.board: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    sqlite3 "$DB_PATH" <<EOF
SELECT json_object(
  'unit', s.unit,
  'anchor', s.current_anchor,
  'unclosed_entries', coalesce((
    SELECT json_group_array(
      json_object(
        'slug', e.slug,
        'anchor', e.anchor,
        'what', e.what,
        'group', e.entry_group,
        'thread', e.thread
      )
    ) FROM entries e
    WHERE e.unit = s.unit AND e.entry_type = 'ENTRY'
      AND e.slug NOT IN (
        SELECT closes FROM entries WHERE unit = s.unit AND closes IS NOT NULL AND closes != ''
        UNION
        SELECT supersedes FROM entries WHERE unit = s.unit AND supersedes IS NOT NULL AND supersedes != ''
      )
    ORDER BY e.id ASC
  ), json_array()),
  'open_tasks', coalesce((
    SELECT json_group_array(
      json_object(
        'slug', t.slug,
        'status', t.status,
        'objective', t.objective
      )
    ) FROM tasks t
    WHERE t.unit = s.unit AND t.status IN ('TODO', 'IN_PROGRESS')
    ORDER BY t.sort_order ASC, t.id ASC
  ), json_array()),
  'open_threads', coalesce((
    SELECT json_group_array(
      json_object(
        'slug', e.slug,
        'thread', e.thread,
        'what', e.what
      )
    ) FROM entries e
    WHERE e.unit = s.unit AND e.thread != 'none' AND e.thread != ''
      AND e.slug NOT IN (
        SELECT closes FROM entries WHERE unit = s.unit AND closes IS NOT NULL AND closes != ''
        UNION
        SELECT supersedes FROM entries WHERE unit = s.unit AND supersedes IS NOT NULL AND supersedes != ''
      )
    ORDER BY e.id ASC
  ), json_array())
)
FROM sessions s
WHERE s.unit = '$(sql_escape "$u")';
EOF
    exit 0
    ;;

  session.stamp)
    if [ $# -lt 2 ]; then
      printf 'session.stamp: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    receipt="$2"
    cur=$(sqlite3 "$DB_PATH" "SELECT current_anchor FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ -z "$cur" ]; then
      printf 'session.stamp: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    num=${cur#A}
    next_num=$((num + 1))
    next_anchor="A$next_num"
    entry_slug="$(date -u +"%Y-%m-%d")-anchor-$next_anchor"
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" <<EOF
BEGIN IMMEDIATE;
UPDATE sessions SET current_anchor = '$next_anchor' WHERE unit = '$(sql_escape "$u")';
INSERT INTO entries (unit, slug, entry_type, anchor, what, thread, created_at)
VALUES ('$(sql_escape "$u")', '$entry_slug', 'ANCHOR', '$next_anchor', '$(sql_escape "$receipt")', 'none', '$now');
COMMIT;
EOF
    printf '{"unit":"%s","previous_anchor":"%s","current_anchor":"%s","receipt_entry":"%s"}\n' \
      "$u" "$cur" "$next_anchor" "$receipt"
    exit 0
    ;;

  session.pointer)
    if [ $# -lt 2 ]; then
      printf 'session.pointer: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    ptr="$2"
    prev=$(sqlite3 "$DB_PATH" "SELECT next_action FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ -z "$prev" ]; then
      printf 'session.pointer: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    sqlite3 -bail "$DB_PATH" "UPDATE sessions SET next_action = '$(sql_escape "$ptr")' WHERE unit = '$(sql_escape "$u")';"
    printf '{"unit":"%s","previous_pointer":"%s","current_pointer":"%s"}\n' "$u" "$prev" "$ptr"
    exit 0
    ;;

  session.refs)
    if [ $# -lt 2 ]; then
      printf 'session.refs: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    refs="$2"
    exists=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists" -eq 0 ]; then
      printf 'session.refs: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    sqlite3 -bail "$DB_PATH" "UPDATE sessions SET ref_sessions = '$(sql_escape "$refs")' WHERE unit = '$(sql_escape "$u")';"
    sqlite3 "$DB_PATH" "SELECT json_object('unit', unit, 'ref_sessions', json(ref_sessions)) FROM sessions WHERE unit = '$(sql_escape "$u")';"
    exit 0
    ;;

  session.close)
    if [ $# -lt 1 ]; then
      printf 'session.close: error: missing unit argument (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    exists=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists" -eq 0 ]; then
      printf 'session.close: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    unclosed_t=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$(sql_escape "$u")' AND status IN ('TODO', 'IN_PROGRESS');")
    unclosed_th=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM entries e WHERE e.unit='$(sql_escape "$u")' AND e.thread != 'none' AND e.thread != '' AND e.slug NOT IN (SELECT closes FROM entries WHERE unit='$(sql_escape "$u")' AND closes IS NOT NULL UNION SELECT supersedes FROM entries WHERE unit='$(sql_escape "$u")' AND supersedes IS NOT NULL);")
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" "UPDATE sessions SET status = 'CLOSED', closed_at = '$now' WHERE unit = '$(sql_escape "$u")';"
    printf '{"unit":"%s","status":"CLOSED","unclosed_tasks":%d,"unclosed_threads":%d}\n' \
      "$u" "$unclosed_t" "$unclosed_th"
    exit 0
    ;;

  session.list)
    db_init
    status_filter="${1:-}"
    where_clause="1=1"
    if [ -n "$status_filter" ]; then
      where_clause="status = '$(sql_escape "$status_filter")'"
    fi
    sqlite3 "$DB_PATH" <<EOF
SELECT json_object(
  'sessions', coalesce((
    SELECT json_group_array(
      json_object('unit', unit, 'status', status)
    ) FROM sessions WHERE $where_clause
    ORDER BY created_at ASC
  ), json_array())
);
EOF
    exit 0
    ;;

  session.audit)
    if [ $# -lt 1 ]; then
      printf 'session.audit: error: missing unit argument (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    exists=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists" -eq 0 ]; then
      printf 'session.audit: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    sqlite3 "$DB_PATH" <<EOF
SELECT json_object(
  'unit', '$(sql_escape "$u")',
  'clean', json('true'),
  'defects', json_array(),
  'open_threads', coalesce((
    SELECT json_group_array(
      json_object('slug', e.slug, 'thread', e.thread, 'what', e.what)
    ) FROM entries e
    WHERE e.unit = '$(sql_escape "$u")' AND e.thread != 'none' AND e.thread != ''
      AND e.slug NOT IN (
        SELECT closes FROM entries WHERE unit = '$(sql_escape "$u")' AND closes IS NOT NULL AND closes != ''
        UNION
        SELECT supersedes FROM entries WHERE unit = '$(sql_escape "$u")' AND supersedes IS NOT NULL AND supersedes != ''
      )
  ), json_array())
);
EOF
    exit 0
    ;;

  task.add)
    if [ $# -lt 3 ]; then
      printf 'task.add: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    slug="$2"
    obj="$3"
    desc="${4:-}"
    crit="${5:-}"
    det="${6:-}"
    refs="${7:-[]}"
    exists_s=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists_s" -eq 0 ]; then
      printf 'task.add: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    exists_t=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$(sql_escape "$u")' AND slug='$(sql_escape "$slug")';")
    if [ "$exists_t" -gt 0 ]; then
      printf 'task.add: error: task '\''%s'\'' already exists in session '\''%s'\'' (ERR_ENTITY_EXISTS)\n' "$slug" "$u" >&2
      exit 1
    fi
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" <<EOF
INSERT INTO tasks (unit, slug, status, objective, description, acceptance_criteria, implementation_details, refs, created_at, updated_at)
VALUES ('$(sql_escape "$u")', '$(sql_escape "$slug")', 'TODO', '$(sql_escape "$obj")', '$(sql_escape "$desc")', '$(sql_escape "$crit")', '$(sql_escape "$det")', '$(sql_escape "$refs")', '$now', '$now');
EOF
    sqlite3 "$DB_PATH" <<EOF
SELECT json_object(
  'status', 'TODO',
  'unit', unit,
  'task', json_object(
    'slug', slug,
    'status', status,
    'objective', objective,
    'description', description,
    'criteria', acceptance_criteria,
    'details', implementation_details,
    'refs', json(refs)
  )
) FROM tasks WHERE unit = '$(sql_escape "$u")' AND slug = '$(sql_escape "$slug")';
EOF
    exit 0
    ;;

  task.update)
    if [ $# -lt 2 ]; then
      printf 'task.update: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    slug="$2"
    if [ $# -ge 3 ]; then
      case "$3" in
        --*)
          printf 'task.update: error: invalid flag or argument '\''%s'\'' (ERR_INVALID_ARGUMENT)\n' "$3" >&2
          exit 1
          ;;
      esac
    fi
    exists_t=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$(sql_escape "$u")' AND slug='$(sql_escape "$slug")';")
    if [ "$exists_t" -eq 0 ]; then
      printf 'task.update: error: task '\''%s'\'' not found in session '\''%s'\'' (ERR_ENTITY_NOT_FOUND)\n' "$slug" "$u" >&2
      exit 1
    fi
    obj="${3:-}"
    desc="${4:-}"
    crit="${5:-}"
    det="${6:-}"
    refs="${7:-}"
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" <<EOF
UPDATE tasks SET
  objective = CASE WHEN '$(sql_escape "$obj")' != '' THEN '$(sql_escape "$obj")' ELSE objective END,
  description = CASE WHEN '$(sql_escape "$desc")' != '' THEN '$(sql_escape "$desc")' ELSE description END,
  acceptance_criteria = CASE WHEN '$(sql_escape "$crit")' != '' THEN '$(sql_escape "$crit")' ELSE acceptance_criteria END,
  implementation_details = CASE WHEN '$(sql_escape "$det")' != '' THEN '$(sql_escape "$det")' ELSE implementation_details END,
  refs = CASE WHEN '$(sql_escape "$refs")' != '' THEN '$(sql_escape "$refs")' ELSE refs END,
  updated_at = '$now'
WHERE unit = '$(sql_escape "$u")' AND slug = '$(sql_escape "$slug")';
EOF
    printf '{"status":"ok","unit":"%s","task_slug":"%s"}\n' "$u" "$slug"
    exit 0
    ;;

  task.start)
    if [ $# -lt 2 ]; then
      printf 'task.start: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    slug="$2"
    exists_t=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$(sql_escape "$u")' AND slug='$(sql_escape "$slug")';")
    if [ "$exists_t" -eq 0 ]; then
      printf 'task.start: error: task '\''%s'\'' not found in session '\''%s'\'' (ERR_ENTITY_NOT_FOUND)\n' "$slug" "$u" >&2
      exit 1
    fi
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" <<EOF
BEGIN IMMEDIATE;
UPDATE tasks SET status = 'IN_PROGRESS', updated_at = '$now' WHERE unit = '$(sql_escape "$u")' AND slug = '$(sql_escape "$slug")';
UPDATE sessions SET next_action = 'work active task: $(sql_escape "$slug")' WHERE unit = '$(sql_escape "$u")';
COMMIT;
EOF
    printf '{"status":"IN_PROGRESS","unit":"%s","task_slug":"%s","next_action":"work active task: %s"}\n' "$u" "$slug" "$slug"
    exit 0
    ;;

  task.complete)
    if [ $# -lt 2 ]; then
      printf 'task.complete: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    slug="$2"
    evidence="${3:-verified}"
    cur_anchor=$(sqlite3 "$DB_PATH" "SELECT current_anchor FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ -z "$cur_anchor" ]; then
      printf 'task.complete: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    exists_t=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$(sql_escape "$u")' AND slug='$(sql_escape "$slug")';")
    if [ "$exists_t" -eq 0 ]; then
      printf 'task.complete: error: task '\''%s'\'' not found in session '\''%s'\'' (ERR_ENTITY_NOT_FOUND)\n' "$slug" "$u" >&2
      exit 1
    fi
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    receipt_slug="$(date -u +"%Y-%m-%d")-$slug-completed"
    receipt_what="backlog/$slug: DONE ($evidence)"
    sqlite3 -bail "$DB_PATH" <<EOF
BEGIN IMMEDIATE;
UPDATE tasks SET status = 'DONE', completed_at = '$now', updated_at = '$now' WHERE unit = '$(sql_escape "$u")' AND slug = '$(sql_escape "$slug")';
INSERT INTO entries (unit, slug, entry_type, anchor, what, thread, created_at)
VALUES ('$(sql_escape "$u")', '$receipt_slug', 'ENTRY', '$cur_anchor', '$(sql_escape "$receipt_what")', 'none', '$now');
COMMIT;
EOF
    printf '{"status":"DONE","unit":"%s","task_slug":"%s","receipt_entry":{"slug":"%s","what":"%s"}}\n' \
      "$u" "$slug" "$receipt_slug" "$receipt_what"
    exit 0
    ;;

  task.reopen)
    if [ $# -lt 2 ]; then
      printf 'task.reopen: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    slug="$2"
    exists_t=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$(sql_escape "$u")' AND slug='$(sql_escape "$slug")';")
    if [ "$exists_t" -eq 0 ]; then
      printf 'task.reopen: error: task '\''%s'\'' not found in session '\''%s'\'' (ERR_ENTITY_NOT_FOUND)\n' "$slug" "$u" >&2
      exit 1
    fi
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    sqlite3 -bail "$DB_PATH" "UPDATE tasks SET status = 'TODO', updated_at = '$now' WHERE unit = '$(sql_escape "$u")' AND slug = '$(sql_escape "$slug")';"
    printf '{"status":"TODO","unit":"%s","task_slug":"%s"}\n' "$u" "$slug"
    exit 0
    ;;

  task.drop)
    if [ $# -lt 2 ]; then
      printf 'task.drop: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    slug="$2"
    reason="${3:-deprecated}"
    cur_anchor=$(sqlite3 "$DB_PATH" "SELECT current_anchor FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ -z "$cur_anchor" ]; then
      printf 'task.drop: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
