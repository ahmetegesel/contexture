#!/bin/sh
# drivers/fts5: the SQLite FTS5 storage driver (contract 2, docs/the-engine.md, The storage
# contract). One sh entry point over the sqlite3 command line: the store is one database at
# schema version 4 (schema.sql, the typed tables of the record data model, each item with its
# verbatim; db-init.sh opens it and upgrades an older store in place through upgrade/), and
# every one of the 40 record functions answers natively in SQL, one script per function
# under sql/fn/ over the shared pieces of sql/lib/ (the call prelude and the payload, the
# refusal point, the derived fields and the JSON of the schemas, the line toolkit of the
# append and edit rules), beside the dump SQL (unit.export, unit.import) and the search
# tables derive.sql rebuilds in the transaction of every write. No function reads markdown
# or reaches another driver; the markdown of an older store is read once, by the upgrade.
#
# The wire: argv carries the function and its bounded identifiers, checked here with the
# posix driver's messages in its refusal order (the argv shape, the unit, CLOSED, then the
# function's own rules, those in SQL); the free-text fields arrive on stdin as escaped
# key=value payload lines, staged in a per-call scratch folder under the workspace's
# .contexture/tmp and read by the SQL with readfile(); a document (a recipe, a report, a
# dump) arrives raw. The answer is one compact JSON line built with json_object in the
# contract key order; a refusal is one stderr line "<function>: error: <message> (<CODE>)"
# with nothing on stdout. Exit tiers: 0 ok, 1 semantic, 2 storage or driver.
#
# Writes: one transaction each (BEGIN IMMEDIATE to COMMIT, whole or nothing), under the unit
# write lock (.contexture/tmp/locks/fts5-<unit>.lock) so writers of one unit serialize; the
# answer prints only after the commit. The six corpus methods of v0.54.0 are kept as shipped
# (corpus.store, corpus.changelog) until backlog#docs-corpus-port.

set -u

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'fts5-driver: error: sqlite3 executable not found (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
MODULE_DIR=$(CDPATH="" cd "$SCRIPT_DIR/.." && pwd)
SCHEMA_SQL="$MODULE_DIR/schema.sql"
SQL_DIR="$MODULE_DIR/sql"
LC_ALL=C
export LC_ALL

find_workspace_root() {
  curr="$PWD"
  while [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

ROOT=$(find_workspace_root)

if [ -n "${CTX_STORAGE_SQLITE_PATH:-}" ]; then
  DB_PATH="$CTX_STORAGE_SQLITE_PATH"
elif [ -f "$ROOT/.contexture/config" ] && grep -Eq '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" 2>/dev/null; then
  val=$(grep -E '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" | head -n1 | sed -E 's/^(session\.)?storage\.database[:=[:space:]]+//' | tr -d ' \t\r\n"')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
elif [ -f "$ROOT/.contexture/storage.conf" ] && grep -Eq '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" 2>/dev/null; then
  val=$(grep -E '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" | head -n1 | sed -E 's/^storage\.database[:[:space:]]+//')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
else
  DB_PATH="$ROOT/.contexture/sessions.db"
fi

# scratch lives in the workspace drawer when it is writable
DB_TMP="$ROOT/.contexture/tmp"
if ! mkdir -p "$DB_TMP" 2>/dev/null || [ ! -w "$DB_TMP" ]; then
  DB_TMP="${TMPDIR:-/tmp}"
fi

# the open path (a fresh schema, the in-place upgrade of an older store)
. "$MODULE_DIR/db-init.sh"

sql_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

now_utc() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# a written unit, task, lane slug: ^[A-Za-z0-9][A-Za-z0-9_-]*$
slug_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# the entry slug and the finding NAME a read addresses: the legacy shapes stay addressable
name_valid() {
  case "$1" in
    ""|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

# a read never creates the store: without a database file there is nothing to read
db_open_read() {
  [ -f "$DB_PATH" ] || return 1
  db_init
  return 0
}

SCRATCH=""
LOCK_DIR=""
cleanup() {
  [ -n "$SCRATCH" ] && rm -rf "$SCRATCH"
  [ -n "$LOCK_DIR" ] && rm -rf "$LOCK_DIR"
  return 0
}
trap cleanup EXIT
# a HUP, INT, or TERM exits through the EXIT trap (dash runs no EXIT trap on a signal it
# does not trap), so an interrupted function leaves no scratch and no held lock; an open
# transaction rolls back with its connection
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

scratch() {
  if [ -z "$SCRATCH" ]; then
    SCRATCH=$(mktemp -d "$DB_TMP/fts5-ws.XXXXXX") || {
      printf '%s: error: cannot create a scratch folder (ERR_STORAGE_WRITE)\n' "$CMD" >&2
      exit 2
    }
  fi
}

# the unit write lock: the writers of one unit serialize (beside the transaction itself, so a
# held lock is the one lever a probe can hold them with)
acquire_lock() {
  mkdir -p "$DB_TMP/locks" 2>/dev/null || true
  lk="$DB_TMP/locks/fts5-$1.lock"
  lk_n=0
  while ! mkdir "$lk" 2>/dev/null; do
    lk_n=$((lk_n + 1))
    if [ "$lk_n" -ge 100 ]; then
      printf "%s: error: failed to acquire the write lock of unit '%s' after 10s (ERR_STORAGE_LOCKED)\n" "$CMD" "$1" >&2
      exit 2
    fi
    sleep 0.1 2>/dev/null || sleep 1
  done
  LOCK_DIR="$lk"
}

if [ $# -eq 0 ]; then
  printf 'fts5-driver: error: missing command (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

CMD="$1"
shift

# ==============================================================================
# The corpus store (capabilities corpus.store and corpus.changelog)
# ==============================================================================
# The agent-facing doc corpus beside the record: a doc keyed by (repo, slug), its text
# verbatim in the docs table, its canonical address docs/<repo>/<slug>.md (never a storage
# location). The driver never parses a doc; the grammar stays in the docs verbs. Every
# write and remove lands its change-log row (doc_changes: the op and the git HEAD the verb
# passed, and the doc's state before the change) in the same transaction as the doc row.
# Keys, flags, messages, and exit tiers are the posix driver's, so a caller never branches.
corpus_key_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# corpus_keys <method> <repo> <slug>: both keys valid, else rc 1 with the method named
corpus_keys() {
  if [ -z "$2" ] || [ -z "$3" ]; then
    printf '%s: error: missing required arguments (repo, slug) (ERR_INVALID_ARGUMENT)\n' "$1" >&2
    exit 1
  fi
  corpus_key_valid "$2" || { printf "%s: error: malformed repo '%s' (ERR_INVALID_ARGUMENT)\n" "$1" "$2" >&2; exit 1; }
  corpus_key_valid "$3" || { printf "%s: error: malformed slug '%s' (ERR_INVALID_ARGUMENT)\n" "$1" "$3" >&2; exit 1; }
}

# corpus_flags <method> <default op> [flags]: --create, --op=<op>, --head=<sha>|none, bounded
# tokens only; sets CF_CREATE, CF_OP, CF_HEAD (none when absent); a bad token refuses rc 1
corpus_flags() {
  cf_m="$1"; CF_OP="$2"; CF_CREATE=0; CF_HEAD=none
  shift 2
  for cf_a in "$@"; do
    case "$cf_a" in
      --create)
        [ "$cf_m" = corpus.write ] || { printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$cf_a" >&2; exit 1; }
        CF_CREATE=1 ;;
      --op=*)
        CF_OP="${cf_a#--op=}"
        case "$CF_OP" in
          new|write|header|rule|pitfall|entry|section|replace|remove|ids) ;;
          *) printf "%s: error: unknown op '%s' (new, write, header, rule, pitfall, entry, section, replace, remove, ids) (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$CF_OP" >&2; exit 1 ;;
        esac
        ;;
      --head=*)
        CF_HEAD="${cf_a#--head=}"
        case "$CF_HEAD" in
          none) ;;
          ""|*[!0-9a-fA-F]*) printf "%s: error: --head takes a commit id or none: '%s' (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$CF_HEAD" >&2; exit 1 ;;
        esac
        ;;
      *) printf "%s: error: unknown argument '%s' (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$cf_a" >&2; exit 1 ;;
    esac
  done
}

# corpus_has_db: the store holds the corpus tables (a read never creates the database)
corpus_has_db() {
  db_open_read || return 1
  [ "$(sq "$DB_PATH" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name='docs';" 2>/dev/null)" = "1" ]
}

# corpus_doc_exists <repo> <slug>: rc 0 when the store holds the doc
corpus_doc_exists() {
  [ "$(sq "$DB_PATH" "SELECT count(*) FROM docs WHERE repo = '$(sql_escape "$1")' AND slug = '$(sql_escape "$2")';")" = "1" ]
}

# corpus.list [<repo>]: one <repo>/<slug> line per doc in the bytewise order of the canonical
# addresses (docs/<repo>/<slug>.md, as a C-locale glob of the files lists them, so one-two
# sorts before one); an empty corpus lists nothing rc 0; an absent repo refuses rc 1
corpus_list() {
  if [ $# -gt 1 ]; then
    printf 'corpus.list: error: takes at most one argument, the repo (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  cl_repo="${1:-}"
  if [ -n "$cl_repo" ] && ! corpus_key_valid "$cl_repo"; then
    printf "corpus.list: error: malformed repo '%s' (ERR_INVALID_ARGUMENT)\n" "$cl_repo" >&2
    exit 1
  fi
  cl_out=""
  if corpus_has_db; then
    cl_out=$(sq -bail "$DB_PATH" "SELECT repo || '/' || slug FROM docs WHERE '$(sql_escape "$cl_repo")' = '' OR repo = '$(sql_escape "$cl_repo")' ORDER BY repo || '/' || slug || '.md' COLLATE BINARY;") || exit 2
  fi
  if [ -n "$cl_repo" ] && [ -z "$cl_out" ]; then
    printf "corpus.list: error: repo '%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$cl_repo" >&2
    exit 1
  fi
  [ -n "$cl_out" ] && printf '%s\n' "$cl_out"
  exit 0
}

# corpus.read <repo> <slug>: the doc byte for byte; rc 1 when absent
corpus_read() {
  if [ $# -gt 2 ]; then
    printf 'corpus.read: error: takes two arguments, repo and slug (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  corpus_keys corpus.read "${1:-}" "${2:-}"
  if ! corpus_has_db || ! corpus_doc_exists "$1" "$2"; then
    printf "corpus.read: error: doc '%s/%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$1" "$2" >&2
    exit 1
  fi
  scratch
  : > "$SCRATCH/doc"
  sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$SCRATCH/doc")', body) FROM docs WHERE repo = '$(sql_escape "$1")' AND slug = '$(sql_escape "$2")';" > /dev/null || {
    printf "corpus.read: error: doc '%s/%s' is unreadable (ERR_STORAGE_READ)\n" "$1" "$2" >&2
    exit 2
  }
  cat "$SCRATCH/doc"
  exit 0
}

# corpus_twin <repo> <slug>: the key of a stored doc that folds onto <repo>/<slug> under ASCII
# case without matching it exactly (its repo alone, or its slug inside the same repo), else
# nothing: keys differing only by case never coexist, since a mount onto a case-insensitive
# filesystem would fold them into one file (the posix driver's rule)
corpus_twin() {
  ct_r=$(sql_escape "$1"); ct_s=$(sql_escape "$2")
  sq -bail "$DB_PATH" "SELECT repo || '/' || slug FROM docs WHERE lower(repo) = lower('$ct_r') AND (repo <> '$ct_r' OR (lower(slug) = lower('$ct_s') AND slug <> '$ct_s')) ORDER BY repo || '/' || slug || '.md' COLLATE BINARY LIMIT 1;"
}

# corpus.write <repo> <slug> [--create] [--op=<op>] [--head=<sha>|none]: the whole doc raw on
# stdin replaces the stored one (a new doc when absent); --create refuses an existing doc
# rc 1; a key folding onto another doc's or repo's under ASCII case refuses rc 1, nothing
# written; the doc row and its change-log row land in one transaction, else rc 2 and no success
corpus_write() {
  cw_repo="${1:-}"; cw_slug="${2:-}"
  if [ $# -ge 2 ]; then shift 2; else shift $#; fi
  corpus_keys corpus.write "$cw_repo" "$cw_slug"
  corpus_flags corpus.write write "$@"
  db_init
  cw_twin=$(corpus_twin "$cw_repo" "$cw_slug") || exit 2
  if [ -n "$cw_twin" ]; then
    printf "corpus.write: error: doc '%s/%s' folds onto '%s' under ASCII case; keys differing only by case never coexist (ERR_ENTITY_EXISTS)\n" "$cw_repo" "$cw_slug" "$cw_twin" >&2
    exit 1
  fi
  if [ "$CF_CREATE" -eq 1 ] && corpus_doc_exists "$cw_repo" "$cw_slug"; then
    printf "corpus.write: error: doc '%s/%s' already exists in the corpus (ERR_ENTITY_EXISTS)\n" "$cw_repo" "$cw_slug" >&2
    exit 1
  fi
  scratch
  cat > "$SCRATCH/doc" || { printf "corpus.write: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cw_repo" "$cw_slug" >&2; exit 2; }
  cw_r=$(sql_escape "$cw_repo"); cw_s=$(sql_escape "$cw_slug"); cw_now=$(now_utc)
  {
    printf 'BEGIN IMMEDIATE;\n'
    printf "INSERT INTO doc_changes (at, op, repo, slug, head, prior) VALUES ('%s', '%s', '%s', '%s', '%s', CASE WHEN EXISTS (SELECT 1 FROM docs WHERE repo = '%s' AND slug = '%s') THEN 'present' ELSE 'absent' END);\n" \
      "$cw_now" "$CF_OP" "$cw_r" "$cw_s" "$CF_HEAD" "$cw_r" "$cw_s"
    printf "INSERT OR REPLACE INTO docs (repo, slug, body, updated_at) VALUES ('%s', '%s', CAST(readfile('%s') AS TEXT), '%s');\n" \
      "$cw_r" "$cw_s" "$(sql_escape "$SCRATCH/doc")" "$cw_now"
    printf 'COMMIT;\n'
  } > "$SCRATCH/corpus.sql"
  sq -bail "$DB_PATH" < "$SCRATCH/corpus.sql" > /dev/null 2>&1 || {
    printf "corpus.write: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cw_repo" "$cw_slug" >&2
    exit 2
  }
  printf '{"status":"ok","repo":"%s","slug":"%s","op":"%s"}\n' "$cw_repo" "$cw_slug" "$CF_OP"
  exit 0
}

# corpus.remove <repo> <slug> [--op=<op>] [--head=<sha>|none]: removes the doc with its
# change-log row in one transaction; rc 1 when absent
corpus_remove() {
  cx_repo="${1:-}"; cx_slug="${2:-}"
  if [ $# -ge 2 ]; then shift 2; else shift $#; fi
  corpus_keys corpus.remove "$cx_repo" "$cx_slug"
  corpus_flags corpus.remove remove "$@"
  if ! corpus_has_db || ! corpus_doc_exists "$cx_repo" "$cx_slug"; then
    printf "corpus.remove: error: doc '%s/%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$cx_repo" "$cx_slug" >&2
    exit 1
  fi
  cx_r=$(sql_escape "$cx_repo"); cx_s=$(sql_escape "$cx_slug")
  {
    printf 'BEGIN IMMEDIATE;\n'
    printf "INSERT INTO doc_changes (at, op, repo, slug, head, prior) VALUES ('%s', '%s', '%s', '%s', '%s', 'present');\n" "$(now_utc)" "$CF_OP" "$cx_r" "$cx_s" "$CF_HEAD"
    printf "DELETE FROM docs WHERE repo = '%s' AND slug = '%s';\n" "$cx_r" "$cx_s"
    printf 'COMMIT;\n'
  } | sq -bail "$DB_PATH" > /dev/null 2>&1 || {
    printf "corpus.remove: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cx_repo" "$cx_slug" >&2
    exit 2
  }
  printf '{"status":"ok","repo":"%s","slug":"%s","op":"%s"}\n' "$cx_repo" "$cx_slug" "$CF_OP"
  exit 0
}

# corpus.mount <dest> [<repo>]: fills the empty folder the caller made with every doc (or
# the one repo's) at <dest>/docs/<repo>/<slug>.md and prints <dest>; an empty store mounts
# an empty docs folder; a missing or non-empty folder and an absent repo refuse rc 1
corpus_mount() {
  cm_dest="${1:-}"; cm_repo="${2:-}"
  if [ $# -gt 2 ]; then
    printf 'corpus.mount: error: takes the destination folder and at most a repo (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  if [ -z "$cm_dest" ] || [ ! -d "$cm_dest" ]; then
    printf 'corpus.mount: error: the destination must be an existing empty folder the caller made (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  if [ -n "$(ls -A "$cm_dest" 2>/dev/null)" ]; then
    printf 'corpus.mount: error: the destination folder is not empty (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  if [ -n "$cm_repo" ] && ! corpus_key_valid "$cm_repo"; then
    printf "corpus.mount: error: malformed repo '%s' (ERR_INVALID_ARGUMENT)\n" "$cm_repo" >&2
    exit 1
  fi
  cm_keys=""
  if corpus_has_db; then
    cm_keys=$(sq -bail "$DB_PATH" "SELECT repo || '/' || slug FROM docs WHERE '$(sql_escape "$cm_repo")' = '' OR repo = '$(sql_escape "$cm_repo")' ORDER BY repo || '/' || slug || '.md' COLLATE BINARY;") || exit 2
  fi
  if [ -n "$cm_repo" ] && [ -z "$cm_keys" ]; then
    printf "corpus.mount: error: repo '%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$cm_repo" >&2
    exit 1
  fi
  mkdir -p "$cm_dest/docs" || { printf 'corpus.mount: error: the destination folder is not writable (ERR_STORAGE_WRITE)\n' >&2; exit 2; }
  if [ -n "$cm_keys" ]; then
    for cm_r in $(printf '%s\n' "$cm_keys" | sed 's|/.*||' | uniq); do
      mkdir -p "$cm_dest/docs/$cm_r" || { printf 'corpus.mount: error: the destination folder is not writable (ERR_STORAGE_WRITE)\n' >&2; exit 2; }
    done
    sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$cm_dest")/docs/' || repo || '/' || slug || '.md', body) FROM docs WHERE '$(sql_escape "$cm_repo")' = '' OR repo = '$(sql_escape "$cm_repo")';" > /dev/null || {
      printf 'corpus.mount: error: the corpus could not be written into the destination folder (ERR_STORAGE_WRITE)\n' >&2
      exit 2
    }
    # an empty doc writes no bytes: every listed doc still sits at its address
    for cm_k in $cm_keys; do
      [ -f "$cm_dest/docs/$cm_k.md" ] || : > "$cm_dest/docs/$cm_k.md"
    done
  fi
  printf '%s\n' "$cm_dest"
  exit 0
}

# corpus.changes: the change-log rows whose head is in the set given on stdin (payload lines
# head=<sha>|none), oldest first, one TAB-separated line each:
#   <seq> <at> <op> <repo>/<slug> <head> <prior: absent|present>
# prior is the doc's state before that change, so a window's rows yield each doc's net status
corpus_changes() {
  if [ $# -gt 0 ]; then
    printf 'corpus.changes: error: takes no arguments; the heads travel on stdin as head=<sha> lines (ERR_INVALID_ARGUMENT)\n' >&2
    exit 1
  fi
  scratch
  cat > "$SCRATCH/heads" || exit 2
  printf 'CREATE TEMP TABLE want_heads (head TEXT PRIMARY KEY);\n' > "$SCRATCH/changes.sql"
  while IFS= read -r ch_l || [ -n "$ch_l" ]; do
    [ -n "$ch_l" ] || continue
    case "$ch_l" in
      head=*) ch_h=${ch_l#head=} ;;
      *) printf "corpus.changes: error: unknown payload line '%s' (head=<sha> lines only) (ERR_INVALID_ARGUMENT)\n" "$ch_l" >&2; exit 1 ;;
    esac
    case "$ch_h" in
      none) ;;
      ""|*[!0-9a-fA-F]*) printf "corpus.changes: error: a head is a commit id or none: '%s' (ERR_INVALID_ARGUMENT)\n" "$ch_h" >&2; exit 1 ;;
    esac
    printf "INSERT OR IGNORE INTO want_heads VALUES ('%s');\n" "$ch_h" >> "$SCRATCH/changes.sql"
  done < "$SCRATCH/heads"
  corpus_has_db || exit 0
  printf "SELECT seq || char(9) || at || char(9) || op || char(9) || repo || '/' || slug || char(9) || head || char(9) || prior FROM doc_changes WHERE head IN (SELECT head FROM want_heads) ORDER BY seq;\n" >> "$SCRATCH/changes.sql"
  sq -bail "$DB_PATH" < "$SCRATCH/changes.sql" || exit 2
  exit 0
}
# ==============================================================================
# The dump (contract 2, docs/the-engine.md, The dump): unit.export and unit.import
# ==============================================================================
# Each is SQL beside this entry point (sql/): the export one query over the typed tables
# answering the dump lines in order; the import the whole dump validated before any write
# (sql/dump.check.sql), then in one transaction the unit loaded whole (sql/dump.import.sql)
# and its search tables derived (sql/derive.sql). A refusal is one stderr line
# "<function>: error: <message> (<CODE>)" with nothing on stdout.
SQL_DIR="$MODULE_DIR/sql"

refuse() {
  printf '%s: error: %s (%s)\n' "$CMD" "$3" "$2" >&2
  exit "$1"
}

want_unit() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  slug_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$1'"
}

# unit_held <unit>: the store holds the unit (its state row)
unit_held() {
  [ "$(sq "$DB_PATH" "SELECT count(*) FROM units WHERE unit = '$(sql_escape "$1")';" 2>/dev/null)" = "1" ]
}

# unit.export <unit>: the unit's dump lines on stdout
unit_export() {
  want_unit "${1:-}"
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
  unit_held "$1" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
  [ $# -le 1 ] || refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$2'"
  scratch
  printf "CREATE TEMP TABLE arg (k TEXT PRIMARY KEY, v TEXT);\nINSERT INTO temp.arg VALUES ('unit', '%s');\n.read '%s'\n" \
    "$(sql_escape "$1")" "$SQL_DIR/unit.export.sql" > "$SCRATCH/export.sql"
  sq -bail "$DB_PATH" < "$SCRATCH/export.sql" > "$SCRATCH/dump" 2> "$SCRATCH/err" \
    || refuse 2 ERR_STORAGE_READ "the export of unit '$1' failed: $(head -n 1 "$SCRATCH/err")"
  cat "$SCRATCH/dump"
  exit 0
}

# unit.import <unit> [--replace] | the dump raw: validated whole before anything lands; a
# held unit refuses without --replace; with it the unit is swapped whole in one transaction
unit_import() {
  want_unit "${1:-}"
  ui_u=$1
  shift
  ui_rep=0
  for ui_a in "$@"; do
    case "$ui_a" in
      --replace) ui_rep=1 ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$ui_a'" ;;
    esac
  done
  scratch
  cat > "$SCRATCH/dump" || refuse 2 ERR_STORAGE_READ "cannot read the dump"
  db_init
  ui_q=$(sql_escape "$ui_u")
  {
    printf "PRAGMA foreign_keys = ON;\n.read '%s'\n" "$SQL_DIR/split.sql"
    printf "CREATE TEMP TABLE arg (k TEXT PRIMARY KEY, v TEXT);\nINSERT INTO temp.arg VALUES ('unit', '%s'), ('dump', '%s');\n" "$ui_q" "$(sql_escape "$SCRATCH/dump")"
    printf "CREATE TEMP TABLE touched (unit TEXT PRIMARY KEY);\nINSERT INTO temp.touched VALUES ('%s');\n" "$ui_q"
    printf 'CREATE TEMP TABLE guard (x INTEGER CHECK (x = 0));\n'
    printf ".read '%s'\n.read '%s'\n" "$SQL_DIR/dump.load.sql" "$SQL_DIR/dump.check.sql"
    # a defect stops the script before any write
    printf "SELECT 'ERR ' || msg FROM temp.dverr;\nINSERT INTO temp.guard SELECT count(*) FROM temp.dverr;\n"
    printf 'BEGIN IMMEDIATE;\n'
    printf "SELECT 'HELD' FROM units WHERE unit = '%s';\n" "$ui_q"
    if [ "$ui_rep" -eq 0 ]; then
      printf "INSERT INTO temp.guard SELECT count(*) FROM units WHERE unit = '%s';\n" "$ui_q"
    fi
    printf ".read '%s'\n.read '%s'\n" "$SQL_DIR/dump.import.sql" "$SQL_DIR/derive.sql"
    printf "COMMIT;\nSELECT 'OK ' || records FROM temp.dok;\n"
  } > "$SCRATCH/import.sql"
  sq -bail "$DB_PATH" < "$SCRATCH/import.sql" > "$SCRATCH/out" 2> "$SCRATCH/err"
  ui_rc=$?
  ui_err=$(grep '^ERR ' "$SCRATCH/out" | head -n 1)
  [ -z "$ui_err" ] || refuse 1 ERR_DUMP_FORMAT "${ui_err#ERR }"
  ui_held=0
  grep -q '^HELD$' "$SCRATCH/out" && ui_held=1
  if [ "$ui_rc" -ne 0 ]; then
    [ "$ui_held" -eq 1 ] && [ "$ui_rep" -eq 0 ] && refuse 1 ERR_ENTITY_EXISTS "unit '$ui_u' already exists"
    refuse 2 ERR_STORAGE_WRITE "the import of unit '$ui_u' failed: $(head -n 1 "$SCRATCH/err")"
  fi
  ui_n=$(sed -n 's/^OK //p' "$SCRATCH/out" | head -n 1)
  [ -n "$ui_n" ] || refuse 2 ERR_STORAGE_WRITE "the import of unit '$ui_u' answered no record count"
  if [ "$ui_held" -eq 1 ]; then ui_r=true; else ui_r=false; fi
  printf '{"unit":"%s","records":%s,"replaced":%s}\n' "$ui_u" "$ui_n" "$ui_r"
  exit 0
}

# ==============================================================================
# The record functions (contract 2): the argv shape here, every record rule in SQL
# ==============================================================================
# A call runs one sqlite3 process over one script: the call header (temp.arg: the function,
# the unit, the other argv tokens a1..aN, the staged payload and document files), then
# sql/lib/prelude.sql and sql/fn/<function>.sql, with sqlite3 working in sql/ so the scripts
# read their pieces by relative path. A script refuses by printing one ERR|<rc>|<code>|<msg>
# line and stopping (sql/lib/stop.sql); a write prints its answer inside its transaction
# and commits after, so an answer reaches stdout only when sqlite3 exits 0.
CALL=""
call_begin() {
  scratch
  CALL="$SCRATCH/call.sql"
  printf 'PRAGMA foreign_keys = ON;\nCREATE TEMP TABLE arg (k TEXT PRIMARY KEY, v TEXT);\n' > "$CALL"
  call_arg fn "$CMD"
}

call_arg() {
  printf "INSERT INTO temp.arg VALUES ('%s', '%s');\n" "$1" "$(sql_escape "$2")" >> "$CALL"
}

# call_argv <token...>: the argv after the unit as a1..aN, na their count
call_argv() {
  ca_i=0
  for ca_v in "$@"; do
    ca_i=$((ca_i + 1))
    call_arg "a$ca_i" "$ca_v"
  done
  call_arg na "$ca_i"
}

# the payload lines, staged whole; the SQL decodes them
call_payload() {
  cat > "$SCRATCH/pay" || refuse 2 ERR_STORAGE_READ "cannot read the payload"
  call_arg pay "$SCRATCH/pay"
}

# a raw document (a recipe, a report), staged whole with its byte count
call_doc() {
  cat > "$SCRATCH/doc" || refuse 2 ERR_STORAGE_READ "cannot read the document"
  call_arg doc "$SCRATCH/doc"
  call_arg docsize "$(wc -c < "$SCRATCH/doc" | tr -d ' ')"
}

# call_run <function script> <read|write>: the script over the store; its refusal, a storage
# failure, or its answer
call_run() {
  printf '.read lib/prelude.sql\n.read fn/%s.sql\n' "$1" >> "$CALL"
  (cd "$SQL_DIR" && sq -bail "$DB_PATH" < "$CALL" > "$SCRATCH/out" 2> "$SCRATCH/err")
  cr_rc=$?
  case "$(sed -n '1p' "$SCRATCH/out")" in
    'ERR|'*)
      cr_l=$(cat "$SCRATCH/out")
      cr_l=${cr_l#ERR|}
      cr_t=${cr_l%%|*}
      cr_l=${cr_l#*|}
      cr_c=${cr_l%%|*}
      cr_m=${cr_l#*|}
      printf '%s: error: %s (%s)\n' "$CMD" "$cr_m" "$cr_c" >&2
      exit "$cr_t"
      ;;
  esac
  if [ "$cr_rc" -ne 0 ]; then
    cr_e=$(sed -n '1p' "$SCRATCH/err")
    # a signal ended the sqlite3 (rc above 128): its first stderr line is the shell's job
    # line, which names the plugin's files; the message names the interruption instead
    [ "$cr_rc" -gt 128 ] && cr_e="sqlite3 was interrupted (exit $cr_rc); the transaction rolled back"
    case "$cr_e" in
      *"database is locked"*|*"database table is locked"*) refuse 2 ERR_STORAGE_LOCKED "the store is locked by another writer" ;;
    esac
    [ "$2" = write ] && refuse 2 ERR_STORAGE_WRITE "the storage write failed: $cr_e"
    refuse 2 ERR_STORAGE_READ "the storage read failed: $cr_e"
  fi
  cat "$SCRATCH/out"
  exit 0
}

# px_extra <n> <argv...>: no argument beyond the n the function takes
px_extra() {
  pe_n=$1
  shift
  [ $# -le "$pe_n" ] || refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$(eval "printf '%s' \"\${$((pe_n + 1))}\"")'"
}

# want_held <unit>: a well formed unit the store holds (a read of a store without a database
# file finds no unit)
want_held() {
  want_unit "${1:-}"
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
  unit_held "$1" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
}

# rec_read <function> <unit> <argv after the unit...>: a read of one unit (the held check in
# SQL, lib/held.sql)
rec_read() {
  rr_f=$1
  rr_u=$2
  shift 2
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$rr_u' not found"
  call_begin
  call_arg unit "$rr_u"
  call_argv "$@"
  call_run "$rr_f" read
}

# rec_write <function> <unit> <payload|doc|none> <argv after the unit...>: a write of one unit,
# its input staged, under the unit write lock, in one transaction
rec_write() {
  rw_f=$1
  rw_u=$2
  rw_in=$3
  shift 3
  [ -f "$DB_PATH" ] || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$rw_u' not found"
  call_begin
  call_arg unit "$rw_u"
  call_argv "$@"
  case "$rw_in" in
    payload) call_payload ;;
    doc) call_doc ;;
  esac
  acquire_lock "$rw_u"
  db_init
  call_run "$rw_f" write
}

want_task_slug() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the task slug"
  slug_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed task slug '$1'"
}

want_lane() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
  slug_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$1'"
}

capability() {
  printf '{"driver":"fts5","version":"2.0.0","contract":"2","functions":["capability","storage.health","session.create","session.list","session.load","session.refload","session.board","session.audit","session.stamp","session.next","session.refs","session.close","session.reopen","session.units","session.refs_to","task.add","task.update","task.start","task.complete","task.reopen","task.drop","task.list","task.get","entry.record","entry.get","entry.list","entry.closure","finding.add","finding.update","finding.supersede","finding.drop","finding.get","finding.list","lane.create","lane.record","lane.write_report","lane.get","search.query","unit.export","unit.import","corpus.list","corpus.read","corpus.write","corpus.remove","corpus.mount","corpus.changes"],"search_modes":["exact","hybrid","trigram"],"optional":["corpus.store","corpus.changelog"]}\n'
}

# storage.health: a probe, never a write: an absent database reports degraded with store
# absent (the store starts at the first bootstrap), and an older store is not upgraded here
storage_health() {
  # an sqlite3 older than the driver's minimum serves no function (db_init refuses each), so
  # the probe reports error naming it, never ok (lanes/si-f5-fts5-review/report F3)
  sh_sv=$(sq :memory: "SELECT sqlite_version();" 2>/dev/null)
  sh_svn=$(printf '%s\n' "$sh_sv" | awk -F. '{ printf "%d", ($1 * 1000000) + ($2 * 1000) + $3 }')
  if [ "${sh_svn:-0}" -lt "$DB_SQLITE_MIN" ]; then
    sh_st=absent; sh_a=0
    if [ -f "$DB_PATH" ]; then
      sh_st=present
      sh_a=$(sq "$DB_PATH" "SELECT count(*) FROM units WHERE status = 'ACTIVE';" 2>/dev/null) || sh_a=0
      case "$sh_a" in ""|*[!0-9]*) sh_a=0 ;; esac
    fi
    printf '{"driver":"fts5","health":"error","detail":"sqlite3 %s is older than the 3.44 the driver needs","store":"%s","active_units":%s}\n' "${sh_sv:-unknown}" "$sh_st" "$sh_a"
    exit 0
  fi
  if [ ! -f "$DB_PATH" ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database not created yet (will be initialized on bootstrap)","store":"absent","active_units":0}\n'
    exit 0
  fi
  sh_p=$(sq "$DB_PATH" "SELECT (SELECT user_version FROM pragma_user_version) || '|' || (SELECT count(*) FROM sqlite_master WHERE type = 'table');" 2>/dev/null) || {
    printf '{"driver":"fts5","health":"error","detail":"database unreadable","store":"absent","active_units":0}\n'
    exit 0
  }
  sh_v=${sh_p%%|*}
  sh_t=${sh_p#*|}
  if [ "$sh_t" = 0 ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database present, no unit stored yet","store":"absent","active_units":0}\n'
    exit 0
  fi
  if [ "$sh_v" != "$DB_SCHEMA_VERSION" ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database at schema %s; it upgrades in place on its first open","store":"present","active_units":0}\n' "$sh_v"
    exit 0
  fi
  sh_c=$(sq "$DB_PATH" "SELECT count(*) || '|' || (SELECT count(*) FROM units WHERE status = 'ACTIVE') FROM units;" 2>/dev/null) || sh_c="0|0"
  sh_n=${sh_c%%|*}
  sh_a=${sh_c#*|}
  if [ "$sh_n" = 0 ]; then
    printf '{"driver":"fts5","health":"degraded","detail":"database present, no unit stored yet","store":"absent","active_units":0}\n'
  elif [ ! -w "$DB_PATH" ]; then
    printf '{"driver":"fts5","health":"error","detail":"database file not writable","store":"present","active_units":%s}\n' "$sh_a"
  elif ! sq "$DB_PATH" "PRAGMA quick_check;" 2>/dev/null | grep -q '^ok$'; then
    printf '{"driver":"fts5","health":"error","detail":"database integrity check failed","store":"present","active_units":%s}\n' "$sh_a"
  else
    printf '{"driver":"fts5","health":"ok","detail":"database present and writable","store":"present","active_units":%s}\n' "$sh_a"
  fi
  exit 0
}

# search.query <unit> [--limit=N] [--entity=T] [--mode=M] | query: the shapes here, the
# exact rule over the lines table and the ranked modes over the FTS5 tables in SQL
search_query() {
  want_unit "${1:-}"
  sq_u=$1
  shift
  sq_limit=20
  sq_entity=all
  sq_mode=exact
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$sq_a'" ;;
    esac
  done
  case "$sq_limit" in
    ""|*[!0-9]*|0) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a positive number: '$sq_limit'" ;;
  esac
  case "$sq_entity" in
    all|session|task|entry|finding|lane|lane_entry) ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "unknown entity type '$sq_entity' (session, task, entry, finding, lane, lane_entry, all)" ;;
  esac
  case "$sq_mode" in
    ""|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$sq_mode'" ;;
  esac
  db_open_read || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sq_u' not found"
  call_begin
  call_arg unit "$sq_u"
  call_arg limit "$sq_limit"
  call_arg entity "$sq_entity"
  call_arg mode "$sq_mode"
  call_payload
  case "$sq_mode" in
    hybrid|trigram) call_run search.ranked read ;;
    *) call_run search.query read ;;
  esac
}

# session.refload <unit>...: every named unit well formed and held, in argv order
session_refload() {
  [ $# -ge 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  db_open_read || { want_unit "$1"; refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"; }
  sr_held=" $(sq "$DB_PATH" "SELECT group_concat(unit, ' ') FROM units;" 2>/dev/null) "
  for sr_u in "$@"; do
    want_unit "$sr_u"
    case "$sr_held" in *" $sr_u "*) ;; *) refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sr_u' not found" ;; esac
  done
  call_begin
  call_arg unit "$1"
  shift
  call_argv "$@"
  call_run session.refload read
}

case "$CMD" in
  unit.export) unit_export "$@" ;;
  unit.import) unit_import "$@" ;;
  capability) capability; exit 0 ;;
  corpus.list) corpus_list "$@" ;;
  corpus.read) corpus_read "$@" ;;
  corpus.write) corpus_write "$@" ;;
  corpus.remove) corpus_remove "$@" ;;
  corpus.mount) corpus_mount "$@" ;;
  corpus.changes) corpus_changes "$@" ;;

  storage.health)
    px_extra 0 "$@"
    storage_health
    ;;
  session.create)
    want_unit "${1:-}"
    px_extra 1 "$@"
    call_begin
    call_arg unit "$1"
    call_payload
    acquire_lock "$1"
    db_init
    call_run session.create write
    ;;
  session.list)
    px_extra 0 "$@"
    if [ ! -f "$DB_PATH" ]; then
      printf '{"store":"absent","units":[]}\n'
      exit 0
    fi
    db_init
    call_begin
    call_run session.list read
    ;;
  session.load)
    [ $# -gt 1 ] && want_held "${1:-}"
    want_unit "${1:-}"
    px_extra 1 "$@"
    rec_read session.load "$1"
    ;;
  session.refload) session_refload "$@" ;;
  session.board|session.audit)
    px_extra 1 "$@"
    want_unit "${1:-}"
    rec_read "$CMD" "$1"
    ;;
  session.stamp|session.next|session.close|session.reopen)
    px_extra 1 "$@"
    want_unit "${1:-}"
    rec_write "$CMD" "$1" payload
    ;;
  session.refs)
    want_unit "${1:-}"
    sf_u=$1
    shift
    sf_bad=""
    for sf_r in "$@"; do
      if [ -z "$sf_bad" ] && ! slug_valid "$sf_r"; then sf_bad=$sf_r; sf_badset=1; fi
    done
    [ -f "$DB_PATH" ] || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sf_u' not found"
    call_begin
    call_arg unit "$sf_u"
    call_argv "$@"
    [ -n "${sf_badset:-}" ] && call_arg badref "$sf_bad"
    call_payload
    acquire_lock "$sf_u"
    db_init
    call_run session.refs write
    ;;
  session.units)
    [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the repo"
    case "$1" in
      [!A-Za-z0-9._-]*|*[!A-Za-z0-9._/-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed repo '$1'" ;;
    esac
    px_extra 1 "$@"
    if [ ! -f "$DB_PATH" ]; then
      printf '{"repo":"%s","units":[],"known_repos":[]}\n' "$1"
      exit 0
    fi
    db_init
    call_begin
    call_arg unit "$1"
    call_run session.units read
    ;;
  session.refs_to)
    want_unit "${1:-}"
    px_extra 1 "$@"
    if [ ! -f "$DB_PATH" ]; then
      printf '{"unit":"%s","referrers":[]}\n' "$1"
      exit 0
    fi
    db_init
    call_begin
    call_arg unit "$1"
    call_run session.refs_to read
    ;;
  task.add|task.update|task.start|task.complete|task.reopen|task.drop|task.get)
    px_extra 2 "$@"
    want_unit "${1:-}"
    want_task_slug "${2:-}"
    case "$CMD" in
      task.get) rec_read "$CMD" "$1" "$2" ;;
      *) rec_write "$CMD" "$1" payload "$2" ;;
    esac
    ;;
  task.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      TODO|IN_PROGRESS|DONE|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "task.list takes TODO, IN_PROGRESS, DONE, or all: '${2:-}'" ;;
    esac
    rec_read "$CMD" "$1" "$2"
    ;;
  entry.record)
    px_extra 1 "$@"
    want_unit "${1:-}"
    rec_write "$CMD" "$1" payload
    ;;
  entry.get|entry.closure)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the entry slug"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed entry slug '$2'"
    rec_read "$CMD" "$1" "$2"
    ;;
  entry.list)
    want_unit "${1:-}"
    el_u=$1
    shift
    for el_a in "$@"; do
      case "$el_a" in
        --anchor=A[0-9]*) case "${el_a#--anchor=A}" in *[!0-9]*) refuse 1 ERR_INVALID_ARGUMENT "--anchor takes A<N>: '$el_a'" ;; esac ;;
        --group=?*) case "${el_a#--group=}" in [!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed group in '$el_a'" ;; esac ;;
        *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$el_a'" ;;
      esac
    done
    rec_read "$CMD" "$el_u" "$@"
    ;;
  finding.add|finding.update|finding.drop|finding.get)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the finding NAME"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$2'"
    case "$CMD" in
      finding.get) rec_read "$CMD" "$1" "$2" ;;
      *) rec_write "$CMD" "$1" payload "$2" ;;
    esac
    ;;
  finding.supersede)
    px_extra 3 "$@"
    want_unit "${1:-}"
    for fs_n in "${2:-}" "${3:-}"; do
      [ -n "$fs_n" ] || refuse 1 ERR_INVALID_ARGUMENT "finding.supersede takes the unit, OLD, and NEW"
      name_valid "$fs_n" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$fs_n'"
    done
    rec_write "$CMD" "$1" payload "$2" "$3"
    ;;
  finding.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      active|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "finding.list takes active or all: '${2:-}'" ;;
    esac
    rec_read "$CMD" "$1" "$2"
    ;;
  lane.create|lane.write_report)
    px_extra 2 "$@"
    want_held "${1:-}"
    want_lane "${2:-}"
    rec_write "$CMD" "$1" doc "$2"
    ;;
  lane.record)
    px_extra 2 "$@"
    want_unit "${1:-}"
    want_lane "${2:-}"
    rec_write "$CMD" "$1" payload "$2"
    ;;
  lane.get)
    px_extra 3 "$@"
    want_unit "${1:-}"
    want_lane "${2:-}"
    case "${3:-}" in
      recipe|journal|report) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "lane.get takes recipe, journal, or report: '${3:-}'" ;;
    esac
    rec_read "$CMD" "$1" "$2" "$3"
    ;;
  search.query) search_query "$@" ;;

  *)
    refuse 2 ERR_CAPABILITY_UNSUPPORTED "unknown function '$CMD'"
    ;;
esac
exit 0
