        ;;
      report)
        content=$(sqlite3 "$DB_PATH" "SELECT report FROM lanes WHERE unit='$(sql_escape "$u")' AND lane_slug='$(sql_escape "$lane_slug")';")
        ;;
      journal)
        content=$(sqlite3 "$DB_PATH" "SELECT what FROM lane_entries WHERE unit='$(sql_escape "$u")' AND lane_slug='$(sql_escape "$lane_slug")' ORDER BY id ASC;")
        ;;
    esac
    sqlite3 "$DB_PATH" "SELECT json_object('unit', '$(sql_escape "$u")', 'lane', '$(sql_escape "$lane_slug")', 'artifact', '$(sql_escape "$artifact")', 'content', '$(sql_escape "$content")');"
    exit 0
    ;;

  lane.close)
    if [ $# -lt 4 ]; then
      printf 'lane.close: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    lane_slug="$2"
    verdict="$3"
    receipt="$4"
    cur_anchor=$(sqlite3 "$DB_PATH" "SELECT current_anchor FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ -z "$cur_anchor" ]; then
      printf 'lane.close: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    exists_l=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM lanes WHERE unit='$(sql_escape "$u")' AND lane_slug='$(sql_escape "$lane_slug")';")
    if [ "$exists_l" -eq 0 ]; then
      printf 'lane.close: error: lane '\''%s'\'' not found in session '\''%s'\'' (ERR_ENTITY_NOT_FOUND)\n' "$lane_slug" "$u" >&2
      exit 1
    fi
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    receipt_slug="$(date -u +"%Y-%m-%d")-$lane_slug-closed"
    receipt_what="lane $lane_slug: $verdict ($receipt)"
    sqlite3 -bail "$DB_PATH" <<EOF
BEGIN IMMEDIATE;
INSERT INTO entries (unit, slug, entry_type, anchor, what, thread, created_at)
VALUES ('$(sql_escape "$u")', '$receipt_slug', 'ENTRY', '$cur_anchor', '$(sql_escape "$receipt_what")', 'none', '$now');
COMMIT;
EOF
    printf '{"unit":"%s","lane":"%s","status":"RESOLVED","receipt_entry":{"slug":"%s","what":"%s"}}\n' \
      "$u" "$lane_slug" "$receipt_slug" "$receipt_what"
    exit 0
    ;;

  search.query)
    if [ $# -lt 2 ]; then
      printf 'search.query: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    db_init
    u="$1"
    q="$2"
    entity_filter="${3:-}"
    limit_num="${4:-20}"
    exists_s=$(sqlite3 "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$(sql_escape "$u")';")
    if [ "$exists_s" -eq 0 ]; then
      printf 'search.query: error: session '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$u" >&2
      exit 1
    fi
    safe_q=$(sanitize_fts_query "$q")
    if [ -z "$safe_q" ]; then
      printf '{"unit":"%s","query":"%s","total_matches":0,"results":[]}\n' "$u" "$q"
      exit 0
    fi
    sqlite3 "$DB_PATH" <<EOF
WITH
  raw_prose AS (
    SELECT rowid AS doc_id, rank, snippet(fts_prose, -1, '<b>', '</b>', '...', 12) AS snip
    FROM fts_prose WHERE fts_prose MATCH '$(sql_escape "$safe_q")'
  ),
  ranked_prose AS (
    SELECT doc_id, row_number() OVER (ORDER BY rank) AS rnk, snip
    FROM raw_prose
  ),
  raw_code AS (
    SELECT rowid AS doc_id, rank, snippet(fts_code, -1, '<b>', '</b>', '...', 12) AS snip
    FROM fts_code WHERE fts_code MATCH '$(sql_escape "$safe_q")'
  ),
  ranked_code AS (
    SELECT doc_id, row_number() OVER (ORDER BY rank) AS rnk, snip
    FROM raw_code
  ),
  combined AS (
    SELECT doc_id, 1.0 / (60.0 + rnk) AS score, snip FROM ranked_prose
    UNION ALL
    SELECT doc_id, 1.0 / (60.0 + rnk) AS score, snip FROM ranked_code
  ),
  fused AS (
    SELECT c.doc_id, round(sum(c.score), 6) AS rrf_score, count(c.doc_id) AS sources, max(c.snip) AS snippet
    FROM combined c GROUP BY c.doc_id
  ),
  ordered_docs AS (
    SELECT f.doc_id, s.unit, s.entity_type, s.entity_id, s.section, s.title, f.rrf_score, f.sources, f.snippet
    FROM fused f
    JOIN search_documents s ON s.doc_id = f.doc_id
    WHERE s.unit = '$(sql_escape "$u")' AND ('$(sql_escape "$entity_filter")' = '' OR s.entity_type = '$(sql_escape "$entity_filter")')
    ORDER BY f.rrf_score DESC
    LIMIT $limit_num
  )
SELECT json_object(
  'unit', '$(sql_escape "$u")',
  'query', '$(sql_escape "$q")',
  'total_matches', (SELECT count(*) FROM ordered_docs),
  'results', coalesce((
    SELECT json_group_array(
      json_object(
        'entity_type', entity_type,
        'entity_id', entity_id,
        'section', section,
        'title', title,
        'rrf_score', rrf_score,
        'sources', sources,
        'snippet', snippet
      )
    ) FROM ordered_docs
  ), json_array())
);
EOF
    exit 0
    ;;

  *)
    printf 'fts5-driver: error: unknown subsystem or method '\''%s'\'' (ERR_CAPABILITY_UNSUPPORTED)\n' "$CMD" >&2
    exit 2
    ;;
esac
