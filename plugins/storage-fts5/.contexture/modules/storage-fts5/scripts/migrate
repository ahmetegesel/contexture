#!/bin/sh
# summary: bidirectional migration between POSIX flat files and SQLite FTS5 database
# usage: ctx storage-fts5 migrate --from=<posix|fts5> --to=<posix|fts5> [--unit=<unit>] [--db=<path>]
# help: imports session files into the store (each file kept verbatim as its artifact, the relational index and the FTS5 documents rebuilt from it), or exports the stored text back to files byte for byte.
# help: example: ctx storage-fts5 migrate --from=posix --to=fts5
# help: example: ctx storage-fts5 migrate --from=posix --to=fts5 --unit=storage
# help: example: ctx storage-fts5 migrate --from=fts5 --to=posix --unit=storage

set -u

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'storage-fts5 migrate: error: sqlite3 executable not found (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
MODULE_DIR=$(CDPATH="" cd "$SCRIPT_DIR/.." && pwd)
SCHEMA_SQL="$MODULE_DIR/schema.sql"

find_workspace_root() {
  curr="$PWD"
  while [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

ROOT=$(find_workspace_root)

FROM_MODE=""
TO_MODE=""
TARGET_UNIT=""
CUSTOM_DB=""

for arg in "$@"; do
  case "$arg" in
    --from=*)
      FROM_MODE="${arg#--from=}"
      ;;
    --to=*)
      TO_MODE="${arg#--to=}"
      ;;
    --unit=*)
      TARGET_UNIT="${arg#--unit=}"
      ;;
    --db=*)
      CUSTOM_DB="${arg#--db=}"
      ;;
    --help|-h)
      printf 'usage: ctx storage-fts5 migrate --from=<posix|fts5> --to=<posix|fts5> [--unit=<unit>] [--db=<path>]\n'
      printf '  --from=<backend>  source backend (posix or fts5)\n'
      printf '  --to=<backend>    destination backend (posix or fts5)\n'
      printf '  --unit=<unit>     migrate single session unit (default: all sessions)\n'
      printf '  --db=<path>       custom SQLite database path\n'
      printf '  --help, -h        display this help summary\n'
      exit 0
      ;;
    *)
      printf 'storage-fts5 migrate: unknown argument: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

if [ -z "$FROM_MODE" ] || [ -z "$TO_MODE" ]; then
  printf 'storage-fts5 migrate: error: both --from and --to are required (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

if [ "$FROM_MODE" = "$TO_MODE" ]; then
  printf 'storage-fts5 migrate: error: --from and --to cannot be identical (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

if [ "$FROM_MODE" != "posix" ] && [ "$FROM_MODE" != "fts5" ]; then
  printf 'storage-fts5 migrate: error: unsupported --from backend: %s (ERR_INVALID_ARGUMENT)\n' "$FROM_MODE" >&2
  exit 1
fi

if [ "$TO_MODE" != "posix" ] && [ "$TO_MODE" != "fts5" ]; then
  printf 'storage-fts5 migrate: error: unsupported --to backend: %s (ERR_INVALID_ARGUMENT)\n' "$TO_MODE" >&2
  exit 1
fi

if [ -n "$CUSTOM_DB" ]; then
  DB_PATH="$CUSTOM_DB"
elif [ -n "${CTX_STORAGE_SQLITE_PATH:-}" ]; then
  DB_PATH="$CTX_STORAGE_SQLITE_PATH"
elif [ -f "$ROOT/.contexture/config" ] && grep -Eq '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" 2>/dev/null; then
  val=$(grep -E '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" | head -n1 | sed -E 's/^(session\.)?storage\.database[:=[:space:]]+//' | tr -d ' \t\r\n"')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
elif [ -f "$ROOT/.contexture/storage.conf" ] && grep -Eq '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" 2>/dev/null; then
  val=$(grep -E '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" | head -n1 | sed -E 's/^storage\.database[:[:space:]]+//')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
else
  DB_PATH="$ROOT/.contexture/sessions.db"
fi

mkdir -p "$(dirname "$DB_PATH")" "$ROOT/.contexture/tmp"
DB_TMP="$ROOT/.contexture/tmp"

# the open path (fresh schema, the upgrades, later tables): one home for driver and migration
. "$MODULE_DIR/db-init.sh"
# the derived index rebuilt from an artifact's text: one home for driver and migration
. "$MODULE_DIR/index.sh"

sql_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

# ==============================================================================
# Ingest: POSIX -> SQLite FTS5
# ==============================================================================
# Every file is stored verbatim as its artifact (the canonical text) and its rows are
# rebuilt by the shared index; a re-import replaces the unit whole in one transaction.
migrate_posix_to_fts5() {
  unit="$1"
  dir="$ROOT/.contexture/sessions/$unit"
  if [ ! -d "$dir" ] || [ ! -f "$dir/state.md" ]; then
    printf 'storage-fts5 migrate: session directory or state.md not found: %s\n' "$dir" >&2
    return 1
  fi

  db_init

  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  # Pre-flight: the schema's uniqueness rules, checked before any SQL exists, so a
  # refusal names the unit, the kind, and the key instead of a temp-file line number;
  # journal and lane journal slugs are exempt: a legacy repeat imports as its own row
  # keyed by ordinal (the journal is append-only history, the engine refuses a new one)
  dups=""
  [ -f "$dir/backlog.md" ] && dups="$dups$(awk '/^@task[ \t]+/ { print "task " $2 }' "$dir/backlog.md" | sort | uniq -d)
"
  [ -f "$dir/knowledge.md" ] && dups="$dups$(awk '/^@finding[ \t]+/ { print "finding " $2 }' "$dir/knowledge.md" | sort | uniq -d)
"
  dups=$(printf '%s' "$dups" | sed '/^$/d')
  if [ -n "$dups" ]; then
    printf '%s\n' "$dups" | while IFS=' ' read -r kind key; do
      printf "storage-fts5 migrate: error: unit '%s' repeats %s %s; the record must carry each key once (ERR_SCHEMA_VIOLATION)\n" "$unit" "$kind" "$key" >&2
    done
    return 1
  fi

  # the ingest SQL, one transaction
  tmp_sql="$ROOT/.contexture/tmp/ingest-$unit-$$.sql"

  {
    printf 'PRAGMA foreign_keys = ON;\nBEGIN IMMEDIATE;\n'
    printf "DELETE FROM sessions WHERE unit = '%s';\n" "$(sql_escape "$unit")"
    printf "INSERT INTO sessions (unit, status, current_anchor, objective, next_action, repos, ref_sessions, created_at) VALUES ('%s', 'ACTIVE', 'A1', '', 'plan the next move', '[]', '[]', '%s');\n" "$(sql_escape "$unit")" "$now"
  } > "$tmp_sql"

  for art in state backlog knowledge journal; do
    [ -f "$dir/$art.md" ] && idx_artifact_sql "$unit" "$art" "$dir/$art.md" "$now" >> "$tmp_sql"
  done
  if [ -d "$dir/lanes" ]; then
    for l_dir in "$dir/lanes"/*; do
      [ -d "$l_dir" ] || continue
      lane_name=${l_dir##*/}
      # a lane folder with no artifact is still a lane
      printf "INSERT OR IGNORE INTO lanes (unit, lane_slug, goal, recipe, report, created_at, updated_at) VALUES ('%s', '%s', '', '', '', '%s', '%s');\n" \
        "$(sql_escape "$unit")" "$(sql_escape "$lane_name")" "$now" "$now" >> "$tmp_sql"
      for art in recipe journal report; do
        [ -f "$l_dir/$art.md" ] && idx_artifact_sql "$unit" "lane/$lane_name/$art" "$l_dir/$art.md" "$now" >> "$tmp_sql"
      done
    done
  fi

  printf 'COMMIT;\n' >> "$tmp_sql"

  sq -bail "$DB_PATH" < "$tmp_sql"
  rc=$?
  rm -f "$tmp_sql"

  if [ "$rc" -ne 0 ]; then
    printf 'storage-fts5 migrate: SQLite import failed with exit code %d\n' "$rc" >&2
    return 1
  fi

  # Count migrated records
  uq=$(sql_escape "$unit")
  cnt_t=$(sq "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$uq';")
  cnt_e=$(sq "$DB_PATH" "SELECT count(*) FROM entries WHERE unit='$uq';")
  cnt_f=$(sq "$DB_PATH" "SELECT count(*) FROM findings WHERE unit='$uq';")
  cnt_l=$(sq "$DB_PATH" "SELECT count(*) FROM lanes WHERE unit='$uq';")
  cnt_le=$(sq "$DB_PATH" "SELECT count(*) FROM lane_entries WHERE unit='$uq';")
  cnt_a=$(sq "$DB_PATH" "SELECT count(*) FROM artifacts WHERE unit='$uq';")

  printf '{"status":"ok","from":"posix","to":"fts5","unit":"%s","sessions":1,"tasks":%d,"entries":%d,"findings":%d,"lanes":%d,"lane_entries":%d,"artifacts":%d}\n' \
    "$unit" "$cnt_t" "$cnt_e" "$cnt_f" "$cnt_l" "$cnt_le" "$cnt_a"
  return 0
}

# ==============================================================================
# Export: SQLite FTS5 -> POSIX
# ==============================================================================
# The stored text is written back byte for byte; a lane with no artifact keeps its folder.
migrate_fts5_to_posix() {
  unit="$1"
  db_init

  uq=$(sql_escape "$unit")
  exists=$(sq "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$uq';")
  if [ "$exists" -eq 0 ]; then
    printf "storage-fts5 migrate: unit '%s' not found in SQLite database\n" "$unit" >&2
    return 1
  fi

  staging="$ROOT/.contexture/tmp/migrate-export-$unit-$$"
  rm -rf "$staging"
  mkdir -p "$staging"
  for l_slug in $(sq "$DB_PATH" "SELECT lane_slug FROM lanes WHERE unit='$uq' ORDER BY lane_slug;"); do
    mkdir -p "$staging/lanes/$l_slug"
  done
  if ! sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$staging")/' || CASE WHEN lane_slug = '' THEN name ELSE 'lanes/' || lane_slug || '/' || name END || '.md', body) FROM artifacts WHERE unit = '$uq';" > /dev/null; then
    rm -rf "$staging"
    printf 'storage-fts5 migrate: export of %s failed\n' "$unit" >&2
    return 1
  fi

  # Atomic replace target session directory
  dest="$ROOT/.contexture/sessions/$unit"
  mkdir -p "$(dirname "$dest")"
  rm -rf "$dest.tmp"
  cp -R "$staging" "$dest.tmp"
  rm -rf "$staging"
  rm -rf "$dest.bak"
  [ -d "$dest" ] && mv "$dest" "$dest.bak"
  mv "$dest.tmp" "$dest"
  rm -rf "$dest.bak"

  cnt_t=$(sq "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$uq';")
  cnt_e=$(sq "$DB_PATH" "SELECT count(*) FROM entries WHERE unit='$uq';")
  cnt_f=$(sq "$DB_PATH" "SELECT count(*) FROM findings WHERE unit='$uq';")
  cnt_l=$(sq "$DB_PATH" "SELECT count(*) FROM lanes WHERE unit='$uq';")
  cnt_le=$(sq "$DB_PATH" "SELECT count(*) FROM lane_entries WHERE unit='$uq';")
  cnt_a=$(sq "$DB_PATH" "SELECT count(*) FROM artifacts WHERE unit='$uq';")

  printf '{"status":"ok","from":"fts5","to":"posix","unit":"%s","sessions":1,"tasks":%d,"entries":%d,"findings":%d,"lanes":%d,"lane_entries":%d,"artifacts":%d}\n' \
    "$unit" "$cnt_t" "$cnt_e" "$cnt_f" "$cnt_l" "$cnt_le" "$cnt_a"
  return 0
}

# ==============================================================================
# Main Execution Loop
# ==============================================================================
exit_code=0

if [ -n "$TARGET_UNIT" ]; then
  UNITS="$TARGET_UNIT"
else
  if [ "$FROM_MODE" = "posix" ]; then
    UNITS=$(find "$ROOT/.contexture/sessions" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null || true)
  else
    db_init
    UNITS=$(sq "$DB_PATH" "SELECT unit FROM sessions;" 2>/dev/null || true)
  fi
fi

if [ -z "$UNITS" ]; then
  printf 'storage-fts5 migrate: no sessions found to migrate\n'
  exit 0
fi

for u in $UNITS; do
  if [ "$FROM_MODE" = "posix" ] && [ "$TO_MODE" = "fts5" ]; then
    migrate_posix_to_fts5 "$u" || exit_code=1
  elif [ "$FROM_MODE" = "fts5" ] && [ "$TO_MODE" = "posix" ]; then
    migrate_fts5_to_posix "$u" || exit_code=1
  fi
done

exit "$exit_code"
