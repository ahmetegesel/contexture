#!/bin/sh
# summary: bidirectional migration between POSIX flat files and SQLite FTS5 database
# usage: ctx storage-fts5 migrate --from=<posix|fts5> --to=<posix|fts5> [--unit=<unit>] [--corpus] [--prune] [--db=<path>]
# help: imports session files into the store (each file kept verbatim as its artifact, the relational index and the FTS5 documents rebuilt from it), or exports the stored text back to files byte for byte.
# help: the doc corpus moves with --corpus: the files side is read and written through the posix reference driver (corpus.list, read, write, remove), every doc kept verbatim; the bare form moves every unit and the corpus, --unit one unit, --corpus alone the corpus alone.
# help: an import mirrors the files (store docs the files lack are dropped) and writes no change-log row; a tracked corpus with uncommitted changes refuses, and a clean tracked one prints the git steps that follow; an export refuses when the files hold a doc the store lacks unless --prune removes it; an empty source never empties the destination.
# help: example: ctx storage-fts5 migrate --from=posix --to=fts5
# help: example: ctx storage-fts5 migrate --from=posix --to=fts5 --unit=storage
# help: example: ctx storage-fts5 migrate --from=fts5 --to=posix --unit=storage
# help: example: ctx storage-fts5 migrate --from=posix --to=fts5 --corpus
# help: example: ctx storage-fts5 migrate --from=fts5 --to=posix --corpus --prune

set -u

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'storage-fts5 migrate: error: sqlite3 executable not found (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
MODULE_DIR=$(CDPATH="" cd "$SCRIPT_DIR/.." && pwd)
SCHEMA_SQL="$MODULE_DIR/schema.sql"

find_workspace_root() {
  curr="$PWD"
  while [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

ROOT=$(find_workspace_root)

FROM_MODE=""
TO_MODE=""
TARGET_UNIT=""
CUSTOM_DB=""
CORPUS=0
PRUNE=0

for arg in "$@"; do
  case "$arg" in
    --from=*)
      FROM_MODE="${arg#--from=}"
      ;;
    --to=*)
      TO_MODE="${arg#--to=}"
      ;;
    --unit=*)
      TARGET_UNIT="${arg#--unit=}"
      ;;
    --corpus)
      CORPUS=1
      ;;
    --prune)
      PRUNE=1
      ;;
    --db=*)
      CUSTOM_DB="${arg#--db=}"
      ;;
    --help|-h)
      printf 'usage: ctx storage-fts5 migrate --from=<posix|fts5> --to=<posix|fts5> [--unit=<unit>] [--corpus] [--prune] [--db=<path>]\n'
      printf '  --from=<backend>  source backend (posix or fts5)\n'
      printf '  --to=<backend>    destination backend (posix or fts5)\n'
      printf '  --unit=<unit>     migrate single session unit (default: all sessions and the corpus)\n'
      printf '  --corpus          migrate the doc corpus (alone, or beside --unit)\n'
      printf '  --prune           on a corpus export, remove the docs the store lacks from the files\n'
      printf '  --db=<path>       custom SQLite database path\n'
      printf '  --help, -h        display this help summary\n'
      exit 0
      ;;
    *)
      printf 'storage-fts5 migrate: unknown argument: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

if [ -z "$FROM_MODE" ] || [ -z "$TO_MODE" ]; then
  printf 'storage-fts5 migrate: error: both --from and --to are required (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

if [ "$FROM_MODE" = "$TO_MODE" ]; then
  printf 'storage-fts5 migrate: error: --from and --to cannot be identical (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

if [ "$FROM_MODE" != "posix" ] && [ "$FROM_MODE" != "fts5" ]; then
  printf 'storage-fts5 migrate: error: unsupported --from backend: %s (ERR_INVALID_ARGUMENT)\n' "$FROM_MODE" >&2
  exit 1
fi

if [ "$TO_MODE" != "posix" ] && [ "$TO_MODE" != "fts5" ]; then
  printf 'storage-fts5 migrate: error: unsupported --to backend: %s (ERR_INVALID_ARGUMENT)\n' "$TO_MODE" >&2
  exit 1
fi

# the scope: --unit alone one unit, --corpus alone the corpus, both together both, the bare
# form every unit and the corpus
DO_UNITS=1
DO_CORPUS=0
if [ -n "$TARGET_UNIT" ]; then
  [ "$CORPUS" -eq 1 ] && DO_CORPUS=1
elif [ "$CORPUS" -eq 1 ]; then
  DO_UNITS=0
  DO_CORPUS=1
else
  DO_CORPUS=1
fi
if [ "$PRUNE" -eq 1 ] && { [ "$FROM_MODE" != "fts5" ] || [ "$DO_CORPUS" -ne 1 ]; }; then
  printf 'storage-fts5 migrate: error: --prune applies to a corpus export only (--from=fts5 --to=posix with the corpus in scope) (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

if [ -n "$CUSTOM_DB" ]; then
  DB_PATH="$CUSTOM_DB"
elif [ -n "${CTX_STORAGE_SQLITE_PATH:-}" ]; then
  DB_PATH="$CTX_STORAGE_SQLITE_PATH"
elif [ -f "$ROOT/.contexture/config" ] && grep -Eq '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" 2>/dev/null; then
  val=$(grep -E '^(session\.)?storage\.database[:=[:space:]]' "$ROOT/.contexture/config" | head -n1 | sed -E 's/^(session\.)?storage\.database[:=[:space:]]+//' | tr -d ' \t\r\n"')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
elif [ -f "$ROOT/.contexture/storage.conf" ] && grep -Eq '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" 2>/dev/null; then
  val=$(grep -E '^storage\.database[:[:space:]]' "$ROOT/.contexture/storage.conf" | head -n1 | sed -E 's/^storage\.database[:[:space:]]+//')
  case "$val" in
    /*) DB_PATH="$val" ;;
    *)  DB_PATH="$ROOT/$val" ;;
  esac
else
  DB_PATH="$ROOT/.contexture/sessions.db"
fi

mkdir -p "$(dirname "$DB_PATH")" "$ROOT/.contexture/tmp"
DB_TMP="$ROOT/.contexture/tmp"

# the open path (fresh schema, the upgrades, later tables): one home for driver and migration
. "$MODULE_DIR/db-init.sh"
# the derived index rebuilt from an artifact's text: one home for driver and migration
. "$MODULE_DIR/index.sh"

sql_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

# ==============================================================================
# Ingest: POSIX -> SQLite FTS5
# ==============================================================================
# Every file is stored verbatim as its artifact (the canonical text) and its rows are
# rebuilt by the shared index; a re-import replaces the unit whole in one transaction.
migrate_posix_to_fts5() {
  unit="$1"
  dir="$ROOT/.contexture/sessions/$unit"
  if [ ! -d "$dir" ] || [ ! -f "$dir/state.md" ]; then
    printf 'storage-fts5 migrate: session directory or state.md not found: %s\n' "$dir" >&2
    return 1
  fi

  db_init

  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  # Pre-flight: the schema's uniqueness rules, checked before any SQL exists, so a
  # refusal names the unit, the kind, and the key instead of a temp-file line number;
  # journal and lane journal slugs are exempt: a legacy repeat imports as its own row
  # keyed by ordinal (the journal is append-only history, the engine refuses a new one)
  dups=""
  [ -f "$dir/backlog.md" ] && dups="$dups$(awk '/^@task[ \t]+/ { print "task " $2 }' "$dir/backlog.md" | sort | uniq -d)
"
  [ -f "$dir/knowledge.md" ] && dups="$dups$(awk '/^@finding[ \t]+/ { print "finding " $2 }' "$dir/knowledge.md" | sort | uniq -d)
"
  dups=$(printf '%s' "$dups" | sed '/^$/d')
  if [ -n "$dups" ]; then
    printf '%s\n' "$dups" | while IFS=' ' read -r kind key; do
      printf "storage-fts5 migrate: error: unit '%s' repeats %s %s; the record must carry each key once (ERR_SCHEMA_VIOLATION)\n" "$unit" "$kind" "$key" >&2
    done
    return 1
  fi

  # the ingest SQL, one transaction
  tmp_sql="$ROOT/.contexture/tmp/ingest-$unit-$$.sql"

  {
    printf 'PRAGMA foreign_keys = ON;\nBEGIN IMMEDIATE;\n'
    printf "DELETE FROM sessions WHERE unit = '%s';\n" "$(sql_escape "$unit")"
    printf "INSERT INTO sessions (unit, status, current_anchor, objective, next_action, repos, ref_sessions, created_at) VALUES ('%s', 'ACTIVE', 'A1', '', 'plan the next move', '[]', '[]', '%s');\n" "$(sql_escape "$unit")" "$now"
  } > "$tmp_sql"

  for art in state backlog knowledge journal; do
    [ -f "$dir/$art.md" ] && idx_artifact_sql "$unit" "$art" "$dir/$art.md" "$now" >> "$tmp_sql"
  done
  if [ -d "$dir/lanes" ]; then
    for l_dir in "$dir/lanes"/*; do
      [ -d "$l_dir" ] || continue
      lane_name=${l_dir##*/}
      # a lane folder with no artifact is still a lane
      printf "INSERT OR IGNORE INTO lanes (unit, lane_slug, goal, recipe, report, created_at, updated_at) VALUES ('%s', '%s', '', '', '', '%s', '%s');\n" \
        "$(sql_escape "$unit")" "$(sql_escape "$lane_name")" "$now" "$now" >> "$tmp_sql"
      for art in recipe journal report; do
        [ -f "$l_dir/$art.md" ] && idx_artifact_sql "$unit" "lane/$lane_name/$art" "$l_dir/$art.md" "$now" >> "$tmp_sql"
      done
    done
  fi

  printf 'COMMIT;\n' >> "$tmp_sql"

  sq -bail "$DB_PATH" < "$tmp_sql"
  rc=$?
  rm -f "$tmp_sql"

  if [ "$rc" -ne 0 ]; then
    printf 'storage-fts5 migrate: SQLite import failed with exit code %d\n' "$rc" >&2
    return 1
  fi

  # Count migrated records
  uq=$(sql_escape "$unit")
  cnt_t=$(sq "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$uq';")
  cnt_e=$(sq "$DB_PATH" "SELECT count(*) FROM entries WHERE unit='$uq';")
  cnt_f=$(sq "$DB_PATH" "SELECT count(*) FROM findings WHERE unit='$uq';")
  cnt_l=$(sq "$DB_PATH" "SELECT count(*) FROM lanes WHERE unit='$uq';")
  cnt_le=$(sq "$DB_PATH" "SELECT count(*) FROM lane_entries WHERE unit='$uq';")
  cnt_a=$(sq "$DB_PATH" "SELECT count(*) FROM artifacts WHERE unit='$uq';")

  printf '{"status":"ok","from":"posix","to":"fts5","unit":"%s","sessions":1,"tasks":%d,"entries":%d,"findings":%d,"lanes":%d,"lane_entries":%d,"artifacts":%d}\n' \
    "$unit" "$cnt_t" "$cnt_e" "$cnt_f" "$cnt_l" "$cnt_le" "$cnt_a"
  return 0
}

# ==============================================================================
# Export: SQLite FTS5 -> POSIX
# ==============================================================================
# The stored text is written back byte for byte; a lane with no artifact keeps its folder.
migrate_fts5_to_posix() {
  unit="$1"
  db_init

  uq=$(sql_escape "$unit")
  exists=$(sq "$DB_PATH" "SELECT count(*) FROM sessions WHERE unit='$uq';")
  if [ "$exists" -eq 0 ]; then
    printf "storage-fts5 migrate: unit '%s' not found in SQLite database\n" "$unit" >&2
    return 1
  fi

  staging="$ROOT/.contexture/tmp/migrate-export-$unit-$$"
  rm -rf "$staging"
  mkdir -p "$staging"
  for l_slug in $(sq "$DB_PATH" "SELECT lane_slug FROM lanes WHERE unit='$uq' ORDER BY lane_slug;"); do
    mkdir -p "$staging/lanes/$l_slug"
  done
  if ! sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$staging")/' || CASE WHEN lane_slug = '' THEN name ELSE 'lanes/' || lane_slug || '/' || name END || '.md', body) FROM artifacts WHERE unit = '$uq';" > /dev/null; then
    rm -rf "$staging"
    printf 'storage-fts5 migrate: export of %s failed\n' "$unit" >&2
    return 1
  fi

  # Atomic replace target session directory
  dest="$ROOT/.contexture/sessions/$unit"
  mkdir -p "$(dirname "$dest")"
  rm -rf "$dest.tmp"
  cp -R "$staging" "$dest.tmp"
  rm -rf "$staging"
  rm -rf "$dest.bak"
  [ -d "$dest" ] && mv "$dest" "$dest.bak"
  mv "$dest.tmp" "$dest"
  rm -rf "$dest.bak"

  cnt_t=$(sq "$DB_PATH" "SELECT count(*) FROM tasks WHERE unit='$uq';")
  cnt_e=$(sq "$DB_PATH" "SELECT count(*) FROM entries WHERE unit='$uq';")
  cnt_f=$(sq "$DB_PATH" "SELECT count(*) FROM findings WHERE unit='$uq';")
  cnt_l=$(sq "$DB_PATH" "SELECT count(*) FROM lanes WHERE unit='$uq';")
  cnt_le=$(sq "$DB_PATH" "SELECT count(*) FROM lane_entries WHERE unit='$uq';")
  cnt_a=$(sq "$DB_PATH" "SELECT count(*) FROM artifacts WHERE unit='$uq';")

  printf '{"status":"ok","from":"fts5","to":"posix","unit":"%s","sessions":1,"tasks":%d,"entries":%d,"findings":%d,"lanes":%d,"lane_entries":%d,"artifacts":%d}\n' \
    "$unit" "$cnt_t" "$cnt_e" "$cnt_f" "$cnt_l" "$cnt_le" "$cnt_a"
  return 0
}

# ==============================================================================
# The corpus: the files side through the posix reference driver
# ==============================================================================
# The posix layout is the reference serialization of the corpus as of the record: the files
# side is read and written only through the posix driver's corpus methods (corpus.list,
# read, write, remove), never by a glob or a path of this script's own; the store side is
# the docs table. A doc moves verbatim. An import writes no change-log row (an import is no
# doc change, so the first gate after a cutover sees only real writes). An empty source
# never empties the destination: the corpus step then leaves it as is and says so.
find_reference() {
  if [ -n "${CTX_REFERENCE_DRIVER:-}" ] && [ -x "$CTX_REFERENCE_DRIVER" ]; then
    printf '%s\n' "$CTX_REFERENCE_DRIVER"; return 0
  fi
  for rf in "$ROOT/.contexture/modules/session/drivers/posix/driver" \
            "$MODULE_DIR/../session/drivers/posix/driver"; do
    if [ -x "$rf" ]; then printf '%s\n' "$rf"; return 0; fi
  done
  return 1
}

# ref_call <method> [args]: one posix reference call from the workspace root
ref_call() {
  (
    unset CTX_DIR
    CTX_ROOT=$ROOT
    export CTX_ROOT
    cd "$ROOT" || exit 2
    exec "$REF" "$@"
  )
}

corpus_scratch() {
  CS=$(mktemp -d "$ROOT/.contexture/tmp/migrate-corpus.XXXXXX") || {
    printf 'storage-fts5 migrate: error: cannot make a scratch folder for the corpus (ERR_STORAGE_WRITE)\n' >&2
    return 1
  }
}

corpus_ref() {
  REF=$(find_reference) || {
    printf 'storage-fts5 migrate: error: the corpus moves through the posix reference driver, which was not found; set CTX_REFERENCE_DRIVER (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 1
  }
}

# corpus_file_keys: the files side's docs, one <repo>/<slug> per line (CORPUS_FILE_KEYS)
corpus_file_keys() {
  if CORPUS_FILE_KEYS=$(ref_call corpus.list < /dev/null 2> "$CS/list.err"); then
    return 0
  fi
  printf 'storage-fts5 migrate: error: the files corpus could not be listed through the posix reference driver: %s\n' "$(cat "$CS/list.err")" >&2
  return 1
}

migrate_corpus_posix_to_fts5() {
  corpus_ref || return 1
  corpus_scratch || return 1
  corpus_file_keys || { rm -rf "$CS"; return 1; }
  if [ -z "$CORPUS_FILE_KEYS" ]; then
    rm -rf "$CS"
    printf '{"status":"ok","from":"posix","to":"fts5","corpus":"skipped","docs":0,"detail":"the files hold no doc; the store corpus is left as is"}\n'
    return 0
  fi
  # a git-tracked corpus moves only from a committed state: a tracked repo folder with any
  # change refuses by name; after a clean import the git steps are printed, never run
  tracked=""
  dirty=""
  if git -C "$ROOT" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    for r in $(printf '%s\n' "$CORPUS_FILE_KEYS" | sed 's|/.*||' | uniq); do
      if [ -n "$(git -C "$ROOT" ls-files -- "docs/$r" 2>/dev/null)" ]; then
        tracked="$tracked $r"
        [ -n "$(git -C "$ROOT" status --porcelain -- "docs/$r" 2>/dev/null)" ] && dirty="$dirty $r"
      fi
    done
  fi
  if [ -n "$dirty" ]; then
    rm -rf "$CS"
    printf 'storage-fts5 migrate: error: the tracked corpus carries uncommitted changes in repo(s)%s; commit or discard them first, the import mirrors a committed state (ERR_SCHEMA_VIOLATION)\n' "$dirty" >&2
    return 1
  fi
  # every doc read through the reference and named by its own @doc line: a doc whose slug
  # differs from its name refuses by name before anything is stored (refuse, never rename)
  n=0
  bad=0
  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  printf 'PRAGMA foreign_keys = ON;\nBEGIN IMMEDIATE;\nDELETE FROM docs;\n' > "$CS/import.sql"
  for k in $CORPUS_FILE_KEYS; do
    r=${k%%/*}
    s=${k#*/}
    n=$((n + 1))
    if ! ref_call corpus.read "$r" "$s" < /dev/null > "$CS/doc-$n" 2> "$CS/read.err"; then
      printf 'storage-fts5 migrate: error: doc %s/%s could not be read through the posix reference driver: %s\n' "$r" "$s" "$(cat "$CS/read.err")" >&2
      bad=1
      continue
    fi
    head_slug=$(awk 'NR == 1 { if ($1 == "@doc") print $3; exit }' "$CS/doc-$n")
    if [ "$head_slug" != "$s" ]; then
      printf "storage-fts5 migrate: error: doc %s/%s names itself '%s' on its @doc line; a doc's slug must equal its name (ERR_SCHEMA_VIOLATION)\n" "$r" "$s" "$head_slug" >&2
      bad=1
      continue
    fi
    printf "INSERT INTO docs (repo, slug, body, updated_at) VALUES ('%s', '%s', CAST(readfile('%s') AS TEXT), '%s');\n" \
      "$(sql_escape "$r")" "$(sql_escape "$s")" "$(sql_escape "$CS/doc-$n")" "$now" >> "$CS/import.sql"
  done
  if [ "$bad" -ne 0 ]; then
    rm -rf "$CS"
    return 1
  fi
  printf 'COMMIT;\n' >> "$CS/import.sql"
  db_init
  printf '%s\n' "$CORPUS_FILE_KEYS" | LC_ALL=C sort > "$CS/keys"
  dropped=$(sq "$DB_PATH" "SELECT repo || '/' || slug FROM docs;" | LC_ALL=C sort | LC_ALL=C comm -23 - "$CS/keys" | wc -l | tr -d ' ')
  if ! sq -bail "$DB_PATH" < "$CS/import.sql" > /dev/null; then
    rm -rf "$CS"
    printf 'storage-fts5 migrate: error: the corpus import failed and rolled back (ERR_STORAGE_WRITE)\n' >&2
    return 1
  fi
  stored=$(sq "$DB_PATH" "SELECT count(*) FROM docs;")
  rm -rf "$CS"
  printf '{"status":"ok","from":"posix","to":"fts5","corpus":"imported","docs":%d,"dropped":%d}\n' "$stored" "$dropped"
  if [ -n "$tracked" ]; then
    printf 'storage-fts5 migrate: the corpus of repo(s)%s is tracked in git; the store now holds it, so the files invite edits that no longer reach the corpus. Next steps (run them yourself):\n' "$tracked" >&2
    for r in $tracked; do
      printf '  git rm -r --cached docs/%s\n' "$r" >&2
    done
    printf '  ignore those folders (.gitignore), commit, delete the working files, and set storage.driver: fts5 in .contexture/config\n' >&2
  fi
  return 0
}

migrate_corpus_fts5_to_posix() {
  corpus_ref || return 1
  db_init
  store_keys=$(sq "$DB_PATH" "SELECT repo || '/' || slug FROM docs ORDER BY repo || '/' || slug || '.md' COLLATE BINARY;")
  if [ -z "$store_keys" ]; then
    printf '{"status":"ok","from":"fts5","to":"posix","corpus":"skipped","docs":0,"detail":"the store holds no doc; the files corpus is left as is"}\n'
    return 0
  fi
  corpus_scratch || return 1
  corpus_file_keys || { rm -rf "$CS"; return 1; }
  printf '%s\n' "$store_keys" | LC_ALL=C sort > "$CS/store"
  printf '%s\n' "$CORPUS_FILE_KEYS" | sed '/^$/d' | LC_ALL=C sort > "$CS/files"
  extras=$(LC_ALL=C comm -13 "$CS/store" "$CS/files")
  if [ -n "$extras" ] && [ "$PRUNE" -ne 1 ]; then
    rm -rf "$CS"
    printf 'storage-fts5 migrate: error: the files hold doc(s) the store lacks: %s; an export never deletes a doc silently, rerun with --prune to remove them (ERR_ENTITY_EXISTS)\n' "$(printf '%s' "$extras" | tr '\n' ' ' | sed 's/ $//')" >&2
    return 1
  fi
  # the stored text into scratch byte for byte, then each doc written through the reference
  mkdir -p "$CS/docs"
  for r in $(printf '%s\n' "$store_keys" | sed 's|/.*||' | uniq); do
    mkdir -p "$CS/docs/$r"
  done
  if ! sq -bail "$DB_PATH" "SELECT writefile('$(sql_escape "$CS")/docs/' || repo || '/' || slug || '.md', body) FROM docs;" > /dev/null; then
    rm -rf "$CS"
    printf 'storage-fts5 migrate: error: the corpus export could not read the store (ERR_STORAGE_READ)\n' >&2
    return 1
  fi
  n=0
  for k in $store_keys; do
    [ -f "$CS/docs/$k.md" ] || : > "$CS/docs/$k.md"
    if ! ref_call corpus.write "${k%%/*}" "${k#*/}" < "$CS/docs/$k.md" > /dev/null 2> "$CS/write.err"; then
      printf 'storage-fts5 migrate: error: doc %s could not be written through the posix reference driver (%d written before it): %s\n' "$k" "$n" "$(cat "$CS/write.err")" >&2
      rm -rf "$CS"
      return 1
    fi
    n=$((n + 1))
  done
  pruned=0
  for k in $extras; do
    if ! ref_call corpus.remove "${k%%/*}" "${k#*/}" < /dev/null > /dev/null 2> "$CS/remove.err"; then
      printf 'storage-fts5 migrate: error: doc %s could not be pruned: %s\n' "$k" "$(cat "$CS/remove.err")" >&2
      rm -rf "$CS"
      return 1
    fi
    pruned=$((pruned + 1))
  done
  rm -rf "$CS"
  printf '{"status":"ok","from":"fts5","to":"posix","corpus":"exported","docs":%d,"pruned":%d}\n' "$n" "$pruned"
  return 0
}

# ==============================================================================
# Main Execution Loop
# ==============================================================================
exit_code=0

if [ "$DO_UNITS" -eq 1 ]; then
  if [ -n "$TARGET_UNIT" ]; then
    UNITS="$TARGET_UNIT"
  else
    if [ "$FROM_MODE" = "posix" ]; then
      UNITS=$(find "$ROOT/.contexture/sessions" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null || true)
    else
      db_init
      UNITS=$(sq "$DB_PATH" "SELECT unit FROM sessions;" 2>/dev/null || true)
    fi
  fi

  if [ -z "$UNITS" ]; then
    printf 'storage-fts5 migrate: no sessions found to migrate\n'
    [ "$DO_CORPUS" -eq 1 ] || exit 0
  fi

  for u in $UNITS; do
    if [ "$FROM_MODE" = "posix" ] && [ "$TO_MODE" = "fts5" ]; then
      migrate_posix_to_fts5 "$u" || exit_code=1
    elif [ "$FROM_MODE" = "fts5" ] && [ "$TO_MODE" = "posix" ]; then
      migrate_fts5_to_posix "$u" || exit_code=1
    fi
  done
fi

if [ "$DO_CORPUS" -eq 1 ]; then
  if [ "$FROM_MODE" = "posix" ]; then
    migrate_corpus_posix_to_fts5 || exit_code=1
  else
    migrate_corpus_fts5_to_posix || exit_code=1
  fi
fi

exit "$exit_code"
