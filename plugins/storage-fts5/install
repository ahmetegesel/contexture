#!/bin/sh
# install this package into the workspace's extension root: the package installer
# overlays the package's .contexture/extensions tree, records every installed
# path and its mode, and runs the module part hooks. Run it only on the human's
# go at the act.
# Usage: install [--help]
set -u
case "${1:-}" in
  -h|--help)
    printf 'usage: install\n'
    exit 0
    ;;
  "") ;;
  *)
    echo "install: unexpected argument: $1" >&2
    exit 1
    ;;
esac
pkg=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
if [ -n "${CTX_ROOT:-}" ]; then
  root=$(CDPATH= cd -- "$CTX_ROOT" 2>/dev/null && pwd) || { echo "install: CTX_ROOT is not a directory: $CTX_ROOT" >&2; exit 2; }
else
  root=$(CDPATH= cd -- "$pkg/../.." 2>/dev/null && pwd) || { echo "install: cannot locate the workspace root (set CTX_ROOT)" >&2; exit 2; }
fi
if [ ! -x "$root/.contexture/package-install" ]; then
  echo "install: the package installer is not at $root/.contexture/package-install (adopt the base first)" >&2
  exit 2
fi
exec "$root/.contexture/package-install" "$pkg"
