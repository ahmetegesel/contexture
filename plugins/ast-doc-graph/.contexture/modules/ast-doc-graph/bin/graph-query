      else
        echo "  [${d_depth}] ${d_name}"
      fi
    done <<< "$callees_output"
  fi
}

# 4. rules <target>
cmd_rules() {
  local target="$1"
  if [[ -z "$target" ]]; then
    echo "Error: rules requires a target symbol name or qname." >&2
    exit 1
  fi
  local target_esc
  target_esc=$(sql_escape "$target")

  local sym_row
  sym_row=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
    SELECT id, qname FROM symbols
    WHERE qname = '${target_esc}' OR id = '${target_esc}' OR name = '${target_esc}'
    LIMIT 1;
  ")

  local s_id="$target" s_qname="$target"
  if [[ -n "$sym_row" ]]; then
    IFS="$SEP" read -r s_id s_qname <<< "$sym_row"
  fi

  local s_id_esc s_qname_esc
  s_id_esc=$(sql_escape "$s_id")
  s_qname_esc=$(sql_escape "$s_qname")

  echo "@rules $s_qname"
  local rules_output
  rules_output=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
    SELECT DISTINCT
      r.id,
      r.doc_id,
      replace(replace(r.statement, char(10), ' '), char(9), ' '),
      coalesce(replace(replace(r.detail, char(10), ' '), char(9), ' '), ''),
      coalesce(replace(replace(r.anti, char(10), ' '), char(9), ' '), ''),
      coalesce(replace(replace(r.good, char(10), ' '), char(9), ' '), '')
    FROM rules r
    JOIN edges e ON r.id = e.source AND e.kind = 'GOVERNS'
    WHERE e.target IN ('${s_id_esc}', '${s_qname_esc}')
    ORDER BY r.id ASC;
  ")

  if [[ -z "$rules_output" ]]; then
    echo "  none"
  else
    local r_id r_doc r_stmt r_detail r_anti r_good
    while IFS="$SEP" read -r r_id r_doc r_stmt r_detail r_anti r_good; do
      echo "  rule: ${r_id} (doc: ${r_doc})"
      echo "    STATEMENT: ${r_stmt}"
      if [[ -n "$r_detail" ]]; then
        echo "    DETAIL: ${r_detail}"
      fi
      if [[ -n "$r_anti" ]]; then
        echo "    ANTI: ${r_anti}"
      fi
      if [[ -n "$r_good" ]]; then
        echo "    GOOD: ${r_good}"
      fi
    done <<< "$rules_output"
  fi
}

# 5. pitfalls <target>
cmd_pitfalls() {
  local target="$1"
  if [[ -z "$target" ]]; then
    echo "Error: pitfalls requires a target symbol name or qname." >&2
    exit 1
  fi
  local target_esc
  target_esc=$(sql_escape "$target")

  local sym_row
  sym_row=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
    SELECT id, qname FROM symbols
    WHERE qname = '${target_esc}' OR id = '${target_esc}' OR name = '${target_esc}'
    LIMIT 1;
  ")

  local s_id="$target" s_qname="$target"
  if [[ -n "$sym_row" ]]; then
    IFS="$SEP" read -r s_id s_qname <<< "$sym_row"
  fi

  local s_id_esc s_qname_esc
  s_id_esc=$(sql_escape "$s_id")
  s_qname_esc=$(sql_escape "$s_qname")

  echo "@pitfalls $s_qname"
  local pitfalls_output
  pitfalls_output=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
    SELECT DISTINCT
      p.id,
      p.doc_id,
      p.severity,
      p.type,
      replace(replace(p.statement, char(10), ' '), char(9), ' '),
      coalesce(replace(replace(p.trigger, char(10), ' '), char(9), ' '), '')
    FROM pitfalls p
    JOIN edges e ON p.id = e.source AND e.kind = 'WARNS'
    WHERE e.target IN ('${s_id_esc}', '${s_qname_esc}')
    ORDER BY p.id ASC;
  ")

  if [[ -z "$pitfalls_output" ]]; then
    echo "  none"
  else
    local p_id p_doc p_sev p_type p_stmt p_trig
    while IFS="$SEP" read -r p_id p_doc p_sev p_type p_stmt p_trig; do
      echo "  pitfall: ${p_id} [severity: ${p_sev}, type: ${p_type}] (doc: ${p_doc})"
      echo "    STATEMENT: ${p_stmt}"
      if [[ -n "$p_trig" ]]; then
        echo "    TRIGGER: ${p_trig}"
      fi
    done <<< "$pitfalls_output"
  fi
}

# 6. search "<query>"
cmd_search() {
  local query="$1"
  if [[ -z "$query" ]]; then
    echo "Error: search requires a query string." >&2
    exit 1
  fi

  echo "@search_results (query: \"$query\")"
  echo ""

  # Build FTS terms for prose docs: prefix terms for each token
  local doc_terms=()
  for term in $query; do
    local clean_term
    clean_term=$(echo "$term" | tr -cd '[:alnum:]_')
    if [[ -n "$clean_term" ]]; then
      doc_terms+=("${clean_term}*")
    fi
  done

  local doc_query
  if [[ ${#doc_terms[@]} -gt 0 ]]; then
    doc_query="${doc_terms[*]}"
  else
    doc_query=$(sql_escape "$query")
  fi

  # Query fts_docs
  local docs_matches
  docs_matches=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
    SELECT
      doc_id,
      entity_id,
      entity_type,
      replace(replace(title, char(10), ' '), char(9), ' '),
      replace(replace(snippet(fts_docs, -1, '<<', '>>', '...', 12), char(10), ' '), char(9), ' '),
      round(bm25(fts_docs), 3) AS score
    FROM fts_docs
    WHERE fts_docs MATCH '${doc_query}'
    ORDER BY score ASC
    LIMIT 10;
  " 2>/dev/null || true)

  # If prefix query had 0 results, try phrase query
  if [[ -z "$docs_matches" ]]; then
    local phrase_query
    phrase_query="\"$(printf '%s' "$query" | sed 's/"/""/g')\""
    docs_matches=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
      SELECT
        doc_id,
        entity_id,
        entity_type,
        replace(replace(title, char(10), ' '), char(9), ' '),
        replace(replace(snippet(fts_docs, -1, '<<', '>>', '...', 12), char(10), ' '), char(9), ' '),
        round(bm25(fts_docs), 3) AS score
      FROM fts_docs
      WHERE fts_docs MATCH '${phrase_query}'
      ORDER BY score ASC
      LIMIT 10;
    " 2>/dev/null || true)
  fi

  echo "@doc_matches"
  if [[ -z "$docs_matches" ]]; then
    echo "  none"
  else
    local m_doc m_ent m_type m_title m_snip m_score
    while IFS="$SEP" read -r m_doc m_ent m_type m_title m_snip m_score; do
      local m_ent_esc
      m_ent_esc=$(sql_escape "$m_ent")

      # Find linked symbols
      local linked_symbols
      linked_symbols=$(sqlite_exec "$DB_PATH" "
        SELECT group_concat(coalesce(s.qname, s.name, e.target), ', ')
        FROM edges e
        LEFT JOIN symbols s ON e.target = s.id
        WHERE e.source = '${m_ent_esc}' AND e.kind IN ('GOVERNS', 'WARNS');
      ")

      echo "  [${m_type}] ${m_ent} (doc: ${m_doc}, score: ${m_score})"
      echo "    TITLE: ${m_title}"
      if [[ -n "$m_snip" ]]; then
        echo "    SNIPPET: ${m_snip}"
      fi
      if [[ -n "$linked_symbols" ]]; then
        echo "    LINKED_SYMBOLS: ${linked_symbols}"
      fi
    done <<< "$docs_matches"
  fi
  echo ""

  # Query fts_symbols (trigram tokenizer)
  local sym_terms=()
  for term in $query; do
    local clean_term
    clean_term=$(echo "$term" | tr -cd '[:alnum:]_')
    if [[ ${#clean_term} -ge 3 ]]; then
      sym_terms+=("\"${clean_term}\"")
    fi
  done

  local sym_matches=""
  if [[ ${#sym_terms[@]} -gt 0 ]]; then
    local sym_query_and
    sym_query_and=$(IFS=" AND "; echo "${sym_terms[*]}")
    sym_matches=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
      SELECT
        s.id,
        s.name,
        s.qname,
        s.kind,
        s.file,
        s.line_start,
        coalesce(s.signature, '')
      FROM fts_symbols fts
      JOIN symbols s ON fts.symbol_id = s.id
      WHERE fts_symbols MATCH '${sym_query_and}'
      ORDER BY rank
      LIMIT 10;
    " 2>/dev/null || true)

    # If AND had no results and multiple terms, try OR
    if [[ -z "$sym_matches" && ${#sym_terms[@]} -gt 1 ]]; then
      local sym_query_or
      sym_query_or=$(IFS=" OR "; echo "${sym_terms[*]}")
      sym_matches=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
        SELECT
          s.id,
          s.name,
          s.qname,
          s.kind,
          s.file,
          s.line_start,
          coalesce(s.signature, '')
        FROM fts_symbols fts
        JOIN symbols s ON fts.symbol_id = s.id
        WHERE fts_symbols MATCH '${sym_query_or}'
        ORDER BY rank
        LIMIT 10;
      " 2>/dev/null || true)
    fi
  fi

  echo "@symbol_matches"
  if [[ -z "$sym_matches" ]]; then
    echo "  none"
  else
    local y_id y_name y_qname y_kind y_file y_line y_sig
    while IFS="$SEP" read -r y_id y_name y_qname y_kind y_file y_line y_sig; do
      local y_id_esc y_qname_esc
      y_id_esc=$(sql_escape "$y_id")
      y_qname_esc=$(sql_escape "$y_qname")

      # Find governing rules or warnings
      local gov_rules
      gov_rules=$(sqlite_exec "$DB_PATH" "
        SELECT group_concat(e.source, ', ')
        FROM edges e
        WHERE e.target IN ('${y_id_esc}', '${y_qname_esc}') AND e.kind IN ('GOVERNS', 'WARNS');
      ")

      echo "  ${y_qname} (${y_kind}, ${y_file}:${y_line})"
      if [[ -n "$y_sig" ]]; then
        echo "    SIGNATURE: ${y_sig}"
      fi
      if [[ -n "$gov_rules" ]]; then
        echo "    GOVERNED_BY: ${gov_rules}"
      fi
    done <<< "$sym_matches"
  fi
}

# 7. stats
cmd_stats() {
  local num_symbols num_edges num_docs num_rules num_pitfalls
  num_symbols=$(sqlite_exec "$DB_PATH" "SELECT count(*) FROM symbols;")
  num_edges=$(sqlite_exec "$DB_PATH" "SELECT count(*) FROM edges;")
  num_docs=$(sqlite_exec "$DB_PATH" "SELECT count(*) FROM docs;")
  num_rules=$(sqlite_exec "$DB_PATH" "SELECT count(*) FROM rules;")
  num_pitfalls=$(sqlite_exec "$DB_PATH" "SELECT count(*) FROM pitfalls;")

  echo "@graph_stats"
  echo "  DATABASE: $DB_PATH"
  echo "  SYMBOLS: $num_symbols"
  echo "  EDGES: $num_edges"

  local edge_breakdown
  edge_breakdown=$(sqlite_exec -separator "$SEP" "$DB_PATH" "
    SELECT kind, count(*) FROM edges GROUP BY kind ORDER BY kind ASC;
  ")
  if [[ -n "$edge_breakdown" ]]; then
    local e_kind e_count
    while IFS="$SEP" read -r e_kind e_count; do
      echo "    ${e_kind}: ${e_count}"
    done <<< "$edge_breakdown"
  fi

  echo "  DOCS: $num_docs"
  echo "  RULES: $num_rules"
  echo "  PITFALLS: $num_pitfalls"
}

# Check database freshness and perform JIT micro-sync if necessary
check_and_sync_freshness

# --- DISPATCH SUBCOMMAND ---

case "$COMMAND" in
  symbol)
    cmd_symbol "$TARGET" "$DEPTH"
    ;;
  search)
    cmd_search "$TARGET"
    ;;
  callers)
    cmd_callers "$TARGET" "$DEPTH"
    ;;
  callees)
    cmd_callees "$TARGET" "$DEPTH"
    ;;
  rules)
    cmd_rules "$TARGET"
    ;;
  pitfalls)
    cmd_pitfalls "$TARGET"
    ;;
  stats)
    cmd_stats
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    print_help
    exit 1
    ;;
esac
