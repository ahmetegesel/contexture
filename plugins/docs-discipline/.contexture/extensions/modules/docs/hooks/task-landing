#!/bin/sh
# ctx-hook: task-landing
# the unit module's task-landing point: nudge the task that just started, through the
# module's installed name (its folder's), so an install under an alias nudges too
[ "${CTX_ACT:-}" = start ] || exit 0
[ -n "${CTX_UNIT:-}" ] && [ -n "${CTX_SLUGS:-}" ] || exit 0
[ -x "${CTX_BIN:-}" ] || exit 0
m=${0%/*}
m=${m%/*}
m=${m##*/}
exec "$CTX_BIN" "$m" nudge "$CTX_UNIT" --task="$CTX_SLUGS"
