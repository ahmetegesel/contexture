#!/bin/sh
# summary: the close gate: the corpus audit plus the coverage and freshness check as one pass
# usage: ctx docs gate
# usage: ctx docs gate --since=<rev>
# usage: ctx docs gate --drift
# usage: ctx docs gate --stdin
# usage: ctx docs gate --test-matrix
# help: runs the corpus audit, then feeds the aggregated status-prefixed delta to the check; it fails when either does; the default run also warns on stderr when a scanned repository is on a non-main branch or behind its last-fetched origin
# help: the default delta is the working tree's (git diff, git diff --cached, the untracked files), so a clean tree hands the check nothing and a notice on stderr says so; --since=<rev> proves a committed range instead: the workspace root's repository from <rev> to the working tree (git diff <rev> plus the untracked files), the child repositories keeping their working delta (a notice names them); under the files driver git carries the corpus half only where the workspace tracks the corpus: the untracked files leave the corpus docs out, so an untracked doc never rides, ignored or not, and an untracked corpus under --since gets a notice naming the process-owned limit; --since joins the default form alone, and an unknown revision or a root outside a repository refuses rc 1
# help: git runs with core.quotePath=false, so a non-ASCII path arrives as its bytes; a path git still quotes is decoded (a quote, a backslash), and one holding a control character (a tab, a newline) cannot ride a status line, so it is left out and named in a notice; --stdin decodes the caller's delta the same way
# help: under a store driver with a change log (store.changelog) the delta has two halves: the code from git (the workspace root's docs/<repo>/<slug>.md paths dropped, since those files are not the corpus) and the corpus from the store (ctx docs changes: the docs written since the current HEAD, so a commit empties both halves together, or since <rev> under --since); the check runs in its store mode; --stdin takes the caller's delta as given, and --drift prints a deferral notice and checks the incoming code delta alone
# help: the notices and warnings go to stderr with a bracketed prefix; stdout and the exit code stay the check's
# help: exit codes: 0 the audit and the check are clean; 1 a violation or a bad argument; 2 unreadable input (an awk engine's own failure)
# help: example: ctx docs gate --test-matrix (ends: TEST MATRIX VERDICT: ALL 8 SCENARIOS PASSED)
#
# Layout: lives at <workspace>/.contexture/extensions/modules/docs/scripts/gate. The
# workspace root resolves from CTX_ROOT (the engine's dispatch environment) or
# the DOCS_WORKSPACE_ROOT override; run standalone it walks up from the script
# to the .contexture drawer's parent. Product repositories live under
# DOCS_PRODUCT_REPOS_DIR (default: projects/); when it is absent the workspace
# root's child repositories are scanned directly, and the workspace root itself
# when it is a repository. The check maps the projects/<repo>/ prefix and the
# flat <repo>/ form alike.
#
# Pure POSIX sh with zero Python dependencies.

set -e

case "$1" in
  help|--help|-h)
    if [ "$#" -ne 1 ]; then
      echo "ctx docs gate: help takes no further arguments" >&2
      exit 1
    fi
    echo "help: ctx docs help gate" >&2
    exit 1
    ;;
esac

case "$0" in
    */*) dir="$(cd "${0%/*}" && pwd)" ;;
    *) dir="$(pwd)" ;;
esac
AWK_AUDIT="$dir/docs-audit.awk"
AWK_GLOB="$dir/docs-glob.awk"
AWK_CHECK="$dir/docs-check.awk"
# the workspace root and the corpus (through the configured storage driver) come from the
# module's IO helper
. "$dir/docs-io.sh"
docs_io_init "$dir" gate
WORKSPACE_ROOT="$DOCS_ROOT"
PRODUCT_REPOS_DIR="${DOCS_PRODUCT_REPOS_DIR:-projects}"

# --since=<rev>: the default form's committed range; DOCS_SINCE_REV names its base commit
GATE_SINCE=""
for gate_a
do
    case "$gate_a" in
        --since=*)
            if [ "$#" -ne 1 ]; then
                echo "ctx docs gate: --since=<rev> takes no other argument (not --stdin, --drift, or --test-matrix)" >&2
                exit 1
            fi
            GATE_SINCE=${gate_a#--since=}
            if [ -z "$GATE_SINCE" ]; then
                echo "ctx docs gate: --since needs a revision (--since=<rev>)" >&2
                exit 1
            fi
            docs_since_rev "$GATE_SINCE" || exit 1
            set --
            ;;
    esac
done

# Function to aggregate git changes across workspace and product repos; under --since the
# workspace root's half runs from DOCS_SINCE_REV to the working tree and a notice names the
# child repositories, which keep their working delta. Every git call runs with
# core.quotePath=false, so a non-ASCII path arrives as its bytes; a path git still quotes
# (a quote, a backslash, a control character) is decoded or named by docs_delta_decode
aggregate_git_changes() {
    # 1. Parent workspace root changes; its untracked files carry no corpus doc
    (
        cd "$WORKSPACE_ROOT"
        if [ -n "$DOCS_SINCE_REV" ]; then
            git -c core.quotePath=false diff --name-status "$DOCS_SINCE_REV" 2>/dev/null || true
        else
            git -c core.quotePath=false diff --name-status 2>/dev/null || true
            git -c core.quotePath=false diff --name-status --cached 2>/dev/null || true
        fi
        git -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null | docs_untracked_half
    ) | docs_delta_decode

    # 2. Product repositories changes ($PRODUCT_REPOS_DIR/* or workspace root child repos)
    if [ -d "$WORKSPACE_ROOT/$PRODUCT_REPOS_DIR" ] && [ "$PRODUCT_REPOS_DIR" != "." ]; then
        scan_dirs="$WORKSPACE_ROOT/$PRODUCT_REPOS_DIR"/*
        prefix_base="$PRODUCT_REPOS_DIR"
    else
        scan_dirs="$WORKSPACE_ROOT"/*
        prefix_base=""
    fi

    children=""
    for pdir in $scan_dirs; do
        if [ -d "$pdir/.git" ] && [ "$pdir" != "$WORKSPACE_ROOT" ]; then
            repo_name="${pdir##*/}"
            pfx="${prefix_base:+$prefix_base/}$repo_name"
            children="${children:+$children, }$pfx"
            (
                cd "$pdir"
                {
                    git -c core.quotePath=false diff --name-status 2>/dev/null || true
                    git -c core.quotePath=false diff --name-status --cached 2>/dev/null || true
                    git -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null | while IFS= read -r f; do
                        [ -n "$f" ] && printf "A\t%s\n" "$f"
                    done
                } | docs_delta_decode "$pfx/" | while IFS= read -r line; do
                    [ -z "$line" ] && continue
                    case "$line" in
                        R[0-9]*[[:space:]]*)
                            stat="${line%%[[:space:]]*}"
                            rest="${line#*[[:space:]]}"
                            rest="${rest#"${rest%%[! ]*}"}"
                            old_f="${rest%%[[:space:]]*}"
                            new_f="${rest#*[[:space:]]}"
                            new_f="${new_f#"${new_f%%[! ]*}"}"
                            printf "%s\t%s/%s\t%s/%s\n" "$stat" "$pfx" "$old_f" "$pfx" "$new_f"
                            ;;
                        [A-Z\?]*[[:space:]]*)
                            stat="${line%%[[:space:]]*}"
                            f="${line#*[[:space:]]}"
                            f="${f#"${f%%[! ]*}"}"
                            printf "%s\t%s/%s\n" "$stat" "$pfx" "$f"
                            ;;
                        *)
                            printf "M\t%s/%s\n" "$pfx" "$line"
                            ;;
                    esac
                done
            )
        fi
    done
    if [ -n "$DOCS_SINCE_REV" ] && [ -n "$children" ]; then
        printf "[GATE NOTICE] --since=%s reaches the workspace root's repository only; the child repositories (%s) keep their working delta\n" "$GATE_SINCE" "$children" >&2
    fi
}

# The notices that name the delta's limits, on stderr after the staged delta: an empty
# delta proves nothing (a clean tree, or an empty range), under the files driver a --since
# range over a corpus git does not track (ignored or not) carries no corpus line, and a path
# the decode left out is named
gate_notices() {
    if docs_delta_empty; then
        if [ -n "$GATE_SINCE" ]; then
            printf "[GATE NOTICE] the delta since %s is empty: the check has nothing to prove\n" "$GATE_SINCE" >&2
        else
            printf "[GATE NOTICE] the delta is empty (a clean tree): the check proves nothing about coverage or freshness; prove a committed range with ctx docs gate --since=<rev>\n" >&2
        fi
    fi
    if [ -n "$GATE_SINCE" ] && [ "$DOCS_DELTA" != log ]; then
        docs_corpus_untracked
        if [ "$DOCS_UNTRACKED" -gt 0 ]; then
            printf "[GATE NOTICE] the corpus is untracked here (%s of %s docs not tracked by git): no corpus line rides the delta, so a changed file whose claimants are all untracked reads UNTRACKED CLAIMANT, its freshness process-owned through the docs-drift flow\n" "$DOCS_UNTRACKED" "$DOCS_NDOCS" >&2
        fi
    fi
    docs_delta_unread "[GATE NOTICE]"
    return 0
}

# Function to aggregate remote drift changes (HEAD...origin/main, the
# merge-base incoming delta) across product repos
aggregate_remote_drift_changes() {
    if [ -d "$WORKSPACE_ROOT/$PRODUCT_REPOS_DIR" ] && [ "$PRODUCT_REPOS_DIR" != "." ]; then
        scan_dirs="$WORKSPACE_ROOT/$PRODUCT_REPOS_DIR"/*
        prefix_base="$PRODUCT_REPOS_DIR"
    else
        scan_dirs="$WORKSPACE_ROOT"/*
        prefix_base=""
        # The flat topologies (single repository, standalone, monorepo) carry
        # the product repository at the workspace root itself: scan it too.
        if [ -e "$WORKSPACE_ROOT/.git" ]; then
            scan_dirs="$WORKSPACE_ROOT $scan_dirs"
        fi
    fi

    for pdir in $scan_dirs; do
        if [ "$pdir" = "$WORKSPACE_ROOT" ]; then
            repo_name="${pdir##*/}"
            pfx=""
        elif [ -d "$pdir/.git" ]; then
            repo_name="${pdir##*/}"
            pfx="${prefix_base:+$prefix_base/}$repo_name"
        else
            continue
        fi
        (
            cd "$pdir"
            remote_ref="origin/main"
            if ! git rev-parse --verify "$remote_ref" >/dev/null 2>&1; then
                remote_ref="origin/master"
            fi
            if git rev-parse --verify "$remote_ref" >/dev/null 2>&1; then
                git -c core.quotePath=false diff --name-status "HEAD...$remote_ref" 2>/dev/null || true
            fi
        ) | docs_delta_decode "${pfx:+$pfx/}" | while IFS= read -r line; do
            [ -z "$line" ] && continue
            case "$line" in
                R[0-9]*[[:space:]]*)
                    stat="${line%%[[:space:]]*}"
                    rest="${line#*[[:space:]]}"
                    rest="${rest#"${rest%%[! ]*}"}"
                    old_f="${rest%%[[:space:]]*}"
                    new_f="${rest#*[[:space:]]}"
                    new_f="${new_f#"${new_f%%[! ]*}"}"
                    printf "%s\t%s\t%s\n" "$stat" "${pfx:+$pfx/}$old_f" "${pfx:+$pfx/}$new_f"
                    ;;
                [A-Z\?]*[[:space:]]*)
                    stat="${line%%[[:space:]]*}"
                    f="${line#*[[:space:]]}"
                    f="${f#"${f%%[! ]*}"}"
                    printf "%s\t%s\n" "$stat" "${pfx:+$pfx/}$f"
                    ;;
                *)
                    printf "M\t%s\n" "${pfx:+$pfx/}$line"
                    ;;
            esac
        done
    done
}

# Function to check and print branch and remote drift warnings to stderr
check_drift_warnings() {
    if [ -d "$WORKSPACE_ROOT/$PRODUCT_REPOS_DIR" ] && [ "$PRODUCT_REPOS_DIR" != "." ]; then
        scan_dirs="$WORKSPACE_ROOT/$PRODUCT_REPOS_DIR"/*
    else
        scan_dirs="$WORKSPACE_ROOT"/*
        # The flat topologies carry the product repository at the workspace
        # root itself: warn about it too.
        if [ -e "$WORKSPACE_ROOT/.git" ]; then
            scan_dirs="$WORKSPACE_ROOT $scan_dirs"
        fi
    fi

    drift_found=0
    for pdir in $scan_dirs; do
        if [ "$pdir" = "$WORKSPACE_ROOT" ] || [ -d "$pdir/.git" ]; then
            repo_name="${pdir##*/}"
            branch=$(git -C "$pdir" branch --show-current 2>/dev/null || echo "")
            if [ -n "$branch" ] && [ "$branch" != "main" ] && [ "$branch" != "master" ]; then
                printf "[DRIFT WARNING] %s is on branch '%s' (not main)\n" "$repo_name" "$branch" >&2
                drift_found=1
            fi
            remote_ref="origin/main"
            if ! git -C "$pdir" rev-parse --verify "$remote_ref" >/dev/null 2>&1; then
                remote_ref="origin/master"
            fi
            if git -C "$pdir" rev-parse --verify "$remote_ref" >/dev/null 2>&1; then
                behind=$(git -C "$pdir" rev-list --count "HEAD..$remote_ref" 2>/dev/null || echo 0)
                if [ "$behind" -gt 0 ]; then
                    printf "[DRIFT WARNING] %s is %s commit(s) behind %s\n" "$repo_name" "$behind" "$remote_ref" >&2
                    drift_found=1
                fi
            fi
        fi
    done
    if [ "$drift_found" -eq 1 ]; then
        printf "[DRIFT NOTICE] Run 'ctx docs gate --drift' to evaluate remote incoming changes against docs.\n\n" >&2
    fi
}

# The corpus the audit and the check read: the whole corpus read once through the
# configured driver's module store into the module's scratch before any pipeline (so the
# scratch and its cleanup stay with this shell); an empty corpus or a driver without the
# store refuses
prepare_corpus() {
    if docs_corpus; then
        docs_delta_source
        return 0
    else
        pc_rc=$?
    fi
    [ "$DOCS_ERR" = empty ] && echo "ctx docs gate: the corpus is empty" >&2
    exit "$pc_rc"
}

# run_engine_over_corpus <awk programs and options>: the engine over every materialized doc,
# whose paths are the logical addresses docs/<repo>/<slug>.md
run_engine_over_corpus() {
    while IFS= read -r doc_path; do
        set -- "$@" "$doc_path"
    done < "$DOCS_PATHS"
    docs_engine_run awk "$@"
}

# Run syntax/integrity audit across all typed documentation
run_audit() {
    docs_template || exit $?
    run_engine_over_corpus -f "$AWK_AUDIT"
}

# Run coverage, freshness, and dead sources check on the staged delta (docs_delta_stage),
# read by name with the shebang list drawn from its paths; under a store's change log the
# engine runs in its log mode (no blanket, no trackedness probe)
run_gate_check() {
    docs_delta_shebangs
    if [ "$DOCS_DELTA" = log ]; then
        run_engine_over_corpus -f "$AWK_GLOB" -f "$AWK_CHECK" -v "$DOCS_DELTA_ARG" -v delta_source=log
    else
        run_engine_over_corpus -f "$AWK_GLOB" -f "$AWK_CHECK" -v "$DOCS_DELTA_ARG"
    fi
}

# Self-planted test matrix: builds its own fixture corpus under the workspace
# drawer's .contexture/tmp (the system temp only when that drawer cannot hold
# it), plants a local repository inside it for the claimant trackedness probe,
# then exercises the check over the eight scenarios. No external paths, no
# writes outside the fixture directory.
run_test_matrix() {
    FIXTURE_BASE="${DOCS_ROOT:-$PWD}/.contexture/tmp"
    if ! mkdir -p "$FIXTURE_BASE" 2>/dev/null || [ ! -w "$FIXTURE_BASE" ]; then
        FIXTURE_BASE="${TMPDIR:-/tmp}"
    fi
    FIXTURE_DIR="$(mktemp -d "$FIXTURE_BASE/docs-gate-matrix.XXXXXX")" || { echo "ctx docs gate: mktemp -d failed" >&2; return 1; }
    trap 'rm -rf "$FIXTURE_DIR"' EXIT INT TERM
    mkdir -p "$FIXTURE_DIR/docs/demo"

    cat > "$FIXTURE_DIR/docs/demo/widgets.md" <<'FIXTURE'
@doc capability widgets
  repo: demo
  description: "Widget catalog and rendering."
  sources: [src/widgets/*.cs]
FIXTURE

    cat > "$FIXTURE_DIR/docs/demo/platform.md" <<'FIXTURE'
@doc structural platform
  repo: demo
  description: "Shared platform services."
  sources: [src/widgets/Widget.cs]
FIXTURE

    command -v git >/dev/null 2>&1 || {
        echo "ctx docs gate: the matrix needs git for the claimant trackedness probe" >&2
        return 1
    }
    git -C "$FIXTURE_DIR" init -q
    git -C "$FIXTURE_DIR" add docs/demo/widgets.md docs/demo/platform.md

    echo "================================================================="
    echo "  CLOSE GATE TEST MATRIX: 8 SCENARIOS (self-planted fixtures)"
    echo "================================================================="
    ALL_PASSED=1

    run_case() {
        name="$1"
        expected="$2"
        input="$3"
        code=0
        out="$(printf '%s' "$input" | (cd "$FIXTURE_DIR" && awk -f "$AWK_GLOB" -f "$AWK_CHECK" docs/demo/*.md) 2>&1)" || code=$?
        echo ""
        echo "[$name]"
        echo "$out"
        if [ "$code" -eq "$expected" ]; then
            echo "--> RESULT: PASS (exit code $code, matches expected $expected)"
        else
            echo "--> RESULT: FAIL (exit code $code, expected $expected)"
            ALL_PASSED=0
        fi
    }

    run_case "SCENARIO 1: Clean tree / no changes" 0 ""

    run_case "SCENARIO 2: Valid edit (code changed and its doc updated)" 0 "M	projects/demo/src/widgets/Widget.cs
docs/demo/widgets.md"

    run_case "SCENARIO 3: Completeness violation (uncovered code file created)" 1 "A	projects/demo/src/loose/Unknown.cs"

    run_case "SCENARIO 4: Freshness violation (code modified without doc update)" 1 "M	projects/demo/src/widgets/Widget.cs"

    run_case "SCENARIO 5: Multi-claimant doc update (claimed by 2 docs, one updated)" 0 "M	projects/demo/src/widgets/Widget.cs
docs/demo/platform.md"

    run_case "SCENARIO 6: Deleted code file with doc update (cleaned sources)" 0 "D	projects/demo/src/widgets/OldWidget.cs
docs/demo/widgets.md"

    run_case "SCENARIO 7: Deleted code file without doc update" 1 "D	projects/demo/src/widgets/Widget.cs"

    run_case "SCENARIO 8: Newly counted extension (an uncovered Python file)" 1 "A	projects/demo/src/tools/report.py"

    echo ""
    echo "================================================================="
    if [ "$ALL_PASSED" -eq 1 ]; then
        echo "  TEST MATRIX VERDICT: ALL 8 SCENARIOS PASSED"
        echo "================================================================="
        return 0
    else
        echo "  TEST MATRIX VERDICT: SOME SCENARIOS FAILED"
        echo "================================================================="
        return 1
    fi
}

# Main dispatch
if [ "$1" = "--test-matrix" ] || [ "$1" = "--test-all" ]; then
    run_test_matrix
    exit $?
fi

if [ "$1" = "-" ] || [ "$1" = "--stdin" ]; then
    if [ -t 0 ]; then
        echo "ctx docs gate: --stdin specified but standard input is a terminal (no piped input)." >&2
        exit 1
    fi
    prepare_corpus
    run_audit
    docs_delta_decode | docs_delta_stage
    docs_delta_unread "[GATE NOTICE]"
    run_gate_check
elif [ "$1" = "--drift" ]; then
    prepare_corpus
    run_audit
    if [ "$DOCS_DELTA" = log ]; then
        # the store's corpus has no incoming half: the incoming code delta alone
        echo "[DRIFT NOTICE] the corpus store carries no incoming changes; drift over a shared store is deferred" >&2
        aggregate_remote_drift_changes | docs_code_half | sort -u | docs_delta_stage
    else
        aggregate_remote_drift_changes | sort -u | docs_delta_stage
    fi
    docs_delta_unread "[GATE NOTICE]"
    run_gate_check
elif [ -z "$1" ]; then
    prepare_corpus
    run_audit
    check_drift_warnings
    if [ "$DOCS_DELTA" = log ]; then
        # the code half from git without the workspace root's corpus paths, the corpus half
        # from the store's change log (the docs written since the current HEAD, or since
        # <rev> under --since)
        docs_changes_prepare ${GATE_SINCE:+"--since=$GATE_SINCE"} || exit $?
        { aggregate_git_changes | docs_code_half; docs_changes_emit; } | sort -u | docs_delta_stage
    else
        aggregate_git_changes | sort -u | docs_delta_stage
    fi
    gate_notices
    run_gate_check
else
    echo "ctx docs gate: unknown argument: $1" >&2
    echo "Usage: ctx docs gate [--since=<rev> | --drift | --stdin | --test-matrix]" >&2
    echo "help: ctx docs help gate" >&2
    exit 1
fi
