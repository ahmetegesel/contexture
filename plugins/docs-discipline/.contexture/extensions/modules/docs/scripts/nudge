#!/bin/sh
# summary: the task nudge over the active task and the corpus
# usage: ctx docs nudge <unit> [<repo>...]
# usage: ctx docs nudge <backlog-file> <repo>...
# help: reads the active task (the unit's first IN_PROGRESS task in backlog order, through ctx unit task list and ctx unit resolve) and prints the matched docs, the top pitfalls, and (when the task names setup verbs) the owning operational doc's run, build, and test targets with its toolchain note
# help: the corpus comes from the configured storage driver: the whole corpus, or the named repos' docs
# help: the backlog-file form reads a backlog outside the record (the plugin's demo); a path inside another module's store root refuses (the roots the storage core's store_roots lists): a record artifact is read through its unit, never as a file; with no storage core to list the roots it refuses rc 2 and reads no file
# help: exit codes: 0 the nudge printed (matched docs may be none; nothing when the unit has no IN_PROGRESS task); 1 a unit, repo, doc, or backlog path refused; 2 unreadable input (the awk engine's own failure), a storage driver without a corpus, or no storage core to list the module store roots
# help: example: ctx docs nudge storage

case "$1" in
  help|--help|-h)
    if [ "$#" -ne 1 ]; then
      echo "ctx docs nudge: help takes no further arguments" >&2
      exit 1
    fi
    echo "help: ctx docs help nudge" >&2
    exit 1
    ;;
esac

if [ "$#" -eq 0 ]; then
  echo "Usage: ctx docs nudge <unit> [<repo>...] (or: ctx docs nudge <backlog-file> <repo>...)" >&2
  echo "help: ctx docs help nudge" >&2
  exit 1
fi

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$dir/docs-io.sh"
docs_io_init "$dir" nudge
first=$1
shift

if docs_file_form "$first"; then
  # the backlog-file form: a value another module stores is never read as a file (the
  # single store)
  docs_record_file "$first"
  case $? in
    0)
      echo "ctx docs nudge: a path inside another module's store root is read through that module, never as a file; a record artifact through its unit: ctx docs nudge <unit> [<repo>...]" >&2
      exit 1
      ;;
    2)
      echo "ctx docs nudge: the storage core cannot list the module store roots, so the file is not read (need: the storage core) (ERR_DRIVER_NOT_FOUND)" >&2
      exit 2
      ;;
  esac
  docs_args 0 1 "$@" || exit $?
  docs_no_display
  docs_exec "$dir/docs-nudge.awk" "$first"
fi

# the unit form: the active task through ctx unit (the configured store)
docs_args 1 1 "$@" || exit $?
docs_no_display
docs_active_task "$first" || exit $?
[ -n "$DOCS_TASK" ] || exit 0
DOCS_KEEP=1
docs_exec "$dir/docs-nudge.awk" "$DOCS_TASK"
