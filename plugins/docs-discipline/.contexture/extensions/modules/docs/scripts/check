#!/bin/sh
# summary: the coverage, freshness, and dead-sources check over a change delta
# usage: git diff --name-status | ctx docs check <repo>...
# usage: git diff --name-status | ctx docs check docs/<repo>/<slug>.md...
# help: reads a status-prefixed change delta on stdin together with the corpus and reports the touched code files that no doc claims (coverage), the changed code files whose docs did not ride the change (freshness), and the deleted files still listed as doc sources
# help: the governed set: the code extensions (awk among them) and every extensionless file (a non-empty basename with no dot after its first character) whose first line, read under the workspace root, starts with #!, plus a depth-1 docs/*.md a doc claims; the test and generated exclusions apply first; an extensionless file without a shebang stays out, and a path that is not a readable regular file (deleted, absent, a folder) counts only when a header source lists it exactly; a doc rides the delta only at its logical address docs/<repo>/<slug>.md, the start of a delta path
# help: the corpus comes from the configured storage driver's module store: a repo name checks against that repo's docs, a doc path names one doc by its logical address docs/<repo>/<slug>.md and the verb reads the stored doc, never a file at the caller's spelling; the corpus argument is required, so the delta on stdin is never read as a corpus
# help: the glob forms docs/*/*.md and docs/<repo>/*.md are the files-driver form: under a store driver no file matches, and zsh refuses an unmatched glob before the verb runs, so name repos there
# help: under a store driver with a change log (store.changelog) a claimed file reads fresh only when a doc whose own sources claim it rode the delta (no workspace or architecture blanket), and every claimant can ride the delta (no UNTRACKED CLAIMANT); compose the delta as { git diff --name-status; ctx docs changes; }
# help: exit codes: 0 the delta is covered and fresh; 1 a completeness, freshness, or dead-sources violation, or an argument naming no doc or repo; 2 unreadable input (the awk engine's own failure) or a storage driver without the store
# help: example: printf 'M\tprojects/demo/src/x.ts\ndocs/demo/x.md\n' | ctx docs check demo workspace

case "$1" in
  help|--help|-h)
    if [ "$#" -ne 1 ]; then
      echo "ctx docs check: help takes no further arguments" >&2
      exit 1
    fi
    echo "help: ctx docs help check" >&2
    exit 1
    ;;
esac

if [ "$#" -eq 0 ]; then
  echo "Usage: git diff --name-status | ctx docs check <repo>..." >&2
  echo "help: ctx docs help check" >&2
  exit 1
fi

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$dir/docs-io.sh"
docs_io_init "$dir" check
docs_args 0 0 "$@" || exit $?
# a store driver's change log feeds the corpus half: the engine's log mode (no blanket, no
# trackedness probe); the files driver keeps today's git mode. The delta is staged and read
# by name, so the shebang list can be drawn from its paths first
docs_delta_source
docs_delta_stage || exit $?
docs_delta_shebangs
if [ "$DOCS_DELTA" = log ]; then
  docs_exec awk -f "$dir/docs-glob.awk" -f "$dir/docs-check.awk" -v "$DOCS_DELTA_ARG" -v delta_source=log
fi
docs_exec awk -f "$dir/docs-glob.awk" -f "$dir/docs-check.awk" -v "$DOCS_DELTA_ARG"
