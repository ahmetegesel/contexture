#!/bin/sh
# summary: counted exact text replacement across a doc, a repo, or the whole corpus (sync sweeps)
# usage: ctx docs replace [<repo> [<slug>]] --old="text" --new="text" --count=<N> [--dry-run]
# help: every occurrence of --old in the scope becomes --new (both may carry newlines); the total over the scope must equal --count, else each doc's count is printed and nothing is written: the check that the sweep's scope is what the author believed
# help: every touched doc is edited and grammar-checked by the audit over its repo before the first write; the writes then land one doc after another (a failure names the docs that landed), one change-log row per touched doc under a store driver
# help: exit codes: 0 replaced (or the dry run printed); 1 a refusal (a stale count, an empty --old, a missing scope, a grammar defect), nothing written; 2 a storage driver failure or a driver without a corpus
# help: example: ctx docs replace workspace --old="ctx docs gate --drift" --new="ctx docs gate --drift --stdin" --count=3

case "$1" in
  help|--help|-h)
    if [ "$#" -ne 1 ]; then
      echo "ctx docs replace: help takes no further arguments" >&2
      exit 1
    fi
    echo "help: ctx docs help replace" >&2
    exit 1
    ;;
esac

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$dir/docs-io.sh"
docs_io_init "$dir" replace
DOCS_FLAGS="--old= --new= --count= --dry-run"
docs_parse "old new count dry-run" 0 "$@" || exit $?
if [ "$DOCS_NP" -gt 2 ] || [ "$DOCS_HAS_OLD" -ne 1 ] || [ "$DOCS_HAS_NEW" -ne 1 ] || [ -z "$DOCS_COUNT" ]; then
  echo "Usage: ctx docs replace [<repo> [<slug>]] --old=\"text\" --new=\"text\" --count=<N> [--dry-run]" >&2
  exit 1
fi
case "$DOCS_COUNT" in
  *[!0-9]*) echo "ctx docs replace: --count takes a whole number (got $DOCS_COUNT) (ERR_INVALID_ARGUMENT)" >&2; exit 1 ;;
esac
if [ -z "$DOCS_OLD" ]; then
  echo "ctx docs replace: --old is empty (ERR_INVALID_ARGUMENT)" >&2
  exit 1
fi
if [ "$DOCS_OLD" = "$DOCS_NEW" ]; then
  echo "ctx docs replace: --old and --new are the same text (ERR_INVALID_ARGUMENT)" >&2
  exit 1
fi
docs_multi replace ${DOCS_P1:+"$DOCS_P1"} ${DOCS_P2:+"$DOCS_P2"}
