#!/bin/sh
# docs-check: CLI wrapper for .contexture/scripts/docs-check.awk
# Usage: git diff --name-status | .contexture/scripts/docs-check docs/<repo>/*.md
# Help: .contexture/scripts/docs-check help (also --help and -h)
# Every other invocation is delegated to the engine byte-faithfully.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AWK_SCRIPT="$SCRIPT_DIR/docs-check.awk"

show_help() {
  cat <<'EOF'
docs-check: the coverage, freshness, and dead-sources check over a delta

usage:
  git diff --name-status | .contexture/scripts/docs-check docs/<repo>/*.md

what it does: reads a status-prefixed change delta on stdin together with
the corpus files and reports the touched code files that no doc claims
(coverage), the changed code files whose docs did not ride the change
(freshness), and the deleted files still listed as doc sources.

exit codes:
  0  the delta is covered and fresh
  1  a completeness, freshness, or dead-sources violation
  2  unreadable input (the awk engine's own failure)

example:
  printf 'M\tprojects/demo/src/x.ts\ndocs/demo/x.md\n' | .contexture/scripts/docs-check docs/*/*.md
EOF
}

case "$1" in
  help|--help|-h)
    if [ "$#" -ne 1 ]; then
      echo "docs-check: help takes no further arguments" >&2
      echo "help: .contexture/scripts/docs-check help" >&2
      exit 1
    fi
    show_help
    exit 0
    ;;
esac

if [ "$#" -eq 0 ]; then
  echo "Usage: git diff --name-status | .contexture/scripts/docs-check docs/<repo>/*.md" >&2
  echo "help: .contexture/scripts/docs-check help" >&2
  exit 1
fi

exec "$AWK_SCRIPT" "$@"
