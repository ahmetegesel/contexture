#!/bin/sh
# docs-nudge: CLI wrapper for .contexture/scripts/docs-nudge.awk
# Usage: .contexture/scripts/docs-nudge backlog.md docs/<repo>/*.md
# Help: .contexture/scripts/docs-nudge help (also --help and -h)
# Every other invocation is delegated to the engine byte-faithfully.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AWK_SCRIPT="$SCRIPT_DIR/docs-nudge.awk"

show_help() {
  cat <<'EOF'
docs-nudge: the task nudge over the active backlog and the corpus

usage:
  .contexture/scripts/docs-nudge backlog.md docs/<repo>/*.md

what it does: reads the active task from the backlog and prints the
matched docs, the top pitfalls, and (when the task names setup verbs) the
owning operational doc's run, build, and test targets with its toolchain
note.

exit codes:
  0  the nudge printed (matched docs may be none)
  2  unreadable input (the awk engine's own failure)

example:
  .contexture/scripts/docs-nudge backlog.md docs/*/*.md
EOF
}

case "$1" in
  help|--help|-h)
    if [ "$#" -ne 1 ]; then
      echo "docs-nudge: help takes no further arguments" >&2
      echo "help: .contexture/scripts/docs-nudge help" >&2
      exit 1
    fi
    show_help
    exit 0
    ;;
esac

if [ "$#" -eq 0 ]; then
  echo "Usage: .contexture/scripts/docs-nudge backlog.md docs/<repo>/*.md" >&2
  echo "help: .contexture/scripts/docs-nudge help" >&2
  exit 1
fi

exec "$AWK_SCRIPT" "$@"
