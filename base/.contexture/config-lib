#!/bin/sh
# config-lib: unified workspace configuration reader, locked atomic writer,
# schema parser and validator, schema discovery, and owner config-verb helpers.
# Sourceable POSIX /bin/sh + LC_ALL=C awk library (no summary line, so engine
# discovery ignores it). Never overwrites caller shell traps.

# ---------------------------------------------------------------------------
# Context and string helpers

# cfg_ctx_dir [<ctx_dir>]: print the resolved .contexture directory path.
cfg_ctx_dir() {
  if [ -n "${1:-}" ]; then
    printf '%s\n' "$1"
    return 0
  fi
  if [ -n "${CTX_DIR:-}" ]; then
    printf '%s\n' "$CTX_DIR"
    return 0
  fi
  if [ -n "${CTX_ROOT:-}" ]; then
    printf '%s/.contexture\n' "$CTX_ROOT"
    return 0
  fi
  ccd_cur=$PWD
  while [ -n "$ccd_cur" ] && [ "$ccd_cur" != "/" ]; do
    if [ -d "$ccd_cur/.contexture" ]; then
      printf '%s/.contexture\n' "$ccd_cur"
      return 0
    fi
    ccd_cur=$(dirname "$ccd_cur")
  done
  printf '%s/.contexture\n' "$PWD"
}

# cfg_root_dir [<ctx_dir>]: print the workspace root corresponding to <ctx_dir>.
cfg_root_dir() {
  crd_ctx=$(cfg_ctx_dir "${1:-}")
  case "$crd_ctx" in
    /.contexture) printf '/\n' ;;
    */.contexture) printf '%s\n' "${crd_ctx%/.contexture}" ;;
    *)
      (CDPATH= cd -- "$crd_ctx/.." 2>/dev/null && pwd) || printf '%s\n' "${CTX_ROOT:-$PWD}"
      ;;
  esac
}

# CFG_UTF8_AWK: RFC 3629 UTF-8 byte validator (same logic as storage/scripts/library).
CFG_UTF8_AWK='
function utf8_ok(s,   n, i, j, c, need, lo, hi) {
  if (s ~ /^[\001-\177]*$/) return 1
  if (!U8_T) { for (i = 1; i < 256; i++) U8_ORD[sprintf("%c", i)] = i; U8_T = 1 }
  n = length(s); i = 1
  while (i <= n) {
    c = U8_ORD[substr(s, i, 1)]
    if (c < 128) { i++; continue }
    if (c >= 194 && c <= 223) { need = 1; lo = 128; hi = 191 }
    else if (c == 224) { need = 2; lo = 160; hi = 191 }
    else if (c >= 225 && c <= 236) { need = 2; lo = 128; hi = 191 }
    else if (c == 237) { need = 2; lo = 128; hi = 159 }
    else if (c == 238 || c == 239) { need = 2; lo = 128; hi = 191 }
    else if (c == 240) { need = 3; lo = 144; hi = 191 }
    else if (c >= 241 && c <= 243) { need = 3; lo = 128; hi = 191 }
    else if (c == 244) { need = 3; lo = 128; hi = 143 }
    else return 0
    if (i + need > n) return 0
    c = U8_ORD[substr(s, i + 1, 1)]
    if (c < lo || c > hi) return 0
    for (j = 2; j <= need; j++) { c = U8_ORD[substr(s, i + j, 1)]; if (c < 128 || c > 191) return 0 }
    i += need + 1
  }
  return 1
}
'

# CFG_JQ_AWK: portable JSON string quoting (no sub/gsub backslash escapes).
CFG_JQ_AWK='
function cfg_jq(s,   i, n, c, o) {
  if (!CFG_JQ_INIT) {
    for (i = 1; i < 32; i++) CFG_ORD[sprintf("%c", i)] = i
    CFG_ORD[sprintf("%c", 127)] = 127
    CFG_JQ_INIT = 1
  }
  o = ""
  n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\") o = o "\\" "\\"
    else if (c == "\"") o = o "\\" "\""
    else if (c == "\n") o = o "\\" "n"
    else if (c == "\t") o = o "\\" "t"
    else if (c == "\r") o = o "\\" "r"
    else if (c in CFG_ORD) o = o sprintf("\\u%04x", CFG_ORD[c])
    else o = o c
  }
  return "\"" o "\""
}
'

# CFG_ESC_AWK: escape/unescape for internal tab-separated transport.
CFG_ESC_AWK='
function cfg_esc(s,   i, n, c, o) {
  o = ""
  n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\") o = o "\\" "\\"
    else if (c == "\n") o = o "\\" "n"
    else if (c == "\t") o = o "\\" "t"
    else if (c == "\r") o = o "\\" "r"
    else o = o c
  }
  return o
}
function cfg_unesc(s,   i, n, c, d, o) {
  o = ""
  n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\" && i < n) {
      d = substr(s, i + 1, 1)
      if (d == "\\") { o = o "\\"; i++; continue }
      if (d == "n") { o = o "\n"; i++; continue }
      if (d == "t") { o = o "\t"; i++; continue }
      if (d == "r") { o = o "\r"; i++; continue }
    }
    o = o c
  }
  return o
}
'

# cfg_utf8_ok <string>: rc 0 valid UTF-8, 1 invalid, 2 error.
cfg_utf8_ok() {
  CFG_V=$1 LC_ALL=C awk "$CFG_UTF8_AWK"'BEGIN { if (utf8_ok(ENVIRON["CFG_V"])) exit 0; exit 3 }' < /dev/null
  case $? in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# cfg_has_nul_file <file>: rc 0 if <file> contains a NUL byte, rc 1 if clean, rc 2 unreadable.
cfg_has_nul_file() {
  [ -f "$1" ] && [ -r "$1" ] || return 2
  chn_raw=$(wc -c < "$1" 2>/dev/null | tr -d ' \t\r\n') || return 2
  chn_clean=$(LC_ALL=C tr -d '\0' < "$1" 2>/dev/null | wc -c | tr -d ' \t\r\n') || return 2
  [ "$chn_raw" != "$chn_clean" ]
}

# cfg_utf8_file_ok <file>: rc 0 if <file> has no NUL bytes and valid UTF-8 lines, 1 invalid, 2 unreadable.
cfg_utf8_file_ok() {
  [ -f "$1" ] && [ -r "$1" ] || return 2
  if cfg_has_nul_file "$1"; then
    return 1
  fi
  LC_ALL=C awk "$CFG_UTF8_AWK"'{ if (!utf8_ok($0)) exit 3 }' "$1"
  case $? in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# cfg_json_quote <string>: emit JSON double-quoted string.
cfg_json_quote() {
  CFG_JQ_S=${1:-} LC_ALL=C awk "$CFG_JQ_AWK"'BEGIN { printf "%s", cfg_jq(ENVIRON["CFG_JQ_S"]) }' < /dev/null
}

# cfg_validate_str <label> <what> <value>: check no CR/LF and valid UTF-8.
cfg_validate_str() {
  cvs_lbl=$1
  cvs_what=$2
  cvs_val=$3
  cvs_cr=$(printf '\r')
  case "$cvs_val" in
    *"$cvs_cr"*)
      printf '%s: error: %s holds a carriage return (ERR_INVALID_ARGUMENT)\n' "$cvs_lbl" "$cvs_what" >&2
      return 1
      ;;
    *"
"*)
      printf '%s: error: %s holds a newline (ERR_INVALID_ARGUMENT)\n' "$cvs_lbl" "$cvs_what" >&2
      return 1
      ;;
  esac
  if ! cfg_utf8_ok "$cvs_val"; then
    printf '%s: error: %s is not valid UTF-8 (ERR_INVALID_ARGUMENT)\n' "$cvs_lbl" "$cvs_what" >&2
    return 1
  fi
  return 0
}

# cfg_write_key_ok <label> <key>: check key is safe for config write/unset.
cfg_write_key_ok() {
  cwk_lbl=$1
  cwk_key=$2
  if [ -z "$cwk_key" ]; then
    printf '%s: error: configuration key cannot be empty (ERR_INVALID_ARGUMENT)\n' "$cwk_lbl" >&2
    return 1
  fi
  cfg_validate_str "$cwk_lbl" "key '$cwk_key'" "$cwk_key" || return 1
  case "$cwk_key" in
    *[[:space:]]*|*:*|*=*|*#*)
      printf "%s: error: malformed configuration key '%s' (ERR_INVALID_ARGUMENT)\n" "$cwk_lbl" "$cwk_key" >&2
      return 1
      ;;
  esac
  return 0
}

# cfg_local_key_ok <key>: rc 0 if <key> matches ^[a-z][a-z0-9_-]*$.
cfg_local_key_ok() {
  case "${1:-}" in
    [abcdefghijklmnopqrstuvwxyz]*)
      case "$1" in
        *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) return 1 ;;
      esac
      return 0
      ;;
    *) return 1 ;;
  esac
}

# cfg_module_name_ok <name>: rc 0 if <name> matches ^[a-z0-9][a-z0-9._-]*$.
cfg_module_name_ok() {
  case "${1:-}" in
    [abcdefghijklmnopqrstuvwxyz0123456789]*)
      case "$1" in
        *[!abcdefghijklmnopqrstuvwxyz0123456789._-]*) return 1 ;;
      esac
      return 0
      ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# 1. Unified config reader

# CFG_PARSE_VAL_AWK: shared config line/value parser.
# First non-empty wins; supports ':' or '=', exact key match, trimmed horizontal
# whitespace, single/double quote unquoting, unquoted inline # comment stripping,
# and CRLF lines.
CFG_PARSE_VAL_AWK='
function cfg_parse_val(rv,   q, i, n, c, d, out, closed, rest) {
  CFG_PV_OK = 1
  sub(/^[ \t]+/, "", rv)
  if (rv == "") return ""
  q = substr(rv, 1, 1)
  if (q == "\"" || q == "'"'"'") {
    out = ""
    closed = 0
    n = length(rv)
    for (i = 2; i <= n; i++) {
      c = substr(rv, i, 1)
      if (q == "\"" && c == "\\" && i < n) {
        d = substr(rv, i + 1, 1)
        if (d == "\"" || d == "\\") { out = out d; i++; continue }
      }
      if (c == q) {
        closed = 1
        rest = substr(rv, i + 1)
        break
      }
      out = out c
    }
    if (!closed) { CFG_PV_OK = 0; return "" }
    sub(/^[ \t]+/, "", rest)
    if (rest != "" && substr(rest, 1, 1) != "#") { CFG_PV_OK = 0; return "" }
    return out
  }
  i = index(rv, "#")
  if (i > 0) rv = substr(rv, 1, i - 1)
  sub(/[ \t]+$/, "", rv)
  return rv
}
'

# cfg_get_file <file> <key>: read exact <key> from <file>.
# rc 0 prints value; rc 1 absent/empty (silent); rc 2 unreadable, NUL, or bad quote.
cfg_get_file() {
  cgf_file=$1
  cgf_key=$2
  [ -f "$cgf_file" ] || return 1
  if [ ! -r "$cgf_file" ]; then
    printf 'config: error: cannot read the workspace configuration (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  if cfg_has_nul_file "$cgf_file"; then
    printf 'config: error: the workspace configuration contains a NUL byte (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  if ! cfg_utf8_file_ok "$cgf_file"; then
    printf 'config: error: the workspace configuration is not valid UTF-8 (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  CFG_TARGET=$cgf_key LC_ALL=C awk "$CFG_PARSE_VAL_AWK"'
    BEGIN { target = ENVIRON["CFG_TARGET"]; found = 0; bad = 0 }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
      if (!match(line, /[:=]/)) next
      k = substr(line, 1, RSTART - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k)
      if (k != target) next
      rv = substr(line, RSTART + 1)
      v = cfg_parse_val(rv)
      if (!CFG_PV_OK) {
        printf "config: error: malformed quoted value for key '\''%s'\'' at line %d (ERR_INVALID_ARGUMENT)\n", k, NR > "/dev/stderr"
        bad = 1
        exit 4
      }
      if (v != "") {
        print v
        found = 1
        exit 0
      }
    }
    END {
      if (bad) exit 4
      if (!found) exit 3
    }' "$cgf_file"
  cgf_rc=$?
  case "$cgf_rc" in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# cfg_get <key> [<ctx_dir>]: read <key> from <ctx_dir>/config.
cfg_get() {
  cg_ctx=$(cfg_ctx_dir "${2:-}")
  cfg_get_file "$cg_ctx/config" "$1"
}

# cfg_list_file <file>: emit "<key>\t<value>" lines for every non-empty key
# (first non-empty wins per key, in file order). Warns on malformed lines.
cfg_list_file() {
  clf_file=$1
  [ -f "$clf_file" ] || return 0
  if [ ! -r "$clf_file" ]; then
    printf 'config: error: cannot read the workspace configuration (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  if cfg_has_nul_file "$clf_file"; then
    printf 'config: error: the workspace configuration contains a NUL byte (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  if ! cfg_utf8_file_ok "$clf_file"; then
    printf 'config: error: the workspace configuration is not valid UTF-8 (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  LC_ALL=C awk "$CFG_PARSE_VAL_AWK"'
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*#/) next
      if (!match(line, /[:=]/)) {
        printf "config: warning: ignoring malformed line %d in the workspace configuration\n", NR > "/dev/stderr"
        next
      }
      k = substr(line, 1, RSTART - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k)
      if (k == "") {
        printf "config: warning: ignoring empty key at line %d in the workspace configuration\n", NR > "/dev/stderr"
        next
      }
      rv = substr(line, RSTART + 1)
      v = cfg_parse_val(rv)
      if (!CFG_PV_OK) {
        printf "config: warning: ignoring malformed quoted value for '\''%s'\'' at line %d\n", k, NR > "/dev/stderr"
        next
      }
      if (v == "" || (k in SEEN)) next
      SEEN[k] = 1
      ORDER[++n] = k
      VAL[k] = v
    }
    END {
      for (i = 1; i <= n; i++) {
        k = ORDER[i]
        printf "%s\t%s\n", k, VAL[k]
      }
    }' "$clf_file"
}

# cfg_list [<ctx_dir>]: emit "<key>\t<value>" lines from <ctx_dir>/config.
cfg_list() {
  cl_ctx=$(cfg_ctx_dir "${1:-}")
  cfg_list_file "$cl_ctx/config"
}

# ---------------------------------------------------------------------------
# 2. Locked atomic writer

# cfg_write_locked <mode: set|raw|unset> <ctx_dir> <key> [<value>]
# Acquires <ctx_dir>/tmp/locks/config.lock inside a subshell with EXIT/HUP/INT/TERM
# cleanup traps (preserving caller traps), stages <ctx_dir>/config.tmp.<pid>,
# and atomically mv -f into <ctx_dir>/config.
# cfg_write_locked restore <ctx_dir> <saved> <expected>: under the same lock, puts the saved
# bytes and mode back (<saved> a file, or a lone hyphen argument when there was no
# configuration, which removes it) only while the configuration's bytes equal <expected>'s, the
# bytes the caller's own writes left; rc 3 writes nothing when another writer changed it
# meanwhile.
cfg_write_locked() {
  cwl_mode=$1
  cwl_ctx=$2
  cwl_key=$3
  cwl_val=${4:-}

  [ "$cwl_mode" = restore ] || cfg_write_key_ok config "$cwl_key" || return 1
  if [ "$cwl_mode" != "unset" ] && [ "$cwl_mode" != restore ]; then
    if [ -z "$cwl_val" ]; then
      printf "config: error: empty value for key '%s' (use unset to remove a key) (ERR_INVALID_ARGUMENT)\n" "$cwl_key" >&2
      return 1
    fi
    cfg_validate_str config "value for '$cwl_key'" "$cwl_val" || return 1
  fi

  cwl_conf="$cwl_ctx/config"
  if [ "$cwl_mode" = "unset" ] && [ ! -f "$cwl_conf" ]; then
    return 0
  fi

  (
    cwl_pid=$$
    cwl_lock_held=""
    cwl_tmp=""
    cwl_cleanup() {
      [ -z "$cwl_tmp" ] || rm -f "$cwl_tmp" 2>/dev/null
      [ -z "$cwl_lock_held" ] || rm -rf "$cwl_lock_held" 2>/dev/null
    }
    trap 'cwl_cleanup' EXIT
    trap 'cwl_cleanup; trap - EXIT; exit 129' HUP
    trap 'cwl_cleanup; trap - EXIT; exit 130' INT
    trap 'cwl_cleanup; trap - EXIT; exit 143' TERM

    cwl_lock_dir="$cwl_ctx/tmp/locks"
    mkdir -p "$cwl_lock_dir" 2>/dev/null || {
      printf 'config.lock: error: cannot create the configuration lock folder (ERR_STORAGE_WRITE)\n' >&2
      exit 2
    }
    cwl_lock="$cwl_lock_dir/config.lock"
    cwl_n=0
    cwl_m=0
    while [ "$cwl_n" -lt 600 ]; do
      if mkdir "$cwl_lock" 2>/dev/null; then
        cwl_lock_held=$cwl_lock
        { sh -c 'printf "%s\n" "$PPID"' > "$cwl_lock/pid" 2>/dev/null || printf '%s\n' "$$" > "$cwl_lock/pid"; } 2>/dev/null || {
          printf 'config.lock: error: cannot write the configuration lock holder pid (ERR_STORAGE_WRITE)\n' >&2
          exit 2
        }
        cwl_pid=$(cat "$cwl_lock/pid" 2>/dev/null)
        case "$cwl_pid" in
          ""|*[!0-9]*) cwl_pid=$$ ;;
        esac
        break
      fi
      cwl_p=$(cat "$cwl_lock/pid" 2>/dev/null)
      case "$cwl_p" in
        ""|*[!0-9]*)
          cwl_m=$((cwl_m + 1))
          if [ "$cwl_m" -ge 10 ]; then
            cwl_m=0
            if rm -rf "$cwl_lock" 2>/dev/null; then
              continue
            fi
          fi
          ;;
        *)
          if kill -0 "$cwl_p" 2>/dev/null; then
            cwl_m=0
          else
            if rm -rf "$cwl_lock" 2>/dev/null; then
              continue
            fi
          fi
          ;;
      esac
      cwl_n=$((cwl_n + 1))
      sleep 0.1 2>/dev/null || { sleep 1; cwl_n=$((cwl_n + 9)); }
    done
    if [ -z "$cwl_lock_held" ]; then
      printf 'config.lock: error: the configuration lock is held (60 s timeout) (ERR_STORAGE_LOCKED)\n' >&2
      exit 2
    fi

    if [ "$cwl_mode" = restore ]; then
      [ -f "$cwl_conf" ] && cmp -s "$cwl_conf" "$cwl_val" || exit 3
      if [ "$cwl_key" = - ]; then
        rm -f "$cwl_conf" 2>/dev/null || {
          printf 'config: error: cannot write the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
          exit 2
        }
        exit 0
      fi
      cwl_tmp="$cwl_ctx/config.tmp.$cwl_pid"
      cp -p "$cwl_key" "$cwl_tmp" 2>/dev/null && mv -f "$cwl_tmp" "$cwl_conf" 2>/dev/null || {
        printf 'config: error: cannot write the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
        exit 2
      }
      cwl_tmp=""
      exit 0
    fi

    if [ "$cwl_mode" = "unset" ] && [ ! -f "$cwl_conf" ]; then
      exit 0
    fi

    if [ -f "$cwl_conf" ]; then
      if [ ! -r "$cwl_conf" ]; then
        printf 'config: error: cannot read the workspace configuration (ERR_STORAGE_READ)\n' >&2
        exit 2
      fi
      if cfg_has_nul_file "$cwl_conf"; then
        printf 'config: error: the workspace configuration contains a NUL byte (ERR_STORAGE_READ)\n' >&2
        exit 2
      fi
      if ! cfg_utf8_file_ok "$cwl_conf"; then
        printf 'config: error: the workspace configuration is not valid UTF-8 (ERR_STORAGE_READ)\n' >&2
        exit 2
      fi
      cwl_no_nl=0
      if [ -s "$cwl_conf" ] && [ -n "$(tail -c 1 "$cwl_conf" 2>/dev/null)" ]; then
        cwl_no_nl=1
      fi
    else
      cwl_no_nl=0
    fi

    cwl_tmp="$cwl_ctx/config.tmp.$cwl_pid"
    : > "$cwl_tmp" 2>/dev/null || {
      cwl_tmp=""
      printf 'config: error: cannot stage the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
      exit 2
    }

    if [ -f "$cwl_conf" ]; then
      CWL_MODE=$cwl_mode CWL_KEY=$cwl_key CWL_VAL=$cwl_val CWL_NONL=$cwl_no_nl LC_ALL=C awk '
        function cfg_format_val(v,   need, i, n, c, o) {
          if (v == "") return "\"\""
          need = 0
          n = length(v)
          if (substr(v, 1, 1) ~ /[ \t]/ || substr(v, n, 1) ~ /[ \t]/) need = 1
          if (!need && (index(v, "\"") || index(v, "'"'"'") || index(v, "\\") || index(v, "#"))) need = 1
          if (!need) return v
          o = "\""
          for (i = 1; i <= n; i++) {
            c = substr(v, i, 1)
            if (c == "\\") o = o "\\" "\\"
            else if (c == "\"") o = o "\\" "\""
            else o = o c
          }
          return o "\""
        }
        BEGIN {
          mode = ENVIRON["CWL_MODE"]
          target = ENVIRON["CWL_KEY"]
          val = ENVIRON["CWL_VAL"]
          no_nl = ENVIRON["CWL_NONL"] + 0
          out_val = (mode == "raw" ? val : cfg_format_val(val))
          is_set = (mode != "unset")
          found = 0; done = 0; m = 0; last_mod = 0
        }
        {
          raw = $0
          clean = raw
          sub(/\r$/, "", clean)
          if (clean !~ /^[ \t]*$/ && clean !~ /^[ \t]*#/ && match(clean, /[:=]/)) {
            k = substr(clean, 1, RSTART - 1)
            gsub(/^[ \t]+|[ \t]+$/, "", k)
            if (k == target) {
              found = 1
              if (is_set && !done) {
                OUT[++m] = target ": " out_val
                MOD[m] = 1
                done = 1
              }
              next
            }
          }
          OUT[++m] = raw
          MOD[m] = 0
        }
        END {
          if (!is_set && !found) exit 3
          if (is_set && !done) {
            OUT[++m] = target ": " out_val
            MOD[m] = 1
          }
          for (j = 1; j <= m; j++) {
            if (j == m && no_nl == 1 && MOD[j] == 0) printf "%s", OUT[j]
            else printf "%s\n", OUT[j]
          }
        }' "$cwl_conf" > "$cwl_tmp"
      cwl_rc=$?
      if [ "$cwl_rc" -eq 3 ]; then
        exit 0
      elif [ "$cwl_rc" -ne 0 ]; then
        printf 'config: error: cannot stage the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
        exit 2
      fi
    else
      if [ "$cwl_mode" = "raw" ]; then
        printf '%s: %s\n' "$cwl_key" "$cwl_val" > "$cwl_tmp" 2>/dev/null || {
          printf 'config: error: cannot write the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
          exit 2
        }
      else
        CWL_KEY=$cwl_key CWL_VAL=$cwl_val LC_ALL=C awk '
          function cfg_format_val(v,   need, i, n, c, o) {
            if (v == "") return "\"\""
            need = 0
            n = length(v)
            if (substr(v, 1, 1) ~ /[ \t]/ || substr(v, n, 1) ~ /[ \t]/) need = 1
            if (!need && (index(v, "\"") || index(v, "'"'"'") || index(v, "\\") || index(v, "#"))) need = 1
            if (!need) return v
            o = "\""
            for (i = 1; i <= n; i++) {
              c = substr(v, i, 1)
              if (c == "\\") o = o "\\" "\\"
              else if (c == "\"") o = o "\\" "\""
              else o = o c
            }
            return o "\""
          }
          BEGIN {
            printf "%s: %s\n", ENVIRON["CWL_KEY"], cfg_format_val(ENVIRON["CWL_VAL"])
          }' < /dev/null > "$cwl_tmp" 2>/dev/null || {
          printf 'config: error: cannot write the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
          exit 2
        }
      fi
    fi

    mv -f "$cwl_tmp" "$cwl_conf" 2>/dev/null || {
      printf 'config: error: cannot write the workspace configuration (ERR_STORAGE_WRITE)\n' >&2
      exit 2
    }
    cwl_tmp=""
    exit 0
  )
}

# cfg_set <key> <value> [<ctx_dir>]: write canonical quoted entry under lock.
cfg_set() {
  cfg_write_locked set "$(cfg_ctx_dir "${3:-}")" "$1" "$2"
}

# cfg_set_raw <key> <value> [<ctx_dir>]: write raw unquoted entry under lock (for pkg_decl_write).
cfg_set_raw() {
  cfg_write_locked raw "$(cfg_ctx_dir "${3:-}")" "$1" "$2"
}

# cfg_unset <key> [<ctx_dir>]: remove all entries for <key> under lock (no-op if absent).
cfg_unset() {
  cfg_write_locked unset "$(cfg_ctx_dir "${2:-}")" "$1"
}

# cfg_restore <saved|-> <expected> [<ctx_dir>]: the saved bytes put back under lock while
# the configuration still holds the expected bytes; rc 3 when another writer changed it.
cfg_restore() {
  cfg_write_locked restore "$(cfg_ctx_dir "${3:-}")" "$1" "$2"
}

# ---------------------------------------------------------------------------
# 3. Schema parser and validator

# Core search schema (declared internally; never stored as a separate module).
CFG_SEARCH_SCHEMA='timeout: optional integer min 1 default 10
  Maximum seconds per module during fan-out search.'

# CFG_SCHEMA_AWK: schema line parser + value validator.
CFG_SCHEMA_AWK="$CFG_UTF8_AWK$CFG_ESC_AWK$CFG_PARSE_VAL_AWK"'
function word(s,   i) {
  i = index(s, " ")
  if (i == 0) i = index(s, "\t")
  return i ? substr(s, 1, i - 1) : s
}
function ltrim(s) {
  sub(/^[ \t]+/, "", s)
  return s
}
function rtrim(s) {
  sub(/[ \t]+$/, "", s)
  return s
}
function val_check(typ, has_oneof, oneof_raw, has_min, min_v, has_max, max_v, val,   nv, ov, k, ok) {
  CFG_VAL_ERR = ""
  CFG_VAL_CODE = "ERR_SCHEMA_VIOLATION"
  if (index(val, "\r") || index(val, "\n")) {
    CFG_VAL_CODE = "ERR_INVALID_ARGUMENT"
    CFG_VAL_ERR = "holds a newline or carriage return"
    return 0
  }
  if (!utf8_ok(val)) {
    CFG_VAL_CODE = "ERR_INVALID_ARGUMENT"
    CFG_VAL_ERR = "is not valid UTF-8"
    return 0
  }
  if (typ == "string") {
    if (val == "") {
      CFG_VAL_ERR = "cannot be empty"
      return 0
    }
    if (has_oneof) {
      nv = split(oneof_raw, ov, /\|/)
      ok = 0
      for (k = 1; k <= nv; k++) if (ov[k] == val) { ok = 1; break }
      if (!ok) {
        CFG_VAL_ERR = "'"'"'" val "'"'"' is not one of " oneof_raw
        return 0
      }
    }
    return 1
  }
  if (typ == "integer") {
    if (val !~ /^-?(0|[1-9][0-9]*)$/) {
      CFG_VAL_ERR = "takes an integer, not '"'"'" val "'"'"'"
      return 0
    }
    if (has_min && (val + 0) < (min_v + 0)) {
      CFG_VAL_ERR = val " is less than minimum " min_v
      return 0
    }
    if (has_max && (val + 0) > (max_v + 0)) {
      CFG_VAL_ERR = val " exceeds maximum " max_v
      return 0
    }
    return 1
  }
  if (typ == "boolean") {
    if (val != "true" && val != "false") {
      CFG_VAL_ERR = "takes true or false, not '"'"'" val "'"'"'"
      return 0
    }
    return 1
  }
  if (typ == "path") {
    if (val == "") {
      CFG_VAL_ERR = "path cannot be empty"
      return 0
    }
    if (val ~ /[\001-\037\177]/) {
      CFG_VAL_CODE = "ERR_INVALID_ARGUMENT"
      CFG_VAL_ERR = "path holds a control character"
      return 0
    }
    return 1
  }
  CFG_VAL_ERR = "unknown type " typ
  return 0
}
function s_fail(msg) {
  printf "%s: error: %s (ERR_INVALID_ARGUMENT)\n", S_LABEL, msg > "/dev/stderr"
  S_ERR = 1
  exit 1
}
'

# cfg_schema_parse_stream <label>: parse schema on stdin, emit 9-column tab lines:
# <key>\t<presence>\t<type>\t<one_of>\t<min>\t<max>\t<has_default>\t<default>\t<description>
cfg_schema_parse_stream() {
  CFG_S_LABEL=${1:-schema} LC_ALL=C awk "$CFG_SCHEMA_AWK"'
    BEGIN {
      S_LABEL = ENVIRON["CFG_S_LABEL"]
      S_ERR = 0
      nk = 0
      last_key = ""
    }
    {
      line = $0
      sub(/\r$/, "", line)
      if (index(line, "\r")) s_fail("line " NR " holds a carriage return")
      if (!utf8_ok(line)) s_fail("line " NR " is not valid UTF-8")
      if (line ~ /^[ \t]*$/) { last_key = ""; next }
      if (line ~ /^[ \t]*#/) { last_key = ""; next }
      if (substr(line, 1, 2) == "  ") {
        if (last_key == "") s_fail("line " NR ": orphaned description line with no preceding key")
        d = substr(line, 3)
        if (DESC[last_key] == "") sub(/^description:[ \t]+/, "", d)
        if (d ~ /^[ \t]*$/) s_fail("line " NR ": empty description line for key '"'"'" last_key "'"'"'")
        DESC[last_key] = (DESC[last_key] == "" ? d : DESC[last_key] "\n" d)
        next
      }
      if (substr(line, 1, 1) ~ /[ \t]/) s_fail("line " NR ": unexpected indentation (descriptions use 2 spaces)")
      c = index(line, ":")
      if (c < 2) s_fail("line " NR ": expected <key>: <required|optional> <type> ...")
      key = substr(line, 1, c - 1)
      if (key == "namespace") s_fail("line " NR ": '\''namespace:'\'' is not allowed in a config schema")
      if (key !~ /^[a-z][a-z0-9_-]*$/) s_fail("line " NR ": invalid key '\''" key "'\'' (expected ^[a-z][a-z0-9_-]*$)")
      if (key in SEEN) s_fail("line " NR ": key '\''" key "'\'' declared twice")
      rest = substr(line, c + 1)
      if (rest == "" || substr(rest, 1, 1) !~ /[ \t]/) s_fail("key '\''" key "'\'': expected space after '\'':'\''")
      rest = rtrim(ltrim(rest))
      pres = word(rest)
      rest = ltrim(substr(rest, length(pres) + 1))
      if (pres != "required" && pres != "optional") s_fail("key '\''" key "'\'': presence must be required or optional, not '\''" pres "'\''")
      typ = word(rest)
      rest = ltrim(substr(rest, length(typ) + 1))
      if (typ != "string" && typ != "integer" && typ != "boolean" && typ != "path") s_fail("key '\''" key "'\'': type must be string, integer, boolean, or path, not '\''" typ "'\''")

      has_oneof = 0; oneof_raw = ""
      has_min = 0; min_v = ""
      has_max = 0; max_v = ""
      has_def = 0; def_v = ""

      while (rest != "") {
        cl = word(rest)
        if (cl == "default") {
          if (has_def) s_fail("key '\''" key "'\'': duplicate default clause")
          if (pres == "required") s_fail("key '\''" key "'\'': required key cannot declare a default")
          def_raw = ltrim(substr(rest, 8))
          if (def_raw == "") s_fail("key '\''" key "'\'': default clause requires a value")
          fq = substr(def_raw, 1, 1)
          def_v = cfg_parse_val(def_raw)
          if (!CFG_PV_OK) s_fail("key '\''" key "'\'': malformed quoted default value")
          if (def_v == "") s_fail("key '\''" key "'\'': default clause requires a value")
          if (fq != "\"" && fq != "'"'"'" && def_v ~ /[ \t]/) {
            s_fail("key '\''" key "'\'': default must be the final clause")
          }
          has_def = 1
          rest = ""
          break
        } else if (typ == "string" && cl == "one-of") {
          if (has_oneof) s_fail("key '\''" key "'\'': duplicate one-of clause")
          after = ltrim(substr(rest, 7))
          if (match(after, /[ \t]+default([ \t]|$)/)) {
            oneof_raw = rtrim(substr(after, 1, RSTART - 1))
            rest = ltrim(substr(after, RSTART))
          } else {
            oneof_raw = after
            rest = ""
          }
          if (oneof_raw == "") s_fail("key '\''" key "'\'': one-of clause requires values")
          if (oneof_raw ~ /[\001-\037\177]/) s_fail("key '\''" key "'\'': one-of set holds a control character")
          nv = split(oneof_raw, OV, /\|/)
          for (k = 1; k <= nv; k++) {
            if (OV[k] == "") s_fail("key '\''" key "'\'': one-of set '\''" oneof_raw "'\'' holds an empty value")
            if (OV[k] ~ /[ \t]/) {
              nw = split(OV[k], OW, /[ \t]+/)
              if (nw >= 2 && OW[2] != "") {
                s_fail("key '\''" key "'\'': unexpected clause '\''" OW[2] "'\'' after one-of")
              }
              s_fail("key '\''" key "'\'': one-of value '\''" OV[k] "'\'' cannot contain whitespace")
            }
          }
          has_oneof = 1
        } else if (typ == "integer" && cl == "min") {
          if (has_min) s_fail("key '\''" key "'\'': duplicate min clause")
          rest = ltrim(substr(rest, 4))
          mv = word(rest)
          if (mv !~ /^-?(0|[1-9][0-9]*)$/) s_fail("key '\''" key "'\'': min takes an integer, not '\''" mv "'\''")
          has_min = 1; min_v = mv
          rest = ltrim(substr(rest, length(mv) + 1))
        } else if (typ == "integer" && cl == "max") {
          if (has_max) s_fail("key '\''" key "'\'': duplicate max clause")
          rest = ltrim(substr(rest, 4))
          mv = word(rest)
          if (mv !~ /^-?(0|[1-9][0-9]*)$/) s_fail("key '\''" key "'\'': max takes an integer, not '\''" mv "'\''")
          has_max = 1; max_v = mv
          rest = ltrim(substr(rest, length(mv) + 1))
        } else {
          s_fail("key '\''" key "'\'': unsupported clause '\''" cl "'\'' for type " typ)
        }
      }

      if (has_min && has_max && (min_v + 0) > (max_v + 0)) {
        s_fail("key '\''" key "'\'': min (" min_v ") exceeds max (" max_v ")")
      }
      if (has_def) {
        if (!val_check(typ, has_oneof, oneof_raw, has_min, min_v, has_max, max_v, def_v)) {
          s_fail("key '\''" key "'\'': invalid default '\''" def_v "'\'': " CFG_VAL_ERR)
        }
      }

      SEEN[key] = 1
      ORDER[++nk] = key
      PRES[key] = pres
      TYP[key] = typ
      ONEOF[key] = oneof_raw
      MINV[key] = min_v
      MAXV[key] = max_v
      HASDEF[key] = has_def
      DEF[key] = def_v
      DESC[key] = ""
      last_key = key
    }
    END {
      if (S_ERR) exit 1
      for (i = 1; i <= nk; i++) {
        k = ORDER[i]
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%d\t%s\t%s\n", k, PRES[k], TYP[k], cfg_esc(ONEOF[k]), MINV[k], MAXV[k], HASDEF[k], cfg_esc(DEF[k]), cfg_esc(DESC[k])
      }
    }'
}

# cfg_schema_parse <file> [<label>]: parse schema file, emit 9-column tab lines.
cfg_schema_parse() {
  csp_file=$1
  csp_lbl=${2:-schema}
  if [ ! -f "$csp_file" ] || [ ! -r "$csp_file" ]; then
    printf '%s: error: cannot read schema file (ERR_STORAGE_READ)\n' "$csp_lbl" >&2
    return 2
  fi
  if cfg_has_nul_file "$csp_file"; then
    printf '%s: error: schema file contains a NUL byte (ERR_INVALID_ARGUMENT)\n' "$csp_lbl" >&2
    return 1
  fi
  cfg_schema_parse_stream "$csp_lbl" < "$csp_file"
}

# cfg_schema_check <file> [<label>]: validate schema file silently on stdout.
cfg_schema_check() {
  cfg_schema_parse "$1" "${2:-schema}" > /dev/null
}

# cfg_schema_validate_value <type> <one_of> <min> <max> <value> [<label>] [<key>]
cfg_schema_validate_value() {
  CSV_TYP=$1 CSV_ONEOF=$2 CSV_MIN=$3 CSV_MAX=$4 CSV_VAL=$5 \
  CSV_LBL=${6:-config} CSV_KEY=${7:-value} LC_ALL=C awk "$CFG_SCHEMA_AWK"'
    BEGIN {
      typ = ENVIRON["CSV_TYP"]
      oneof = ENVIRON["CSV_ONEOF"]
      min_v = ENVIRON["CSV_MIN"]
      max_v = ENVIRON["CSV_MAX"]
      val = ENVIRON["CSV_VAL"]
      lbl = ENVIRON["CSV_LBL"]
      key = ENVIRON["CSV_KEY"]
      if (!val_check(typ, (oneof != ""), oneof, (min_v != ""), min_v, (max_v != ""), max_v, val)) {
        printf "%s: error: key '\''%s'\'': %s (%s)\n", lbl, key, CFG_VAL_ERR, CFG_VAL_CODE > "/dev/stderr"
        exit 1
      }
      exit 0
    }' < /dev/null
}

# ---------------------------------------------------------------------------
# 4. Schema discovery and alias resolution

# cfg_is_builtin <name>: rc 0 for shipped builtin module names.
cfg_is_builtin() {
  case "${1:-}" in
    unit|run|lane|rhythm|store) return 0 ;;
  esac
  return 1
}

# cfg_load_unit_verbs <ctx_dir>: cache unit module verb names once per <ctx_dir>.
cfg_load_unit_verbs() {
  cluv_ctx=$1
  [ "${CFG_UNIT_VERBS_CTX:-}" = "$cluv_ctx" ] && return 0
  CFG_UNIT_VERBS_CTX=$cluv_ctx
  CFG_UNIT_VERBS=" help "
  cluv_root=$(cfg_root_dir "$cluv_ctx")
  cluv_sd="$cluv_ctx/modules/unit/scripts"
  [ -d "$cluv_sd" ] || cluv_sd="$cluv_root/base/.contexture/modules/unit/scripts"
  if [ -d "$cluv_sd" ]; then
    set --
    for cluv_f in "$cluv_sd"/*; do
      [ -f "$cluv_f" ] || continue
      case "${cluv_f##*/}" in *.*) continue ;; esac
      set -- "$@" "$cluv_f"
    done
    if [ $# -gt 0 ]; then
      cluv_hits=$(grep -l '^# summary: ' "$@" 2>/dev/null || true)
      while IFS= read -r cluv_hit; do
        [ -n "$cluv_hit" ] || continue
        CFG_UNIT_VERBS="$CFG_UNIT_VERBS${cluv_hit##*/} "
      done <<EOF
$cluv_hits
EOF
    fi
  fi
}

# cfg_is_reserved <ctx_dir> <name>: rc 0 for engine-reserved names and unit verbs.
cfg_is_reserved() {
  cir_ctx=$1
  cir_name=$2
  case "$cir_name" in
    help|refresh|run|hooks|compose|package|search|config|storage|append|amend|query|flip|drop|next|resolve)
      return 0
      ;;
  esac
  cfg_load_unit_verbs "$cir_ctx"
  case "$CFG_UNIT_VERBS" in
    *" $cir_name "*) return 0 ;;
  esac
  return 1
}

# cfg_alias_of <ctx_dir> <installed_name>: emit "<original> <package>" when aliased;
# silent on absent or unreadable extensions/.state.
cfg_alias_of() {
  cao_ctx=$1
  cao_name=$2
  [ -d "$cao_ctx/extensions/.state" ] || return 0
  for cao_f in "$cao_ctx"/extensions/.state/*.files; do
    [ -f "$cao_f" ] && [ -r "$cao_f" ] || continue
    cao_orig=$(LC_ALL=C awk -v n="$cao_name" '$1 == "module" && NF == 3 && $2 == n && $3 != n { print $3; exit }' "$cao_f" 2>/dev/null)
    [ -n "$cao_orig" ] || continue
    cao_pkg=$(LC_ALL=C awk '$1 == "package" { print $2; exit }' "$cao_f" 2>/dev/null)
    if [ -z "$cao_pkg" ]; then
      cao_pkg=${cao_f##*/}
      cao_pkg=${cao_pkg%.files}
    fi
    printf '%s %s\n' "$cao_orig" "$cao_pkg"
    return 0
  done
  return 0
}

# cfg_module_dir_valid <ctx_dir> <name>: rc 0 if <name> is a valid module directory
# (workspace or extension, including manifestless filter/hook dirs).
cfg_module_dir_valid() {
  cmdv_ctx=$1
  cmdv_name=$2
  case "$cmdv_name" in
    ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin) return 1 ;;
  esac
  cfg_module_name_ok "$cmdv_name" || return 1
  if [ -d "$cmdv_ctx/modules/$cmdv_name" ]; then
    if cfg_is_reserved "$cmdv_ctx" "$cmdv_name" && ! cfg_is_builtin "$cmdv_name"; then
      return 1
    fi
    return 0
  fi
  if [ -d "$cmdv_ctx/extensions/modules/$cmdv_name" ]; then
    cfg_is_builtin "$cmdv_name" && return 1
    cfg_is_reserved "$cmdv_ctx" "$cmdv_name" && return 1
    return 0
  fi
  return 1
}

# cfg_discover_module_configs <ctx_dir>: emit "<namespace>\t<config_file>" sorted by namespace.
# Workspace modules shadow extension modules even if workspace module has no config file.
cfg_discover_module_configs() {
  cdmc_ctx=$1
  cdmc_ws=""
  cdmc_out=""
  if [ -d "$cdmc_ctx/modules" ]; then
    for cdmc_d in "$cdmc_ctx/modules"/*/; do
      [ -d "$cdmc_d" ] || continue
      cdmc_bn=${cdmc_d%/}
      cdmc_bn=${cdmc_bn##*/}
      case "$cdmc_bn" in
        ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin) continue ;;
      esac
      cfg_module_name_ok "$cdmc_bn" || continue
      if cfg_is_reserved "$cdmc_ctx" "$cdmc_bn" && ! cfg_is_builtin "$cdmc_bn"; then
        continue
      fi
      cdmc_ws="$cdmc_ws $cdmc_bn"
      if [ -f "${cdmc_d}config" ]; then
        cdmc_out="${cdmc_out}${cdmc_bn}	${cdmc_d}config
"
      fi
    done
  fi
  if [ -d "$cdmc_ctx/extensions/modules" ]; then
    for cdmc_d in "$cdmc_ctx/extensions/modules"/*/; do
      [ -d "$cdmc_d" ] || continue
      cdmc_bn=${cdmc_d%/}
      cdmc_bn=${cdmc_bn##*/}
      case "$cdmc_bn" in
        ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin) continue ;;
      esac
      cfg_module_name_ok "$cdmc_bn" || continue
      case " $cdmc_ws " in
        *" $cdmc_bn "*) continue ;;
      esac
      cfg_is_builtin "$cdmc_bn" && continue
      cfg_is_reserved "$cdmc_ctx" "$cdmc_bn" && continue
      if [ -f "${cdmc_d}config" ]; then
        cdmc_out="${cdmc_out}${cdmc_bn}	${cdmc_d}config
"
      fi
    done
  fi
  [ -z "$cdmc_out" ] || printf '%s' "$cdmc_out" | LC_ALL=C sort -t '	' -k1,1
}

# cfg_storage_schema_rows <ctx_dir> <label>: parse core storage/config plus installed
# driver configs under storage/drivers/*/config, extensions/storage/drivers/*/config,
# and drivers/*/config. Refuses collisions with core driver or other drivers.
cfg_storage_schema_rows() {
  cssr_ctx=$1
  cssr_lbl=$2
  cssr_root=$(cfg_root_dir "$cssr_ctx")

  cssr_core=""
  if [ -f "$cssr_ctx/storage/config" ]; then
    cssr_core="$cssr_ctx/storage/config"
  elif [ -f "$cssr_root/base/.contexture/storage/config" ]; then
    cssr_core="$cssr_root/base/.contexture/storage/config"
  fi

  cssr_rows=""
  cssr_keys=" "
  if [ -n "$cssr_core" ]; then
    cssr_parsed=$(cfg_schema_parse "$cssr_core" "$cssr_lbl") || return $?
    if [ -n "$cssr_parsed" ]; then
      cssr_rows="$cssr_parsed
"
      while IFS='	' read -r cssr_k cssr_rest; do
        [ -n "$cssr_k" ] || continue
        cssr_keys="$cssr_keys$cssr_k "
      done <<EOF
$cssr_parsed
EOF
    fi
  fi

  cssr_drivers=" "
  for cssr_glob in \
    "$cssr_ctx"/storage/drivers/*/config \
    "$cssr_ctx"/extensions/storage/drivers/*/config \
    "$cssr_ctx"/drivers/*/config; do
    [ -f "$cssr_glob" ] || continue
    cssr_drv_dir=${cssr_glob%/config}
    cssr_drv=${cssr_drv_dir##*/}
    case "$cssr_drivers" in
      *" $cssr_drv "*) continue ;;
    esac
    cssr_drivers="$cssr_drivers$cssr_drv "
    cssr_dparsed=$(cfg_schema_parse "$cssr_glob" "$cssr_lbl ($cssr_drv)") || return $?
    [ -n "$cssr_dparsed" ] || continue
    while IFS='	' read -r cssr_k cssr_rest; do
      [ -n "$cssr_k" ] || continue
      case "$cssr_keys" in
        *" $cssr_k "*)
          printf "%s: error: driver '%s' config key 'storage.%s' collides with an existing storage key (ERR_INVALID_ARGUMENT)\n" "$cssr_lbl" "$cssr_drv" "$cssr_k" >&2
          return 1
          ;;
      esac
      cssr_keys="$cssr_keys$cssr_k "
    done <<EOF
$cssr_dparsed
EOF
    cssr_rows="${cssr_rows}${cssr_dparsed}
"
  done

  printf '%s' "$cssr_rows"
}

# cfg_append_ns_rows <ns> <alias_orig> <alias_pkg> <9col_rows>: prefix 3 namespace/alias
# columns to each parsed schema row.
cfg_emit_ns_rows() {
  printf '%s\n' "$4" | CEN_NS=$1 CEN_AO=$2 CEN_AP=$3 LC_ALL=C awk '
    NF > 0 {
      printf "%s\t%s\t%s\t%s\n", ENVIRON["CEN_NS"], $0, ENVIRON["CEN_AO"], ENVIRON["CEN_AP"]
    }'
}

# cfg_discover_schemas [<ctx_dir>] [<filter_ns>] [<label>]:
# Emit 12-column tab rows:
# <ns>\t<key>\t<presence>\t<type>\t<one_of>\t<min>\t<max>\t<has_default>\t<default>\t<description>\t<alias_orig>\t<alias_pkg>
# If <filter_ns> is given and unknown, refuses rc 1.
cfg_discover_schemas() {
  cds_ctx=$(cfg_ctx_dir "${1:-}")
  cds_ns=${2:-}
  cds_lbl=${3:-config}

  if [ -n "$cds_ns" ]; then
    case "$cds_ns" in
      search)
        cds_r=$(printf '%s\n' "$CFG_SEARCH_SCHEMA" | cfg_schema_parse_stream "$cds_lbl (search)") || return $?
        [ -z "$cds_r" ] || cfg_emit_ns_rows search "" "" "$cds_r"
        return 0
        ;;
      storage)
        cds_r=$(cfg_storage_schema_rows "$cds_ctx" "$cds_lbl") || return $?
        [ -z "$cds_r" ] || cfg_emit_ns_rows storage "" "" "$cds_r"
        return 0
        ;;
      *)
        if ! cfg_module_dir_valid "$cds_ctx" "$cds_ns"; then
          printf "%s: error: unknown configuration namespace '%s' (ERR_ENTITY_NOT_FOUND)\n" "$cds_lbl" "$cds_ns" >&2
          return 1
        fi
        cds_mconf=""
        if [ -f "$cds_ctx/modules/$cds_ns/config" ]; then
          cds_mconf="$cds_ctx/modules/$cds_ns/config"
          cds_ao=""
          cds_ap=""
        elif [ ! -d "$cds_ctx/modules/$cds_ns" ] && [ -f "$cds_ctx/extensions/modules/$cds_ns/config" ]; then
          cds_mconf="$cds_ctx/extensions/modules/$cds_ns/config"
          cds_ao=""
          cds_ap=""
          IFS=' ' read -r cds_ao cds_ap <<EOF
$(cfg_alias_of "$cds_ctx" "$cds_ns")
EOF
        fi
        [ -n "$cds_mconf" ] || return 0
        cds_r=$(cfg_schema_parse "$cds_mconf" "$cds_lbl ($cds_ns)") || return $?
        [ -z "$cds_r" ] || cfg_emit_ns_rows "$cds_ns" "$cds_ao" "$cds_ap" "$cds_r"
        return 0
        ;;
    esac
  fi

  cds_all=""
  cds_sr=$(printf '%s\n' "$CFG_SEARCH_SCHEMA" | cfg_schema_parse_stream "$cds_lbl (search)") || return $?
  if [ -n "$cds_sr" ]; then
    cds_all="${cds_all}$(cfg_emit_ns_rows search "" "" "$cds_sr")
"
  fi
  cds_str=$(cfg_storage_schema_rows "$cds_ctx" "$cds_lbl") || return $?
  if [ -n "$cds_str" ]; then
    cds_all="${cds_all}$(cfg_emit_ns_rows storage "" "" "$cds_str")
"
  fi

  cds_mods=$(cfg_discover_module_configs "$cds_ctx")
  if [ -n "$cds_mods" ]; then
    while IFS='	' read -r cds_m cds_mf; do
      [ -n "$cds_m" ] || continue
      cds_ao=""
      cds_ap=""
      case "$cds_mf" in
        "$cds_ctx"/extensions/modules/*)
          IFS=' ' read -r cds_ao cds_ap <<EOF
$(cfg_alias_of "$cds_ctx" "$cds_m")
EOF
          ;;
      esac
      cds_mr=$(cfg_schema_parse "$cds_mf" "$cds_lbl ($cds_m)") || return $?
      if [ -n "$cds_mr" ]; then
        cds_all="${cds_all}$(cfg_emit_ns_rows "$cds_m" "$cds_ao" "$cds_ap" "$cds_mr")
"
      fi
    done <<EOF
$cds_mods
EOF
  fi

  printf '%s' "$cds_all"
}

# ---------------------------------------------------------------------------
# 5. Assembly, storage driver validator, and shared owner config-verb helper

# cfg_effective_driver [<ctx_dir>]: effective configured storage driver name
# (reading workspace configuration, then legacy storage.conf, else posix).
cfg_effective_driver() {
  ced_ctx=$(cfg_ctx_dir "${1:-}")
  ced_v=$(cfg_get_file "$ced_ctx/config" storage.driver 2>/dev/null) && [ -n "$ced_v" ] && { printf '%s\n' "$ced_v"; return 0; }
  ced_v=$(cfg_get_file "$ced_ctx/config" session.storage.driver 2>/dev/null) && [ -n "$ced_v" ] && { printf '%s\n' "$ced_v"; return 0; }
  ced_v=$(cfg_get_file "$ced_ctx/storage.conf" storage.driver 2>/dev/null) && [ -n "$ced_v" ] && { printf '%s\n' "$ced_v"; return 0; }
  ced_v=$(cfg_get_file "$ced_ctx/storage.conf" session.storage.driver 2>/dev/null) && [ -n "$ced_v" ] && { printf '%s\n' "$ced_v"; return 0; }
  printf 'posix\n'
}

# cfg_find_resolver <ctx_dir>: locate driver-resolver executable.
cfg_find_resolver() {
  cfr_ctx=$1
  cfr_root=$(cfg_root_dir "$cfr_ctx")
  if [ -n "${CTX_STORE_RESOLVER:-}" ] && [ -x "$CTX_STORE_RESOLVER" ]; then
    printf '%s\n' "$CTX_STORE_RESOLVER"
    return 0
  fi
  for cfr_c in \
    "$cfr_ctx/storage/scripts/driver-resolver" \
    "$cfr_root/base/.contexture/storage/scripts/driver-resolver"; do
    if [ -x "$cfr_c" ]; then
      printf '%s\n' "$cfr_c"
      return 0
    fi
  done
  return 1
}

# cfg_storage_driver_post: emit non-blocking stderr migration notice when effective
# driver changed across set or unset.
cfg_storage_driver_post() {
  csdp_new=$(cfg_effective_driver "$CFG_DRV_CTX")
  if [ "$CFG_DRV_OLD" != "$csdp_new" ]; then
    printf "notice: active storage driver changed from '%s' to '%s'; existing data is not migrated automatically between storage drivers\n" "$CFG_DRV_OLD" "$csdp_new" >&2
  fi
  return 0
}

# cfg_validate_storage_driver <op> <key> <value> <ctx_dir>:
# Pre-write validator hook for storage config writes. When <key> is 'driver':
# on set, verifies driver via driver-resolver check >/dev/null before writing;
# on both set and unset, arms CFG_POST_HOOK=cfg_storage_driver_post so a non-blocking
# migration notice prints if the effective driver changes.
cfg_validate_storage_driver() {
  cvsd_op=$1
  cvsd_key=$2
  cvsd_val=$3
  cvsd_ctx=$4
  [ "$cvsd_key" = "driver" ] || return 0

  if [ "$cvsd_op" = "set" ]; then
    case "$cvsd_val" in
      ""|-*|*[[:space:]]*)
        printf "store config: error: malformed storage driver '%s' (ERR_INVALID_ARGUMENT)\n" "$cvsd_val" >&2
        return 1
        ;;
    esac
    cvsd_rsv=$(cfg_find_resolver "$cvsd_ctx") || {
      printf 'store config: error: the storage core resolver is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
      return 2
    }
    cvsd_root=$(cfg_root_dir "$cvsd_ctx")
    (
      unset CTX_DIR
      CTX_ROOT=$cvsd_root
      export CTX_ROOT
      cd "$cvsd_root" || exit 2
      exec "$cvsd_rsv" check "$cvsd_val" >/dev/null
    ) || return $?
  fi

  CFG_DRV_OLD=$(cfg_effective_driver "$cvsd_ctx")
  CFG_DRV_CTX=$cvsd_ctx
  CFG_POST_HOOK=cfg_storage_driver_post
  return 0
}

# cfg_assembly_load <caller_label> <ctx_dir> [--module=<ns>] [--json] [--owner]
cfg_assembly_load() {
  cal_lbl=$1
  cal_ctx=$2
  shift 2
  cal_mod=""
  cal_json=0
  cal_owner=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --module=)
        printf '%s: error: --module= names no namespace (ERR_INVALID_ARGUMENT)\n' "$cal_lbl" >&2
        return 1
        ;;
      --module=*) cal_mod=${1#--module=} ;;
      --json) cal_json=1 ;;
      --owner) cal_owner=1 ;;
      *)
        printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cal_lbl" "$1" >&2
        return 1
        ;;
    esac
    shift
  done

  cal_schemas=$(cfg_discover_schemas "$cal_ctx" "$cal_mod" "$cal_lbl") || return $?
  cal_entries=$(cfg_list_file "$cal_ctx/config") || return $?

  if [ "$cal_owner" -eq 0 ] && { [ -z "$cal_mod" ] || [ "$cal_mod" = "storage" ]; }; then
    if [ -f "$cal_ctx/storage.conf" ]; then
      printf '%s: warning: legacy storage configuration is deprecated; move settings into the workspace configuration\n' "$cal_lbl" >&2
    fi
  fi

  CAL_SCHEMAS=$cal_schemas CAL_ENTRIES=$cal_entries CAL_JSON=$cal_json \
  CAL_LBL=$cal_lbl CAL_OWNER=$cal_owner CAL_MOD=$cal_mod \
  LC_ALL=C awk "$CFG_ESC_AWK$CFG_JQ_AWK"'
    BEGIN {
      json = ENVIRON["CAL_JSON"] + 0
      lbl = ENVIRON["CAL_LBL"]
      owner = ENVIRON["CAL_OWNER"] + 0
      mod = ENVIRON["CAL_MOD"]

      nsch = split(ENVIRON["CAL_SCHEMAS"], SL, /\n/)
      nkeys = 0
      for (i = 1; i <= nsch; i++) {
        if (SL[i] == "") continue
        split(SL[i], F, /\t/)
        ns = F[1]; k = F[2]; full = ns "." k
        DECL[full] = 1
        ORDER[++nkeys] = full
        SNS[full] = ns
        SK[full] = k
        STYP[full] = F[4]
        SHASDEF[full] = F[8] + 0
        SDEF[full] = cfg_unesc(F[9])
        SAO[full] = F[11]
      }

      nent = split(ENVIRON["CAL_ENTRIES"], EL, /\n/)
      for (i = 1; i <= nent; i++) {
        if (EL[i] == "") continue
        t = index(EL[i], "\t")
        if (t < 2) continue
        ek = substr(EL[i], 1, t - 1)
        ev = substr(EL[i], t + 1)
        if (substr(ek, 1, 8) == "package.") continue
        CVAL[ek] = ev
        CHAS[ek] = 1
        if (owner || mod != "") {
          if (mod != "") {
            ns_of = ""
            for (di = length(ek); di >= 1; di--) {
              if (substr(ek, di, 1) == ".") { ns_of = substr(ek, 1, di - 1); break }
            }
            if (ns_of == mod && !(ek in DECL)) {
              printf "%s: warning: undeclared configuration key '\''%s'\''\n", lbl, ek > "/dev/stderr"
            }
          }
          if (!owner && mod == "storage" && index(ek, "session.storage.") == 1) {
            printf "%s: warning: legacy key '\''%s'\'' is deprecated; use '\''storage.%s'\''\n", lbl, ek, substr(ek, 17) > "/dev/stderr"
          }
          continue
        }
        if (index(ek, "session.storage.") == 1) {
          printf "%s: warning: legacy key '\''%s'\'' is deprecated; use '\''storage.%s'\''\n", lbl, ek, substr(ek, 17) > "/dev/stderr"
          continue
        }
        if (!(ek in DECL)) {
          printf "%s: warning: undeclared configuration key '\''%s'\''\n", lbl, ek > "/dev/stderr"
        }
      }

      out_n = 0
      for (i = 1; i <= nkeys; i++) {
        full = ORDER[i]
        if (full in CHAS) {
          val = CVAL[full]; src = "config"
        } else if (SHASDEF[full]) {
          val = SDEF[full]; src = "default"
        } else {
          continue
        }
        OUT[++out_n] = full
        OVAL[full] = val
        OSRC[full] = src
      }

      if (json) {
        printf "{\"entries\":["
        for (i = 1; i <= out_n; i++) {
          full = OUT[i]
          printf "%s{\"namespace\":%s,\"key\":%s,\"full_key\":%s", (i > 1 ? "," : ""), cfg_jq(SNS[full]), cfg_jq(SK[full]), cfg_jq(full)
          if (SAO[full] != "") printf ",\"alias_of\":%s", cfg_jq(SAO[full])
          printf ",\"value\":%s,\"type\":%s,\"source\":%s}", cfg_jq(OVAL[full]), cfg_jq(STYP[full]), cfg_jq(OSRC[full])
        }
        printf "]}\n"
      } else {
        for (i = 1; i <= out_n; i++) {
          full = OUT[i]
          if (OSRC[full] == "default") printf "%s: %s (default)\n", full, OVAL[full]
          else printf "%s: %s\n", full, OVAL[full]
        }
      }
    }' < /dev/null
}

# cfg_assembly_get <caller_label> <ctx_dir> <ns.key>
cfg_assembly_get() {
  cag_lbl=$1
  cag_ctx=$2
  cag_full=$3

  case "$cag_full" in
    package.*)
      printf "%s: error: package declarations are managed by 'ctx package list' (ERR_INVALID_ARGUMENT)\n" "$cag_lbl" >&2
      return 1
      ;;
    *.*) ;;
    *)
      printf "%s: error: expected <namespace>.<key>, got '%s' (ERR_INVALID_ARGUMENT)\n" "$cag_lbl" "$cag_full" >&2
      return 1
      ;;
  esac

  cag_ns=${cag_full%.*}
  cag_k=${cag_full##*.}
  if [ -z "$cag_ns" ] || ! cfg_local_key_ok "$cag_k"; then
    printf "%s: error: malformed configuration key '%s' (ERR_INVALID_ARGUMENT)\n" "$cag_lbl" "$cag_full" >&2
    return 1
  fi

  cag_schemas=$(cfg_discover_schemas "$cag_ctx" "$cag_ns" "$cag_lbl") || return $?
  cag_row=$(printf '%s\n' "$cag_schemas" | LC_ALL=C awk -F '\t' -v k="$cag_k" '$2 == k { print; exit }')
  if [ -z "$cag_row" ]; then
    printf "%s: error: unknown configuration key '%s' (ERR_SCHEMA_VIOLATION)\n" "$cag_lbl" "$cag_full" >&2
    return 1
  fi

  cag_val=$(cfg_get_file "$cag_ctx/config" "$cag_full")
  cag_rc=$?
  if [ "$cag_rc" -eq 0 ]; then
    printf '%s\n' "$cag_val"
    return 0
  elif [ "$cag_rc" -eq 2 ]; then
    return 2
  fi

  cag_has_def=$(printf '%s\n' "$cag_row" | LC_ALL=C awk -F '\t' '{ print $8 }')
  if [ "$cag_has_def" = "1" ]; then
    printf '%s\n' "$cag_row" | LC_ALL=C awk "$CFG_ESC_AWK"'BEGIN { FS = "\t" } { print cfg_unesc($9) }'
    return 0
  fi

  printf "%s: error: configuration key '%s' is not set (ERR_ENTITY_NOT_FOUND)\n" "$cag_lbl" "$cag_full" >&2
  return 1
}

# cfg_assembly_schema <caller_label> <ctx_dir> [<ns>] [--json]
cfg_assembly_schema() {
  cas_lbl=$1
  cas_ctx=$2
  shift 2
  cas_ns=""
  cas_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) cas_json=1 ;;
      -*)
        printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cas_lbl" "$1" >&2
        return 1
        ;;
      *)
        if [ -n "$cas_ns" ]; then
          printf "%s: error: unexpected argument '%s' (ERR_INVALID_ARGUMENT)\n" "$cas_lbl" "$1" >&2
          return 1
        fi
        cas_ns=$1
        ;;
    esac
    shift
  done

  cas_schemas=$(cfg_discover_schemas "$cas_ctx" "$cas_ns" "$cas_lbl") || return $?
  CAS_SCHEMAS=$cas_schemas CAS_JSON=$cas_json LC_ALL=C awk "$CFG_ESC_AWK$CFG_JQ_AWK"'
    function cfg_schema_val(v,   need, i, n, c, o) {
      if (v == "") return "\"\""
      need = 0
      n = length(v)
      if (index(v, " ") || index(v, "\t") || index(v, "\"") || index(v, "'"'"'") || index(v, "\\") || index(v, "#")) need = 1
      if (!need) return v
      o = "\""
      for (i = 1; i <= n; i++) {
        c = substr(v, i, 1)
        if (c == "\\") o = o "\\" "\\"
        else if (c == "\"") o = o "\\" "\""
        else o = o c
      }
      return o "\""
    }
    BEGIN {
      json = ENVIRON["CAS_JSON"] + 0
      n = split(ENVIRON["CAS_SCHEMAS"], SL, /\n/)
      nns = 0
      for (i = 1; i <= n; i++) {
        if (SL[i] == "") continue
        split(SL[i], F, /\t/)
        ns = F[1]
        if (!(ns in NS_SEEN)) {
          NS_SEEN[ns] = 1
          NS_ORD[++nns] = ns
          NS_AO[ns] = F[11]
          NS_AP[ns] = F[12]
          NS_CNT[ns] = 0
        }
        idx = ++NS_CNT[ns]
        K_NAME[ns, idx] = F[2]
        K_PRES[ns, idx] = F[3]
        K_TYP[ns, idx] = F[4]
        K_ONE[ns, idx] = cfg_unesc(F[5])
        K_MIN[ns, idx] = F[6]
        K_MAX[ns, idx] = F[7]
        K_HDEF[ns, idx] = F[8] + 0
        K_DEF[ns, idx] = cfg_unesc(F[9])
        K_DESC[ns, idx] = cfg_unesc(F[10])
      }
      if (json) {
        printf "{\"schemas\":["
        for (i = 1; i <= nns; i++) {
          ns = NS_ORD[i]
          printf "%s{\"namespace\":%s", (i > 1 ? "," : ""), cfg_jq(ns)
          if (NS_AO[ns] != "") printf ",\"alias_of\":%s", cfg_jq(NS_AO[ns])
          if (NS_AP[ns] != "") printf ",\"package\":%s", cfg_jq(NS_AP[ns])
          printf ",\"keys\":["
          for (j = 1; j <= NS_CNT[ns]; j++) {
            k = K_NAME[ns, j]
            printf "%s{\"key\":%s,\"full_key\":%s,\"presence\":%s,\"type\":%s", (j > 1 ? "," : ""), cfg_jq(k), cfg_jq(ns "." k), cfg_jq(K_PRES[ns, j]), cfg_jq(K_TYP[ns, j])
            if (K_ONE[ns, j] != "") {
              no = split(K_ONE[ns, j], OV, /\|/)
              printf ",\"one_of\":["
              for (oi = 1; oi <= no; oi++) printf "%s%s", (oi > 1 ? "," : ""), cfg_jq(OV[oi])
              printf "]"
            }
            if (K_MIN[ns, j] != "") printf ",\"min\":%s", K_MIN[ns, j]
            if (K_MAX[ns, j] != "") printf ",\"max\":%s", K_MAX[ns, j]
            if (K_HDEF[ns, j]) printf ",\"default\":%s", cfg_jq(K_DEF[ns, j])
            if (K_DESC[ns, j] != "") printf ",\"description\":%s", cfg_jq(K_DESC[ns, j])
            printf "}"
          }
          printf "]}"
        }
        printf "]}\n"
      } else {
        for (i = 1; i <= nns; i++) {
          ns = NS_ORD[i]
          if (NS_AO[ns] != "") printf "%s (alias of %s from package %s):\n", ns, NS_AO[ns], NS_AP[ns]
          else printf "%s:\n", ns
          for (j = 1; j <= NS_CNT[ns]; j++) {
            line = K_NAME[ns, j] ": " K_PRES[ns, j] " " K_TYP[ns, j]
            if (K_ONE[ns, j] != "") line = line " one-of " K_ONE[ns, j]
            if (K_MIN[ns, j] != "") line = line " min " K_MIN[ns, j]
            if (K_MAX[ns, j] != "") line = line " max " K_MAX[ns, j]
            if (K_HDEF[ns, j]) line = line " default " cfg_schema_val(K_DEF[ns, j])
            printf "  %s\n", line
            if (K_DESC[ns, j] != "") {
              nd = split(K_DESC[ns, j], DL, /\n/)
              for (di = 1; di <= nd; di++) printf "    %s\n", DL[di]
            }
          }
        }
      }
    }' < /dev/null
}

# cfg_owner_help <ns> <caller_label> [<subcommand>]: print owner config help.
cfg_owner_help() {
  coh_ns=$1
  coh_lbl=$2
  coh_sub=${3:-}
  case "$coh_sub" in
    "")
      cat <<EOF
usage: $coh_lbl <subcommand> [args...]
subcommands:
  load [--json]         show effective configuration for $coh_ns
  get <key>             read one configuration value for $coh_ns
  set <key> <value>     validate and write one configuration value for $coh_ns
  unset <key>           remove one configuration value for $coh_ns
  schema [--json]       show configuration schema for $coh_ns
  help [<subcommand>]   show help for a configuration subcommand
EOF
      ;;
    load)
      printf 'usage: %s load [--json]\nshow effective configuration entries for %s (workspace configuration overrides schema defaults)\n' "$coh_lbl" "$coh_ns"
      ;;
    get)
      printf 'usage: %s get <key>\nread one configuration value for %s using its local key name\n' "$coh_lbl" "$coh_ns"
      ;;
    set)
      printf 'usage: %s set <key> <value>\nvalidate and write one configuration value for %s to the workspace configuration\n' "$coh_lbl" "$coh_ns"
      ;;
    unset)
      printf 'usage: %s unset <key>\nremove one configuration value for %s from the workspace configuration\n' "$coh_lbl" "$coh_ns"
      ;;
    schema)
      printf 'usage: %s schema [--json]\nshow declared configuration schema keys, types, defaults, and descriptions for %s\n' "$coh_lbl" "$coh_ns"
      ;;
    help)
      printf 'usage: %s help [<subcommand>]\nshow configuration command help for %s\n' "$coh_lbl" "$coh_ns"
      ;;
    *)
      printf "%s: error: unknown subcommand '%s' (ERR_INVALID_ARGUMENT)\n" "$coh_lbl" "$coh_sub" >&2
      return 1
      ;;
  esac
  return 0
}

# config_owner_verb <ns> <caller_label> <validator_fn> [args...]:
# Shared owner config-verb implementation (load [--json], get, set, unset,
# schema [--json], help, --help/-h) over local key names.
config_owner_verb() {
  cov_ns=$1
  cov_lbl=$2
  cov_hook=$3
  shift 3

  if [ $# -eq 0 ]; then
    cfg_owner_help "$cov_ns" "$cov_lbl"
    return 0
  fi

  cov_sub=$1
  shift
  case "$cov_sub" in
    --help|-h)
      if [ $# -ne 0 ]; then
        printf "%s: error: unexpected argument '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$1" >&2
        return 1
      fi
      cfg_owner_help "$cov_ns" "$cov_lbl"
      return 0
      ;;
    help)
      if [ $# -eq 1 ]; then
        case "$1" in
          --help|-h)
            cfg_owner_help "$cov_ns" "$cov_lbl" help
            return $?
            ;;
        esac
      fi
      if [ $# -gt 1 ]; then
        printf '%s: error: help takes at most one subcommand name (ERR_INVALID_ARGUMENT)\n' "$cov_lbl" >&2
        return 1
      fi
      cfg_owner_help "$cov_ns" "$cov_lbl" "${1:-}"
      return $?
      ;;
  esac

  case "${1:-}" in
    --help|-h)
      if [ $# -eq 1 ]; then
        cfg_owner_help "$cov_ns" "$cov_lbl" "$cov_sub"
        return $?
      fi
      ;;
  esac

  cov_ctx=$(cfg_ctx_dir)
  case "$cov_sub" in
    load)
      cov_json=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --json) cov_json=1 ;;
          *)
            printf "%s: error: unknown argument '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$1" >&2
            return 1
            ;;
        esac
        shift
      done
      if [ "$cov_json" -eq 1 ]; then
        cfg_assembly_load "$cov_lbl" "$cov_ctx" "--module=$cov_ns" --owner --json
      else
        cfg_assembly_load "$cov_lbl" "$cov_ctx" "--module=$cov_ns" --owner
      fi
      ;;
    get)
      if [ $# -ne 1 ]; then
        printf '%s: error: get takes one local key name (ERR_INVALID_ARGUMENT)\n' "$cov_lbl" >&2
        return 1
      fi
      cov_k=$1
      case "$cov_k" in
        -*) printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2; return 1 ;;
        *.*) printf "%s: error: use local key name without namespace prefix: '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2; return 1 ;;
      esac
      if ! cfg_local_key_ok "$cov_k"; then
        printf "%s: error: malformed key '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2
        return 1
      fi
      cfg_assembly_get "$cov_lbl" "$cov_ctx" "$cov_ns.$cov_k"
      ;;
    set)
      if [ $# -ne 2 ]; then
        printf '%s: error: set takes <key> and <value> (ERR_INVALID_ARGUMENT)\n' "$cov_lbl" >&2
        return 1
      fi
      cov_k=$1
      cov_v=$2
      case "$cov_k" in
        -*) printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2; return 1 ;;
        *.*) printf "%s: error: use local key name without namespace prefix: '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2; return 1 ;;
      esac
      if ! cfg_local_key_ok "$cov_k"; then
        printf "%s: error: malformed key '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2
        return 1
      fi
      cov_schemas=$(cfg_discover_schemas "$cov_ctx" "$cov_ns" "$cov_lbl") || return $?
      cov_row=$(printf '%s\n' "$cov_schemas" | LC_ALL=C awk -F '\t' -v k="$cov_k" '$2 == k { print; exit }')
      if [ -z "$cov_row" ]; then
        printf "%s: error: unknown configuration key '%s' (ERR_SCHEMA_VIOLATION)\n" "$cov_lbl" "$cov_k" >&2
        return 1
      fi
      cov_typ=$(printf '%s\n' "$cov_row" | LC_ALL=C awk -F '\t' '{ print $4 }')
      cov_one=$(printf '%s\n' "$cov_row" | LC_ALL=C awk "$CFG_ESC_AWK"'BEGIN { FS = "\t" } { print cfg_unesc($5) }')
      cov_min=$(printf '%s\n' "$cov_row" | LC_ALL=C awk -F '\t' '{ print $6 }')
      cov_max=$(printf '%s\n' "$cov_row" | LC_ALL=C awk -F '\t' '{ print $7 }')
      cfg_schema_validate_value "$cov_typ" "$cov_one" "$cov_min" "$cov_max" "$cov_v" "$cov_lbl" "$cov_k" || return $?
      CFG_POST_HOOK=""
      if [ -n "$cov_hook" ]; then
        "$cov_hook" set "$cov_k" "$cov_v" "$cov_ctx" || return $?
      fi
      cfg_set "$cov_ns.$cov_k" "$cov_v" "$cov_ctx" || return $?
      if [ -n "$CFG_POST_HOOK" ]; then
        "$CFG_POST_HOOK"
      fi
      return 0
      ;;
    unset)
      if [ $# -ne 1 ]; then
        printf '%s: error: unset takes one local key name (ERR_INVALID_ARGUMENT)\n' "$cov_lbl" >&2
        return 1
      fi
      cov_k=$1
      case "$cov_k" in
        -*) printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2; return 1 ;;
        *.*) printf "%s: error: use local key name without namespace prefix: '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2; return 1 ;;
      esac
      if ! cfg_local_key_ok "$cov_k"; then
        printf "%s: error: malformed key '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_k" >&2
        return 1
      fi
      cov_schemas=$(cfg_discover_schemas "$cov_ctx" "$cov_ns" "$cov_lbl") || return $?
      cov_row=$(printf '%s\n' "$cov_schemas" | LC_ALL=C awk -F '\t' -v k="$cov_k" '$2 == k { print; exit }')
      if [ -z "$cov_row" ]; then
        printf "%s: error: unknown configuration key '%s' (ERR_SCHEMA_VIOLATION)\n" "$cov_lbl" "$cov_k" >&2
        return 1
      fi
      cov_pres=$(printf '%s\n' "$cov_row" | LC_ALL=C awk -F '\t' '{ print $3 }')
      if [ "$cov_pres" = "required" ]; then
        printf "%s: error: cannot unset required configuration key '%s' (ERR_SCHEMA_VIOLATION)\n" "$cov_lbl" "$cov_k" >&2
        return 1
      fi
      CFG_POST_HOOK=""
      if [ -n "$cov_hook" ]; then
        "$cov_hook" unset "$cov_k" "" "$cov_ctx" || return $?
      fi
      cfg_unset "$cov_ns.$cov_k" "$cov_ctx" || return $?
      if [ -n "$CFG_POST_HOOK" ]; then
        "$CFG_POST_HOOK"
      fi
      return 0
      ;;
    schema)
      cov_json=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --json) cov_json=1 ;;
          *)
            printf "%s: error: unknown argument '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$1" >&2
            return 1
            ;;
        esac
        shift
      done
      if [ "$cov_json" -eq 1 ]; then
        cfg_assembly_schema "$cov_lbl" "$cov_ctx" "$cov_ns" --json
      else
        cfg_assembly_schema "$cov_lbl" "$cov_ctx" "$cov_ns"
      fi
      ;;
    *)
      printf "%s: error: unknown subcommand '%s' (ERR_INVALID_ARGUMENT)\n" "$cov_lbl" "$cov_sub" >&2
      return 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# 6. The human's answer
#
# cfg_answer <label> <subject> <word1> <flag1> <word2> <flag2>: the answer to a question only
# the human answers (an irreversible choice a package script needs before it writes), its
# word on stdout rc 0. It asks only when stdin and stderr are both terminals ([ -t 0 ] and
# [ -t 2 ]), or when CTX_PACKAGE_TTY names a file read as the terminal (the test seam); never
# /dev/tty, so a harness shell holding a controlling terminal never blocks, and never on
# stdin alone, so a run under ctx run, whose capture makes stderr a file, refuses instead of
# waiting. The question is one stderr line, <label>: <subject>; answer <word1> or <word2>:,
# an unknown answer re-asks, and end of input refuses rc 1 with one line naming both flags.
# With no terminal it refuses rc 1 with one stderr line naming the subject, both flags, and
# that the answer is the human's, so an agent relays the question and never picks a default;
# a seam naming a file that cannot be read refuses rc 2. Nothing is written in any case.
cfg_answer() {
  ca_lbl=$1 ca_subj=$2 ca_w1=$3 ca_f1=$4 ca_w2=$5 ca_f2=$6
  if [ -n "${CTX_PACKAGE_TTY:-}" ]; then
    if [ ! -f "$CTX_PACKAGE_TTY" ] || [ ! -r "$CTX_PACKAGE_TTY" ]; then
      printf "%s: the answer cannot be read: CTX_PACKAGE_TTY names no readable file\n" "$ca_lbl" >&2
      return 2
    fi
  elif ! { [ -t 0 ] && [ -t 2 ]; }; then
    printf "%s: %s; this needs the human's answer, %s (%s) or %s (%s): relay the question and run it again with the flag the human chooses (the answer is the human's, never a default)\n" \
      "$ca_lbl" "$ca_subj" "$ca_w1" "$ca_f1" "$ca_w2" "$ca_f2" >&2
    return 1
  fi
  (
    if [ -n "${CTX_PACKAGE_TTY:-}" ]; then
      exec < "$CTX_PACKAGE_TTY" || exit 2
    fi
    ca_ask="$ca_lbl: $ca_subj; answer $ca_w1 or $ca_w2: "
    while :; do
      printf '%s' "$ca_ask" >&2
      if ! IFS= read -r ca_line; then
        printf "\n%s: no answer was read; answer %s or %s, or run it again with %s or %s as the human chooses\n" "$ca_lbl" "$ca_w1" "$ca_w2" "$ca_f1" "$ca_f2" >&2
        exit 1
      fi
      ca_line=$(printf '%s' "$ca_line" | tr -d ' \t\r')
      if [ "$ca_line" = "$ca_w1" ] || [ "$ca_line" = "$ca_w2" ]; then
        printf '%s\n' "$ca_line"
        exit 0
      fi
      ca_ask="$ca_lbl: '$ca_line' is no answer; answer $ca_w1 or $ca_w2: "
    done
  )
}

# cfg_answer_value <label> <subject> <flag>: one value only the human gives (a required
# setting with no default), on stdout rc 0, under cfg_answer's terminal rule and seam: the
# question is one stderr line, <label>: <subject>; answer a value:, an empty answer re-asks,
# end of input refuses rc 1 naming the flag, and with no terminal one stderr line names the
# subject, the flag, and that the answer is the human's, rc 1; an unreadable seam refuses rc 2.
# The value is trimmed of leading and trailing blanks, tabs, and carriage returns; the caller
# checks it against its type. Nothing is written in any case.
cfg_answer_value() {
  cav_lbl=$1 cav_subj=$2 cav_flag=$3
  if [ -n "${CTX_PACKAGE_TTY:-}" ]; then
    if [ ! -f "$CTX_PACKAGE_TTY" ] || [ ! -r "$CTX_PACKAGE_TTY" ]; then
      printf "%s: the answer cannot be read: CTX_PACKAGE_TTY names no readable file\n" "$cav_lbl" >&2
      return 2
    fi
  elif ! { [ -t 0 ] && [ -t 2 ]; }; then
    printf "%s: %s; this needs the human's answer, a value given as %s: relay the question and run it again with the value the human chooses (the answer is the human's, never a default)\n" \
      "$cav_lbl" "$cav_subj" "$cav_flag" >&2
    return 1
  fi
  (
    if [ -n "${CTX_PACKAGE_TTY:-}" ]; then
      exec < "$CTX_PACKAGE_TTY" || exit 2
    fi
    cav_ask="$cav_lbl: $cav_subj; answer a value: "
    while :; do
      printf '%s' "$cav_ask" >&2
      if ! IFS= read -r cav_line; then
        printf "\n%s: no answer was read; answer a value, or run it again with %s as the human chooses\n" "$cav_lbl" "$cav_flag" >&2
        exit 1
      fi
      cav_line=$(printf '%s' "$cav_line" | tr -d '\r' | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//')
      if [ -n "$cav_line" ]; then
        printf '%s\n' "$cav_line"
        exit 0
      fi
      cav_ask="$cav_lbl: an empty answer is no answer; answer a value: "
    done
  )
}

# ---------------------------------------------------------------------------
# 7. The driver package run
#
# The steps the package installer and uninstaller share when a driver package moves the record
# between posix and its driver: long steps as held children, the driver hooks, the storage
# moving freeze, the move engine's commands, the configuration's snapshot and its put back,
# and the move state read with crash recovery. A caller sets DL_WS (the workspace root),
# DL_LABEL (its stderr label), DL_BIN (the engine), DL_SCR (its own scratch folder), DL_PKG and
# DL_PKG_ROOT (the package's name and root, the root empty when no catalog holds it), and
# DL_ANSWER (the old copy answer: backup, delete, or empty), then calls dl_init.

dl_init() {
  DL_CORE=$DL_WS/.contexture/storage/scripts
  DL_CONF=$DL_WS/.contexture/config
  DL_STATE=$DL_WS/.contexture/extensions/.state
  DL_RUN=""
  DL_STAMP=""
  DL_CHILD=""
  DL_TOKEN=""
  DL_CONF_SAVED=0
  DL_LINE=""
  DL_FLAG=$DL_SCR/stopped
}

dl_err() { printf '%s: %s\n' "$DL_LABEL" "$*" >&2; }

# dl_first <file>: the file's first line holding a character; a line naming a path is left out
dl_first() {
  dlf_l=$(awk '/[^[:space:]]/ { sub(/\r$/, ""); print; exit }' "$1" 2>/dev/null)
  case "$dlf_l" in
    */*) dlf_l="its message names a path, so it is left out" ;;
    "") dlf_l="it gave no reason" ;;
  esac
  printf '%s\n' "$dlf_l"
}

# dl_env_vars: the CTX_STORAGE_ variables the environment sets, joined by commas
dl_env_vars() {
  env | sed -n 's/^\(CTX_STORAGE_[A-Za-z0-9_]*\)=.*/\1/p' | LC_ALL=C sort -u \
    | awk '{ s = s (s == "" ? "" : ", ") $0 } END { print s }'
}

# dl_run_make: the run folder, the drawer's tmp/driver-run.<pid>, and the run's one stamp
# (<YYYYmmdd-HHMMSS>-<pid>); rc 2 when the drawer's scratch cannot hold it (never the system
# temp). The in and out subfolders are the move engine's run folders of the move in and out.
dl_run_make() {
  dlr_t=$DL_WS/.contexture/tmp
  { [ -d "$dlr_t" ] || mkdir -p "$dlr_t"; } 2>/dev/null && [ -w "$dlr_t" ] || return 2
  DL_RUN=$dlr_t/driver-run.$$
  rm -rf "$DL_RUN" 2>/dev/null
  mkdir "$DL_RUN" "$DL_RUN/in" "$DL_RUN/out" 2>/dev/null || { DL_RUN=""; return 2; }
  DL_STAMP="$(date +%Y%m%d-%H%M%S)-$$"
  printf '%s\n' "$DL_STAMP" > "$DL_RUN/stamp" 2>/dev/null || return 2
}

dl_run_drop() {
  [ -z "$DL_RUN" ] || rm -rf "$DL_RUN" 2>/dev/null
}

# dl_held <stdout file> <stderr file> <command>...: one long step as a held child, started in
# the background with stdin /dev/null so a trapped signal reaches the caller at once through
# the wait builtin; DL_CHILD names it while it runs
dl_held() {
  dlh_o=$1
  dlh_e=$2
  shift 2
  "$@" < /dev/null > "$dlh_o" 2> "$dlh_e" &
  DL_CHILD=$!
  wait "$DL_CHILD"
  dlh_rc=$?
  DL_CHILD=""
  return "$dlh_rc"
}

# dl_stop: the held child stopped, TERM, then KILL after 10 s, then reaped; the killer polls a
# flag file, since it inherits the ignored signals of an unwind and so cannot be signalled
dl_stop() {
  [ -n "$DL_CHILD" ] || return 0
  kill -TERM "$DL_CHILD" 2>/dev/null
  rm -f "$DL_FLAG" 2>/dev/null
  (
    dls_n=0
    while [ "$dls_n" -lt 100 ]; do
      [ -f "$DL_FLAG" ] && exit 0
      if sleep 0.1 2>/dev/null; then dls_n=$((dls_n + 1)); else sleep 1; dls_n=$((dls_n + 10)); fi
    done
    kill -KILL "$DL_CHILD" 2>/dev/null
  ) &
  dls_k=$!
  wait "$DL_CHILD" 2>/dev/null
  : > "$DL_FLAG"
  wait "$dls_k" 2>/dev/null
  DL_CHILD=""
}

# dl_core_exec <scratch root, or -> <token: 1 or 0> <script> <arguments>...: a storage core
# script from the workspace root, the scratch root and, with 1, the freeze token exported into
# it alone
dl_core_exec() {
  cd "$DL_WS" || exit 2
  unset CTX_DIR
  CTX_ROOT=$DL_WS
  CTX_STORE_WORKSPACE=$DL_WS
  export CTX_ROOT CTX_STORE_WORKSPACE
  if [ "$1" != - ]; then
    CTX_SCRATCH_ROOT=$1
    export CTX_SCRATCH_ROOT
  fi
  if [ "$2" = 1 ] && [ -n "$DL_TOKEN" ]; then
    CTX_STORAGE_MOVE=$DL_TOKEN
    export CTX_STORAGE_MOVE
  fi
  dlc_s=$3
  shift 3
  exec "$DL_CORE/$dlc_s" "$@"
}

# dl_move <run subfolder> <store-move arguments>...: one move engine command as a held child,
# the run subfolder as its run folder and the freeze token passed; its streams in DL_SCR's
# move.out and move.err
dl_move() {
  dlm_r=$1
  shift
  dl_held "$DL_SCR/move.out" "$DL_SCR/move.err" dl_core_exec "$dlm_r" 1 store-move "$@"
}

# dl_take <source> <target>: the storage moving freeze for this run (holder pid $$), the
# source named through the override so the old copy step's deletes to it pass; a held child,
# so a signal stops it with TERM (a background take ignores an interrupt)
dl_take() {
  dl_held "$DL_SCR/take.out" "$DL_SCR/take.err" dl_core_exec - 0 driver-resolver --driver="$1" move-freeze "$$" "$2"
  dlt_rc=$?
  [ "$dlt_rc" -ne 0 ] || DL_TOKEN=$$
  return "$dlt_rc"
}

dl_release() {
  [ -n "$DL_TOKEN" ] || return 0
  ( dl_core_exec - 0 driver-resolver move-release "$$" ) > /dev/null 2> "$DL_SCR/release.err"
  dlr_rc=$?
  [ "$dlr_rc" -ne 0 ] || DL_TOKEN=""
  return "$dlr_rc"
}

# dl_namespaces <file>: the namespaces the declaration listing names (kept ones included),
# one per line; rc 2 when the listing fails
dl_namespaces() {
  ( dl_core_exec - 0 store-data --list ) > "$DL_SCR/ns.list" 2> /dev/null || return 2
  cut -f 1 "$DL_SCR/ns.list" > "$1"
}

# dl_count <driver> <file>: "<namespace> <count>" per namespace through the named driver's
# store.list, unknown when a count fails; rc 2 when the namespace listing fails
dl_count() {
  dl_namespaces "$DL_SCR/count.ns" || return 2
  : > "$2"
  while IFS= read -r dlc_ns; do
    [ -n "$dlc_ns" ] || continue
    dlc_n=$( ( dl_core_exec - 0 store-clear count --driver="$1" "$dlc_ns" ) 2> /dev/null) && [ -n "$dlc_n" ] || dlc_n=unknown
    printf '%s %s\n' "$dlc_ns" "$dlc_n" >> "$2"
  done < "$DL_SCR/count.ns"
}

# dl_holding <counts file>: the namespaces holding a key (or whose count failed), for a line
dl_holding() {
  awk '$2 != "0" { printf "%s%s (%s)", (n++ ? ", " : ""), $1, ($2 == "unknown" ? "key count unknown" : ($2 == "1" ? "1 key" : $2 " keys")) }' "$1"
}

# dl_ask <counts file> <subject>: DL_ANSWER settled before anything is written: kept when the
# flag gave it, else asked once when the old copy holds a key, else left empty; the answer is
# the human's, so no terminal refuses rc 1 naming both flags
dl_ask() {
  [ -z "$DL_ANSWER" ] || return 0
  dla_h=$(dl_holding "$1")
  [ -n "$dla_h" ] || return 0
  DL_ANSWER=$(cfg_answer "$DL_LABEL" "$2: $dla_h; back it up or delete it" backup --backup-old delete --delete-old) || return $?
}

# dl_hook <part folder> <hook> <version> <direction> [<old copy> [<backup folder>]]: a driver
# hook (prepare, finish, cleanup) inside the driver part, run as a held child from the
# workspace root with stdin /dev/null, today's hook environment, CTX_DRIVER, and
# CTX_DRIVER_DIRECTION, a finish out also CTX_DRIVER_OLD_COPY and, for a backup,
# CTX_DRIVER_BACKUP, never the freeze token nor any CTX_STORAGE_ variable; a missing hook
# answers rc 0; DL_LINE holds its first stderr line
dl_hook() {
  DL_LINE=""
  [ -f "$1/hooks/$2" ] || return 0
  dl_held "$DL_SCR/hook.out" "$DL_SCR/hook.err" dl_hook_exec "$@"
  dlk_rc=$?
  DL_LINE=$(dl_first "$DL_SCR/hook.err")
  return "$dlk_rc"
}

dl_hook_exec() {
  cd "$DL_WS" || exit 2
  for dlx_v in $(env | sed -n 's/^\(CTX_STORAGE_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$dlx_v"
  done
  unset CTX_DIR CTX_SCRATCH_ROOT
  CTX_ROOT=$DL_WS
  CTX_BIN=$DL_BIN
  CTX_PACKAGE_NAME=$DL_PKG
  CTX_PACKAGE_VERSION=$3
  CTX_PACKAGE_ROOT=$DL_PKG_ROOT
  CTX_DRIVER=${1##*/}
  CTX_DRIVER_DIRECTION=$4
  LC_ALL=C
  export CTX_ROOT CTX_BIN CTX_PACKAGE_NAME CTX_PACKAGE_VERSION CTX_PACKAGE_ROOT CTX_DRIVER CTX_DRIVER_DIRECTION LC_ALL
  if [ -n "${5:-}" ]; then
    CTX_DRIVER_OLD_COPY=$5
    export CTX_DRIVER_OLD_COPY
  fi
  if [ -n "${6:-}" ]; then
    CTX_DRIVER_BACKUP=$6
    export CTX_DRIVER_BACKUP
  fi
  dlx_h=$1/hooks/$2
  [ ! -x "$dlx_h" ] || exec "$dlx_h"
  exec sh "$dlx_h"
}

# dl_finish_out <driver> <version> <backup|delete>: the driver's finish hook out, its own
# storage (the old copy once the record reads from posix) backed up into the run's backup,
# move-<stamp>/@<driver> (a name no namespace can take), or deleted; DL_DONE says what it did
dl_finish_out() {
  dlo_part=$DL_WS/.contexture/extensions/storage/drivers/$1
  dlo_b=""
  if [ "$3" = backup ]; then
    dlo_b=$DL_WS/.contexture/backups/move-$DL_STAMP/@$1
    mkdir -p "$dlo_b" 2>/dev/null || { DL_LINE="the backup folder cannot be made in the drawer"; return 2; }
  fi
  dl_hook "$dlo_part" finish "$2" out "$3" "$dlo_b"
  dlo_rc=$?
  if [ -n "$dlo_b" ]; then
    if rmdir "$dlo_b" 2>/dev/null; then
      rmdir "${dlo_b%/*}" 2>/dev/null
      DL_DONE="held nothing to back up"
    else
      DL_DONE="moved into the backup stamped $DL_STAMP"
    fi
  else
    DL_DONE="deleted"
  fi
  return "$dlo_rc"
}

# dl_conf_save: the configuration's bytes and mode (or its absence) saved in the run folder
# before the run's first write of a phase; dl_conf_set and dl_conf_unset write through the
# locked writer, noting each key; dl_conf_back puts the saved bytes back under the lock while
# the file holds what the run's writes left, else each noted key alone, said so
dl_conf_save() {
  rm -f "$DL_RUN/config.saved" "$DL_RUN/config.expect" 2>/dev/null
  if [ -f "$DL_CONF" ]; then
    cp -p "$DL_CONF" "$DL_RUN/config.saved" 2>/dev/null || return 2
  fi
  : > "$DL_RUN/config.keys" || return 2
  DL_CONF_SAVED=1
  dl_conf_mark
}

dl_conf_mark() {
  if [ -f "$DL_CONF" ]; then
    cp -p "$DL_CONF" "$DL_RUN/config.expect" 2>/dev/null
  else
    rm -f "$DL_RUN/config.expect" 2>/dev/null
  fi
}

dl_conf_set() {
  grep -Fqx -- "$1" "$DL_RUN/config.keys" 2>/dev/null || printf '%s\n' "$1" >> "$DL_RUN/config.keys"
  cfg_set "$1" "$2" "$DL_WS/.contexture" 2> "$DL_SCR/conf.err" || return $?
  dl_conf_mark
}

dl_conf_unset() {
  grep -Fqx -- "$1" "$DL_RUN/config.keys" 2>/dev/null || printf '%s\n' "$1" >> "$DL_RUN/config.keys"
  cfg_unset "$1" "$DL_WS/.contexture" 2> "$DL_SCR/conf.err" || return $?
  dl_conf_mark
}

# dl_conf_revert <key>: one key put back to its saved value (or unset when it had none)
dl_conf_revert() {
  if [ -f "$DL_RUN/config.saved" ] && dlv_v=$(cfg_get_file "$DL_RUN/config.saved" "$1" 2>/dev/null) && [ -n "$dlv_v" ]; then
    dl_conf_set "$1" "$dlv_v"
  else
    dl_conf_unset "$1"
  fi
}

dl_conf_back() {
  [ "$DL_CONF_SAVED" -eq 1 ] || return 0
  DL_CONF_SAVED=0
  dlb_s=-
  [ ! -f "$DL_RUN/config.saved" ] || dlb_s=$DL_RUN/config.saved
  if [ -f "$DL_RUN/config.expect" ]; then
    cfg_restore "$dlb_s" "$DL_RUN/config.expect" "$DL_WS/.contexture" 2> /dev/null
    dlb_rc=$?
  elif [ -f "$DL_CONF" ]; then
    dlb_rc=3
  else
    dlb_rc=0
  fi
  [ "$dlb_rc" -ne 0 ] || return 0
  [ "$dlb_rc" -eq 3 ] || return "$dlb_rc"
  while IFS= read -r dlb_k; do
    [ -n "$dlb_k" ] || continue
    if [ "$dlb_s" != - ] && dlb_v=$(cfg_get_file "$dlb_s" "$dlb_k" 2>/dev/null) && [ -n "$dlb_v" ]; then
      cfg_set "$dlb_k" "$dlb_v" "$DL_WS/.contexture" 2> /dev/null || return 2
    else
      cfg_unset "$dlb_k" "$DL_WS/.contexture" 2> /dev/null || return 2
    fi
  done < "$DL_RUN/config.keys"
  dl_err "the workspace configuration changed during the run, so each key the run wrote was put back alone"
}

# dl_driver_pkgs: "<package> <driver> <version>" per installed driver package
dl_driver_pkgs() {
  for dlp_f in "$DL_STATE"/*.files; do
    [ -f "$dlp_f" ] || continue
    awk '
      $1 == "package" && NF == 2 && p == "" { p = $2 }
      $1 == "version" && NF == 2 && v == "" { v = $2 }
      $1 == "kind" && NF == 2 && k == "" { k = $2 }
      $1 == "driver" && NF == 2 && d == "" { d = $2 }
      END { if (k == "driver" && p != "" && d != "") print p " " d " " v }' "$dlp_f" 2>/dev/null
  done
}

# dl_written <run subfolder>: the keys the copy sent per namespace, noted before an unwind
# removes its lists; dl_unwound <unwind stdout>: "<namespace> <w> written, <d> deleted"
# joined by semicolons
dl_written() {
  for dlu_f in "$1"/written.*; do
    [ -f "$dlu_f" ] || continue
    printf '%s %s\n' "${dlu_f##*/written.}" "$(awk 'END { print NR }' "$dlu_f")"
  done > "$DL_SCR/unwound.w"
}

dl_unwound() {
  awk 'FILENAME == ARGV[1] { i = index($0, ": "); if (i) d[substr($0, 1, i - 1)] = substr($0, i + 2) + 0; next }
    $2 > 0 || d[$1] > 0 { printf "%s%s %s written, %s deleted", (n++ ? "; " : ""), $1, $2, (($1 in d) ? d[$1] : 0) }' \
    "$1" "$DL_SCR/unwound.w" 2>/dev/null
}

# dl_out <driver>: the move back into posix (an uninstall of the configured driver, a format
# change's move out): the freeze naming posix, store-move copy <driver> posix, storage.driver
# unset, store-move check <driver>, the release; DL_STEP names the step reached, DL_LINE a
# failure's reason, DL_OUT_LINES the copy's lines; dl_out_unwind undoes a failure
dl_out() {
  DL_O_COPY=0
  DL_O_SWITCH=0
  DL_STEP="the freeze"
  dl_conf_save || { DL_LINE="the workspace configuration cannot be saved in the run folder"; return 2; }
  dl_take "$1" posix || { DL_LINE=$(dl_first "$DL_SCR/take.err"); return 2; }
  DL_STEP="the copy into posix"
  DL_O_COPY=1
  dl_move "$DL_RUN/out" copy "$1" posix || { DL_LINE=$(dl_first "$DL_SCR/move.err"); return 2; }
  DL_OUT_LINES=$(cat "$DL_SCR/move.out")
  DL_STEP="the switch to posix"
  DL_O_SWITCH=1
  dl_conf_unset storage.driver || { DL_LINE=$(dl_first "$DL_SCR/conf.err"); return 2; }
  DL_STEP="the check through posix"
  dl_move "$DL_RUN/out" check "$1" || { DL_LINE=$(dl_first "$DL_SCR/move.err"); return 2; }
  return 0
}

dl_out_unwind() {
  DL_UNWOUND=""
  dlw_rc=0
  [ "${DL_O_SWITCH:-0}" -eq 0 ] || dl_conf_revert storage.driver
  if [ "${DL_O_COPY:-0}" -eq 1 ]; then
    dl_written "$DL_RUN/out"
    if dl_move "$DL_RUN/out" unwind posix; then
      DL_UNWOUND=$(dl_unwound "$DL_SCR/move.out")
    else
      DL_UNWOUND="the unwind of the posix copy stopped ($(dl_first "$DL_SCR/move.err")), so its freeze stays for the next driver package run, which deletes that copy"
      dlw_rc=2
    fi
  fi
  [ "$dlw_rc" -ne 0 ] || dl_release
  dl_conf_back || dlw_rc=2
  return "$dlw_rc"
}

# dl_recover: the move state read first by every driver package run: held refuses rc 2,
# stale is recovered with one line naming what it found and did, then each stopped run's kept
# old copy step is finished and every other stopped run's folder removed
dl_recover() {
  DL_STATE_LINE=$( ( dl_core_exec - 0 driver-resolver move-state ) 2> "$DL_SCR/state.err") \
    || { dl_err "the storage moving state cannot be read ($(dl_first "$DL_SCR/state.err"))"; return 2; }
  case "$DL_STATE_LINE" in
    free) ;;
    held) dl_err "storage is being moved by another run; retry after that move ends (ERR_STORAGE_LOCKED)"; return 2 ;;
    held\ *) dl_err "storage is being moved to driver '${DL_STATE_LINE#held }' by another run; retry after that move ends (ERR_STORAGE_LOCKED)"; return 2 ;;
    stale\ *) dl_stale "${DL_STATE_LINE#stale }" || return $? ;;
    *) dl_err "the storage moving state reads '$DL_STATE_LINE'"; return 2 ;;
  esac
  dl_kept
}

# dl_clear <source>: a crashed move's freeze removed through a take naming posix and the release
dl_clear() {
  dl_take "$1" posix || { dl_err "the freeze a stopped move left cannot be cleared ($(dl_first "$DL_SCR/take.err"))"; return 2; }
  dl_release
}

# dl_kept_for <driver>: rc 0 when a stopped run's folder holds an unfinished step of a move
# into the driver
dl_kept_for() {
  for dlq_d in "$DL_WS"/.contexture/tmp/driver-run.*; do
    [ -s "$dlq_d/pending" ] && [ -f "$dlq_d/run" ] || continue
    [ "$(awk '{ print $2; exit }' "$dlq_d/run")" = "$1" ] && return 0
  done
  return 1
}

dl_stale() {
  dls_t=$1
  dls_c=$(cfg_effective_driver "$DL_WS/.contexture")
  if [ "$dls_t" = posix ] && [ "$dls_c" = posix ]; then
    dl_clear posix || return 2
    dls_what="the record reads from posix"
    dls_pkgs=$(dl_driver_pkgs)
    if [ -n "$dls_pkgs" ]; then
      set -- $dls_pkgs
      dl_count "$2" "$DL_SCR/stale.counts" || { dl_err "the namespaces cannot be listed, so the stopped move cannot be recovered"; return 2; }
      if [ -n "$(dl_holding "$DL_SCR/stale.counts")" ]; then
        dl_ask "$DL_SCR/stale.counts" "a stopped move back into posix left the '$2' driver's own storage, the old copy" || return $?
        dl_finish_out "$2" "$3" "${DL_ANSWER:-backup}" || {
          dl_err "found a move back into posix stopped after its switch, but the '$2' driver's finish failed ($DL_LINE); run the uninstall of $1 with the human's answer to finish"
          return 2
        }
        dls_what="$dls_what; the '$2' driver's own storage $DL_DONE"
      fi
      dls_what="$dls_what; $1 stays installed, not configured"
    fi
    printf '%s: recovered a move back into posix stopped after its switch: %s\n' "$DL_LABEL" "$dls_what"
  elif [ "$dls_t" = "$dls_c" ]; then
    dl_kept_for "$dls_t" && return 0
    dl_clear posix || return 2
    printf "%s: recovered a move into '%s' stopped after its switch: the record reads from '%s' and nothing was left to finish\n" "$DL_LABEL" "$dls_t" "$dls_t"
  elif [ "$dls_t" = posix ]; then
    dl_take "$dls_c" posix || { dl_err "the freeze a stopped move left cannot be cleared ($(dl_first "$DL_SCR/take.err"))"; return 2; }
    dl_namespaces "$DL_SCR/stale.ns" || { dl_release; dl_err "the namespaces cannot be listed, so the stopped move cannot be recovered"; return 2; }
    dls_n=0
    while IFS= read -r dls_ns; do
      [ -n "$dls_ns" ] || continue
      if ! dls_k=$( ( dl_core_exec - 1 store-clear namespace --driver=posix "$dls_ns" ) 2> "$DL_SCR/clear.err"); then
        dl_release
        dl_err "the partial posix copy a stopped move back left cannot be deleted ($(dl_first "$DL_SCR/clear.err"))"
        return 2
      fi
      dls_n=$((dls_n + ${dls_k:-0}))
    done < "$DL_SCR/stale.ns"
    dl_release
    printf "%s: recovered a move back into posix stopped before its switch: deleted the %s keys of its partial posix copy; the record reads from '%s'\n" "$DL_LABEL" "$dls_n" "$dls_c"
  else
    dls_what="nothing of it was found installed"
    dls_pkg=$(dl_driver_pkgs | awk -v d="$dls_t" '$2 == d { print; exit }')
    if [ -n "$dls_pkg" ]; then
      set -- $dls_pkg
      dl_hook "$DL_WS/.contexture/extensions/storage/drivers/$2" cleanup "$3" in || {
        dl_err "found a move into '$2' stopped before its switch, but the driver's cleanup failed ($DL_LINE)"
        return 2
      }
      dls_what="the driver's cleanup removed what the move made; $1 stays installed, not configured"
    fi
    dl_clear posix || return 2
    printf "%s: recovered a move into '%s' stopped before its switch: the record reads from '%s'; %s\n" "$DL_LABEL" "$dls_t" "$dls_c" "$dls_what"
  fi
}

# dl_kept: each stopped run's folder (its pid gone): an unfinished old copy step or finish of
# a move into the configured driver is finished under a freeze, with this run's answer and
# the stopped run's stamp; any other such folder is removed
dl_kept() {
  for dlk_d in "$DL_WS"/.contexture/tmp/driver-run.*; do
    [ -d "$dlk_d" ] || continue
    dlk_p=${dlk_d##*.}
    case "$dlk_p" in ""|*[!0-9]*) continue ;; esac
    [ "$dlk_p" != "$$" ] || continue
    ! kill -0 "$dlk_p" 2>/dev/null || continue
    if [ -s "$dlk_d/pending" ] && [ -f "$dlk_d/run" ]; then
      dl_kept_finish "$dlk_d" || return $?
    fi
    rm -rf "$dlk_d" 2>/dev/null
  done
  return 0
}

dl_kept_finish() {
  read -r dkf_pkg dkf_drv dkf_ver < "$1/run" || return 0
  [ "$(cfg_effective_driver "$DL_WS/.contexture")" = "$dkf_drv" ] || return 0
  dkf_stamp=$(sed -n '1p' "$1/stamp" 2>/dev/null)
  dkf_said=""
  if grep -qx retire "$1/pending"; then
    dl_count posix "$DL_SCR/kept.counts" || { dl_err "the namespaces cannot be listed, so a stopped run's old copy step cannot be finished"; return 2; }
    dl_ask "$DL_SCR/kept.counts" "a stopped run of '$dkf_pkg' left the old posix copy of the record it moved into '$dkf_drv'" || return $?
    dl_take posix "$dkf_drv" || { dl_err "a stopped run's old copy step cannot be finished: the freeze cannot be taken ($(dl_first "$DL_SCR/take.err"))"; return 2; }
    if ! dl_move "$1/in" retire posix "${DL_ANSWER:-backup}" "$dkf_stamp"; then
      dl_release
      dl_err "a stopped run's old copy step cannot be finished ($(dl_first "$DL_SCR/move.err")); its run state stays for the next driver package run"
      return 2
    fi
    dl_release
    dkf_said=$(sed -n '$p' "$DL_SCR/move.out")
    grep -vx retire "$1/pending" > "$1/pending.new"; mv -f "$1/pending.new" "$1/pending"
  fi
  if grep -qx finish "$1/pending"; then
    dl_hook "$DL_WS/.contexture/extensions/storage/drivers/$dkf_drv" finish "$dkf_ver" in || {
      dl_err "a stopped run's driver finish cannot be completed ($DL_LINE)"
      return 2
    }
    dkf_said="${dkf_said:+$dkf_said; }the driver's finish ran"
  fi
  printf "%s: finished what a stopped run of '%s' left after its verify: %s\n" "$DL_LABEL" "$dkf_pkg" "${dkf_said:-nothing remained}"
}
