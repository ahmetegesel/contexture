#!/bin/sh
# driver-resolver: the storage core's driver resolver: it resolves storage drivers,
# validates capability handshakes, and dispatches storage operations for every module
# over the generic module store (the record through the unit module's data script, the
# corpus through the docs module). The core's posix driver sits beside this script under
# storage/drivers; the session module's compatibility wrapper retired with the unit
# module, so every caller reaches the one resolver here directly.
#
# Standardized exit codes:
#   0: success
#   1: semantic or validation error (ERR_INVALID_ARGUMENT)
#   2: storage or driver error (ERR_DRIVER_NOT_FOUND, ERR_CAPABILITY_UNSUPPORTED, ERR_DRIVER_PROTOCOL)

set -u

# Locate .contexture root directory
find_ctx_dir() {
  if [ -n "${CTX_DIR:-}" ] && [ -d "$CTX_DIR" ]; then
    printf '%s\n' "$CTX_DIR"
    return 0
  fi
  if [ -n "${CTX_ROOT:-}" ] && [ -d "$CTX_ROOT/.contexture" ]; then
    printf '%s/.contexture\n' "$CTX_ROOT"
    return 0
  fi
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s/.contexture\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  sdir=$(CDPATH="" cd "$(dirname "$0")" 2>/dev/null && pwd)
  curr="$sdir"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s/.contexture\n' "$curr"
      return 0
    elif [ "$(basename "$curr")" = ".contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  if [ -d ".contexture" ]; then
    printf '%s/.contexture\n' "$PWD"
    return 0
  fi
  return 1
}

# Read storage.driver from .contexture/storage.conf
read_conf_driver() {
  ctx_dir="$1"
  # Check unified workspace config first (.contexture/config)
  conf="$ctx_dir/config"
  if [ -f "$conf" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        session.storage.driver*=*|session.storage.driver*:*|storage.driver*=*|storage.driver*:*)
          val=${line#*=}
          [ "$val" = "$line" ] && val=${line#*:}
          val=${val%%#*}
          val=$(printf '%s' "$val" | tr -d ' \t\r\n"')
          val=$(printf '%s' "$val" | tr -d "'")
          if [ -n "$val" ]; then
            printf '%s\n' "$val"
            return 0
          fi
          ;;
      esac
    done < "$conf"
  fi
  # Fallback to storage.conf if present
  conf="$ctx_dir/storage.conf"
  if [ -f "$conf" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        session.storage.driver*=*|session.storage.driver*:*|storage.driver*=*|storage.driver*:*)
          val=${line#*=}
          [ "$val" = "$line" ] && val=${line#*:}
          val=${val%%#*}
          val=$(printf '%s' "$val" | tr -d ' \t\r\n"')
          val=$(printf '%s' "$val" | tr -d "'")
          if [ -n "$val" ]; then
            printf '%s\n' "$val"
            return 0
          fi
          ;;
      esac
    done < "$conf"
  fi
  return 1
}

# Locate driver executable: the storage core's drivers first, then the extension root's
# package drivers, then the transitional locations (workspace drivers, module-owned
# drivers, the base mirror, PATH). The core drivers and the extension root are the
# settled end shape; the module tree carries the fts5 driver until the module system
# moves it to the extension root.
find_driver_executable() {
  ctx_dir="$1"
  driver="$2"

  case "$driver" in
    */*)
      if [ -x "$driver" ]; then
        printf '%s\n' "$driver"
        return 0
      fi
      ;;
  esac

  # Tier 1: Workspace custom drivers (transitional)
  if [ -x "$ctx_dir/drivers/$driver/driver" ]; then
    printf '%s/drivers/%s/driver\n' "$ctx_dir" "$driver"
    return 0
  fi
  if [ -f "$ctx_dir/drivers/$driver" ] && [ -x "$ctx_dir/drivers/$driver" ]; then
    printf '%s/drivers/%s\n' "$ctx_dir" "$driver"
    return 0
  fi

  # Tier 2: The storage core's drivers
  if [ -x "$ctx_dir/storage/drivers/$driver/driver" ]; then
    printf '%s/storage/drivers/%s/driver\n' "$ctx_dir" "$driver"
    return 0
  fi
  if [ -f "$ctx_dir/storage/drivers/$driver" ] && [ -x "$ctx_dir/storage/drivers/$driver" ]; then
    printf '%s/storage/drivers/%s\n' "$ctx_dir" "$driver"
    return 0
  fi

  # Tier 3: The extension root's package drivers (the settled home of a package's
  # driver; the core's drivers above stay beside it, the transitional tiers below)
  if [ -x "$ctx_dir/extensions/storage/drivers/$driver/driver" ]; then
    printf '%s/extensions/storage/drivers/%s/driver\n' "$ctx_dir" "$driver"
    return 0
  fi
  if [ -f "$ctx_dir/extensions/storage/drivers/$driver" ] && [ -x "$ctx_dir/extensions/storage/drivers/$driver" ]; then
    printf '%s/extensions/storage/drivers/%s\n' "$ctx_dir" "$driver"
    return 0
  fi

  # Tier 4: Module-owned drivers (transitional; the fts5 driver lives here until the
  # module system moves it to the extension root)
  for mod_dir in "$ctx_dir"/modules/*; do
    [ -d "$mod_dir" ] || continue
    if [ -x "$mod_dir/drivers/$driver/driver" ]; then
      printf '%s/drivers/%s/driver\n' "$mod_dir" "$driver"
      return 0
    fi
    if [ -f "$mod_dir/drivers/$driver" ] && [ -x "$mod_dir/drivers/$driver" ]; then
      printf '%s/drivers/%s\n' "$mod_dir" "$driver"
      return 0
    fi
  done

  # Tier 5: Base mirror fallback (transitional)
  base_ctx="$ctx_dir/../base/.contexture"
  if [ -d "$base_ctx" ]; then
    if [ -x "$base_ctx/storage/drivers/$driver/driver" ]; then
      printf '%s/storage/drivers/%s/driver\n' "$base_ctx" "$driver"
      return 0
    fi
    if [ -x "$base_ctx/extensions/storage/drivers/$driver/driver" ]; then
      printf '%s/extensions/storage/drivers/%s/driver\n' "$base_ctx" "$driver"
      return 0
    fi
    for mod_dir in "$base_ctx"/modules/*; do
      [ -d "$mod_dir" ] || continue
      if [ -x "$mod_dir/drivers/$driver/driver" ]; then
        printf '%s/drivers/%s/driver\n' "$mod_dir" "$driver"
        return 0
      fi
      if [ -f "$mod_dir/drivers/$driver" ] && [ -x "$mod_dir/drivers/$driver" ]; then
        printf '%s/drivers/%s\n' "$mod_dir" "$driver"
        return 0
      fi
    done
  fi

  # Tier 6: External binary on PATH (transitional)
  if command -v "ctx-storage-$driver" >/dev/null 2>&1; then
    command -v "ctx-storage-$driver"
    return 0
  fi

  return 1
}

# Determine configured driver name honoring precedence
determine_driver_name() {
  ctx_dir="$1"
  override_driver="${2:-}"

  if [ -n "$override_driver" ]; then
    printf '%s\n' "$override_driver"
    return 0
  fi

  if [ -n "${CTX_STORAGE_DRIVER:-}" ]; then
    printf '%s\n' "$CTX_STORAGE_DRIVER"
    return 0
  fi

  conf_driver=$(read_conf_driver "$ctx_dir" 2>/dev/null) || conf_driver=""
  if [ -n "$conf_driver" ]; then
    printf '%s\n' "$conf_driver"
    return 0
  fi

  printf 'posix\n'
  return 0
}

# Resolve target driver path
resolve_target_driver() {
  ctx_dir="$1"
  target_name="$2"

  resolved_path=$(find_driver_executable "$ctx_dir" "$target_name") || resolved_path=""

  if [ -n "$resolved_path" ] && [ -x "$resolved_path" ]; then
    printf '%s\n' "$resolved_path"
    return 0
  fi

  # Canonical default path for the core posix baseline driver
  if [ "$target_name" = "posix" ]; then
    printf '%s/storage/drivers/posix/driver\n' "$ctx_dir"
    return 0
  fi

  printf 'driver-resolver: ERROR: storage driver '\''%s'\'' not found in the core drivers, the extension drivers, workspace drivers, module drivers, or PATH (ERR_DRIVER_NOT_FOUND)\n' "$target_name" >&2
  return 2
}

# cap_prep: CAP_ERR_FILE, a scratch file of the drawer that takes the driver's stderr at the
# handshake (removed by cap_refused or cap_done); empty when the drawer cannot be written,
# and the stderr is then set aside as before
cap_prep() {
  CAP_ERR_FILE=""
  mkdir -p "$CTX_DIR/tmp" 2>/dev/null && CAP_ERR_FILE=$(mktemp "$CTX_DIR/tmp/cap-err.XXXXXX" 2>/dev/null) || CAP_ERR_FILE=""
}
cap_done() { [ -n "${CAP_ERR_FILE:-}" ] && rm -f "$CAP_ERR_FILE"; CAP_ERR_FILE=""; return 0; }

# cap_refused <driver name> <rc>: the handshake's refusal, one line: the driver's own refusal
# line when it printed one (it names what failed; its code ends the line), else the
# handshake's ERR_DRIVER_PROTOCOL line
cap_refused() {
  cr_line=""
  if [ -n "${CAP_ERR_FILE:-}" ]; then
    cr_line=$(head -n 1 "$CAP_ERR_FILE" 2>/dev/null)
    cap_done
  fi
  if [ -n "$cr_line" ]; then
    printf 'driver-resolver: ERROR: capability handshake failed for driver '\''%s'\'': %s\n' "$1" "$cr_line" >&2
  else
    printf 'driver-resolver: ERROR: capability handshake failed for driver '\''%s'\'' with exit code %d (ERR_DRIVER_PROTOCOL)\n' "$1" "$2" >&2
  fi
}

# Validate capability handshake
verify_capabilities() {
  driver_exec="$1"
  driver_name="$2"

  if [ ! -x "$driver_exec" ]; then
    printf 'driver-resolver: ERROR: driver executable '\''%s'\'' not found or not executable (ERR_DRIVER_NOT_FOUND)\n' "$driver_exec" >&2
    return 2
  fi

  cap_prep
  cap_json=$("$driver_exec" capability 2>"${CAP_ERR_FILE:-/dev/null}" </dev/null)
  cap_rc=$?
  [ "$cap_rc" -eq 0 ] && cap_done

  if [ "$cap_rc" -ne 0 ]; then
    cap_refused "$driver_name" "$cap_rc"
    return 2
  fi

  # contract 3 (docs/the-engine.md, The descriptor and the handshake): the store-only card
  # at driver version 3.0.0: contract 3, the seven data names in the fixed order, exact among
  # the search modes, and the optional token agreement. The card carries no record function
  # family: capability and storage.health are the driver's own methods, never descriptor
  # families, and a record-only driver refuses
  check_result=$(printf '%s\n' "$cap_json" | desc_field contract)
  if [ "$check_result" != 3 ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares contract '\''%s'\'', not 3 (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$check_result" >&2
    return 2
  fi
  case "$cap_json" in
    *'"functions"'*)
      printf 'driver-resolver: ERROR: driver '\''%s'\'' declares a record function family, which contract 3 does not carry (ERR_DRIVER_PROTOCOL)\n' "$driver_name" >&2
      return 2
      ;;
  esac
  cap_store=$(printf '%s\n' "$cap_json" | desc_field store | tr '\n' ' ')
  if [ -z "$cap_store" ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares no store family; contract 3 serves the store alone (ERR_DRIVER_PROTOCOL)\n' "$driver_name" >&2
    return 2
  fi
  if [ "$cap_store" != "$STORE_FUNCTIONS " ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares the store family '\''%s'\'', not the seven data names in the fixed order (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$cap_store" >&2
    return 2
  fi
  cap_modes=$(printf '%s\n' "$cap_json" | desc_field search_modes | tr '\n' ' ' | sed 's/[[:space:]]*$//')
  case " $cap_modes " in
    *" exact "*) ;;
    *) printf 'driver-resolver: ERROR: driver '\''%s'\'' declares no exact search mode among [%s] (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$cap_modes" >&2; return 2 ;;
  esac

  # the optional tokens stay inside the card: store (implied by the family), store.changelog
  # where the driver keeps a change log, and search.schema where it consumes a declared
  # search schema; any other token refuses
  cap_opt=" $(printf '%s\n' "$cap_json" | desc_field optional | tr '\n' ' ') "
  for cap_o in $cap_opt; do
    case "$cap_o" in
      store|store.changelog|search.schema) ;;
      *) printf 'driver-resolver: ERROR: driver '\''%s'\'' declares optional capability '\''%s'\'' outside store, store.changelog, search.schema (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$cap_o" >&2; return 2 ;;
    esac
  done

  printf '%s\n' "$cap_json"
  return 0
}

# the seven store data names of contract 3's card, in the descriptor's fixed order
STORE_FUNCTIONS="list get put delete changes batch scan"

# desc_field <key>: the value of one descriptor key on stdin: a string, or each element of
# a list of strings on its own line (the descriptor is one compact JSON object; a legacy
# pretty-printed descriptor reads the same)
desc_field() {
  DF_KEY="$1" awk '
    { t = t $0 "\n" }
    END {
      k = "\"" ENVIRON["DF_KEY"] "\""
      p = index(t, k)
      if (p == 0) exit 0
      r = substr(t, p + length(k))
      sub(/^[ \t\r\n]*:[ \t\r\n]*/, "", r)
      if (substr(r, 1, 1) == "[") {
        e = index(r, "]")
        r = substr(r, 2, e - 2)
        while (match(r, /"[^"]*"/)) { print substr(r, RSTART + 1, RLENGTH - 2); r = substr(r, RSTART + RLENGTH) }
      } else if (substr(r, 1, 1) == "\"") {
        r = substr(r, 2)
        print substr(r, 1, index(r, "\"") - 1)
      }
    }'
}

# verdict_fresh <verdict file> <driver path>: a cached verdict stands while it is strictly
# newer than the driver and, when the workspace carries one, than its configuration (a
# driver that reads configuration is verified again after the configuration changes)
verdict_fresh() {
  [ -f "$1" ] && [ "$1" -nt "$2" ] || return 1
  if [ -f "$CTX_DIR/config" ] && [ ! "$1" -nt "$CTX_DIR/config" ]; then return 1; fi
  return 0
}

# The handshake at dispatch: a driver other than the bundled core posix driver proves its
# descriptor (contract 3, the seven store data names, exact, and the optional token
# agreement) before it serves any function, and a driver that fails halts the call rc 2
# ERR_DRIVER_PROTOCOL with the gap named; a record-only driver refuses because the card is
# store-only. The
# verdict is cached in the scratch drawer, one file per driver path, valid while fresh
# (verdict_fresh), so the handshake runs once per driver change, never once per call; a
# driver changed in the second of its verdict is verified again until a later verdict
# stands. An unwritable drawer caches nothing, verifies on every call, and adds nothing to
# stderr. The handshake reads /dev/null, never the payload on stdin.
handshake_at_dispatch() {
  hd_path="$1"
  hd_name="$2"
  [ "$hd_path" = "$CTX_DIR/storage/drivers/posix/driver" ] && return 0
  hd_key=""
  hd_rest=$hd_path
  while :; do
    case "$hd_rest" in
      */*) hd_key="${hd_key}${hd_rest%%/*}_"; hd_rest=${hd_rest#*/} ;;
      *) hd_key="$hd_key$hd_rest"; break ;;
    esac
  done
  hd_dir="$CTX_DIR/tmp/driver-verdicts"
  hd_file="$hd_dir/$hd_key"
  if verdict_fresh "$hd_file" "$hd_path"; then
    return 0
  fi
  verify_capabilities "$hd_path" "$hd_name" >/dev/null </dev/null || return 2
  if mkdir -p "$hd_dir" 2>/dev/null; then
    hd_tmp="$hd_file.$$"
    if { printf 'verified %s\n' "$hd_path" > "$hd_tmp"; } 2>/dev/null; then
      mv -f "$hd_tmp" "$hd_file" 2>/dev/null || rm -f "$hd_tmp"
    fi
  fi
  return 0
}

# The optional capabilities (store, store.changelog, search.schema) and the search modes
# stay outside the dispatch handshake; the store family's array implies the store capability
# even when the token is omitted, and a caller that needs one asks the resolver first (a
# search mode reads search.mode.<m>):
#   require <capability>...  rc 0 when the configured driver declares every one; rc 2
#                            ERR_CAPABILITY_UNSUPPORTED naming the missing ones otherwise
#   has <capability>         rc 0 declared, rc 1 not declared, no message
# The bundled posix driver answers from its descriptor like any other driver. A passing
# verdict is cached in the scratch drawer, one file per driver path and capability set
# (sorted, so the order of the arguments never matters; has reads it and writes none), its name apart from the dispatch
# verdict of the same driver (which it never answers or overwrites), valid while fresh (the
# rule of handshake_at_dispatch); a missing capability is never cached, and an unwritable
# drawer caches nothing and adds nothing to stderr. The descriptor is read with stdin from
# /dev/null.
cap_token_valid() {
  case "$1" in
    ""|[!a-z]*|*[!a-z0-9._]*) return 1 ;;
  esac
  return 0
}

# driver_caps: the capabilities a descriptor on stdin declares, one per line: its optional
# capabilities, then the store capability the store family implies, then each search mode
# as search.mode.<m>
driver_caps() {
  dc_json=$(cat)
  dc_opt=$(printf '%s\n' "$dc_json" | desc_field optional)
  printf '%s\n' "$dc_opt"
  dc_store=$(printf '%s\n' "$dc_json" | desc_field store)
  case " $(printf '%s\n' "$dc_opt" | tr '\n' ' ') " in
    *" store "*) ;;
    *) [ -n "$dc_store" ] && printf 'store\n' ;;
  esac
  printf '%s\n' "$dc_json" | desc_field search_modes | sed 's/^/search.mode./'
}

# require_caps <quiet 0|1> <driver path> <driver name> <capability>...: rc 0 all declared,
# 3 some missing (named on stderr unless quiet), 2 the driver cannot answer its descriptor
require_caps() {
  rq_quiet=$1; rq_path=$2; rq_name=$3
  shift 3
  rq_set=$(printf '%s\n' "$@" | LC_ALL=C sort -u)
  rq_tag=$(printf '%s\n' "$rq_set" | tr '\n' '+')
  rq_tag=${rq_tag%+}
  rq_key=""
  rq_rest=$rq_path
  while :; do
    case "$rq_rest" in
      */*) rq_key="${rq_key}${rq_rest%%/*}_"; rq_rest=${rq_rest#*/} ;;
      *) rq_key="$rq_key$rq_rest"; break ;;
    esac
  done
  rq_dir="$CTX_DIR/tmp/driver-verdicts"
  rq_file="$rq_dir/$rq_key.require.$rq_tag"
  if verdict_fresh "$rq_file" "$rq_path"; then
    return 0
  fi
  if [ ! -x "$rq_path" ]; then
    printf 'driver-resolver: ERROR: driver executable '\''%s'\'' not found or not executable (ERR_DRIVER_NOT_FOUND)\n' "$rq_path" >&2
    return 2
  fi
  cap_prep
  rq_json=$("$rq_path" capability 2>"${CAP_ERR_FILE:-/dev/null}" </dev/null)
  rq_rc=$?
  [ "$rq_rc" -eq 0 ] && cap_done
  if [ "$rq_rc" -ne 0 ]; then
    cap_refused "$rq_name" "$rq_rc"
    return 2
  fi
  rq_have=$(printf '%s\n' "$rq_json" | driver_caps)
  rq_missing=""
  for rq_c in $rq_set; do
    printf '%s\n' "$rq_have" | grep -qxF -- "$rq_c" || rq_missing="$rq_missing $rq_c"
  done
  if [ -n "$rq_missing" ]; then
    [ "$rq_quiet" -eq 1 ] || printf 'driver-resolver: ERROR: driver '\''%s'\'' lacks capability:%s (ERR_CAPABILITY_UNSUPPORTED)\n' "$rq_name" "$rq_missing" >&2
    return 3
  fi
  # has is a probe: it reads a require verdict but never writes one, so the verdicts name
  # exactly the capability sets callers required
  [ "$rq_quiet" -eq 1 ] && return 0
  if mkdir -p "$rq_dir" 2>/dev/null; then
    rq_tmp="$rq_file.$$"
    if { printf 'declares %s: %s\n' "$rq_path" "$rq_tag" > "$rq_tmp"; } 2>/dev/null; then
      mv -f "$rq_tmp" "$rq_file" 2>/dev/null || rm -f "$rq_tmp"
    fi
  fi
  return 0
}

# Main entry point
CTX_DIR=$(find_ctx_dir) || {
  printf 'driver-resolver: ERROR: could not locate .contexture root directory\n' >&2
  exit 2
}

CLI_DRIVER=""
COMMAND=""

while [ $# -gt 0 ]; do
  case "$1" in
    --driver=*)
      CLI_DRIVER="${1#--driver=}"
      shift
      ;;
    -d)
      shift
      [ $# -gt 0 ] || { printf 'driver-resolver: ERROR: -d requires driver name (ERR_INVALID_ARGUMENT)\n' >&2; exit 1; }
      CLI_DRIVER="$1"
      shift
      ;;
    --help|-h|help)
      printf 'usage: driver-resolver [options] [command] [args...]\n'
      printf 'commands:\n'
      printf '  resolve [name]                    print resolved driver executable path\n'
      printf '  capability [name]                 validate capability handshake and print capabilities\n'
      printf '  check [name]                      verify resolution and capabilities\n'
      printf '  require <capability>...           rc 0 when the driver declares every one, rc 2 naming the missing\n'
      printf '  has <capability>                  rc 0 declared, rc 1 not declared, no message\n'
      printf '  exec <subsystem>.<method> [args]  dispatch call to active driver (stdin passes through)\n'
      printf '  <subsystem>.<method> [args]       direct dispatch form\n'
      printf 'options:\n'
      printf '  --driver=<name>, -d <name>        explicit driver override\n'
      exit 0
      ;;
    *)
      COMMAND="$1"
      shift
      break
      ;;
  esac
done

TARGET_DRIVER=$(determine_driver_name "$CTX_DIR" "$CLI_DRIVER")

# contract 3: no backend delegates to another, so the resolver exports no reference
# driver (the v0.54.0 CTX_REFERENCE_DRIVER retired with the delegate design)

case "$COMMAND" in
  ""|resolve|--resolve)
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER")
    rc=$?
    if [ "$rc" -eq 0 ]; then
      printf '%s\n' "$DRIVER_PATH"
      exit 0
    fi
    exit "$rc"
    ;;

  capability|--capability|capabilities|--capabilities)
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    verify_capabilities "$DRIVER_PATH" "$TARGET_DRIVER"
    exit $?
    ;;

  check|verify)
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    verify_capabilities "$DRIVER_PATH" "$TARGET_DRIVER" >/dev/null || exit 2
    printf 'OK: storage driver '\''%s'\'' verified at %s\n' "$TARGET_DRIVER" "$DRIVER_PATH"
    exit 0
    ;;

  require|has)
    if [ $# -eq 0 ] || { [ "$COMMAND" = has ] && [ $# -ne 1 ]; }; then
      if [ "$COMMAND" = has ]; then
        printf 'driver-resolver: ERROR: has takes exactly one capability (ERR_INVALID_ARGUMENT)\n' >&2
      else
        printf 'driver-resolver: ERROR: require takes one or more capabilities (ERR_INVALID_ARGUMENT)\n' >&2
      fi
      exit 1
    fi
    for rq_arg in "$@"; do
      cap_token_valid "$rq_arg" || {
        printf 'driver-resolver: ERROR: malformed capability '\''%s'\'' (ERR_INVALID_ARGUMENT)\n' "$rq_arg" >&2
        exit 1
      }
    done
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    rq_q=0
    [ "$COMMAND" = has ] && rq_q=1
    require_caps "$rq_q" "$DRIVER_PATH" "$TARGET_DRIVER" "$@"
    rq_rc=$?
    case "$rq_rc" in
      0) exit 0 ;;
      3) [ "$COMMAND" = has ] && exit 1; exit 2 ;;
      *) exit 2 ;;
    esac
    ;;

  exec|dispatch)
    [ $# -gt 0 ] || {
      printf 'driver-resolver: ERROR: exec requires <subsystem>.<method> argument (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    }
    METHOD="$1"
    shift
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    if [ ! -x "$DRIVER_PATH" ]; then
      printf 'driver-resolver: ERROR: driver '\''%s'\'' executable not found at %s (ERR_DRIVER_NOT_FOUND)\n' "$TARGET_DRIVER" "$DRIVER_PATH" >&2
      exit 2
    fi
    handshake_at_dispatch "$DRIVER_PATH" "$TARGET_DRIVER" || exit 2
    exec "$DRIVER_PATH" "$METHOD" "$@"
    ;;

  *.*)
    METHOD="$COMMAND"
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    if [ ! -x "$DRIVER_PATH" ]; then
      printf 'driver-resolver: ERROR: driver '\''%s'\'' executable not found at %s (ERR_DRIVER_NOT_FOUND)\n' "$TARGET_DRIVER" "$DRIVER_PATH" >&2
      exit 2
    fi
    handshake_at_dispatch "$DRIVER_PATH" "$TARGET_DRIVER" || exit 2
    exec "$DRIVER_PATH" "$METHOD" "$@"
    ;;

  *)
    if [ $# -eq 0 ]; then
      TARGET_DRIVER="$COMMAND"
      DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER")
      rc=$?
      if [ "$rc" -eq 0 ]; then
        printf '%s\n' "$DRIVER_PATH"
        exit 0
      fi
      exit "$rc"
    fi
    printf 'driver-resolver: ERROR: unknown command or invalid method: '\''%s'\'' (ERR_INVALID_ARGUMENT)\n' "$COMMAND" >&2
    exit 1
    ;;
esac
