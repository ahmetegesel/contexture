#!/bin/sh
# driver-resolver: the storage core's driver resolver: it resolves storage drivers,
# validates capability handshakes, and dispatches storage operations for every module
# over the generic module store (the record through the unit module's data script, the
# corpus through the docs module). The core's posix driver sits beside this script under
# storage/drivers; the session module's compatibility wrapper retired with the unit
# module, so every caller reaches the one resolver here directly.
#
# Standardized exit codes:
#   0: success
#   1: semantic or validation error (ERR_INVALID_ARGUMENT)
#   2: storage or driver error (ERR_DRIVER_NOT_FOUND, ERR_CAPABILITY_UNSUPPORTED, ERR_DRIVER_PROTOCOL)

set -u

# Locate .contexture root directory
find_ctx_dir() {
  if [ -n "${CTX_DIR:-}" ] && [ -d "$CTX_DIR" ]; then
    printf '%s\n' "$CTX_DIR"
    return 0
  fi
  if [ -n "${CTX_ROOT:-}" ] && [ -d "$CTX_ROOT/.contexture" ]; then
    printf '%s/.contexture\n' "$CTX_ROOT"
    return 0
  fi
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s/.contexture\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  sdir=$(CDPATH="" cd "$(dirname "$0")" 2>/dev/null && pwd)
  curr="$sdir"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s/.contexture\n' "$curr"
      return 0
    elif [ "$(basename "$curr")" = ".contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  if [ -d ".contexture" ]; then
    printf '%s/.contexture\n' "$PWD"
    return 0
  fi
  return 1
}

# conf_strip <value>: CS_OUT, the value without its blanks, tabs, carriage returns, and quotes
CS_CR=$(printf '\r')
conf_strip() {
  cs_in=$1
  CS_OUT=""
  while [ -n "$cs_in" ]; do
    cs_c=${cs_in%"${cs_in#?}"}
    cs_in=${cs_in#?}
    case "$cs_c" in
      ' '|'	'|'"'|"'"|"$CS_CR") ;;
      *) CS_OUT=$CS_OUT$cs_c ;;
    esac
  done
}

# Read storage.driver from .contexture/config, then fallback to .contexture/storage.conf
read_conf_driver() {
  ctx_dir="$1"
  rcd_lib=""
  for rcd_c in "$ctx_dir/config-lib" "$ctx_dir/../base/.contexture/config-lib"; do
    if [ -f "$rcd_c" ]; then
      rcd_lib="$rcd_c"
      break
    fi
  done
  if [ -n "$rcd_lib" ]; then
    . "$rcd_lib"
    for rcd_conf in "$ctx_dir/config" "$ctx_dir/storage.conf"; do
      [ -f "$rcd_conf" ] || continue
      for rcd_key in storage.driver session.storage.driver; do
        rcd_val=$(cfg_get_file "$rcd_conf" "$rcd_key" 2>/dev/null) && [ -n "$rcd_val" ] && {
          printf '%s\n' "$rcd_val"
          return 0
        }
      done
    done
    return 1
  fi

  # Safe inline fallback when config-lib is absent
  for rcd_conf in "$ctx_dir/config" "$ctx_dir/storage.conf"; do
    [ -f "$rcd_conf" ] || continue
    for rcd_key in storage.driver session.storage.driver; do
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line%"$CS_CR"}
        case "$line" in
          ""|\#*) continue ;;
          *[:=]*)
            rcd_k=${line%%[:=]*}
            conf_strip "$rcd_k"
            [ "$CS_OUT" = "$rcd_key" ] || continue
            val=${line#"$rcd_k"}
            val=${val#?}
            val=${val%%#*}
            conf_strip "$val"
            val=$CS_OUT
            if [ -n "$val" ]; then
              printf '%s\n' "$val"
              return 0
            fi
            ;;
        esac
      done < "$rcd_conf"
    done
  done
  return 1
}

# Locate driver executable: the storage core's drivers first, then the extension root's
# package drivers, then the transitional locations (workspace drivers, module-owned
# drivers, the base mirror, PATH). The core drivers and the extension root are the
# settled end shape; the module tree carries the fts5 driver until the module system
# moves it to the extension root.
find_driver_executable() {
  ctx_dir="$1"
  driver="$2"

  case "$driver" in
    */*)
      if [ -x "$driver" ]; then
        printf '%s\n' "$driver"
        return 0
      fi
      ;;
  esac

  # Tier 1: Workspace custom drivers (transitional)
  if [ -x "$ctx_dir/drivers/$driver/driver" ]; then
    printf '%s/drivers/%s/driver\n' "$ctx_dir" "$driver"
    return 0
  fi
  if [ -f "$ctx_dir/drivers/$driver" ] && [ -x "$ctx_dir/drivers/$driver" ]; then
    printf '%s/drivers/%s\n' "$ctx_dir" "$driver"
    return 0
  fi

  # Tier 2: The storage core's drivers
  if [ -x "$ctx_dir/storage/drivers/$driver/driver" ]; then
    printf '%s/storage/drivers/%s/driver\n' "$ctx_dir" "$driver"
    return 0
  fi
  if [ -f "$ctx_dir/storage/drivers/$driver" ] && [ -x "$ctx_dir/storage/drivers/$driver" ]; then
    printf '%s/storage/drivers/%s\n' "$ctx_dir" "$driver"
    return 0
  fi

  # Tier 3: The extension root's package drivers (the settled home of a package's
  # driver; the core's drivers above stay beside it, the transitional tiers below)
  if [ -x "$ctx_dir/extensions/storage/drivers/$driver/driver" ]; then
    printf '%s/extensions/storage/drivers/%s/driver\n' "$ctx_dir" "$driver"
    return 0
  fi
  if [ -f "$ctx_dir/extensions/storage/drivers/$driver" ] && [ -x "$ctx_dir/extensions/storage/drivers/$driver" ]; then
    printf '%s/extensions/storage/drivers/%s\n' "$ctx_dir" "$driver"
    return 0
  fi

  # Tier 4: Module-owned drivers (transitional; the fts5 driver lives here until the
  # module system moves it to the extension root)
  for mod_dir in "$ctx_dir"/modules/*; do
    [ -d "$mod_dir" ] || continue
    if [ -x "$mod_dir/drivers/$driver/driver" ]; then
      printf '%s/drivers/%s/driver\n' "$mod_dir" "$driver"
      return 0
    fi
    if [ -f "$mod_dir/drivers/$driver" ] && [ -x "$mod_dir/drivers/$driver" ]; then
      printf '%s/drivers/%s\n' "$mod_dir" "$driver"
      return 0
    fi
  done

  # Tier 5: Base mirror fallback (transitional)
  base_ctx="$ctx_dir/../base/.contexture"
  if [ -d "$base_ctx" ]; then
    if [ -x "$base_ctx/storage/drivers/$driver/driver" ]; then
      printf '%s/storage/drivers/%s/driver\n' "$base_ctx" "$driver"
      return 0
    fi
    if [ -x "$base_ctx/extensions/storage/drivers/$driver/driver" ]; then
      printf '%s/extensions/storage/drivers/%s/driver\n' "$base_ctx" "$driver"
      return 0
    fi
    for mod_dir in "$base_ctx"/modules/*; do
      [ -d "$mod_dir" ] || continue
      if [ -x "$mod_dir/drivers/$driver/driver" ]; then
        printf '%s/drivers/%s/driver\n' "$mod_dir" "$driver"
        return 0
      fi
      if [ -f "$mod_dir/drivers/$driver" ] && [ -x "$mod_dir/drivers/$driver" ]; then
        printf '%s/drivers/%s\n' "$mod_dir" "$driver"
        return 0
      fi
    done
  fi

  # Tier 6: External binary on PATH (transitional)
  if command -v "ctx-storage-$driver" >/dev/null 2>&1; then
    command -v "ctx-storage-$driver"
    return 0
  fi

  return 1
}

# Determine configured driver name honoring precedence
determine_driver_name() {
  ctx_dir="$1"
  override_driver="${2:-}"

  if [ -n "$override_driver" ]; then
    printf '%s\n' "$override_driver"
    return 0
  fi

  if [ -n "${CTX_STORAGE_DRIVER:-}" ]; then
    printf '%s\n' "$CTX_STORAGE_DRIVER"
    return 0
  fi

  conf_driver=$(read_conf_driver "$ctx_dir" 2>/dev/null) || conf_driver=""
  if [ -n "$conf_driver" ]; then
    printf '%s\n' "$conf_driver"
    return 0
  fi

  printf 'posix\n'
  return 0
}

# Resolve target driver path
resolve_target_driver() {
  ctx_dir="$1"
  target_name="$2"

  resolved_path=$(find_driver_executable "$ctx_dir" "$target_name") || resolved_path=""

  if [ -n "$resolved_path" ] && [ -x "$resolved_path" ]; then
    printf '%s\n' "$resolved_path"
    return 0
  fi

  # Canonical default path for the core posix baseline driver
  if [ "$target_name" = "posix" ]; then
    printf '%s/storage/drivers/posix/driver\n' "$ctx_dir"
    return 0
  fi

  printf 'driver-resolver: ERROR: storage driver '\''%s'\'' not found in the core drivers, the extension drivers, workspace drivers, module drivers, or PATH (ERR_DRIVER_NOT_FOUND)\n' "$target_name" >&2
  return 2
}

# cap_prep: CAP_ERR_FILE, a scratch file of the drawer that takes the driver's stderr at the
# handshake (removed by cap_refused or cap_done); empty when the drawer cannot be written,
# and the stderr is then set aside as before
cap_prep() {
  CAP_ERR_FILE=""
  mkdir -p "$CTX_DIR/tmp" 2>/dev/null && CAP_ERR_FILE=$(mktemp "$CTX_DIR/tmp/cap-err.XXXXXX" 2>/dev/null) || CAP_ERR_FILE=""
}
cap_done() { [ -n "${CAP_ERR_FILE:-}" ] && rm -f "$CAP_ERR_FILE"; CAP_ERR_FILE=""; return 0; }

# cap_refused <driver name> <rc>: the handshake's refusal, one line: the driver's own refusal
# line when it printed one (it names what failed; its code ends the line), else the
# handshake's ERR_DRIVER_PROTOCOL line
cap_refused() {
  cr_line=""
  if [ -n "${CAP_ERR_FILE:-}" ]; then
    cr_line=$(head -n 1 "$CAP_ERR_FILE" 2>/dev/null)
    cap_done
  fi
  if [ -n "$cr_line" ]; then
    printf 'driver-resolver: ERROR: capability handshake failed for driver '\''%s'\'': %s\n' "$1" "$cr_line" >&2
  else
    printf 'driver-resolver: ERROR: capability handshake failed for driver '\''%s'\'' with exit code %d (ERR_DRIVER_PROTOCOL)\n' "$1" "$2" >&2
  fi
}

# Validate capability handshake
verify_capabilities() {
  driver_exec="$1"
  driver_name="$2"

  if [ ! -x "$driver_exec" ]; then
    printf 'driver-resolver: ERROR: driver executable '\''%s'\'' not found or not executable (ERR_DRIVER_NOT_FOUND)\n' "$driver_exec" >&2
    return 2
  fi

  cap_prep
  cap_json=$("$driver_exec" capability 2>"${CAP_ERR_FILE:-/dev/null}" </dev/null)
  cap_rc=$?
  [ "$cap_rc" -eq 0 ] && cap_done

  if [ "$cap_rc" -ne 0 ]; then
    cap_refused "$driver_name" "$cap_rc"
    return 2
  fi

  # contract 4 (docs/the-engine.md, The descriptor and the handshake): the store-only card
  # that describes posix exactly: contract 4, the six data names in the fixed order, the
  # exact search mode alone, and the optional token agreement. The card carries no record
  # function family: capability and storage.health are the driver's own methods, never
  # descriptor families, and a record-only driver refuses; the version stays unchecked
  check_result=$(printf '%s\n' "$cap_json" | desc_field contract)
  if [ "$check_result" != 4 ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares contract '\''%s'\'', not 4 (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$check_result" >&2
    return 2
  fi
  case "$cap_json" in
    *'"functions"'*)
      printf 'driver-resolver: ERROR: driver '\''%s'\'' declares a record function family, which contract 4 does not carry (ERR_DRIVER_PROTOCOL)\n' "$driver_name" >&2
      return 2
      ;;
  esac
  cap_store=$(printf '%s\n' "$cap_json" | desc_field store | tr '\n' ' ')
  if [ -z "$cap_store" ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares no store family; contract 4 serves the store family alone (ERR_DRIVER_PROTOCOL)\n' "$driver_name" >&2
    return 2
  fi
  if [ "$cap_store" != "$STORE_FUNCTIONS " ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares the store family '\''%s'\'', not the six data names in the fixed order (%s) (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$cap_store" "$STORE_FUNCTIONS" >&2
    return 2
  fi
  if ! cap_pairs=$(printf '%s\n' "$cap_json" | desc_modes); then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares search_modes that are not a list of name and description objects (ERR_DRIVER_PROTOCOL)\n' "$driver_name" >&2
    return 2
  fi
  cap_modes=$(printf '%s\n' "$cap_pairs" | cut -f 1 | tr '\n' ' ' | sed 's/[[:space:]]*$//')
  if [ "$cap_modes" != exact ]; then
    printf 'driver-resolver: ERROR: driver '\''%s'\'' declares the search modes [%s], not the exact mode alone (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$cap_modes" >&2
    return 2
  fi

  # the optional tokens stay inside the card: store (implied by the family) and
  # store.promote where the driver moves a key prefix from a declared fallback root to the
  # root; any other token refuses
  cap_opt=" $(printf '%s\n' "$cap_json" | desc_field optional | tr '\n' ' ') "
  for cap_o in $cap_opt; do
    case "$cap_o" in
      store|store.promote) ;;
      *) printf 'driver-resolver: ERROR: driver '\''%s'\'' declares optional capability '\''%s'\'' outside store, store.promote (ERR_DRIVER_PROTOCOL)\n' "$driver_name" "$cap_o" >&2; return 2 ;;
    esac
  done

  printf '%s\n' "$cap_json"
  return 0
}

# the six store data names of contract 4's card, in the descriptor's fixed order
STORE_FUNCTIONS="list get put delete batch scan"

# desc_field <key>: the value of one descriptor key on stdin: a string, or each element of
# a list of strings on its own line (the descriptor is one compact JSON object; a legacy
# pretty-printed descriptor reads the same)
desc_field() {
  DF_KEY="$1" awk '
    { t = t $0 "\n" }
    END {
      k = "\"" ENVIRON["DF_KEY"] "\""
      p = index(t, k)
      if (p == 0) exit 0
      r = substr(t, p + length(k))
      sub(/^[ \t\r\n]*:[ \t\r\n]*/, "", r)
      if (substr(r, 1, 1) == "[") {
        e = index(r, "]")
        r = substr(r, 2, e - 2)
        while (match(r, /"[^"]*"/)) { print substr(r, RSTART + 1, RLENGTH - 2); r = substr(r, RSTART + RLENGTH) }
      } else if (substr(r, 1, 1) == "\"") {
        r = substr(r, 2)
        print substr(r, 1, index(r, "\"") - 1)
      }
    }'
}

# desc_modes: the search mode registry of a descriptor on stdin, one name TAB description
# line per mode in the card's order. search_modes is a list of objects, each carrying a name
# (a lowercase token) and a one-line description; the reader walks the JSON strings
# themselves, so a description holding a bracket, a brace, a comma, or an escaped quote
# reads whole, and a tab or newline escape inside one reads as a blank. A card without the
# key answers nothing rc 0; an element that is not such an object answers rc 1.
desc_modes() {
  LC_ALL=C awk '
    { t = t $0 "\n" }
    function ws() { while (i <= n && index(" \t\r\n", substr(t, i, 1))) i++ }
    function str(   o, c, e) {
      if (substr(t, i, 1) != "\"") { bad = 1; return "" }
      i++; o = ""
      while (i <= n) {
        c = substr(t, i, 1)
        if (c == "\"") { i++; return o }
        if (c == "\\") {
          e = substr(t, i + 1, 1); i += 2
          if (e == "n" || e == "t" || e == "r") o = o " "
          else if (e == "u") { o = o "?"; i += 4 }
          else o = o e
          continue
        }
        o = o c; i++
      }
      bad = 1; return ""
    }
    END {
      n = length(t)
      k = "\"search_modes\""
      p = index(t, k)
      if (p == 0) exit 0
      i = p + length(k); ws()
      if (substr(t, i, 1) != ":") exit 1
      i++; ws()
      if (substr(t, i, 1) != "[") exit 1
      i++; ws()
      if (substr(t, i, 1) == "]") exit 0
      while (i <= n) {
        ws()
        if (substr(t, i, 1) != "{") exit 1
        i++; name = ""; desc = ""; hasn = 0; hasd = 0
        while (1) {
          ws()
          if (substr(t, i, 1) == "}") { i++; break }
          key = str(); if (bad) exit 1
          ws(); if (substr(t, i, 1) != ":") exit 1
          i++; ws()
          val = str(); if (bad) exit 1
          if (key == "name") { name = val; hasn = 1 }
          else if (key == "description") { desc = val; hasd = 1 }
          ws()
          if (substr(t, i, 1) == ",") { i++; continue }
          if (substr(t, i, 1) == "}") { i++; break }
          exit 1
        }
        if (!hasn || !hasd || name !~ /^[a-z][a-z0-9_-]*$/ || desc == "") exit 1
        out = out name "\t" desc "\n"
        ws()
        if (substr(t, i, 1) == ",") { i++; continue }
        if (substr(t, i, 1) == "]") { printf "%s", out; exit 0 }
        exit 1
      }
      exit 1
    }'
}

# verdict_fresh <verdict file> <driver path>: a cached verdict stands while the driver
# exists and the verdict is strictly newer than it, than this resolver (a core update, whose
# copy stamps the resolver anew, verifies every driver against the new contract), and, when
# the workspace carries one, than its configuration (a driver that reads configuration is
# verified again after the configuration changes). Each file's existence is tested on its
# own, since a bash or ksh sh reads -nt as true against a missing file where dash and zsh
# read false
verdict_fresh() {
  [ -f "$1" ] && [ -f "$2" ] && [ "$1" -nt "$2" ] || return 1
  if [ -f "$0" ] && [ ! "$1" -nt "$0" ]; then return 1; fi
  if [ -f "$CTX_DIR/config" ] && [ ! "$1" -nt "$CTX_DIR/config" ]; then return 1; fi
  return 0
}

# The handshake at dispatch: a driver other than the bundled core posix driver proves its
# descriptor (contract 4, the six store data names, exact alone, and the optional token
# agreement) before it serves any function, and a driver that fails halts the call rc 2
# ERR_DRIVER_PROTOCOL with the gap named; a record-only driver refuses because the card is
# store-only. The
# verdict is cached in the scratch drawer, one file per driver path, valid while fresh
# (verdict_fresh), so the handshake runs once per driver change, never once per call; a
# driver changed in the second of its verdict is verified again until a later verdict
# stands. An unwritable drawer caches nothing, verifies on every call, and adds nothing to
# stderr. The handshake reads /dev/null, never the payload on stdin.
handshake_at_dispatch() {
  hd_path="$1"
  hd_name="$2"
  [ "$hd_path" = "$CTX_DIR/storage/drivers/posix/driver" ] && return 0
  hd_key=""
  hd_rest=$hd_path
  while :; do
    case "$hd_rest" in
      */*) hd_key="${hd_key}${hd_rest%%/*}_"; hd_rest=${hd_rest#*/} ;;
      *) hd_key="$hd_key$hd_rest"; break ;;
    esac
  done
  hd_dir="$CTX_DIR/tmp/driver-verdicts"
  hd_file="$hd_dir/$hd_key"
  if verdict_fresh "$hd_file" "$hd_path"; then
    return 0
  fi
  verify_capabilities "$hd_path" "$hd_name" >/dev/null </dev/null || return 2
  if mkdir -p "$hd_dir" 2>/dev/null; then
    hd_tmp="$hd_file.$$"
    if { printf 'verified %s\n' "$hd_path" > "$hd_tmp"; } 2>/dev/null; then
      mv -f "$hd_tmp" "$hd_file" 2>/dev/null || rm -f "$hd_tmp"
    fi
  fi
  return 0
}

# The optional capabilities (store, store.promote) and the search mode stay outside the
# dispatch handshake; the store family's array implies the
# store capability even when the token is omitted, and a caller that needs one asks the
# resolver first (a search mode reads search.mode.<m>):
#   require <capability>...  rc 0 when the configured driver declares every one; rc 2
#                            ERR_CAPABILITY_UNSUPPORTED naming the missing ones otherwise
#   has <capability>         rc 0 declared, rc 1 not declared, no message
# The bundled posix driver answers from its descriptor like any other driver. A passing
# verdict is cached in the scratch drawer, one file per driver path and capability set
# (sorted, so the order of the arguments never matters; has reads it and writes none), its name apart from the dispatch
# verdict of the same driver (which it never answers or overwrites), valid while fresh (the
# rule of handshake_at_dispatch); a missing capability is never cached, and an unwritable
# drawer caches nothing and adds nothing to stderr. The descriptor is read with stdin from
# /dev/null.
cap_token_valid() {
  case "$1" in
    ""|[!a-z]*|*[!a-z0-9._]*) return 1 ;;
  esac
  return 0
}

# driver_caps: the capabilities a descriptor on stdin declares, one per line: its optional
# capabilities, then the store capability the store family implies, then each registered
# search mode's name as search.mode.<m>
driver_caps() {
  dc_json=$(cat)
  dc_opt=$(printf '%s\n' "$dc_json" | desc_field optional)
  printf '%s\n' "$dc_opt"
  dc_store=$(printf '%s\n' "$dc_json" | desc_field store)
  case " $(printf '%s\n' "$dc_opt" | tr '\n' ' ') " in
    *" store "*) ;;
    *) [ -n "$dc_store" ] && printf 'store\n' ;;
  esac
  printf '%s\n' "$dc_json" | desc_modes | cut -f 1 | sed '/^$/d; s/^/search.mode./'
}

# require_caps <quiet 0|1> <driver path> <driver name> <capability>...: rc 0 all declared,
# 3 some missing (named on stderr unless quiet), 2 the driver cannot answer its descriptor
require_caps() {
  rq_quiet=$1; rq_path=$2; rq_name=$3
  shift 3
  rq_set=$(printf '%s\n' "$@" | LC_ALL=C sort -u)
  rq_tag=$(printf '%s\n' "$rq_set" | tr '\n' '+')
  rq_tag=${rq_tag%+}
  rq_key=""
  rq_rest=$rq_path
  while :; do
    case "$rq_rest" in
      */*) rq_key="${rq_key}${rq_rest%%/*}_"; rq_rest=${rq_rest#*/} ;;
      *) rq_key="$rq_key$rq_rest"; break ;;
    esac
  done
  rq_dir="$CTX_DIR/tmp/driver-verdicts"
  rq_file="$rq_dir/$rq_key.require.$rq_tag"
  # the driver must be there and executable before any cached verdict answers for it
  if [ ! -x "$rq_path" ]; then
    printf 'driver-resolver: ERROR: driver executable '\''%s'\'' not found or not executable (ERR_DRIVER_NOT_FOUND)\n' "$rq_path" >&2
    return 2
  fi
  if verdict_fresh "$rq_file" "$rq_path"; then
    return 0
  fi
  cap_prep
  rq_json=$("$rq_path" capability 2>"${CAP_ERR_FILE:-/dev/null}" </dev/null)
  rq_rc=$?
  [ "$rq_rc" -eq 0 ] && cap_done
  if [ "$rq_rc" -ne 0 ]; then
    cap_refused "$rq_name" "$rq_rc"
    return 2
  fi
  rq_have=$(printf '%s\n' "$rq_json" | driver_caps)
  rq_missing=""
  for rq_c in $rq_set; do
    printf '%s\n' "$rq_have" | grep -qxF -- "$rq_c" || rq_missing="$rq_missing $rq_c"
  done
  if [ -n "$rq_missing" ]; then
    [ "$rq_quiet" -eq 1 ] || printf 'driver-resolver: ERROR: driver '\''%s'\'' lacks capability:%s (ERR_CAPABILITY_UNSUPPORTED)\n' "$rq_name" "$rq_missing" >&2
    return 3
  fi
  # has is a probe: it reads a require verdict but never writes one, so the verdicts name
  # exactly the capability sets callers required
  [ "$rq_quiet" -eq 1 ] && return 0
  if mkdir -p "$rq_dir" 2>/dev/null; then
    rq_tmp="$rq_file.$$"
    if { printf 'declares %s: %s\n' "$rq_path" "$rq_tag" > "$rq_tmp"; } 2>/dev/null; then
      mv -f "$rq_tmp" "$rq_file" 2>/dev/null || rm -f "$rq_tmp"
    fi
  fi
  return 0
}

# The key and value gate at dispatch: every key and prefix a store function takes and every
# value it writes meets the storage core's one key rule (store-key.awk beside this script)
# before any driver runs, so every caller (a module through the library, a core script) and
# every driver meet one rule. A refusal is the dispatched function's own line, rc 1
# ERR_INVALID_ARGUMENT, a key named with the batch payload escape so the line stays one;
# nothing reaches stdout and no driver runs. The suffix clause reads the namespace's suffix
# and key pattern through store-data when a checked key or prefix has a non final segment,
# and once for every batch; a declaration it cannot read leaves the refusal to the driver.
# A put's and a batch's stdin are staged in the per verb scratch root, else the drawer's
# scratch (the system temp only when the drawer cannot hold it), a batch's without its NUL
# bytes, checked there (a value at most KV_CAP bytes, a batch value's decoded size
# likewise), and handed to the driver as its stdin from the staged file, which kv_handoff
# unlinks before the exec; a hangup, interrupt, or termination before it removes the file.
KV_CAP=16777216
KV_STAGE=""
KV_RULE=""
KV_SFX=""
KV_MULTI=0
KV_NL='
'
case "$0" in */*) KV_HOME=${0%/*} ;; *) KV_HOME=. ;; esac

kv_drop() {
  [ -n "$KV_STAGE" ] && rm -f "$KV_STAGE" 2>/dev/null
  KV_STAGE=""
  return 0
}

kv_fail() {
  printf '%s: error: %s (%s)\n' "$METHOD" "$3" "$2" >&2
  kv_drop
  exit "$1"
}

kv_rule() {
  [ -z "$KV_RULE" ] || return 0
  [ -f "$KV_HOME/store-key.awk" ] && [ -r "$KV_HOME/store-key.awk" ] || kv_fail 2 ERR_STORAGE_READ "the storage core key rule is not installed"
  while IFS= read -r kv_l || [ -n "$kv_l" ]; do
    KV_RULE="$KV_RULE$kv_l$KV_NL"
  done < "$KV_HOME/store-key.awk"
}

# kv_decl <namespace>: KV_SFX and KV_MULTI from the namespace's declaration, read once, from
# the workspace root the drivers find (the walk up from the working folder)
kv_decl() {
  [ -z "${KV_DECL_READ:-}" ] || return 0
  KV_DECL_READ=1
  kd_ws=$PWD
  while [ -n "$kd_ws" ] && [ "$kd_ws" != / ] && [ ! -d "$kd_ws/.contexture" ]; do kd_ws=${kd_ws%/*}; done
  [ -n "$kd_ws" ] && [ "$kd_ws" != / ] || kd_ws=$PWD
  [ -x "$KV_HOME/store-data" ] || return 0
  kd_out=$(CTX_STORE_WORKSPACE="$kd_ws" "$KV_HOME/store-data" "$1" 2>/dev/null </dev/null) || return 0
  kd_rest=${kd_out#*"$KV_NL"}
  kd_rest=${kd_rest#*"$KV_NL"}
  KV_SFX=${kd_rest%%"$KV_NL"*}
  kd_rest=${kd_rest#*"$KV_NL"}
  kd_pat=${kd_rest%%"$KV_NL"*}
  case "$kd_pat" in *'...>') KV_MULTI=1 ;; esac
}

# kv_check <key|list|whole> <namespace> <message> <item>...: each item under the rule (a key,
# a list prefix, or a whole segment prefix); the first one outside it refuses with
# <message> '<item>'. Each item rides awk's operands behind one letter, so none reads as an
# option.
kv_check() {
  kc_mode=$1; kc_ns=$2; kc_msg=$3
  shift 3
  kc_n=$#
  kc_slash=0
  for kc_a in "$@"; do
    case "$kc_a" in */*) kc_slash=1 ;; esac
    set -- "$@" "k$kc_a"
  done
  shift "$kc_n"
  kv_rule
  if [ "$kc_slash" -eq 1 ] || [ "$kc_mode" = whole ]; then kv_decl "$kc_ns"; fi
  kc_bad=$(KC_MODE=$kc_mode KC_SFX=$KV_SFX KC_MULTI=$KV_MULTI LC_ALL=C awk "$KV_RULE"'
    BEGIN {
      mode = ENVIRON["KC_MODE"]; sfx = ENVIRON["KC_SFX"]; multi = (ENVIRON["KC_MULTI"] == "1")
      for (a = 1; a < ARGC; a++) {
        s = substr(ARGV[a], 2)
        if (mode == "key") ok = kr_key(s, sfx, multi)
        else if (mode == "list") ok = kr_list_prefix(s, sfx, multi)
        else ok = kr_whole_prefix(s, sfx, multi)
        if (!ok) { printf "%s", kr_esc(s); exit 3 }
      }
      exit 0
    }' "$@")
  case $? in
    0) return 0 ;;
    3) kv_fail 1 ERR_INVALID_ARGUMENT "$kc_msg '$kc_bad'" ;;
    *) kv_fail 2 ERR_STORAGE_READ "the storage core key rule cannot be read" ;;
  esac
}

# kv_stage [wire]: stdin staged in a file of the per verb scratch root, else the drawer's
# scratch; a batch payload (wire) is staged without its NUL bytes, which an awk may cut a
# line at while a shell read drops them, so the gate checks the very lines the driver reads
kv_stage() {
  trap 'kv_drop' EXIT
  trap 'kv_drop; exit 129' HUP
  trap 'kv_drop; exit 130' INT
  trap 'kv_drop; exit 143' TERM
  ks_dir=""
  if [ -n "${CTX_SCRATCH_ROOT:-}" ] && { [ -d "$CTX_SCRATCH_ROOT" ] || mkdir -p "$CTX_SCRATCH_ROOT" 2>/dev/null; } && [ -w "$CTX_SCRATCH_ROOT" ]; then
    ks_dir=$CTX_SCRATCH_ROOT
  elif { [ -d "$CTX_DIR/tmp" ] || mkdir -p "$CTX_DIR/tmp" 2>/dev/null; } && [ -w "$CTX_DIR/tmp" ]; then
    ks_dir=$CTX_DIR/tmp
  else
    ks_dir="${TMPDIR:-/tmp}/contexture-${USER:-}"
    mkdir -p "$ks_dir" 2>/dev/null
  fi
  KV_STAGE=$(mktemp "$ks_dir/store-gate.XXXXXX" 2>/dev/null) || kv_fail 2 ERR_STORAGE_WRITE "cannot stage the payload"
  if [ "${1:-}" = wire ]; then
    { LC_ALL=C tr -d '\000' > "$KV_STAGE"; } 2>/dev/null || kv_fail 2 ERR_STORAGE_WRITE "cannot stage the payload"
  else
    { cat > "$KV_STAGE"; } 2>/dev/null || kv_fail 2 ERR_STORAGE_WRITE "cannot stage the payload"
  fi
}

kv_value() {
  kv_stage
  kv_size=$(wc -c < "$KV_STAGE" 2>/dev/null) || kv_fail 2 ERR_STORAGE_WRITE "cannot stage the payload"
  kv_size=${kv_size##* }
  [ "$kv_size" -le "$KV_CAP" ] || kv_fail 1 ERR_INVALID_ARGUMENT "the value of key '$1' is $kv_size bytes, past the 16 MiB cap ($KV_CAP bytes)"
}

# kv_batch <namespace>: the batch payload staged, then every action's key and decoded value
# size (the trailing padding run aside, so no decoder yields more) checked in action order
# as the driver parses them; a line outside the wire's shape (an unknown or repeated line, a
# line outside an action, an unknown action, an action with no key) ends the check there,
# so the driver names it
kv_batch() {
  kv_stage wire
  kv_rule
  kv_decl "$1"
  kb_bad=$(KC_SFX=$KV_SFX KC_MULTI=$KV_MULTI KC_CAP=$KV_CAP LC_ALL=C awk "$KV_RULE"'
    function unesc(s,   o, i, c, n) {
      o = ""; n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\\") {
          c = substr(s, ++i, 1)
          if (c == "n") c = "\n"; else if (c == "t") c = "\t"; else if (c == "r") c = "\r"
        }
        o = o c
      }
      return o
    }
    function shut(   L, size) {
      if (!open) return
      open = 0; n++
      if (!seen_key || key == "") stop()
      if (!kr_key(key, sfx, multi)) { printf "malformed\t%s\t%s\t%s", n, op, kr_esc(key); rc = 3; exit 3 }
      if (op == "put" && seen_val) {
        L = length(val)
        while (L > 0 && substr(val, L, 1) == "=") L--
        size = int(L * 3 / 4)
        if (size > cap) { printf "cap\t%s\t%s\t%s\t%.0f", n, op, kr_esc(key), size; rc = 3; exit 3 }
      }
    }
    function stop() { stopped = 1; exit 0 }
    BEGIN { sfx = ENVIRON["KC_SFX"]; multi = (ENVIRON["KC_MULTI"] == "1"); cap = ENVIRON["KC_CAP"] + 0 }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line == "") next
      if (substr(line, 1, 7) == "action=") {
        shut()
        op = substr(line, 8)
        if (op != "put" && op != "delete") stop()
        open = 1; key = ""; val = ""; seen_key = seen_val = 0
      } else if (substr(line, 1, 4) == "key=") {
        if (!open || seen_key) stop()
        seen_key = 1; key = unesc(substr(line, 5))
      } else if (substr(line, 1, 10) == "value_b64=") {
        if (!open || seen_val) stop()
        seen_val = 1; val = substr(line, 11)
      } else stop()
    }
    END { if (!stopped && !rc) shut(); exit rc }' "$KV_STAGE")
  case $? in
    0) return 0 ;;
    3) ;;
    *) kv_fail 2 ERR_STORAGE_READ "the storage core key rule cannot be read" ;;
  esac
  kb_kind=${kb_bad%%	*}; kb_bad=${kb_bad#*	}
  kb_n=${kb_bad%%	*}; kb_bad=${kb_bad#*	}
  kb_op=${kb_bad%%	*}; kb_key=${kb_bad#*	}
  printf 'store.batch: error: action %s (%s '\''%s'\''): ' "$kb_n" "$kb_op" "${kb_key%%	*}" >&2
  if [ "$kb_kind" = cap ]; then
    printf 'the value of key '\''%s'\'' is %s bytes, past the 16 MiB cap (%s bytes) (ERR_INVALID_ARGUMENT)\n' "${kb_key%%	*}" "${kb_key#*	}" "$KV_CAP" >&2
  else
    printf 'malformed key '\''%s'\'' (ERR_INVALID_ARGUMENT)\n' "$kb_key" >&2
  fi
  kv_drop
  exit 1
}

# kv_gate <the dispatched function's arguments>: the gate's checks for the dispatched
# function; a function that takes no key, prefix, or value passes untouched, and an argument
# count the driver refuses is left to it
kv_gate() {
  kg_ns=${1:-}
  case "$METHOD" in
    store.get)
      [ $# -ge 2 ] || return 0
      shift
      kv_check key "$kg_ns" "malformed key" "$@"
      ;;
    store.put|store.delete)
      [ $# -ge 2 ] || return 0
      kv_check key "$kg_ns" "malformed key" "$2"
      [ "$METHOD" = store.delete ] || kv_value "$2"
      ;;
    store.list)
      [ $# -ge 2 ] && [ -n "$2" ] || return 0
      kv_check list "$kg_ns" "malformed key prefix" "$2"
      ;;
    store.promote)
      [ $# -ge 2 ] || return 0
      kv_check whole "$kg_ns" "malformed key prefix" "$2"
      ;;
    storage.sweep)
      [ $# -ge 1 ] || return 0
      shift
      for kg_a in "$@"; do
        case "$kg_a" in --prefix=*) kv_check whole "$kg_ns" "malformed key prefix" "${kg_a#--prefix=}" ;; esac
      done
      ;;
    store.batch)
      [ $# -ge 1 ] || return 0
      kv_batch "$kg_ns"
      ;;
  esac
  return 0
}

# kv_handoff: the staged payload becomes the driver's stdin, its file unlinked before the exec
kv_handoff() {
  [ -n "$KV_STAGE" ] || return 0
  [ -r "$KV_STAGE" ] || kv_fail 2 ERR_STORAGE_WRITE "cannot stage the payload"
  exec < "$KV_STAGE"
  rm -f "$KV_STAGE" 2>/dev/null
  KV_STAGE=""
  trap - EXIT HUP INT TERM
}

# Main entry point
CTX_DIR=$(find_ctx_dir) || {
  printf 'driver-resolver: ERROR: could not locate .contexture root directory\n' >&2
  exit 2
}

CLI_DRIVER=""
COMMAND=""

while [ $# -gt 0 ]; do
  case "$1" in
    --driver=*)
      CLI_DRIVER="${1#--driver=}"
      shift
      ;;
    -d)
      shift
      [ $# -gt 0 ] || { printf 'driver-resolver: ERROR: -d requires driver name (ERR_INVALID_ARGUMENT)\n' >&2; exit 1; }
      CLI_DRIVER="$1"
      shift
      ;;
    --help|-h|help)
      printf 'usage: driver-resolver [options] [command] [args...]\n'
      printf 'commands:\n'
      printf '  resolve [name]                    print resolved driver executable path\n'
      printf '  capability [name]                 validate capability handshake and print capabilities\n'
      printf '  check [name]                      verify resolution and capabilities\n'
      printf '  require <capability>...           rc 0 when the driver declares every one, rc 2 naming the missing\n'
      printf '  has <capability>                  rc 0 declared, rc 1 not declared, no message\n'
      printf '  modes [name]                      the search mode registry: one name TAB description line per mode\n'
      printf '  exec <subsystem>.<method> [args]  dispatch call to active driver (stdin passes through)\n'
      printf '  <subsystem>.<method> [args]       direct dispatch form\n'
      printf 'options:\n'
      printf '  --driver=<name>, -d <name>        explicit driver override\n'
      exit 0
      ;;
    *)
      COMMAND="$1"
      shift
      break
      ;;
  esac
done

TARGET_DRIVER=$(determine_driver_name "$CTX_DIR" "$CLI_DRIVER")

# contract 4: no backend delegates to another, so the resolver exports no reference
# driver (the v0.54.0 CTX_REFERENCE_DRIVER retired with the delegate design)

case "$COMMAND" in
  ""|resolve|--resolve)
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER")
    rc=$?
    if [ "$rc" -eq 0 ]; then
      printf '%s\n' "$DRIVER_PATH"
      exit 0
    fi
    exit "$rc"
    ;;

  capability|--capability|capabilities|--capabilities)
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    verify_capabilities "$DRIVER_PATH" "$TARGET_DRIVER"
    exit $?
    ;;

  modes)
    if [ $# -gt 1 ]; then
      printf 'driver-resolver: ERROR: modes takes at most a driver name (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    md_card=$(verify_capabilities "$DRIVER_PATH" "$TARGET_DRIVER" </dev/null) || exit 2
    printf '%s\n' "$md_card" | desc_modes
    exit 0
    ;;

  check|verify)
    if [ $# -gt 0 ]; then
      TARGET_DRIVER="$1"
    fi
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    verify_capabilities "$DRIVER_PATH" "$TARGET_DRIVER" >/dev/null || exit 2
    printf 'OK: storage driver '\''%s'\'' verified at %s\n' "$TARGET_DRIVER" "$DRIVER_PATH"
    exit 0
    ;;

  require|has)
    if [ $# -eq 0 ] || { [ "$COMMAND" = has ] && [ $# -ne 1 ]; }; then
      if [ "$COMMAND" = has ]; then
        printf 'driver-resolver: ERROR: has takes exactly one capability (ERR_INVALID_ARGUMENT)\n' >&2
      else
        printf 'driver-resolver: ERROR: require takes one or more capabilities (ERR_INVALID_ARGUMENT)\n' >&2
      fi
      exit 1
    fi
    for rq_arg in "$@"; do
      cap_token_valid "$rq_arg" || {
        printf 'driver-resolver: ERROR: malformed capability '\''%s'\'' (ERR_INVALID_ARGUMENT)\n' "$rq_arg" >&2
        exit 1
      }
    done
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    rq_q=0
    [ "$COMMAND" = has ] && rq_q=1
    require_caps "$rq_q" "$DRIVER_PATH" "$TARGET_DRIVER" "$@"
    rq_rc=$?
    case "$rq_rc" in
      0) exit 0 ;;
      3) [ "$COMMAND" = has ] && exit 1; exit 2 ;;
      *) exit 2 ;;
    esac
    ;;

  exec|dispatch)
    [ $# -gt 0 ] || {
      printf 'driver-resolver: ERROR: exec requires <subsystem>.<method> argument (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    }
    METHOD="$1"
    shift
    kv_gate "$@"
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    if [ ! -x "$DRIVER_PATH" ]; then
      printf 'driver-resolver: ERROR: driver '\''%s'\'' executable not found at %s (ERR_DRIVER_NOT_FOUND)\n' "$TARGET_DRIVER" "$DRIVER_PATH" >&2
      exit 2
    fi
    handshake_at_dispatch "$DRIVER_PATH" "$TARGET_DRIVER" || exit 2
    kv_handoff
    exec "$DRIVER_PATH" "$METHOD" "$@"
    ;;

  *.*)
    METHOD="$COMMAND"
    kv_gate "$@"
    DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER") || exit 2
    if [ ! -x "$DRIVER_PATH" ]; then
      printf 'driver-resolver: ERROR: driver '\''%s'\'' executable not found at %s (ERR_DRIVER_NOT_FOUND)\n' "$TARGET_DRIVER" "$DRIVER_PATH" >&2
      exit 2
    fi
    handshake_at_dispatch "$DRIVER_PATH" "$TARGET_DRIVER" || exit 2
    kv_handoff
    exec "$DRIVER_PATH" "$METHOD" "$@"
    ;;

  *)
    if [ $# -eq 0 ]; then
      TARGET_DRIVER="$COMMAND"
      DRIVER_PATH=$(resolve_target_driver "$CTX_DIR" "$TARGET_DRIVER")
      rc=$?
      if [ "$rc" -eq 0 ]; then
        printf '%s\n' "$DRIVER_PATH"
        exit 0
      fi
      exit "$rc"
    fi
    printf 'driver-resolver: ERROR: unknown command or invalid method: '\''%s'\'' (ERR_INVALID_ARGUMENT)\n' "$COMMAND" >&2
    exit 1
    ;;
esac
