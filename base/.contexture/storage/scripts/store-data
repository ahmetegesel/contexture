#!/bin/sh
# store-data: the storage core's private reader and validator of a module's data file
# (no summary line, so discovery ignores it). It answers one namespace with the effective
# store fields on eleven lines, in this order: namespace, root, suffix, key pattern,
# changes, the data file path, the search form, the format, the fields, the title, and the
# snippet. The search form's document rules follow, one per line, as four
# tab-separated values: the key pattern, the section, the entity type, and the head marker
# (or - for none).
#
# A module's namespace is its installed module name: the module folder's name, never a
# declared value. A module declares its store in `<root>/<module>/data`, where <root> is the
# workspace modules root (`.contexture/modules`) or the extension root
# (`.contexture/extensions/modules`); one `field: value` line per field and a line starting
# with # a comment:
#   key: <pattern, a <name> placeholder per slash-separated segment; the final
#         segment may be a multi-segment <name...> placeholder>              (required)
#   root: <workspace-relative folder, inside the workspace>                  (optional;
#         default the namespace)
#   fallback_root: <workspace-relative folder, inside the workspace, neither (optional;
#         the root nor nested with it; a deprecated root a file store reads   no default)
#         after the root and never writes>
#   suffix: <suffix; may be empty>                                           (optional;
#         default empty)
#   changes: true|false                                                      (optional;
#         default false)
#   search: flat|documents                                                   (optional)
#   format: text|json                                                        (optional;
#         flat only; default text)
#   fields: <comma-separated field names>                                    (optional;
#         flat only; the JSON fields the typed search extracts)
#   title: <field name|key|head>                                             (optional;
#         flat default key; documents default head)
#   snippet: line                                                            (optional;
#         default line)
#   document: <key-pattern> <section> <entity-type> <head-marker|->          (optional;
#         repeatable; the document-set search schema)
#   unsearched: <key-pattern>                                                (optional;
#         repeatable; a document the module reads that its search schema
#         leaves out, such as the unit state; the leftovers probe and the
#         sweep count its keys as documents)
#   field: <name>: <required|optional> <line|block> [list] [one-of <A|B|...>] [default <value>]
#         (optional; repeatable; one declared field of the module's container, the
#         module library's field grammar)
# The namespace <ns> is served by the data file of the module folder named <ns>: the
# workspace modules root first, then the extension root, as discovery resolves a module
# name (a workspace module shadows an extension module of its name). The script validates
# the fields before any store function maps a key to a path. A data file names no
# namespace and no search modes: a namespace line refuses as an unknown field naming the fix
# (the namespace is the folder's name), and so does a modes line (the modes are the
# configured driver's registry).
#
# A root the data file declares applies only under the module's own name: an extension
# module that an install record names as installed under an alias (its module line
# <installed name> <original name> holding two names) answers its namespace as the root
# and no fallback root, the declared ones still validated as written, so an aliased
# module never reads or writes the store of the module it copies; a workspace module is
# never installed by a package, so never aliased. An install record area that exists but
# cannot be read leaves an extension module's root unknown and refuses rc 2.
#
# The plain answer never carries the fallback root, so a parser that reads the eleven lines
# by position ignores the field by construction. store-data <namespace> --with-fallback
# answers the fallback root as line 12 (an empty line when none is declared) and the
# document rules from line 13; a file store asks for it, a store with no root never does.
#
# A field line declares one field of the module's container in the module library's field
# grammar, the clauses in their fixed order, one blank apart with none trailing: the
# blanks after field: are the file's separator, while the declaration keeps its own, so a
# trailing blank refuses. The reader checks every field line through the library's field
# validator (its fields_decl_check over a scratch copy of the field lines), the engine and
# the reserved names beside this reader, and refuses a malformed
# line, a reserved name, or a name declared twice rc 1 naming the data file line (line <N>:
# <the validator's reason>); a data file without a field line never runs the validator.
# The answer carries the fields only when asked: store-data <namespace> --with-fields
# (alone or beside --with-fallback) answers, after the document rules, one tagged line per
# field, @field TAB <name>: <spec>, in declaration order; a document rule never starts
# with @, and a reader that does not ask (a driver never validates fields) never sees the
# family, so every other answer stays byte for byte as before.
#
# An unsearched line names the key pattern of a document the module reads that its search
# schema leaves out (placeholders and literal segments, as a document rule's pattern), so a
# key it names is a document without being searched. The answer carries the lines only when
# asked: store-data <namespace> --with-unsearched (beside the other flags, in any order)
# answers, after the document rules and before any field line, one tagged line per
# unsearched line, @unsearched TAB <pattern>, in declaration order; the leftovers probe and
# the sweep ask for it, every other reader never sees the family.
#
# The listing mode, store-data --list, answers every valid declaration in both roots, one
# line each, the namespace (the folder's name) and its root (the namespace when none is
# declared, or when the module is installed under an alias) separated by a tab, then the
# fallback root as a third column when one applies, sorted by namespace; a name both roots
# hold answers the workspace module's. A module folder whose name is no namespace token and
# a declaration that cannot be read (a malformed one, or one whose root is unknown) are left
# out, each with one line on stderr, and the listing then exits 1, the rows it read still
# answered, so a reader never takes a partial listing for the whole.
#
# Exit codes: 0 the answer; 1 a malformed declaration, a malformed namespace, an argument
# beyond the namespace, --with-fallback, --with-fields, and --with-unsearched or beyond the listing flag, or a
# listing that left a module out; 2 the
# module drawer is absent or unreadable, the install record area an extension module's
# root needs cannot be read, or the field validator a field line needs is missing or its
# scratch copy of the field lines cannot be written; 3 no module folder of that name holds a
# data file. The one-line reason goes to stderr.

set -u
LC_ALL=C
export LC_ALL

sd_fail() {
  printf 'store-data: %s\n' "$1" >&2
  exit 1
}

sd_env() {
  printf 'store-data: %s\n' "$1" >&2
  exit 2
}

SD_LIST=0
SD_WITH_FB=0
SD_WITH_FIELDS=0
SD_WITH_UNSEARCHED=0
SD_NAMESPACE="${1:-}"
case "$SD_NAMESPACE" in
  --list)
    [ $# -le 1 ] || sd_fail "unexpected argument '$2' (store-data --list takes no argument)"
    SD_LIST=1
    ;;
  *)
    while [ $# -ge 2 ]; do
      if [ "$2" = --with-fallback ] && [ "$SD_WITH_FB" -eq 0 ]; then
        SD_WITH_FB=1
      elif [ "$2" = --with-fields ] && [ "$SD_WITH_FIELDS" -eq 0 ]; then
        SD_WITH_FIELDS=1
      elif [ "$2" = --with-unsearched ] && [ "$SD_WITH_UNSEARCHED" -eq 0 ]; then
        SD_WITH_UNSEARCHED=1
      else
        sd_fail "unexpected argument '$2' (store-data <namespace> [--with-fallback] [--with-fields] [--with-unsearched], or store-data --list)"
      fi
      shift
    done
    # the namespace token, the module name rule: lowercase letters, digits, dot, underscore,
    # and dash, starting with a letter or digit
    case "$SD_NAMESPACE" in
      ""|[!a-z0-9]*|*[!a-z0-9._-]*) sd_fail "malformed namespace '$SD_NAMESPACE'" ;;
    esac
    ;;
esac

# the workspace root: CTX_STORE_WORKSPACE from the caller, else the walk up from PWD
SD_WS="${CTX_STORE_WORKSPACE:-}"
if [ -z "$SD_WS" ]; then
  sd_curr="$PWD"
  while [ -n "$sd_curr" ] && [ "$sd_curr" != "/" ]; do
    if [ -d "$sd_curr/.contexture" ]; then SD_WS="$sd_curr"; break; fi
    sd_curr=$(dirname "$sd_curr")
  done
  [ -n "$SD_WS" ] || SD_WS="$PWD"
fi
[ -d "$SD_WS/.contexture/modules" ] || sd_env "no module drawer at the workspace root"

sd_modules="$SD_WS/.contexture/modules"
sd_extension_modules="$SD_WS/.contexture/extensions/modules"
sd_state="$SD_WS/.contexture/extensions/.state"
# the storage core's scripts folder this reader sits in, beside the module library and its
# field validator engine
case "$0" in */*) sd_dir=${0%/*} ;; *) sd_dir=. ;; esac

# sd_parse <namespace> <data file>: the parse and the rule checks, one awk pass over the
# owner file and, for an extension module, every install record after it, whose module
# line naming the namespace under an alias drops the declared roots; the answer is the
# eleven lines plus the document rules, a refusal is the one prefixed line and exit 1, an
# install record area that cannot be read exit 2. A data file holding a field line takes
# two passes more: the pass that finds one exits 4 with nothing printed, the field lines
# are read and checked, and a last pass prints the answer.
sd_parse() {
sd_pns=$1
sd_ppath=$2
set --
case "$sd_ppath" in
  "$sd_extension_modules"/*)
    if [ -e "$sd_state" ]; then
      if [ ! -d "$sd_state" ] || [ ! -r "$sd_state" ] || [ ! -x "$sd_state" ]; then
        printf 'store-data: the install record area cannot be read, so the storage root of namespace '\''%s'\'' is unknown\n' "$sd_pns" >&2
        return 2
      fi
      for sd_rec in "$sd_state"/*.files; do
        [ -f "$sd_rec" ] || continue
        if [ ! -r "$sd_rec" ]; then
          printf 'store-data: the install record area cannot be read, so the storage root of namespace '\''%s'\'' is unknown\n' "$sd_pns" >&2
          return 2
        fi
        set -- "$@" "$sd_rec"
      done
    fi
    ;;
esac
sd_awk_run answer 0 "$sd_ppath" "$@"
sd_prc=$?
[ "$sd_prc" -eq 4 ] || return "$sd_prc"
sd_specs=$(sd_awk_run fields 0 "$sd_ppath" "$@") || return $?
sd_fields_check "$sd_specs" || return $?
sd_awk_run answer 1 "$sd_ppath" "$@"
}

# sd_awk_run <mode> <checked> <data file> [<install record>...]: one pass of the parse over
# the owner file of sd_pns at sd_ppath. The mode answer prints the answer, or exits 4 with
# nothing printed when the file holds a field line and checked is 0; fields prints the
# field lines, numbers their data file line numbers, one per line, each after the checks
sd_awk_run() {
sd_rmode=$1
sd_rchecked=$2
shift 2
SD_WANT_NS="$sd_pns" SD_PATH="$sd_ppath" SD_FNAME="${sd_ppath##*/}" SD_WITH_FB="$SD_WITH_FB" \
  SD_WITH_FIELDS="$SD_WITH_FIELDS" SD_WITH_UNSEARCHED="$SD_WITH_UNSEARCHED" SD_MODE="$sd_rmode" SD_CHECKED="$sd_rchecked" LC_ALL=C awk "$SD_AWK" "$@"
}

# sd_fields_check <field lines>: the field lines, one per line in file order, checked by the
# module library's fields_decl_check, its engine and its reserved names beside this reader,
# over a scratch copy in the verb's scratch root, else the drawer's scratch folder; rc 0, or
# rc 1 with one line naming the data file line, rc 2 when the validator is missing or the
# scratch copy cannot be written. The validator stops at the first bad line, so the failing
# line is the shortest failing prefix, sought only once the whole set failed.
sd_fields_check() {
sd_fc_specs=$1
if [ ! -f "$sd_dir/library" ] || [ ! -f "$sd_dir/store-fields.awk" ]; then
  printf 'store-data: the field validator is not installed beside the data reader, so the field lines of namespace '\''%s'\'' cannot be checked\n' "$sd_pns" >&2
  return 2
fi
sd_fc_tmp=${CTX_SCRATCH_ROOT:-}
if [ -z "$sd_fc_tmp" ] || ! { [ -d "$sd_fc_tmp" ] || mkdir -p "$sd_fc_tmp" 2>/dev/null; } || [ ! -w "$sd_fc_tmp" ]; then
  sd_fc_tmp=$SD_WS/.contexture/tmp
  mkdir -p "$sd_fc_tmp" 2>/dev/null
fi
sd_fc_decl=$(mktemp "$sd_fc_tmp/store-data-fields.XXXXXX" 2>/dev/null) || {
  printf 'store-data: the scratch file to check the field lines of namespace '\''%s'\'' cannot be created\n' "$sd_pns" >&2
  return 2
}
(
  . "$sd_dir/library" || exit 2
  CTX_STORE_RESOLVER=$sd_dir/driver-resolver
  sd_fc_unread() {
    printf 'store-data: the field validator could not check the field lines of namespace '\''%s'\''\n' "$sd_pns" >&2
    exit 2
  }
  printf '%s\n' "$sd_fc_specs" > "$sd_fc_decl" || sd_fc_unread
  fields_decl_check "$sd_fc_decl" 2>/dev/null
  sd_fc_rc=$?
  [ "$sd_fc_rc" -eq 0 ] && exit 0
  [ "$sd_fc_rc" -eq 1 ] || sd_fc_unread
  sd_fc_k=0
  for sd_fc_num in $(sd_awk_run numbers 1 "$sd_ppath"); do
    sd_fc_k=$((sd_fc_k + 1))
    printf '%s\n' "$sd_fc_specs" | sed -n "1,${sd_fc_k}p" > "$sd_fc_decl" || sd_fc_unread
    sd_fc_msg=$(fields_decl_check "$sd_fc_decl" 2>&1)
    sd_fc_rc=$?
    [ "$sd_fc_rc" -eq 0 ] && continue
    [ "$sd_fc_rc" -eq 1 ] || sd_fc_unread
    sd_fc_msg=${sd_fc_msg#*: error: }
    sd_fc_msg=${sd_fc_msg% (*)}
    case "$sd_fc_msg" in
      "declaration line "*)
        sd_fc_rest=${sd_fc_msg#declaration line }
        sd_fc_rest=${sd_fc_rest#"${sd_fc_rest%%[!0-9]*}"}
        case "$sd_fc_rest" in
          ": "*) sd_fc_msg=${sd_fc_rest#": "} ;;
          *) sd_fc_msg="the field line$sd_fc_rest" ;;
        esac
        ;;
    esac
    printf 'store-data: line %s: %s\n' "$sd_fc_num" "$sd_fc_msg" >&2
    exit 1
  done
  sd_fc_unread
)
sd_fc_rc=$?
rm -f "$sd_fc_decl"
return "$sd_fc_rc"
}

SD_AWK='
function fail(msg) {
  printf "store-data: %s\n", msg > "/dev/stderr"
  bad = 1
  exit 1
}
function trim(s) {
  gsub(/^[[:space:]]+/, "", s)
  gsub(/[[:space:]]+$/, "", s)
  return s
}
function ns_ok(s) { return s ~ /^[a-z0-9][a-z0-9._-]*$/ }
function root_ok(r,   n, p, i) {
  if (r == "" || r == ".") return 0
  if (substr(r, 1, 1) == "/" || substr(r, length(r), 1) == "/") return 0
  if (r ~ /[[:cntrl:]]/ || index(r, " ") || index(r, "\\")) return 0
  n = split(r, p, "/")
  for (i = 1; i <= n; i++) if (p[i] == "" || p[i] == "." || p[i] == "..") return 0
  return 1
}
function suffix_ok(s) {
  if (s == "") return 1
  if (s == "." || s == "..") return 0
  if (index(s, "/") || index(s, " ")) return 0
  if (s ~ /[[:cntrl:]]/) return 0
  return 1
}
function key_pattern_ok(k,   n, p, i) {
  if (k == "") return 0
  n = split(k, p, "/")
  for (i = 1; i <= n; i++) {
    if (i == n && p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/) continue
    if (p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*>$/) continue
    return 0
  }
  return 1
}
function doc_pattern_ok(k,   n, p, i) {
  if (k == "") return 0
  n = split(k, p, "/")
  for (i = 1; i <= n; i++) {
    if (i == n && p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/) continue
    if (p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*>$/) continue
    if (p[i] ~ /^[A-Za-z0-9._-]+$/) continue
    return 0
  }
  return 1
}
function section_ok(s) { return s != "" && s ~ /^[a-z][a-z0-9_]*$/ }
function entity_ok(s) { return s != "" && s ~ /^[a-z][a-z0-9_]*$/ }
function marker_ok(s) { return s == "-" || s ~ /^@[A-Za-z][A-Za-z0-9_-]*$/ }
BEGIN {
  want = ENVIRON["SD_WANT_NS"]
  path = ENVIRON["SD_PATH"]
  fname = ENVIRON["SD_FNAME"]
  seen_root = seen_suffix = seen_key = seen_changes = seen_fb = 0
  seen_search = seen_format = seen_fields = seen_title = seen_snippet = 0
  ns = root = suffix = key = changes = search = format = fields = title = snippet = fb = ""
  docs = ""
  uns = ""
  doc_count = 0
  nfl = 0
  lineno = 0
  aliased = 0
}
FILENAME != path {
  if ($1 == "module" && NF == 3 && $2 == want && $3 != want) aliased = 1
  next
}
{
  line = $0
  sub(/\r$/, "", line)
  lineno++
  if (line ~ /^#/) next
  if (line !~ /[^[:space:]]/) next
  c = index(line, ":")
  if (c == 0) fail("line " lineno " of " fname " is not a '\''field: value'\'' line")
  field = trim(substr(line, 1, c - 1))
  value = trim(substr(line, c + 1))
  if (field == "namespace") {
    fail("unknown field '\''namespace'\'' in the data file: the namespace is the module folder'\''s name, so remove the namespace line")
  } else if (field == "root") {
    if (seen_root) fail("duplicate field '\''root'\'' in the data file")
    seen_root = 1; root = value
  } else if (field == "fallback_root") {
    if (seen_fb) fail("duplicate field '\''fallback_root'\'' in the data file")
    seen_fb = 1; fb = value
  } else if (field == "suffix") {
    if (seen_suffix) fail("duplicate field '\''suffix'\'' in the data file")
    seen_suffix = 1; suffix = value
  } else if (field == "key") {
    if (seen_key) fail("duplicate field '\''key'\'' in the data file")
    seen_key = 1; key = value
  } else if (field == "changes") {
    if (seen_changes) fail("duplicate field '\''changes'\'' in the data file")
    seen_changes = 1; changes = value
  } else if (field == "search") {
    if (seen_search) fail("duplicate field '\''search'\'' in the data file")
    seen_search = 1; search = value
  } else if (field == "format") {
    if (seen_format) fail("duplicate field '\''format'\'' in the data file")
    seen_format = 1; format = value
  } else if (field == "fields") {
    if (seen_fields) fail("duplicate field '\''fields'\'' in the data file")
    seen_fields = 1; fields = value
  } else if (field == "title") {
    if (seen_title) fail("duplicate field '\''title'\'' in the data file")
    seen_title = 1; title = value
  } else if (field == "snippet") {
    if (seen_snippet) fail("duplicate field '\''snippet'\'' in the data file")
    seen_snippet = 1; snippet = value
  } else if (field == "modes") {
    fail("unknown field '\''modes'\'' in the data file: the search modes are the configured driver'\''s registry, so remove the modes line")
  } else if (field == "document") {
    doc_count++
    n = split(value, p, /[[:space:]]+/)
    if (n != 4) fail("line " lineno ": a document rule takes the key pattern, the section, the entity type, and the head marker (or -)")
    dpat = p[1]; dsec = p[2]; dent = p[3]; dmark = p[4]
    if (!doc_pattern_ok(dpat)) fail("line " lineno ": malformed document key pattern '\''" dpat "'\''")
    if (!section_ok(dsec)) fail("line " lineno ": malformed document section '\''" dsec "'\''")
    if (!entity_ok(dent)) fail("line " lineno ": malformed document entity type '\''" dent "'\''")
    if (!marker_ok(dmark)) fail("line " lineno ": malformed document head marker '\''" dmark "'\''")
    docs = docs dpat "\t" dsec "\t" dent "\t" dmark "\n"
  } else if (field == "unsearched") {
    n = split(value, p, /[[:space:]]+/)
    if (n != 1) fail("line " lineno ": an unsearched line takes one key pattern")
    if (!doc_pattern_ok(p[1])) fail("line " lineno ": malformed unsearched key pattern '\''" p[1] "'\''")
    uns = uns "@unsearched\t" p[1] "\n"
  } else if (field == "field") {
    v = substr(line, c + 1)
    sub(/^[[:space:]]+/, "", v)
    if (v == "") fail("line " lineno ": the field line is empty")
    nfl++
    fl[nfl] = v
    fln[nfl] = lineno
  } else {
    fail("unknown field '\''" field "'\'' in the data file")
  }
}
END {
  if (bad) exit 1
  ns = want
  if (!seen_key) fail("the data file declares no key pattern")
  if (!seen_root) root = ns
  if (!seen_suffix) suffix = ""
  if (!seen_changes) changes = "false"

  if (!ns_ok(ns)) fail("malformed namespace '\''" ns "'\''")
  if (!root_ok(root)) fail("malformed root '\''" root "'\'' (a workspace-relative folder inside the workspace)")
  if (seen_fb) {
    if (!root_ok(fb)) fail("malformed fallback root '\''" fb "'\'' (a workspace-relative folder inside the workspace)")
    if (fb == root) fail("the fallback root '\''" fb "'\'' equals the root")
    if (index(fb, root "/") == 1 || index(root, fb "/") == 1) fail("the fallback root '\''" fb "'\'' and the root '\''" root "'\'' are nested")
  }
  if (aliased) { root = ns; fb = "" }
  if (!suffix_ok(suffix)) fail("malformed suffix '\''" suffix "'\''")
  if (!key_pattern_ok(key)) fail("malformed key pattern '\''" key "'\'' (a <name> placeholder per slash-separated segment, the last optionally <name...>)")
  if (changes != "true" && changes != "false") fail("malformed changes flag '\''" changes "'\'' (true or false)")

  form = ""
  if (seen_search) {
    if (search != "flat" && search != "documents") fail("malformed search form '\''" search "'\'' (flat or documents)")
    form = search
  } else if (doc_count > 0 || seen_format || seen_fields || seen_title || seen_snippet) {
    if (doc_count > 0) form = "documents"; else form = "flat"
  }
  if (form == "documents" && doc_count == 0) fail("the document-set search form takes at least one document rule")
  if (form == "documents" && (seen_format || seen_fields)) fail("the document-set search form takes no format or fields")
  if (form != "documents" && doc_count > 0) fail("a document rule needs the document-set search form")

  if (format == "") {
    if (form == "flat") format = "text"
  } else if (format == "text" || format == "json") {
    if (form != "flat") fail("format is a flat-form field")
  } else {
    fail("malformed format '\''" format "'\'' (text or json)")
  }

  if (form != "flat" && seen_fields) fail("fields is a flat-form field")
  if (seen_fields) {
    gsub(/[[:space:]]/, "", fields)
    if (fields == "" || fields ~ /^,/ || fields ~ /,$/ || index(fields, ",,")) fail("malformed fields '\''" fields "'\''")
    n = split(fields, p, ",")
    for (i = 1; i <= n; i++) if (p[i] !~ /^[A-Za-z0-9_.-]+$/) fail("malformed field name '\''" p[i] "'\''")
  }

  if (seen_title) {
    if (form == "documents") {
      if (title != "head" && title != "key") fail("malformed document title '\''" title "'\'' (head or key)")
    } else {
      if (title !~ /^[A-Za-z0-9_.-]+$/) fail("malformed title '\''" title "'\''")
    }
  } else {
    if (form == "documents") title = "head"; else title = "key"
  }

  if (seen_snippet && snippet != "line") fail("malformed snippet '\''" snippet "'\'' (line)")
  if (!seen_snippet) snippet = "line"

  mode = ENVIRON["SD_MODE"]
  if (mode == "fields") { for (i = 1; i <= nfl; i++) print fl[i]; exit 0 }
  if (mode == "numbers") { for (i = 1; i <= nfl; i++) print fln[i]; exit 0 }
  if (nfl > 0 && ENVIRON["SD_CHECKED"] != "1") exit 4

  print ns
  print root
  print suffix
  print key
  print changes
  print path
  print form
  print format
  print fields
  print title
  print snippet
  if (ENVIRON["SD_WITH_FB"] == "1") print fb
  printf "%s", docs
  if (ENVIRON["SD_WITH_UNSEARCHED"] == "1") printf "%s", uns
  if (ENVIRON["SD_WITH_FIELDS"] == "1") for (i = 1; i <= nfl; i++) print "@field\t" fl[i]
}
'

# the listing mode: every module folder holding a data file, its name the namespace, the
# workspace modules first so an extension module of a name the workspace holds is left out
# as discovery shadows it, each declaration parsed whole and its root and any fallback root
# answered, in namespace order; any module left out makes the exit 1
if [ "$SD_LIST" -eq 1 ]; then
  SD_WITH_FB=1
  sd_tab=$(printf '\t')
  sd_seen=" "
  sd_rows=""
  sd_left=0
  for sd_file in "$sd_modules"/*/data "$sd_extension_modules"/*/data; do
    [ -f "$sd_file" ] || continue
    sd_ns=${sd_file%/*}
    sd_ns=${sd_ns##*/}
    case "$sd_seen" in
      *" $sd_ns "*) continue ;;
    esac
    sd_seen="$sd_seen$sd_ns "
    case "$sd_ns" in
      [!a-z0-9]*|*[!a-z0-9._-]*)
        printf 'store-data: the module folder '\''%s'\'' names no namespace: a module name is lowercase letters, digits, dot, underscore, and dash, starting with a letter or digit\n' "$sd_ns" >&2
        sd_left=1
        continue
        ;;
    esac
    sd_rows="$sd_rows$sd_ns$sd_tab$sd_file
"
  done
  sd_sorted=$(printf '%s' "$sd_rows" | LC_ALL=C sort) || sd_env "the module listing cannot be sorted"
  while IFS="$sd_tab" read -r sd_ns sd_file; do
    [ -n "$sd_ns" ] || continue
    if sd_out=$(sd_parse "$sd_ns" "$sd_file" 2>&1); then
      sd_fb=$(printf '%s\n' "$sd_out" | sed -n '12p')
      printf '%s\t%s%s\n' "$sd_ns" "$(printf '%s\n' "$sd_out" | sed -n '2p')" "${sd_fb:+$sd_tab$sd_fb}"
    else
      printf 'store-data: namespace '\''%s'\'': %s\n' "$sd_ns" "${sd_out#store-data: }" >&2
      sd_left=1
    fi
  done <<EOF
$sd_sorted
EOF
  exit "$sd_left"
fi

# the owner lookup: the data file of the module folder named after the namespace, the
# workspace modules root first, then the extension root
sd_found=""
for sd_file in "$sd_modules/$SD_NAMESPACE/data" "$sd_extension_modules/$SD_NAMESPACE/data"; do
  if [ -f "$sd_file" ]; then
    sd_found=$sd_file
    break
  fi
done

if [ -z "$sd_found" ]; then
  printf 'store-data: namespace '\''%s'\'' is declared by no module data file\n' "$SD_NAMESPACE" >&2
  exit 3
fi

sd_parse "$SD_NAMESPACE" "$sd_found"
exit $?
