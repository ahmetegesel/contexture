#!/bin/sh
# store-data: the storage core's private reader and validator of a module's data file
# (no summary line, so discovery ignores it). It answers one namespace with the effective
# store fields on twelve lines, in this order: namespace, root, suffix, key pattern,
# changes, the data file path, the search form, the format, the fields, the title, the
# snippet, and the modes. The search form's document rules follow, one per line, as four
# tab-separated values: the key pattern, the section, the entity type, and the head marker
# (or - for none).
#
# A module declares its store in `<root>/<module>/data`, where <root> is the workspace
# modules root (`.contexture/modules`) or the extension root
# (`.contexture/extensions/modules`); one `field: value` line per
# field and a line starting with # a comment:
#   namespace: <lowercase token: letters, digits, dot, underscore, hyphen>   (required)
#   key: <pattern, a <name> placeholder per slash-separated segment; the final
#         segment may be a multi-segment <name...> placeholder>              (required)
#   root: <workspace-relative folder, inside the workspace>                  (optional;
#         default the namespace)
#   suffix: <suffix; may be empty>                                           (optional;
#         default empty)
#   changes: true|false                                                      (optional;
#         default false)
#   search: flat|documents                                                   (optional)
#   format: text|json                                                        (optional;
#         flat only; default text)
#   fields: <comma-separated field names>                                    (optional;
#         flat only; the JSON fields the typed search extracts)
#   title: <field name|key|head>                                             (optional;
#         flat default key; documents default head)
#   snippet: line                                                            (optional;
#         default line)
#   modes: <comma-separated modes>                                           (optional;
#         default exact; exact is required)
#   document: <key-pattern> <section> <entity-type> <head-marker|->          (optional;
#         repeatable; the document-set search schema)
# The module directory beside the data file is the owner; a second data file declaring the
# same namespace, in either root, refuses. The script validates the fields before any
# store function maps a key to a path.
#
# Exit codes: 0 the answer; 1 a malformed declaration, a malformed namespace, or two
# declarations of the namespace; 2 the module drawer is absent or unreadable; 3 the
# namespace is declared nowhere. The one-line reason goes to stderr.

set -u
LC_ALL=C
export LC_ALL

SD_NAMESPACE="${1:-}"

sd_fail() {
  printf 'store-data: %s\n' "$1" >&2
  exit 1
}

sd_env() {
  printf 'store-data: %s\n' "$1" >&2
  exit 2
}

# the namespace token: lowercase letters, digits, dot, underscore, hyphen
case "$SD_NAMESPACE" in
  ''|[!a-z0-9._-]*|*[!a-z0-9._-]*) sd_fail "malformed namespace '$SD_NAMESPACE'" ;;
esac

# the workspace root: CTX_STORE_WORKSPACE from the caller, else the walk up from PWD
SD_WS="${CTX_STORE_WORKSPACE:-}"
if [ -z "$SD_WS" ]; then
  sd_curr="$PWD"
  while [ -n "$sd_curr" ] && [ "$sd_curr" != "/" ]; do
    if [ -d "$sd_curr/.contexture" ]; then SD_WS="$sd_curr"; break; fi
    sd_curr=$(dirname "$sd_curr")
  done
  [ -n "$SD_WS" ] || SD_WS="$PWD"
fi
[ -d "$SD_WS/.contexture/modules" ] || sd_env "no module drawer at the workspace root"

sd_modules="$SD_WS/.contexture/modules"
sd_extension_modules="$SD_WS/.contexture/extensions/modules"

# the owner scan: the first namespace value of each candidate data file, one awk pass over
# every file in both roots; the workspace modules first, then the extension modules
set --
for sd_file in "$sd_modules"/*/data; do
  [ -f "$sd_file" ] || continue
  set -- "$@" "$sd_file"
done
if [ -d "$sd_extension_modules" ]; then
  for sd_file in "$sd_extension_modules"/*/data; do
    [ -f "$sd_file" ] || continue
    set -- "$@" "$sd_file"
  done
fi

sd_owner_files=""
if [ $# -gt 0 ]; then
  sd_owner_files=$(SD_WANT_NS="$SD_NAMESPACE" LC_ALL=C awk '
    BEGIN { want = ENVIRON["SD_WANT_NS"] }
    FNR == 1 { found = 0 }
    found { next }
    {
      line = $0
      sub(/\r$/, "", line)
      if (line ~ /^#/) next
      if (line !~ /[^[:space:]]/) next
      c = index(line, ":")
      if (c == 0) next
      key = substr(line, 1, c - 1)
      val = substr(line, c + 1)
      gsub(/^[[:space:]]+/, "", key)
      gsub(/[[:space:]]+$/, "", key)
      if (key != "namespace") next
      gsub(/^[[:space:]]+/, "", val)
      gsub(/[[:space:]]+$/, "", val)
      found = 1
      if (val == want) print FILENAME
    }
  ' "$@")
fi

sd_found=""
sd_count=0
sd_owners=""
if [ -n "$sd_owner_files" ]; then
  sd_ifs=$IFS
  IFS='
'
  for sd_file in $sd_owner_files; do
    sd_count=$((sd_count + 1))
    sd_found=$sd_file
    sd_mod=${sd_file%/*}
    sd_mod=${sd_mod##*/}
    sd_owners="$sd_owners $sd_mod"
  done
  IFS=$sd_ifs
fi

if [ "$sd_count" -eq 0 ]; then
  printf 'store-data: namespace '\''%s'\'' is declared by no module data file\n' "$SD_NAMESPACE" >&2
  exit 3
fi
if [ "$sd_count" -gt 1 ]; then
  sd_fail "namespace '$SD_NAMESPACE' is declared by more than one module:$sd_owners"
fi

# the parse and the rule checks: one awk pass over the owner file; the answer is the twelve
# lines plus the document rules, a refusal is the one prefixed line and exit 1
SD_WANT_NS="$SD_NAMESPACE" SD_PATH="$sd_found" SD_FNAME="${sd_found##*/}" LC_ALL=C awk '
function fail(msg) {
  printf "store-data: %s\n", msg > "/dev/stderr"
  bad = 1
  exit 1
}
function trim(s) {
  gsub(/^[[:space:]]+/, "", s)
  gsub(/[[:space:]]+$/, "", s)
  return s
}
function ns_ok(s) { return s != "" && s ~ /^[a-z0-9._-]+$/ }
function root_ok(r,   n, p, i) {
  if (r == "" || r == ".") return 0
  if (substr(r, 1, 1) == "/" || substr(r, length(r), 1) == "/") return 0
  if (r ~ /[[:cntrl:]]/ || index(r, " ") || index(r, "\\")) return 0
  n = split(r, p, "/")
  for (i = 1; i <= n; i++) if (p[i] == "" || p[i] == "." || p[i] == "..") return 0
  return 1
}
function suffix_ok(s) {
  if (s == "") return 1
  if (s == "." || s == "..") return 0
  if (index(s, "/") || index(s, " ")) return 0
  if (s ~ /[[:cntrl:]]/) return 0
  return 1
}
function key_pattern_ok(k,   n, p, i) {
  if (k == "") return 0
  n = split(k, p, "/")
  for (i = 1; i <= n; i++) {
    if (i == n && p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/) continue
    if (p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*>$/) continue
    return 0
  }
  return 1
}
function doc_pattern_ok(k,   n, p, i) {
  if (k == "") return 0
  n = split(k, p, "/")
  for (i = 1; i <= n; i++) {
    if (i == n && p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/) continue
    if (p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*>$/) continue
    if (p[i] ~ /^[A-Za-z0-9._-]+$/) continue
    return 0
  }
  return 1
}
function section_ok(s) { return s != "" && s ~ /^[a-z][a-z0-9_]*$/ }
function entity_ok(s) { return s != "" && s ~ /^[a-z][a-z0-9_]*$/ }
function marker_ok(s) { return s == "-" || s ~ /^@[A-Za-z][A-Za-z0-9_-]*$/ }
BEGIN {
  want = ENVIRON["SD_WANT_NS"]
  path = ENVIRON["SD_PATH"]
  fname = ENVIRON["SD_FNAME"]
  seen_ns = seen_root = seen_suffix = seen_key = seen_changes = 0
  seen_search = seen_format = seen_fields = seen_title = seen_snippet = seen_modes = 0
  ns = root = suffix = key = changes = search = format = fields = title = snippet = modes = ""
  docs = ""
  doc_count = 0
  lineno = 0
}
{
  line = $0
  sub(/\r$/, "", line)
  lineno++
  if (line ~ /^#/) next
  if (line !~ /[^[:space:]]/) next
  c = index(line, ":")
  if (c == 0) fail("line " lineno " of " fname " is not a '\''field: value'\'' line")
  field = trim(substr(line, 1, c - 1))
  value = trim(substr(line, c + 1))
  if (field == "namespace") {
    if (seen_ns) fail("duplicate field '\''namespace'\'' in the data file")
    seen_ns = 1; ns = value
  } else if (field == "root") {
    if (seen_root) fail("duplicate field '\''root'\'' in the data file")
    seen_root = 1; root = value
  } else if (field == "suffix") {
    if (seen_suffix) fail("duplicate field '\''suffix'\'' in the data file")
    seen_suffix = 1; suffix = value
  } else if (field == "key") {
    if (seen_key) fail("duplicate field '\''key'\'' in the data file")
    seen_key = 1; key = value
  } else if (field == "changes") {
    if (seen_changes) fail("duplicate field '\''changes'\'' in the data file")
    seen_changes = 1; changes = value
  } else if (field == "search") {
    if (seen_search) fail("duplicate field '\''search'\'' in the data file")
    seen_search = 1; search = value
  } else if (field == "format") {
    if (seen_format) fail("duplicate field '\''format'\'' in the data file")
    seen_format = 1; format = value
  } else if (field == "fields") {
    if (seen_fields) fail("duplicate field '\''fields'\'' in the data file")
    seen_fields = 1; fields = value
  } else if (field == "title") {
    if (seen_title) fail("duplicate field '\''title'\'' in the data file")
    seen_title = 1; title = value
  } else if (field == "snippet") {
    if (seen_snippet) fail("duplicate field '\''snippet'\'' in the data file")
    seen_snippet = 1; snippet = value
  } else if (field == "modes") {
    if (seen_modes) fail("duplicate field '\''modes'\'' in the data file")
    seen_modes = 1; modes = value
  } else if (field == "document") {
    doc_count++
    n = split(value, p, /[[:space:]]+/)
    if (n != 4) fail("line " lineno ": a document rule takes the key pattern, the section, the entity type, and the head marker (or -)")
    dpat = p[1]; dsec = p[2]; dent = p[3]; dmark = p[4]
    if (!doc_pattern_ok(dpat)) fail("line " lineno ": malformed document key pattern '\''" dpat "'\''")
    if (!section_ok(dsec)) fail("line " lineno ": malformed document section '\''" dsec "'\''")
    if (!entity_ok(dent)) fail("line " lineno ": malformed document entity type '\''" dent "'\''")
    if (!marker_ok(dmark)) fail("line " lineno ": malformed document head marker '\''" dmark "'\''")
    docs = docs dpat "\t" dsec "\t" dent "\t" dmark "\n"
  } else {
    fail("unknown field '\''" field "'\'' in the data file")
  }
}
END {
  if (bad) exit 1
  if (!seen_ns) fail("the data file declares no namespace")
  if (!seen_key) fail("the data file declares no key pattern")
  if (!seen_root) root = ns
  if (!seen_suffix) suffix = ""
  if (!seen_changes) changes = "false"

  if (!ns_ok(ns)) fail("malformed namespace '\''" ns "'\''")
  if (ns != want) fail("the data file declares namespace '\''" ns "'\'', not '\''" want "'\''")
  if (!root_ok(root)) fail("malformed root '\''" root "'\'' (a workspace-relative folder inside the workspace)")
  if (!suffix_ok(suffix)) fail("malformed suffix '\''" suffix "'\''")
  if (!key_pattern_ok(key)) fail("malformed key pattern '\''" key "'\'' (a <name> placeholder per slash-separated segment, the last optionally <name...>)")
  if (changes != "true" && changes != "false") fail("malformed changes flag '\''" changes "'\'' (true or false)")

  form = ""
  if (seen_search) {
    if (search != "flat" && search != "documents") fail("malformed search form '\''" search "'\'' (flat or documents)")
    form = search
  } else if (doc_count > 0 || seen_format || seen_fields || seen_title || seen_snippet) {
    if (doc_count > 0) form = "documents"; else form = "flat"
  }
  if (form == "documents" && doc_count == 0) fail("the document-set search form takes at least one document rule")
  if (form == "documents" && (seen_format || seen_fields)) fail("the document-set search form takes no format or fields")
  if (form != "documents" && doc_count > 0) fail("a document rule needs the document-set search form")

  if (format == "") {
    if (form == "flat") format = "text"
  } else if (format == "text" || format == "json") {
    if (form != "flat") fail("format is a flat-form field")
  } else {
    fail("malformed format '\''" format "'\'' (text or json)")
  }

  if (form != "flat" && seen_fields) fail("fields is a flat-form field")
  if (seen_fields) {
    gsub(/[[:space:]]/, "", fields)
    if (fields == "" || fields ~ /^,/ || fields ~ /,$/ || index(fields, ",,")) fail("malformed fields '\''" fields "'\''")
    n = split(fields, p, ",")
    for (i = 1; i <= n; i++) if (p[i] !~ /^[A-Za-z0-9_.-]+$/) fail("malformed field name '\''" p[i] "'\''")
  }

  if (seen_title) {
    if (form == "documents") {
      if (title != "head" && title != "key") fail("malformed document title '\''" title "'\'' (head or key)")
    } else {
      if (title !~ /^[A-Za-z0-9_.-]+$/) fail("malformed title '\''" title "'\''")
    }
  } else {
    if (form == "documents") title = "head"; else title = "key"
  }

  if (seen_snippet && snippet != "line") fail("malformed snippet '\''" snippet "'\'' (line)")
  if (!seen_snippet) snippet = "line"

  if (seen_modes) {
    gsub(/[[:space:]]/, "", modes)
    if (modes == "" || modes ~ /^,/ || modes ~ /,$/ || index(modes, ",,")) fail("malformed modes '\''" modes "'\''")
    n = split(modes, p, ",")
    mnorm = ""
    mseen = " "
    for (i = 1; i <= n; i++) {
      m = p[i]
      if (m !~ /^[a-z][a-z0-9_-]*$/) fail("malformed mode '\''" m "'\''")
      if (index(mseen, " " m " ")) fail("duplicate mode '\''" m "'\''")
      mseen = mseen m " "
      if (mnorm == "") mnorm = m; else mnorm = mnorm "," m
    }
    if (!index(mseen, " exact ")) fail("the modes must include exact")
    modes = mnorm
  } else {
    modes = "exact"
  }

  print ns
  print root
  print suffix
  print key
  print changes
  print path
  print form
  print format
  print fields
  print title
  print snippet
  print modes
  printf "%s", docs
}
' "$sd_found"
exit $?
