#!/bin/sh
# library: the storage core's module-facing interface, sourced by a module's scripts and
# data script (no summary line, so the engine never lists it). It is the one door from a
# module to the configured storage driver, and it serves the calling module's own namespace
# alone: no store function takes a namespace, since the library finds its caller.
#
#   store.namespace                                                 (the caller's namespace)
#   store.list [<prefix>]
#   store.get <key> [<key>...]                                      (two or more: one JSON line)
#   store.get.into <targets>                                        (the batched read into files)
#   store.put <key> [--op=<op>] [--head=<sha|none>]                 (payload on stdin)
#   store.delete <key> [--op=<op>] [--head=<sha|none>]
#   store.changes                                                   (heads on stdin)
#   store.batch                                                     (actions on stdin)
#   store.scan
#   store.search <query> <mode> [<limit>]                           (query on stdin; 0 = all)
#   store.modes [--own]
#   store.promote <prefix>                                          (optional capability)
#   store.require <capability>...
#   store.has <capability>
#   store.roots
#   store.leftovers                                                 (the read only leftovers probe)
#   store.leftovers.text <answer> <summary|kinds>                   (its one text form)
#   lib.utf8_ok <string>, lib.utf8_file_ok <file>                   (the shared checks)
#   lib.ref_ok <label> <ref>
#   lib.lock, lib.unlock                                            (the library lock)
#   fields.decl_check <declaration>                                 (the field validator)
#   fields.apply <declaration> <old record> <actions> <new record>
#   fields.effective <declaration> <record>
#   fields.conforms <declaration> <record>
#   fields.reserved_ok <name>
#   fields.own <declaration>                                        (the caller's declared fields)
#   fields.put <key> <actions> <record>, fields.set <key> <actions> <record>
#   fields.get <key> <record>                                       (the checked record entry)
#
# The caller lookup: a module's namespace is its installed module name. At the first storage
# call (never when the library is sourced, since a lane verb sources the unit helpers) the
# library takes the calling script's path ($0, which a sourced file shares with the script
# that sourced it), folds its dot and dot-dot segments lexically (no symlink is resolved, so
# a linked module folder answers by the link's name, as discovery names modules), and walks
# up to the nearest folder holding a module manifest (a file named module); that folder's
# name is the namespace, kept for the rest of the shell. A relative script path (a later cd
# would misattribute it) or no module folder above the script refuses rc 1 with one line
# naming the need (ERR_INVALID_ARGUMENT). store_namespace prints the answer; another
# module's data is reached only through that module's ctx verbs.
#
# The store functions and the two probes reach the configured driver through the storage
# core's resolver, passing it the caller's namespace; the caller uses the shell function
# names store_list, store_get, store_put, store_delete, store_changes, store_batch,
# store_scan, store_search, store_promote, store_require, and store_has. store_promote moves
# a whole key prefix from the namespace's fallback root to its root on a driver that
# declares store.promote (ask store_has store.promote first). store_get with one key answers
# the raw value; with two or more it answers the driver's one batched line, which
# store_get_into decodes into files. The caller sets CTX_STORE_ROOT to the workspace root
# (the engine exports CTX_ROOT, which serves when CTX_STORE_ROOT is absent) and may set
# CTX_STORE_RESOLVER to an exact resolver path; the core resolver is found under the
# drawer, then the base mirror.
#
# store_roots reads the module declarations, never the driver: one line per declared store
# root, the namespace and the root separated by a tab, sorted by namespace, a namespace
# that declares a fallback root answering it on a second line after its root, through the
# storage core's data reader in its listing mode (store-data --list, whose third column
# carries the fallback). It answers the whole list or none: a module whose data file cannot
# be read (the listing exiting 1), no data reader, or no module drawer refuses rc 2 with one
# store.roots line, the reader's reason quoted.
#
# A refusal is one stderr line with a fixed code. The resolver's own driver-resolver: line
# is passed through unchanged, the one shape exception.
#
# The shared checks validate a value a module asks about and print nothing: lib_utf8_ok
# and lib_utf8_file_ok answer rc 0 for valid UTF-8, 1 for anything else, 2 when the check
# cannot run; LIB_UTF8_AWK is the awk text of the same check for a caller that folds it
# into its own awk program. lib_ref_ok checks the shape of a full address <owner>#<path>
# alone and refuses with its one line naming the ref.
#
# The library lock serializes a module's writers of its namespace across a check and a
# write: lib_lock takes it, lib_unlock releases it, and the caller releases it in its exit
# trap too. It lives in its own lock family, never at a driver's namespace lock, so a holder
# calls every store function freely; one process holds one library lock.
#
# The field validator is opt in: a module that declares fields for a container hands the
# declaration (one field line per line) and the record files to the fields functions, which
# run the storage core's store-fields.awk engine; a module declaring none never calls them.
# Every value is a string; a rule tying fields together is the module's own. A refusal is
# rc 1 with one line: ERR_INVALID_ARGUMENT for malformed input (a declaration line, an
# action, a value that is not UTF-8 or holds a newline in a line field), ERR_SCHEMA_VIOLATION
# for a write breaking the declaration (an unknown field, a value outside its one-of set, a
# required field left absent). ERR_SCHEMA_VIOLATION is a library owned tier 1 code, which the
# docs module uses too.
#
# The checked record entry serves a module that declares its container's fields as field
# lines in its data file: fields_own reads them through the storage core's data reader, and
# fields_put, fields_set, and fields_get run the validator on the module's own records, so a
# put fills the defaults at write and a get fills the read defaults. A module declaring no
# field line never calls them.

# STORE_LIB_NS: the caller's namespace once the first storage call found it; emptied when the
# library is sourced, so a value a parent shell left never stands for this script
STORE_LIB_NS=""

# store_lib_ns <function label>: the caller lookup, setting STORE_LIB_NS (never in a
# subshell, so the answer stays for the shell's later calls); rc 0, or rc 1 with one line
store_lib_ns() {
  [ -z "$STORE_LIB_NS" ] || return 0
  sln_p=$0
  case "$sln_p" in
    /*) ;;
    *)
      printf "%s: error: the calling script runs by a relative path, so its module cannot be found (run it by its absolute path, as ctx dispatch does) (ERR_INVALID_ARGUMENT)\n" "$1" >&2
      return 1
      ;;
  esac
  sln_out=""
  sln_rest=${sln_p#/}
  while [ -n "$sln_rest" ]; do
    case "$sln_rest" in
      */*) sln_seg=${sln_rest%%/*}; sln_rest=${sln_rest#*/} ;;
      *) sln_seg=$sln_rest; sln_rest="" ;;
    esac
    case "$sln_seg" in
      ""|.) ;;
      ..) sln_out=${sln_out%/*} ;;
      *) sln_out="$sln_out/$sln_seg" ;;
    esac
  done
  sln_d=${sln_out%/*}
  while [ -n "$sln_d" ]; do
    if [ -f "$sln_d/module" ]; then
      STORE_LIB_NS=${sln_d##*/}
      return 0
    fi
    sln_d=${sln_d%/*}
  done
  printf "%s: error: the calling script sits in no module folder (no folder above it holds a module manifest), so it has no namespace (ERR_INVALID_ARGUMENT)\n" "$1" >&2
  return 1
}

# store_namespace: the caller's namespace on stdout, the installed folder name of the calling
# script's module; rc 1 with the lookup's one line when there is none
store_namespace() {
  store_lib_ns store.namespace || return $?
  printf '%s\n' "$STORE_LIB_NS"
}

# store_lib_root: the workspace root the store calls run in
store_lib_root() {
  if [ -n "${CTX_STORE_ROOT:-}" ]; then
    printf '%s\n' "$CTX_STORE_ROOT"
    return 0
  fi
  if [ -n "${CTX_ROOT:-}" ]; then
    printf '%s\n' "$CTX_ROOT"
    return 0
  fi
  printf '%s\n' "$PWD"
}

# store_lib_resolver: the resolver path, CTX_STORE_RESOLVER when set, else the core under
# the drawer or the base mirror
store_lib_resolver() {
  if [ -n "${CTX_STORE_RESOLVER:-}" ]; then
    printf '%s\n' "$CTX_STORE_RESOLVER"
    return 0
  fi
  slr_root=$(store_lib_root)
  for slr_c in "$slr_root/.contexture/storage/scripts/driver-resolver" \
               "$slr_root/base/.contexture/storage/scripts/driver-resolver"; do
    if [ -x "$slr_c" ]; then
      printf '%s\n' "$slr_c"
      return 0
    fi
  done
  return 1
}

# store_lib_call <function label> <resolver arguments...>: one resolver call from the
# workspace root, stdin passed through, CTX_DIR unset, CTX_ROOT exported
store_lib_call() {
  slc_fn=$1
  shift
  slc_root=${CTX_STORE_ROOT:-${CTX_ROOT:-$PWD}}
  slc_resolver=${CTX_STORE_RESOLVER:-}
  if [ -z "$slc_resolver" ]; then
    if [ -x "$slc_root/.contexture/storage/scripts/driver-resolver" ]; then
      slc_resolver="$slc_root/.contexture/storage/scripts/driver-resolver"
    elif [ -x "$slc_root/base/.contexture/storage/scripts/driver-resolver" ]; then
      slc_resolver="$slc_root/base/.contexture/storage/scripts/driver-resolver"
    else
      printf '%s: error: the storage core resolver is not installed (ERR_DRIVER_NOT_FOUND)\n' "$slc_fn" >&2
      return 2
    fi
  fi
  if [ ! -d "$slc_root/.contexture" ]; then
    printf '%s: error: the workspace root is not a folder (ERR_INVALID_ARGUMENT)\n' "$slc_fn" >&2
    return 2
  fi
  (
    unset CTX_DIR
    CTX_ROOT=$slc_root
    export CTX_ROOT
    cd "$slc_root" || exit 2
    exec "$slc_resolver" "$@"
  )
}

# store_lib_own <function>: one store function over the caller's own namespace, the namespace
# found by the caller lookup and passed to the driver ahead of the caller's arguments
store_lib_own() {
  slo_fn=$1
  shift
  store_lib_ns "$slo_fn" || return $?
  store_lib_call "$slo_fn" "$slo_fn" "$STORE_LIB_NS" "$@"
}

store_list() { store_lib_own store.list "$@"; }
store_get() { store_lib_own store.get "$@"; }
store_put() { store_lib_own store.put "$@"; }
store_delete() { store_lib_own store.delete "$@"; }
store_changes() { store_lib_own store.changes "$@"; }
store_require() { store_lib_call store.require require "$@"; }
store_has() { store_lib_call store.has has "$@"; }
store_promote() { store_lib_own store.promote "$@"; }

# store_lib_data: the storage core's data reader, found beside the resolver this library
# calls (the core scripts folder holds both), then under the drawer, then in the base mirror
store_lib_data() {
  sld_root=$(store_lib_root)
  sld_beside=""
  if sld_resolver=$(store_lib_resolver); then sld_beside="${sld_resolver%/*}/store-data"; fi
  for sld_c in "$sld_beside" "$sld_root/.contexture/storage/scripts/store-data" \
               "$sld_root/base/.contexture/storage/scripts/store-data"; do
    if [ -n "$sld_c" ] && [ -x "$sld_c" ]; then printf '%s\n' "$sld_c"; return 0; fi
  done
  return 1
}

# store_get_into <targets>: the batched read into files. <targets> holds one <key> TAB
# <path> line per key in the asked order; one store.get call answers every key (the one key
# form for a single key), each present value lands in its path byte for byte, and one line
# per key prints on stdout in the asked order: 1 TAB <key> for a present key, 0 TAB <key>
# for an absent one. A refused call passes its rc and its one stderr line through with
# nothing on stdout, and a read served from a deprecated root keeps its notice on stderr.
# The scratch is <targets>.ans and <targets>.err, beside the caller's file.
store_get_into() {
  sgi_t=$1
  store_lib_ns store.get || return $?
  sgi_ns=$STORE_LIB_NS
  set --
  while IFS='	' read -r sgi_k sgi_p; do
    [ -n "$sgi_k" ] && set -- "$@" "$sgi_k"
  done < "$sgi_t"
  [ $# -gt 0 ] || return 0
  if [ $# -eq 1 ]; then
    sgi_p=$(LC_ALL=C awk -F '\t' 'NF { print substr($0, length($1) + 2); exit }' "$sgi_t")
    store_get "$1" > "$sgi_p" 2> "$sgi_t.err" < /dev/null
    sgi_rc=$?
    if [ "$sgi_rc" -eq 0 ]; then
      cat "$sgi_t.err" >&2
      printf '1\t%s\n' "$1"
      return 0
    fi
    rm -f "$sgi_p"
    if [ "$sgi_rc" -eq 1 ] && [ "$(cat "$sgi_t.err")" = "store.get: error: key '$1' not found in namespace '$sgi_ns' (ERR_ENTITY_NOT_FOUND)" ]; then
      printf '0\t%s\n' "$1"
      return 0
    fi
    cat "$sgi_t.err" >&2
    return "$sgi_rc"
  fi
  store_get "$@" > "$sgi_t.ans" 2> "$sgi_t.err" < /dev/null
  sgi_rc=$?
  if [ "$sgi_rc" -ne 0 ]; then
    cat "$sgi_t.err" >&2
    return "$sgi_rc"
  fi
  sgi_pack=""
  if sgi_r=$(store_lib_resolver); then sgi_pack="${sgi_r%/*}/store-pack"; fi
  sgi_root=$(store_lib_root)
  for sgi_c in "$sgi_pack" "$sgi_root/.contexture/storage/scripts/store-pack" "$sgi_root/base/.contexture/storage/scripts/store-pack"; do
    if [ -n "$sgi_c" ] && [ -x "$sgi_c" ]; then sgi_pack=$sgi_c; break; fi
    sgi_pack=""
  done
  if [ -z "$sgi_pack" ]; then
    printf 'store.get: error: the storage core codec is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  fi
  "$sgi_pack" unpack "$sgi_t.ans" "$sgi_t" || return 2
  cat "$sgi_t.err" >&2
  return 0
}

# store_roots: the declared store roots, namespace TAB root per line (a fallback root on its
# own line after the root), from the storage core's data reader found beside the resolver
# this library calls (the core scripts folder holds both), then under the drawer, then in
# the base mirror, run from the workspace root. The reader's lines start with its name and a
# row never does, so one capture holds both; a listing that left a module out (rc 1) or
# failed refuses rc 2 with one line quoting the reader's first reason, never a partial list
store_roots() {
  sr_root=$(store_lib_root)
  sr_script=$(store_lib_data) || {
    printf 'store.roots: error: the storage core data reader is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  }
  sr_out=$(CTX_STORE_WORKSPACE=$sr_root "$sr_script" --list 2>&1)
  sr_rc=$?
  if [ "$sr_rc" -ne 0 ]; then
    sr_why=$(printf '%s\n' "$sr_out" | LC_ALL=C awk 'index($0, "store-data: ") == 1 { print substr($0, 13); exit }')
    if [ "$sr_rc" -eq 1 ]; then
      printf "store.roots: error: a module's data file cannot be read, so no root list is answered (%s) (ERR_STORAGE_READ)\n" "$sr_why" >&2
    else
      printf 'store.roots: error: the module declarations cannot be listed (%s) (ERR_STORAGE_READ)\n' "${sr_why:-the data reader exited $sr_rc}" >&2
    fi
    return 2
  fi
  [ -n "$sr_out" ] || return 0
  printf '%s\n' "$sr_out" | LC_ALL=C awk -F '\t' '{ print $1 "\t" $2; if ($3 != "") print $1 "\t" $3 }'
}

# store_leftovers: what the caller's own namespace's storage holds beyond its keys, the
# configured driver's read only probe storage.leftovers, its one JSON line on stdout (a driver
# that keeps no file tree answers its unknown function line rc 2, passed through)
store_leftovers() { store_lib_own storage.leftovers "$@"; }

# store_leftovers_text <answer> <summary|kinds>: the probe's answer file as text naming no
# folder, through the storage core's flattener found beside the resolver (then under the
# drawer, then in the base mirror). summary prints one line per root, root: and fallback
# root:, its state (absent, a symbolic link, unreadable, none declared) or its keys, its
# entries, and every kind it found with its count and bytes; kinds prints one line per root
# and kind found, <root label>: <kind>: <count> (<bytes> bytes), a root it cannot walk on
# one line too, and nothing when nothing lies beyond the keys. The flattened answer stages
# at <answer>.flat, beside the caller's file; a malformed answer refuses rc 2 with one line
store_leftovers_text() {
  slt_json=""
  if slt_r=$(store_lib_resolver); then slt_json="${slt_r%/*}/json.awk"; fi
  slt_root=$(store_lib_root)
  for slt_c in "$slt_json" "$slt_root/.contexture/storage/scripts/json.awk" "$slt_root/base/.contexture/storage/scripts/json.awk"; do
    if [ -n "$slt_c" ] && [ -f "$slt_c" ]; then slt_json=$slt_c; break; fi
    slt_json=""
  done
  if [ -z "$slt_json" ]; then
    printf 'store.leftovers: error: the storage core flattener is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  fi
  case "${2:-}" in
    summary|kinds) ;;
    *) printf "store.leftovers: error: the text form is summary or kinds: '%s' (ERR_INVALID_ARGUMENT)\n" "${2:-}" >&2; return 1 ;;
  esac
  if ! LC_ALL=C awk -f "$slt_json" < "$1" > "$1.flat" 2>/dev/null; then
    rm -f "$1.flat"
    printf 'store.leftovers: error: the leftovers answer is malformed (ERR_STORAGE_READ)\n' >&2
    return 2
  fi
  SLT_MODE=$2 LC_ALL=C awk '
    function ld(line,   p) {
      if (!match(line, /[=:#]/)) return
      p = substr(line, 1, RSTART - 1)
      V[p] = substr(line, RSTART + 1)
    }
    function root(r, label,   st, i, k, o, n) {
      st = V[r ".state"]
      if (st == "walked") {
        o = ""; n = 0
        for (i = 1; i <= NK; i++) {
          k = KIND[i]
          if (V[r ".kinds." k ".count"] + 0 == 0) continue
          n++
          if (mode == "kinds") printf "%s: %s: %.0f (%.0f bytes)\n", label, NAME[k], V[r ".kinds." k ".count"], V[r ".kinds." k ".bytes"]
          else o = o (o == "" ? "" : ", ") sprintf("%s %.0f (%.0f bytes)", NAME[k], V[r ".kinds." k ".count"], V[r ".kinds." k ".bytes"])
        }
        if (mode == "summary") {
          printf "%s: %.0f keys in %.0f entries", label, V[r ".keys"], V[r ".entries"]
          if (n == 0) printf ", nothing beyond them\n"
          else printf "; beyond them: %s\n", o
        }
      } else if (st == "unreadable") printf "%s: unreadable, so its content cannot be walked\n", label
      else if (st == "link") printf "%s: a symbolic link, which the store does not walk\n", label
      else if (mode == "summary" && st == "absent") printf "%s: absent (not made yet)\n", label
      else if (mode == "summary" && st == "none") printf "%s: none declared\n", label
    }
    BEGIN {
      mode = ENVIRON["SLT_MODE"]
      NK = split("stray_files nonkey_folders empty_folders links special_files unreadable_folders remnants shadowed_keys newline_names", KIND, " ")
      NAME["stray_files"] = "stray files"; NAME["nonkey_folders"] = "folders outside the key shape"
      NAME["empty_folders"] = "empty folders"; NAME["links"] = "symbolic links"
      NAME["special_files"] = "special files"; NAME["unreadable_folders"] = "unreadable folders"
      NAME["remnants"] = "lock or write remnants"; NAME["shadowed_keys"] = "keys the root shadows"
      NAME["newline_names"] = "names holding a newline"
    }
    { ld($0) }
    END { root("root", "root"); root("fallback", "fallback root") }' "$1.flat"
  slt_rc=$?
  rm -f "$1.flat"
  return "$slt_rc"
}

# store_batch: the transactional batch over the caller's namespace; the action list travels
# on stdin as the driver's escaped payload lines (action=<put|delete>, key=<escaped key>,
# head=<sha|none>, value_b64=<base64> for a put), and the driver answers one compact JSON
# line {"namespace","actions":N} or the first failure's one line with the action and key.
store_batch() { store_lib_own store.batch "$@"; }

# store_scan: every key the caller's module pattern admits with its raw value, bytewise, as
# one compact JSON line {"namespace","items":[{"key","value_b64"}]}; the caller decodes the
# base64 value.
store_scan() { store_lib_own store.scan "$@"; }

# store_lib_escape <value>: the payload escape (backslash, newline, tab, carriage return)
store_lib_escape() {
  SLE_S=$1 LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SLE_S"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") out = out "\\" "\\"
      else if (c == "\n") out = out "\\n"
      else if (c == "\t") out = out "\\t"
      else if (c == "\r") out = out "\\r"
      else out = out c
    }
    printf "%s", out
  }'
}

# LIB_UTF8_AWK: the awk function utf8_ok(s), true when s is valid UTF-8 (RFC 3629: no
# overlong form, no surrogate, nothing above U+10FFFF); byte values come from a table built
# with sprintf("%c"), so it runs alike on BWK awk, mawk, gawk, and busybox awk under
# LC_ALL=C (every caller sets it: bytes, never the locale's characters); an ASCII value
# takes the fast path, one match against a class of the bytes 1 to 127
LIB_UTF8_AWK='
function utf8_ok(s,   n, i, j, c, need, lo, hi) {
  if (s ~ /^[\001-\177]*$/) return 1
  if (!U8_T) { for (i = 1; i < 256; i++) U8_ORD[sprintf("%c", i)] = i; U8_T = 1 }
  n = length(s); i = 1
  while (i <= n) {
    c = U8_ORD[substr(s, i, 1)]
    if (c < 128) { i++; continue }
    if (c >= 194 && c <= 223) { need = 1; lo = 128; hi = 191 }
    else if (c == 224) { need = 2; lo = 160; hi = 191 }
    else if (c >= 225 && c <= 236) { need = 2; lo = 128; hi = 191 }
    else if (c == 237) { need = 2; lo = 128; hi = 159 }
    else if (c == 238 || c == 239) { need = 2; lo = 128; hi = 191 }
    else if (c == 240) { need = 3; lo = 144; hi = 191 }
    else if (c >= 241 && c <= 243) { need = 3; lo = 128; hi = 191 }
    else if (c == 244) { need = 3; lo = 128; hi = 143 }
    else return 0
    if (i + need > n) return 0
    c = U8_ORD[substr(s, i + 1, 1)]
    if (c < lo || c > hi) return 0
    for (j = 2; j <= need; j++) { c = U8_ORD[substr(s, i + j, 1)]; if (c < 128 || c > 191) return 0 }
    i += need + 1
  }
  return 1
}
'

# lib_utf8_ok <string>: rc 0 when the string is valid UTF-8, 1 when not, 2 when the check
# cannot run; silent (an argv string never holds a NUL)
lib_utf8_ok() {
  LIB_V=$1 LC_ALL=C awk "$LIB_UTF8_AWK"'BEGIN { if (utf8_ok(ENVIRON["LIB_V"])) exit 0; exit 3 }' < /dev/null
  case $? in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# lib_utf8_file_ok <file>: rc 0 when every line of the file is valid UTF-8, 1 when one is
# not, 2 when the file cannot be read; silent. A NUL byte is the caller's own check, since
# not every awk reads one.
lib_utf8_file_ok() {
  [ -f "$1" ] && [ -r "$1" ] || return 2
  LC_ALL=C awk "$LIB_UTF8_AWK"'{ if (!utf8_ok($0)) exit 3 }' "$1"
  case $? in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# lib_ref_ok <label> <ref>: the shape of a full address, <owner>#<path>: the owner is the
# text before the first hash (lowercase letters, digits, dot, underscore, and dash, starting
# with a letter or digit), the path every byte after it (non-empty; a further hash belongs
# to it, as in file#<path>#<symbol>), and the whole value one token: no ASCII blank, no
# control character, no double quote, and no Unicode blank of the White_Space set (NEL,
# NBSP, U+1680, U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F, U+3000, as UTF-8 byte
# strings built by printf so no such byte sits in this file). Shape only: whether the owner
# is installed or the target exists is the caller's. rc 0, or rc 1 with one stderr line
# naming the ref (its newline, tab, carriage return, and backslash written by the payload
# escape, so the line stays one), or rc 2 when the check cannot run.
lib_ref_ok() {
  LIB_R=$2 LIB_B=$(printf '\302\205|\302\240|\341\232\200|\342\200\200|\342\200\201|\342\200\202|\342\200\203|\342\200\204|\342\200\205|\342\200\206|\342\200\207|\342\200\210|\342\200\211|\342\200\212|\342\200\250|\342\200\251|\342\200\257|\342\201\237|\343\200\200|') LC_ALL=C awk 'BEGIN {
    r = ENVIRON["LIB_R"]
    if (r ~ /[\001-\040"\177]/) exit 3
    n = split(ENVIRON["LIB_B"], B, /\|/)
    for (i = 1; i < n; i++) if (index(r, B[i])) exit 3
    h = index(r, "#")
    if (h < 2 || h == length(r)) exit 3
    if (substr(r, 1, h - 1) !~ /^[a-z0-9][a-z0-9._-]*$/) exit 3
    exit 0
  }' < /dev/null
  case $? in
    0) return 0 ;;
    3) printf "%s: error: malformed ref '%s': a reference is <owner>#<path>, one token without blanks, control characters, or double quotes (ERR_INVALID_ARGUMENT)\n" "$1" "$(store_lib_escape "$2")" >&2; return 1 ;;
    *) return 2 ;;
  esac
}

# lib_lock: the library lock of the caller's namespace (the caller lookup's answer), a lock
# folder under the drawer's scratch in the library's own family, holding the holder's pid
# (the calling shell's $$); LIB_LOCK names it while held. A waiter removes a lock whose
# holder pid is gone (kill -0), gives a pid-less lock ten polls of grace, and refuses a live
# holder rc 2 ERR_STORAGE_LOCKED after 600 polls 0.1 s apart (where sleep refuses a fraction
# a poll sleeps 1 s and counts as ten), the wait the unit lock and the drivers' namespace
# locks share. An argument (the lock takes no namespace), a caller with no namespace, a
# malformed namespace, or a second lock in a process that holds one refuses rc 1
# ERR_INVALID_ARGUMENT, and a lock folder or pid that cannot be written rc 2
# ERR_STORAGE_WRITE, each with one line. The namespace classes spell every letter, since a
# range follows the caller's locale.
lib_lock() {
  if [ $# -ne 0 ]; then
    printf "lib.lock: error: lib_lock takes no argument: it locks the calling module's own namespace (ERR_INVALID_ARGUMENT)\n" >&2
    return 1
  fi
  store_lib_ns lib.lock || return $?
  ll_ns=$STORE_LIB_NS
  case "$ll_ns" in
    [abcdefghijklmnopqrstuvwxyz0123456789]*)
      case "$ll_ns" in *[!abcdefghijklmnopqrstuvwxyz0123456789._-]*) ll_ns="" ;; esac ;;
    *) ll_ns="" ;;
  esac
  if [ -z "$ll_ns" ]; then
    printf "lib.lock: error: malformed namespace '%s' (ERR_INVALID_ARGUMENT)\n" "$(store_lib_escape "$STORE_LIB_NS")" >&2
    return 1
  fi
  if [ -n "${LIB_LOCK:-}" ]; then
    printf "lib.lock: error: this process already holds a library lock; release it before taking the lock of '%s' (ERR_INVALID_ARGUMENT)\n" "$ll_ns" >&2
    return 1
  fi
  ll_dir="$(store_lib_root)/.contexture/tmp/locks/lib"
  mkdir -p "$ll_dir" 2>/dev/null || {
    printf "lib.lock: error: cannot create the library lock folder of '%s' (ERR_STORAGE_WRITE)\n" "$ll_ns" >&2
    return 2
  }
  ll_lock="$ll_dir/$ll_ns.lock"
  ll_n=0
  ll_m=0
  while [ "$ll_n" -lt 600 ]; do
    if mkdir "$ll_lock" 2>/dev/null; then
      { printf '%s\n' "$$" > "$ll_lock/pid"; } 2>/dev/null || {
        rm -rf "$ll_lock" 2>/dev/null
        printf "lib.lock: error: cannot write the library lock holder pid of '%s' (ERR_STORAGE_WRITE)\n" "$ll_ns" >&2
        return 2
      }
      LIB_LOCK=$ll_lock
      return 0
    fi
    ll_p=$(cat "$ll_lock/pid" 2>/dev/null)
    case "$ll_p" in
      ""|*[!0-9]*)
        ll_m=$((ll_m + 1))
        if [ "$ll_m" -ge 10 ]; then rm -rf "$ll_lock" 2>/dev/null; ll_m=0; continue; fi
        ;;
      *)
        if kill -0 "$ll_p" 2>/dev/null; then ll_m=0
        else rm -rf "$ll_lock" 2>/dev/null; continue
        fi
        ;;
    esac
    ll_n=$((ll_n + 1))
    sleep 0.1 2>/dev/null || { sleep 1; ll_n=$((ll_n + 9)); }
  done
  printf "lib.lock: error: the library lock of '%s' is held (60 s timeout) (ERR_STORAGE_LOCKED)\n" "$ll_ns" >&2
  return 2
}

# lib_unlock: removes the library lock this process holds; a no-op when it holds none
lib_unlock() {
  if [ -n "${LIB_LOCK:-}" ]; then
    rm -rf "$LIB_LOCK" 2>/dev/null
    LIB_LOCK=""
  fi
  return 0
}

# LIB_FIELDS_RESERVED and LIB_FIELDS_RESERVED_PREFIXES: the field names a declaration may not
# take, since each field becomes a flag (--<name>, --add-<name>, --remove-<name>) beside the
# shared flags and the value controls --unset and --stdin
LIB_FIELDS_RESERVED='json limit type mode container id ref unset stdin'
LIB_FIELDS_RESERVED_PREFIXES='add- remove-'

# fields_reserved_ok <name>: rc 1 for a reserved field name, rc 0 otherwise; silent
fields_reserved_ok() {
  for frk_n in $LIB_FIELDS_RESERVED; do
    [ "${1:-}" = "$frk_n" ] && return 1
  done
  for frk_p in $LIB_FIELDS_RESERVED_PREFIXES; do
    case "${1:-}" in "$frk_p"*) return 1 ;; esac
  done
  return 0
}

# store_lib_fields: the storage core's field validator engine, found beside the resolver this
# library calls (the core scripts folder holds both), then under the drawer, then in the base
# mirror
store_lib_fields() {
  slf_root=$(store_lib_root)
  slf_beside=""
  if slf_r=$(store_lib_resolver); then slf_beside="${slf_r%/*}/store-fields.awk"; fi
  for slf_c in "$slf_beside" "$slf_root/.contexture/storage/scripts/store-fields.awk" \
               "$slf_root/base/.contexture/storage/scripts/store-fields.awk"; do
    if [ -n "$slf_c" ] && [ -f "$slf_c" ]; then printf '%s\n' "$slf_c"; return 0; fi
  done
  return 1
}

# fields_run <mode> <label> <declaration> <record> <actions>: one engine run, its answer on
# stdout and its refusal line on stderr; an unreadable input file refuses rc 2 naming its role
fields_run() {
  fr_mode=$1
  fr_label=$2
  shift 2
  fr_awk=$(store_lib_fields) || {
    printf '%s: error: the storage core field validator is not installed (ERR_DRIVER_NOT_FOUND)\n' "$fr_label" >&2
    return 2
  }
  for fr_role in declaration record actions; do
    if [ ! -f "$1" ] || [ ! -r "$1" ]; then
      [ "$1" = /dev/null ] || {
        printf '%s: error: cannot read the %s file (ERR_STORAGE_READ)\n' "$fr_label" "$fr_role" >&2
        return 2
      }
    fi
    case $fr_role in
      declaration) fr_d=$1 ;;
      record) fr_r=$1 ;;
      actions) fr_a=$1 ;;
    esac
    shift
  done
  fr_prog=$(cat "$fr_awk") || {
    printf '%s: error: cannot read the storage core field validator (ERR_STORAGE_READ)\n' "$fr_label" >&2
    return 2
  }
  SF_MODE=$fr_mode SF_LABEL=$fr_label SF_TODAY=$(date +%Y-%m-%d) SF_RESERVED=$LIB_FIELDS_RESERVED \
    SF_RESERVED_PREFIXES=$LIB_FIELDS_RESERVED_PREFIXES LC_ALL=C \
    awk "$LIB_UTF8_AWK$fr_prog" part=1 "$fr_d" part=2 "$fr_r" part=3 "$fr_a" < /dev/null
}

# fields_decl_check <declaration>: every field line of a declaration file checked: the name
# (lowercase letters, digits, underscore, and dash, starting with a letter, never reserved,
# never twice), the clauses in their fixed order, a block taking no list, one-of, or default,
# a list no default, a required field no default, a default inside its one-of set (the
# dynamic today with none), one blank between clauses with none trailing, and no clause but a
# default after the one-of set; rc 0 silent, or rc 1 with one line naming the field and clause
fields_decl_check() {
  if [ $# -ne 1 ]; then
    printf 'fields.decl_check: error: takes one declaration file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fields_run decl fields.decl_check "$1" /dev/null /dev/null > /dev/null
}

# fields_apply <declaration> <old record> <actions> <new record>: a write's actions applied to
# the old record (an empty one means create), the canonical result written to the new record
# file; checks in order: the action lines and block bodies, UTF-8, a newline or carriage
# return in a line value (a carriage return in a block), an empty value, an unknown field
# (an unset of a leftover field the record holds is accepted), a value outside its one-of
# set, the action against the field's shape, an item added twice or removed absent, a
# required field an unset or remove leaves absent, then a required field absent from the
# result. Defaults fill at create only (today the write's date); an update leaves an absent
# field absent. A refusal writes nothing, and the old record is never touched.
fields_apply() {
  if [ $# -ne 4 ]; then
    printf 'fields.apply: error: takes a declaration, an old record, an actions file, and a new record file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fa_tmp="$4.fields.$$"
  : > "$fa_tmp" 2>/dev/null || {
    printf 'fields.apply: error: cannot write the new record (ERR_STORAGE_WRITE)\n' >&2
    return 2
  }
  fields_run apply fields.apply "$1" "$2" "$3" > "$fa_tmp"
  fa_rc=$?
  if [ "$fa_rc" -ne 0 ]; then
    rm -f "$fa_tmp"
    return "$fa_rc"
  fi
  mv -f "$fa_tmp" "$4" 2>/dev/null || {
    rm -f "$fa_tmp"
    printf 'fields.apply: error: cannot write the new record (ERR_STORAGE_WRITE)\n' >&2
    return 2
  }
  return 0
}

# fields_effective <declaration> <record>: the record on stdout with each absent field that
# carries a static default filled with it, computed at read and never stored (a today default
# is never computed at read), so a reader and a filter agree
fields_effective() {
  if [ $# -ne 2 ]; then
    printf 'fields.effective: error: takes a declaration and a record file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fields_run effective fields.effective "$1" "$2" /dev/null
}

# fields_conforms <declaration> <record>: one stdout line <field>: <reason> per field that
# breaks the current declaration (a required field absent, a value outside its one-of set, a
# single field holding several values, a shape other than the declared one, a leftover field
# no longer declared), rc 1 when any line printed, rc 0 when the record conforms; a refusal
# prints its one line on stderr and nothing on stdout
fields_conforms() {
  if [ $# -ne 2 ]; then
    printf 'fields.conforms: error: takes a declaration and a record file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fields_run conforms fields.conforms "$1" "$2" /dev/null
}

# fields_own <declaration>: the caller's declared fields written to the declaration file, one
# <name>: <spec> field line each in declaration order, read from its data file's field lines
# through the storage core's data reader (store-data <namespace> --with-fields), an empty
# file when the data file declares none. The reader's refusal is re-framed under the
# function's label: a namespace no data file declares rc 1 ERR_ENTITY_NOT_FOUND, a malformed
# declaration (a field line among them) rc 1 ERR_INVALID_ARGUMENT, an unreadable one rc 2
# ERR_STORAGE_READ. The scratch is <declaration>.ans and <declaration>.err, removed on return.
fields_own() {
  if [ $# -ne 1 ]; then
    printf 'fields.own: error: takes one declaration file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fields_own_into fields.own "$1"
}

# fields_own_into <label> <declaration>: fields_own under the calling function's label
fields_own_into() {
  foi_l=$1
  foi_d=$2
  store_lib_ns "$foi_l" || return $?
  foi_script=$(store_lib_data) || {
    printf '%s: error: the storage core data reader is not installed (ERR_DRIVER_NOT_FOUND)\n' "$foi_l" >&2
    return 2
  }
  { : > "$foi_d.ans" && : > "$foi_d.err"; } 2>/dev/null || {
    rm -f "$foi_d.ans" "$foi_d.err"
    printf '%s: error: cannot write the declaration file (ERR_STORAGE_WRITE)\n' "$foi_l" >&2
    return 2
  }
  CTX_STORE_WORKSPACE=$(store_lib_root) "$foi_script" "$STORE_LIB_NS" --with-fields > "$foi_d.ans" 2> "$foi_d.err"
  foi_rc=$?
  if [ "$foi_rc" -ne 0 ]; then
    foi_msg=$(sed -n 1p "$foi_d.err")
    rm -f "$foi_d.ans" "$foi_d.err"
    foi_msg=${foi_msg#store-data: }
    [ -n "$foi_msg" ] || foi_msg="the data file of namespace '$STORE_LIB_NS' cannot be read"
    case "$foi_rc" in
      3) printf '%s: error: %s (ERR_ENTITY_NOT_FOUND)\n' "$foi_l" "$foi_msg" >&2; return 1 ;;
      2) printf '%s: error: %s (ERR_STORAGE_READ)\n' "$foi_l" "$foi_msg" >&2; return 2 ;;
      *) printf '%s: error: %s (ERR_INVALID_ARGUMENT)\n' "$foi_l" "$foi_msg" >&2; return 1 ;;
    esac
  fi
  LC_ALL=C awk -F '\t' '$1 == "@field" { print substr($0, 8) }' "$foi_d.ans" > "$foi_d" 2>/dev/null || {
    rm -f "$foi_d.ans" "$foi_d.err"
    printf '%s: error: cannot write the declaration file (ERR_STORAGE_WRITE)\n' "$foi_l" >&2
    return 2
  }
  rm -f "$foi_d.ans" "$foi_d.err"
  return 0
}

# fields_clean <record>: the checked record entry's scratch beside the record file removed
fields_clean() {
  rm -f "$1.decl" "$1.old" "$1.new" "$1.t" "$1.t.out" "$1.t.ans" "$1.t.err"
}

# fields_read <label> <key> <record>: the caller's declared fields in <record>.decl (a
# namespace declaring none refused rc 1) and the key's stored record in <record>.old,
# frd_have 1 when the key is present and 0 when it is absent; a refusal leaves no scratch
fields_read() {
  frd_l=$1
  frd_k=$2
  frd_r=$3
  fields_own_into "$frd_l" "$frd_r.decl" || return $?
  if [ ! -s "$frd_r.decl" ]; then
    fields_clean "$frd_r"
    printf "%s: error: namespace '%s' declares no fields (its data file carries no field line) (ERR_INVALID_ARGUMENT)\n" "$frd_l" "$STORE_LIB_NS" >&2
    return 1
  fi
  printf '%s\t%s\n' "$frd_k" "$frd_r.old" > "$frd_r.t" 2>/dev/null || {
    fields_clean "$frd_r"
    printf '%s: error: cannot write the record file (ERR_STORAGE_WRITE)\n' "$frd_l" >&2
    return 2
  }
  store_get_into "$frd_r.t" > "$frd_r.t.out"
  frd_rc=$?
  if [ "$frd_rc" -ne 0 ]; then
    fields_clean "$frd_r"
    return "$frd_rc"
  fi
  case $(cat "$frd_r.t.out") in
    1*) frd_have=1 ;;
    *) frd_have=0 ;;
  esac
  return 0
}

# fields_put <key> <actions> <record>: a checked create of one record of the caller's own
# namespace. Under the library lock (the one the caller holds, else its own for the call),
# the declared fields are read by fields_own, an existing key refuses rc 1 ERR_ENTITY_EXISTS,
# the actions (fields_apply's actions file) apply to an empty record with the defaults filled
# at write (today the write's date), and the canonical record is put at the key and written
# to the record file. fields_set <key> <actions> <record> is the checked change: a missing
# key refuses rc 1 ERR_ENTITY_NOT_FOUND and the actions apply to the stored record, an absent
# field staying absent. A namespace whose data file declares no field line refuses rc 1
# ERR_INVALID_ARGUMENT; the validator's refusal carries the function's label, a store
# function's or the lock's refusal passes through as its own line, and a refusal writes
# nothing. The scratch sits beside the record file (<record>.decl, .old, .new, and .t with
# its answers), removed on return.
fields_put() {
  if [ $# -ne 3 ]; then
    printf 'fields.put: error: takes a key, an actions file, and a record file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fields_write fields.put 1 "$@"
}

fields_set() {
  if [ $# -ne 3 ]; then
    printf 'fields.set: error: takes a key, an actions file, and a record file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fields_write fields.set 0 "$@"
}

# fields_write <label> <create> <key> <actions> <record>: the checked write under the lock
fields_write() {
  if [ -n "${LIB_LOCK:-}" ]; then
    fields_write_held "$@"
    return $?
  fi
  lib_lock || return $?
  fields_write_held "$@"
  fw_rc=$?
  lib_unlock
  return "$fw_rc"
}

# fields_write_held <label> <create> <key> <actions> <record>: the checked write, the lock held
fields_write_held() {
  fwh_l=$1
  fwh_c=$2
  fwh_k=$3
  fwh_a=$4
  fwh_r=$5
  if [ ! -f "$fwh_a" ] || [ ! -r "$fwh_a" ]; then
    printf '%s: error: cannot read the actions file (ERR_STORAGE_READ)\n' "$fwh_l" >&2
    return 2
  fi
  fields_read "$fwh_l" "$fwh_k" "$fwh_r" || return $?
  if [ "$fwh_c" -eq 1 ] && [ "$frd_have" -eq 1 ]; then
    fields_clean "$fwh_r"
    printf "%s: error: key '%s' already exists in namespace '%s' (ERR_ENTITY_EXISTS)\n" "$fwh_l" "$fwh_k" "$STORE_LIB_NS" >&2
    return 1
  fi
  if [ "$fwh_c" -eq 0 ] && [ "$frd_have" -eq 0 ]; then
    fields_clean "$fwh_r"
    printf "%s: error: key '%s' not found in namespace '%s' (ERR_ENTITY_NOT_FOUND)\n" "$fwh_l" "$fwh_k" "$STORE_LIB_NS" >&2
    return 1
  fi
  [ "$fwh_c" -eq 0 ] || : > "$fwh_r.old"
  fields_run apply "$fwh_l" "$fwh_r.decl" "$fwh_r.old" "$fwh_a" > "$fwh_r.new"
  fwh_rc=$?
  if [ "$fwh_rc" -eq 0 ]; then
    store_put "$fwh_k" < "$fwh_r.new" > /dev/null
    fwh_rc=$?
  fi
  if [ "$fwh_rc" -eq 0 ]; then
    mv -f "$fwh_r.new" "$fwh_r" 2>/dev/null || {
      printf '%s: error: the record landed, but the record file cannot be written (ERR_STORAGE_WRITE)\n' "$fwh_l" >&2
      fwh_rc=2
    }
  fi
  fields_clean "$fwh_r"
  return "$fwh_rc"
}

# fields_get <key> <record>: one record of the caller's own namespace written to the record
# file with each absent static default filled at read and never stored (fields_effective's
# rule, a today default never filled at read), read only and lock free; a missing key refuses
# rc 1 ERR_ENTITY_NOT_FOUND, a namespace declaring no field line rc 1 ERR_INVALID_ARGUMENT
fields_get() {
  if [ $# -ne 2 ]; then
    printf 'fields.get: error: takes a key and a record file (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  fg_k=$1
  fg_r=$2
  fields_read fields.get "$fg_k" "$fg_r" || return $?
  if [ "$frd_have" -eq 0 ]; then
    fields_clean "$fg_r"
    printf "fields.get: error: key '%s' not found in namespace '%s' (ERR_ENTITY_NOT_FOUND)\n" "$fg_k" "$STORE_LIB_NS" >&2
    return 1
  fi
  fields_run effective fields.get "$fg_r.decl" "$fg_r.old" /dev/null > "$fg_r.new"
  fg_rc=$?
  if [ "$fg_rc" -eq 0 ]; then
    mv -f "$fg_r.new" "$fg_r" 2>/dev/null || {
      printf 'fields.get: error: cannot write the record file (ERR_STORAGE_WRITE)\n' >&2
      fg_rc=2
    }
  fi
  fields_clean "$fg_r"
  return "$fg_rc"
}

# store_search <query> <mode> [<limit>]: the library's search entry over the caller's
# namespace; the query travels on stdin as the escaped query= payload line and the driver
# answers the store's one result shape
store_search() {
  ss_q=${1:-}; ss_mode=${2:-}; ss_lim=${3:-20}
  store_lib_ns store.search || return $?
  printf 'query=%s\n' "$(store_lib_escape "$ss_q")" | store_lib_call store.search store.search "$STORE_LIB_NS" "$ss_mode" "$ss_lim"
}

# store_modes [--own]: the search mode registry, one name TAB description line per mode in
# the configured driver's order, the modes being registered by the driver's descriptor and
# never declared by a module (exact is always among them). With --own it answers the modes
# the caller's own namespace can answer: exact always, a ranked mode only when its data file
# declares a search schema, since a ranked mode reads the documents a schema derives. Any
# other argument refuses rc 1 ERR_INVALID_ARGUMENT, a namespace no data file declares rc 1
# ERR_ENTITY_NOT_FOUND, a missing reader or resolver rc 2.
store_modes() {
  if [ $# -gt 1 ] || { [ $# -eq 1 ] && [ "$1" != --own ]; }; then
    printf 'store.modes: error: store.modes takes no argument but --own (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  if [ $# -eq 1 ]; then store_lib_ns store.modes || return $?; fi
  sm_reg=$(store_lib_call store.modes modes < /dev/null) || return $?
  if [ $# -eq 0 ]; then
    [ -z "$sm_reg" ] || printf '%s\n' "$sm_reg"
    return 0
  fi
  sm_script=$(store_lib_data) || {
    printf 'store.modes: error: the storage core data reader is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  }
  sm_out=$(CTX_STORE_WORKSPACE=$(store_lib_root) "$sm_script" "$STORE_LIB_NS" 2>&1)
  sm_rc=$?
  if [ "$sm_rc" -ne 0 ]; then
    sm_msg=$(printf '%s\n' "$sm_out" | head -n 1)
    sm_msg=${sm_msg#store-data: }
    case "$sm_rc" in
      3) printf 'store.modes: error: %s (ERR_ENTITY_NOT_FOUND)\n' "$sm_msg" >&2; return 1 ;;
      2) printf 'store.modes: error: %s (ERR_STORAGE_READ)\n' "$sm_msg" >&2; return 2 ;;
      *) printf 'store.modes: error: %s (ERR_INVALID_ARGUMENT)\n' "$sm_msg" >&2; return 1 ;;
    esac
  fi
  sm_form=$(printf '%s\n' "$sm_out" | sed -n '7p')
  printf '%s\n' "$sm_reg" | SM_FORM="$sm_form" LC_ALL=C awk -F '\t' '$1 != "" && ($1 == "exact" || ENVIRON["SM_FORM"] != "")'
}
