#!/bin/sh
# library: the storage core's module-facing interface, sourced by a module's scripts and
# data script (no summary line, so the engine never lists it). It is the one door from a
# module to the configured storage driver, and the one door from a source module to a
# target module's data script:
#
#   store.list <namespace> [<prefix>]
#   store.get <namespace> <key> [<key>...]                          (two or more: one JSON line)
#   store.get.into <namespace> <targets>                            (the batched read into files)
#   store.put <namespace> <key> [--op=<op>] [--head=<sha|none>]     (payload on stdin)
#   store.delete <namespace> <key> [--op=<op>] [--head=<sha|none>]
#   store.changes <namespace>                                        (heads on stdin)
#   store.batch <namespace>                                          (actions on stdin)
#   store.scan <namespace>
#   store.search <namespace> <query> <mode> [<limit>]                (query on stdin; 0 = all)
#   store.modes [<namespace>]
#   store.promote <namespace> <prefix>                              (optional capability)
#   store.require <capability>...
#   store.has <capability>
#   store.roots
#   data.get <ref>
#   data.emit <ref> <data>
#   lib.utf8_ok <string>, lib.utf8_file_ok <file>                   (the shared checks)
#   lib.ref_ok <label> <ref>
#
# The store functions and the two probes reach the configured driver through the storage
# core's resolver; the caller uses the shell function names store_list, store_get,
# store_put, store_delete, store_changes, store_batch, store_scan, store_search,
# store_promote, store_require, and store_has. store_promote moves a whole key prefix from
# the namespace's fallback root to its root on a driver that declares store.promote (ask
# store_has store.promote first). store_get with one key answers the raw value; with two
# or more it answers the driver's one batched line, which store_get_into decodes into files.
# The
# caller sets CTX_STORE_ROOT to the workspace root (the engine exports CTX_ROOT, which
# serves when CTX_STORE_ROOT is absent) and may set CTX_STORE_RESOLVER to an exact
# resolver path; the core resolver is found under the drawer, then the base mirror.
#
# store_roots reads the module declarations, never the driver: one line per declared store
# root, the namespace and the root separated by a tab, sorted by namespace, a namespace
# that declares a fallback root answering it on a second line after its root, through the
# storage core's data reader in its listing mode (store-data --list, whose third column
# carries the fallback). A malformed or doubly declared namespace is left out with its line
# on stderr; with no data reader or no module drawer it refuses rc 2 with one line.
#
# data_get <ref> resolves a module reference <module>#<symbol>: it finds the target
# module's data script in the workspace modules, the workspace extensions, or the base
# mirror of either (modules/<module>/scripts/data and
# extensions/modules/<module>/scripts/data), runs it with data_get, and prints the
# envelope the script emits through data_emit. A ref chain is bounded at 8 hops and a
# repeated ref in the chain refuses as a cycle. data_emit <ref> <data> is the target data
# script's helper: it prints one compact JSON envelope {"ref":"<ref>","data":<data>} and
# the data must already be compact JSON. The source write's validation of a new ref is
# the unit module's later; this library is the mechanism it calls.
#
# A refusal is one stderr line with a fixed code (ERR_INVALID_ARGUMENT,
# ERR_ENTITY_NOT_FOUND, or the target's own code re-framed with the ref). The resolver's
# own driver-resolver: line is passed through unchanged, the one shape exception.
#
# The shared checks validate a value a module asks about and print nothing: lib_utf8_ok
# and lib_utf8_file_ok answer rc 0 for valid UTF-8, 1 for anything else, 2 when the check
# cannot run; LIB_UTF8_AWK is the awk text of the same check for a caller that folds it
# into its own awk program. lib_ref_ok checks the shape of a full address <owner>#<path>
# alone and refuses with its one line naming the ref.

# store_lib_root: the workspace root the store calls run in
store_lib_root() {
  if [ -n "${CTX_STORE_ROOT:-}" ]; then
    printf '%s\n' "$CTX_STORE_ROOT"
    return 0
  fi
  if [ -n "${CTX_ROOT:-}" ]; then
    printf '%s\n' "$CTX_ROOT"
    return 0
  fi
  printf '%s\n' "$PWD"
}

# store_lib_resolver: the resolver path, CTX_STORE_RESOLVER when set, else the core under
# the drawer or the base mirror
store_lib_resolver() {
  if [ -n "${CTX_STORE_RESOLVER:-}" ]; then
    printf '%s\n' "$CTX_STORE_RESOLVER"
    return 0
  fi
  slr_root=$(store_lib_root)
  for slr_c in "$slr_root/.contexture/storage/scripts/driver-resolver" \
               "$slr_root/base/.contexture/storage/scripts/driver-resolver"; do
    if [ -x "$slr_c" ]; then
      printf '%s\n' "$slr_c"
      return 0
    fi
  done
  return 1
}

# store_lib_call <function label> <resolver arguments...>: one resolver call from the
# workspace root, stdin passed through, CTX_DIR unset, CTX_ROOT exported
store_lib_call() {
  slc_fn=$1
  shift
  slc_root=${CTX_STORE_ROOT:-${CTX_ROOT:-$PWD}}
  slc_resolver=${CTX_STORE_RESOLVER:-}
  if [ -z "$slc_resolver" ]; then
    if [ -x "$slc_root/.contexture/storage/scripts/driver-resolver" ]; then
      slc_resolver="$slc_root/.contexture/storage/scripts/driver-resolver"
    elif [ -x "$slc_root/base/.contexture/storage/scripts/driver-resolver" ]; then
      slc_resolver="$slc_root/base/.contexture/storage/scripts/driver-resolver"
    else
      printf '%s: error: the storage core resolver is not installed (ERR_DRIVER_NOT_FOUND)\n' "$slc_fn" >&2
      return 2
    fi
  fi
  if [ ! -d "$slc_root/.contexture" ]; then
    printf '%s: error: the workspace root is not a folder (ERR_INVALID_ARGUMENT)\n' "$slc_fn" >&2
    return 2
  fi
  (
    unset CTX_DIR
    CTX_ROOT=$slc_root
    export CTX_ROOT
    cd "$slc_root" || exit 2
    exec "$slc_resolver" "$@"
  )
}

store_list() { store_lib_call store.list store.list "$@"; }
store_get() { store_lib_call store.get store.get "$@"; }
store_put() { store_lib_call store.put store.put "$@"; }
store_delete() { store_lib_call store.delete store.delete "$@"; }
store_changes() { store_lib_call store.changes store.changes "$@"; }
store_require() { store_lib_call store.require require "$@"; }
store_has() { store_lib_call store.has has "$@"; }
store_promote() { store_lib_call store.promote store.promote "$@"; }

# store_lib_data: the storage core's data reader, found beside the resolver this library
# calls (the core scripts folder holds both), then under the drawer, then in the base mirror
store_lib_data() {
  sld_root=$(store_lib_root)
  sld_beside=""
  if sld_resolver=$(store_lib_resolver); then sld_beside="${sld_resolver%/*}/store-data"; fi
  for sld_c in "$sld_beside" "$sld_root/.contexture/storage/scripts/store-data" \
               "$sld_root/base/.contexture/storage/scripts/store-data"; do
    if [ -n "$sld_c" ] && [ -x "$sld_c" ]; then printf '%s\n' "$sld_c"; return 0; fi
  done
  return 1
}

# store_get_into <namespace> <targets>: the batched read into files. <targets> holds one
# <key> TAB <path> line per key in the asked order; one store.get call answers every key
# (the one key form for a single key), each present value lands in its path byte for byte,
# and one line per key prints on stdout in the asked order: 1 TAB <key> for a present key,
# 0 TAB <key> for an absent one. A refused call passes its rc and its one stderr line
# through with nothing on stdout, and a read served from a deprecated root keeps its notice
# on stderr. The scratch is <targets>.ans and <targets>.err, beside the caller's file.
store_get_into() {
  sgi_ns=$1
  sgi_t=$2
  set --
  while IFS='	' read -r sgi_k sgi_p; do
    [ -n "$sgi_k" ] && set -- "$@" "$sgi_k"
  done < "$sgi_t"
  [ $# -gt 0 ] || return 0
  if [ $# -eq 1 ]; then
    sgi_p=$(LC_ALL=C awk -F '\t' 'NF { print substr($0, length($1) + 2); exit }' "$sgi_t")
    store_get "$sgi_ns" "$1" > "$sgi_p" 2> "$sgi_t.err" < /dev/null
    sgi_rc=$?
    if [ "$sgi_rc" -eq 0 ]; then
      cat "$sgi_t.err" >&2
      printf '1\t%s\n' "$1"
      return 0
    fi
    rm -f "$sgi_p"
    if [ "$sgi_rc" -eq 1 ] && [ "$(cat "$sgi_t.err")" = "store.get: error: key '$1' not found in namespace '$sgi_ns' (ERR_ENTITY_NOT_FOUND)" ]; then
      printf '0\t%s\n' "$1"
      return 0
    fi
    cat "$sgi_t.err" >&2
    return "$sgi_rc"
  fi
  store_get "$sgi_ns" "$@" > "$sgi_t.ans" 2> "$sgi_t.err" < /dev/null
  sgi_rc=$?
  if [ "$sgi_rc" -ne 0 ]; then
    cat "$sgi_t.err" >&2
    return "$sgi_rc"
  fi
  sgi_pack=""
  if sgi_r=$(store_lib_resolver); then sgi_pack="${sgi_r%/*}/store-pack"; fi
  sgi_root=$(store_lib_root)
  for sgi_c in "$sgi_pack" "$sgi_root/.contexture/storage/scripts/store-pack" "$sgi_root/base/.contexture/storage/scripts/store-pack"; do
    if [ -n "$sgi_c" ] && [ -x "$sgi_c" ]; then sgi_pack=$sgi_c; break; fi
    sgi_pack=""
  done
  if [ -z "$sgi_pack" ]; then
    printf 'store.get: error: the storage core codec is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  fi
  "$sgi_pack" unpack "$sgi_t.ans" "$sgi_t" || return 2
  cat "$sgi_t.err" >&2
  return 0
}

# store_roots: the declared store roots, namespace TAB root per line (a fallback root on its
# own line after the root), from the storage core's data reader found beside the resolver
# this library calls (the core scripts folder holds both), then under the drawer, then in
# the base mirror, run from the workspace root
store_roots() {
  sr_root=$(store_lib_root)
  sr_script=$(store_lib_data) || {
    printf 'store.roots: error: the storage core data reader is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  }
  sr_out=$(CTX_STORE_WORKSPACE=$sr_root "$sr_script" --list) || return $?
  [ -n "$sr_out" ] || return 0
  printf '%s\n' "$sr_out" | LC_ALL=C awk -F '\t' '{ print $1 "\t" $2; if ($3 != "") print $1 "\t" $3 }'
}

# store_batch <namespace>: the transactional batch; the action list travels on stdin as
# the driver's escaped payload lines (action=<put|delete>, key=<escaped key>,
# head=<sha|none>, value_b64=<base64> for a put), and the driver answers one compact JSON
# line {"namespace","actions":N} or the first failure's one line with the action and key.
store_batch() { store_lib_call store.batch store.batch "$@"; }

# store_scan <namespace>: every key the module pattern admits with its raw value, bytewise,
# as one compact JSON line {"namespace","items":[{"key","value_b64"}]}; the caller decodes
# the base64 value.
store_scan() { store_lib_call store.scan store.scan "$@"; }

# store_lib_escape <value>: the payload escape (backslash, newline, tab, carriage return)
store_lib_escape() {
  SLE_S=$1 LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SLE_S"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") out = out "\\" "\\"
      else if (c == "\n") out = out "\\n"
      else if (c == "\t") out = out "\\t"
      else if (c == "\r") out = out "\\r"
      else out = out c
    }
    printf "%s", out
  }'
}

# LIB_UTF8_AWK: the awk function utf8_ok(s), true when s is valid UTF-8 (RFC 3629: no
# overlong form, no surrogate, nothing above U+10FFFF); byte values come from a table built
# with sprintf("%c"), so it runs alike on BWK awk, mawk, gawk, and busybox awk under
# LC_ALL=C (every caller sets it: bytes, never the locale's characters); an ASCII value
# takes the fast path, one match against a class of the bytes 1 to 127
LIB_UTF8_AWK='
function utf8_ok(s,   n, i, j, c, need, lo, hi) {
  if (s ~ /^[\001-\177]*$/) return 1
  if (!U8_T) { for (i = 1; i < 256; i++) U8_ORD[sprintf("%c", i)] = i; U8_T = 1 }
  n = length(s); i = 1
  while (i <= n) {
    c = U8_ORD[substr(s, i, 1)]
    if (c < 128) { i++; continue }
    if (c >= 194 && c <= 223) { need = 1; lo = 128; hi = 191 }
    else if (c == 224) { need = 2; lo = 160; hi = 191 }
    else if (c >= 225 && c <= 236) { need = 2; lo = 128; hi = 191 }
    else if (c == 237) { need = 2; lo = 128; hi = 159 }
    else if (c == 238 || c == 239) { need = 2; lo = 128; hi = 191 }
    else if (c == 240) { need = 3; lo = 144; hi = 191 }
    else if (c >= 241 && c <= 243) { need = 3; lo = 128; hi = 191 }
    else if (c == 244) { need = 3; lo = 128; hi = 143 }
    else return 0
    if (i + need > n) return 0
    c = U8_ORD[substr(s, i + 1, 1)]
    if (c < lo || c > hi) return 0
    for (j = 2; j <= need; j++) { c = U8_ORD[substr(s, i + j, 1)]; if (c < 128 || c > 191) return 0 }
    i += need + 1
  }
  return 1
}
'

# lib_utf8_ok <string>: rc 0 when the string is valid UTF-8, 1 when not, 2 when the check
# cannot run; silent (an argv string never holds a NUL)
lib_utf8_ok() {
  LIB_V=$1 LC_ALL=C awk "$LIB_UTF8_AWK"'BEGIN { if (utf8_ok(ENVIRON["LIB_V"])) exit 0; exit 3 }' < /dev/null
  case $? in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# lib_utf8_file_ok <file>: rc 0 when every line of the file is valid UTF-8, 1 when one is
# not, 2 when the file cannot be read; silent. A NUL byte is the caller's own check, since
# not every awk reads one.
lib_utf8_file_ok() {
  [ -f "$1" ] && [ -r "$1" ] || return 2
  LC_ALL=C awk "$LIB_UTF8_AWK"'{ if (!utf8_ok($0)) exit 3 }' "$1"
  case $? in
    0) return 0 ;;
    3) return 1 ;;
    *) return 2 ;;
  esac
}

# lib_ref_ok <label> <ref>: the shape of a full address, <owner>#<path>: the owner is the
# text before the first hash (lowercase letters, digits, dot, underscore, and dash, starting
# with a letter or digit), the path every byte after it (non-empty; a further hash belongs
# to it, as in file#<path>#<symbol>), and the whole value one token: no ASCII blank, no
# control character, no double quote, and no Unicode blank of the White_Space set (NEL,
# NBSP, U+1680, U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F, U+3000, as UTF-8 byte
# strings built by printf so no such byte sits in this file). Shape only: whether the owner
# is installed or the target exists is the caller's. rc 0, or rc 1 with one stderr line
# naming the ref (its newline, tab, carriage return, and backslash written by the payload
# escape, so the line stays one), or rc 2 when the check cannot run.
lib_ref_ok() {
  LIB_R=$2 LIB_B=$(printf '\302\205|\302\240|\341\232\200|\342\200\200|\342\200\201|\342\200\202|\342\200\203|\342\200\204|\342\200\205|\342\200\206|\342\200\207|\342\200\210|\342\200\211|\342\200\212|\342\200\250|\342\200\251|\342\200\257|\342\201\237|\343\200\200|') LC_ALL=C awk 'BEGIN {
    r = ENVIRON["LIB_R"]
    if (r ~ /[\001-\040"\177]/) exit 3
    n = split(ENVIRON["LIB_B"], B, /\|/)
    for (i = 1; i < n; i++) if (index(r, B[i])) exit 3
    h = index(r, "#")
    if (h < 2 || h == length(r)) exit 3
    if (substr(r, 1, h - 1) !~ /^[a-z0-9][a-z0-9._-]*$/) exit 3
    exit 0
  }' < /dev/null
  case $? in
    0) return 0 ;;
    3) printf "%s: error: malformed ref '%s': a reference is <owner>#<path>, one token without blanks, control characters, or double quotes (ERR_INVALID_ARGUMENT)\n" "$1" "$(store_lib_escape "$2")" >&2; return 1 ;;
    *) return 2 ;;
  esac
}

# store_search <namespace> <query> <mode> [<limit>]: the library's search entry; the query
# travels on stdin as the escaped query= payload line and the driver answers the store's
# one result shape
store_search() {
  ss_ns=${1:-}; ss_q=${2:-}; ss_mode=${3:-}; ss_lim=${4:-20}
  printf 'query=%s\n' "$(store_lib_escape "$ss_q")" | store_lib_call store.search store.search "$ss_ns" "$ss_mode" "$ss_lim"
}

# store_modes [<namespace>]: the search mode registry, one name TAB description line per
# mode in the configured driver's order, the modes being registered by the driver's
# descriptor and never declared by a module (exact is always among them). With a namespace it
# answers the modes that namespace can answer: exact always, a ranked mode only when the
# namespace's data file declares a search schema, since a ranked mode reads the documents a
# schema derives. A namespace no data file declares refuses rc 1 ERR_ENTITY_NOT_FOUND, a
# malformed one rc 1 ERR_INVALID_ARGUMENT, a missing reader or resolver rc 2.
store_modes() {
  if [ $# -gt 1 ]; then
    printf 'store.modes: error: store.modes takes at most a namespace (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  sm_reg=$(store_lib_call store.modes modes < /dev/null) || return $?
  if [ $# -eq 0 ]; then
    [ -z "$sm_reg" ] || printf '%s\n' "$sm_reg"
    return 0
  fi
  sm_script=$(store_lib_data) || {
    printf 'store.modes: error: the storage core data reader is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
    return 2
  }
  sm_out=$(CTX_STORE_WORKSPACE=$(store_lib_root) "$sm_script" "$1" 2>&1)
  sm_rc=$?
  if [ "$sm_rc" -ne 0 ]; then
    sm_msg=$(printf '%s\n' "$sm_out" | head -n 1)
    sm_msg=${sm_msg#store-data: }
    case "$sm_rc" in
      3) printf 'store.modes: error: %s (ERR_ENTITY_NOT_FOUND)\n' "$sm_msg" >&2; return 1 ;;
      2) printf 'store.modes: error: %s (ERR_STORAGE_READ)\n' "$sm_msg" >&2; return 2 ;;
      *) printf 'store.modes: error: %s (ERR_INVALID_ARGUMENT)\n' "$sm_msg" >&2; return 1 ;;
    esac
  fi
  sm_form=$(printf '%s\n' "$sm_out" | sed -n '7p')
  printf '%s\n' "$sm_reg" | SM_FORM="$sm_form" LC_ALL=C awk -F '\t' '$1 != "" && ($1 == "exact" || ENVIRON["SM_FORM"] != "")'
}

# data_lib_ref_ok <ref>: one <module>#<symbol> token, both sides non-empty, no blank or
# control character
data_lib_ref_ok() {
  case "$1" in
    ''|*'#'*'#'*) return 1 ;;
    '#'*|*'#') return 1 ;;
    *'#'*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *' '*) return 1 ;;
    *[[:cntrl:]]*) return 1 ;;
  esac
  return 0
}

# data_lib_module <ref>: the target module name, the text before the #
data_lib_module() {
  dlr_mod=${1%%#*}
  printf '%s\n' "$dlr_mod"
}

# data_get <ref>: resolve a module reference through the target module's data script
data_get() {
  dg_ref=$1
  if ! data_lib_ref_ok "$dg_ref"; then
    printf 'data_get: error: ref '\''%s'\'': a reference is <module>#<symbol> (ERR_INVALID_ARGUMENT)\n' "$dg_ref" >&2
    return 1
  fi
  dg_depth=$((${CTX_DATA_DEPTH:-0} + 1))
  if [ "$dg_depth" -gt 8 ]; then
    printf 'data_get: error: ref '\''%s'\'': ref depth over the limit 8 (ERR_INVALID_ARGUMENT)\n' "$dg_ref" >&2
    return 1
  fi
  case " ${CTX_DATA_CHAIN:-} " in
    *" $dg_ref "*)
      printf 'data_get: error: ref '\''%s'\'': ref cycle (ERR_INVALID_ARGUMENT)\n' "$dg_ref" >&2
      return 1
      ;;
  esac
  dg_mod=$(data_lib_module "$dg_ref")
  dg_root=$(store_lib_root)
  dg_script=""
  for dg_c in "$dg_root/.contexture/modules/$dg_mod/scripts/data" \
              "$dg_root/.contexture/extensions/modules/$dg_mod/scripts/data" \
              "$dg_root/base/.contexture/modules/$dg_mod/scripts/data" \
              "$dg_root/base/.contexture/extensions/modules/$dg_mod/scripts/data"; do
    if [ -x "$dg_c" ]; then dg_script=$dg_c; break; fi
  done
  if [ -z "$dg_script" ]; then
    printf 'data_get: error: ref '\''%s'\'': module '\''%s'\'' not found (ERR_ENTITY_NOT_FOUND)\n' "$dg_ref" "$dg_mod" >&2
    return 1
  fi
  dg_tmp="${TMPDIR:-/tmp}"
  if [ -d "$dg_root/.contexture" ] && mkdir -p "$dg_root/.contexture/tmp" 2>/dev/null && [ -w "$dg_root/.contexture/tmp" ]; then
    dg_tmp="$dg_root/.contexture/tmp"
  fi
  dg_err=$(mktemp "$dg_tmp/data-get.XXXXXX" 2>/dev/null) || dg_err=""
  dg_out=$(CTX_STORE_ROOT="$dg_root" CTX_DATA_DEPTH=$dg_depth CTX_DATA_CHAIN="${CTX_DATA_CHAIN:-}$dg_ref " "$dg_script" data_get "$dg_ref" 2>"${dg_err:-/dev/null}")
  dg_rc=$?
  if [ "$dg_rc" -ne 0 ]; then
    dg_msg=""
    [ -n "$dg_err" ] && dg_msg=$(head -n 1 "$dg_err" 2>/dev/null)
    [ -n "$dg_err" ] && rm -f "$dg_err"
    case "$dg_msg" in
      data_get:\ error:\ *) dg_msg=${dg_msg#data_get: error: } ;;
    esac
    [ -n "$dg_msg" ] || dg_msg="the target module refused the reference"
    printf 'data_get: error: ref '\''%s'\'': %s\n' "$dg_ref" "$dg_msg" >&2
    return "$dg_rc"
  fi
  [ -n "$dg_err" ] && rm -f "$dg_err"
  printf '%s\n' "$dg_out"
  return 0
}

# data_emit <ref> <data>: the target data script's one-line envelope, data compact JSON
data_emit() {
  de_ref=$1
  de_data=${2:-}
  if ! data_lib_ref_ok "$de_ref"; then
    printf 'data_emit: error: ref '\''%s'\'': a reference is <module>#<symbol> (ERR_INVALID_ARGUMENT)\n' "$de_ref" >&2
    return 1
  fi
  case "$de_data" in
    ''|*[[:cntrl:]]*)
      printf 'data_emit: error: the data for ref '\''%s'\'' must be one compact JSON value (ERR_INVALID_ARGUMENT)\n' "$de_ref" >&2
      return 1
      ;;
  esac
  printf '{"ref":"%s","data":%s}\n' "$de_ref" "$de_data"
  return 0
}
