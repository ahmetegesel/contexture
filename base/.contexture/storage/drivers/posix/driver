#!/bin/sh
# driver: the zero-dependency POSIX storage driver (contract 2, docs/the-engine.md, The
# storage contract). The record lives as markdown files under .contexture/sessions/<unit>/
# (state.md, backlog.md, knowledge.md, journal.md, lanes/<lane>/recipe.md, journal.md,
# report.md), and this driver is the only code that touches them. It answers the 38 record
# functions (argv identifiers, the escaped key=value payload on stdin with indexed list
# keys, one compact JSON answer in the contract key order, one fixed stderr line per
# refusal) through awk programs beside it: canon.awk (the canonical renderer and the JSON
# string form), model.awk (the parse rules into typed items holding all of their content,
# the derived fields, the JSON of the schemas), ops.awk (the functions: the record rules, the
# append rule, a touched item rewritten canonical in place), search.awk (the exact rule over
# the rendered text). Every item reads in the canonical layout; a file keeps its bytes until
# a write touches one of its items. It answers the seven generic module store functions
# (store): store.list, store.get, store.put, store.delete, store.changes, store.batch, and
# store.scan over a module's declared data file and root, plus the store.search entry.
#
# Writes: the unit lock (.contexture/tmp/locks/<unit>.lock, carrying its holder pid) is
# held from the read to the last rename, every changed file is staged beside the sessions
# folder and renamed into place (one mv per file, each replaced file hard-linked into the
# stage first so a failed rename or an interrupt rolls the earlier ones back), and the
# answer prints only after every file landed; a refusal stages nothing. Every awk runs in
# the C locale (bytes) and takes every value through the environment or a file, never
# through awk -v.

set -u

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
LC_ALL=C
export LC_ALL

find_workspace_root() {
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

get_tmp_dir() {
  ws=$(find_workspace_root)
  if [ -d "$ws/.contexture/tmp" ] && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  elif mkdir -p "$ws/.contexture/tmp" 2>/dev/null && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  else
    d="${TMPDIR:-/tmp}/contexture-$USER"
    mkdir -p "$d" 2>/dev/null || true
    printf '%s\n' "$d"
  fi
}

get_lock_dir() {
  tmp_d=$(get_tmp_dir)
  mkdir -p "$tmp_d/locks" 2>/dev/null || true
  printf '%s/locks\n' "$tmp_d"
}

# scratch_dir: the per-verb root ctx exported (created on first use), else the drawer;
# every transient file stages here so a killed verb's root holds its residue
scratch_dir() {
  if [ -n "${CTX_SCRATCH_ROOT:-}" ] && mkdir -p "$CTX_SCRATCH_ROOT" 2>/dev/null \
    && [ -d "$CTX_SCRATCH_ROOT" ] && [ -w "$CTX_SCRATCH_ROOT" ]; then
    printf '%s\n' "$CTX_SCRATCH_ROOT"
  else
    get_tmp_dir
  fi
}

escape_json() {
  # every escape is written by split and concatenation (bs_double, sjoin), never by a gsub
  # replacement: awk builds read a backslash inside a replacement differently (busybox awk
  # and gawk --posix yield one backslash from four, Debian's busybox awk drops the backslash
  # before a quote, r, or t)
  printf '%s' "$1" | awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function sjoin(s, sep, lit,    n, p, i, o) { n = split(s, p, sep); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o lit p[i]; return o }
    BEGIN { ORS="" }
    {
      if (NR > 1) printf "\\n";
      s = bs_double($0);
      s = sjoin(s, "[\"]", "\\" "\"");
      s = sjoin(s, "[\r]", "\\" "r");
      s = sjoin(s, "[\t]", "\\" "t");
      printf "%s", s;
    }
  '
}


# ==============================================================================
# The record functions (contract 2)
# ==============================================================================
FN=""
SCR=""
STAGE=""
PX_LOCK=""
PC_ON=0
PC_N=0
px_cleanup() {
  # a commit cut short (a failed rename, an interrupt) rolls back what it renamed, so a
  # write lands whole or not at all (R20); the backups live in the stage, removed after
  [ "$PC_ON" -eq 1 ] && pc_rollback
  [ -n "$SCR" ] && rm -rf "$SCR"
  [ -n "$STAGE" ] && rm -rf "$STAGE"
  [ -n "$PX_LOCK" ] && rm -rf "$PX_LOCK" 2>/dev/null
  [ -n "$PAYLOAD_FILE" ] && rm -f "$PAYLOAD_FILE"
  return 0
}
PAYLOAD_FILE=""
trap px_cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# refuse <rc> <CODE> <message>: the one fixed stderr line of a refusal
refuse() {
  printf '%s: error: %s (%s)\n' "$FN" "$3" "$2" >&2
  exit "$1"
}

ident_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# the entry slug and the finding NAME a read addresses: the legacy shapes stay addressable
name_valid() {
  case "$1" in
    ""|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

# ==============================================================================
# The generic module store (the storage core's store contract)
# ==============================================================================
# Seven data functions over a module's declared data file: store.list, store.get,
# store.put, store.delete, store.changes, store.batch, and store.scan. The data file
# (modules/<module>/data) is read and validated by the storage core's private store-data
# script; the posix mapping is <root>/<key><suffix> under the workspace root, the module's
# declared root.
# Keys are exact, ASCII-case-fold twins never coexist, list is bytewise
# and filtered by the module pattern, put is a same-directory temp moved over the key
# under one namespace scope lock, and the change log belongs to a store driver (posix
# keeps none). The batch holds that same namespace lock once, validates its whole action
# list, stages a put value per action, and commits every key under one store-scope undo
# log so it lands whole or not at all; the scan answers every admitted key with its raw
# value in base64.
STORE_WS=""
STORE_TMP=""
STORE_LOCK=""
STORE_BATCH_STAGE=""
SB_ON=0

store_cleanup() {
  [ "${SB_ON:-0}" -eq 1 ] && sb_rollback
  SB_ON=0
  [ -n "${STORE_TMP:-}" ] && rm -f "$STORE_TMP" 2>/dev/null
  STORE_TMP=""
  [ -n "${STORE_BATCH_STAGE:-}" ] && rm -rf "$STORE_BATCH_STAGE" 2>/dev/null
  STORE_BATCH_STAGE=""
  store_unlock
  return 0
}

store_unlock() {
  [ -n "${STORE_LOCK:-}" ] || return 0
  su_lock=$STORE_LOCK
  STORE_LOCK=""
  rm -rf "$su_lock" 2>/dev/null
  su_base=$(get_lock_dir)
  su_p=$(dirname "$su_lock")
  while [ "$su_p" != "$su_base" ] && [ "$su_p" != "/" ]; do
    rmdir "$su_p" 2>/dev/null || break
    su_p=$(dirname "$su_p")
  done
  return 0
}

# store_lock <namespace>: one namespace scope lock shared by store.put, store.delete, and
# store.batch, a folder under the drawer's lock folder, held until store_unlock; five
# seconds of retries then rc 2 ERR_STORAGE_LOCKED. The folder carries its holder pid; a
# waiter removes a lock whose pid is gone, and gives a lock with no pid file a second's
# grace for its holder to write one.
store_lock() {
  STORE_LOCK="$(get_lock_dir)/store-$1.lock"
  mkdir -p "$(dirname "$STORE_LOCK")" 2>/dev/null || {
    STORE_LOCK=""
    refuse 2 ERR_STORAGE_WRITE "cannot make the store lock folder"
  }
  sl_n=0
  sl_miss=0
  while [ "$sl_n" -lt 50 ]; do
    if mkdir "$STORE_LOCK" 2>/dev/null; then
      printf '%s\n' "$$" > "$STORE_LOCK/pid" 2>/dev/null || {
        rm -rf "$STORE_LOCK" 2>/dev/null
        STORE_LOCK=""
        refuse 2 ERR_STORAGE_WRITE "cannot write the store lock holder pid"
      }
      return 0
    fi
    sl_pid=$(cat "$STORE_LOCK/pid" 2>/dev/null)
    case "$sl_pid" in
      ""|*[!0-9]*)
        sl_miss=$((sl_miss + 1))
        if [ "$sl_miss" -ge 10 ]; then rm -rf "$STORE_LOCK" 2>/dev/null; sl_miss=0; continue; fi
        ;;
      *)
        if kill -0 "$sl_pid" 2>/dev/null; then sl_miss=0
        else rm -rf "$STORE_LOCK" 2>/dev/null; continue
        fi
        ;;
    esac
    sl_n=$((sl_n + 1))
    sleep 0.1 2>/dev/null || sleep 1
  done
  STORE_LOCK=""
  refuse 2 ERR_STORAGE_LOCKED "the store namespace '$1' is locked (5 s timeout)"
}

# store_data <function> <namespace>: the validated fields of the namespace's data file in
# SD_NS, SD_ROOT, SD_SUFFIX, SD_KEYPAT, SD_CHANGES; the caller's function name frames the
# refusal. The storage core's store-data script owns the grammar (the core is
# base, so no module's parser enters base).
store_data() {
  FN=$1
  sd_ns=$2
  sd_ws=$(find_workspace_root)
  sd_script=""
  for sd_c in "$SCRIPT_DIR/../../scripts/store-data" \
              "$sd_ws/.contexture/storage/scripts/store-data" \
              "$sd_ws/base/.contexture/storage/scripts/store-data"; do
    if [ -x "$sd_c" ]; then sd_script=$sd_c; break; fi
  done
  [ -n "$sd_script" ] || refuse 2 ERR_STORAGE_READ "the storage core data reader is not installed"
  sd_err=$(mktemp "$(scratch_dir)/store-data.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  sd_out=$(CTX_STORE_WORKSPACE="$sd_ws" "$sd_script" "$sd_ns" 2>"$sd_err")
  sd_rc=$?
  sd_msg=$(head -n 1 "$sd_err" 2>/dev/null)
  rm -f "$sd_err"
  case "$sd_msg" in store-data:\ *) sd_msg=${sd_msg#store-data: } ;; esac
  [ -n "$sd_msg" ] || sd_msg="the namespace '$sd_ns' is not declared by a usable data file"
  case "$sd_rc" in
    0) ;;
    3) refuse 1 ERR_ENTITY_NOT_FOUND "$sd_msg" ;;
    2) refuse 2 ERR_STORAGE_READ "$sd_msg" ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "$sd_msg" ;;
  esac
  SD_NS=$(printf '%s\n' "$sd_out" | sed -n '1p')
  SD_ROOT=$(printf '%s\n' "$sd_out" | sed -n '2p')
  SD_SUFFIX=$(printf '%s\n' "$sd_out" | sed -n '3p')
  SD_KEYPAT=$(printf '%s\n' "$sd_out" | sed -n '4p')
  SD_CHANGES=$(printf '%s\n' "$sd_out" | sed -n '5p')
  SD_FILE=$(printf '%s\n' "$sd_out" | sed -n '6p')
  SD_FORM=$(printf '%s\n' "$sd_out" | sed -n '7p')
  SD_FORMAT=$(printf '%s\n' "$sd_out" | sed -n '8p')
  SD_FIELDS=$(printf '%s\n' "$sd_out" | sed -n '9p')
  SD_TITLE=$(printf '%s\n' "$sd_out" | sed -n '10p')
  SD_SNIPPET=$(printf '%s\n' "$sd_out" | sed -n '11p')
  SD_MODES=$(printf '%s\n' "$sd_out" | sed -n '12p')
  SD_DOCS=$(printf '%s\n' "$sd_out" | sed -n '13,$p')
  STORE_WS=$sd_ws
}

# store_key_ok <key>: the generic key rule: no blanks, control characters, leading slash,
# backslash, or . or .. segment, and every segment non-empty (exact, not folded)
store_key_ok() {
  SK_KEY="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SK_KEY"]
    if (s == "") exit 1
    if (substr(s, 1, 1) == "/" || substr(s, length(s), 1) == "/") exit 1
    if (s ~ /[[:cntrl:]]/ || index(s, " ") || index(s, "\\")) exit 1
    n = split(s, p, "/")
    for (i = 1; i <= n; i++) if (p[i] == "" || p[i] == "." || p[i] == "..") exit 1
    exit 0
  }'
}

# store_key_shape <pattern> <key>: the key's segments match the module's pattern; every
# pattern segment is a <name> placeholder and the key's segment count equals the pattern's,
# except that a final <name...> placeholder admits one or more segments (the variable-depth
# key that lets a module's main files and its deeper lane files share one pattern)
store_key_shape() {
  SSP_P="$1" SSP_K="$2" LC_ALL=C awk 'BEGIN {
    m = split(ENVIRON["SSP_P"], p, "/")
    n = split(ENVIRON["SSP_K"], k, "/")
    if (m < 1) exit 1
    multi = (p[m] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/)
    if (multi) { if (n < m) exit 1 } else { if (n != m) exit 1 }
    for (i = 1; i < m; i++) {
      if (p[i] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) exit 1
      if (k[i] == "") exit 1
    }
    if (multi) {
      for (i = m; i <= n; i++) if (k[i] == "") exit 1
    } else {
      if (p[m] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) exit 1
      if (k[m] == "") exit 1
    }
    exit 0
  }'
}

# store_key_for <function> <namespace> <key>: the key rule and the module pattern before a
# key reaches the filesystem
store_key_for() {
  FN=$1
  sk_key=$3
  store_key_ok "$sk_key" || refuse 1 ERR_INVALID_ARGUMENT "malformed key '$sk_key'"
  store_key_shape "$SD_KEYPAT" "$sk_key" || refuse 1 ERR_INVALID_ARGUMENT "key '$sk_key' does not match the namespace pattern '$SD_KEYPAT'"
}

# store_path <key>: the posix mapping of a validated key
store_path() {
  printf '%s/%s/%s%s\n' "$STORE_WS" "$SD_ROOT" "$1" "$SD_SUFFIX"
}

# store_list_keys: every key in the namespace, bytewise, only those the module pattern
# admits; the folder entries are read as stored, so a case twin of a key never appears
store_list_keys() {
  sl_dir="$STORE_WS/$SD_ROOT"
  [ -d "$sl_dir" ] || return 0
  find "$sl_dir" -type f -print 2>/dev/null | while IFS= read -r sl_f; do
    sl_rel=${sl_f#"$sl_dir"/}
    case "$sl_rel" in
      *"$SD_SUFFIX") sl_key=${sl_rel%"$SD_SUFFIX"} ;;
      *) continue ;;
    esac
    store_key_ok "$sl_key" || continue
    store_key_shape "$SD_KEYPAT" "$sl_key" || continue
    printf '%s\n' "$sl_key"
  done | LC_ALL=C sort
}

# store_key_exists <key>: the exact key the store lists (a case twin is absent)
store_key_exists() {
  store_list_keys | grep -F -q -x -e "$1"
}

# store_twin <key>: a stored key that folds onto <key> under ASCII case without matching it
store_twin() {
  store_list_keys | ST_TARGET="$1" LC_ALL=C awk '
    { t = ENVIRON["ST_TARGET"]; if ($0 != t && tolower($0) == tolower(t)) { print; exit } }'
}

# store_fold_twin <key> <path>: a stored key whose file the path resolves to while the exact
# key is absent. A case-insensitive filesystem can fold more than ASCII (a Unicode case
# variant), so a put that wrote without this check would replace the stored key and lose the
# requested one; the exact key must always be the key the store lists.
store_fold_twin() {
  sft_key=$1
  sft_path=$2
  store_key_exists "$sft_key" && return 0
  [ -e "$sft_path" ] || return 0
  sft_ino=$(ls -di "$sft_path" 2>/dev/null | awk '{print $1}')
  [ -n "$sft_ino" ] || return 0
  store_list_keys | while IFS= read -r sft_k; do
    [ "$sft_k" = "$sft_key" ] && continue
    sft_p=$(store_path "$sft_k")
    sft_kino=$(ls -di "$sft_p" 2>/dev/null | awk '{print $1}')
    if [ -n "$sft_kino" ] && [ "$sft_kino" = "$sft_ino" ]; then
      printf '%s\n' "$sft_k"
      break
    fi
  done
}

# store_fold_refusal <namespace> <key> <stored key>: the fixed line for a key the filesystem
# cannot hold exactly beside <stored key>
store_fold_refusal() {
  refuse 1 ERR_ENTITY_EXISTS "key '$2' cannot be represented exactly beside '$3' under the filesystem's case folding; the two keys never coexist in namespace '$1'"
}

# store_flags <function> <default op> [flags]: --op=<op> and --head=<sha|none>, bounded
store_flags() {
  sf_fn=$1; SF_OP=$2
  shift 2
  SF_HEAD=none
  for sf_a in "$@"; do
    case "$sf_a" in
      --op=*) SF_OP=${sf_a#--op=} ;;
      --head=*) SF_HEAD=${sf_a#--head=} ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown argument '$sf_a'" ;;
    esac
  done
  case "$SF_OP" in
    ''|*[!A-Za-z0-9._-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed op '$SF_OP'" ;;
  esac
  case "$SF_HEAD" in
    none) ;;
    ''|*[!0-9a-fA-F]*) refuse 1 ERR_INVALID_ARGUMENT "--head takes a commit id or none: '$SF_HEAD'" ;;
  esac
}

store_list() {
  FN=store.list
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.list takes one argument, the namespace"
  sn_ns=$1
  store_data store.list "$sn_ns"
  sn_tmp=$(mktemp "$(scratch_dir)/store-keys.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  store_list_keys > "$sn_tmp"
  printf '{"namespace":"%s","keys":[' "$(escape_json "$sn_ns")"
  sn_first=1
  while IFS= read -r sn_key; do
    [ -n "$sn_key" ] || continue
    if [ "$sn_first" -eq 1 ]; then
      printf '"%s"' "$(escape_json "$sn_key")"
      sn_first=0
    else
      printf ',"%s"' "$(escape_json "$sn_key")"
    fi
  done < "$sn_tmp"
  rm -f "$sn_tmp"
  printf ']}\n'
}

store_get() {
  FN=store.get
  [ $# -eq 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.get takes the namespace and the key"
  sg_ns=$1; sg_key=$2
  store_data store.get "$sg_ns"
  store_key_for store.get "$sg_ns" "$sg_key"
  store_key_exists "$sg_key" || refuse 1 ERR_ENTITY_NOT_FOUND "key '$sg_key' not found in namespace '$sg_ns'"
  cat "$(store_path "$sg_key")" || refuse 2 ERR_STORAGE_READ "cannot read key '$sg_key' in namespace '$sg_ns'"
}

store_put() {
  FN=store.put
  [ $# -ge 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.put takes the namespace, the key, and optional flags"
  sp_ns=$1; sp_key=$2
  shift 2
  store_flags store.put write "$@"
  store_data store.put "$sp_ns"
  store_key_for store.put "$sp_ns" "$sp_key"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  store_lock "$sp_ns"
  sp_twin=$(store_twin "$sp_key")
  if [ -n "$sp_twin" ]; then
    store_unlock
    refuse 1 ERR_ENTITY_EXISTS "key '$sp_key' folds onto '$sp_twin' under ASCII case; keys differing only by case never coexist in namespace '$sp_ns'"
  fi
  sp_path=$(store_path "$sp_key")
  sp_fold=$(store_fold_twin "$sp_key" "$sp_path")
  if [ -n "$sp_fold" ]; then
    store_unlock
    store_fold_refusal "$sp_ns" "$sp_key" "$sp_fold"
  fi
  mkdir -p "$(dirname "$sp_path")" 2>/dev/null || {
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  }
  STORE_TMP=$(mktemp "$sp_path.XXXXXX" 2>/dev/null) || {
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  }
  chmod "$(umask -S | tr -d x)" "$STORE_TMP" 2>/dev/null || true
  if ! cat > "$STORE_TMP" || ! mv -f "$STORE_TMP" "$sp_path" 2>/dev/null; then
    rm -f "$STORE_TMP"
    STORE_TMP=""
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  fi
  STORE_TMP=""
  # the write must list the key it echoes; a folded directory or file name is refused and
  # the just-written file removed, so a successful put never loses its key
  sp_fold=$(store_fold_twin "$sp_key" "$sp_path")
  if [ -n "$sp_fold" ]; then
    rm -f "$sp_path"
    store_unlock
    store_fold_refusal "$sp_ns" "$sp_key" "$sp_fold"
  fi
  store_unlock
  printf '{"namespace":"%s","key":"%s","op":"%s"}\n' "$(escape_json "$sp_ns")" "$(escape_json "$sp_key")" "$(escape_json "$SF_OP")"
}

store_delete() {
  FN=store.delete
  [ $# -ge 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.delete takes the namespace, the key, and optional flags"
  sx_ns=$1; sx_key=$2
  shift 2
  store_flags store.delete remove "$@"
  store_data store.delete "$sx_ns"
  store_key_for store.delete "$sx_ns" "$sx_key"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  store_lock "$sx_ns"
  if ! store_key_exists "$sx_key"; then
    store_unlock
    refuse 1 ERR_ENTITY_NOT_FOUND "key '$sx_key' not found in namespace '$sx_ns'"
  fi
  sx_path=$(store_path "$sx_key")
  if ! rm -f "$sx_path" 2>/dev/null || [ -e "$sx_path" ]; then
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage remove of key '$sx_key' failed"
  fi
  store_unlock
  printf '{"namespace":"%s","key":"%s","op":"%s"}\n' "$(escape_json "$sx_ns")" "$(escape_json "$sx_key")" "$(escape_json "$SF_OP")"
}

store_changes() {
  FN=store.changes
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.changes takes one argument, the namespace"
  sc_ns=$1
  store_data store.changes "$sc_ns"
  refuse 1 ERR_CAPABILITY_UNSUPPORTED "the posix store keeps no change log; namespace '$sc_ns' reports its delta through its module (changes: $SD_CHANGES)"
}

# ==============================================================================
# The transactional batch and the scan
# ==============================================================================
# The batch wire (stdin, the driver's escaped payload format): an action=put or
# action=delete line opens an action, then key=<escaped key>, head=<sha|none> (default
# none), and, for a put, value_b64=<base64>. The action list is validated whole under the
# namespace lock, staged, and committed under one store-scope undo log; the first failure
# prints store.batch: error: action <n> (<op> '<key>'): <message> (<CODE>), 1-based, and
# nothing is written.
batch_unescape() {
  BU_RAW="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["BU_RAW"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n") out = out "\n"
        else if (c == "t") out = out "\t"
        else if (c == "r") out = out "\r"
        else out = out c
      } else out = out c
    }
    printf "%s", out
  }'
}

# batch_decode <base64> <out>: decode one value; the base64 command differs only in its
# decode flag, so the GNU/Darwin spelling is tried first and the BSD one second
batch_decode() {
  printf '%s' "$1" | base64 -d > "$2" 2>/dev/null && return 0
  printf '%s' "$1" | base64 -D > "$2" 2>/dev/null && return 0
  rm -f "$2" 2>/dev/null
  return 1
}

# batch_refuse <rc> <n> <op> <key> <CODE> <message>: the batch's one failure line
batch_refuse() {
  printf 'store.batch: error: action %s (%s '\''%s'\''): %s (%s)\n' "$2" "$3" "$4" "$6" "$5" >&2
  exit "$1"
}

# batch_key_for <n> <op> <key>: the key rule and the module pattern, framed by the action
batch_key_for() {
  bk_key=$3
  store_key_ok "$bk_key" || batch_refuse 1 "$1" "$2" "$bk_key" ERR_INVALID_ARGUMENT "malformed key '$bk_key'"
  store_key_shape "$SD_KEYPAT" "$bk_key" || batch_refuse 1 "$1" "$2" "$bk_key" ERR_INVALID_ARGUMENT "key '$bk_key' does not match the namespace pattern '$SD_KEYPAT'"
}

# batch_close_action: validate the action being parsed and append it to the staging
# manifest (n, op, key, head, value path, tab separated; a key never holds a tab)
batch_close_action() {
  [ "$sb_open" -eq 1 ] || return 0
  sb_open=0
  SB_N=$((SB_N + 1))
  [ "$sb_seen_key" -eq 1 ] && [ -n "$sb_key" ] || batch_refuse 1 "$SB_N" "$sb_op" "?" ERR_INVALID_ARGUMENT "the action carries no key"
  batch_key_for "$SB_N" "$sb_op" "$sb_key"
  case "$sb_head" in
    none) ;;
    ''|*[!0-9a-fA-F]*) batch_refuse 1 "$SB_N" "$sb_op" "$sb_key" ERR_INVALID_ARGUMENT "--head takes a commit id or none: '$sb_head'" ;;
  esac
  case "$sb_op" in
    put)
      [ "$sb_seen_val" -eq 1 ] || batch_refuse 1 "$SB_N" put "$sb_key" ERR_INVALID_ARGUMENT "a put carries no value"
      sb_v="$STORE_BATCH_STAGE/val.$SB_N"
      batch_decode "$sb_val" "$sb_v" || batch_refuse 1 "$SB_N" put "$sb_key" ERR_INVALID_ARGUMENT "malformed base64 value"
      printf '%s\t%s\t%s\t%s\t%s\n' "$SB_N" put "$sb_key" "$sb_head" "$sb_v" >> "$STORE_BATCH_STAGE/man"
      ;;
    delete)
      [ "$sb_seen_val" -eq 0 ] || batch_refuse 1 "$SB_N" delete "$sb_key" ERR_INVALID_ARGUMENT "a delete carries no value"
      printf '%s\t%s\t%s\t%s\t\n' "$SB_N" delete "$sb_key" "$sb_head" >> "$STORE_BATCH_STAGE/man"
      ;;
  esac
}

# batch_parse: read the action payload from stdin; values stage under STORE_BATCH_STAGE
batch_parse() {
  STORE_BATCH_STAGE=$(mktemp -d "$(get_tmp_dir)/store-batch.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the batch staging folder"
  : > "$STORE_BATCH_STAGE/man"
  SB_N=0
  sb_open=0
  sb_op=""; sb_key=""; sb_head=""; sb_val=""; sb_seen_key=0; sb_seen_head=0; sb_seen_val=0
  while IFS= read -r sb_l || [ -n "$sb_l" ]; do
    sb_l=${sb_l%"$cr_byte"}
    case "$sb_l" in
      '') continue ;;
      action=*)
        batch_close_action
        sb_open=1
        sb_op=${sb_l#action=}
        case "$sb_op" in
          put|delete) ;;
          *) batch_refuse 1 "$((SB_N + 1))" "$sb_op" "?" ERR_INVALID_ARGUMENT "unknown action '$sb_op' (put or delete)" ;;
        esac
        sb_key=""; sb_head=none; sb_val=""; sb_seen_key=0; sb_seen_head=0; sb_seen_val=0
        ;;
      key=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_key" -eq 0 ] || batch_refuse 1 "$SB_N" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'key='"
        sb_seen_key=1
        sb_key=$(batch_unescape "${sb_l#key=}")
        ;;
      head=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_head" -eq 0 ] || batch_refuse 1 "$SB_N" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'head='"
        sb_seen_head=1
        sb_head=${sb_l#head=}
        ;;
      value_b64=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_val" -eq 0 ] || batch_refuse 1 "$SB_N" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'value_b64='"
        sb_seen_val=1
        sb_val=${sb_l#value_b64=}
        ;;
      *) batch_refuse 1 "$SB_N" "${sb_op:-?}" "${sb_key:-?}" ERR_INVALID_ARGUMENT "unknown payload line '$sb_l'" ;;
    esac
  done
  if [ "$sb_open" -eq 1 ]; then batch_close_action; fi
  [ "$SB_N" -gt 0 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "the batch carries no actions"
}

# batch_validate: the whole action list against the live key set, under the namespace lock;
# a delete must find the key present at its place in the order, and a put never coexists
# with an ASCII case twin
batch_validate() {
  SB_LIVE="$STORE_BATCH_STAGE/live"
  store_list_keys > "$SB_LIVE"
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    case "$sb_op" in
      put)
        sb_twin=$(SB_T="$sb_key" LC_ALL=C awk 'BEGIN { t = ENVIRON["SB_T"] } { if ($0 != t && tolower($0) == tolower(t)) { print; exit } }' "$SB_LIVE")
        [ -z "$sb_twin" ] || batch_refuse 1 "$sb_i" put "$sb_key" ERR_ENTITY_EXISTS "key '$sb_key' folds onto '$sb_twin' under ASCII case; keys differing only by case never coexist in namespace '$SB_NS'"
        printf '%s\n' "$sb_key" >> "$SB_LIVE"
        LC_ALL=C sort -u "$SB_LIVE" -o "$SB_LIVE"
        ;;
      delete)
        grep -F -q -x -e "$sb_key" "$SB_LIVE" || batch_refuse 1 "$sb_i" delete "$sb_key" ERR_ENTITY_NOT_FOUND "key '$sb_key' not found in namespace '$SB_NS'"
        grep -F -v -x -e "$sb_key" "$SB_LIVE" > "$SB_LIVE.next" || true
        mv -f "$SB_LIVE.next" "$SB_LIVE"
        ;;
    esac
  done < "$STORE_BATCH_STAGE/man"
}

# sb_note <f|d> <path> <backup>: one undo step; the store-scope log the batch commits under
sb_note() {
  printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >> "$STORE_BATCH_STAGE/undo"
}

# sb_rollback: every noted step undone, the last first
sb_rollback() {
  [ -f "$STORE_BATCH_STAGE/undo" ] || return 0
  awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) print a[i] }' "$STORE_BATCH_STAGE/undo" |
    while IFS='	' read -r sb_k sb_p sb_b; do
      case "$sb_k" in
        f) if [ -n "$sb_b" ]; then mv -f "$sb_b" "$sb_p" 2>/dev/null; else rm -f "$sb_p" 2>/dev/null; fi ;;
        d) rmdir "$sb_p" 2>/dev/null ;;
      esac
    done
}

# sb_dir <folder>: the folder made when absent, noted so a rollback removes it again
sb_dir() {
  [ -d "$1" ] && return 0
  sb_up=$(dirname "$1")
  sb_dir "$sb_up" || return 1
  sb_note d "$1" ""
  mkdir "$1" 2>/dev/null || [ -d "$1" ] || return 1
}

# sb_backup <path>: a hard link of the file about to be replaced or removed, kept in the
# stage (the same filesystem), a copy where the link is refused; prints the backup path
sb_backup() {
  [ -f "$1" ] || { printf '\n'; return 0; }
  SB_BAK_N=$((SB_BAK_N + 1))
  sb_b="$STORE_BATCH_STAGE/bak.$SB_BAK_N"
  ln "$1" "$sb_b" 2>/dev/null || cp -p "$1" "$sb_b" 2>/dev/null || return 1
  printf '%s\n' "$sb_b"
}

# batch_commit: every action applied in order under one undo log; any failure prints its
# action line and store_cleanup rolls the earlier steps back
batch_commit() {
  SB_ON=1
  SB_BAK_N=0
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    sb_path=$(store_path "$sb_key")
    case "$sb_op" in
      put)
        sb_dir "$(dirname "$sb_path")" || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        sb_bak=$(sb_backup "$sb_path") || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        sb_note f "$sb_path" "$sb_bak"
        mv -f "$sb_val" "$sb_path" 2>/dev/null || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        ;;
      delete)
        [ -f "$sb_path" ] || continue
        sb_bak=$(sb_backup "$sb_path") || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "the storage remove of key '$sb_key' failed"
        sb_note f "$sb_path" "$sb_bak"
        rm -f "$sb_path" 2>/dev/null && [ ! -f "$sb_path" ] || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "the storage remove of key '$sb_key' failed"
        ;;
    esac
  done < "$STORE_BATCH_STAGE/man"
  # the write must list the key it echoes; a folded file name is refused and rolls back
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    [ "$sb_op" = put ] || continue
    sb_fold=$(store_fold_twin "$sb_key" "$(store_path "$sb_key")")
    [ -z "$sb_fold" ] || batch_refuse 1 "$sb_i" put "$sb_key" ERR_ENTITY_EXISTS "key '$sb_key' cannot be represented exactly beside '$sb_fold' under the filesystem's case folding; the two keys never coexist in namespace '$SB_NS'"
  done < "$STORE_BATCH_STAGE/man"
  SB_ON=0
}

store_batch() {
  FN=store.batch
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.batch takes one argument, the namespace"
  SB_NS=$1
  store_data store.batch "$SB_NS"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  batch_parse
  store_lock "$SB_NS"
  batch_validate
  batch_commit
  store_cleanup
  printf '{"namespace":"%s","actions":%s}\n' "$(escape_json "$SB_NS")" "$SB_N"
}

# store_scan: every key the module pattern admits with its raw value in base64, bytewise,
# one compact JSON answer; no limit (the module stops after the keys it needs)
store_scan() {
  FN=store.scan
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.scan takes one argument, the namespace"
  sc_ns=$1
  store_data store.scan "$sc_ns"
  sc_b64=""
  for sc_c in "$SCRIPT_DIR/../../scripts/store-b64" "$STORE_WS/.contexture/storage/scripts/store-b64" "$STORE_WS/base/.contexture/storage/scripts/store-b64"; do
    if [ -x "$sc_c" ]; then sc_b64=$sc_c; break; fi
  done
  [ -n "$sc_b64" ] || refuse 2 ERR_STORAGE_READ "the storage core base64 encoder is not installed"
  sc_keys=$(mktemp "$(scratch_dir)/store-scan.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  store_list_keys > "$sc_keys"
  printf '{"namespace":"%s","items":[' "$(escape_json "$sc_ns")"
  sc_first=1
  while IFS= read -r sc_key; do
    [ -n "$sc_key" ] || continue
    sc_path=$(store_path "$sc_key")
    [ -f "$sc_path" ] || continue
    sc_v=$("$sc_b64" "$sc_path") || { rm -f "$sc_keys"; refuse 2 ERR_STORAGE_READ "cannot read key '$sc_key' in namespace '$sc_ns'"; }
    if [ "$sc_first" -eq 1 ]; then sc_first=0; else printf ','; fi
    printf '{"key":"%s","value_b64":"%s"}' "$(escape_json "$sc_key")" "$sc_v"
  done < "$sc_keys"
  rm -f "$sc_keys"
  printf ']}\n'
}

# store_query_read: the query payload line, decoded (backslash, n, t, r), with a sentinel
# so a trailing newline survives the command substitution
cr_byte=$(printf '\r')
store_query_read() {
  sq_seen=0; sq_raw=""
  while IFS= read -r sq_l || [ -n "$sq_l" ]; do
    sq_l=${sq_l%"$cr_byte"}
    case "$sq_l" in
      query=*)
        [ "$sq_seen" -eq 0 ] || refuse 1 ERR_INVALID_ARGUMENT "duplicate payload line 'query='"
        sq_seen=1; sq_raw=${sq_l#query=} ;;
      '') ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown payload line '$sq_l' (query= only)" ;;
    esac
  done
  [ "$sq_seen" -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the query payload"
  SQ_RAW="$sq_raw" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SQ_RAW"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n") out = out "\n"
        else if (c == "t") out = out "\t"
        else if (c == "r") out = out "\r"
        else out = out c
      } else out = out c
    }
    printf "%sX", out
  }'
}

# store_search <namespace> <mode> [<limit>]: the exact rule over the raw stored values; the
# query travels on stdin as a query= payload line. A ranked mode refuses here (posix
# declares exact alone), and a mode the module does not declare refuses too.
store_search() {
  FN=store.search
  [ $# -ge 2 ] && [ $# -le 3 ] || refuse 1 ERR_INVALID_ARGUMENT "store.search takes the namespace, the mode, and an optional limit"
  ss_ns=$1; ss_mode=$2; ss_lim=${3:-20}
  case "$ss_mode" in
    ''|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$ss_mode'" ;;
  esac
  case "$ss_lim" in
    ''|*[!0-9]*|0) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a positive number: '$ss_lim'" ;;
  esac
  store_data store.search "$ss_ns"
  case ",$SD_MODES," in
    *",$ss_mode,"*) ;;
    *) refuse 1 ERR_CAPABILITY_UNSUPPORTED "mode '$ss_mode' is not declared by namespace '$ss_ns'; declared modes: $SD_MODES" ;;
  esac
  [ "$ss_mode" = exact ] || refuse 1 ERR_CAPABILITY_UNSUPPORTED "mode '$ss_mode' is not supported; declared modes: exact"
  ss_q=$(store_query_read) || exit $?
  ss_q=${ss_q%X}
  case "$ss_q" in *[![:space:]]*) ;; *) refuse 1 ERR_INVALID_ARGUMENT "the search query is empty" ;; esac
  ss_core=""
  for ss_c in "$SCRIPT_DIR/../../scripts/store-search" "$STORE_WS/.contexture/storage/scripts/store-search" "$STORE_WS/base/.contexture/storage/scripts/store-search"; do
    if [ -x "$ss_c" ]; then ss_core=$ss_c; break; fi
  done
  [ -n "$ss_core" ] || refuse 2 ERR_STORAGE_READ "the storage core search engine is not installed"
  ss_keytmp=$(mktemp "$(scratch_dir)/store-search.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  ss_man="${ss_keytmp}.man"
  store_list_keys > "$ss_keytmp"
  : > "$ss_man"
  while IFS= read -r ss_k; do
    [ -n "$ss_k" ] || continue
    ss_p=$(store_path "$ss_k")
    [ -f "$ss_p" ] && printf '%s\t%s\n' "$ss_k" "$ss_p" >> "$ss_man"
  done < "$ss_keytmp"
  rm -f "$ss_keytmp"
  "$ss_core" exact "$SD_FILE" "$ss_ns" "$ss_q" "$ss_lim" "$ss_man"
  ss_rc=$?
  rm -f "$ss_man"
  exit "$ss_rc"
}

# px_mkdtemp <parent> <prefix>: a fresh private folder (mkdir is atomic; the name carries the
# pid and a counter), POSIX tools alone, no mktemp
px_mkdtemp() {
  pm_n=0
  while [ "$pm_n" -lt 100 ]; do
    pm_d="$1/$2.$$.$pm_n"
    if mkdir -m 700 "$pm_d" 2>/dev/null; then printf '%s\n' "$pm_d"; return 0; fi
    pm_n=$((pm_n + 1))
  done
  return 1
}

px_init() {
  WS=$(find_workspace_root)
  SESS="$WS/.contexture/sessions"
  SCR=$(px_mkdtemp "$(scratch_dir)" posix) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch folder"
  : > "$SCR/man"
  : > "$SCR/files"
  : > "$SCR/err"
}

want_unit() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  ident_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$1'"
}

# held <unit>: the store holds the unit (its folder holds a state)
held() { [ -f "$SESS/$1/state.md" ]; }

want_held() {
  want_unit "$1"
  held "$1" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
}

# the manifest: F lines (key, path) with the sizes one wc answers, U lines per unit held,
# L lines per lane of a unit (a lane folder holding at least one artifact), in bytewise
# order (the C locale's glob)
man_file() {
  if [ -f "$2" ]; then
    printf 'F\t%s\t%s\n' "$1" "$2" >> "$SCR/man"
    printf '%s\n' "$2" >> "$SCR/files"
  fi
}

man_unit() {
  mu_d="$SESS/$1"
  [ -f "$mu_d/state.md" ] || return 0
  printf 'U\t%s\n' "$1" >> "$SCR/man"
  man_file "$1|state" "$mu_d/state.md"
  case " $2 " in *" backlog "*) man_file "$1|backlog" "$mu_d/backlog.md" ;; esac
  case " $2 " in *" knowledge "*) man_file "$1|knowledge" "$mu_d/knowledge.md" ;; esac
  case " $2 " in *" journal "*) man_file "$1|journal" "$mu_d/journal.md" ;; esac
  if [ -d "$mu_d/lanes" ]; then
    for mu_l in "$mu_d"/lanes/*; do
      [ -d "$mu_l" ] || continue
      mu_n=${mu_l##*/}
      ident_valid "$mu_n" || continue
      # a lane is its artifacts (end review item 8): a folder holding no recipe, journal,
      # or report is no lane, whatever other files it holds (lane.get refuses it, every
      # listing skips it, lane.create of the name lands beside those files)
      [ -f "$mu_l/recipe.md" ] || [ -f "$mu_l/journal.md" ] || [ -f "$mu_l/report.md" ] || continue
      printf 'L\t%s\t%s\n' "$1" "$mu_n" >> "$SCR/man"
      case " $2 " in
        *" lanes "*|*" lane:$mu_n "*)
          man_file "$1|lane/$mu_n/recipe" "$mu_l/recipe.md"
          man_file "$1|lane/$mu_n/journal" "$mu_l/journal.md"
          man_file "$1|lane/$mu_n/report" "$mu_l/report.md"
          ;;
      esac
    done
  fi
}

# man_all_units [<parts>]: every unit the store holds, bytewise
man_all_units() {
  [ -d "$SESS" ] || return 0
  for ma_d in "$SESS"/*; do
    [ -d "$ma_d" ] || continue
    ma_u=${ma_d##*/}
    ident_valid "$ma_u" || continue
    man_unit "$ma_u" "${1:-}"
  done
}

man_sizes() {
  : > "$SCR/sizes"
  [ -s "$SCR/files" ] || return 0
  set --
  while IFS= read -r ms_p; do set -- "$@" "$ms_p"; done < "$SCR/files"
  wc -c "$@" > "$SCR/sizes" 2>/dev/null || refuse 2 ERR_STORAGE_READ "cannot read the unit's artifacts"
}

payload_stage() {
  PAYLOAD_FILE="$SCR/payload"
  cat > "$PAYLOAD_FILE" || refuse 2 ERR_STORAGE_READ "cannot read the payload"
}

# px_awk <program files...>: one awk run over the manifest; its refusal passes through
px_awk() {
  man_sizes
  PX_FN="$FN" PX_UNIT="${PX_UNIT:-}" PX_MAN="$SCR/man" PX_SIZES="$SCR/sizes" PX_PAY="${PAYLOAD_FILE:-}" \
    PX_ERR="$SCR/err" PX_STAGE="${STAGE:-}" PX_OUT="${PX_OUT:-}" \
    awk -f "$SCRIPT_DIR/canon.awk" -f "$SCRIPT_DIR/model.awk" -f "$SCRIPT_DIR/ops.awk"
  pa_rc=$?
  if [ "$pa_rc" -ne 0 ]; then
    if [ -s "$SCR/err" ]; then cat "$SCR/err" >&2; else printf '%s: error: the record engine failed (rc %s) (ERR_STORAGE_READ)\n' "$FN" "$pa_rc" >&2; pa_rc=2; fi
    exit "$pa_rc"
  fi
}

# px_lock <unit>: the unit lock folder, held until px_cleanup; its pid file names the
# holder. A waiter removes a lock whose pid is gone (a SIGKILLed writer), and gives a lock
# with no pid file a second's grace for its holder to write one; a live holder still ends
# in ERR_STORAGE_LOCKED after five seconds.
px_lock() {
  pl_dir=$(get_lock_dir)
  pl_t="$pl_dir/$1.lock"
  pl_n=0
  pl_miss=0
  while [ "$pl_n" -lt 50 ]; do
    if mkdir "$pl_t" 2>/dev/null; then
      printf '%s\n' "$$" > "$pl_t/pid" 2>/dev/null || {
        rm -rf "$pl_t" 2>/dev/null
        refuse 2 ERR_STORAGE_WRITE "cannot write the unit lock holder pid"
      }
      PX_LOCK="$pl_t"; return 0
    fi
    pl_pid=$(cat "$pl_t/pid" 2>/dev/null)
    case "$pl_pid" in
      ""|*[!0-9]*)
        pl_miss=$((pl_miss + 1))
        if [ "$pl_miss" -ge 10 ]; then rm -rf "$pl_t" 2>/dev/null; pl_miss=0; continue; fi
        ;;
      *)
        if kill -0 "$pl_pid" 2>/dev/null; then pl_miss=0
        else rm -rf "$pl_t" 2>/dev/null; continue
        fi
        ;;
    esac
    pl_n=$((pl_n + 1))
    sleep 0.1 2>/dev/null || sleep 1
  done
  refuse 2 ERR_STORAGE_LOCKED "the unit lock of '$1' is held (5 s timeout)"
}

px_stage() {
  mkdir -p "$SESS" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "cannot create the sessions folder"
  STAGE=$(px_mkdtemp "$SESS" .stage) || refuse 2 ERR_STORAGE_WRITE "cannot stage the write"
  PX_OUT="$SCR/answer"
}

# the commit's undo log: PC_K_<n> (f a file replaced or created, d a folder created),
# PC_P_<n> its path, PC_B_<n> the backup of the file it replaced ("" when it was new)
pc_note() {
  PC_N=$((PC_N + 1))
  eval "PC_K_$PC_N=\$1; PC_P_$PC_N=\$2; PC_B_$PC_N=\${3:-}"
}

# pc_dir <folder>: the folder made when absent, noted so a rollback removes it again
pc_dir() {
  [ -d "$1" ] && return 0
  pd_up=$(dirname "$1")
  pc_dir "$pd_up" || return 1
  pc_note d "$1"
  mkdir "$1" 2>/dev/null || [ -d "$1" ] || return 1
}

# pc_backup <path>: a hard link of the file about to be replaced or removed, kept in the
# stage (the same filesystem), a copy where the link is refused; prints the backup path
pc_backup() {
  [ -f "$1" ] || { printf '\n'; return 0; }
  pb_b="$STAGE/.bak.$((PC_N + 1))"
  ln "$1" "$pb_b" 2>/dev/null || cp -p "$1" "$pb_b" 2>/dev/null || return 1
  printf '%s\n' "$pb_b"
}

# pc_rollback: every noted step undone, the last first: a replaced file gets its backup
# back, a created file and a created folder go
pc_rollback() {
  PC_ON=0
  while [ "$PC_N" -gt 0 ]; do
    eval "pr_k=\$PC_K_$PC_N; pr_p=\$PC_P_$PC_N; pr_b=\$PC_B_$PC_N"
    case "$pr_k" in
      f) if [ -n "$pr_b" ]; then mv -f "$pr_b" "$pr_p" 2>/dev/null; else rm -f "$pr_p" 2>/dev/null; fi ;;
      d) rmdir "$pr_p" 2>/dev/null ;;
    esac
    PC_N=$((PC_N - 1))
  done
}

# px_commit <unit folder>: every staged step applied in manifest order (one mv per file, a
# removal, a folder), then the answer; each replaced or removed file is backed up first, so a
# failed step (rc 2 ERR_STORAGE_WRITE, no answer) or an interrupt rolls every earlier step
# back and the unit reads as before (R20)
px_commit() {
  pc_ud=$1
  PC_ON=1
  if [ -f "$STAGE/manifest" ]; then
    while IFS='	' read -r pc_src pc_rel; do
      case "$pc_src" in
        d) pc_dir "$pc_ud/$pc_rel" || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed" ;;
        -)
          [ -f "$pc_ud/$pc_rel" ] || continue
          pc_b=$(pc_backup "$pc_ud/$pc_rel") || refuse 2 ERR_STORAGE_WRITE "the storage removal of $pc_rel failed"
          # noted before the step: an interrupt landing right after it still undoes it
          pc_note f "$pc_ud/$pc_rel" "$pc_b"
          rm -f "$pc_ud/$pc_rel" 2>/dev/null && [ ! -f "$pc_ud/$pc_rel" ] || refuse 2 ERR_STORAGE_WRITE "the storage removal of $pc_rel failed"
          ;;
        *)
          pc_dir "$(dirname "$pc_ud/$pc_rel")" || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed"
          pc_b=$(pc_backup "$pc_ud/$pc_rel") || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed"
          pc_note f "$pc_ud/$pc_rel" "$pc_b"
          mv -f "$STAGE/$pc_src" "$pc_ud/$pc_rel" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed"
          ;;
      esac
    done < "$STAGE/manifest"
  fi
  PC_ON=0
  cat "$SCR/answer"
}

# px_extra <n> <argv...>: no argument beyond the n the function takes
px_extra() {
  pe_n=$1
  shift
  [ $# -le "$pe_n" ] || refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$(eval "printf '%s' \"\${$((pe_n + 1))}\"")'"
}

px_args() {
  PX_NA=0
  export PX_NA
  for pa_a in "$@"; do
    PX_NA=$((PX_NA + 1))
    eval "PX_A$PX_NA=\$pa_a; export PX_A$PX_NA"
  done
}

# rec_read <function> <unit> <parts> <argv after the unit...>: a read of one held unit
rec_read() {
  FN=$1; want_held "$2"
  PX_UNIT=$2; export PX_UNIT
  man_unit "$2" "$3"
  shift 3
  px_args "$@"
  px_awk
}

# rec_write <function> <unit> <parts> <argv after the unit...>: a write of one held unit
rec_write() {
  FN=$1; want_held "$2"
  PX_UNIT=$2; export PX_UNIT
  rw_parts=$3
  shift 3
  px_args "$@"
  payload_stage
  px_lock "$PX_UNIT"
  px_stage
  man_unit "$PX_UNIT" "$rw_parts"
  px_awk
  px_commit "$SESS/$PX_UNIT"
}

capability() {
  printf '{"driver":"posix","version":"3.0.0","contract":"2","functions":["capability","storage.health","session.create","session.list","session.load","session.refload","session.board","session.audit","session.stamp","session.next","session.refs","session.close","session.reopen","session.units","session.refs_to","task.add","task.update","task.start","task.complete","task.reopen","task.drop","task.list","task.get","entry.record","entry.get","entry.list","entry.closure","finding.add","finding.update","finding.supersede","finding.drop","finding.get","finding.list","lane.create","lane.record","lane.write_report","lane.get","search.query"],"store":["list","get","put","delete","changes","batch","scan"],"search_modes":["exact"],"optional":["store"]}\n'
}

storage_health() {
  sh_health="ok"
  if [ ! -d "$SESS" ]; then
    sh_health="degraded"
    sh_detail="sessions directory does not exist yet (will be created on bootstrap)"
  elif [ ! -w "$SESS" ]; then
    sh_health="error"
    sh_detail="sessions directory is not writable"
  else
    sh_detail="sessions directory writable, unlocked"
    if [ -d "$SESS/.lock" ]; then
      sh_health="locked"
      sh_detail="storage lock active"
    fi
  fi
  man_all_units ""
  PX_HEALTH=$sh_health PX_DETAIL=$sh_detail px_awk
}

search_query() {
  want_unit "${1:-}"
  sq_u=$1
  shift
  sq_limit=20
  sq_entity=all
  sq_mode=exact
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$sq_a'" ;;
    esac
  done
  case "$sq_limit" in
    ""|*[!0-9]*|0) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a positive number: '$sq_limit'" ;;
  esac
  case "$sq_entity" in
    all|session|task|entry|finding|lane|lane_entry) ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "unknown entity type '$sq_entity' (session, task, entry, finding, lane, lane_entry, all)" ;;
  esac
  case "$sq_mode" in
    ""|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$sq_mode'" ;;
  esac
  held "$sq_u" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sq_u' not found"
  payload_stage
  # the searched text is the rendered one: the unit parsed whole, every item's canonical span
  man_unit "$sq_u" "backlog knowledge journal lanes"
  man_sizes
  PX_PAY="$PAYLOAD_FILE" PX_ERR="$SCR/err" PX_MAN="$SCR/man" PX_SIZES="$SCR/sizes" SQ_UNIT="$sq_u" SQ_LIMIT="$sq_limit" SQ_ENTITY="$sq_entity" SQ_MODE="$sq_mode" \
    awk -f "$SCRIPT_DIR/canon.awk" -f "$SCRIPT_DIR/model.awk" -f "$SCRIPT_DIR/search.awk" < /dev/null > "$SCR/answer"
  sq_rc=$?
  if [ "$sq_rc" -ne 0 ]; then
    if [ -s "$SCR/err" ]; then cat "$SCR/err" >&2; else printf '%s: error: the search failed (rc %s) (ERR_STORAGE_READ)\n' "$FN" "$sq_rc" >&2; sq_rc=2; fi
    exit "$sq_rc"
  fi
  cat "$SCR/answer"
}

# session.create <unit> | objective, repos (list), attention
session_create() {
  FN=session.create
  want_unit "${1:-}"
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  payload_stage
  px_lock "$PX_UNIT"
  [ -e "$SESS/$PX_UNIT" ] && refuse 1 ERR_ENTITY_EXISTS "unit '$PX_UNIT' already exists"
  px_stage
  px_awk
  mkdir "$SESS/$PX_UNIT" 2>/dev/null || refuse 1 ERR_ENTITY_EXISTS "unit '$PX_UNIT' already exists"
  pc_note d "$SESS/$PX_UNIT"
  px_commit "$SESS/$PX_UNIT"
}

# session.load <unit>: the unit and every unit its ref_sessions name
session_load() {
  FN=session.load
  want_held "${1:-}"
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  man_unit "$1" ""
  FN=state.refs
  sl_refs=$(px_awk)
  FN=session.load
  : > "$SCR/man"; : > "$SCR/files"
  man_unit "$1" "backlog knowledge journal"
  for sl_r in $sl_refs; do
    ident_valid "$sl_r" || continue
    [ "$sl_r" = "$1" ] && continue
    man_unit "$sl_r" "backlog knowledge journal"
  done
  px_awk
}

session_refload() {
  FN=session.refload
  [ $# -ge 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  for sr_u in "$@"; do
    want_unit "$sr_u"
    held "$sr_u" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sr_u' not found"
  done
  PX_UNIT=$1; export PX_UNIT
  for sr_u in "$@"; do
    grep -q "^U	$sr_u\$" "$SCR/man" || man_unit "$sr_u" "backlog knowledge journal"
  done
  shift
  px_args "$@"
  px_awk
}

session_refs() {
  FN=session.refs
  want_held "${1:-}"
  sf_u=$1
  shift
  for sf_r in "$@"; do
    ident_valid "$sf_r" || refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$sf_r'"
  done
  PX_UNIT=$sf_u; export PX_UNIT
  px_args "$@"
  payload_stage
  px_lock "$sf_u"
  px_stage
  man_all_units ""
  px_awk
  px_commit "$SESS/$sf_u"
}

session_units() {
  FN=session.units
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the repo"
  case "$1" in
    [!A-Za-z0-9._-]*|*[!A-Za-z0-9._/-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed repo '$1'" ;;
  esac
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  man_all_units ""
  px_awk
}

session_refs_to() {
  FN=session.refs_to
  want_unit "${1:-}"
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  man_all_units ""
  px_awk
}

# lane_doc <function> <unit> <lane> <recipe|report>: lane.create or lane.write_report, the
# document raw on stdin
lane_doc() {
  FN=$1; want_held "${2:-}"
  [ -n "${3:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
  ident_valid "$3" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$3'"
  PX_UNIT=$2; export PX_UNIT
  px_args "$3"
  px_lock "$PX_UNIT"
  px_stage
  cat > "$STAGE/doc" || refuse 2 ERR_STORAGE_READ "cannot read the document"
  PX_DOCSIZE=$(wc -c < "$STAGE/doc" | tr -d ' '); export PX_DOCSIZE
  man_unit "$PX_UNIT" ""
  px_awk
  px_commit "$SESS/$PX_UNIT"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
FN=$cmd

case "$cmd" in
  capability) capability; exit 0 ;;
  store.list) store_list "$@"; exit $? ;;
  store.get) store_get "$@"; exit $? ;;
  store.put) store_put "$@"; exit $? ;;
  store.delete) store_delete "$@"; exit $? ;;
  store.changes) store_changes "$@"; exit $? ;;
  store.batch) store_batch "$@"; exit $? ;;
  store.scan) store_scan "$@"; exit $? ;;
  store.search) store_search "$@"; exit $? ;;
esac

px_init

case "$cmd" in
  storage.health)
    px_extra 0 "$@"
    storage_health
    ;;
  session.create) session_create "$@" ;;
  session.list)
    px_extra 0 "$@"
    man_all_units journal
    px_awk
    ;;
  session.load) session_load "$@" ;;
  session.refload) session_refload "$@" ;;
  session.board)
    px_extra 1 "$@"
    rec_read "$cmd" "${1:-}" "backlog journal"
    ;;
  session.audit)
    px_extra 1 "$@"
    rec_read "$cmd" "${1:-}" "backlog journal"
    ;;
  session.stamp)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "journal"
    ;;
  session.next)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "backlog"
    ;;
  session.close)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "backlog journal"
    ;;
  session.reopen)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" ""
    ;;
  session.refs) session_refs "$@" ;;
  session.units) session_units "$@" ;;
  session.refs_to) session_refs_to "$@" ;;
  task.add|task.update|task.start|task.complete|task.reopen|task.drop|task.get)
    px_extra 2 "$@"
    FN=$cmd
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the task slug"
    ident_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed task slug '$2'"
    case "$cmd" in
      task.get) rec_read "$cmd" "$1" "backlog" "$2" ;;
      task.complete|task.drop) rec_write "$cmd" "$1" "backlog journal" "$2" ;;
      *) rec_write "$cmd" "$1" "backlog" "$2" ;;
    esac
    ;;
  task.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      TODO|IN_PROGRESS|DONE|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "task.list takes TODO, IN_PROGRESS, DONE, or all: '${2:-}'" ;;
    esac
    rec_read "$cmd" "$1" "backlog" "$2"
    ;;
  entry.record)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "journal"
    ;;
  entry.get|entry.closure)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the entry slug"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed entry slug '$2'"
    rec_read "$cmd" "$1" "journal" "$2"
    ;;
  entry.list)
    want_unit "${1:-}"
    el_u=$1
    shift
    for el_a in "$@"; do
      case "$el_a" in
        --anchor=A[0-9]*) case "${el_a#--anchor=A}" in *[!0-9]*) refuse 1 ERR_INVALID_ARGUMENT "--anchor takes A<N>: '$el_a'" ;; esac ;;
        --group=?*) case "${el_a#--group=}" in [!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed group in '$el_a'" ;; esac ;;
        *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$el_a'" ;;
      esac
    done
    rec_read "$cmd" "$el_u" "journal" "$@"
    ;;
  finding.add|finding.update|finding.drop|finding.get)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the finding NAME"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$2'"
    case "$cmd" in
      finding.get) rec_read "$cmd" "$1" "knowledge" "$2" ;;
      *) rec_write "$cmd" "$1" "knowledge" "$2" ;;
    esac
    ;;
  finding.supersede)
    px_extra 3 "$@"
    want_unit "${1:-}"
    for fs_n in "${2:-}" "${3:-}"; do
      [ -n "$fs_n" ] || refuse 1 ERR_INVALID_ARGUMENT "finding.supersede takes the unit, OLD, and NEW"
      name_valid "$fs_n" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$fs_n'"
    done
    rec_write "$cmd" "$1" "knowledge" "$2" "$3"
    ;;
  finding.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      active|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "finding.list takes active or all: '${2:-}'" ;;
    esac
    rec_read "$cmd" "$1" "knowledge" "$2"
    ;;
  lane.create|lane.write_report)
    px_extra 2 "$@"
    lane_doc "$cmd" "${1:-}" "${2:-}"
    ;;
  lane.record)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    ident_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    rec_write "$cmd" "$1" "lane:$2" "$2"
    ;;
  lane.get)
    px_extra 3 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    ident_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    case "${3:-}" in
      recipe|journal|report) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "lane.get takes recipe, journal, or report: '${3:-}'" ;;
    esac
    rec_read "$cmd" "$1" "lane:$2" "$2" "$3"
    ;;
  search.query) search_query "$@" ;;
  *) refuse 2 ERR_CAPABILITY_UNSUPPORTED "unknown function '$cmd'" ;;
esac
exit 0
