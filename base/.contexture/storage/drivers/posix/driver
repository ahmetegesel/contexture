#!/bin/sh
# driver: the zero-dependency POSIX storage driver (contract 3, docs/the-engine.md, The
# descriptor and the handshake). The driver is store-only: it answers capability and
# storage.health as its own methods and the seven generic module store functions
# (store.list, store.get, store.put, store.delete, store.changes, store.batch, store.scan)
# over a module's declared data file and root, plus the store.search entry. The record's
# 35 operations live in the unit module's data script over this store; the driver keeps no
# record function. store.list takes an optional literal key prefix; store.search carries
# the document rules' entity_type and entity_id, collects every match, and applies the
# limit (0 = all) after the walk.
#
# A namespace may declare a fallback root, a deprecated root the store reads after its
# root and never writes: get, list, scan, search, and the key probe read the root first,
# then the fallback, the root's copy shadowing; put and batch write the root alone, and a
# delete removes the key from both. Under the namespace lock a put, a delete, and a batch
# first move each written key's top segment folder from the fallback to the root when the
# fallback alone holds it (one rename; both roots holding it refuses). A call that served
# a key from the fallback and answers rc 0 prints one notice line on stderr naming the
# function and the namespace. The optional store.promote moves a whole key prefix from the
# fallback to the root.
#
# Writes: the namespace lock (.contexture/tmp/locks/store-<namespace>.lock, carrying its
# holder pid) is held across the batch or put, each put is a same-directory temp renamed
# over the key, and a batch commits every key under one store-scope undo log so a failed
# step restores the earlier ones; a refusal stages nothing. Every awk runs in the C locale
# (bytes) and takes every value through the environment or a file, never through awk -v.

set -u

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
LC_ALL=C
export LC_ALL

find_workspace_root() {
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

get_tmp_dir() {
  ws=$(find_workspace_root)
  if [ -d "$ws/.contexture/tmp" ] && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  elif mkdir -p "$ws/.contexture/tmp" 2>/dev/null && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  else
    d="${TMPDIR:-/tmp}/contexture-${USER:-}"
    mkdir -p "$d" 2>/dev/null || true
    printf '%s\n' "$d"
  fi
}

get_lock_dir() {
  tmp_d=$(get_tmp_dir)
  mkdir -p "$tmp_d/locks" 2>/dev/null || true
  printf '%s/locks\n' "$tmp_d"
}

# scratch_dir: the per-verb root ctx exported (created on first use), else the drawer;
# every transient file stages here so a killed verb's root holds its residue
scratch_dir() {
  if [ -n "${CTX_SCRATCH_ROOT:-}" ] && mkdir -p "$CTX_SCRATCH_ROOT" 2>/dev/null \
    && [ -d "$CTX_SCRATCH_ROOT" ] && [ -w "$CTX_SCRATCH_ROOT" ]; then
    printf '%s\n' "$CTX_SCRATCH_ROOT"
  else
    get_tmp_dir
  fi
}

escape_json() {
  # every escape is written by split and concatenation (bs_double, sjoin), never by a gsub
  # replacement: awk builds read a backslash inside a replacement differently (busybox awk
  # and gawk --posix yield one backslash from four, Debian's busybox awk drops the backslash
  # before a quote, r, or t)
  printf '%s' "$1" | awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function sjoin(s, sep, lit,    n, p, i, o) { n = split(s, p, sep); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o lit p[i]; return o }
    BEGIN { ORS="" }
    {
      if (NR > 1) printf "\\n";
      s = bs_double($0);
      s = sjoin(s, "[\"]", "\\" "\"");
      s = sjoin(s, "[\r]", "\\" "r");
      s = sjoin(s, "[\t]", "\\" "t");
      printf "%s", s;
    }
  '
}

escape_json_lines() {
  # every line of a file as a comma-separated JSON string, in one awk pass
  awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function sjoin(s, sep, lit,    n, p, i, o) { n = split(s, p, sep); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o lit p[i]; return o }
    BEGIN { ORS = ""; first = 1 }
    {
      if (!first) printf ","
      first = 0
      s = bs_double($0);
      s = sjoin(s, "[\"]", "\\" "\"");
      s = sjoin(s, "[\r]", "\\" "r");
      s = sjoin(s, "[\t]", "\\" "t");
      printf "\"%s\"", s
    }
  ' "$1"
}


# ==============================================================================
# The store contract
# ==============================================================================
FN=""

# refuse <rc> <CODE> <message>: the one fixed stderr line of a refusal
refuse() {
  printf '%s: error: %s (%s)\n' "$FN" "$3" "$2" >&2
  exit "$1"
}

# scratch_new <file>...: each of this call's scratch files made empty; scratch_add <file>
# <format> [<args>...]: one printf appended to such a file. Both are silent (a shell reports a
# failing redirect before a trailing 2>/dev/null applies, so the group carries it) and
# answer nonzero when the write fails, for the caller to refuse rc 2 ERR_STORAGE_WRITE: a
# lost line would let a batch commit part of its actions or a read answer short
scratch_new() {
  for sw_f in "$@"; do
    { : > "$sw_f"; } 2>/dev/null || return 1
  done
}

scratch_add() {
  sa_f=$1
  shift
  { printf "$@" >> "$sa_f"; } 2>/dev/null
}

SCRATCH_FAILED="cannot write the driver's scratch file"

# ==============================================================================
# The generic module store (the storage core's store contract)
# ==============================================================================
# Seven data functions over a module's declared data file: store.list, store.get,
# store.put, store.delete, store.changes, store.batch, and store.scan. The data file
# (modules/<module>/data) is read and validated by the storage core's private store-data
# script; the posix mapping is <root>/<key><suffix> under the workspace root, the module's
# declared root.
# Keys are exact, ASCII-case-fold twins never coexist, list is bytewise
# and filtered by the module pattern, put is a same-directory temp moved over the key
# under one namespace scope lock, and the change log belongs to a store driver (posix
# keeps none). The batch holds that same namespace lock once, validates its whole action
# list, stages a put value per action, and commits every key under one store-scope undo
# log so it lands whole or not at all; the scan answers every admitted key with its raw
# value in base64.
STORE_WS=""
STORE_TMP=""
STORE_LOCK=""
STORE_BATCH_STAGE=""
STORE_SDERR=""
STORE_TEMPS=""
STORE_FB_SERVED=0
SB_ON=0

# store_temp <path>: a read's temp file, named for store_cleanup as soon as mktemp answers it,
# so a HUP, INT, or TERM during the read removes it (a signal inside mktemp's own fork,
# before the name is back, is the one window left)
store_temp() {
  STORE_TEMPS="$STORE_TEMPS$1
"
}

store_cleanup() {
  [ "${SB_ON:-0}" -eq 1 ] && sb_rollback
  SB_ON=0
  [ -n "${STORE_SDERR:-}" ] && rm -f "$STORE_SDERR" 2>/dev/null
  STORE_SDERR=""
  if [ -n "${STORE_TEMPS:-}" ]; then
    printf '%s' "$STORE_TEMPS" | while IFS= read -r st_f; do
      [ -n "$st_f" ] && rm -f "$st_f" 2>/dev/null
    done
    STORE_TEMPS=""
  fi
  [ -n "${STORE_TMP:-}" ] && rm -f "$STORE_TMP" 2>/dev/null
  STORE_TMP=""
  [ -n "${STORE_BATCH_STAGE:-}" ] && rm -rf "$STORE_BATCH_STAGE" 2>/dev/null
  STORE_BATCH_STAGE=""
  store_unlock
  return 0
}

store_unlock() {
  [ -n "${STORE_LOCK:-}" ] || return 0
  su_lock=$STORE_LOCK
  STORE_LOCK=""
  rm -rf "$su_lock" 2>/dev/null
  su_base=$(get_lock_dir)
  su_p=$(dirname "$su_lock")
  while [ "$su_p" != "$su_base" ] && [ "$su_p" != "/" ]; do
    rmdir "$su_p" 2>/dev/null || break
    su_p=$(dirname "$su_p")
  done
  return 0
}

# store_lock <namespace>: one namespace scope lock shared by store.put, store.delete, and
# store.batch, a folder under the drawer's lock folder, held until store_unlock. The folder
# carries its holder pid; a waiter removes a lock whose pid is gone, gives a lock with no
# pid file ten polls of grace for its holder to write one, and refuses a live holder rc 2
# ERR_STORAGE_LOCKED after 600 polls 0.1 s apart, 60 s of sleep (the unit lock's wait;
# where sleep refuses a fraction, a poll sleeps 1 s and counts as ten). STORE_LOCK names
# the folder only once mkdir holds it, so a waiter's interrupt trap removes nothing.
store_lock() {
  sl_lock="$(get_lock_dir)/store-$1.lock"
  mkdir -p "$(dirname "$sl_lock")" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "cannot make the store lock folder"
  sl_n=0
  sl_miss=0
  while [ "$sl_n" -lt 600 ]; do
    if mkdir "$sl_lock" 2>/dev/null; then
      STORE_LOCK=$sl_lock
      { printf '%s\n' "$$" > "$STORE_LOCK/pid"; } 2>/dev/null || {
        rm -rf "$STORE_LOCK" 2>/dev/null
        STORE_LOCK=""
        refuse 2 ERR_STORAGE_WRITE "cannot write the store lock holder pid"
      }
      return 0
    fi
    sl_pid=$(cat "$sl_lock/pid" 2>/dev/null)
    case "$sl_pid" in
      ""|*[!0-9]*)
        sl_miss=$((sl_miss + 1))
        if [ "$sl_miss" -ge 10 ]; then rm -rf "$sl_lock" 2>/dev/null; sl_miss=0; continue; fi
        ;;
      *)
        if kill -0 "$sl_pid" 2>/dev/null; then sl_miss=0
        else rm -rf "$sl_lock" 2>/dev/null; continue
        fi
        ;;
    esac
    sl_n=$((sl_n + 1))
    sleep 0.1 2>/dev/null || { sleep 1; sl_n=$((sl_n + 9)); }
  done
  refuse 2 ERR_STORAGE_LOCKED "the store namespace '$1' is locked (60 s timeout)"
}

# store_lock_held <namespace>: rc 0 while a writer holds the namespace lock, found without a
# write in the folder get_lock_dir answers (the drawer's while its scratch folder is
# writable, else the fallback). Held follows the waiter's rule: a pid-less lock is held, a
# lock whose pid is gone is not, since the next writer removes it.
store_lock_held() {
  lh_tmp="$(find_workspace_root)/.contexture/tmp"
  [ -d "$lh_tmp" ] && [ -w "$lh_tmp" ] || lh_tmp="${TMPDIR:-/tmp}/contexture-${USER:-}"
  lh_lock="$lh_tmp/locks/store-$1.lock"
  [ -d "$lh_lock" ] || return 1
  lh_pid=$(cat "$lh_lock/pid" 2>/dev/null)
  case "$lh_pid" in
    ""|*[!0-9]*) return 0 ;;
  esac
  kill -0 "$lh_pid" 2>/dev/null
}

# store_data <function> <namespace>: the validated fields of the namespace's data file in
# SD_NS, SD_ROOT, SD_FALLBACK (empty when none is declared), SD_SUFFIX, SD_KEYPAT,
# SD_CHANGES; the caller's function name frames the refusal. The storage core's store-data script owns the grammar (the core is
# base, so no module's parser enters base). The cleanup traps stand before the reader's
# stderr file exists, so a HUP, INT, or TERM while the reader runs removes it. A scratch
# file that cannot be made refuses as a write, and for the health probe, which writes
# nothing, as a read.
store_data() {
  FN=$1
  sd_ns=$2
  case "$FN" in
    storage.health) sd_scratch_code=ERR_STORAGE_READ ;;
    *) sd_scratch_code=ERR_STORAGE_WRITE ;;
  esac
  sd_ws=$(find_workspace_root)
  sd_script=""
  for sd_c in "$SCRIPT_DIR/../../scripts/store-data" \
              "$sd_ws/.contexture/storage/scripts/store-data" \
              "$sd_ws/base/.contexture/storage/scripts/store-data"; do
    if [ -x "$sd_c" ]; then sd_script=$sd_c; break; fi
  done
  [ -n "$sd_script" ] || refuse 2 ERR_STORAGE_READ "the storage core data reader is not installed"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  STORE_SDERR=$(mktemp "$(scratch_dir)/store-data.XXXXXX" 2>/dev/null) || refuse 2 "$sd_scratch_code" "cannot create the driver's scratch file"
  scratch_new "$STORE_SDERR" || refuse 2 "$sd_scratch_code" "$SCRATCH_FAILED"
  sd_out=$(CTX_STORE_WORKSPACE="$sd_ws" "$sd_script" "$sd_ns" --with-fallback 2>"$STORE_SDERR")
  sd_rc=$?
  sd_msg=$(head -n 1 "$STORE_SDERR" 2>/dev/null)
  rm -f "$STORE_SDERR"
  STORE_SDERR=""
  case "$sd_msg" in store-data:\ *) sd_msg=${sd_msg#store-data: } ;; esac
  [ -n "$sd_msg" ] || sd_msg="the namespace '$sd_ns' is not declared by a usable data file"
  case "$sd_rc" in
    0) ;;
    3) refuse 1 ERR_ENTITY_NOT_FOUND "$sd_msg" ;;
    2) refuse 2 ERR_STORAGE_READ "$sd_msg" ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "$sd_msg" ;;
  esac
  SD_NS=$(printf '%s\n' "$sd_out" | sed -n '1p')
  SD_ROOT=$(printf '%s\n' "$sd_out" | sed -n '2p')
  SD_SUFFIX=$(printf '%s\n' "$sd_out" | sed -n '3p')
  SD_KEYPAT=$(printf '%s\n' "$sd_out" | sed -n '4p')
  SD_CHANGES=$(printf '%s\n' "$sd_out" | sed -n '5p')
  SD_FILE=$(printf '%s\n' "$sd_out" | sed -n '6p')
  SD_FORM=$(printf '%s\n' "$sd_out" | sed -n '7p')
  SD_FORMAT=$(printf '%s\n' "$sd_out" | sed -n '8p')
  SD_FIELDS=$(printf '%s\n' "$sd_out" | sed -n '9p')
  SD_TITLE=$(printf '%s\n' "$sd_out" | sed -n '10p')
  SD_SNIPPET=$(printf '%s\n' "$sd_out" | sed -n '11p')
  SD_MODES=$(printf '%s\n' "$sd_out" | sed -n '12p')
  SD_FALLBACK=$(printf '%s\n' "$sd_out" | sed -n '13p')
  SD_DOCS=$(printf '%s\n' "$sd_out" | sed -n '14,$p')
  STORE_WS=$sd_ws
}

# store_key_ok <key>: the generic key rule: no blanks, control characters, leading slash,
# backslash, or . or .. segment, and every segment non-empty (exact, not folded)
store_key_ok() {
  SK_KEY="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SK_KEY"]
    if (s == "") exit 1
    if (substr(s, 1, 1) == "/" || substr(s, length(s), 1) == "/") exit 1
    if (s ~ /[[:cntrl:]]/ || index(s, " ") || index(s, "\\")) exit 1
    n = split(s, p, "/")
    for (i = 1; i <= n; i++) if (p[i] == "" || p[i] == "." || p[i] == "..") exit 1
    exit 0
  }'
}

# store_key_shape <pattern> <key>: the key's segments match the module's pattern; every
# pattern segment is a <name> placeholder and the key's segment count equals the pattern's,
# except that a final <name...> placeholder admits one or more segments (the variable-depth
# key that lets a module's main files and its deeper lane files share one pattern)
store_key_shape() {
  SSP_P="$1" SSP_K="$2" LC_ALL=C awk 'BEGIN {
    m = split(ENVIRON["SSP_P"], p, "/")
    n = split(ENVIRON["SSP_K"], k, "/")
    if (m < 1) exit 1
    multi = (p[m] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/)
    if (multi) { if (n < m) exit 1 } else { if (n != m) exit 1 }
    for (i = 1; i < m; i++) {
      if (p[i] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) exit 1
      if (k[i] == "") exit 1
    }
    if (multi) {
      for (i = m; i <= n; i++) if (k[i] == "") exit 1
    } else {
      if (p[m] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) exit 1
      if (k[m] == "") exit 1
    }
    exit 0
  }'
}

# store_prefix_ok <prefix>: the optional store.list prefix: one literal bytewise key
# prefix, possibly ending mid-segment or on a slash; no blank, control character,
# backslash, leading slash, or . or .. segment (a prefix is a filter, not a stored key)
store_prefix_ok() {
  SP_PREFIX="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SP_PREFIX"]
    if (s == "") exit 1
    if (substr(s, 1, 1) == "/") exit 1
    if (s ~ /[[:cntrl:]]/ || index(s, " ") || index(s, "\\")) exit 1
    n = split(s, p, "/")
    for (i = 1; i <= n; i++) if (p[i] == "." || p[i] == "..") exit 1
    exit 0
  }'
}

# store_key_for <function> <namespace> <key>: the key rule and the module pattern before a
# key reaches the filesystem
store_key_for() {
  FN=$1
  sk_key=$3
  store_key_ok "$sk_key" || refuse 1 ERR_INVALID_ARGUMENT "malformed key '$sk_key'"
  store_key_shape "$SD_KEYPAT" "$sk_key" || refuse 1 ERR_INVALID_ARGUMENT "key '$sk_key' does not match the namespace pattern '$SD_KEYPAT'"
}

# store_path <key>: the posix mapping of a validated key
store_path() {
  printf '%s/%s/%s%s\n' "$STORE_WS" "$SD_ROOT" "$1" "$SD_SUFFIX"
}

# store_list_keys [<prefix>] [first]: every key in the namespace, bytewise, the root's and
# the fallback root's together, each key once; a key only the fallback holds sets
# STORE_FB_SERVED when the call runs in the function's own shell. With first, the walk of
# each root stops at its first admitted key.
store_list_keys() {
  if [ -z "$SD_FALLBACK" ]; then
    store_list_root "$STORE_WS/$SD_ROOT" "${1:-}" "${2:-}"
    return
  fi
  slk_p=$(store_list_root "$STORE_WS/$SD_ROOT" "${1:-}" "${2:-}")
  slk_f=$(store_list_root "$STORE_WS/$SD_FALLBACK" "${1:-}" "${2:-}")
  if [ -n "$slk_f" ] && [ -n "$( { printf '%s\n' "$slk_p" | sed 's/^/p /'; printf '%s\n' "$slk_f" | sed 's/^/f /'; } \
    | LC_ALL=C awk '{ k = substr($0, 3); if (k == "") next; if (substr($0, 1, 1) == "p") p[k] = 1; else if (!(k in p)) { print 1; exit } }')" ]; then
    STORE_FB_SERVED=1
  fi
  printf '%s\n%s\n' "$slk_p" "$slk_f" | LC_ALL=C awk 'NF' | LC_ALL=C sort -u
}

# store_list_root <folder> [<prefix>] [first]: every key under one root folder, bytewise,
# only those the module pattern admits and, when a prefix is given, those that start with
# it; the folder entries are read as stored, so a case twin of a key never appears. The key
# rule and the module pattern run in one awk pass, and a prefix ending on a slash starts
# the walk at that directory (or answers nothing when the root holds no such directory), so
# a per-unit read does not pay for the namespace. With first, the walk stops at the first
# admitted key, the presence probe of the health.
store_list_root() {
  sl_dir=$1
  sl_prefix=${2:-}
  sl_first=${3:-}
  [ -d "$sl_dir" ] || return 0
  sl_scan=$sl_dir
  if [ -n "$sl_prefix" ]; then
    case "$sl_prefix" in
      */)
        sl_sub=${sl_prefix%/}
        [ -d "$sl_dir/$sl_sub" ] || return 0
        sl_scan="$sl_dir/$sl_sub"
        ;;
    esac
  fi
  find "$sl_scan" -type f -print 2>/dev/null | SL_DIR="$sl_dir" SL_SUFFIX="$SD_SUFFIX" SL_KEYPAT="$SD_KEYPAT" SL_PREFIX="$sl_prefix" SL_FIRST="$sl_first" LC_ALL=C awk '
    BEGIN {
      dir = ENVIRON["SL_DIR"]; sfx = ENVIRON["SL_SUFFIX"]; pre = ENVIRON["SL_PREFIX"]; first = (ENVIRON["SL_FIRST"] != "")
      m = split(ENVIRON["SL_KEYPAT"], p, "/")
      for (i = 1; i <= m; i++) multi[i] = (p[i] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/)
    }
    {
      f = $0
      if (substr(f, 1, length(dir) + 1) != dir "/") next
      key = substr(f, length(dir) + 2)
      if (sfx != "") {
        if (length(key) < length(sfx) || substr(key, length(key) - length(sfx) + 1) != sfx) next
        key = substr(key, 1, length(key) - length(sfx))
      }
      if (key == "") next
      if (substr(key, 1, 1) == "/" || substr(key, length(key), 1) == "/") next
      if (key ~ /[[:cntrl:]]/ || index(key, " ") || index(key, "\\")) next
      n = split(key, k, "/")
      ok = 1
      for (i = 1; i <= n; i++) if (k[i] == "" || k[i] == "." || k[i] == "..") { ok = 0; break }
      if (!ok) next
      if (m < 1) next
      if (multi[m]) { if (n < m) next } else { if (n != m) next }
      for (i = 1; i < m; i++) {
        if (p[i] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) next
        if (k[i] == "") next
      }
      if (multi[m]) {
        for (i = m; i <= n; i++) if (k[i] == "") next
      } else {
        if (p[m] !~ /^<[A-Za-z][A-Za-z0-9_]*>$/) next
        if (k[m] == "") next
      }
      if (pre != "" && substr(key, 1, length(pre)) != pre) next
      print key
      if (first) exit
    }' | LC_ALL=C sort
}

# store_key_exists <key>: the exact key the store lists, in the root or the fallback root
store_key_exists() {
  store_key_exists_in "$STORE_WS/$SD_ROOT" "$1" && return 0
  [ -n "$SD_FALLBACK" ] && store_key_exists_in "$STORE_WS/$SD_FALLBACK" "$1"
}

# store_read_path <key>: SR_PATH names the file a read of the key takes, the root's copy
# first, then the fallback's (which sets STORE_FB_SERVED); rc 1 when neither root holds it
store_read_path() {
  SR_PATH=""
  if store_key_exists_in "$STORE_WS/$SD_ROOT" "$1"; then
    SR_PATH=$(store_path "$1")
    return 0
  fi
  if [ -n "$SD_FALLBACK" ] && store_key_exists_in "$STORE_WS/$SD_FALLBACK" "$1"; then
    SR_PATH="$STORE_WS/$SD_FALLBACK/$1$SD_SUFFIX"
    STORE_FB_SERVED=1
    return 0
  fi
  return 1
}

# store_notice: the one notice line of a call that served a key from the fallback root
store_notice() {
  [ "$STORE_FB_SERVED" -eq 1 ] || return 0
  printf '%s: notice: namespace '\''%s'\'' was read from its deprecated fallback root\n' "$FN" "$SD_NS" >&2
}

# store_key_exists_in <folder> <key>: the exact key under one root folder (a case twin is
# absent). The walk checks each path segment's stored spelling at its own directory, so a
# case fold in any ancestor is refused and the namespace is never listed.
store_key_exists_in() {
  ske_key=$2
  ske_dir=$1
  [ -d "$ske_dir" ] || return 1
  ske_rest=$ske_key
  while :; do
    case "$ske_rest" in
      */*) ske_seg=${ske_rest%%/*}; ske_rest=${ske_rest#*/} ;;
      *) ske_seg=$ske_rest; ske_rest= ;;
    esac
    if [ -z "$ske_rest" ]; then
      ls -A "$ske_dir" 2>/dev/null | grep -F -x -q -e "$ske_seg$SD_SUFFIX" || return 1
      return 0
    fi
    ls -A "$ske_dir" 2>/dev/null | grep -F -x -q -e "$ske_seg" || return 1
    ske_dir="$ske_dir/$ske_seg"
    [ -d "$ske_dir" ] || return 1
  done
}

# store_twin <key>: a stored key that folds onto <key> under ASCII case without matching it
store_twin() {
  store_list_keys | ST_TARGET="$1" LC_ALL=C awk '
    { t = ENVIRON["ST_TARGET"]; if ($0 != t && tolower($0) == tolower(t)) { print; exit } }'
}

# store_fold_twin <key> <path>: a stored key whose file the path resolves to while the exact
# key is absent. A case-insensitive filesystem can fold more than ASCII (a Unicode case
# variant), so a put that wrote without this check would replace the stored key and lose the
# requested one; the exact key must always be the key the store lists.
store_fold_twin() {
  sft_key=$1
  sft_path=$2
  store_key_exists "$sft_key" && return 0
  [ -e "$sft_path" ] || return 0
  sft_ino=$(ls -di "$sft_path" 2>/dev/null | awk '{print $1}')
  [ -n "$sft_ino" ] || return 0
  store_list_keys | while IFS= read -r sft_k; do
    [ "$sft_k" = "$sft_key" ] && continue
    sft_p=$(store_path "$sft_k")
    sft_kino=$(ls -di "$sft_p" 2>/dev/null | awk '{print $1}')
    if [ -n "$sft_kino" ] && [ "$sft_kino" = "$sft_ino" ]; then
      printf '%s\n' "$sft_k"
      break
    fi
  done
}

# store_fold_refusal <namespace> <key> <stored key>: the fixed line for a key the filesystem
# cannot hold exactly beside <stored key>
store_fold_refusal() {
  refuse 1 ERR_ENTITY_EXISTS "key '$2' cannot be represented exactly beside '$3' under the filesystem's case folding; the two keys never coexist in namespace '$1'"
}

# store_flags <function> <default op> [flags]: --op=<op> and --head=<sha|none>, bounded
store_flags() {
  sf_fn=$1; SF_OP=$2
  shift 2
  SF_HEAD=none
  for sf_a in "$@"; do
    case "$sf_a" in
      --op=*) SF_OP=${sf_a#--op=} ;;
      --head=*) SF_HEAD=${sf_a#--head=} ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown argument '$sf_a'" ;;
    esac
  done
  case "$SF_OP" in
    ''|*[!A-Za-z0-9._-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed op '$SF_OP'" ;;
  esac
  case "$SF_HEAD" in
    none) ;;
    ''|*[!0-9a-fA-F]*) refuse 1 ERR_INVALID_ARGUMENT "--head takes a commit id or none: '$SF_HEAD'" ;;
  esac
}

store_list() {
  FN=store.list
  [ $# -ge 1 ] && [ $# -le 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.list takes the namespace and an optional key prefix"
  sn_ns=$1
  sn_prefix=${2:-}
  if [ -n "$sn_prefix" ]; then
    store_prefix_ok "$sn_prefix" || refuse 1 ERR_INVALID_ARGUMENT "malformed key prefix '$sn_prefix'"
  fi
  store_data store.list "$sn_ns"
  sn_tmp=$(mktemp "$(scratch_dir)/store-keys.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  store_temp "$sn_tmp"
  if ! { store_list_keys "$sn_prefix" > "$sn_tmp"; } 2>/dev/null; then
    rm -f "$sn_tmp"
    refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"
  fi
  printf '{"namespace":"%s","keys":[' "$(escape_json "$sn_ns")"
  escape_json_lines "$sn_tmp"
  rm -f "$sn_tmp"
  printf ']}\n'
  store_notice
}

store_get() {
  FN=store.get
  [ $# -eq 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.get takes the namespace and the key"
  sg_ns=$1; sg_key=$2
  store_data store.get "$sg_ns"
  store_key_for store.get "$sg_ns" "$sg_key"
  store_read_path "$sg_key" || refuse 1 ERR_ENTITY_NOT_FOUND "key '$sg_key' not found in namespace '$sg_ns'"
  cat "$SR_PATH" 2>/dev/null || refuse 2 ERR_STORAGE_READ "cannot read key '$sg_key' in namespace '$sg_ns'"
  store_notice
}

# store_fallback_drop: the fallback root folder removed when it holds nothing; rmdir refuses
# silently while any entry remains, so the answer is always rc 0 and nothing is printed
store_fallback_drop() {
  rmdir "$STORE_WS/$SD_FALLBACK" 2>/dev/null
  return 0
}

# store_lift <folder>: the fallback root's folder (a key prefix without its slash) moved to
# the root by one rename, under the namespace lock the caller holds, then the fallback root
# dropped when the move emptied it; rc 0 when it moved or the fallback holds no such folder
# (a namespace without a fallback checks no folder), rc 1 when the root holds it too, rc 2
# when the move failed. The caller frames the refusal.
store_lift() {
  [ -n "$SD_FALLBACK" ] && [ -d "$STORE_WS/$SD_FALLBACK/$1" ] || return 0
  lf_to="$STORE_WS/$SD_ROOT/$1"
  [ -e "$lf_to" ] && return 1
  { [ -d "${lf_to%/*}" ] || mkdir -p "${lf_to%/*}"; } 2>/dev/null || return 2
  mv "$STORE_WS/$SD_FALLBACK/$1" "$lf_to" 2>/dev/null || return 2
  store_fallback_drop
}

# store_lift_for <namespace> <key>: store_lift of the key's top segment folder before a put
# or a delete writes it, a refusal in the function's own frame
store_lift_for() {
  store_lift "${2%%/*}"
  case $? in
    0) return 0 ;;
    1) store_unlock; refuse 1 ERR_ENTITY_EXISTS "key prefix '${2%%/*}/' is held in both roots of namespace '$1'" ;;
    *) store_unlock; refuse 2 ERR_STORAGE_WRITE "the move of key prefix '${2%%/*}/' in namespace '$1' failed" ;;
  esac
}

store_put() {
  FN=store.put
  [ $# -ge 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.put takes the namespace, the key, and optional flags"
  sp_ns=$1; sp_key=$2
  shift 2
  store_flags store.put write "$@"
  store_data store.put "$sp_ns"
  store_key_for store.put "$sp_ns" "$sp_key"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  store_lock "$sp_ns"
  sp_twin=$(store_twin "$sp_key")
  if [ -n "$sp_twin" ]; then
    store_unlock
    refuse 1 ERR_ENTITY_EXISTS "key '$sp_key' folds onto '$sp_twin' under ASCII case; keys differing only by case never coexist in namespace '$sp_ns'"
  fi
  sp_path=$(store_path "$sp_key")
  sp_fold=$(store_fold_twin "$sp_key" "$sp_path")
  if [ -n "$sp_fold" ]; then
    store_unlock
    store_fold_refusal "$sp_ns" "$sp_key" "$sp_fold"
  fi
  store_lift_for "$sp_ns" "$sp_key"
  mkdir -p "$(dirname "$sp_path")" 2>/dev/null || {
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  }
  STORE_TMP=$(mktemp "$sp_path.XXXXXX" 2>/dev/null) || {
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  }
  chmod "$(umask -S | tr -d x)" "$STORE_TMP" 2>/dev/null || true
  if ! { cat > "$STORE_TMP"; } 2>/dev/null || ! mv -f "$STORE_TMP" "$sp_path" 2>/dev/null; then
    rm -f "$STORE_TMP"
    STORE_TMP=""
    store_unlock
    refuse 2 ERR_STORAGE_WRITE "the storage write of key '$sp_key' failed"
  fi
  STORE_TMP=""
  # the write must list the key it echoes; a folded directory or file name is refused and
  # the just-written file removed, so a successful put never loses its key
  sp_fold=$(store_fold_twin "$sp_key" "$sp_path")
  if [ -n "$sp_fold" ]; then
    rm -f "$sp_path"
    store_unlock
    store_fold_refusal "$sp_ns" "$sp_key" "$sp_fold"
  fi
  store_unlock
  printf '{"namespace":"%s","key":"%s","op":"%s"}\n' "$(escape_json "$sp_ns")" "$(escape_json "$sp_key")" "$(escape_json "$SF_OP")"
}

store_delete() {
  FN=store.delete
  [ $# -ge 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.delete takes the namespace, the key, and optional flags"
  sx_ns=$1; sx_key=$2
  shift 2
  store_flags store.delete remove "$@"
  store_data store.delete "$sx_ns"
  store_key_for store.delete "$sx_ns" "$sx_key"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  store_lock "$sx_ns"
  if ! store_key_exists "$sx_key"; then
    store_unlock
    refuse 1 ERR_ENTITY_NOT_FOUND "key '$sx_key' not found in namespace '$sx_ns'"
  fi
  store_lift_for "$sx_ns" "$sx_key"
  for sx_path in "$(store_path "$sx_key")" ${SD_FALLBACK:+"$STORE_WS/$SD_FALLBACK/$sx_key$SD_SUFFIX"}; do
    if ! rm -f "$sx_path" 2>/dev/null || [ -e "$sx_path" ]; then
      store_unlock
      refuse 2 ERR_STORAGE_WRITE "the storage remove of key '$sx_key' failed"
    fi
  done
  store_unlock
  printf '{"namespace":"%s","key":"%s","op":"%s"}\n' "$(escape_json "$sx_ns")" "$(escape_json "$sx_key")" "$(escape_json "$SF_OP")"
}

store_changes() {
  FN=store.changes
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.changes takes one argument, the namespace"
  sc_ns=$1
  store_data store.changes "$sc_ns"
  refuse 1 ERR_CAPABILITY_UNSUPPORTED "the posix store keeps no change log; namespace '$sc_ns' reports its delta through its module (changes: $SD_CHANGES)"
}

# ==============================================================================
# The transactional batch and the scan
# ==============================================================================
# The batch wire (stdin, the driver's escaped payload format): an action=put or
# action=delete line opens an action, then key=<escaped key>, head=<sha|none> (default
# none), and, for a put, value_b64=<base64>. The action list is validated whole under the
# namespace lock, staged, and committed under one store-scope undo log; the first failure
# prints store.batch: error: action <n> (<op> '<key>'): <message> (<CODE>), 1-based, and
# nothing is written.
batch_unescape() {
  BU_RAW="$1" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["BU_RAW"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n") out = out "\n"
        else if (c == "t") out = out "\t"
        else if (c == "r") out = out "\r"
        else out = out c
      } else out = out c
    }
    printf "%s", out
  }'
}

# batch_decode <base64> <out>: decode one value: rc 0 staged, 1 not base64 (the caller's
# input), 2 the decoded value cannot be written (a storage failure). The value is decoded
# into /dev/null first, so a write failure never reads as bad input; the base64 command
# differs only in its decode flag, so the GNU/Darwin spelling is tried first and the BSD
# one second
batch_decode() {
  bd_flag=""
  for bd_f in -d -D; do
    if printf '%s' "$1" | base64 "$bd_f" > /dev/null 2>&1; then bd_flag=$bd_f; break; fi
  done
  [ -n "$bd_flag" ] || return 1
  printf '%s' "$1" | { base64 "$bd_flag" > "$2"; } 2>/dev/null && return 0
  rm -f "$2" 2>/dev/null
  return 2
}

# batch_refuse <rc> <n> <op> <key> <CODE> <message>: the batch's one failure line
batch_refuse() {
  printf 'store.batch: error: action %s (%s '\''%s'\''): %s (%s)\n' "$2" "$3" "$4" "$6" "$5" >&2
  exit "$1"
}

# batch_key_for <n> <op> <key>: the key rule and the module pattern, framed by the action
batch_key_for() {
  bk_key=$3
  store_key_ok "$bk_key" || batch_refuse 1 "$1" "$2" "$bk_key" ERR_INVALID_ARGUMENT "malformed key '$bk_key'"
  store_key_shape "$SD_KEYPAT" "$bk_key" || batch_refuse 1 "$1" "$2" "$bk_key" ERR_INVALID_ARGUMENT "key '$bk_key' does not match the namespace pattern '$SD_KEYPAT'"
}

# batch_close_action: validate the action being parsed and append it to the staging
# manifest (n, op, key, head, value path, tab separated; a key never holds a tab)
batch_close_action() {
  [ "$sb_open" -eq 1 ] || return 0
  sb_open=0
  SB_N=$((SB_N + 1))
  [ "$sb_seen_key" -eq 1 ] && [ -n "$sb_key" ] || batch_refuse 1 "$SB_N" "$sb_op" "?" ERR_INVALID_ARGUMENT "the action carries no key"
  batch_key_for "$SB_N" "$sb_op" "$sb_key"
  case "$sb_head" in
    none) ;;
    ''|*[!0-9a-fA-F]*) batch_refuse 1 "$SB_N" "$sb_op" "$sb_key" ERR_INVALID_ARGUMENT "--head takes a commit id or none: '$sb_head'" ;;
  esac
  case "$sb_op" in
    put)
      [ "$sb_seen_val" -eq 1 ] || batch_refuse 1 "$SB_N" put "$sb_key" ERR_INVALID_ARGUMENT "a put carries no value"
      sb_v="$STORE_BATCH_STAGE/val.$SB_N"
      batch_decode "$sb_val" "$sb_v"
      case $? in
        0) ;;
        1) batch_refuse 1 "$SB_N" put "$sb_key" ERR_INVALID_ARGUMENT "malformed base64 value" ;;
        *) batch_refuse 2 "$SB_N" put "$sb_key" ERR_STORAGE_WRITE "cannot stage the value" ;;
      esac
      scratch_add "$STORE_BATCH_STAGE/man" '%s\t%s\t%s\t%s\t%s\n' "$SB_N" put "$sb_key" "$sb_head" "$sb_v" \
        || batch_refuse 2 "$SB_N" put "$sb_key" ERR_STORAGE_WRITE "cannot stage the action"
      ;;
    delete)
      [ "$sb_seen_val" -eq 0 ] || batch_refuse 1 "$SB_N" delete "$sb_key" ERR_INVALID_ARGUMENT "a delete carries no value"
      scratch_add "$STORE_BATCH_STAGE/man" '%s\t%s\t%s\t%s\t\n' "$SB_N" delete "$sb_key" "$sb_head" \
        || batch_refuse 2 "$SB_N" delete "$sb_key" ERR_STORAGE_WRITE "cannot stage the action"
      ;;
  esac
}

# batch_parse: read the action payload from stdin; values stage under STORE_BATCH_STAGE
batch_parse() {
  STORE_BATCH_STAGE=$(mktemp -d "$(get_tmp_dir)/store-batch.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the batch staging folder"
  scratch_new "$STORE_BATCH_STAGE/man" || refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"
  SB_N=0
  sb_open=0
  sb_op=""; sb_key=""; sb_head=""; sb_val=""; sb_seen_key=0; sb_seen_head=0; sb_seen_val=0
  while IFS= read -r sb_l || [ -n "$sb_l" ]; do
    case "$sb_l" in *"$cr_byte") sb_l=${sb_l%?} ;; esac
    case "$sb_l" in
      '') continue ;;
      action=*)
        batch_close_action
        sb_open=1
        sb_op=${sb_l#action=}
        case "$sb_op" in
          put|delete) ;;
          *) batch_refuse 1 "$((SB_N + 1))" "$sb_op" "?" ERR_INVALID_ARGUMENT "unknown action '$sb_op' (put or delete)" ;;
        esac
        sb_key=""; sb_head=none; sb_val=""; sb_seen_key=0; sb_seen_head=0; sb_seen_val=0
        ;;
      key=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_key" -eq 0 ] || batch_refuse 1 "$((SB_N + 1))" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'key='"
        sb_seen_key=1
        sb_key=$(batch_unescape "${sb_l#key=}")
        ;;
      head=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_head" -eq 0 ] || batch_refuse 1 "$((SB_N + 1))" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'head='"
        sb_seen_head=1
        sb_head=${sb_l#head=}
        ;;
      value_b64=*)
        [ "$sb_open" -eq 1 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "a payload line outside an action"
        [ "$sb_seen_val" -eq 0 ] || batch_refuse 1 "$((SB_N + 1))" "$sb_op" "${sb_key:-?}" ERR_INVALID_ARGUMENT "duplicate payload line 'value_b64='"
        sb_seen_val=1
        sb_val=${sb_l#??????????}
        ;;
      *) batch_refuse 1 "$((SB_N + 1))" "${sb_op:-?}" "${sb_key:-?}" ERR_INVALID_ARGUMENT "unknown payload line '$sb_l'" ;;
    esac
  done
  if [ "$sb_open" -eq 1 ]; then batch_close_action; fi
  [ "$SB_N" -gt 0 ] || batch_refuse 1 1 "?" "?" ERR_INVALID_ARGUMENT "the batch carries no actions"
}

# batch_validate: the whole action list against the live key set, under the namespace lock;
# a delete must find the key present at its place in the order, and a put never coexists
# with an ASCII case twin
batch_validate() {
  SB_LIVE="$STORE_BATCH_STAGE/live"
  { store_list_keys > "$SB_LIVE"; } 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    case "$sb_op" in
      put)
        sb_twin=$(SB_T="$sb_key" LC_ALL=C awk 'BEGIN { t = ENVIRON["SB_T"] } { if ($0 != t && tolower($0) == tolower(t)) { print; exit } }' "$SB_LIVE")
        [ -z "$sb_twin" ] || batch_refuse 1 "$sb_i" put "$sb_key" ERR_ENTITY_EXISTS "key '$sb_key' folds onto '$sb_twin' under ASCII case; keys differing only by case never coexist in namespace '$SB_NS'"
        scratch_add "$SB_LIVE" '%s\n' "$sb_key" && LC_ALL=C sort -u "$SB_LIVE" -o "$SB_LIVE" 2>/dev/null \
          || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "cannot stage the action"
        ;;
      delete)
        grep -F -q -x -e "$sb_key" "$SB_LIVE" || batch_refuse 1 "$sb_i" delete "$sb_key" ERR_ENTITY_NOT_FOUND "key '$sb_key' not found in namespace '$SB_NS'"
        scratch_new "$SB_LIVE.next" || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "cannot stage the action"
        { grep -F -v -x -e "$sb_key" "$SB_LIVE" > "$SB_LIVE.next"; } 2>/dev/null
        [ $? -le 1 ] && mv -f "$SB_LIVE.next" "$SB_LIVE" 2>/dev/null \
          || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "cannot stage the action"
        ;;
    esac
  done < "$STORE_BATCH_STAGE/man"
}

# batch_lift: each action's top key segment folder moved from the fallback root to the root
# (store_lift) after the validation and before the commit, each folder checked once; a
# folder both roots hold refuses with the action's line and nothing written
batch_lift() {
  [ -n "$SD_FALLBACK" ] || return 0
  bl_last=""
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    bl_top=${sb_key%%/*}
    [ "$bl_top" = "$bl_last" ] && continue
    bl_last=$bl_top
    store_lift "$bl_top"
    case $? in
      0) ;;
      1) batch_refuse 1 "$sb_i" "$sb_op" "$sb_key" ERR_ENTITY_EXISTS "key prefix '$bl_top/' is held in both roots of namespace '$SB_NS'" ;;
      *) batch_refuse 2 "$sb_i" "$sb_op" "$sb_key" ERR_STORAGE_WRITE "the move of key prefix '$bl_top/' in namespace '$SB_NS' failed" ;;
    esac
  done < "$STORE_BATCH_STAGE/man"
}

# sb_note <f|d> <path> <backup>: one undo step; the store-scope log the batch commits under.
# A step the log cannot hold answers nonzero before its change is made, so a rollback never
# misses a landed step
sb_note() {
  scratch_add "$STORE_BATCH_STAGE/undo" '%s\t%s\t%s\n' "$1" "$2" "${3:-}"
}

# sb_rollback: every noted step undone, the last first
sb_rollback() {
  [ -f "$STORE_BATCH_STAGE/undo" ] || return 0
  awk '{ a[NR] = $0 } END { for (i = NR; i >= 1; i--) print a[i] }' "$STORE_BATCH_STAGE/undo" |
    while IFS='	' read -r sb_k sb_p sb_b; do
      case "$sb_k" in
        f) if [ -n "$sb_b" ]; then mv -f "$sb_b" "$sb_p" 2>/dev/null; else rm -f "$sb_p" 2>/dev/null; fi ;;
        d) rmdir "$sb_p" 2>/dev/null ;;
      esac
    done
}

# sb_dir <folder>: the folder made when absent, noted so a rollback removes it again
sb_dir() {
  [ -d "$1" ] && return 0
  sb_up=$(dirname "$1")
  sb_dir "$sb_up" || return 1
  sb_note d "$1" "" || return 1
  mkdir "$1" 2>/dev/null || [ -d "$1" ] || return 1
}

# sb_backup <path>: a hard link of the file about to be replaced or removed, kept in the
# stage (the same filesystem), a copy where the link is refused; sets SB_BAK to the backup
# path (empty when the file was new). The counter advances in this shell, not a
# substitution, so every action gets its own backup file
sb_backup() {
  SB_BAK=""
  [ -f "$1" ] || return 0
  SB_BAK_N=$((SB_BAK_N + 1))
  sb_b="$STORE_BATCH_STAGE/bak.$SB_BAK_N"
  ln "$1" "$sb_b" 2>/dev/null || cp -p "$1" "$sb_b" 2>/dev/null || return 1
  SB_BAK=$sb_b
  return 0
}

# batch_commit: every action applied in order under one undo log; any failure prints its
# action line and store_cleanup rolls the earlier steps back
batch_commit() {
  SB_ON=1
  SB_BAK_N=0
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    sb_path=$(store_path "$sb_key")
    case "$sb_op" in
      put)
        sb_dir "$(dirname "$sb_path")" || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        sb_backup "$sb_path" || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        sb_note f "$sb_path" "$SB_BAK" || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        mv -f "$sb_val" "$sb_path" 2>/dev/null || batch_refuse 2 "$sb_i" put "$sb_key" ERR_STORAGE_WRITE "the storage write of key '$sb_key' failed"
        ;;
      delete)
        for sb_dp in "$sb_path" ${SD_FALLBACK:+"$STORE_WS/$SD_FALLBACK/$sb_key$SD_SUFFIX"}; do
          [ -f "$sb_dp" ] || continue
          sb_backup "$sb_dp" || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "the storage remove of key '$sb_key' failed"
          sb_note f "$sb_dp" "$SB_BAK" || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "the storage remove of key '$sb_key' failed"
          rm -f "$sb_dp" 2>/dev/null && [ ! -f "$sb_dp" ] || batch_refuse 2 "$sb_i" delete "$sb_key" ERR_STORAGE_WRITE "the storage remove of key '$sb_key' failed"
        done
        ;;
    esac
  done < "$STORE_BATCH_STAGE/man"
  # the write must list the key it echoes; a folded file name is refused and rolls back
  while IFS='	' read -r sb_i sb_op sb_key sb_head sb_val; do
    [ "$sb_op" = put ] || continue
    sb_fold=$(store_fold_twin "$sb_key" "$(store_path "$sb_key")")
    [ -z "$sb_fold" ] || batch_refuse 1 "$sb_i" put "$sb_key" ERR_ENTITY_EXISTS "key '$sb_key' cannot be represented exactly beside '$sb_fold' under the filesystem's case folding; the two keys never coexist in namespace '$SB_NS'"
  done < "$STORE_BATCH_STAGE/man"
  SB_ON=0
}

store_batch() {
  FN=store.batch
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.batch takes one argument, the namespace"
  SB_NS=$1
  store_data store.batch "$SB_NS"
  trap 'store_cleanup' EXIT
  trap 'store_cleanup; exit 129' HUP
  trap 'store_cleanup; exit 130' INT
  trap 'store_cleanup; exit 143' TERM
  batch_parse
  store_lock "$SB_NS"
  batch_validate
  batch_lift
  batch_commit
  store_cleanup
  printf '{"namespace":"%s","actions":%s}\n' "$(escape_json "$SB_NS")" "$SB_N"
}

# store_scan: every key the module pattern admits with its raw value in base64, bytewise,
# one compact JSON answer; no limit (the module stops after the keys it needs). The answer
# is staged and printed whole, so a read failure mid-scan prints nothing on stdout: the
# refusal is the one stderr line and the call is all or none.
store_scan() {
  FN=store.scan
  [ $# -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "store.scan takes one argument, the namespace"
  sc_ns=$1
  store_data store.scan "$sc_ns"
  sc_b64=""
  for sc_c in "$SCRIPT_DIR/../../scripts/store-b64" "$STORE_WS/.contexture/storage/scripts/store-b64" "$STORE_WS/base/.contexture/storage/scripts/store-b64"; do
    if [ -x "$sc_c" ]; then sc_b64=$sc_c; break; fi
  done
  [ -n "$sc_b64" ] || refuse 2 ERR_STORAGE_READ "the storage core base64 encoder is not installed"
  sc_keys=$(mktemp "$(scratch_dir)/store-scan.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  store_temp "$sc_keys"
  sc_out=$(mktemp "$(scratch_dir)/store-scan-out.XXXXXX" 2>/dev/null) || { rm -f "$sc_keys"; refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"; }
  store_temp "$sc_out"
  { store_list_keys > "$sc_keys"; } 2>/dev/null \
    && scratch_add "$sc_out" '{"namespace":"%s","items":[' "$(escape_json "$sc_ns")" \
    || { rm -f "$sc_keys" "$sc_out"; refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"; }
  sc_first=1
  while IFS= read -r sc_key; do
    [ -n "$sc_key" ] || continue
    store_read_path "$sc_key" || continue
    sc_path=$SR_PATH
    [ -f "$sc_path" ] || continue
    sc_v=$("$sc_b64" "$sc_path" 2>/dev/null) || { rm -f "$sc_keys" "$sc_out"; refuse 2 ERR_STORAGE_READ "cannot read key '$sc_key' in namespace '$sc_ns'"; }
    sc_sep=','
    if [ "$sc_first" -eq 1 ]; then sc_first=0; sc_sep=''; fi
    scratch_add "$sc_out" '%s{"key":"%s","value_b64":"%s"}' "$sc_sep" "$(escape_json "$sc_key")" "$sc_v" \
      || { rm -f "$sc_keys" "$sc_out"; refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"; }
  done < "$sc_keys"
  rm -f "$sc_keys"
  scratch_add "$sc_out" ']}\n' || { rm -f "$sc_out"; refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"; }
  cat "$sc_out"
  rm -f "$sc_out"
  store_notice
}

# store_query_read: the query payload line, decoded (backslash, n, t, r), with a sentinel
# so a trailing newline survives the command substitution
cr_byte=$(printf '\r')
store_query_read() {
  sq_seen=0; sq_raw=""
  while IFS= read -r sq_l || [ -n "$sq_l" ]; do
    sq_l=${sq_l%"$cr_byte"}
    case "$sq_l" in
      query=*)
        [ "$sq_seen" -eq 0 ] || refuse 1 ERR_INVALID_ARGUMENT "duplicate payload line 'query='"
        sq_seen=1; sq_raw=${sq_l#query=} ;;
      '') ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown payload line '$sq_l' (query= only)" ;;
    esac
  done
  [ "$sq_seen" -eq 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the query payload"
  SQ_RAW="$sq_raw" LC_ALL=C awk 'BEGIN {
    s = ENVIRON["SQ_RAW"]; out = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == "\\") {
        i++
        c = substr(s, i, 1)
        if (c == "n") out = out "\n"
        else if (c == "t") out = out "\t"
        else if (c == "r") out = out "\r"
        else out = out c
      } else out = out c
    }
    printf "%sX", out
  }'
}

# store_search <namespace> <mode> [<limit>]: the exact rule over the raw stored values; the
# query travels on stdin as a query= payload line. A ranked mode refuses here (posix
# declares exact alone), and a mode the module does not declare refuses too.
store_search() {
  FN=store.search
  [ $# -ge 2 ] && [ $# -le 3 ] || refuse 1 ERR_INVALID_ARGUMENT "store.search takes the namespace, the mode, and an optional limit"
  ss_ns=$1; ss_mode=$2; ss_lim=${3:-20}
  case "$ss_mode" in
    ''|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$ss_mode'" ;;
  esac
  case "$ss_lim" in
    ''|*[!0-9]*) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a number, 0 for every result: '$ss_lim'" ;;
  esac
  store_data store.search "$ss_ns"
  case ",$SD_MODES," in
    *",$ss_mode,"*) ;;
    *) refuse 1 ERR_CAPABILITY_UNSUPPORTED "mode '$ss_mode' is not declared by namespace '$ss_ns'; declared modes: $SD_MODES" ;;
  esac
  [ "$ss_mode" = exact ] || refuse 1 ERR_CAPABILITY_UNSUPPORTED "mode '$ss_mode' is not supported; declared modes: exact"
  ss_q=$(store_query_read) || exit $?
  ss_q=${ss_q%X}
  case "$ss_q" in *[![:space:]]*) ;; *) refuse 1 ERR_INVALID_ARGUMENT "the search query is empty" ;; esac
  ss_core=""
  for ss_c in "$SCRIPT_DIR/../../scripts/store-search" "$STORE_WS/.contexture/storage/scripts/store-search" "$STORE_WS/base/.contexture/storage/scripts/store-search"; do
    if [ -x "$ss_c" ]; then ss_core=$ss_c; break; fi
  done
  [ -n "$ss_core" ] || refuse 2 ERR_STORAGE_READ "the storage core search engine is not installed"
  ss_keytmp=$(mktemp "$(scratch_dir)/store-search.XXXXXX" 2>/dev/null) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"
  store_temp "$ss_keytmp"
  ss_err=$(mktemp "$(scratch_dir)/store-search-err.XXXXXX" 2>/dev/null) || { rm -f "$ss_keytmp"; refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch file"; }
  store_temp "$ss_err"
  ss_man="${ss_keytmp}.man"
  store_temp "$ss_man"
  { store_list_keys > "$ss_keytmp"; } 2>/dev/null && scratch_new "$ss_err" "$ss_man" \
    || { rm -f "$ss_keytmp" "$ss_err" "$ss_man"; refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"; }
  while IFS= read -r ss_k; do
    [ -n "$ss_k" ] || continue
    store_read_path "$ss_k" || continue
    ss_p=$SR_PATH
    [ -f "$ss_p" ] || continue
    scratch_add "$ss_man" '%s\t%s\n' "$ss_k" "$ss_p" \
      || { rm -f "$ss_keytmp" "$ss_err" "$ss_man"; refuse 2 ERR_STORAGE_WRITE "$SCRATCH_FAILED"; }
  done < "$ss_keytmp"
  rm -f "$ss_keytmp"
  ss_out=$("$ss_core" exact "$SD_FILE" "$ss_ns" "$ss_q" "$ss_lim" "$ss_man" 2>"$ss_err")
  ss_rc=$?
  if [ "$ss_rc" -ne 0 ]; then
    ss_msg=$(head -n 1 "$ss_err" 2>/dev/null)
    rm -f "$ss_err" "$ss_man"
    case "$ss_msg" in store-search:\ error:\ *) ss_msg=${ss_msg#store-search: error: } ;; esac
    [ -n "$ss_msg" ] || ss_msg="the store search failed"
    ss_code=""
    case "$ss_msg" in
      *' ('*')')
        ss_code=${ss_msg##*' ('}
        ss_code=${ss_code%)}
        ss_msg=${ss_msg%' ('*}
        ;;
    esac
    [ -n "$ss_code" ] || ss_code=ERR_STORAGE_READ
    [ "$ss_rc" -eq 1 ] || ss_rc=2
    refuse "$ss_rc" "$ss_code" "$ss_msg"
  fi
  rm -f "$ss_err" "$ss_man"
  printf '%s\n' "$ss_out"
  store_notice
  exit 0
}


# ==============================================================================
# The descriptor, the health, and the dispatch
# ==============================================================================
# capability: the contract 3 store-only card at driver version 3.0.0: the driver, the
# version, contract 3, the seven data names in the fixed order, the search modes, and the
# optional tokens (store, and store.promote for the fallback root move). The card carries
# no record function family; capability and storage.health are the driver's own methods
# the handshake and the diagnose call.
capability() {
  printf '{"driver":"posix","version":"3.0.0","contract":"3","store":["list","get","put","delete","changes","batch","scan"],"search_modes":["exact"],"optional":["store","store.promote"]}\n'
}

# store.promote <namespace> <prefix>: the optional move of one whole key prefix (whole key
# segments ending in a slash) from the namespace's fallback root to its root, one folder
# rename under the namespace lock; state moved, or none when the fallback holds no folder
# for the prefix or the namespace declares no fallback; the root already holding a folder
# for the prefix refuses rc 1 ERR_ENTITY_EXISTS with nothing moved. A move that empties the
# fallback root, or a none answer over an empty fallback root, removes that root.
store_promote() {
  FN=store.promote
  [ $# -eq 2 ] || refuse 1 ERR_INVALID_ARGUMENT "store.promote takes the namespace and a key prefix ending in a slash"
  pm_ns=$1; pm_prefix=$2
  case "$pm_prefix" in
    */) store_key_ok "${pm_prefix%/}" || refuse 1 ERR_INVALID_ARGUMENT "malformed key prefix '$pm_prefix' (whole key segments ending in a slash)" ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "malformed key prefix '$pm_prefix' (whole key segments ending in a slash)" ;;
  esac
  store_data store.promote "$pm_ns"
  pm_state=none
  pm_src="$STORE_WS/$SD_FALLBACK/${pm_prefix%/}"
  if [ -n "$SD_FALLBACK" ] && [ -d "$pm_src" ]; then
    store_lock "$pm_ns"
    store_lift "${pm_prefix%/}"
    case $? in
      0) ;;
      1) store_unlock; refuse 1 ERR_ENTITY_EXISTS "key prefix '$pm_prefix' is held in both roots of namespace '$pm_ns'" ;;
      *) store_unlock; refuse 2 ERR_STORAGE_WRITE "the move of key prefix '$pm_prefix' in namespace '$pm_ns' failed" ;;
    esac
    store_unlock
    pm_state=moved
  elif [ -n "$SD_FALLBACK" ]; then
    store_fallback_drop
  fi
  printf '{"namespace":"%s","prefix":"%s","state":"%s"}\n' "$(escape_json "$pm_ns")" "$(escape_json "$pm_prefix")" "$pm_state"
}

# storage.health <namespace>: a probe of the named namespace's store, never a write, and the
# backend's health alone (no record count: the record's active listing is the unit
# module's). The namespace's declared root and fallback root are the store: neither made
# reads degraded, either unreadable reads error, then presence is the first key the
# namespace's pattern admits in either; either unwritable reads error with that presence,
# and the namespace's store lock held reads locked in place of ok. No detail names a folder.
storage_health() {
  store_data storage.health "$1"
  sh_health="ok"
  sh_store="absent"
  sh_made=0; sh_unread=0; sh_unwrite=0
  for sh_root in "$STORE_WS/$SD_ROOT" ${SD_FALLBACK:+"$STORE_WS/$SD_FALLBACK"}; do
    [ -d "$sh_root" ] || continue
    sh_made=1
    if [ ! -r "$sh_root" ] || [ ! -x "$sh_root" ]; then sh_unread=1
    elif [ ! -w "$sh_root" ]; then sh_unwrite=1
    fi
  done
  if [ "$sh_made" -eq 0 ]; then
    sh_health="degraded"
    sh_detail="the store is not made yet (the first write makes it)"
  elif [ "$sh_unread" -eq 1 ]; then
    sh_health="error"
    sh_detail="the store is not readable"
  else
    [ -n "$(store_list_keys "" first)" ] && sh_store="present"
    if [ "$sh_unwrite" -eq 1 ]; then
      sh_health="error"
      sh_detail="the store is not writable"
    elif store_lock_held "$SD_NS"; then
      sh_health="locked"
      sh_detail="the store namespace '$SD_NS' is locked by a writer"
    elif [ "$sh_store" = present ]; then
      sh_detail="the store is writable and unlocked"
    else
      sh_detail="the store is writable and holds no key of the namespace yet"
    fi
  fi
  printf '{"driver":"posix","health":"%s","detail":"%s","store":"%s"}\n' "$sh_health" "$sh_detail" "$sh_store"
}

# px_extra <n> <argv...>: no argument beyond the n the function takes
px_extra() {
  pe_n=$1
  shift
  [ $# -le "$pe_n" ] || refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$(eval "printf '%s' \"\${$((pe_n + 1))}\"")'"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
FN=$cmd

case "$cmd" in
  capability) capability; exit 0 ;;
  store.list) store_list "$@"; exit $? ;;
  store.get) store_get "$@"; exit $? ;;
  store.put) store_put "$@"; exit $? ;;
  store.delete) store_delete "$@"; exit $? ;;
  store.changes) store_changes "$@"; exit $? ;;
  store.batch) store_batch "$@"; exit $? ;;
  store.scan) store_scan "$@"; exit $? ;;
  store.search) store_search "$@"; exit $? ;;
  store.promote) store_promote "$@"; exit $? ;;
  storage.health)
    [ $# -ge 1 ] || refuse 1 ERR_INVALID_ARGUMENT "storage.health takes the namespace"
    px_extra 1 "$@"
    storage_health "$1"
    exit 0
    ;;
  *) refuse 2 ERR_CAPABILITY_UNSUPPORTED "unknown function '$cmd'" ;;
esac
exit 0
