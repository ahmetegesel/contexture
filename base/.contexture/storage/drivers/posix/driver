}
function lo_init(   j, i, nd0, D0, T) {
  sfx = ENVIRON["LO_SFX"]
  m = split(ENVIRON["LO_KEYPAT"], pp, "/")
  multi = (m >= 1 && pp[m] ~ /^<[A-Za-z][A-Za-z0-9_]*\.\.\.>$/)
  nd0 = split(ENVIRON["LO_DOCS"], D0, "\n")
