# LO_AWK: the leftovers walk's one awk program over a root's typed listing (d, f, l, or o, a
# tab, and ./<path> per entry, from find's batched printf; n, a tab, and the parent folder of
# each name holding a newline, which the walk pruned and never lists) and its sizes (wc -c
# lines, keyed by the same ./<path>; a summary total line skipped). Any other line stops the
# program rc 3, nothing answered: a name is never continued across lines. LO_PASS=empty prints
# the folders with no entry (the readability candidates), after an empty line when a name
# holding a newline was found; LO_PASS=walk (the probe) and LO_PASS=sweep (the sweep's plan)
# classify: a regular file the pattern admits is a key (written to LO_KEYS when set; in the
# fallback a key LO_SHADOW names is a shadowed key), a document or a key outside the document
# rules (LO_FUNCS); a regular file whose suffix and segment count the pattern admits while the
# key rule refuses its name (refused, a name opening with a dot aside) is a refused key; each
# folder above a key, or above a refused key outside the loose sweep, is a key folder (and
# every folder LO_CTX names, the
# ancestors of a sweep's prefix folder, which the walk does not list), and each folder above a
# folder the walk cannot read or enter (named in LO_UNREAD) or above a name holding a newline
# is an open folder; the entries of the root, of a key folder, and of an open folder are
# classified one by one, every other entry belongs to the folder above it that holds no key.
# Such a folder: unreadable, a lock remnant (.lock or *.lock), a non-key folder (it holds a
# file, link, or special file), else empty; its bytes the regular files below it. A file: a
# key outside the document rules, a shadowed key, a lock or write remnant (a lock name, or a
# killed writer's temp: .<key file name>XXXXXX, or the older <key file name>.XXXXXX), a
# refused key, else a stray file; a link and a special file
# count apart; the names holding a newline count as their own kind, their bytes LO_NLBYTES.
# The probe prints one JSON object {state, entries, keys, documents, kinds}, never a path.
# The sweep never plans an unreadable folder (it counts them as left) and moves a key folder
# holding no document below it (and no open folder) as one item, its entries still counted
# by kind; LO_LOOSE=1 keeps only the entries at the top of the root that hold no key. It writes
# one item per line to LO_ITEMS, grouped by parent folder: its kind, the entries it counts,
# their bytes, the folders it clears, the walk entries it covers, its type, and its path with
# a backslash, a tab, a newline, and every other control character escaped; and prints
# {state, kinds, emptied, left}, emptied the key folders holding no document it clears (each
# moved inside its item) and left the unreadable folders it leaves untouched.
LO_AWK="$LO_FUNCS"'
function enc(s,   o, i, n, c) {
  if (s !~ /[[:cntrl:]]/ && !index(s, "\\")) return s
  o = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\") o = o "\\" "\\"
    else if (c == "\t") o = o "\\" "t"
    else if (c == "\n") o = o "\\" "n"
    else if (c in ORD) o = o "\\" sprintf("%03o", ORD[c])
    else o = o c
  }
  return o
}
function lockname(nm) { return nm == ".lock" || nm ~ /\.lock$/ }
function tempname(nm,   L, ls) {
  L = length(nm); ls = length(sfx)
  if (L < ls + 8) return 0
  if (substr(nm, L - 5) !~ /^[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]$/) return 0
  if (substr(nm, 1, 1) == ".") return substr(nm, L - 5 - ls, ls) == sfx
  if (substr(nm, L - 6, 1) != ".") return 0
  return substr(nm, L - 6 - ls, ls) == sfx
}
function topc(p,   q) {
  if (p in TOPC) return TOPC[p]
  q = parent(p)
  TOPC[p] = (q in COLL) ? topc(q) : p
  return TOPC[p]
}
function tally(kind, b) { C[kind]++; B[kind] += b }
function item(kind, n, b, e, w, t, p,   pa) {
  ni++
