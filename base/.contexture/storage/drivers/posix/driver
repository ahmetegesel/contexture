  IL[ni] = sprintf("%s\t%.0f\t%.0f\t%.0f\t%.0f\t%s\t%s", kind, n, b, e, w, t, enc(p))
  pa = parent(p)
  if (!(pa in GHEAD)) { ng++; GORD[ng] = pa; GHEAD[pa] = ni } else NEXT[GTAIL[pa]] = ni
  GTAIL[pa] = ni
}
function kind(name, last) { printf "\"%s\":{\"count\":%.0f,\"bytes\":%.0f}%s", name, C[name] + 0, B[name] + 0, last ? "" : "," }
BEGIN {
  lo_init()
  for (i = 1; i < 32; i++) ORD[sprintf("%c", i)] = i
  ORD[sprintf("%c", 127)] = 127
}
{
  line = $0
  if (line == "d\t.") next
  c = substr(line, 1, 1)
  if (substr(line, 2, 3) == "\t./" && (c == "d" || c == "f" || c == "l" || c == "o")) {
    nt++; TT[nt] = c; TP[nt] = substr(line, 5); next
  }
  if (substr(line, 1, 2) == "n\t") {
    s = substr(line, 3)
    if (s == ".") s = ""
    else if (substr(s, 1, 2) == "./") s = substr(s, 3)
    else { bad++; next }
    nn++; NP[nn] = s; next
  }
  if (line ~ /^ *[0-9][0-9]* \.\//) {
    s = line
    while (substr(s, 1, 1) == " ") s = substr(s, 2)
    sp = index(s, " ")
    ns++; SN[ns] = substr(s, 1, sp - 1) + 0; SP[ns] = substr(s, sp + 3); next
  }
  if (line ~ /^ *[0-9][0-9]* total$/) next
  bad++
}
END {
  if (bad) exit 3
  for (i = 1; i <= nt; i++) KIDS[parent(TP[i])]++
  for (i = 1; i <= nn; i++) KIDS[NP[i]]++
  if (ENVIRON["LO_PASS"] == "empty") {
    if (nn) print ""
    for (i = 1; i <= nt; i++) if (TT[i] == "d" && !((TP[i]) in KIDS)) print TP[i]
    exit 0
  }
  sweep = (ENVIRON["LO_PASS"] == "sweep")
  loose = (ENVIRON["LO_LOOSE"] == "1")
  items_out = sweep ? ENVIRON["LO_ITEMS"] : ""
  for (i = 1; i <= ns; i++) SZ[SP[i]] = SN[i]
  f = ENVIRON["LO_UNREAD"]
  if (f != "") while ((getline l < f) > 0) { UNR[l] = 1; for (q = parent(l); q != ""; q = parent(q)) UC[q] = 1 }
  for (i = 1; i <= nn; i++) for (q = NP[i]; q != ""; q = parent(q)) UC[q] = 1
  f = ENVIRON["LO_SHADOW"]
  if (f != "") while ((getline l < f) > 0) SHADOW[l] = 1
  nc = split(ENVIRON["LO_CTX"], CX, "\n")
  for (j = 1; j <= nc; j++) if (CX[j] != "") HK[CX[j]] = 1
  keys_out = ENVIRON["LO_KEYS"]
  for (i = 1; i <= nt; i++) {
    p = TP[i]; t = TT[i]
    pa = parent(p)
    for (q = pa; q != ""; q = parent(q)) DESC[q]++
    if (sweep && t == "l" && admit(p) && isdoc(KEY_OF) && !(KEY_OF in SHADOW)) { DP[p] = 1; for (q = pa; q != ""; q = parent(q)) HDP[q] = 1 }
    if (t == "d") continue
    for (q = pa; q != ""; q = parent(q)) HOLD[q] = 1
    if (t != "f") continue
    for (q = pa; q != ""; q = parent(q)) BY[q] += SZ[p]
    if (!admit(p)) {
      if (!loose && refused(p)) { RK[p] = 1; for (q = pa; q != ""; q = parent(q)) HK[q] = 1 }
      continue
    }
    for (q = pa; q != ""; q = parent(q)) HK[q] = 1
    if (KEY_OF in SHADOW) { SH[p] = 1; continue }
    KEY[p] = 1; nk++
    if (keys_out != "") print KEY_OF > keys_out
    if (isdoc(KEY_OF)) { nd++; for (q = pa; q != ""; q = parent(q)) HD[q] = 1 }
    else OUT[p] = 1
  }
  if (sweep && !loose) for (i = 1; i <= nt; i++) { p = TP[i]; if (TT[i] == "d" && (p in HK) && !(p in HD) && !(p in UC)) COLL[p] = 1 }
  for (i = 1; i <= nt; i++) {
    p = TP[i]; t = TT[i]; pa = parent(p)
    if (pa != "" && !(pa in HK) && !(pa in UC)) continue
    if (loose && pa != "") { tp = p; sub(/\/.*/, "", tp); if (tp in HK) continue }
    nm = base(p)
    if (t == "d") {
