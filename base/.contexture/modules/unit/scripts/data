#!/bin/sh
# data: the unit module's data script (no summary line, so discovery lists no verb). It
# answers the record's 35 operations over the storage core's generic module store, one
# store value per artifact: <unit>/state, <unit>/backlog, <unit>/knowledge,
# <unit>/journal, and <unit>/lanes/<lane>/<recipe|journal|report>. The artifact values are
# the current file shapes, so the record order, the preambles, the anchors, the opaque
# items, the legacy shapes, and the positional liveness survive unchanged. The parse,
# the canonical render, and the record rules are the module's own (lib/canon.awk,
# lib/model.awk, lib/ops.awk); the data script maps the artifacts onto the store's get,
# list, and batch, and the writes land all or none through one store.batch.
#
# The cross-unit reads use store.list with the per-unit key prefix; the active listing
# (session.active) reads every unit's state, then each ACTIVE unit's backlog, never a
# journal; session.list (the diagnose count) reads every unit's state and journal. The exact search is the record
# rule over the canonical render (lib/search.awk); a ranked mode is the store's search
# over the document-set schema, filtered to the unit and capped after the walk, its
# default-document identity (the artifact key) mapped to the record id (the unit or the
# lane, a lane entry keeping its lane prefix).
#
# The ref check: a new write's refs are full addresses, <owner>#<path>, checked for their
# shape before the unit lock (a retired short owner refuses); the verbs check each target
# through its owner's get before the call, so no lock is held during the checks; a value
# already stored reads as it stands until ctx unit migrate rewrites it. The namespace is the
# module's folder name, found by the storage core's library from this script's path.
#
# The store root moves gradually: the data file declares a fallback root the store reads
# after its root, and the posix store's own write moves a unit's folder from the fallback
# to the root, so a unit moves whole at its first landing write with no call of its own;
# unit.migrate, outside the record's 35 operations, moves the named units or every unit for
# ctx unit migrate through the store's optional store.promote, then rewrites their pointers. A run
# whose reads came from the fallback and that ends rc 0 prints one warning line after its
# answer.
#
# Usage: data <function> [<args>...]   (the function wire of the storage contract)
# Exit codes: 0 the answer; 1 a semantic refusal; 2 a storage or driver failure.

set -u
LC_ALL=C
export LC_ALL

UDIR=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
ULIB="$UDIR/lib"

U_LIB=""
for ul_c in "${CTX_STORE_ROOT:-${CTX_ROOT:-$PWD}}/.contexture/storage/scripts/library" \
            "$UDIR/../../storage/scripts/library" \
            "$UDIR/../../../base/.contexture/storage/scripts/library"; do
  if [ -f "$ul_c" ]; then
    . "$ul_c"
    U_LIB=$ul_c
    break
  fi
done
if [ -z "$U_LIB" ]; then
  printf 'unit: error: the storage core library is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi

U_SCR=""
U_LOCK=""
U_STAGE=""
U_PAY=""
U_UNIT=""
U_PARTS=""
U_WRITE=0
U_OUT=""
U_QN=0
U_MISS=" "

u_cleanup() {
  [ -n "$U_LOCK" ] && rm -rf "$U_LOCK" 2>/dev/null
  [ -n "$U_SCR" ] && rm -rf "$U_SCR" 2>/dev/null
  return 0
}
trap u_cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

u_refuse() {
  printf '%s: error: %s (%s)\n' "${FN:-unit}" "$3" "$2" >&2
  exit "$1"
}

# u_store_refuse <rc> <store function> <stderr file> <fallback>: a refused store call as
# the function's one line, carrying the store's message and code: the store's refusal line
# (its first line opening "<store function>: error: ", the prefix stripped, else a first
# line that is the resolver's own line, whole), or the call's fixed fallback line with its
# code when the store printed neither; the store's own line never reaches the verb
u_store_refuse() {
  usr_msg=$(USR_P="$2: error: " LC_ALL=C awk '
    NR == 1 { f = $0 }
    m == "" && index($0, ENVIRON["USR_P"]) == 1 { m = substr($0, length(ENVIRON["USR_P"]) + 1) }
    END { if (m == "" && index(f, "driver-resolver: ") == 1) m = f; print m }' "$3" 2>/dev/null)
  [ -n "$usr_msg" ] || usr_msg=$4
  printf '%s: error: %s\n' "${FN:-unit}" "$usr_msg" >&2
  exit "$1"
}

# u_new <file>...: each of this run's scratch files made empty; u_put <file> <format>
# [<args>...]: one printf appended to such a file. Both are silent (a shell reports a
# failing redirect before a trailing 2>/dev/null applies, so the group carries it) and
# refuse rc 2 ERR_STORAGE_WRITE when the write fails. A command whose own stderr may carry
# a refusal writes into a file u_new made, so its status, never a failing redirect (which
# answers 1 and would read as absent), decides: a lost line would let a write read an
# artifact as absent, a unit as new, or commit part of its artifacts
u_new() {
  for un_f in "$@"; do
    { : > "$un_f"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  done
}

u_put() {
  up_f=$1
  shift
  { printf "$@" >> "$up_f"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
}

u_ident_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

u_name_valid() {
  case "$1" in
    ""|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

u_want_unit() {
  [ -n "${1:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  u_ident_valid "$1" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$1'"
}

# u_scratch: the per-run folder under the verb's scratch root when ctx exported one (the
# engine sweeps a root a killed verb leaves), else the workspace's .contexture/tmp
u_scratch() {
  [ -n "$U_SCR" ] && return 0
  us_tmp=""
  if [ -n "${CTX_SCRATCH_ROOT:-}" ] && mkdir -p "$CTX_SCRATCH_ROOT" 2>/dev/null \
    && [ -d "$CTX_SCRATCH_ROOT" ] && [ -w "$CTX_SCRATCH_ROOT" ]; then
    us_tmp=$CTX_SCRATCH_ROOT
  else
    us_root=$(store_lib_root)
    us_tmp="$us_root/.contexture/tmp"
    mkdir -p "$us_tmp" 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot create the workspace scratch folder"
    [ -d "$us_tmp" ] && [ -w "$us_tmp" ] || u_refuse 2 ERR_STORAGE_WRITE "the workspace scratch folder is not writable"
  fi
  U_SCR=$(mktemp -d "$us_tmp/unit.XXXXXX" 2>/dev/null) || u_refuse 2 ERR_STORAGE_WRITE "cannot create the data script's scratch folder"
}

# u_lock <unit>: the unit lock folder, held from the read to the batch commit (the driver
# takes its namespace lock inside it, at the commit). The unit locks live in their own
# folder, locks/unit/, beside the drivers' flat locks/store-<namespace>.lock, so no unit
# name can meet a namespace lock. A waiter removes a lock whose holder pid is gone, gives
# a pid-less lock ten polls of grace, and refuses a live holder (busy or hung) after 600
# polls 0.1 s apart (60 s of sleep); where sleep refuses a fraction, a poll sleeps 1 s and
# counts as ten
u_lock() {
  u_tmp=$(store_lib_root)/.contexture/tmp
  mkdir -p "$u_tmp/locks/unit" 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot create the lock folder"
  U_LT="$u_tmp/locks/unit/$1.lock"
  U_LN=0
  U_LM=0
  while [ "$U_LN" -lt 600 ]; do
    if mkdir "$U_LT" 2>/dev/null; then
      { printf '%s\n' "$$" > "$U_LT/pid"; } 2>/dev/null || {
        rm -rf "$U_LT" 2>/dev/null
        u_refuse 2 ERR_STORAGE_WRITE "cannot write the unit lock holder pid"
      }
      U_LOCK="$U_LT"
      return 0
    fi
    U_LP=$(cat "$U_LT/pid" 2>/dev/null)
    case "$U_LP" in
      ""|*[!0-9]*)
        U_LM=$((U_LM + 1))
        if [ "$U_LM" -ge 10 ]; then rm -rf "$U_LT" 2>/dev/null; U_LM=0; continue; fi
        ;;
      *)
        if kill -0 "$U_LP" 2>/dev/null; then U_LM=0
        else rm -rf "$U_LT" 2>/dev/null; continue
        fi
        ;;
    esac
    U_LN=$((U_LN + 1))
    sleep 0.1 2>/dev/null || { sleep 1; U_LN=$((U_LN + 9)); }
  done
  u_refuse 2 ERR_STORAGE_LOCKED "the unit lock of '$1' is held (60 s timeout)"
}

# u_keys_parse: the keys of store.list's answer, one per line
u_keys_parse() {
  LC_ALL=C awk '
    {
      if (!match($0, /"keys":\[/)) next
      s = substr($0, RSTART + 8)
      sub(/\].*$/, "", s)
      n = split(s, P, /","/)
      for (i = 1; i <= n; i++) {
        k = P[i]
        sub(/^"/, "", k)
        sub(/"$/, "", k)
        if (k != "") print k
      }
    }'
}

# u_note <file>: a read's rc 0 store stderr kept in the run's notice file, the input of the
# one warning u_warn prints when the run ends rc 0
u_note() {
  [ -s "$1" ] || return 0
  { cat "$1" >> "$U_SCR/notice"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
}

u_keys_all() {
  u_new "$U_SCR/list.ans" "$U_SCR/list.err"
  store_list > "$U_SCR/list.ans" 2> "$U_SCR/list.err" < /dev/null
  case $? in
    0) u_note "$U_SCR/list.err"; u_keys_parse < "$U_SCR/list.ans" ;;
    *) u_store_refuse 2 store.list "$U_SCR/list.err" "the store list failed (ERR_STORAGE_READ)" ;;
  esac
}

u_keys_prefix() {
  u_new "$U_SCR/list.ans" "$U_SCR/list.err"
  store_list "$1" > "$U_SCR/list.ans" 2> "$U_SCR/list.err" < /dev/null
  case $? in
    0) u_note "$U_SCR/list.err"; u_keys_parse < "$U_SCR/list.ans" ;;
    *) u_store_refuse 2 store.list "$U_SCR/list.err" "the store list failed (ERR_STORAGE_READ)" ;;
  esac
}

# u_add_key <manifest key> <store key>: fetch the raw value to a scratch file and add its
# manifest line; a key that vanished between the list and the get is absent, and U_ADD_RC
# reports which (0 fetched, 1 absent)
u_add_key() {
  U_ADD_RC=1
  U_NART=$((U_NART + 1))
  U_ART="$U_SCR/art.$U_NART"
  u_new "$U_ART" "$U_SCR/get.err"
  store_get "$2" > "$U_ART" 2> "$U_SCR/get.err" < /dev/null
  U_GRC=$?
  case "$U_GRC" in
    0) U_ADD_RC=0; u_note "$U_SCR/get.err" ;;
    1) rm -f "$U_ART"; U_NART=$((U_NART - 1)); return 0 ;;
    *) u_store_refuse "$U_GRC" store.get "$U_SCR/get.err" "the store read failed (ERR_STORAGE_READ)" ;;
  esac
  u_put "$U_SCR/man" 'F\t%s\t%s\n' "$1" "$U_ART"
  u_put "$U_SCR/files" '%s\n' "$U_ART"
}

u_manifest_reset() {
  u_new "$U_SCR/man" "$U_SCR/files"
  U_NART=0
  U_QN=0
}

# u_queue <manifest key> <store key>: one key for the next u_flush
u_queue() {
  [ "$U_QN" -gt 0 ] || u_new "$U_SCR/q"
  u_put "$U_SCR/q" '%s\t%s\n' "$1" "$2"
  U_QN=$((U_QN + 1))
}

# u_flush_batch: two or more queued keys fetched by one batched store.get, each present one
# added to the manifest in the queued order; U_MISS names the manifest keys the store does
# not hold, each between blanks. A lone key, or a refused or short batch, answers rc 1 with
# nothing added and the queue left for the caller's one key replay
u_flush_batch() {
  U_MISS=" "
  uq_n=$U_QN
  U_QN=0
  if [ "$uq_n" -gt 1 ]; then
    u_new "$U_SCR/q.t" "$U_SCR/q.s" "$U_SCR/q.err" "$U_SCR/q.miss"
    UQ_BASE=$U_NART UQ_DIR=$U_SCR LC_ALL=C awk -F '\t' '{ print substr($0, length($1) + 2) "\t" ENVIRON["UQ_DIR"] "/art." (ENVIRON["UQ_BASE"] + NR) }' "$U_SCR/q" > "$U_SCR/q.t" \
      || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
    if store_get_into "$U_SCR/q.t" > "$U_SCR/q.s" 2> "$U_SCR/q.err" \
      && UQ_BASE=$U_NART UQ_DIR=$U_SCR LC_ALL=C awk -F '\t' '
        FILENAME == ARGV[1] { M[FNR] = $1; K[FNR] = substr($0, length($1) + 2); n = FNR; next }
        {
          if (FNR > n || substr($0, 3) != K[FNR] || ($1 != "1" && $1 != "0")) { bad = 1; exit 3 }
          seen = FNR; S[FNR] = $1
        }
        END {
          if (bad || seen != n) exit 3
          man = ENVIRON["UQ_DIR"] "/man"; files = ENVIRON["UQ_DIR"] "/files"
          for (i = 1; i <= n; i++) {
            if (S[i] != "1") { print M[i]; continue }
            p = ENVIRON["UQ_DIR"] "/art." (ENVIRON["UQ_BASE"] + i)
            printf "F\t%s\t%s\n", M[i], p >> man
            printf "%s\n", p >> files
          }
        }' "$U_SCR/q" "$U_SCR/q.s" > "$U_SCR/q.miss"; then
      U_NART=$((U_NART + uq_n))
      u_note "$U_SCR/q.err"
      while IFS= read -r uq_m; do U_MISS="$U_MISS$uq_m "; done < "$U_SCR/q.miss"
      return 0
    fi
  fi
  return 1
}

# u_flush: the queued keys fetched through u_flush_batch; a lone key, or a refused or short
# batch, replays the queue through u_add_key in its order, so a refusal is the very line the
# one key reads print
u_flush() {
  U_MISS=" "
  [ "$U_QN" -gt 0 ] || return 0
  u_flush_batch && return 0
  while IFS='	' read -r uq_m uq_k; do
    u_add_key "$uq_m" "$uq_k"
    [ "$U_ADD_RC" -eq 0 ] || U_MISS="$U_MISS$uq_m "
  done < "$U_SCR/q"
}

# u_queue_parts <unit> <parts>: the named block artifacts queued, no list: a part the store
# does not hold is simply absent, exactly as the list would have said
u_queue_parts() {
  case " $2 " in *" backlog "*) u_queue "$1|backlog" "$1/backlog" ;; esac
  case " $2 " in *" journal "*) u_queue "$1|journal" "$1/journal" ;; esac
  case " $2 " in *" knowledge "*) u_queue "$1|knowledge" "$1/knowledge" ;; esac
}

# u_fetch_parts <unit> <parts>: the named block artifacts into the manifest, one fetch
u_fetch_parts() {
  u_queue_parts "$1" "$2"
  u_flush
}

# u_fetch_unit <unit> <parts> [required]: the unit's artifacts into the manifest; state
# always, the other parts on request ("all" takes every artifact, "lane:<l>" the lane,
# "__lanes__" discovers the lanes alone). A parts set with no lane and no "all" fetches the
# exact keys, no list at all; required (1) refuses a unit the store does not hold with the
# same line the held probe answered, after the listed keys are read, and 2 refuses it before
# any read, where the held probe stood. A refused batch replays the one key reads in their
# own order, the state first, so its refusal is theirs.
u_fetch_unit() {
  uf_u=$1
  uf_parts=" $2 "
  uf_req=${3:-0}
  case "$uf_parts" in
    *" all "*|*" lane:"*|*" __lanes__ "*)
      uf_state=0
      uf_lanes=""
      u_new "$U_SCR/keys"
      u_keys_prefix "$uf_u/" > "$U_SCR/keys" || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
      while IFS= read -r uf_k; do
        [ -n "$uf_k" ] || continue
        uf_r=${uf_k#"$uf_u/"}
        case "$uf_r" in
          state)
            uf_state=1
            u_queue "$uf_u|state" "$uf_k"
            ;;
          backlog|knowledge|journal)
            case "$uf_parts" in
              *" all "*|*" $uf_r "*) u_queue "$uf_u|$uf_r" "$uf_k" ;;
            esac
            ;;
          lanes/*/*)
            uf_rest=${uf_r#lanes/}
            uf_lane=${uf_rest%%/*}
            uf_art=${uf_rest#*/}
            case "$uf_art" in recipe|journal|report) ;; *) continue ;; esac
            u_ident_valid "$uf_lane" || continue
            case " $uf_lanes " in
              *" $uf_lane "*) ;;
              *) uf_lanes="$uf_lanes $uf_lane" ;;
            esac
            case "$uf_parts" in
              *" all "*|*" lanes "*|*" lane:$uf_lane "*) u_queue "$uf_u|lane/$uf_lane/$uf_art" "$uf_k" ;;
            esac
            ;;
        esac
      done < "$U_SCR/keys"
      if [ "$uf_state" -eq 0 ] && [ "$uf_req" -eq 2 ]; then
        u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$uf_u' not found"
      fi
      u_flush
      if [ "$uf_state" -eq 0 ] && [ "$uf_req" -eq 1 ]; then
        u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$uf_u' not found"
      fi
      [ "$uf_state" -eq 0 ] || u_put "$U_SCR/man" 'U\t%s\n' "$uf_u"
      for uf_l in $uf_lanes; do
        u_put "$U_SCR/man" 'L\t%s\t%s\n' "$uf_u" "$uf_l"
      done
      ;;
    *)
      u_queue "$uf_u|state" "$uf_u/state"
      u_queue_parts "$uf_u" "$2"
      if u_flush_batch; then
        case "$U_MISS" in
          *" $uf_u|state "*) [ "$uf_req" -eq 0 ] || u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$uf_u' not found" ;;
          *) u_put "$U_SCR/man" 'U\t%s\n' "$uf_u" ;;
        esac
      else
        u_add_key "$uf_u|state" "$uf_u/state"
        if [ "$U_ADD_RC" -eq 0 ]; then
          u_put "$U_SCR/man" 'U\t%s\n' "$uf_u"
        elif [ "$uf_req" -ne 0 ]; then
          u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$uf_u' not found"
        fi
        u_fetch_parts "$uf_u" "$2"
      fi
      ;;
  esac
}

# u_fetch_all <with_journal 0|1>: every held unit's state (and journal for the listing)
u_fetch_all() {
  fa_j=$1
  u_new "$U_SCR/units" "$U_SCR/keys"
  u_keys_all > "$U_SCR/keys" || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  while IFS= read -r fa_k; do
    [ -n "$fa_k" ] || continue
    case "$fa_k" in
      */state) ;;
      *) continue ;;
    esac
    fa_u=${fa_k%/state}
    case "$fa_u" in */*) continue ;; esac
    u_ident_valid "$fa_u" || continue
    u_put "$U_SCR/units" '%s\n' "$fa_u"
    u_queue "$fa_u|state" "$fa_k"
  done < "$U_SCR/keys"
  u_flush
  while IFS= read -r fa_u; do
    u_put "$U_SCR/man" 'U\t%s\n' "$fa_u"
  done < "$U_SCR/units"
  if [ "$fa_j" -eq 1 ]; then
    u_new "$U_SCR/junits"
    LC_ALL=C awk '
      FILENAME == ARGV[1] { u[$0] = 1; next }
      {
        if ($0 !~ /\/journal$/) next
        p = $0
        sub(/\/journal$/, "", p)
        if ((p in u) && p !~ /\//) print p
      }' "$U_SCR/units" "$U_SCR/keys" > "$U_SCR/junits" || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
    while IFS= read -r fa_u; do
      [ -n "$fa_u" ] || continue
      u_queue "$fa_u|journal" "$fa_u/journal"
    done < "$U_SCR/junits"
    u_flush
  fi
}

# u_active [<unit>]: the active listing's one fetch: every unit's state, then each ACTIVE
# unit's backlog, never a journal; the state's first column-0 status line decides, the same
# typed key the record parser reads, so no per-unit verb call enters the view; the derived
# move the functions read from it follows the board's open-task rule (any status but DONE).
# A named unit narrows the listing to that unit alone, its state and backlog in one fetch (a
# non-ACTIVE unit's backlog never enters its fields); a unit the store does not hold lists
# no unit. A refused fetch replays the full listing's own reads, the state, then the backlog
# of an ACTIVE unit alone, so its refusal is theirs
u_active() {
  FN=session.active
  U_UNIT=""
  u_manifest_reset
  if [ -n "${1:-}" ]; then
    u_queue "$1|state" "$1/state"
    u_queue "$1|backlog" "$1/backlog"
    if u_flush_batch; then
      case "$U_MISS" in
        *" $1|state "*) ;;
        *) u_put "$U_SCR/man" 'U\t%s\n' "$1" ;;
      esac
    else
      u_add_key "$1|state" "$1/state"
      if [ "$U_ADD_RC" -eq 0 ]; then
        u_put "$U_SCR/man" 'U\t%s\n' "$1"
        u_active_units
        [ ! -s "$U_SCR/active" ] || u_add_key "$1|backlog" "$1/backlog"
      fi
    fi
    u_awk
    cat "$U_SCR/answer"
    return 0
  fi
  u_fetch_all 0
  u_active_units
  while IFS= read -r ua_u; do
    [ -n "$ua_u" ] || continue
    u_queue "$ua_u|backlog" "$ua_u/backlog"
  done < "$U_SCR/active"
  u_flush
  u_awk
  cat "$U_SCR/answer"
}

# u_active_units: the ACTIVE units among the fetched states into the active file, the
# state's first status line deciding
u_active_units() {
  u_new "$U_SCR/active"
  LC_ALL=C awk -F '	' '
    $1 == "F" {
      k = $2
      if (k !~ /\|state$/) next
      u = k; sub(/\|state$/, "", u)
      st = ""
      while ((getline line < $3) > 0) {
        if (line ~ /^status:/) {
          st = line
          sub(/^status:[ 	]*/, "", st)
          sub(/[ 	\r]+$/, "", st)
          break
        }
      }
      close($3)
      if (st == "ACTIVE") print u
    }' "$U_SCR/man" > "$U_SCR/active" || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
}

# u_payload: stdin into the scratch. The target is made first, so a scratch that cannot hold
# it refuses ERR_STORAGE_WRITE; a failure of the copy itself reads as the payload's read
u_payload() {
  u_new "$U_SCR/pay"
  { cat > "$U_SCR/pay"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_READ "cannot read the payload"
  U_PAY="$U_SCR/pay"
}

# u_args: the function's argv after the unit, as PX_A1..PX_AN for ops.awk
u_args() {
  PX_NA=0
  export PX_NA
  for ua_a in "$@"; do
    PX_NA=$((PX_NA + 1))
    eval "PX_A$PX_NA=\$ua_a; export PX_A$PX_NA"
  done
}

u_sizes() {
  u_new "$U_SCR/sizes"
  [ -s "$U_SCR/files" ] || return 0
  set --
  while IFS= read -r us_p; do set -- "$@" "$us_p"; done < "$U_SCR/files"
  { wc -c "$@" > "$U_SCR/sizes"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_READ "cannot read the unit's artifacts"
}

u_stage_start() {
  U_STAGE="$U_SCR/stage"
  mkdir -p "$U_STAGE" 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot stage the write"
}

# u_awk: one record engine run over the manifest; a refusal passes through
u_awk() {
  u_sizes
  if [ "${U_CAPTURE:-0}" -eq 1 ]; then
    ua_out=""
  else
    ua_out="$U_SCR/answer"
  fi
  PX_FN="$FN" PX_UNIT="${U_UNIT:-}" PX_MAN="$U_SCR/man" PX_SIZES="$U_SCR/sizes" \
    PX_PAY="${U_PAY:-}" PX_ERR="$U_SCR/err" PX_STAGE="${U_STAGE:-}" \
    PX_OUT="$ua_out" PX_NA="${PX_NA:-0}" PX_DOCSIZE="${PX_DOCSIZE:-0}" \
    awk -f "$ULIB/canon.awk" -f "$ULIB/model.awk" -f "$ULIB/ops.awk"
  ua_rc=$?
  if [ "$ua_rc" -ne 0 ]; then
    if [ -s "$U_SCR/err" ]; then
      cat "$U_SCR/err" >&2
    else
      printf '%s: error: the record engine failed (rc %s) (ERR_STORAGE_READ)\n' "$FN" "$ua_rc" >&2
      ua_rc=2
    fi
    exit "$ua_rc"
  fi
  return 0
}

# u_unit_migrate [--dry-run] <unit>...|--all: outside the record's 35 operations, the
# record's migrations, applied per unit under its unit lock: the root move first (store.promote,
# where the store keeps a fallback root), then the pointer rewrite (lib/migrate.awk) over every
# artifact value as stored, the changed values written back through one store.batch, never
# through the record operations, so a CLOSED unit is reached as the root move reaches it (the
# one named exception to the CLOSED freeze: a form change, never a meaning change). The units
# the store lists by their state key, in either root, are the held set the rewrite reads (a
# record storage path naming any other unit keeps its bytes). The named
# units (each one the store holds), or every unit the store lists by its state key; the first
# refusal stops the run naming the unit, the units migrated before it staying migrated. The
# census rows go to MG_DIR (the verb's census folder): before.tsv as each unit was found,
# after.tsv as it is left, residual.tsv the residual scan's rows (u_mig_residual). --dry-run
# computes the same rewrite and census, takes no lock, and
# writes nothing. The answer is {"promote":<bool>,"moved":N,"rewritten":N,"migrated":N}, the
# migrated count the units either migration changed (the units it would change, dry)
u_unit_migrate() {
  FN=unit.migrate
  um_dry=0
  if [ "${1:-}" = --dry-run ]; then um_dry=1; shift; fi
  [ $# -ge 1 ] || u_refuse 1 ERR_INVALID_ARGUMENT "unit.migrate takes the units or --all"
  um_dir=${MG_DIR:-$U_SCR}
  [ -d "$um_dir" ] && [ -w "$um_dir" ] || u_refuse 2 ERR_STORAGE_WRITE "cannot write the census folder"
  u_new "$um_dir/before.tsv" "$um_dir/after.tsv" "$um_dir/residual.tsv" "$um_dir/units.txt"
  um_promote=1
  store_has store.promote < /dev/null 2>/dev/null || um_promote=0
  u_new "$U_SCR/promote.units" "$U_SCR/mg.held" "$U_SCR/keys"
  if [ "$1" = --all ]; then
    u_extra 1 "$@"
  else
    for up_u in "$@"; do
      u_want_held "$up_u"
      u_put "$U_SCR/promote.units" '%s\n' "$up_u"
    done
  fi
  u_keys_all > "$U_SCR/keys" || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  while IFS= read -r up_k; do
    case "$up_k" in */state) ;; *) continue ;; esac
    up_u=${up_k%/state}
    case "$up_u" in */*) continue ;; esac
    u_ident_valid "$up_u" || continue
    u_put "$U_SCR/mg.held" '%s\n' "$up_u"
  done < "$U_SCR/keys"
  if [ "$1" = --all ]; then
    cp "$U_SCR/mg.held" "$U_SCR/promote.units" 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  fi
  um_moved=0
  um_rew=0
  um_mig=0
  while IFS= read -r up_u; do
    [ -n "$up_u" ] || continue
    um_hit=0
    u_put "$um_dir/units.txt" '%s\n' "$up_u"
    [ "$um_dry" -eq 1 ] || u_lock "$up_u"
    if [ "$um_promote" -eq 1 ] && [ "$um_dry" -eq 0 ]; then
      u_new "$U_SCR/promote.out" "$U_SCR/promote.err"
      store_promote "$up_u/" > "$U_SCR/promote.out" 2> "$U_SCR/promote.err" < /dev/null
      up_rc=$?
      if [ "$up_rc" -ne 0 ]; then
        up_msg=$(head -n 1 "$U_SCR/promote.err" 2>/dev/null)
        case "$up_msg" in
          store.promote:\ error:\ *) up_msg=${up_msg#store.promote: error: } ;;
        esac
        [ -n "$up_msg" ] || up_msg="the store promotion failed (ERR_STORAGE_WRITE)"
        printf '%s: error: unit '\''%s'\'': %s\n' "$FN" "$up_u" "$up_msg" >&2
        exit "$up_rc"
      fi
      if grep -q '"state":"moved"' "$U_SCR/promote.out" 2>/dev/null; then
        um_moved=$((um_moved + 1))
        um_hit=1
      fi
    fi
    u_mig_rewrite "$up_u" "$um_dir" "$um_dry"
    if [ "$UM_CHANGED" -eq 1 ]; then
      um_rew=$((um_rew + 1))
      um_hit=1
    fi
    [ "$um_hit" -eq 0 ] || um_mig=$((um_mig + 1))
    rm -rf "$U_LOCK" 2>/dev/null
    U_LOCK=""
  done < "$U_SCR/promote.units"
  if [ "$um_promote" -eq 1 ]; then um_p=true; else um_p=false; fi
  printf '{"promote":%s,"moved":%s,"rewritten":%s,"migrated":%s}\n' "$um_p" "$um_moved" "$um_rew" "$um_mig"
}

# u_mig_rewrite <unit> <census folder> <dry 0|1>: the pointer rewrite of one unit: every
# artifact value read as stored, lib/migrate.awk run over all of them (the before rows), the
# after rows counted over what the unit is left holding, and the changed values written back
# through one store.batch (none under --dry-run); UM_CHANGED says whether any value changed
u_mig_rewrite() {
  UM_CHANGED=0
  um_u=$1
  u_manifest_reset
  u_fetch_unit "$um_u" all 1
  u_new "$U_SCR/mg.map" "$U_SCR/mg.post" "$U_SCR/mg.files" "$U_SCR/mg.changed" "$U_SCR/mg.keys"
  rm -rf "$U_SCR/mg" 2>/dev/null
  mkdir "$U_SCR/mg" 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  um_n=0
  while IFS='	' read -r um_t um_k um_f; do
    [ "$um_t" = F ] || continue
    um_part=${um_k#*|}
    case "$um_part" in
      state|backlog|journal|knowledge) um_kind=$um_part; um_lane=""; um_key="$um_u/$um_part" ;;
      lane/*/*)
        um_r=${um_part#lane/}
        um_lane=${um_r%%/*}
        case "${um_r#*/}" in
          recipe) um_kind=recipe ;;
          report) um_kind=report ;;
          *) um_kind=ljournal ;;
        esac
        um_key="$um_u/lanes/$um_r"
        ;;
      *) continue ;;
    esac
    um_n=$((um_n + 1))
    um_nl=1
    [ -s "$um_f" ] && [ -n "$(tail -c 1 "$um_f")" ] && um_nl=0
    u_put "$U_SCR/mg.map" '%s\t%s\t%s\t%s\t%s\t%s\n' "$um_f" "$um_kind" "$um_lane" "$U_SCR/mg/$um_n" "$um_part" "$um_nl"
    u_put "$U_SCR/mg.files" '%s\n' "$um_f"
    u_put "$U_SCR/mg.keys" '%s\t%s\t%s\t%s\t%s\t%s\n' "$um_part" "$um_key" "$U_SCR/mg/$um_n" "$um_f" "$um_kind" "$um_lane"
  done < "$U_SCR/man"
  [ "$um_n" -gt 0 ] || return 0
  # shellcheck disable=SC2046
  MG_MODE=rewrite MG_UNIT=$um_u MG_REPOS="${MG_REPOS:-}" MG_HELD="$U_SCR/mg.held" MG_MAP="$U_SCR/mg.map" MG_CENSUS="$2/before.tsv" MG_CHANGED="$U_SCR/mg.changed" \
    awk -f "$ULIB/migrate.awk" $(cat "$U_SCR/mg.files") || u_refuse 2 ERR_STORAGE_READ "the pointer rewrite failed for unit '$um_u'"
  u_new "$U_SCR/mg.map2" "$U_SCR/mg.files2"
  while IFS='	' read -r um_part um_key um_o um_f um_kind um_lane; do
    um_src=$um_f
    grep -qxF "$um_part" "$U_SCR/mg.changed" 2>/dev/null && um_src=$um_o
    u_put "$U_SCR/mg.map2" '%s\t%s\t%s\t%s\t%s\t1\n' "$um_src" "$um_kind" "$um_lane" "$um_src.after" "$um_part"
    u_put "$U_SCR/mg.files2" '%s\n' "$um_src"
  done < "$U_SCR/mg.keys"
  # shellcheck disable=SC2046
  MG_MODE=census MG_UNIT=$um_u MG_REPOS="${MG_REPOS:-}" MG_HELD="$U_SCR/mg.held" MG_MAP="$U_SCR/mg.map2" MG_CENSUS="$2/after.tsv" MG_CHANGED="" \
    awk -f "$ULIB/migrate.awk" $(cat "$U_SCR/mg.files2") || u_refuse 2 ERR_STORAGE_READ "the census after failed for unit '$um_u'"
  u_mig_residual "$um_u" "$2/residual.tsv"
  [ -s "$U_SCR/mg.changed" ] || return 0
  UM_CHANGED=1
  [ "$3" -eq 0 ] || return 0
  u_new "$U_SCR/batch" "$U_SCR/batch.out" "$U_SCR/batch.err"
  while IFS='	' read -r um_part um_key um_o um_f um_kind um_lane; do
    grep -qxF "$um_part" "$U_SCR/mg.changed" 2>/dev/null || continue
    um_b64=$("$ULIB/b64" "$um_o") || u_refuse 2 ERR_STORAGE_WRITE "cannot encode $um_part"
    { {
      printf 'action=put\n' &&
      printf 'key=%s\n' "$(store_lib_escape "$um_key")" &&
      printf 'head=none\n' &&
      printf 'value_b64=%s\n' "$um_b64"
    } >> "$U_SCR/batch"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  done < "$U_SCR/mg.keys"
  store_batch < "$U_SCR/batch" > "$U_SCR/batch.out" 2> "$U_SCR/batch.err"
  um_rc=$?
  [ "$um_rc" -eq 0 ] || u_store_refuse "$um_rc" store.batch "$U_SCR/batch.err" "the store batch failed (ERR_STORAGE_WRITE)"
}

# u_mig_residual <unit> <rows file>: the residual scan, independent of lib/migrate.awk's
# tokenizer, over what the unit is left holding (the sources of the census after): every
# blank separated token still holding an old pointer form (a retired short owner, its .md
# spelling, a lanes/ artifact, a record storage path to a lane artifact, a ../<unit>/lanes/
# path, IDEAS.md) at its start or after a character no slug holds (a lanes/ artifact only
# after one no path holds), outside NOTE, CLOSES, and SUPERSEDES lines and ref_sessions, one
# row each: <unit> <label> <line> <token> (the token's surrounding punctuation cut)
u_mig_residual() {
  # shellcheck disable=SC2046
  RS_UNIT=$1 RS_MAP="$U_SCR/mg.map2" RS_OUT=$2 LC_ALL=C awk '
    function hit(t, re, bad,   s, p, c) {
      s = t
      p = 0
      while (match(s, re)) {
        c = (p + RSTART > 1) ? substr(t, p + RSTART - 1, 1) : ""
        if (c == "" || c !~ bad) return 1
        p += RSTART
        s = substr(t, p + 1)
      }
      return 0
    }
    function cut(t) {
      while (t != "" && index("([{\"'\''`*\\", substr(t, 1, 1))) t = substr(t, 2)
      while (t != "" && index(")]}\"'\''`,;:.!?*\\", substr(t, length(t), 1))) t = substr(t, 1, length(t) - 1)
      return t
    }
    BEGIN {
      while ((getline m < ENVIRON["RS_MAP"]) > 0) { split(m, P, "\t"); K[P[1]] = P[2]; L[P[1]] = P[5] }
      u = ENVIRON["RS_UNIT"]
      out = ENVIRON["RS_OUT"]
    }
    FNR == 1 { kind = K[FILENAME]; label = L[FILENAME]; blk = (kind ~ /^(backlog|journal|knowledge|ljournal)$/) }
    blk && /^  (NOTE|CLOSES|SUPERSEDES):/ { next }
    kind == "state" && /^ref_sessions[ \t]*:/ { next }
    {
      rest = $0
      while (match(rest, /[^ \t]+/)) {
        tok = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART + RLENGTH)
        if (index(tok, "IDEAS.md") || hit(tok, "(journal|knowledge|backlog|lane|task|finding|entry)(\\.md)?#[^ \t]", "[A-Za-z0-9_.-]") \
          || hit(tok, "lanes/[^/ \t]+/(recipe|journal|report)", "[A-Za-z0-9_./#-]") \
          || hit(tok, "(sessions|units)/[A-Za-z0-9_-]+/lanes/[^/ \t]+/(recipe|journal|report)", "[A-Za-z0-9_.-]") \
          || cut(tok) ~ /^\.\.\/[A-Za-z0-9_-]+\/lanes\//) \
          printf "%s\t%s\t%d\t%s\n", u, label, FNR, cut(tok) >> out
      }
    }' $(cat "$U_SCR/mg.files2") < /dev/null || u_refuse 2 ERR_STORAGE_WRITE "the residual scan failed for unit '$1'"
}

# u_warn: after a rc 0 run's answer, once, the reminder of the root move when a read of the
# run was served from the store's deprecated fallback root: each unit moves at its next
# write, and the sweep is the human's choice; the sweep itself prints none
u_warn() {
  [ "$cmd" = unit.migrate ] && return 0
  [ -n "$U_SCR" ] && [ -s "$U_SCR/notice" ] || return 0
  grep -q 'was read from its deprecated fallback root' "$U_SCR/notice" 2>/dev/null || return 0
  printf 'WARNING: the record was read from its deprecated root; each unit moves at its next write, and ctx unit migrate --all moves the rest when the human chooses\n' >&2
}

# u_commit: one store.batch, every staged artifact all or none, then the answer
u_commit() {
  if [ ! -f "$U_STAGE/manifest" ]; then
    cat "$U_SCR/answer"
    return 0
  fi
  u_new "$U_SCR/batch" "$U_SCR/batch.out" "$U_SCR/batch.err"
  while IFS='	' read -r uc_n uc_rel; do
    [ -n "$uc_n" ] || continue
    uc_src="$U_STAGE/$uc_n"
    [ -f "$uc_src" ] || u_refuse 2 ERR_STORAGE_WRITE "the staged write of $uc_rel is missing"
    uc_key="$U_UNIT/${uc_rel%.md}"
    uc_b64=$("$ULIB/b64" "$uc_src") || u_refuse 2 ERR_STORAGE_WRITE "cannot encode $uc_rel"
    { {
      printf 'action=put\n' &&
      printf 'key=%s\n' "$(store_lib_escape "$uc_key")" &&
      printf 'head=none\n' &&
      printf 'value_b64=%s\n' "$uc_b64"
    } >> "$U_SCR/batch"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
  done < "$U_STAGE/manifest"
  store_batch < "$U_SCR/batch" > "$U_SCR/batch.out" 2> "$U_SCR/batch.err"
  uc_rc=$?
  [ "$uc_rc" -eq 0 ] || u_store_refuse "$uc_rc" store.batch "$U_SCR/batch.err" "the store batch failed (ERR_STORAGE_WRITE)"
  cat "$U_SCR/answer"
}

# u_refs_check <file>: each line one ref, a full address (<owner>#<path>): a retired short
# owner (journal, knowledge, backlog, lane, task, finding, entry, and their .md spellings)
# refuses, and every other value passes the storage library's one full address shape check
# (lib_ref_ok)
u_refs_check() {
  while IFS= read -r ur_ref; do
    case "$ur_ref" in
      journal#*|knowledge#*|backlog#*|lane#*|task#*|finding#*|entry#*|journal.md#*|knowledge.md#*|backlog.md#*)
        printf "%s: error: malformed ref '%s': a reference is a full address <owner>#<path> (ERR_INVALID_ARGUMENT)\n" "$FN" "$(store_lib_escape "$ur_ref")" >&2
        exit 1 ;;
    esac
    lib_ref_ok "$FN" "$ur_ref" || exit 1
  done < "$1"
}

# u_refs_shape: a write's refs, each a full address, checked by u_refs_check before the unit
# lock; the target's existence is the verb's check, through each owner's get, before the call
u_refs_shape() {
  [ -n "$U_PAY" ] && [ -f "$U_PAY" ] || return 0
  u_new "$U_SCR/refs" "$U_SCR/refs.err"
  PX_PAY="$U_PAY" PX_ERR="$U_SCR/err" awk -f "$ULIB/canon.awk" -f "$ULIB/model.awk" -f "$ULIB/refs.awk" \
    > "$U_SCR/refs" 2> "$U_SCR/refs.err"
  case $? in
    0) ;;
    *) [ -s "$U_SCR/refs.err" ] && cat "$U_SCR/refs.err" >&2
       u_refuse 2 ERR_STORAGE_READ "cannot read the write's references" ;;
  esac
  u_refs_check "$U_SCR/refs"
}

# u_unit_call <function> <unit> <parts> <write> [<args>...]
u_unit_call() {
  FN=$1
  U_UNIT=$2
  U_PARTS=$3
  U_WRITE=$4
  shift 4
  u_scratch
  u_manifest_reset
  u_payload
  if [ "$U_WRITE" -eq 1 ]; then
    u_refs_shape
    u_lock "$U_UNIT"
    u_stage_start
  fi
  u_fetch_unit "$U_UNIT" "$U_PARTS" 1
  u_args "$@"
  u_awk
  if [ "$U_WRITE" -eq 1 ]; then
    u_commit
  else
    cat "$U_SCR/answer"
  fi
}

# u_recipe_refs <document>: a lane recipe's REFS block items, the first token of each indented
# line under a column 0 REFS :: head (the items refs-to reads), through u_refs_check
u_recipe_refs() {
  u_new "$U_SCR/refs"
  LC_ALL=C awk '
    /^[^ \t]/ { inrefs = ($0 ~ /^REFS[ \t]*::/); next }
    inrefs && /^[ \t]+[^ \t]/ { w = $0; sub(/^[ \t]+/, "", w); sub(/[ \t].*$/, "", w); print w }
  ' "$1" > "$U_SCR/refs" 2>/dev/null || u_refuse 2 ERR_STORAGE_READ "cannot read the recipe's references"
  u_refs_check "$U_SCR/refs"
}

# u_lane_doc <function> <unit> <lane>: lane.create or lane.write_report, the document raw, read
# before the unit lock; a recipe's REFS block items pass the shape backstop there
u_lane_doc() {
  FN=$1
  U_UNIT=$2
  U_LANE=$3
  u_scratch
  u_manifest_reset
  U_PAY=""
  u_stage_start
  u_new "$U_STAGE/doc"
  { cat > "$U_STAGE/doc"; } 2>/dev/null || u_refuse 2 ERR_STORAGE_READ "cannot read the document"
  if [ "$FN" = lane.create ]; then
    u_recipe_refs "$U_STAGE/doc"
  fi
  u_lock "$U_UNIT"
  PX_DOCSIZE=$(wc -c < "$U_STAGE/doc" | tr -d ' ')
  u_fetch_unit "$U_UNIT" "__lanes__" 1
  u_args "$U_LANE"
  u_awk
  u_commit
}

# u_load <unit>: the unit and every unit its ref_sessions name
u_load() {
  FN=session.load
  u_scratch
  U_UNIT=$1
  u_manifest_reset
  u_payload
  u_fetch_unit "$1" "" 1
  FN=state.refs
  U_CAPTURE=1
  u_lrefs=$(u_awk) || exit $?
  U_CAPTURE=0
  FN=session.load
  u_fetch_parts "$1" "backlog knowledge journal"
  for u_lr in $u_lrefs; do
    u_ident_valid "$u_lr" || continue
    [ "$u_lr" = "$1" ] && continue
    if u_held "$u_lr"; then
      u_fetch_unit "$u_lr" "backlog knowledge journal"
    fi
  done
  u_awk
  cat "$U_SCR/answer"
}

# u_refload <unit> [<unit>...]
u_refload() {
  FN=session.refload
  [ $# -ge 1 ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  U_UNIT=$1
  u_scratch
  for u_rr in "$@"; do
    u_want_unit "$u_rr"
    u_held "$u_rr" || u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$u_rr' not found"
  done
  u_manifest_reset
  u_payload
  for u_rr in "$@"; do
    u_fetch_unit "$u_rr" "backlog knowledge journal"
  done
  shift
  u_args "$@"
  u_awk
  cat "$U_SCR/answer"
}

# u_refs <unit> [<unit>...]: set ref_sessions
u_refs() {
  FN=session.refs
  U_UNIT=$1
  u_scratch
  u_want_unit "$U_UNIT"
  u_held "$U_UNIT" || u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$U_UNIT' not found"
  shift
  for u_r in "$@"; do
    u_ident_valid "$u_r" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$u_r'"
  done
  u_manifest_reset
  u_payload
  u_lock "$U_UNIT"
  u_stage_start
  u_fetch_all 0
  u_args "$@"
  u_awk
  u_commit
}

# u_held <unit>: the unit's state key exists
u_held() {
  u_new "$U_SCR/held.err"
  store_get "$1/state" > /dev/null 2> "$U_SCR/held.err" < /dev/null
  uh_rc=$?
  case "$uh_rc" in
    0) u_note "$U_SCR/held.err"; return 0 ;;
    1) return 1 ;;
    *) u_store_refuse "$uh_rc" store.get "$U_SCR/held.err" "the store read failed (ERR_STORAGE_READ)" ;;
  esac
}

u_want_held() {
  u_want_unit "$1"
  u_held "$1" || u_refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
}

u_extra() {
  ue_n=$1
  shift
  [ $# -le "$ue_n" ] || u_refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$(eval "printf '%s' \"\${$((ue_n + 1))}\"")'"
}

# u_pay_field <key>: one decoded payload value
u_pay_field() {
  PK=$1 PX_PAY="$U_PAY" PX_ERR="$U_SCR/err" \
    awk -f "$ULIB/canon.awk" -f "$ULIB/model.awk" -f "$ULIB/payfield.awk"
}

# u_search <unit> [flags]: one unit's search; --limit=0 answers every result (the search verb
# asks each unit uncapped, merges, and applies its limit once)
u_search() {
  FN=search.query
  U_UNIT=$1
  shift
  sq_limit=20
  sq_entity=all
  sq_mode=exact
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *) u_refuse 1 ERR_INVALID_ARGUMENT "unknown option '$sq_a'" ;;
    esac
  done
  case "$sq_limit" in
    ""|*[!0-9]*) u_refuse 1 ERR_INVALID_ARGUMENT "--limit takes a number, 0 for every result: '$sq_limit'" ;;
  esac
  case "$sq_entity" in
    all|session|task|entry|finding|lane|lane_entry) ;;
    *) u_refuse 1 ERR_INVALID_ARGUMENT "unknown entity type '$sq_entity' (session, task, entry, finding, lane, lane_entry, all)" ;;
  esac
  case "$sq_mode" in
    ""|[!a-z]*|*[!a-z0-9_-]*) u_refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$sq_mode'" ;;
  esac
  u_scratch
  if [ "$sq_mode" = exact ]; then
    # exact is answerable everywhere, and the listed artifacts prove the unit held, so the
    # exact read asks neither the held probe nor the mode registry
    u_want_unit "$U_UNIT"
    u_payload
  else
    u_want_held "$U_UNIT"
    u_payload
  fi
  # the modes this namespace can answer: the driver's registry filtered by the unit's
  # declared search schema, read through the storage core's library
  u_sq_modes=""
  [ "$sq_mode" = exact ] || u_sq_modes=$(store_modes --own 2>/dev/null | cut -f 1 | LC_ALL=C awk '{ o = o (NR > 1 ? ", " : "") $0 } END { print o }')
  if [ -n "$u_sq_modes" ]; then
    u_sq_ok=0
    for u_sq_m in $(printf '%s' "$u_sq_modes" | tr ',' ' '); do
      [ "$u_sq_m" = "$sq_mode" ] && u_sq_ok=1
    done
    if [ "$u_sq_ok" -eq 0 ]; then
      printf '%s: error: mode '\''%s'\'' is not supported; answerable modes: %s (ERR_CAPABILITY_UNSUPPORTED)\n' "$FN" "$sq_mode" "$u_sq_modes" >&2
      exit 1
    fi
  fi
  if [ "$sq_mode" = "exact" ]; then
    u_manifest_reset
    u_fetch_unit "$U_UNIT" "all" 2
    u_sizes
    u_new "$U_SCR/answer"
    PX_MAN="$U_SCR/man" PX_SIZES="$U_SCR/sizes" PX_PAY="$U_PAY" PX_ERR="$U_SCR/err" \
      SQ_UNIT="$U_UNIT" SQ_LIMIT="$sq_limit" SQ_ENTITY="$sq_entity" SQ_MODE="$sq_mode" \
      awk -f "$ULIB/canon.awk" -f "$ULIB/model.awk" -f "$ULIB/search.awk" > "$U_SCR/answer"
    sq_rc=$?
    if [ "$sq_rc" -ne 0 ]; then
      if [ -s "$U_SCR/err" ]; then cat "$U_SCR/err" >&2; else
        printf '%s: error: the search failed (rc %s) (ERR_STORAGE_READ)\n' "$FN" "$sq_rc" >&2
        sq_rc=2
      fi
      exit "$sq_rc"
    fi
    cat "$U_SCR/answer"
    return 0
  fi
  sq_q=$(u_pay_field query)
  u_new "$U_SCR/store.ans" "$U_SCR/store.err" "$U_SCR/flat" "$U_SCR/flat.err" "$U_SCR/answer"
  if ! store_search "$sq_q" "$sq_mode" 0 > "$U_SCR/store.ans" 2> "$U_SCR/store.err"; then
    sq_rc=$?
    sq_msg=$(head -n 1 "$U_SCR/store.err" 2>/dev/null)
    case "$sq_msg" in
      store.search:\ error:\ *) sq_msg=${sq_msg#store.search: error: } ;;
    esac
    [ -n "$sq_msg" ] || sq_msg="the store search failed (ERR_STORAGE_READ)"
    printf '%s: error: %s\n' "$FN" "$sq_msg" >&2
    exit "$sq_rc"
  fi
  awk -f "${U_LIB%/library}/json.awk" < "$U_SCR/store.ans" > "$U_SCR/flat" 2> "$U_SCR/flat.err" || {
    sq_rc=$?
    [ -s "$U_SCR/flat.err" ] && cat "$U_SCR/flat.err" >&2
    printf '%s: error: the store search answer is malformed (ERR_STORAGE_READ)\n' "$FN" >&2
    exit 2
  }
  RQ_UNIT="$U_UNIT" RQ_QUERY="$sq_q" RQ_MODE="$sq_mode" RQ_LIMIT="$sq_limit" RQ_ENTITY="$sq_entity" \
    awk -f "$ULIB/canon.awk" -f "$ULIB/model.awk" -f "$ULIB/ranked.awk" < "$U_SCR/flat" > "$U_SCR/answer"
  sq_rc=$?
  [ "$sq_rc" -eq 0 ] || exit "$sq_rc"
  cat "$U_SCR/answer"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
FN=$cmd

case "$cmd" in
  capability|storage.health)
    printf '%s: error: unknown function '\''%s'\'' (ERR_CAPABILITY_UNSUPPORTED)\n' "$cmd" "$cmd" >&2
    exit 2
    ;;
esac

u_scratch

case "$cmd" in
  session.create)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_manifest_reset
    u_payload
    u_refs_shape
    u_lock "${1:-}"
    u_new "$U_SCR/keys"
    u_keys_prefix "${1:-}/" > "$U_SCR/keys" || u_refuse 2 ERR_STORAGE_WRITE "cannot write the data script's scratch"
    if [ -s "$U_SCR/keys" ]; then
      u_refuse 1 ERR_ENTITY_EXISTS "unit '$1' already exists"
    fi
    u_stage_start
    U_UNIT=$1
    u_awk
    u_commit
    ;;
  session.list)
    u_extra 0 "$@"
    u_manifest_reset
    u_fetch_all 1
    u_awk
    cat "$U_SCR/answer"
    ;;
  session.active)
    u_extra 1 "$@"
    [ $# -eq 0 ] || u_want_unit "$1"
    u_active "$@"
    ;;
  session.load)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_load "${1:-}"
    ;;
  session.refload)
    u_refload "$@"
    ;;
  session.board)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_unit_call "$cmd" "$1" "backlog journal" 0
    ;;
  session.audit)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_unit_call "$cmd" "$1" "backlog journal" 0
    ;;
  session.stamp)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_unit_call "$cmd" "$1" "journal" 1
    ;;
  session.close)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_unit_call "$cmd" "$1" "backlog journal" 1
    ;;
  session.reopen)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    u_unit_call "$cmd" "$1" "" 1
    ;;
  session.refs)
    u_extra 99 "$@"
    u_refs "$@"
    ;;
  session.units)
    u_extra 1 "$@"
    [ -n "${1:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the repo"
    case "$1" in
      [!A-Za-z0-9._-]*|*[!A-Za-z0-9._/-]*) u_refuse 1 ERR_INVALID_ARGUMENT "malformed repo '$1'" ;;
    esac
    U_UNIT=$1
    u_manifest_reset
    u_fetch_all 0
    u_awk
    cat "$U_SCR/answer"
    ;;
  session.refs_to)
    u_extra 1 "$@"
    u_want_unit "${1:-}"
    U_UNIT=$1
    u_manifest_reset
    u_fetch_all 0
    u_awk
    cat "$U_SCR/answer"
    ;;
  task.add|task.update|task.start|task.complete|task.reopen|task.drop|task.get)
    u_extra 2 "$@"
    FN=$cmd
    u_want_unit "${1:-}"
    [ -n "${2:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the task slug"
    u_ident_valid "$2" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed task slug '$2'"
    case "$cmd" in
      task.get) u_unit_call "$cmd" "$1" "backlog" 0 "$2" ;;
      task.complete|task.drop) u_unit_call "$cmd" "$1" "backlog journal" 1 "$2" ;;
      *) u_unit_call "$cmd" "$1" "backlog" 1 "$2" ;;
    esac
    ;;
  task.list)
    u_extra 2 "$@"
    u_want_unit "${1:-}"
    case "${2:-}" in
      TODO|IN_PROGRESS|DONE|all) ;;
      *) u_refuse 1 ERR_INVALID_ARGUMENT "task.list takes TODO, IN_PROGRESS, DONE, or all: '${2:-}'" ;;
    esac
    u_unit_call "$cmd" "$1" "backlog" 0 "$2"
    ;;
  entry.record)
    u_extra 1 "$@"
    FN=$cmd
    u_want_unit "${1:-}"
    u_unit_call "$cmd" "$1" "journal" 1
    ;;
  entry.get|entry.closure)
    u_extra 2 "$@"
    u_want_unit "${1:-}"
    [ -n "${2:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the entry slug"
    u_name_valid "$2" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed entry slug '$2'"
    u_unit_call "$cmd" "$1" "journal" 0 "$2"
    ;;
  entry.list)
    u_want_unit "${1:-}"
    el_u=$1
    shift
    for el_a in "$@"; do
      case "$el_a" in
        --anchor=A[0-9]*) case "${el_a#--anchor=A}" in *[!0-9]*) u_refuse 1 ERR_INVALID_ARGUMENT "--anchor takes A<N>: '$el_a'" ;; esac ;;
        --group=?*) case "${el_a#--group=}" in [!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) u_refuse 1 ERR_INVALID_ARGUMENT "malformed group in '$el_a'" ;; esac ;;
        *) u_refuse 1 ERR_INVALID_ARGUMENT "unknown option '$el_a'" ;;
      esac
    done
    u_unit_call "$cmd" "$el_u" "journal" 0 "$@"
    ;;
  finding.add|finding.update|finding.drop|finding.get)
    u_extra 2 "$@"
    u_want_unit "${1:-}"
    [ -n "${2:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the finding NAME"
    u_name_valid "$2" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$2'"
    case "$cmd" in
      finding.get) u_unit_call "$cmd" "$1" "knowledge" 0 "$2" ;;
      *) u_unit_call "$cmd" "$1" "knowledge" 1 "$2" ;;
    esac
    ;;
  finding.supersede)
    u_extra 3 "$@"
    u_want_unit "${1:-}"
    for fs_n in "${2:-}" "${3:-}"; do
      [ -n "$fs_n" ] || u_refuse 1 ERR_INVALID_ARGUMENT "finding.supersede takes the unit, OLD, and NEW"
      u_name_valid "$fs_n" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$fs_n'"
    done
    u_unit_call "$cmd" "$1" "knowledge" 1 "$2" "$3"
    ;;
  finding.list)
    u_extra 2 "$@"
    u_want_unit "${1:-}"
    case "${2:-}" in
      active|all) ;;
      *) u_refuse 1 ERR_INVALID_ARGUMENT "finding.list takes active or all: '${2:-}'" ;;
    esac
    u_unit_call "$cmd" "$1" "knowledge" 0 "$2"
    ;;
  lane.create|lane.write_report)
    u_extra 2 "$@"
    FN=$cmd
    u_want_unit "${1:-}"
    [ -n "${2:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    u_ident_valid "$2" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    u_lane_doc "$cmd" "$1" "$2"
    ;;
  lane.record)
    u_extra 2 "$@"
    FN=$cmd
    u_want_unit "${1:-}"
    [ -n "${2:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    u_ident_valid "$2" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    u_unit_call "$cmd" "$1" "lane:$2" 1 "$2"
    ;;
  lane.get)
    u_extra 3 "$@"
    u_want_unit "${1:-}"
    [ -n "${2:-}" ] || u_refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    u_ident_valid "$2" || u_refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    case "${3:-}" in
      recipe|journal|report) ;;
      *) u_refuse 1 ERR_INVALID_ARGUMENT "lane.get takes recipe, journal, or report: '${3:-}'" ;;
    esac
    u_unit_call "$cmd" "$1" "lane:$2" 0 "$2" "$3"
    ;;
  search.query)
    u_search "$@"
    ;;
  unit.migrate)
    u_unit_migrate "$@"
    ;;
  *)
    printf '%s: error: unknown function '\''%s'\'' (ERR_CAPABILITY_UNSUPPORTED)\n' "$FN" "$cmd" >&2
    exit 2
    ;;
esac
u_warn
exit 0
