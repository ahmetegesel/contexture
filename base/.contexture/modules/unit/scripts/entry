#!/bin/sh
# summary: journal entry operations (show, list, closure)
# usage: ctx unit entry <subcommand> <unit> [args...]
# subcommand: show print one entry's canonical block
# usage: ctx unit entry show <unit> <slug> [--json]
# help: prints the entry's canonical block, the last occurrence of a repeated legacy slug
# subcommand: list list the journal's entries
# usage: ctx unit entry list <unit> [--anchor=A<N>] [--group=...] [--json]
# help: prints one line per entry occurrence, filtered by anchor or group
# subcommand: closure tell whether an entry is closed
# usage: ctx unit entry closure <unit> <slug> [--json]
# help: prints whether the entry is closed and every later closer naming it (positional: a closer closes the occurrences before it)

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

if [ $# -eq 0 ]; then
  printf 'usage: ctx unit entry <subcommand> <unit> [args...]\n' >&2
  printf 'subcommands: show, list, closure\n' >&2
  exit 1
fi

subcmd="$1"
shift

case "$subcmd" in
  show|closure)
    [ $# -gt 0 ] || { printf 'entry %s: error: missing unit argument\n' "$subcmd" >&2; exit 1; }
    unit="$1"; shift
    vb_unit "entry $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'entry %s: error: missing entry slug\n' "$subcmd" >&2; exit 1; }
    slug="$1"; shift
    json_out=0
    for a in "$@"; do
      case "$a" in
        --json) json_out=1 ;;
        *) vb_unknown "entry $subcmd" "$a" ;;
      esac
    done
    if [ "$subcmd" = show ]; then vb_call entry.get "$unit" "$slug"; else vb_call entry.closure "$unit" "$slug"; fi
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json
    elif [ "$subcmd" = show ]; then vb_render entry_show
    else vb_render closure
    fi
    exit 0
    ;;

  list)
    [ $# -gt 0 ] || { printf 'entry list: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "entry $subcmd" "$unit"
    json_out=0
    anchor_filter=""
    group_filter=""
    for a in "$@"; do
      case "$a" in
        --json) json_out=1 ;;
        --anchor=*) anchor_filter="${a#--anchor=}" ;;
        --group=*) group_filter="${a#--group=}" ;;
        *) vb_unknown "entry list" "$a" ;;
      esac
    done
    # the filters are the driver's (entry.list --anchor, --group), so text and JSON agree
    set --
    [ -n "$anchor_filter" ] && set -- "$@" "--anchor=$anchor_filter"
    [ -n "$group_filter" ] && set -- "$@" "--group=$group_filter"
    vb_call entry.list "$unit" "$@"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else vb_render entry_list; fi
    exit 0
    ;;

  *)
    printf "entry: error: unknown subcommand '%s' (show, list, closure) (ERR_INVALID_ARGUMENT)\n" "$subcmd" >&2
    exit 1
    ;;
esac
