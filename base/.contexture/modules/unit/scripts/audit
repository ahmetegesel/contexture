#!/bin/sh
# summary: the session audit: closures, entry grammar, the backlog cross-checks; prints the open thread tail
# usage: ctx unit audit <slug>
# help: the repair instrument: fix what it flags, fill what is missing; rc=1 on dangling or slugless closers, dateless entry slugs, inline markers on @entry lines, bracketed field lines, unharvested KNOWLEDGE flags, DONE tasks without their backlog/<slug>: DONE event, and entries dated at or after 2026-09-18 missing THREAD; each finding is flagged by slug (some also by line); a legacy duplicate entry slug prints as a LEGACY DUPLICATE SLUG warning and leaves rc unchanged; when the run is clean, also prints the open thread tail with its targets; the tail is a display, never an enforcement: a thread paused stays open; the old IN_PROGRESS-absent-from-state check retired with the stored pointer: the move is now derived from the backlog at presentation, so an IN_PROGRESS task is always on the board
# help: the storage driver checks the record (session.audit) and base prints its findings in a fixed order; the grammar checks with line numbers are the posix store's alone, since only a text store can hold broken text
# help: exit codes: 0 session audit clean (open thread tail printed if any); 1 grammar, closure, or consistency findings detected
# help: example: ctx unit audit my-unit

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx unit audit <unit>\n' >&2
  printf 'help: ctx unit help\n' >&2
  exit 1
}

case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && { vb_verb_help unit "$0"; exit 0; } ;;
esac
[ $# -eq 1 ] || usage
vb_slug_ok "$1" || usage

vb_call session.audit "$1"
if [ "$VB_RC" -ne 0 ]; then
  if [ "$VB_RC" -eq 1 ] && { vb_err_has "artifact 'journal' not found" || vb_err_has "unit '$1' not found"; }; then
    printf 'ERROR: missing journal: unit %s\n' "$1" >&2
    exit 1
  fi
  vb_through
fi
vb_render audit
