#!/bin/sh
# summary: storage diagnostics: configuration, storage driver, and storage health
# usage: ctx unit diagnose [--leftovers] [--json]
# help: inspect the workspace configuration, the resolved storage driver and its
# help: capability descriptor (the contract, the functions, the search modes, the
# help: optional capabilities), and the storage backend health (storage.health), then the
# help: ACTIVE unit count from the record's own listing; a listing that refuses prints
# help: active units: unknown (<its refusal's message>), null in --json, never a count.
# help: --leftovers adds what the record's storage holds beyond its documents (the keys the
# help: unit verbs read: each unit's state, backlog, knowledge, journal, and its lanes'
# help: recipes, journals, and reports), through the storage layer's read only probe over the
# help: unit namespace, a whole walk of its root and its deprecated root: one line per root,
# help: its documents and entries and each kind found with its count and bytes (stray files,
# help: folders outside the key shape, empty folders, symbolic links, special files,
# help: unreadable folders, lock or write remnants, keys the root shadows, keys outside the
# help: document rules such as old lane scratch), never a path; --json adds
# help: storage.leftovers, the probe's answer, null when it refused; a probe that refuses
# help: prints leftovers: unknown (<its message>); ctx unit migrate --sweep clears what it names.
# help: exit codes: 0 the diagnosis printed, a part it could not read named in its own line
# help: (a driver error, a health error, an unknown count); 1 an unrecognized option; 2 the
# help: storage resolver missing or no scratch folder.

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

format="text"
leftovers=0
for arg in "$@"; do
  case "$arg" in
    --json)
      format="json"
      ;;
    --leftovers)
      leftovers=1
      ;;
    *)
      printf 'ctx unit diagnose: unrecognized option: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

if [ ! -x "$VB_RESOLVER" ]; then
  printf 'ctx unit diagnose: driver-resolver not found at %s\n' "$VB_RESOLVER" >&2
  exit 2
fi

root="${CTX_ROOT:-$PWD}"
ctx_dir="$root/.contexture"

# 1. Config status
config_file="$ctx_dir/config"
config_status="absent"
config_driver=""
if [ -f "$config_file" ]; then
  config_status="present"
  if [ -n "${VB_CONFIG_LIB:-}" ] && [ -f "$VB_CONFIG_LIB" ]; then
    . "$VB_CONFIG_LIB"
    config_driver=$(cfg_get_file "$config_file" storage.driver 2>/dev/null) || config_driver=""
    if [ -z "$config_driver" ]; then
      config_driver=$(cfg_get_file "$config_file" session.storage.driver 2>/dev/null) || config_driver=""
    fi
  fi
fi

# 2. Driver resolution
if [ -n "${CTX_STORAGE_DRIVER:-}" ]; then
  driver_name="$CTX_STORAGE_DRIVER"
  driver_source="environment (CTX_STORAGE_DRIVER)"
elif [ -n "$config_driver" ]; then
  driver_name="$config_driver"
  driver_source="config"
else
  driver_name="posix"
  driver_source="default (posix)"
fi

# 3. The descriptor: the resolver's handshake read (capability), never a record read
vb_tmp
driver_status="ok"
driver_err=""
if "$VB_RESOLVER" capability < /dev/null > "$VB_DIR/cap" 2> "$VB_DIR/caperr"; then
  :
else
  driver_status="error"
  driver_err=$(cat "$VB_DIR/caperr" "$VB_DIR/cap")
fi

# 4. Storage health: the driver reports the store of the module's own namespace
# (storage.health unit); the ACTIVE unit count is the record's own listing (session.list),
# never part of the backend's health answer
vb_call storage.health unit
if [ "$VB_RC" -eq 0 ]; then
  vb_relay
  health_line=$(vb_render health)
else
  health_line=$(printf 'error\tthe storage driver did not report its health\tabsent')
fi
tab=$(printf '\t')
health_status=${health_line%%"$tab"*}
rest=${health_line#*"$tab"}
health_detail=${rest%%"$tab"*}
rest=${rest#*"$tab"}
health_store=${rest%%"$tab"*}
# a listing that refuses leaves the count unknown, never 0: the text names the refusal's
# message, --json reads null
active_count=""
active_err=""
vb_call session.list
if [ "$VB_RC" -eq 0 ]; then
  vb_relay
  active_count=$(awk '{ n += gsub(/"status":"ACTIVE"/, ""); } END { print n + 0 }' "$VB_DIR/ans")
else
  active_err=$(awk 'NR == 1 { sub(/^[^ ]*: error: /, ""); print; exit }' "$VB_DIR/err" 2>/dev/null)
  [ -n "$active_err" ] || active_err="the record's listing did not answer"
fi

# 5. With --leftovers, what the unit namespace's storage holds beyond its documents: the storage
# layer's read only probe for the module's own namespace (the library's caller lookup names
# it), its answer rendered by the library's one text form; a probe that refuses leaves it
# unknown with its message, null in --json
lo_ans=""
lo_err=""
if [ "$leftovers" -eq 1 ]; then
  if [ -z "$VB_LIBRARY" ]; then
    lo_err="the storage layer library is not installed"
  elif store_leftovers < /dev/null > "$VB_DIR/lo" 2> "$VB_DIR/loerr" && store_leftovers_text "$VB_DIR/lo" summary > "$VB_DIR/lotext" 2>> "$VB_DIR/loerr"; then
    lo_ans=$(cat "$VB_DIR/lo")
  else
    lo_err=$(awk 'NR == 1 { sub(/^[^ ]*: error: /, ""); print; exit }' "$VB_DIR/loerr" 2>/dev/null)
    [ -n "$lo_err" ] || lo_err="the storage layer did not answer the leftovers probe"
  fi
fi

# jstr <text>: one JSON string in the contract form
jstr() {
  JS_V="$1" awk 'BEGIN {
    s = ENVIRON["JS_V"]
    n = split(s, P, /\\/); o = (n ? P[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" P[i]
    n = split(o, Q, /"/); o = (n ? Q[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\"" Q[i]
    n = split(o, T, /\t/); o = (n ? T[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "t" T[i]
    n = split(o, T, /\r/); o = (n ? T[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "r" T[i]
    n = split(o, L, "\n"); r = (n ? L[1] : ""); for (i = 2; i <= n; i++) r = r "\\" "n" L[i]
    printf "\"%s\"", r
  }'
}

if [ "$format" = "json" ]; then
  if [ "$driver_status" = ok ]; then desc=$(cat "$VB_DIR/cap"); else desc=null; fi
  lo_json=""
  [ "$leftovers" -eq 0 ] || lo_json=",\"leftovers\":${lo_ans:-null}"
  printf '{"workspace_root":%s,"config":{"status":%s,"driver":%s},"driver":{"name":%s,"source":%s,"status":%s,"descriptor":%s},"storage":{"health":%s,"detail":%s,"store":%s,"active_units":%s%s}}\n' \
    "$(jstr "$root")" "$(jstr "$config_status")" "$(jstr "${config_driver:-none}")" \
    "$(jstr "$driver_name")" "$(jstr "$driver_source")" "$(jstr "$driver_status")" "$desc" \
    "$(jstr "$health_status")" "$(jstr "$health_detail")" "$(jstr "$health_store")" "${active_count:-null}" "$lo_json"
else
  printf 'ctx unit: storage and configuration diagnostics\n'
  printf '  workspace root:  %s\n' "$root"
  printf '  configuration:   %s' "$config_status"
  if [ -n "$config_driver" ]; then
    printf ' (storage.driver = %s)\n' "$config_driver"
  else
    printf '\n'
  fi
  printf '  storage driver:  %s (source: %s)\n' "$driver_name" "$driver_source"
  if [ "$driver_status" = "ok" ]; then
    printf '  driver status:   ok\n'
    reg=$("$VB_RESOLVER" modes < /dev/null 2>/dev/null | awk -F '\t' '$1 != "" { o = o (o == "" ? "" : ", ") $1 } END { print o }')
    awk -f "$VB_JSON" < "$VB_DIR/cap" | RV_MODES="$reg" RV_VIEW=diagnose awk -f "$VB_RENDER"
  else
    printf '  driver status:   error (%s)\n' "$driver_err"
  fi
  printf '  storage health:  %s (%s)\n' "$health_status" "$health_detail"
  if [ -n "$active_count" ]; then
    printf '  active units:    %d\n' "$active_count"
  else
    printf '  active units:    unknown (%s)\n' "$active_err"
  fi
  if [ "$leftovers" -eq 1 ]; then
    if [ -n "$lo_ans" ]; then
      printf '  leftovers:\n'
      sed 's/^/    /' "$VB_DIR/lotext"
    else
      printf '  leftovers:       unknown (%s)\n' "$lo_err"
    fi
  fi
fi
