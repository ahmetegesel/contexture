# the unit module's store declaration: the record as one value per artifact file
root: .contexture/units
fallback_root: .contexture/sessions
suffix: .md
key: <unit>/<path...>
# the record's document set: every artifact a verb reads, none of them a search schema, so
# the leftovers probe and the sweep count their keys as documents
unsearched: <unit>/state
unsearched: <unit>/backlog
unsearched: <unit>/knowledge
unsearched: <unit>/journal
unsearched: <unit>/lanes/<lane>/recipe
unsearched: <unit>/lanes/<lane>/journal
unsearched: <unit>/lanes/<lane>/report
