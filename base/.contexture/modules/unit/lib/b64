#!/bin/sh
# b64: the unit module's base64 encoder (a helper, not a verb; no summary line, so
# discovery ignores it). It reads one file and prints its bytes as base64 on one line, so
# the data script can carry an artifact's value in a store.batch put. od reads the bytes;
# awk builds each group from the decimal byte values, so no external base64 command and no
# locale folding is involved.
#
# Usage: b64 <file>
# Exit codes: 0 the encoded answer; 1 a missing argument or an unreadable file.

set -u
LC_ALL=C
export LC_ALL

[ $# -eq 1 ] || {
  printf 'store-b64: error: takes one file (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
}
[ -f "$1" ] || {
  printf 'store-b64: error: file not found (ERR_ENTITY_NOT_FOUND)\n' >&2
  exit 1
}
[ -r "$1" ] || {
  printf 'store-b64: error: file is not readable (ERR_STORAGE_READ)\n' >&2
  exit 1
}

od -An -v -tu1 "$1" | awk '
BEGIN {
  b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  k = 0
}
{
  for (i = 1; i <= NF; i++) {
    v = $i + 0
    if (k == 0) { x = v; k = 1 }
    else if (k == 1) { y = v; k = 2 }
    else { z = v; k = 0; emit3(x, y, z) }
  }
}
END {
  if (k == 1) emit1(x)
  else if (k == 2) emit2(x, y)
}
function ch(n) { return substr(b64, n + 1, 1) }
function emit3(a, b, c) {
  printf "%s%s%s%s", ch(int(a / 4)), ch((a % 4) * 16 + int(b / 16)), ch((b % 16) * 4 + int(c / 64)), ch(c % 64)
}
function emit1(a) {
  printf "%s%s==", ch(int(a / 4)), ch((a % 4) * 16)
}
function emit2(a, b) {
  printf "%s%s%s=", ch(int(a / 4)), ch((a % 4) * 16 + int(b / 16)), ch((b % 16) * 4)
}
'
