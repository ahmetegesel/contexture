#!/bin/sh
# store: the private engine behind the store verbs. It carries no summary line, so discovery
# ignores it and the engine never lists it as a verb; each verb is a thin wrapper that execs
# it with its act name. The one door to the data is the storage layer's module library: the
# engine sources it and calls its functions only (the store functions, the field validator,
# the library lock, and the shared checks), so the module never names the configured driver,
# and the library serves the module's own namespace alone.
#
# Keys: <container>/<id> for a record, containers/<name> for a declaration. A declaration is
# one record of the builtin containers container, its schema fixed here: description (a
# required line), minting (a required line, given or generated), fields (an optional list of
# field lines in the library's grammar), and the store kept retired (every id the container
# ever used and gave up) and state (dropped once dropped), which no write may name.
#
# Every refusal is rc 1 or 2 with one stderr line, store <verb>: error: <message> (<CODE>),
# a library refusal re-framed under the verb's name; a write refusal writes nothing.
set -u

verb=${1:-}
[ -n "$verb" ] && shift
FN="store $verb"

die() {
  printf '%s: error: %s (%s)\n' "$FN" "$3" "$2" >&2
  exit "$1"
}

if [ -z "${CTX_ROOT:-}" ]; then
  printf '%s: error: run this module through ctx (CTX_ROOT is not set) (ERR_INVALID_ARGUMENT)\n' "$FN" >&2
  exit 2
fi
case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && exec "${CTX_BIN:-$CTX_ROOT/.contexture/ctx}" store help "$verb" ;;
esac

MOD=${0%/scripts/*}
REC_AWK=$MOD/lib/record.awk
LIB=$CTX_ROOT/.contexture/storage/scripts/library
[ -f "$LIB" ] || die 2 ERR_DRIVER_NOT_FOUND 'the storage layer library is not installed'
CTX_STORE_ROOT=$CTX_ROOT
export CTX_STORE_ROOT
. "$LIB"
CORE=${LIB%/library}

scratch=${CTX_SCRATCH_ROOT:-$CTX_ROOT/.contexture/tmp}
mkdir -p "$scratch" 2>/dev/null
SCR=$(mktemp -d "$scratch/store.XXXXXX" 2>/dev/null) || die 2 ERR_STORAGE_WRITE 'cannot make the verb scratch'
cleanup() {
  lib_unlock
  rm -rf "$SCR"
}
trap 'cleanup' EXIT
trap 'cleanup; trap - EXIT; exit 129' HUP
trap 'cleanup; trap - EXIT; exit 130' INT
trap 'cleanup; trap - EXIT; exit 143' TERM

NL='
'
TAB='	'
CR=$(printf '\r')

CONTAINERS_DECL='description: required line
minting: required line one-of given|generated
fields: optional line list'
printf '%s\n' "$CONTAINERS_DECL" > "$SCR/containers.decl"

# reframe: the library's one refusal line in $SCR/err printed under the verb's name
reframe() {
  rf_line=$(sed -n 1p "$SCR/err")
  rf_msg=${rf_line#*: error: }
  printf '%s: error: %s\n' "$FN" "$rf_msg" >&2
}

# lib_or_die <function> [args...]: one library call; a refusal re-framed, its rc the exit
lib_or_die() {
  "$@" 2> "$SCR/err"
  lod_rc=$?
  [ "$lod_rc" -eq 0 ] && return 0
  reframe
  exit "$lod_rc"
}

# rec <mode> [<arg>]: the record reader over stdin
rec() {
  REC_MODE=$1 REC_ARG=${2:-} awk -f "$REC_AWK"
}

# word_ok <word>: the slug rule of ids and container names: letters, digits, underscore, and
# dash, starting with a letter or digit
word_ok() {
  case "$1" in
    [ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-]*) return 1 ;;
  esac
  return 0
}

lower() {
  printf '%s\n' "$1" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz'
}

# fetch <key> <file>: rc 0 with the value in the file, rc 1 when the key is absent
fetch() {
  printf '%s\t%s\n' "$1" "$2" > "$SCR/fetch"
  lib_or_die store_get_into "$SCR/fetch" > "$SCR/fetch.out"
  case $(cat "$SCR/fetch.out") in
    1*) return 0 ;;
  esac
  return 1
}

# keys <prefix>: every stored key under the prefix, one per line, bytewise
keys() {
  lib_or_die store_list "$1" > "$SCR/list.json"
  awk -f "$CORE/json.awk" < "$SCR/list.json" | sed -n 's/^keys\.[0-9][0-9]*=//p'
}

# decl_load <name>: DSTATE absent, live, or dropped; the declaration record in $SCR/d.rec,
# its field lines in $SCR/d.fields, its minting in DMINT
decl_load() {
  : > "$SCR/d.fields"
  DMINT=""
  if ! fetch "containers/$1" "$SCR/d.rec"; then
    DSTATE=absent
    : > "$SCR/d.rec"
    return 0
  fi
  rec values fields < "$SCR/d.rec" > "$SCR/d.fields"
  DMINT=$(rec values minting < "$SCR/d.rec")
  if [ "$(rec values state < "$SCR/d.rec")" = dropped ]; then DSTATE=dropped; else DSTATE=live; fi
}

# parse_writes [flags...]: the write forms into the actions file $SCR/acts (the field
# validator's tab separated lines) and the ref actions into $SCR/refacts; a malformed flag
# refuses
parse_writes() {
  : > "$SCR/acts"
  : > "$SCR/refacts"
  pw_stdin=""
  for pw_a in "$@"; do
    case "$pw_a" in
      --unset=*) pw_op=unset; pw_f=${pw_a#--unset=}; pw_v="" ;;
      --stdin=*) pw_op=block; pw_f=${pw_a#--stdin=}; pw_v="" ;;
      --add-*=*) pw_op=add; pw_f=${pw_a#--add-}; pw_v=${pw_f#*=}; pw_f=${pw_f%%=*} ;;
      --remove-*=*) pw_op=remove; pw_f=${pw_a#--remove-}; pw_v=${pw_f#*=}; pw_f=${pw_f%%=*} ;;
      --?*=*) pw_op=set; pw_f=${pw_a#--}; pw_v=${pw_f#*=}; pw_f=${pw_f%%=*} ;;
      *) die 1 ERR_INVALID_ARGUMENT "unknown argument '$(store_lib_escape "$pw_a")' (a write takes --<field>=<value>, --add-<field>=<item>, --remove-<field>=<item>, --unset=<field>, or --stdin=<field>)" ;;
    esac
    [ -n "$pw_f" ] || die 1 ERR_INVALID_ARGUMENT "argument '$(store_lib_escape "$pw_a")' names no field"
    case "$pw_f" in *"$NL"*|*"$TAB"*|*"$CR"*) die 1 ERR_INVALID_ARGUMENT "argument '$(store_lib_escape "$pw_a")' names a malformed field" ;; esac
    if [ "$pw_op" = block ]; then
      [ -z "$pw_stdin" ] || die 1 ERR_INVALID_ARGUMENT "one block per call: --stdin names '$pw_stdin' already"
      pw_stdin=$pw_f
      cat > "$SCR/block"
      pw_v=$("$CORE/store-b64" "$SCR/block") || die 2 ERR_STORAGE_READ 'cannot read the block on stdin'
      [ -s "$SCR/block" ] || pw_v=""
    fi
    case "$pw_op" in
      unset) printf 'unset\t%s\n' "$pw_f" ;;
      block) printf 'block\t%s\t%s\n' "$pw_f" "$pw_v" ;;
      *) printf '%s\t%s\t%s\n' "$pw_op" "$pw_f" "$(store_lib_escape "$pw_v")" ;;
    esac >> "$SCR/acts"
  done
}

# system_names_refused <names...>: a write naming a store kept field refuses as undeclared
system_names_refused() {
  for snr_n in "$@"; do
    if awk -F '\t' -v n="$snr_n" '$2 == n { found = 1 } END { exit !found }' "$SCR/acts"; then
      die 1 ERR_SCHEMA_VIOLATION "field '$snr_n' is not declared (the store keeps it)"
    fi
  done
}

# decl_fields_check <declaration record>: the field lines it carries checked by the library
decl_fields_check() {
  rec values fields < "$1" > "$SCR/new.fields"
  lib_or_die fields_decl_check "$SCR/new.fields"
}

# print_record <container> <id> <record file>
print_record() {
  if [ "$json" = 1 ]; then
    if [ "$1" = containers ]; then pr_lists="fields retired"; else pr_lists=$(list_names); fi
    printf '{"container":"%s","id":"%s","address":"store#%s/%s","record":' "$1" "$2" "$1" "$2"
    rec json "$pr_lists" < "$3"
    printf '}\n'
  else
    cat "$3"
  fi
}

# split_path <path>: PC and PI from <container>/<id>, PI empty for a bare container
split_path() {
  case "$1" in
    */*/*|/*|*/) die 1 ERR_INVALID_ARGUMENT "malformed path '$(store_lib_escape "$1")' (a path is <container>/<id>)" ;;
    */*) PC=${1%%/*}; PI=${1#*/} ;;
    *) PC=$1; PI="" ;;
  esac
  word_ok "$PC" || die 1 ERR_INVALID_ARGUMENT "malformed container name '$(store_lib_escape "$PC")' (letters, digits, underscore, and dash, starting with a letter or digit)"
  [ "$PC" != containers ] || id_shape
}

# id_shape: PI checked against the slug rule
id_shape() {
  if [ -n "$PI" ] && ! word_ok "$PI"; then
    die 1 ERR_INVALID_ARGUMENT "malformed id '$(store_lib_escape "$PI")' (letters, digits, underscore, and dash, starting with a letter or digit)"
  fi
}

# live_for_write: the container PC declared and live, else the write breaks the schema
live_for_write() {
  decl_load "$PC"
  case "$DSTATE" in
    absent) die 1 ERR_SCHEMA_VIOLATION "container '$PC' is not declared (put containers/$PC declares it)" ;;
    dropped) die 1 ERR_SCHEMA_VIOLATION "container '$PC' is dropped (put containers/$PC declares it again)" ;;
  esac
}

# live_for_read: the container PC declared and live, else it reads not found
live_for_read() {
  decl_load "$PC"
  case "$DSTATE" in
    absent) die 1 ERR_ENTITY_NOT_FOUND "container '$PC' is not declared" ;;
    dropped) die 1 ERR_ENTITY_NOT_FOUND "container '$PC' is dropped" ;;
  esac
}

# retired_has <id>: rc 0 when the declaration's retired list holds the id, whatever its case
retired_has() {
  rh_id=$(lower "$1")
  rec values retired < "$SCR/d.rec" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz' | grep -Fqx -- "$rh_id"
}

# twin_of <id>: the stored id of PC equal to the id whatever its case, printed; rc 1 when none
twin_of() {
  keys "$PC/" > "$SCR/twin.keys"
  TO_ID=$(lower "$1") awk -v p="$PC/" '{ k = substr($0, length(p) + 1); if (tolower(k) == ENVIRON["TO_ID"]) { print k; found = 1; exit } } END { exit !found }' "$SCR/twin.keys"
}

# id_free <id>: refuses an id a record holds (in any case) or the declaration retired
id_free() {
  if if_twin=$(twin_of "$1"); then
    [ "$if_twin" = "$1" ] && die 1 ERR_ENTITY_EXISTS "record '$PC/$1' already exists"
    die 1 ERR_ENTITY_EXISTS "record '$PC/$1' already exists as '$PC/$if_twin' (ids are unique whatever their case)"
  fi
  retired_has "$1" && die 1 ERR_ENTITY_EXISTS "id '$1' is retired in container '$PC' (a deleted id is never handed out again)"
  return 0
}

# mint: a generated id, the date and five random lowercase letters or digits, drawn until
# no record holds it and the declaration never retired it
mint() {
  mi_n=0
  keys "$PC/" > "$SCR/mint.keys"
  while [ "$mi_n" -lt 50 ]; do
    mi_n=$((mi_n + 1))
    mi_r=$(od -An -N5 -tu1 /dev/urandom 2>/dev/null | awk -v s="$$$mi_n" 'BEGIN { c = "abcdefghijklmnopqrstuvwxyz0123456789" }
      { for (i = 1; i <= NF; i++) out = out substr(c, $i % 36 + 1, 1) }
      END { if (length(out) != 5) { srand(s); out = ""; for (i = 1; i <= 5; i++) out = out substr(c, int(rand() * 36) + 1, 1) } print out }')
    mi_id="$(date +%Y-%m-%d)-$mi_r"
    MI_ID=$mi_id awk -v p="$PC/" 'tolower(substr($0, length(p) + 1)) == ENVIRON["MI_ID"] { found = 1 } END { exit !found }' "$SCR/mint.keys" && continue
    retired_has "$mi_id" && continue
    PI=$mi_id
    return 0
  done
  die 2 ERR_STORAGE_WRITE "no free id drawn for container '$PC' in 50 draws"
}

# split_refs: the ref actions moved out of $SCR/acts into $SCR/refacts, since ref is the
# built in list field of every container, kept by the store beside the declared fields
split_refs() {
  awk -F '\t' '$2 == "ref"' "$SCR/acts" > "$SCR/refacts"
  awk -F '\t' '$2 != "ref"' "$SCR/acts" > "$SCR/acts.core"
  mv "$SCR/acts.core" "$SCR/acts"
}

# apply_refs <old ref values file> <new ref lines file>: the ref actions applied to the old
# items in order, each added ref checked (UTF-8, then the full address shape) last
apply_refs() {
  cp "$1" "$SCR/refs.items"
  while IFS='	' read -r ar_op ar_f ar_e; do
    case "$ar_op" in
      set) die 1 ERR_INVALID_ARGUMENT "field 'ref' is a list: add or remove its items" ;;
      block) die 1 ERR_INVALID_ARGUMENT "field 'ref' is a line field, not a block" ;;
      unset) : > "$SCR/refs.items"; continue ;;
    esac
    ar_v=$(printf '%s' "$ar_e" | REC_MODE=unesc awk -f "$REC_AWK"; printf x)
    ar_v=${ar_v%x}
    [ -n "$ar_v" ] || die 1 ERR_INVALID_ARGUMENT "field 'ref': an empty value (unset removes a field)"
    if [ "$ar_op" = add ]; then
      lib_utf8_ok "$ar_v" || die 1 ERR_INVALID_ARGUMENT "field 'ref': the value is not valid UTF-8"
      lib_ref_ok "$FN" "$ar_v" || exit $?
      grep -Fqx -- "$ar_v" "$SCR/refs.items" && die 1 ERR_INVALID_ARGUMENT "field 'ref' already holds '$ar_v'"
      printf '%s\n' "$ar_v" >> "$SCR/refs.items"
    else
      case "$ar_v" in *"
"*) die 1 ERR_INVALID_ARGUMENT "field 'ref' holds no item '$ar_e'" ;; esac
      grep -Fqx -- "$ar_v" "$SCR/refs.items" || die 1 ERR_INVALID_ARGUMENT "field 'ref' holds no item '$ar_e'"
      AR_V=$ar_v awk '$0 != ENVIRON["AR_V"]' "$SCR/refs.items" > "$SCR/refs.next"
      mv "$SCR/refs.next" "$SCR/refs.items"
    fi
  done < "$SCR/refacts"
  while IFS= read -r ar_v; do printf 'ref: "%s"\n' "$(store_lib_escape "$ar_v")"; done < "$SCR/refs.items" > "$2"
}

# declared_names: the declared field names of PC, blank separated
declared_names() {
  sed 's/:.*//' "$SCR/d.fields" | tr '\n' ' '
}

# list_names: the declared list fields of PC and the built in ref, blank separated
list_names() {
  awk '$4 == "list" { sub(/:$/, "", $1); printf "%s ", $1 }' "$SCR/d.fields"
  printf 'ref'
}

# compose <core record> <ref lines> <out>: the ref lines placed after the declared fields
compose() {
  REC_FILE=$2 REC_MODE=insert REC_ARG=$(declared_names) awk -f "$REC_AWK" < "$1" > "$3"
}

# effective <stored record> <out>: the record with each absent static default filled at read
effective() {
  rec strip ref < "$1" > "$SCR/eff.core"
  rec keep ref < "$1" > "$SCR/eff.refs"
  lib_or_die fields_effective "$SCR/d.fields" "$SCR/eff.core" > "$SCR/eff.filled"
  compose "$SCR/eff.filled" "$SCR/eff.refs" "$2"
}

# record_missing: the missing record PC/PI refused, naming a retired id as retired
record_missing() {
  retired_has "$PI" && die 1 ERR_ENTITY_NOT_FOUND "record '$PC/$PI' is retired (a deleted id is never handed out again)"
  die 1 ERR_ENTITY_NOT_FOUND "record '$PC/$PI' not found"
}

# retire_into <retired lines> <out>: the declaration of PC with the lines added after the ids
# it already retired, before its state
retire_into() {
  rec strip 'retired state' < "$SCR/d.rec" > "$SCR/ri.base"
  rec keep retired < "$SCR/d.rec" > "$SCR/ri.ret"
  rec keep state < "$SCR/d.rec" > "$SCR/ri.state"
  cat "$SCR/ri.base" "$SCR/ri.ret" "$1" "$SCR/ri.state" > "$2"
}

# read_all <prefix>: every record under the prefix read in one batched get into $SCR/r.<n>,
# its keys printed in order
read_all() {
  keys "$1" > "$SCR/all.keys"
  : > "$SCR/all.targets"
  ra_n=0
  while IFS= read -r ra_k; do
    ra_n=$((ra_n + 1))
    printf '%s\t%s\n' "$ra_k" "$SCR/r.$ra_n" >> "$SCR/all.targets"
  done < "$SCR/all.keys"
  [ "$ra_n" -eq 0 ] || lib_or_die store_get_into "$SCR/all.targets" > /dev/null
  cat "$SCR/all.keys"
}

# lvl: the live container names, comma separated, or none
lvl() {
  if [ -n "$live" ]; then printf "%s" "$live" | sed "s/ /, /g"; else printf none; fi
}

# filter_check <field> <escaped value>: ok, undeclared, block, or set <the one-of set> for a
# value outside it, read from the declaration of PC
filter_check() {
  FC_F=$1 FC_V=$(printf '%s' "$2" | REC_MODE=unesc awk -f "$REC_AWK") awk '
    { c = index($0, ":"); if (substr($0, 1, c - 1) != ENVIRON["FC_F"]) next
      found = 1; rest = substr($0, c + 2); split(rest, w, / /)
      if (w[2] == "block") { print "block"; exit }
      p = index(rest, " one-of ")
      if (p) {
        s = substr(rest, p + 8); q = index(s, " default "); if (q) s = substr(s, 1, q - 1)
        nv = split(s, v, /\|/); ok = 0
        for (i = 1; i <= nv; i++) if (v[i] == ENVIRON["FC_V"]) ok = 1
        if (!ok) { print "set " s; exit }
      }
      print "ok"; exit
    }
    END { if (!found) print "undeclared" }' "$SCR/d.fields"
}

json=0

case "$verb" in
  get)
    gp=""
    for a in "$@"; do
      case "$a" in
        --json) json=1 ;;
        -*) die 1 ERR_INVALID_ARGUMENT "unknown flag '$(store_lib_escape "$a")' (usage: ctx store get <container>/<id> [--json])" ;;
        *) [ -z "$gp" ] || die 1 ERR_INVALID_ARGUMENT 'get takes one path (usage: ctx store get <container>/<id> [--json])'; gp=$a ;;
      esac
    done
    [ -n "$gp" ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store get <container>/<id> [--json]'
    split_path "$gp"
    [ -n "$PI" ] || die 1 ERR_INVALID_ARGUMENT "get reads one entity: <container>/<id> (list $PC lists the container)"
    if [ "$PC" = containers ]; then
      decl_load "$PI"
      [ "$DSTATE" != absent ] || die 1 ERR_ENTITY_NOT_FOUND "container '$PI' is not declared"
      print_record containers "$PI" "$SCR/d.rec"
      exit 0
    fi
    live_for_read
    id_shape
    fetch "$PC/$PI" "$SCR/rec" || record_missing
    effective "$SCR/rec" "$SCR/rec.eff"
    print_record "$PC" "$PI" "$SCR/rec.eff"
    exit 0
    ;;
  list)
    lc=""
    dropped=0
    : > "$SCR/filters"
    for a in "$@"; do
      case "$a" in
        --json) json=1 ;;
        --dropped) dropped=1 ;;
        --?*=*) lf=${a#--}; printf '%s\t%s\n' "$(store_lib_escape "${lf%%=*}")" "$(store_lib_escape "${lf#*=}")" >> "$SCR/filters" ;;
        -*) die 1 ERR_INVALID_ARGUMENT "unknown flag '$(store_lib_escape "$a")' (a filter is --<field>=<value>)" ;;
        *) [ -z "$lc" ] || die 1 ERR_INVALID_ARGUMENT 'list takes one container (usage: ctx store list <container> [--<field>=<value>]... [--json])'; lc=$a ;;
      esac
    done
    [ -n "$lc" ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store list <container> [--<field>=<value>]... [--json]'
    case "$lc" in */*) die 1 ERR_INVALID_ARGUMENT "list takes a container, not a path ('$(store_lib_escape "$lc")')" ;; esac
    split_path "$lc"
    if [ "$PC" != containers ]; then
      [ "$dropped" = 0 ] || die 1 ERR_INVALID_ARGUMENT '--dropped lists the dropped containers: list containers --dropped'
      live_for_read
      while IFS='	' read -r lf lv; do
        [ -n "$lv" ] || die 1 ERR_INVALID_ARGUMENT "field '$lf': an empty filter value"
        [ "$lf" = ref ] && continue
        case $(filter_check "$lf" "$lv") in
          undeclared) die 1 ERR_INVALID_ARGUMENT "field '$lf' is not declared in container '$PC'" ;;
          block) die 1 ERR_INVALID_ARGUMENT "field '$lf' is a block field: a filter takes line fields (search finds block text)" ;;
          set\ *) die 1 ERR_INVALID_ARGUMENT "field '$lf': '$lv' is not one of $(filter_check "$lf" "$lv" | sed 's/^set //')" ;;
        esac
      done < "$SCR/filters"
      read_all "$PC/" > "$SCR/keys"
      [ "$json" = 1 ] && printf '{"container":"%s","records":[' "$PC"
      first=1
      count=0
      n=0
      while IFS= read -r k; do
        n=$((n + 1))
        effective "$SCR/r.$n" "$SCR/r.$n.eff"
        REC_FILE=$SCR/filters REC_MODE=match awk -f "$REC_AWK" < "$SCR/r.$n.eff" || continue
        count=$((count + 1))
        id=${k#"$PC"/}
        if [ "$json" = 1 ]; then
          [ "$first" = 1 ] || printf ','
          first=0
          printf '{"id":"%s","address":"store#%s/%s","record":' "$id" "$PC" "$id"
          rec json "$(list_names)" < "$SCR/r.$n.eff"
          printf '}'
        else
          rec text "$id" < "$SCR/r.$n.eff"
        fi
      done < "$SCR/keys"
      [ "$json" = 1 ] && printf '],"total":%s}\n' "$count"
      exit 0
    fi
    [ -s "$SCR/filters" ] && die 1 ERR_INVALID_ARGUMENT 'list containers takes no field filter'
    keys containers/ > "$SCR/keys"
    : > "$SCR/targets"
    n=0
    while IFS= read -r k; do
      n=$((n + 1))
      printf '%s\t%s\n' "$k" "$SCR/r.$n" >> "$SCR/targets"
    done < "$SCR/keys"
    [ "$n" -eq 0 ] || lib_or_die store_get_into "$SCR/targets" > /dev/null
    first=1
    [ "$json" = 1 ] && printf '{"container":"containers","records":['
    count=0
    n=0
    while IFS= read -r k; do
      n=$((n + 1))
      name=${k#containers/}
      st=$(rec values state < "$SCR/r.$n")
      if [ "$dropped" = 1 ]; then [ "$st" = dropped ] || continue; else [ "$st" != dropped ] || continue; fi
      count=$((count + 1))
      if [ "$json" = 1 ]; then
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"id":"%s","address":"store#containers/%s","record":' "$name" "$name"
        rec json 'fields retired' < "$SCR/r.$n"
        printf '}'
      else
        rec keep 'description minting' < "$SCR/r.$n" | rec text "$name"
      fi
    done < "$SCR/keys"
    [ "$json" = 1 ] && printf '],"total":%s}\n' "$count"
    exit 0
    ;;
  put)
    [ $# -ge 1 ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store put <container>/<id> | <container> [--<field>=<value>]... [--add-<field>=<item>]... [--unset=<field>]... [--stdin=<field>]'
    pp=$1
    shift
    case "$pp" in -*) die 1 ERR_INVALID_ARGUMENT 'put takes the path first (usage: ctx store put <container>/<id> | <container> [flags])' ;; esac
    parse_writes "$@"
    split_path "$pp"
    if [ "$PC" = containers ]; then
      [ -n "$PI" ] || die 1 ERR_INVALID_ARGUMENT 'put containers/<name> declares a container'
      [ "$PI" != containers ] || die 1 ERR_INVALID_ARGUMENT "'containers' is the store's reserved container name"
      lib_or_die lib_lock
      decl_load "$PI"
      [ "$DSTATE" != live ] || die 1 ERR_ENTITY_EXISTS "container '$PI' is already declared (set containers/$PI changes it)"
      system_names_refused retired state
      : > "$SCR/empty"
      lib_or_die fields_apply "$SCR/containers.decl" "$SCR/empty" "$SCR/acts" "$SCR/new"
      decl_fields_check "$SCR/new"
      rec keep retired < "$SCR/d.rec" > "$SCR/sys"
      REC_FILE=$SCR/sys REC_MODE=insert REC_ARG='description minting fields' awk -f "$REC_AWK" < "$SCR/new" > "$SCR/new.rec"
      lib_or_die store_put "containers/$PI" < "$SCR/new.rec" > /dev/null
      printf '%s\n' "$PI"
      exit 0
    fi
    lib_or_die lib_lock
    live_for_write
    if [ "$DMINT" = generated ]; then
      [ -z "$PI" ] || die 1 ERR_INVALID_ARGUMENT "container '$PC' mints its ids (generated): put $PC takes no id"
      mint
    else
      [ -n "$PI" ] || die 1 ERR_INVALID_ARGUMENT "container '$PC' takes given ids: put $PC/<id>"
      id_shape
      id_free "$PI"
    fi
    split_refs
    : > "$SCR/empty"
    lib_or_die fields_apply "$SCR/d.fields" "$SCR/empty" "$SCR/acts" "$SCR/new"
    apply_refs "$SCR/empty" "$SCR/new.refs"
    compose "$SCR/new" "$SCR/new.refs" "$SCR/new.rec"
    lib_or_die store_put "$PC/$PI" < "$SCR/new.rec" > /dev/null
    printf '%s\n' "$PI"
    exit 0
    ;;
  set)
    [ $# -ge 1 ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store set <container>/<id> [--<field>=<value>]... [--add-<field>=<item>]... [--remove-<field>=<item>]... [--unset=<field>]... [--stdin=<field>]'
    sp=$1
    shift
    case "$sp" in -*) die 1 ERR_INVALID_ARGUMENT 'set takes the path first (usage: ctx store set <container>/<id> [flags])' ;; esac
    parse_writes "$@"
    [ -s "$SCR/acts" ] || die 1 ERR_INVALID_ARGUMENT 'set takes at least one field flag'
    split_path "$sp"
    [ -n "$PI" ] || die 1 ERR_INVALID_ARGUMENT "set changes one entity: <container>/<id>"
    if [ "$PC" = containers ]; then
      lib_or_die lib_lock
      decl_load "$PI"
      [ "$DSTATE" != absent ] || die 1 ERR_ENTITY_NOT_FOUND "container '$PI' is not declared"
      [ "$DSTATE" != dropped ] || die 1 ERR_ENTITY_NOT_FOUND "container '$PI' is dropped (put containers/$PI declares it again)"
      system_names_refused retired state
      rec strip 'retired state' < "$SCR/d.rec" > "$SCR/old.core"
      lib_or_die fields_apply "$SCR/containers.decl" "$SCR/old.core" "$SCR/acts" "$SCR/new"
      decl_fields_check "$SCR/new"
      rec keep 'retired state' < "$SCR/d.rec" > "$SCR/sys"
      REC_FILE=$SCR/sys REC_MODE=insert REC_ARG='description minting fields' awk -f "$REC_AWK" < "$SCR/new" > "$SCR/new.rec"
      lib_or_die store_put "containers/$PI" < "$SCR/new.rec" > /dev/null
      printf '%s\n' "$PI"
      exit 0
    fi
    lib_or_die lib_lock
    live_for_write
    id_shape
    fetch "$PC/$PI" "$SCR/old" || record_missing
    split_refs
    rec strip ref < "$SCR/old" > "$SCR/old.core"
    rec values ref < "$SCR/old" > "$SCR/old.refs"
    lib_or_die fields_apply "$SCR/d.fields" "$SCR/old.core" "$SCR/acts" "$SCR/new"
    apply_refs "$SCR/old.refs" "$SCR/new.refs"
    compose "$SCR/new" "$SCR/new.refs" "$SCR/new.rec"
    lib_or_die store_put "$PC/$PI" < "$SCR/new.rec" > /dev/null
    printf '%s\n' "$PI"
    exit 0
    ;;
  delete)
    [ $# -eq 1 ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store delete <container>/<id>'
    case "$1" in -*) die 1 ERR_INVALID_ARGUMENT 'usage: ctx store delete <container>/<id>' ;; esac
    split_path "$1"
    [ -n "$PI" ] || die 1 ERR_INVALID_ARGUMENT "delete removes one entity: <container>/<id>"
    if [ "$PC" = containers ]; then
      lib_or_die lib_lock
      PC=$PI
      decl_load "$PC"
      [ "$DSTATE" != absent ] || die 1 ERR_ENTITY_NOT_FOUND "container '$PC' is not declared"
      [ "$DSTATE" != dropped ] || die 1 ERR_ENTITY_NOT_FOUND "container '$PC' is already dropped"
      keys "$PC/" > "$SCR/drop.keys"
      sed "s|^$PC/\\(.*\\)\$|retired: \"\\1\"|" "$SCR/drop.keys" > "$SCR/ret.new"
      retire_into "$SCR/ret.new" "$SCR/d.new"
      printf 'state: "dropped"\n' >> "$SCR/d.new"
      {
        while IFS= read -r dk; do printf 'action=delete\nkey=%s\n' "$dk"; done < "$SCR/drop.keys"
        printf 'action=put\nkey=containers/%s\nvalue_b64=%s\n' "$PC" "$("$CORE/store-b64" "$SCR/d.new")"
      } > "$SCR/batch"
      lib_or_die store_batch < "$SCR/batch" > /dev/null
      printf '%s\n' "$PC"
      exit 0
    fi
    lib_or_die lib_lock
    live_for_write
    id_shape
    fetch "$PC/$PI" "$SCR/old" || record_missing
    printf 'retired: "%s"\n' "$PI" > "$SCR/ret.new"
    retire_into "$SCR/ret.new" "$SCR/d.new"
    {
      printf 'action=delete\nkey=%s\n' "$PC/$PI"
      printf 'action=put\nkey=containers/%s\nvalue_b64=%s\n' "$PC" "$("$CORE/store-b64" "$SCR/d.new")"
    } > "$SCR/batch"
    lib_or_die store_batch < "$SCR/batch" > /dev/null
    printf '%s\n' "$PI"
    exit 0
    ;;
  search)
    sq=""
    sq_set=0
    s_cont=""
    s_type=""
    s_mode=exact
    s_limit=20
    for a in "$@"; do
      case "$a" in
        --container=*) s_cont=${a#--container=} ;;
        --type=*) s_type=${a#--type=} ;;
        --mode=*) s_mode=${a#--mode=} ;;
        --limit=*) s_limit=${a#--limit=} ;;
        --json) json=1 ;;
        -*) die 1 ERR_INVALID_ARGUMENT "unknown flag '$(store_lib_escape "$a")' (usage: ctx store search \"<query>\" [--container=<c>] [--type=<t>] [--mode=<m>] [--limit=<n>] [--json])" ;;
        *) [ "$sq_set" = 0 ] || die 1 ERR_INVALID_ARGUMENT 'search takes one query'; sq=$a; sq_set=1 ;;
      esac
    done
    [ -n "$sq" ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store search "<query>" [--container=<c>] [--type=<t>] [--mode=<m>] [--limit=<n>] [--json]'
    case "$sq" in *"
"*|*"$(printf '\r')"*) die 1 ERR_INVALID_ARGUMENT 'a query holds no newline or carriage return' ;; esac
    case "$s_limit" in ''|*[!0123456789]*|0*) die 1 ERR_INVALID_ARGUMENT "--limit takes a positive whole number, not '$(store_lib_escape "$s_limit")'" ;; esac
    lib_or_die store_modes --own > "$SCR/modes"
    if ! cut -f 1 "$SCR/modes" | grep -Fqx -- "$s_mode"; then
      [ -n "${CTX_SEARCH_FANOUT:-}" ] || die 1 ERR_INVALID_ARGUMENT "mode '$(store_lib_escape "$s_mode")' cannot answer the store (it answers: $(cut -f 1 "$SCR/modes" | tr '\n' ' ' | sed 's/ $//; s/ /, /g'))"
    fi
    read_all containers/ > "$SCR/ckeys"
    live=""
    n=0
    while IFS= read -r k; do
      n=$((n + 1))
      [ "$(rec values state < "$SCR/r.$n")" = dropped ] || live="$live ${k#containers/}"
    done < "$SCR/ckeys"
    live=${live# }
    allow=$live
    for s_narrow in "$s_cont" "$s_type"; do
      [ -n "$s_narrow" ] || continue
      if ! printf '%s\n' $live | grep -Fqx -- "$s_narrow"; then
        if [ -n "${CTX_SEARCH_FANOUT:-}" ]; then allow=""; continue; fi
        [ "$s_narrow" = "$s_cont" ] && die 1 ERR_INVALID_ARGUMENT "container '$(store_lib_escape "$s_narrow")' is not a live container (live: $(lvl))"
        die 1 ERR_INVALID_ARGUMENT "type '$(store_lib_escape "$s_narrow")' names no live container (the store's types are its containers: $(lvl))"
      fi
      printf '%s\n' $allow | grep -Fqx -- "$s_narrow" && allow=$s_narrow || allow=""
    done
    if [ -n "$allow" ]; then
      lib_or_die store_search "$sq" exact 0 > "$SCR/search.json"
      awk -f "$CORE/json.awk" < "$SCR/search.json" > "$SCR/search.flat" || die 2 ERR_STORAGE_READ 'the storage layer answered a malformed search'
    else
      : > "$SCR/search.flat"
    fi
    fmt=text
    [ "$json" = 1 ] && fmt=json
    ROWS_ALLOW=$allow ROWS_LIMIT=$s_limit ROWS_QUERY=$sq ROWS_FORMAT=$fmt REC_MODE=rows awk -f "$REC_AWK" < "$SCR/search.flat"
    exit 0
    ;;
  check)
    [ $# -eq 1 ] || die 1 ERR_INVALID_ARGUMENT 'usage: ctx store check <container> | --leftovers'
    if [ "$1" = --leftovers ]; then
      # what the store's own storage holds beyond its records' keys, through the storage
      # layer's read only probe and its one text form: one line per root and kind, rc 1
      # when any prints, nothing and rc 0 when nothing lies beyond the keys
      lib_or_die store_leftovers < /dev/null > "$SCR/leftovers"
      lib_or_die store_leftovers_text "$SCR/leftovers" kinds > "$SCR/leftovers.text"
      cat "$SCR/leftovers.text"
      [ -s "$SCR/leftovers.text" ] && exit 1
      exit 0
    fi
    case "$1" in -*|*/*) die 1 ERR_INVALID_ARGUMENT 'usage: ctx store check <container> | --leftovers' ;; esac
    split_path "$1"
    [ "$PC" != containers ] || die 1 ERR_INVALID_ARGUMENT 'check reads a declared container; the containers container has its fixed schema'
    live_for_read
    read_all "$PC/" > "$SCR/keys"
    bad=0
    n=0
    while IFS= read -r k; do
      n=$((n + 1))
      rec strip ref < "$SCR/r.$n" > "$SCR/r.$n.core"
      fields_conforms "$SCR/d.fields" "$SCR/r.$n.core" > "$SCR/r.$n.check" 2> "$SCR/err"
      ck_rc=$?
      if [ -s "$SCR/err" ]; then
        reframe
        exit "$ck_rc"
      fi
      [ "$ck_rc" -eq 0 ] && continue
      bad=1
      sed "s|^|$k: |" "$SCR/r.$n.check"
    done < "$SCR/keys"
    exit "$bad"
    ;;
  *)
    die 1 ERR_INVALID_ARGUMENT "unknown verb '$(store_lib_escape "$verb")'"
    ;;
esac
