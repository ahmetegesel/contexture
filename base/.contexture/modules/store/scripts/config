#!/bin/sh
# summary: inspect and update storage configuration (load, get, set, unset, schema)
# usage: ctx store config <subcommand> [args...]
# help: subcommands:
# help:   load [--json]         show effective storage configuration
# help:   get <key>             read one storage setting by local key name
# help:   set <key> <value>     validate and write one storage setting to the workspace configuration
# help:   unset <key>           remove one storage setting from the workspace configuration
# help:   schema [--json]       show declared storage schema keys, types, defaults, and descriptions
# help:   help [<subcommand>]   show help for a storage configuration subcommand
# help: the driver belongs to the driver package lifecycle: set and unset of driver refuse, naming ctx package install and ctx package uninstall (an unset lands only while the configured driver resolves nothing); an installed driver package's setting refuses a change while its driver holds data or while the storage is being moved
# help: example: ctx store config get driver

if [ -z "${CTX_ROOT:-}" ]; then
  printf 'store config: error: run this module through ctx (CTX_ROOT is not set) (ERR_INVALID_ARGUMENT)\n' >&2
  exit 2
fi

CFG_LIB="$CTX_ROOT/.contexture/config-lib"
if [ ! -f "$CFG_LIB" ]; then
  printf 'store config: error: the internal config library is not installed (ERR_DRIVER_NOT_FOUND)\n' >&2
  exit 2
fi
. "$CFG_LIB"

config_owner_verb storage 'ctx store config' cfg_validate_storage_driver "$@"
