task_drop() {
  unit="${1:-}"
  slug="${2:-}"
  reason="${3:-Deprecating task}"
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'task.drop: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.drop: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! block_has "$backlog" task "$slug"; then
    printf "task.drop: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  acquire_lock "$unit" || return 2
  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  tmp_j=$(mktemp "$tmp_d/journal.XXXXXX")

  awk -v target="$slug" '
    BEGIN { in_target = 0; }
    /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      in_target = (line == target);
      if (!in_target) print $0;
      next;
    }
    {
      if (!in_target) print $0;
    }
  ' "$backlog" > "$tmp_b"

  today=$(date +%Y-%m-%d)
  cur_anc=$(grep '^current_anchor:' "$s_dir/state.md" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"
  receipt_slug="$today-$slug-dropped"
  # the canonical drop receipt (the record grammar): backlog/<slug>: DROPPED (<reason>)
  receipt_what="backlog/$slug: DROPPED ($reason)"

  cat "$s_dir/journal.md" > "$tmp_j"
  printf '\n@entry %s\n  ANCHOR: %s\n  WHAT: "%s"\n  THREAD: none\n' "$receipt_slug" "$cur_anc" "$receipt_what" >> "$tmp_j"

  commit_mv "$tmp_b" "$backlog" || { rm -f "$tmp_j"; release_lock "$unit"; return 2; }
  commit_mv "$tmp_j" "$s_dir/journal.md" || { release_lock "$unit"; return 2; }
  release_lock "$unit"

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  printf '{"status":"DROPPED","unit":"%s","task_slug":"%s"}\n' "$esc_unit" "$esc_slug"
  return 0
}

task_list() {
  unit="${1:-}"
  status_filter="${2:-}"
  if [ -z "$unit" ]; then
    printf 'task.list: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.list: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  awk -v unit="$unit" -v filter="$status_filter" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN {
      count = 0; cur_slug = ""; cur_status = "TODO"; cur_obj = "";
    }
    function flush() {
      if (cur_slug == "") return;
      if (filter == "" || filter == "all" || tolower(cur_status) == tolower(filter)) {
        count++; s[count] = cur_slug; st[count] = cur_status; obj[count] = cur_obj;
      }
      cur_slug = ""; cur_status = "TODO"; cur_obj = "";
    }
    /^@task[ ]+/ {
      flush();
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_slug = line;
      next;
    }
    /^[ ]{2}STATUS:[ ]*/ {
      v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      cur_status = v;
      next;
    }
    /^[ ]{2}OBJECTIVE:[ ]*/ {
      v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      cur_obj = v;
      next;
    }
    END {
      flush();
      printf "{\"unit\":\"%s\",\"tasks\":[", escape_json(unit);
      for (i = 1; i <= count; i++) {
        printf "{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\"}", escape_json(s[i]), escape_json(st[i]), escape_json(obj[i]);
        if (i < count) printf ",";
      }
      printf "]}\n";
    }
  ' "$s_dir/backlog.md"
  return 0
}

task_show() {
  unit="${1:-}"
  slug="${2:-}"
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'task.show: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.show: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! block_has "$backlog" task "$slug"; then
    printf "task.show: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  awk -v unit="$unit" -v target="$slug" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    function refs_arr(v,   n, w, i, out) {
      sub(/^[ \t]*\[/, "", v); sub(/\][ \t]*$/, "", v); gsub(/,/, " ", v)
      n = split(v, w, /[ \t]+/); out = ""
      for (i = 1; i <= n; i++) if (w[i] != "") out = out (out == "" ? "" : ",") "\"" escape_json(w[i]) "\""
      return "[" out "]"
    }
    BEGIN { found = 0; in_target = 0; in_scalar = ""; status = "TODO"; obj = ""; desc = ""; crit = ""; det = ""; refs = ""; }
    /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == target) {
        found = 1; in_target = 1;
      } else {
        in_target = 0;
      }
      next;
    }
    in_target && /^[ ]{2}STATUS:[ ]*/ {
      in_scalar = ""; v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      status = v; next;
    }
    in_target && /^[ ]{2}OBJECTIVE:[ ]*/ {
      in_scalar = ""; v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      obj = v; next;
    }
    in_target && /^[ ]{2}REFS:[ ]*/ {
      in_scalar = ""; v = $0; sub(/^[ ]{2}REFS:[ ]*/, "", v); refs = v; next;
    }
    in_target && /^[ ]{2}DESCRIPTION ::/ { in_scalar = "desc"; next; }
    in_target && /^[ ]{2}ACCEPTANCE CRITERIA ::/ { in_scalar = "crit"; next; }
    in_target && /^[ ]{2}IMPLEMENTATION DETAILS ::/ { in_scalar = "det"; next; }
    in_target && in_scalar != "" && /^[ ]{4}/ {
      line = substr($0, 5);
      if (in_scalar == "desc") desc = (desc == "" ? line : desc "\n" line);
      else if (in_scalar == "crit") crit = (crit == "" ? line : crit "\n" line);
      else if (in_scalar == "det") det = (det == "" ? line : det "\n" line);
      next;
    }
    in_target && /^[ \t]*$/ { in_scalar = ""; }
    END {
      if (!found) exit 1;
      printf "{\"unit\":\"%s\",\"task\":{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\",\"description\":\"%s\",\"criteria\":\"%s\",\"details\":\"%s\",\"refs\":%s}}\n",
        escape_json(unit), escape_json(target), escape_json(status), escape_json(obj), escape_json(desc), escape_json(crit), escape_json(det), refs_arr(refs);
    }
  ' "$backlog"
  return $?
}

entry_record() {
  unit="${1:-}"
  slug="${2:-}"
  what="${3:-}"
  group="${4:-}"
  thread="${5:-none}"
  closes="${6:-}"
  ref="${7:-}"
  if [ -z "$unit" ] || [ -z "$slug" ] || [ -z "$what" ]; then
    printf 'entry.record: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "entry.record: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  cur_anc=$(grep '^current_anchor:' "$s_dir/state.md" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"

  journal="$s_dir/journal.md"
  # a new slug only: the journal is append-only history, a repeat is refused
  if awk -v s="$slug" '$1 == "@entry" && $2 == s { found = 1 } END { exit !found }' "$journal" 2>/dev/null; then
    printf "entry.record: error: entry '%s' already exists in session '%s' (ERR_ENTITY_EXISTS)\n" "$slug" "$unit" >&2
    return 1
  fi
  tmp_d=$(get_tmp_dir)
  tmp_j=$(mktemp "$tmp_d/journal.XXXXXX")
  cat "$journal" > "$tmp_j"

  printf '\n@entry %s\n' "$slug" >> "$tmp_j"
  printf '  ANCHOR: %s\n' "$cur_anc" >> "$tmp_j"
  printf '  WHAT: "%s"\n' "$what" >> "$tmp_j"
  [ -n "$group" ] && printf '  GROUP: %s\n' "$group" >> "$tmp_j"
  [ -n "$thread" ] && printf '  THREAD: %s\n' "$thread" >> "$tmp_j"
  # the record order: GROUP, THREAD, REF, CLOSES
  [ -n "$ref" ] && printf '  REF: "%s"\n' "$ref" >> "$tmp_j"
  # a value carrying its own verdict stands verbatim; a bare target list is done by this entry
  case "$closes" in
    "") ;;
    *"("*) printf '  CLOSES: %s\n' "$closes" >> "$tmp_j" ;;
    *) printf '  CLOSES: %s (done: %s)\n' "$closes" "$what" >> "$tmp_j" ;;
  esac

  commit_mv "$tmp_j" "$journal" || return 2

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  esc_anc=$(escape_json "$cur_anc")
  esc_what=$(escape_json "$what")
  esc_group=$(escape_json "$group")
  esc_th=$(escape_json "$thread")
  esc_ref=$(escape_json "$ref")
  # the echo carries ref after thread, as entry.show does (empty when absent)
  printf '{"unit":"%s","entry":{"slug":"%s","anchor":"%s","what":"%s","group":"%s","thread":"%s","ref":"%s"}}\n' \
    "$esc_unit" "$esc_slug" "$esc_anc" "$esc_what" "$esc_group" "$esc_th" "$esc_ref"
  return 0
}

entry_show() {
  unit="${1:-}"
  slug="${2:-}"
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'entry.show: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "entry.show: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  journal="$s_dir/journal.md"
  if ! block_has "$journal" entry "$slug"; then
    printf "entry.show: error: entry '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  awk -v unit="$unit" -v target="$slug" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN {
      found = 0; in_target = 0; anchor = ""; what = ""; group = ""; thread = ""; ref = "";
      closed = 0; closed_by = ""; close_reason = "";
      cur_entry = "";
    }
    /^@entry[ ]+/ {
      line = $0; sub(/^@entry[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_entry = line;
      if (cur_entry == target) {
        # a legacy journal may repeat the slug: the last occurrence is reported, and
        # only a closer standing after it closes it
        found = 1; in_target = 1;
        anchor = ""; what = ""; group = ""; thread = ""; ref = "";
        closed = 0; closed_by = ""; close_reason = "";
      } else {
        in_target = 0;
      }
      next;
    }
    in_target && /^[ ]{2}ANCHOR:[ ]*/ {
      v = $0; sub(/^[ ]{2}ANCHOR:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      anchor = v; next;
    }
    in_target && /^[ ]{2}WHAT:[ ]*/ {
      v = $0; sub(/^[ ]{2}WHAT:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      what = v; next;
    }
    in_target && /^[ ]{2}GROUP:[ ]*/ {
      v = $0; sub(/^[ ]{2}GROUP:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      group = v; next;
    }
    in_target && /^[ ]{2}THREAD:[ ]*/ {
      v = $0; sub(/^[ ]{2}THREAD:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      thread = v; next;
    }
    in_target && /^[ ]{2}REF:[ ]*/ {
      v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      ref = v; next;
    }
    /^[ ]{2}(CLOSES|SUPERSEDES):[ ]*/ {
      line = $0; sub(/^[ ]{2}(CLOSES|SUPERSEDES):[ ]*/, "", line);
      t = line; sub(/[ \t]+-[ \t]+.*$/, "", t); sub(/[ \t]+\(.*$/, "", t);
      hit = 0; nw = split(t, cw, /[ \t]+/);
      for (wi = 1; wi <= nw; wi++) if (cw[wi] == target && cw[wi] ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[a-zA-Z0-9_-]+[a-zA-Z0-9]$/) hit = 1;
      if (hit && !closed) {
        closed = 1;
        closed_by = cur_entry;
        reason = line;
        if (sub(/^[^()]*\(/, "", reason)) sub(/\)[^)]*$/, "", reason);
        close_reason = reason;
      }
      next;
    }
    END {
      if (!found) exit 1;
      printf "{\"unit\":\"%s\",\"entry\":{\"slug\":\"%s\",\"anchor\":\"%s\",\"what\":\"%s\",\"group\":\"%s\",\"thread\":\"%s\",\"ref\":\"%s\"},\"is_closed\":%s,\"closed_by\":\"%s\",\"close_reason\":\"%s\"}\n",
        escape_json(unit), escape_json(target), escape_json(anchor), escape_json(what), escape_json(group), escape_json(thread), escape_json(ref),
        (closed ? "true" : "false"), escape_json(closed_by), escape_json(close_reason);
    }
  ' "$journal"
  return $?
}

entry_list() {
  unit="${1:-}"
  el_anchor=""
  el_group=""
  [ $# -gt 0 ] && shift
  for el_a in "$@"; do
    case "$el_a" in
      --anchor=*) el_anchor="${el_a#--anchor=}" ;;
      --group=*) el_group="${el_a#--group=}" ;;
      *) printf "entry.list: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$el_a" >&2; return 1 ;;
    esac
  done
  if [ -z "$unit" ]; then
    printf 'entry.list: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "entry.list: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  journal="$s_dir/journal.md"
  # --anchor and --group keep only the entries whose ANCHOR and GROUP match exactly
  awk -v unit="$unit" -v fa="$el_anchor" -v fg="$el_group" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN { count = 0; cur_slug = ""; cur_anc = ""; cur_what = ""; cur_grp = ""; }
    function flush() {
      if (cur_slug == "") return;
      if ((fa == "" || cur_anc == fa) && (fg == "" || cur_grp == fg)) {
        count++; s[count] = cur_slug; anc[count] = cur_anc; what[count] = cur_what;
      }
      cur_slug = ""; cur_anc = ""; cur_what = ""; cur_grp = "";
    }
    /^[ ]{2}GROUP:[ ]*/ {
      v = $0; sub(/^[ ]{2}GROUP:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (cur_slug != "") cur_grp = v; next;
    }
    /^@anchor[ ]+/ { flush(); next; }
    /^@entry[ ]+/ {
      flush();
      line = $0; sub(/^@entry[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_slug = line; next;
    }
    /^[ ]{2}ANCHOR:[ ]*/ {
      v = $0; sub(/^[ ]{2}ANCHOR:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      cur_anc = v; next;
    }
    /^[ ]{2}WHAT:[ ]*/ {
      v = $0; sub(/^[ ]{2}WHAT:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      cur_what = v; next;
    }
    END {
      flush();
      printf "{\"unit\":\"%s\",\"entries\":[", escape_json(unit);
      for (i = 1; i <= count; i++) {
        printf "{\"slug\":\"%s\",\"anchor\":\"%s\",\"what\":\"%s\"}", escape_json(s[i]), escape_json(anc[i]), escape_json(what[i]);
        if (i < count) printf ",";
      }
      printf "]}\n";
    }
  ' "$journal"
  return 0
}

