      next;
    }
    { print $0; }
  ' "$backlog" > "$tmp_b"

  today=$(date +%Y-%m-%d)
  cur_anc=$(grep '^current_anchor:' "$s_dir/state.md" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"
  receipt_slug="$today-$slug-completed"
  receipt_what="backlog/$slug: DONE ($evidence)"

  cat "$s_dir/journal.md" > "$tmp_j"
  printf '\n@entry %s\n  ANCHOR: %s\n  WHAT: "%s"\n  THREAD: none\n' "$receipt_slug" "$cur_anc" "$receipt_what" >> "$tmp_j"

