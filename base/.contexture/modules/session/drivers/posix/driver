finding_add() {
  unit="${1:-}"
  name="${2:-}"
  summary="${3:-}"
  ref="${4:-}"
  supersedes="${5:-}"
  if [ -z "$unit" ] || [ -z "$name" ] || [ -z "$summary" ]; then
    printf 'finding.add: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "finding.add: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  knowledge="$s_dir/knowledge.md"
  # a NAME the knowledge already carries is refused: a replacement is a new finding
  # that supersedes it (finding.supersede), never a second block under one NAME
  if block_has "$knowledge" finding "$name"; then
    printf "finding.add: error: finding '%s' already exists in session '%s' (ERR_ENTITY_EXISTS)\n" "$name" "$unit" >&2
    return 1
  fi
  if [ -n "$supersedes" ] && ! block_has "$knowledge" finding "$supersedes"; then
    printf "finding.add: error: superseded finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$supersedes" "$unit" >&2
    return 1
  fi
  # free text through the environment (serialize_blocks.awk); a failed render never lands
  if ! block=$(SB_SUMMARY="$summary" SB_REF="$ref" SB_SUPERSEDES="$supersedes" \
    awk -v block_type="finding" -v name="$name" -f "$SCRIPT_DIR/serialize_blocks.awk") || [ -z "$block" ]; then
    printf "finding.add: error: rendering finding '%s' failed, nothing written (ERR_STORAGE_WRITE)\n" "$name" >&2
    return 2
  fi

  tmp_d=$(get_tmp_dir)
  tmp_k=$(mktemp "$tmp_d/knowledge.XXXXXX")
  cat "$knowledge" > "$tmp_k"
  printf '\n%s\n' "$block" >> "$tmp_k"
  commit_mv "$tmp_k" "$knowledge" || return 2

  esc_unit=$(escape_json "$unit")
  esc_name=$(escape_json "$name")
  esc_sum=$(escape_json "$summary")
  esc_ref=$(escape_json "$ref")
  esc_sup=$(escape_json "$supersedes")
  printf '{"unit":"%s","finding":{"name":"%s","summary":"%s","ref":"%s","supersedes":"%s"}}\n' \
    "$esc_unit" "$esc_name" "$esc_sum" "$esc_ref" "$esc_sup"
  return 0
}

finding_update() {
  unit="${1:-}"
  name="${2:-}"
  new_sum="${3:-}"
  new_ref="${4:-}"
  if [ -z "$unit" ] || [ -z "$name" ]; then
    printf 'finding.update: error: missing required arguments (unit, name) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  knowledge="$s_dir/knowledge.md"
  if [ ! -d "$s_dir" ] || [ ! -f "$knowledge" ]; then
    printf "finding.update: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  if ! block_has "$knowledge" finding "$name"; then
    printf "finding.update: error: finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$name" "$unit" >&2
    return 1
  fi
  tmp_d=$(get_tmp_dir)
  tmp_k=$(mktemp "$tmp_d/knowledge.XXXXXX")
  # the SUMMARY body and the REF line are replaced in place when given; a REF given for a
  # finding that carries none lands after the block body (the serializer order): at the
  # first column-0 line after the target or at EOF, before the blank separator, so the
  # short blank lines met inside the target are held (verbatim) until that point is known
  # free text through the environment: -v would interpret backslash escapes and refuse a newline
  FU_SUM="$new_sum" FU_REF="$new_ref" awk -v target="$name" '
    function indent_lines(text, prefix,    lines, n, i, r) {
      n = split(text, lines, "\n"); r = "";
      for (i = 1; i <= n; i++) { r = r prefix lines[i]; if (i < n) r = r "\n"; }
      return r;
    }
    function add_ref() {
      if (new_ref != "" && !ref_seen) printf "  REF: \"%s\"\n", new_ref;
      ref_done = 1;
    }
    function flush_held(   i) {
      for (i = 1; i <= held; i++) print hl[i];
      if (held > 0) skip_scalar = 0;
      held = 0;
    }
    BEGIN { new_sum = ENVIRON["FU_SUM"]; new_ref = ENVIRON["FU_REF"]; in_target = 0; skip_scalar = 0; found = 0; ref_seen = 0; ref_done = 1; held = 0; }
    in_target && !ref_done && /^[ \t]*$/ && !/^[ ]{4}/ { hl[++held] = $0; next; }
    in_target && !ref_done && /^[^ \t]/ { add_ref(); }
    { flush_held(); }
    /^@finding[ ]+/ {
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == target) {
        found = 1; in_target = 1; ref_seen = 0; ref_done = 0;
        print $0;
        next;
      } else in_target = 0;
    }
    in_target && /^[ ]{2}SUMMARY ::/ {
      if (new_sum != "") {
        printf "  SUMMARY ::\n%s\n", indent_lines(new_sum, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && /^[ ]{2}REF:[ ]*/ {
      ref_seen = 1;
      if (new_ref != "") {
        printf "  REF: \"%s\"\n", new_ref;
        next;
      }
    }
    in_target && skip_scalar && /^[ ]{4}/ { next; }
    {
      if ($0 !~ /^[ ]{4}/) skip_scalar = 0;
      print $0;
    }
    END {
      if (in_target && !ref_done) add_ref();
      flush_held();
      if (!found) exit 1;
    }
  ' "$knowledge" > "$tmp_k"
  if [ $? -ne 0 ]; then
    rm -f "$tmp_k"
    printf "finding.update: error: finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$name" "$unit" >&2
    return 1
  fi
  commit_mv "$tmp_k" "$knowledge" || return 2
  printf '{"status":"ok","unit":"%s","finding":{"name":"%s"}}\n' "$(escape_json "$unit")" "$(escape_json "$name")"
  return 0
}

finding_supersede() {
  unit="${1:-}"
  old_name="${2:-}"
  new_name="${3:-}"
  summary="${4:-}"
  ref="${5:-}"
  if [ -z "$unit" ] || [ -z "$old_name" ] || [ -z "$new_name" ] || [ -z "$summary" ]; then
    printf 'finding.supersede: error: missing required arguments (unit, predecessor, successor, summary) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  knowledge="$s_dir/knowledge.md"
  if [ ! -d "$s_dir" ]; then
    printf "finding.supersede: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  if ! block_has "$knowledge" finding "$old_name"; then
    printf "finding.supersede: error: finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$old_name" "$unit" >&2
    return 1
  fi
  finding_add "$unit" "$new_name" "$summary" "$ref" "$old_name" > /dev/null || return $?
  printf '{"status":"ok","unit":"%s","superseded":"%s","successor":"%s"}\n' "$(escape_json "$unit")" "$(escape_json "$old_name")" "$(escape_json "$new_name")"
  return 0
}

finding_drop() {
  unit="${1:-}"
  name="${2:-}"
  if [ -z "$unit" ] || [ -z "$name" ]; then
    printf 'finding.drop: error: missing required arguments (unit, name) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  knowledge="$s_dir/knowledge.md"
  if [ ! -d "$s_dir" ] || [ ! -f "$knowledge" ]; then
    printf "finding.drop: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  if ! block_has "$knowledge" finding "$name"; then
    printf "finding.drop: error: finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$name" "$unit" >&2
    return 1
  fi
  tmp_d=$(get_tmp_dir)
  tmp_k=$(mktemp "$tmp_d/knowledge.XXXXXX")
  # the block runs from its @finding line to the line before the next column-0 block
  awk -v target="$name" '
    BEGIN { in_target = 0; found = 0; }
    /^@finding[ ]+/ {
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == target) {
        found = 1; in_target = 1;
        next;
      } else in_target = 0;
    }
    in_target && /^@[A-Za-z]/ { in_target = 0; }
    in_target { next; }
    { print $0; }
    END { if (!found) exit 1; }
  ' "$knowledge" > "$tmp_k"
  if [ $? -ne 0 ]; then
    rm -f "$tmp_k"
    printf "finding.drop: error: finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$name" "$unit" >&2
    return 1
  fi
  commit_mv "$tmp_k" "$knowledge" || return 2
  printf '{"status":"DROPPED","unit":"%s","name":"%s"}\n' "$(escape_json "$unit")" "$(escape_json "$name")"
  return 0
}

finding_show() {
  unit="${1:-}"
  name="${2:-}"
  if [ -z "$unit" ] || [ -z "$name" ]; then
    printf 'finding.show: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "finding.show: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  knowledge="$s_dir/knowledge.md"
  if ! block_has "$knowledge" finding "$name"; then
    printf "finding.show: error: finding '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$name" "$unit" >&2
    return 1
  fi

  awk -v unit="$unit" -v target="$name" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN { found = 0; in_target = 0; in_summary = 0; summary = ""; ref = ""; superseded_by = ""; cur_finding = ""; }
    /^@finding[ ]+/ {
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_finding = line;
      if (cur_finding == target) {
        found = 1; in_target = 1;
      } else {
        in_target = 0;
      }
      next;
    }
    in_target && /^[ ]{2}REF:[ ]*/ {
      in_summary = 0; v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      ref = v; next;
    }
    in_target && /^[ ]{2}SUMMARY ::/ { in_summary = 1; next; }
    in_target && in_summary && /^[ ]{4}/ {
      line = substr($0, 5);
      summary = (summary == "" ? line : summary "\n" line);
      next;
    }
    /^[ ]{2}SUPERSEDES:[ ]*/ {
      v = $0; sub(/^[ ]{2}SUPERSEDES:[ ]*/, "", v); sub(/[ (].*$/, "", v);
      if (v == target) superseded_by = cur_finding;
      next;
    }
    END {
      if (!found) exit 1;
      printf "{\"unit\":\"%s\",\"finding\":{\"name\":\"%s\",\"summary\":\"%s\",\"ref\":\"%s\",\"superseded_by\":\"%s\"}}\n",
        escape_json(unit), escape_json(target), escape_json(summary), escape_json(ref), escape_json(superseded_by);
    }
  ' "$knowledge"
  return $?
}

finding_list() {
  unit="${1:-}"
  active_only="${2:-}"
  if [ -z "$unit" ]; then
    printf 'finding.list: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "finding.list: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  knowledge="$s_dir/knowledge.md"
  # active_only (the SPI flag, any non-empty value) leaves out every finding a later
  # SUPERSEDES names; empty lists them all
  awk -v unit="$unit" -v active_only="$active_only" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN { count = 0; cur_name = ""; cur_summary = ""; cur_ref = ""; cur_sup = ""; in_summary = 0; }
    function flush() {
      if (cur_name == "") return;
      count++; n[count] = cur_name; sum[count] = cur_summary; rf[count] = cur_ref; sup[count] = cur_sup;
      cur_name = ""; cur_summary = ""; cur_ref = ""; cur_sup = ""; in_summary = 0;
    }
    /^@finding[ ]+/ {
      flush();
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_name = line; next;
    }
    /^[ ]{2}SUPERSEDES:[ ]*/ {
      in_summary = 0; v = $0; sub(/^[ ]{2}SUPERSEDES:[ ]*/, "", v); sub(/[ (].*$/, "", v);
      cur_sup = v; next;
    }
    /^[ ]{2}REF:[ ]*/ {
      in_summary = 0; v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      cur_ref = v; next;
    }
    /^[ ]{2}SUMMARY ::/ { in_summary = 1; next; }
    in_summary && /^[ ]{4}/ {
      line = substr($0, 5);
      cur_summary = (cur_summary == "" ? line : cur_summary "\n" line);
      next;
    }
    END {
      flush();
      printf "{\"unit\":\"%s\",\"findings\":[", escape_json(unit);
      for (i = 1; i <= count; i++) if (sup[i] != "") retired[sup[i]] = 1;
      shown = 0;
      for (i = 1; i <= count; i++) {
        if (active_only != "" && (n[i] in retired)) continue;
        if (shown) printf ",";
        shown = 1;
        printf "{\"name\":\"%s\",\"summary\":\"%s\",\"ref\":\"%s\"", escape_json(n[i]), escape_json(sum[i]), escape_json(rf[i]);
        if (sup[i] != "") printf ",\"supersedes\":\"%s\"", escape_json(sup[i]);
        printf "}";
      }
      printf "]}\n";
    }
  ' "$knowledge"
  return 0
}

lane_create() {
  unit="${1:-}"
  lane="${2:-}"
  goal="${3:-}"
  recipe_body="${4:-}"
  if [ -z "$unit" ] || [ -z "$lane" ] || [ -z "$goal" ]; then
    printf 'lane.create: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "lane.create: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  l_dir="$s_dir/lanes/$lane"
  mkdir -p "$l_dir" || return 2

  if [ -n "$recipe_body" ]; then
    printf '%s\n' "$recipe_body" > "$l_dir/recipe.md"
  else
    cat > "$l_dir/recipe.md" <<EOF
# recipe grammar
blocks at column 0; fields indent 2; tasks indent 4;

@context: "subagent lane: $lane"

MISSION
  GOAL: "$goal"
EOF
  fi

  cat > "$l_dir/journal.md" <<'EOF'
# journal grammar
blocks at column 0; fields indent 2;
EOF

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  printf '{"unit":"%s","lane":"%s","status":"CREATED"}\n' "$esc_unit" "$esc_lane"
  return 0
}

lane_record() {
  unit="${1:-}"
  lane="${2:-}"
  slug="${3:-}"
  what="${4:-}"
  thread="${5:-none}"
  if [ -z "$unit" ] || [ -z "$lane" ] || [ -z "$slug" ] || [ -z "$what" ]; then
    printf 'lane.record: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.record: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  # the lane journal is append-only history: a repeated slug is refused
  if block_has "$l_dir/journal.md" entry "$slug"; then
    printf "lane.record: error: entry '%s' already exists in lane '%s' of session '%s' (ERR_ENTITY_EXISTS)\n" "$slug" "$lane" "$unit" >&2
    return 1
  fi
  if ! printf '\n@entry %s\n  WHAT: "%s"\n  THREAD: %s\n' "$slug" "$what" "$thread" >> "$l_dir/journal.md" 2>/dev/null; then
    printf 'lane.record: error: the storage write of journal.md failed (ERR_STORAGE_WRITE)\n' >&2
    return 2
  fi

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_slug=$(escape_json "$slug")
  esc_what=$(escape_json "$what")
  printf '{"unit":"%s","lane":"%s","entry":{"slug":"%s","what":"%s"}}\n' "$esc_unit" "$esc_lane" "$esc_slug" "$esc_what"
  return 0
}

lane_report() {
  unit="${1:-}"
  lane="${2:-}"
  lr_mode="${3:-}"
  report_body=""
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.report: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.report: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  rep_file="$l_dir/report.md"
  # --write: the report arrives raw on stdin and is stored byte for byte (any size;
  # nothing rides argv); without it the stored report is read back
  case "$lr_mode" in
    --write)
      lr_tmp=$(mktemp "$rep_file.XXXXXX" 2>/dev/null) || { printf 'lane.report: error: cannot stage the report (ERR_STORAGE_WRITE)\n' >&2; return 2; }
      if ! cat > "$lr_tmp" || ! mv "$lr_tmp" "$rep_file"; then
        rm -f "$lr_tmp"
        printf 'lane.report: error: the storage write failed (ERR_STORAGE_WRITE)\n' >&2
        return 2
      fi
      ;;
    "") ;;
    *) printf "lane.report: error: unknown mode '%s' (--write or none) (ERR_INVALID_ARGUMENT)\n" "$lr_mode" >&2; return 1 ;;
  esac
  if [ -f "$rep_file" ]; then
    report_body=$(cat "$rep_file")
  fi

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_rep=$(escape_json "$report_body")
  printf '{"unit":"%s","lane":"%s","report":"%s"}\n' "$esc_unit" "$esc_lane" "$esc_rep"
  return 0
}

lane_show() {
