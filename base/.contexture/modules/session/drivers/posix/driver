  esc_rslug=$(escape_json "$receipt_slug")
  esc_rwhat=$(escape_json "$receipt_what")
  printf '{"status":"DONE","unit":"%s","task_slug":"%s","receipt_entry":{"slug":"%s","what":"%s"}}\n' \
