task_add() {
  unit="${1:-}"
  slug="${2:-}"
  obj="${3:-}"
  desc="${4:-}"
  crit="${5:-}"
  det="${6:-}"
  refs="${7:-}"
  if [ -z "$unit" ] || [ -z "$slug" ] || [ -z "$obj" ]; then
    printf 'task.add: error: missing required arguments (unit, slug, objective) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.add: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if block_has "$backlog" task "$slug"; then
    printf "task.add: error: task '%s' already exists in session '%s' (ERR_ENTITY_EXISTS)\n" "$slug" "$unit" >&2
    return 1
  fi

  # free text through the environment (serialize_blocks.awk): a newline or a backslash
  # sequence reaches the block verbatim; a render that fails never lands
  if ! block=$(SB_OBJECTIVE="$obj" SB_DESC="$desc" SB_CRITERIA="$crit" SB_DETAILS="$det" SB_REFS="$refs" \
    awk -v block_type="task" -v slug="$slug" -v status="TODO" -f "$SCRIPT_DIR/serialize_blocks.awk") || [ -z "$block" ]; then
    printf "task.add: error: rendering task '%s' failed, nothing written (ERR_STORAGE_WRITE)\n" "$slug" >&2
    return 2
  fi

  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  cat "$backlog" > "$tmp_b"
  printf '\n%s\n' "$block" >> "$tmp_b"
  commit_mv "$tmp_b" "$backlog" || return 2

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  esc_obj=$(escape_json "$obj")
  esc_desc=$(escape_json "$desc")
  esc_crit=$(escape_json "$crit")
  esc_det=$(escape_json "$det")
  refs_arr=$(refs_json "$refs")
  printf '{"status":"TODO","unit":"%s","task":{"slug":"%s","status":"TODO","objective":"%s","description":"%s","criteria":"%s","details":"%s","refs":%s}}\n' \
    "$esc_unit" "$esc_slug" "$esc_obj" "$esc_desc" "$esc_crit" "$esc_det" "$refs_arr"
  return 0
}

task_update() {
  unit="${1:-}"
  slug="${2:-}"
  obj="${3:-}"
  desc="${4:-}"
  crit="${5:-}"
  det="${6:-}"
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'task.update: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.update: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! block_has "$backlog" task "$slug"; then
    printf "task.update: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  # a field the block already carries is replaced in place; a field it lacks is inserted
  # at its template position (DESCRIPTION, ACCEPTANCE CRITERIA, IMPLEMENTATION DETAILS)
  # ahead of the first later section, else after the block's last content line
  tu_has=$(awk -v target="$slug" '
    /^@task[ ]+/ { t = $0; sub(/^@task[ ]+/, "", t); sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t); in_t = (t == target); next }
    /^@[A-Za-z]/ { in_t = 0; next }
    in_t && /^[ ]{2}DESCRIPTION ::/ { h1 = 1 }
    in_t && /^[ ]{2}ACCEPTANCE CRITERIA ::/ { h2 = 1 }
    in_t && /^[ ]{2}IMPLEMENTATION DETAILS ::/ { h3 = 1 }
    END { printf "%d%d%d", h1, h2, h3 }' "$backlog")
  # free text through the environment: -v would interpret backslash escapes and refuse a
  # newline, and a failed render must never replace the backlog
  if ! TU_OBJ="$obj" TU_DESC="$desc" TU_CRIT="$crit" TU_DET="$det" awk -v target="$slug" -v has_s="$tu_has" '
    function indent_lines(text, prefix,    lines, n, i, r) {
      n = split(text, lines, "\n"); r = "";
      for (i = 1; i <= n; i++) { r = r prefix lines[i]; if (i < n) r = r "\n"; }
      return r;
    }
    function section(rank) {
      if (rank == 1) return "DESCRIPTION";
      if (rank == 2) return "ACCEPTANCE CRITERIA";
      return "IMPLEMENTATION DETAILS";
    }
    function flush_blanks(   i) { for (i = 1; i <= nblank; i++) print ""; nblank = 0 }
    function emit_missing(upto,   r) {
      for (r = 1; r <= upto; r++) {
        if (want[r] != "" && !has[r] && !done[r]) {
          printf "  %s ::\n%s\n", section(r), indent_lines(want[r], "    ");
          done[r] = 1;
        }
      }
    }
    function task_of(line) { sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line); return line }
    BEGIN {
      new_obj = ENVIRON["TU_OBJ"]; new_desc = ENVIRON["TU_DESC"]; new_crit = ENVIRON["TU_CRIT"]; new_det = ENVIRON["TU_DET"];
      in_target = 0; skip_scalar = 0; nblank = 0;
      want[1] = new_desc; want[2] = new_crit; want[3] = new_det;
      for (r = 1; r <= 3; r++) has[r] = (substr(has_s, r, 1) == "1");
    }
    /^@[A-Za-z]/ && in_target {
      emit_missing(3);
      flush_blanks();
      in_target = 0;
    }
    /^@task[ ]+/ {
      if (task_of($0) == target) {
        in_target = 1;
        printf "@task %s\n", target;
        next;
      } else {
        in_target = 0;
      }
    }
    # an empty line inside the target is held until the next content line, so a missing
    # section lands after the last content line, never after the trailing blank run
    in_target && $0 == "" { skip_scalar = 0; nblank++; next; }
    in_target { flush_blanks(); }
    in_target && /^[ ]{2}ACCEPTANCE CRITERIA ::/ { emit_missing(1); }
    in_target && /^[ ]{2}IMPLEMENTATION DETAILS ::/ { emit_missing(2); }
    in_target && /^[ ]{2}OBJECTIVE:[ ]*/ {
      if (new_obj != "") {
        printf "  OBJECTIVE: \"%s\"\n", new_obj;
        next;
      }
    }
    in_target && /^[ ]{2}DESCRIPTION ::/ {
      if (new_desc != "") {
        printf "  DESCRIPTION ::\n%s\n", indent_lines(new_desc, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && /^[ ]{2}ACCEPTANCE CRITERIA ::/ {
      if (new_crit != "") {
        printf "  ACCEPTANCE CRITERIA ::\n%s\n", indent_lines(new_crit, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && /^[ ]{2}IMPLEMENTATION DETAILS ::/ {
      if (new_det != "") {
        printf "  IMPLEMENTATION DETAILS ::\n%s\n", indent_lines(new_det, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && skip_scalar && /^[ ]{4}/ {
      next;
    }
    {
      if ($0 !~ /^[ ]{4}/) skip_scalar = 0;
      print $0;
    }
    END {
      if (in_target) emit_missing(3);
      flush_blanks();
    }
  ' "$backlog" > "$tmp_b"; then
    rm -f "$tmp_b"
    printf "task.update: error: rendering task '%s' failed, the backlog is unchanged (ERR_STORAGE_WRITE)\n" "$slug" >&2
    return 2
  fi
  commit_mv "$tmp_b" "$backlog" || return 2

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  printf '{"status":"ok","unit":"%s","task":{"slug":"%s","status":"TODO"}}\n' "$esc_unit" "$esc_slug"
  return 0
}

task_start() {
  unit="${1:-}"
  slug="${2:-}"
  pointer="${3:-}"
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'task.start: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.start: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! block_has "$backlog" task "$slug"; then
    printf "task.start: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  acquire_lock "$unit" || return 2
  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")

  awk -v target="$slug" '
    BEGIN { in_target = 0; }
    /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      in_target = (line == target);
      print $0;
      next;
    }
    in_target && /^[ ]{2}STATUS:[ ]*/ {
      print "  STATUS: IN_PROGRESS";
      next;
    }
    { print $0; }
  ' "$backlog" > "$tmp_b"

  next_act="work active task: $slug"
  [ -n "$pointer" ] && next_act="$pointer"
  if ! PV_VAL="$next_act" awk '
    BEGIN { done = 0; val = ENVIRON["PV_VAL"] }
    /^next_action:/ { print "next_action: \"" val "\""; done = 1; next }
    { print }
    END { if (!done) exit 1 }
  ' "$s_dir/state.md" > "$tmp_s"; then
    rm -f "$tmp_b" "$tmp_s"
    release_lock "$unit"
    printf "task.start: error: state.md missing next_action field, refusing to overwrite (ERR_STORAGE_CORRUPT)\n" >&2
    return 2
  fi

  commit_mv "$tmp_b" "$backlog" || { rm -f "$tmp_s"; release_lock "$unit"; return 2; }
  commit_mv "$tmp_s" "$s_dir/state.md" || { release_lock "$unit"; return 2; }
  release_lock "$unit"

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  esc_act=$(escape_json "$next_act")
  printf '{"status":"IN_PROGRESS","unit":"%s","task_slug":"%s","next_action":"%s"}\n' "$esc_unit" "$esc_slug" "$esc_act"
  return 0
}

