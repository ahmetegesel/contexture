    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! grep -q "^@task  *$slug" "$backlog" 2>/dev/null && ! grep -q "^@task $slug$" "$backlog" 2>/dev/null; then
    printf "task.show: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  awk -v unit="$unit" -v target="$slug" '
    function escape_json(s,    r) {
      r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN { found = 0; in_target = 0; in_scalar = ""; status = "TODO"; obj = ""; desc = ""; crit = ""; det = ""; }
    /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == target) {
        found = 1; in_target = 1;
      } else {
        in_target = 0;
      }
      next;
    }
    in_target && /^[ ]{2}STATUS:[ ]*/ {
      in_scalar = ""; v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      status = v; next;
    }
    in_target && /^[ ]{2}OBJECTIVE:[ ]*/ {
      in_scalar = ""; v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      obj = v; next;
    }
    in_target && /^[ ]{2}DESCRIPTION ::/ { in_scalar = "desc"; next; }
    in_target && /^[ ]{2}ACCEPTANCE CRITERIA ::/ { in_scalar = "crit"; next; }
    in_target && /^[ ]{2}IMPLEMENTATION DETAILS ::/ { in_scalar = "det"; next; }
    in_target && in_scalar != "" && /^[ ]{4}/ {
      line = substr($0, 5);
      if (in_scalar == "desc") desc = (desc == "" ? line : desc "\n" line);
      else if (in_scalar == "crit") crit = (crit == "" ? line : crit "\n" line);
      else if (in_scalar == "det") det = (det == "" ? line : det "\n" line);
      next;
    }
    in_target && /^[ \t]*$/ { in_scalar = ""; }
    END {
      if (!found) exit 1;
      printf "{\"unit\":\"%s\",\"task\":{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\",\"description\":\"%s\",\"criteria\":\"%s\",\"details\":\"%s\",\"refs\":[]}}\n",
        escape_json(unit), escape_json(target), escape_json(status), escape_json(obj), escape_json(desc), escape_json(crit), escape_json(det);
    }
  ' "$backlog"
  return $?
}

