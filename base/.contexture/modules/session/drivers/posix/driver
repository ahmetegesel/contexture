#!/bin/sh
# driver: zero-dependency POSIX filesystem storage driver
# Implements the complete 26-method SPI contract in pure POSIX sh and awk.

set -u

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)

find_workspace_root() {
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

get_session_dir() {
  u="$1"
  ws=$(find_workspace_root)
  printf '%s/.contexture/sessions/%s\n' "$ws" "$u"
}

get_tmp_dir() {
  ws=$(find_workspace_root)
  if [ -d "$ws/.contexture/tmp" ] && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  elif mkdir -p "$ws/.contexture/tmp" 2>/dev/null && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  else
    d="${TMPDIR:-/tmp}/contexture-$USER"
    mkdir -p "$d" 2>/dev/null || true
    printf '%s\n' "$d"
  fi
}

get_lock_dir() {
  tmp_d=$(get_tmp_dir)
  mkdir -p "$tmp_d/locks" 2>/dev/null || true
  printf '%s/locks\n' "$tmp_d"
}

acquire_lock() {
  u="$1"
  locks_dir=$(get_lock_dir)
  lock_target="$locks_dir/$u.lock"
  attempts=0
  while [ "$attempts" -lt 50 ]; do
    if [ -e "$lock_target" ]; then
      attempts=$((attempts + 1))
      sleep 0.1 2>/dev/null || sleep 1
      continue
    fi
    if mkdir "$lock_target" 2>/dev/null; then
      HELD_LOCK="$lock_target"
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 0.1 2>/dev/null || sleep 1
  done
  printf 'posix-driver: error: failed to acquire lock for unit %s after 5s timeout (ERR_STORAGE_LOCKED)\n' "$u" >&2
  return 2
}

release_lock() {
  u="$1"
  locks_dir=$(get_lock_dir)
  rm -rf "$locks_dir/$u.lock" 2>/dev/null || true
  HELD_LOCK=""
}

# commit_mv <temp> <target>: the atomic replace of a method's artifact; a failed mv (a
# read-only drawer, a full disk) removes the temp and reports the storage tier, so the
# caller returns 2 and never prints success over a write that did not land
commit_mv() {
  if ! mv -f "$1" "$2" 2>/dev/null; then
    rm -f "$1"
    printf '%s: error: the storage write of %s failed (ERR_STORAGE_WRITE)\n' "${cmd:-posix-driver}" "${2##*/}" >&2
    return 2
  fi
  return 0
}

escape_json() {
  # the backslash is doubled by concatenation (bs_double), never by a gsub replacement:
  # a replacement of four backslashes yields one under busybox awk and gawk --posix
  printf '%s' "$1" | awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    BEGIN { ORS="" }
    {
      if (NR > 1) printf "\\n";
      $0 = bs_double($0);
      gsub(/"/, "\\\"");
      gsub(/\r/, "\\r");
      gsub(/\t/, "\\t");
      printf "%s", $0;
    }
  '
}

# The payload transport: argv carries the method and its bounded identifiers; every
# free-text field arrives on stdin as key=value lines, the value escaped (backslash,
# newline, tab, carriage return as \\, \n, \t, \r). A single-document body
# (artifact.write, lane.report --write) is the raw stdin itself.
PAYLOAD_FILE=""
payload_cleanup() {
  [ -n "$PAYLOAD_FILE" ] && rm -f "$PAYLOAD_FILE"
  return 0
}
# every exit path cleans up: the EXIT trap removes the staged payload and releases a
# held unit lock; a HUP, INT, or TERM exits through it (dash runs no EXIT trap on a
# signal it does not trap), so an interrupted method leaves neither behind
HELD_LOCK=""
driver_cleanup() {
  payload_cleanup
  [ -n "$HELD_LOCK" ] && rm -rf "$HELD_LOCK" 2>/dev/null
  return 0
}
trap driver_cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
payload_load() {
  tmp_pd=$(get_tmp_dir)
  PAYLOAD_FILE=$(mktemp "$tmp_pd/payload.XXXXXX") || {
    printf 'posix-driver: error: cannot stage the payload (ERR_STORAGE_WRITE)\n' >&2
    exit 2
  }
  cat > "$PAYLOAD_FILE"
}
# pget <var> <key>: the decoded field, exact (trailing newlines kept), empty when absent
pget() {
  _pv=$(awk -v k="$2" '
    index($0, k "=") == 1 {
      v = substr($0, length(k) + 2)
      gsub(/\\\\/, "\001", v); gsub(/\\n/, "\n", v); gsub(/\\t/, "\t", v); gsub(/\\r/, "\r", v)
      gsub(/\001/, "\\", v)
      printf "%s", v
      exit
    }' "$PAYLOAD_FILE"; printf x)
  eval "$1=\${_pv%x}"
}

# block_has <file> <kind> <name>: rc0 when a column-0 @<kind> head names <name> exactly
block_has() {
  [ -f "$1" ] || return 1
  awk -v k="@$2" -v n="$3" '$1 == k && $2 == n { f = 1; exit } END { exit !f }' "$1"
}

# refs_json <value>: a REFS value (bracketed or bare, comma or space separated) as a JSON array
refs_json() {
  printf '%s' "$1" | awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function esc(s) { s = bs_double(s); gsub(/"/, "\\\"", s); return s }
    { v = v (NR > 1 ? " " : "") $0 }
    END {
      sub(/^[ \t]*\[/, "", v); sub(/\][ \t]*$/, "", v); gsub(/,/, " ", v)
      n = split(v, w, /[ \t]+/); out = ""
      for (i = 1; i <= n; i++) if (w[i] != "") out = out (out == "" ? "" : ",") "\"" esc(w[i]) "\""
      printf "[%s]", out
    }'
}

slug_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# artifact keys: state, backlog, knowledge, journal, lane/<lane>/{recipe,journal,report}
art_path() {
  ap_dir=$(get_session_dir "$1")
  case "$2" in
    state|backlog|knowledge|journal) printf '%s/%s.md\n' "$ap_dir" "$2" ;;
    lane/*/recipe|lane/*/journal|lane/*/report)
      ap_rest=${2#lane/}
      ap_lane=${ap_rest%/*}
      ap_name=${ap_rest##*/}
      slug_valid "$ap_lane" || return 1
      printf '%s/lanes/%s/%s.md\n' "$ap_dir" "$ap_lane" "$ap_name"
      ;;
    *) return 1 ;;
  esac
}

artifact_read() {
  unit="${1:-}"
  key="${2:-}"
  if [ -z "$unit" ] || [ -z "$key" ]; then
    printf 'artifact.read: error: missing required arguments (unit, key) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  slug_valid "$unit" || { printf "artifact.read: error: malformed unit '%s' (ERR_INVALID_ARGUMENT)\n" "$unit" >&2; return 1; }
  path=$(art_path "$unit" "$key") || { printf "artifact.read: error: unknown artifact key '%s' (ERR_INVALID_ARGUMENT)\n" "$key" >&2; return 1; }
  if [ ! -f "$path" ]; then
    printf "artifact.read: error: artifact '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$key" "$unit" >&2
    return 1
  fi
  cat "$path" || return 2
  return 0
}

artifact_write() {
  unit="${1:-}"
  key="${2:-}"
  if [ -z "$unit" ] || [ -z "$key" ]; then
    printf 'artifact.write: error: missing required arguments (unit, key) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  slug_valid "$unit" || { printf "artifact.write: error: malformed unit '%s' (ERR_INVALID_ARGUMENT)\n" "$unit" >&2; return 1; }
  path=$(art_path "$unit" "$key") || { printf "artifact.write: error: unknown artifact key '%s' (ERR_INVALID_ARGUMENT)\n" "$key" >&2; return 1; }
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "artifact.write: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  case "$key" in
    lane/*) mkdir -p "$(dirname "$path")" || return 2 ;;
  esac
  # a unique same-directory temp: the mv stays on one filesystem (atomic replace)
  # and concurrent writers never share a temp name
  aw_tmp=$(mktemp "$path.XXXXXX" 2>/dev/null) || {
    printf "artifact.write: error: cannot create a temp beside %s (ERR_STORAGE_WRITE)\n" "$key" >&2
    return 2
  }
  if ! cat > "$aw_tmp"; then
    rm -f "$aw_tmp"
    printf 'artifact.write: error: the storage write failed (ERR_STORAGE_WRITE)\n' >&2
    return 2
  fi
  if ! mv "$aw_tmp" "$path"; then
    rm -f "$aw_tmp"
    printf 'artifact.write: error: the storage write failed (ERR_STORAGE_WRITE)\n' >&2
    return 2
  fi
  return 0
}

artifact_list() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'artifact.list: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  slug_valid "$unit" || { printf "artifact.list: error: malformed unit '%s' (ERR_INVALID_ARGUMENT)\n" "$unit" >&2; return 1; }
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "artifact.list: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  for al_a in state backlog knowledge journal; do
    [ -f "$s_dir/$al_a.md" ] && printf '%s\n' "$al_a"
  done
  if [ -d "$s_dir/lanes" ]; then
    for al_l in "$s_dir"/lanes/*; do
      [ -d "$al_l" ] || continue
      al_n=${al_l##*/}
      slug_valid "$al_n" || continue
      printf 'lane/%s\n' "$al_n"
      for al_a in recipe journal report; do
        [ -f "$al_l/$al_a.md" ] && printf 'lane/%s/%s\n' "$al_n" "$al_a"
      done
    done
  fi
  return 0
}

session_create() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.create: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  slug_valid "$unit" || { printf "session.create: error: malformed unit '%s' (ERR_INVALID_ARGUMENT)\n" "$unit" >&2; return 1; }
  s_dir=$(get_session_dir "$unit")
  if [ -e "$s_dir" ]; then
    printf "session.create: error: session '%s' already exists (ERR_ENTITY_EXISTS)\n" "$unit" >&2
    return 1
  fi
  mkdir -p "$(dirname "$s_dir")" 2>/dev/null || true
  if ! mkdir "$s_dir" 2>/dev/null; then
    if [ -e "$s_dir" ]; then
      printf "session.create: error: session '%s' already exists (ERR_ENTITY_EXISTS)\n" "$unit" >&2
      return 1
    fi
    printf "session.create: error: cannot create session '%s' (ERR_STORAGE_WRITE)\n" "$unit" >&2
    return 2
  fi
  printf '{"status":"ok","unit":"%s"}\n' "$(escape_json "$unit")"
  return 0
}

storage_health() {
  ws=$(find_workspace_root)
  sessions_dir="$ws/.contexture/sessions"
  sh_health="ok"
  if [ ! -d "$sessions_dir" ]; then
    sh_health="degraded"
    sh_detail="sessions directory does not exist yet (will be created on bootstrap)"
  elif [ ! -w "$sessions_dir" ]; then
    sh_health="error"
    sh_detail="sessions directory is not writable"
  else
    sh_detail="sessions directory writable, unlocked"
    if [ -d "$sessions_dir/.lock" ]; then
      sh_health="locked"
      sh_detail="storage lock active"
    fi
  fi
  printf '{"driver":"posix","health":"%s","detail":"%s"}\n' "$sh_health" "$(escape_json "$sh_detail")"
  return 0
}

capability() {
  cat <<'EOF'
{
  "driver": "posix",
  "version": "1.0.0",
  "capabilities": [
    "session.lifecycle",
    "task.crud",
    "task.atomic_completion",
    "entry.journal",
    "finding.knowledge",
    "lane.lifecycle",
    "resolve.symbolic",
    "search.keyword",
    "artifact.store"
  ]
}
EOF
  return 0
}

session_init() {
  unit="${1:-}"
  objective="${2:-new unit}"
  if [ -z "$unit" ]; then
    printf 'session.init: error: missing required session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ -d "$s_dir" ]; then
    printf "session.init: error: session '%s' already exists (ERR_ENTITY_EXISTS)\n" "$unit" >&2
    return 1
  fi
  mkdir -p "$s_dir/lanes" || return 2

  cat > "$s_dir/state.md" <<EOF
status: ACTIVE
current_anchor: A1
next_action: "plan the next move"
objective: "$objective"
repos: []
ref_sessions: []
EOF

  cat > "$s_dir/backlog.md" <<'EOF'
# backlog grammar

EOF

  cat > "$s_dir/journal.md" <<'EOF'
# journal grammar

@anchor A1 ("session initialized", attention: [])

EOF

  cat > "$s_dir/knowledge.md" <<'EOF'
# knowledge grammar

EOF

  esc_unit=$(escape_json "$unit")
  esc_obj=$(escape_json "$objective")
  printf '{"status":"ok","unit":"%s","anchor":"A1","state":{"status":"ACTIVE","current_anchor":"A1","next_action":"plan the next move","objective":"%s","repos":[],"ref_sessions":[]}}\n' "$esc_unit" "$esc_obj"
  return 0
}

session_load() {
  unit="${1:-}"
  page="${2:-1}"
  if [ -z "$unit" ]; then
    printf 'session.load: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.load: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  # an absent artifact is skipped, never an awk abort (a legacy unit may lack its backlog)
  set --
  for sl_f in state backlog knowledge journal; do
    [ -f "$s_dir/$sl_f.md" ] && set -- "$@" "$s_dir/$sl_f.md"
  done
  set -- "$@" /dev/null
  awk -v unit="$unit" -v page="$page" -f "$SCRIPT_DIR/load_bios.awk" "$@"
  return 0
}

session_board() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.board: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.board: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  awk -v unit="$unit" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN {
      anchor = "A1";
      task_cnt = 0;
      entry_cnt = 0;
      cur_task = ""; cur_status = ""; cur_obj = "";
      cur_entry = ""; cur_anchor = ""; cur_what = ""; cur_thread = "";
    }
    FILENAME ~ /state\.md$/ {
      if ($0 ~ /^current_anchor:[ ]*/) {
        v = $0; sub(/^current_anchor:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        anchor = v;
      }
      next
    }
    FILENAME ~ /backlog\.md$/ {
      if ($0 ~ /^@task[ ]+/) {
        if (cur_task != "" && (cur_status == "TODO" || cur_status == "IN_PROGRESS")) {
          task_cnt++; tasks_slug[task_cnt] = cur_task; tasks_status[task_cnt] = cur_status; tasks_obj[task_cnt] = cur_obj;
        }
        line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
        cur_task = line; cur_status = "TODO"; cur_obj = "";
        next
      }
      if ($0 ~ /^[ ]{2}STATUS:[ ]*/) {
        v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        cur_status = v;
        next
      }
      if ($0 ~ /^[ ]{2}OBJECTIVE:[ ]*/) {
        v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
        cur_obj = v;
        next
      }
      next
    }
    FILENAME ~ /journal\.md$/ {
      if ($0 ~ /^[ ]{2}(CLOSES|SUPERSEDES):[ ]*/) {
        line = $0; sub(/^[ ]{2}(CLOSES|SUPERSEDES):[ ]*/, "", line);
        sub(/[ \t]+-[ \t]+.*$/, "", line); sub(/[ \t]+\(.*$/, "", line);
        nw = split(line, cw, /[ \t]+/);
        for (wi = 1; wi <= nw; wi++) if (cw[wi] ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[a-zA-Z0-9_-]+[a-zA-Z0-9]$/) closed[cw[wi]] = FNR;
      }
      if ($0 ~ /^@entry[ ]+/) {
        if (cur_entry != "") {
          entry_cnt++; e_slug[entry_cnt] = cur_entry; e_ln[entry_cnt] = cur_ln; e_anc[entry_cnt] = cur_anchor; e_what[entry_cnt] = cur_what; e_th[entry_cnt] = cur_thread;
        }
        line = $0; sub(/^@entry[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
        cur_entry = line; cur_ln = FNR; cur_anchor = anchor; cur_what = ""; cur_thread = "none";
        next
      }
      if ($0 ~ /^[ ]{2}ANCHOR:[ ]*/) {
        v = $0; sub(/^[ ]{2}ANCHOR:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        cur_anchor = v;
        next
      }
      if ($0 ~ /^[ ]{2}WHAT:[ ]*/) {
        v = $0; sub(/^[ ]{2}WHAT:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
        cur_what = v;
        next
      }
      if ($0 ~ /^[ ]{2}THREAD:[ ]*/) {
        v = $0; sub(/^[ ]{2}THREAD:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        cur_thread = v;
        next
      }
      next
    }
    END {
      if (cur_task != "" && (cur_status == "TODO" || cur_status == "IN_PROGRESS")) {
        task_cnt++; tasks_slug[task_cnt] = cur_task; tasks_status[task_cnt] = cur_status; tasks_obj[task_cnt] = cur_obj;
      }
      if (cur_entry != "") {
        entry_cnt++; e_slug[entry_cnt] = cur_entry; e_ln[entry_cnt] = cur_ln; e_anc[entry_cnt] = cur_anchor; e_what[entry_cnt] = cur_what; e_th[entry_cnt] = cur_thread;
      }

      printf "{\"unit\":\"%s\",\"anchor\":\"%s\",", escape_json(unit), escape_json(anchor);

      printf "\"unclosed_entries\":[";
      first = 1;
      for (i = 1; i <= entry_cnt; i++) {
        if (e_slug[i] in closed && closed[e_slug[i]] > e_ln[i]) continue;
        if (!first) printf ",";
        first = 0;
        printf "{\"slug\":\"%s\",\"anchor\":\"%s\",\"what\":\"%s\",\"thread\":\"%s\"}", escape_json(e_slug[i]), escape_json(e_anc[i]), escape_json(e_what[i]), escape_json(e_th[i]);
      }
      printf "],";

      printf "\"open_tasks\":[";
      first = 1;
      for (i = 1; i <= task_cnt; i++) {
        if (!first) printf ",";
        first = 0;
        printf "{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\"}", escape_json(tasks_slug[i]), escape_json(tasks_status[i]), escape_json(tasks_obj[i]);
      }
      printf "],";

      printf "\"open_threads\":[";
      first = 1;
      for (i = 1; i <= entry_cnt; i++) {
        if (e_slug[i] in closed && closed[e_slug[i]] > e_ln[i]) continue;
        if (e_th[i] == "" || e_th[i] == "none") continue;
        if (!first) printf ",";
        first = 0;
        printf "{\"slug\":\"%s\",\"thread\":\"%s\"}", escape_json(e_slug[i]), escape_json(e_th[i]);
      }
      printf "]}";
      printf "\n";
    }
  ' $(for sb_f in state backlog journal; do [ -f "$s_dir/$sb_f.md" ] && printf '%s\n' "$s_dir/$sb_f.md"; done; printf '/dev/null\n')
  return 0
}

session_stamp() {
  unit="${1:-}"
  attention="${2:-session stamp}"
  if [ -z "$unit" ]; then
    printf 'session.stamp: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.stamp: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  state_file="$s_dir/state.md"
  journal_file="$s_dir/journal.md"
  cur_anc=$(grep '^current_anchor:' "$state_file" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"
  anc_num=$(printf '%s' "$cur_anc" | sed 's/[^0-9]//g')
  [ -z "$anc_num" ] && anc_num=1
  next_num=$((anc_num + 1))
  next_anc="A$next_num"

  tmp_d=$(get_tmp_dir)
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")
  sed "s/^current_anchor:.*/current_anchor: $next_anc/" "$state_file" > "$tmp_s"
  commit_mv "$tmp_s" "$state_file" || return 2

  printf '\n@anchor %s ("continues %s", attention: "%s")\n' "$next_anc" "$cur_anc" "$attention" >> "$journal_file"

  esc_unit=$(escape_json "$unit")
  esc_prev=$(escape_json "$cur_anc")
  esc_next=$(escape_json "$next_anc")
  esc_att=$(escape_json "$attention")
  printf '{"unit":"%s","previous_anchor":"%s","current_anchor":"%s","receipt_entry":"%s"}\n' "$esc_unit" "$esc_prev" "$esc_next" "$esc_att"
  return 0
}

session_close() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.close: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.close: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  state_file="$s_dir/state.md"
  tmp_d=$(get_tmp_dir)
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")
  sed "s/^status:.*/status: CLOSED/" "$state_file" > "$tmp_s"
  commit_mv "$tmp_s" "$state_file" || return 2

  esc_unit=$(escape_json "$unit")
