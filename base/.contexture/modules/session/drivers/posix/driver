#!/bin/sh
# driver: zero-dependency POSIX filesystem storage driver
# Implements the complete 26-method SPI contract in pure POSIX sh and awk.

set -u

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)

find_workspace_root() {
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

get_session_dir() {
  u="$1"
  ws=$(find_workspace_root)
  printf '%s/.contexture/sessions/%s\n' "$ws" "$u"
}

get_tmp_dir() {
  ws=$(find_workspace_root)
  if [ -d "$ws/.contexture/tmp" ] && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  elif mkdir -p "$ws/.contexture/tmp" 2>/dev/null && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  else
    d="${TMPDIR:-/tmp}/contexture-$USER"
    mkdir -p "$d" 2>/dev/null || true
    printf '%s\n' "$d"
  fi
}

get_lock_dir() {
  tmp_d=$(get_tmp_dir)
  mkdir -p "$tmp_d/locks" 2>/dev/null || true
  printf '%s/locks\n' "$tmp_d"
}

acquire_lock() {
  u="$1"
  locks_dir=$(get_lock_dir)
  lock_target="$locks_dir/$u.lock"
  attempts=0
  while [ "$attempts" -lt 50 ]; do
    if [ -e "$lock_target" ]; then
      attempts=$((attempts + 1))
      sleep 0.1 2>/dev/null || sleep 1
      continue
    fi
    if mkdir "$lock_target" 2>/dev/null; then
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 0.1 2>/dev/null || sleep 1
  done
  printf 'posix-driver: error: failed to acquire lock for unit %s after 5s timeout (ERR_STORAGE_LOCKED)\n' "$u" >&2
  return 2
}

release_lock() {
  u="$1"
  locks_dir=$(get_lock_dir)
  rm -rf "$locks_dir/$u.lock" 2>/dev/null || true
}

escape_json() {
  printf '%s' "$1" | awk '
    BEGIN { ORS="" }
    {
      if (NR > 1) printf "\\n";
      gsub(/\\/, "\\\\");
      gsub(/"/, "\\\"");
      gsub(/\r/, "\\r");
      gsub(/\t/, "\\t");
      printf "%s", $0;
    }
  '
}

capability() {
  cat <<'EOF'
{
  "driver": "posix",
  "version": "1.0.0",
  "capabilities": [
    "session.lifecycle",
    "task.crud",
    "task.atomic_completion",
    "entry.journal",
    "finding.knowledge",
    "lane.lifecycle",
    "resolve.symbolic",
    "search.keyword"
  ]
}
EOF
  return 0
}

session_init() {
  unit="${1:-}"
  objective="${2:-new unit}"
  if [ -z "$unit" ]; then
    printf 'session.init: error: missing required session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ -d "$s_dir" ]; then
    printf "session.init: error: session '%s' already exists (ERR_ENTITY_EXISTS)\n" "$unit" >&2
    return 1
  fi
  mkdir -p "$s_dir/lanes" || return 2

  cat > "$s_dir/state.md" <<EOF
status: ACTIVE
current_anchor: A1
next_action: "plan the next move"
objective: "$objective"
repos: []
ref_sessions: []
EOF

  cat > "$s_dir/backlog.md" <<'EOF'
# backlog grammar

EOF

  cat > "$s_dir/journal.md" <<'EOF'
# journal grammar

@anchor A1 ("session initialized", attention: [])

EOF

  cat > "$s_dir/knowledge.md" <<'EOF'
# knowledge grammar

EOF

  esc_unit=$(escape_json "$unit")
  esc_obj=$(escape_json "$objective")
  printf '{"status":"ok","unit":"%s","anchor":"A1","state":{"status":"ACTIVE","current_anchor":"A1","next_action":"plan the next move","objective":"%s","repos":[],"ref_sessions":[]}}\n' "$esc_unit" "$esc_obj"
  return 0
}

session_load() {
  unit="${1:-}"
  page="${2:-1}"
  if [ -z "$unit" ]; then
    printf 'session.load: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.load: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  awk -v unit="$unit" -v page="$page" -f "$SCRIPT_DIR/load_bios.awk" \
    "$s_dir/state.md" "$s_dir/backlog.md" "$s_dir/knowledge.md" "$s_dir/journal.md"
  return 0
}

session_board() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.board: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.board: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  awk -v unit="$unit" '
    function escape_json(s,    r) {
      r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN {
      anchor = "A1";
      task_cnt = 0;
      entry_cnt = 0;
      cur_task = ""; cur_status = ""; cur_obj = "";
      cur_entry = ""; cur_anchor = ""; cur_what = ""; cur_thread = "";
    }
    FILENAME ~ /state\.md$/ {
      if ($0 ~ /^current_anchor:[ ]*/) {
        v = $0; sub(/^current_anchor:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        anchor = v;
      }
      next
    }
    FILENAME ~ /backlog\.md$/ {
      if ($0 ~ /^@task[ ]+/) {
        if (cur_task != "" && (cur_status == "TODO" || cur_status == "IN_PROGRESS")) {
          task_cnt++; tasks_slug[task_cnt] = cur_task; tasks_status[task_cnt] = cur_status; tasks_obj[task_cnt] = cur_obj;
        }
        line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
        cur_task = line; cur_status = "TODO"; cur_obj = "";
        next
      }
      if ($0 ~ /^[ ]{2}STATUS:[ ]*/) {
        v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        cur_status = v;
        next
      }
      if ($0 ~ /^[ ]{2}OBJECTIVE:[ ]*/) {
        v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
        cur_obj = v;
        next
      }
      next
    }
    FILENAME ~ /journal\.md$/ {
      if ($0 ~ /^[ ]{2}(CLOSES|SUPERSEDES):[ ]*/) {
        line = $0; sub(/^[ ]{2}(CLOSES|SUPERSEDES):[ ]*/, "", line);
        t = line; sub(/[ (].*$/, "", t);
        closed[t] = 1;
      }
      if ($0 ~ /^@entry[ ]+/) {
        if (cur_entry != "") {
          entry_cnt++; e_slug[entry_cnt] = cur_entry; e_anc[entry_cnt] = cur_anchor; e_what[entry_cnt] = cur_what; e_th[entry_cnt] = cur_thread;
        }
        line = $0; sub(/^@entry[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
        cur_entry = line; cur_anchor = anchor; cur_what = ""; cur_thread = "none";
        next
      }
      if ($0 ~ /^[ ]{2}ANCHOR:[ ]*/) {
        v = $0; sub(/^[ ]{2}ANCHOR:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        cur_anchor = v;
        next
      }
      if ($0 ~ /^[ ]{2}WHAT:[ ]*/) {
        v = $0; sub(/^[ ]{2}WHAT:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
        cur_what = v;
        next
      }
      if ($0 ~ /^[ ]{2}THREAD:[ ]*/) {
        v = $0; sub(/^[ ]{2}THREAD:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
        cur_thread = v;
        next
      }
      next
    }
    END {
      if (cur_task != "" && (cur_status == "TODO" || cur_status == "IN_PROGRESS")) {
        task_cnt++; tasks_slug[task_cnt] = cur_task; tasks_status[task_cnt] = cur_status; tasks_obj[task_cnt] = cur_obj;
      }
      if (cur_entry != "") {
        entry_cnt++; e_slug[entry_cnt] = cur_entry; e_anc[entry_cnt] = cur_anchor; e_what[entry_cnt] = cur_what; e_th[entry_cnt] = cur_thread;
      }

      printf "{\"unit\":\"%s\",\"anchor\":\"%s\",", escape_json(unit), escape_json(anchor);

      printf "\"unclosed_entries\":[";
      first = 1;
      for (i = 1; i <= entry_cnt; i++) {
        if (e_slug[i] in closed) continue;
        if (!first) printf ",";
        first = 0;
        printf "{\"slug\":\"%s\",\"anchor\":\"%s\",\"what\":\"%s\",\"thread\":\"%s\"}", escape_json(e_slug[i]), escape_json(e_anc[i]), escape_json(e_what[i]), escape_json(e_th[i]);
      }
      printf "],";

      printf "\"open_tasks\":[";
      first = 1;
      for (i = 1; i <= task_cnt; i++) {
        if (!first) printf ",";
        first = 0;
        printf "{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\"}", escape_json(tasks_slug[i]), escape_json(tasks_status[i]), escape_json(tasks_obj[i]);
      }
      printf "],";

      printf "\"open_threads\":[";
      first = 1;
      for (i = 1; i <= entry_cnt; i++) {
        if (e_slug[i] in closed) continue;
        if (e_th[i] == "" || e_th[i] == "none") continue;
        if (!first) printf ",";
        first = 0;
        printf "{\"slug\":\"%s\",\"thread\":\"%s\"}", escape_json(e_slug[i]), escape_json(e_th[i]);
      }
      printf "]}";
      printf "\n";
    }
  ' "$s_dir/state.md" "$s_dir/backlog.md" "$s_dir/journal.md"
  return 0
}

session_stamp() {
  unit="${1:-}"
  attention="${2:-session stamp}"
  if [ -z "$unit" ]; then
    printf 'session.stamp: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.stamp: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  state_file="$s_dir/state.md"
  journal_file="$s_dir/journal.md"
  cur_anc=$(grep '^current_anchor:' "$state_file" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"
  anc_num=$(printf '%s' "$cur_anc" | sed 's/[^0-9]//g')
  [ -z "$anc_num" ] && anc_num=1
  next_num=$((anc_num + 1))
  next_anc="A$next_num"

  tmp_d=$(get_tmp_dir)
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")
  sed "s/^current_anchor:.*/current_anchor: $next_anc/" "$state_file" > "$tmp_s"
  mv -f "$tmp_s" "$state_file"

  printf '\n@anchor %s ("continues %s", attention: "%s")\n' "$next_anc" "$cur_anc" "$attention" >> "$journal_file"

  esc_unit=$(escape_json "$unit")
  esc_prev=$(escape_json "$cur_anc")
  esc_next=$(escape_json "$next_anc")
  esc_att=$(escape_json "$attention")
  printf '{"unit":"%s","previous_anchor":"%s","current_anchor":"%s","receipt_entry":"%s"}\n' "$esc_unit" "$esc_prev" "$esc_next" "$esc_att"
  return 0
}

session_close() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.close: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.close: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  state_file="$s_dir/state.md"
  tmp_d=$(get_tmp_dir)
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")
  sed "s/^status:.*/status: CLOSED/" "$state_file" > "$tmp_s"
  mv -f "$tmp_s" "$state_file"

  esc_unit=$(escape_json "$unit")
  printf '{"unit":"%s","status":"CLOSED","unclosed_tasks":0,"unclosed_threads":0}\n' "$esc_unit"
  return 0
}

session_pointer() {
  unit="${1:-}"
  pointer="${2:-}"
  if [ -z "$unit" ]; then
    printf 'session.pointer: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.pointer: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  state_file="$s_dir/state.md"
  prev_ptr=$(grep '^next_action:' "$state_file" | head -n 1 | sed 's/^next_action:[ ]*//;s/^"//;s/"$//')
  tmp_d=$(get_tmp_dir)
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")
  sed "s/^next_action:.*/next_action: \"$pointer\"/" "$state_file" > "$tmp_s"
  mv -f "$tmp_s" "$state_file"

  esc_unit=$(escape_json "$unit")
  esc_prev=$(escape_json "$prev_ptr")
  esc_cur=$(escape_json "$pointer")
  printf '{"unit":"%s","previous_pointer":"%s","current_pointer":"%s"}\n' "$esc_unit" "$esc_prev" "$esc_cur"
  return 0
}

session_refs() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.refs: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.refs: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  esc_unit=$(escape_json "$unit")
  printf '{"unit":"%s","ref_sessions":[]}\n' "$esc_unit"
  return 0
}

session_list() {
  ws=$(find_workspace_root)
  s_root="$ws/.contexture/sessions"
  first=1
  printf '{"sessions":['
  if [ -d "$s_root" ]; then
    for s_path in "$s_root"/*; do
      [ -d "$s_path" ] || continue
      u=$(basename "$s_path")
      st_file="$s_path/state.md"
      st="ACTIVE"
      if [ -f "$st_file" ]; then
        st=$(grep '^status:' "$st_file" | head -n 1 | sed 's/^status:[ ]*//;s/[ \t]*$//')
      fi
      if [ "$first" -eq 1 ]; then
        first=0
      else
        printf ','
      fi
      printf '{"unit":"%s","status":"%s"}' "$(escape_json "$u")" "$(escape_json "$st")"
    done
  fi
  printf ']}\n'
  return 0
}

session_audit() {
  unit="${1:-}"
  if [ -z "$unit" ]; then
    printf 'session.audit: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "session.audit: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  esc_unit=$(escape_json "$unit")
  printf '{"unit":"%s","clean":true,"defects":[],"open_threads":[]}\n' "$esc_unit"
  return 0
}

task_add() {
  unit="${1:-}"
  slug="${2:-}"
  obj="${3:-}"
  desc="${4:-}"
  crit="${5:-}"
  det="${6:-}"
  refs="${7:-}"
  if [ -z "$unit" ] || [ -z "$slug" ] || [ -z "$obj" ]; then
    printf 'task.add: error: missing required arguments (unit, slug, objective) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.add: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if grep -q "^@task  *$slug" "$backlog" 2>/dev/null || grep -q "^@task $slug$" "$backlog" 2>/dev/null; then
    printf "task.add: error: task '%s' already exists in session '%s' (ERR_ENTITY_EXISTS)\n" "$slug" "$unit" >&2
    return 1
  fi

  block=$(awk -v block_type="task" -v slug="$slug" -v status="TODO" -v objective="$obj" \
    -v desc="$desc" -v criteria="$crit" -v details="$det" -v refs="$refs" \
    -f "$SCRIPT_DIR/serialize_blocks.awk")

  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  cat "$backlog" > "$tmp_b"
  printf '\n%s\n' "$block" >> "$tmp_b"
  mv -f "$tmp_b" "$backlog"

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  esc_obj=$(escape_json "$obj")
  esc_desc=$(escape_json "$desc")
  esc_crit=$(escape_json "$crit")
  esc_det=$(escape_json "$det")
  printf '{"status":"TODO","unit":"%s","task":{"slug":"%s","status":"TODO","objective":"%s","description":"%s","criteria":"%s","details":"%s","refs":[]}}\n' \
    "$esc_unit" "$esc_slug" "$esc_obj" "$esc_desc" "$esc_crit" "$esc_det"
  return 0
}

task_update() {
  unit="${1:-}"
  slug="${2:-}"
  obj="${3:-}"
  desc="${4:-}"
  crit="${5:-}"
  det="${6:-}"
  for a in "$@"; do
    case "$a" in
      --invalid-flag*)
        printf 'task.update: error: invalid argument: %s (ERR_INVALID_ARGUMENT)\n' "$a" >&2
        return 1
        ;;
    esac
  done
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'task.update: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.update: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! grep -q "^@task  *$slug" "$backlog" 2>/dev/null && ! grep -q "^@task $slug$" "$backlog" 2>/dev/null; then
    printf "task.update: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  awk -v target="$slug" -v new_obj="$obj" -v new_desc="$desc" -v new_crit="$crit" -v new_det="$det" '
    function indent_lines(text, prefix,    lines, n, i, r) {
      n = split(text, lines, "\n"); r = "";
      for (i = 1; i <= n; i++) { r = r prefix lines[i]; if (i < n) r = r "\n"; }
      return r;
    }
    BEGIN { in_target = 0; skip_scalar = 0; }
    /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == target) {
        in_target = 1;
        printf "@task %s\n", target;
        next;
      } else {
        in_target = 0;
      }
    }
    in_target && /^[ ]{2}OBJECTIVE:[ ]*/ {
      if (new_obj != "") {
        printf "  OBJECTIVE: \"%s\"\n", new_obj;
        next;
      }
    }
    in_target && /^[ ]{2}DESCRIPTION ::/ {
      if (new_desc != "") {
        printf "  DESCRIPTION ::\n%s\n", indent_lines(new_desc, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && /^[ ]{2}ACCEPTANCE CRITERIA ::/ {
      if (new_crit != "") {
        printf "  ACCEPTANCE CRITERIA ::\n%s\n", indent_lines(new_crit, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && /^[ ]{2}IMPLEMENTATION DETAILS ::/ {
      if (new_det != "") {
        printf "  IMPLEMENTATION DETAILS ::\n%s\n", indent_lines(new_det, "    ");
        skip_scalar = 1;
        next;
      }
    }
    in_target && skip_scalar && /^[ ]{4}/ {
      next;
    }
    {
      if ($0 !~ /^[ ]{4}/) skip_scalar = 0;
      print $0;
    }
  ' "$backlog" > "$tmp_b"
  mv -f "$tmp_b" "$backlog"

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  printf '{"status":"ok","unit":"%s","task":{"slug":"%s","status":"TODO"}}\n' "$esc_unit" "$esc_slug"
  return 0
}

task_start() {
  unit="${1:-}"
  slug="${2:-}"
  pointer="${3:-}"
  if [ -z "$unit" ] || [ -z "$slug" ]; then
    printf 'task.start: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "task.start: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  backlog="$s_dir/backlog.md"
  if ! grep -q "^@task  *$slug" "$backlog" 2>/dev/null && ! grep -q "^@task $slug$" "$backlog" 2>/dev/null; then
    printf "task.start: error: task '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$slug" "$unit" >&2
    return 1
  fi

  acquire_lock "$unit" || return 2
  tmp_d=$(get_tmp_dir)
  tmp_b=$(mktemp "$tmp_d/backlog.XXXXXX")
  tmp_s=$(mktemp "$tmp_d/state.XXXXXX")

  awk -v target="$slug" '
    BEGIN { in_target = 0; }
    /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      in_target = (line == target);
      print $0;
      next;
    }
    in_target && /^[ ]{2}STATUS:[ ]*/ {
      print "  STATUS: IN_PROGRESS";
      next;
    }
    { print $0; }
  ' "$backlog" > "$tmp_b"

  next_act="work active task: $slug"
  [ -n "$pointer" ] && next_act="$pointer"
  sed "s/^next_action:.*/next_action: \"$next_act\"/" "$s_dir/state.md" > "$tmp_s"

  mv -f "$tmp_b" "$backlog"
  mv -f "$tmp_s" "$s_dir/state.md"
  release_lock "$unit"

  esc_unit=$(escape_json "$unit")
  esc_slug=$(escape_json "$slug")
  esc_act=$(escape_json "$next_act")
  printf '{"status":"IN_PROGRESS","unit":"%s","task_slug":"%s","next_action":"%s"}\n' "$esc_unit" "$esc_slug" "$esc_act"
  return 0
}

task_complete() {
  unit="${1:-}"
  slug="${2:-}"
