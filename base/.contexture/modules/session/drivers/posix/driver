lane_status() {
  unit="${1:-}"
  lane="${2:-}"
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.status: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.status: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  has_recipe=false; [ -f "$l_dir/recipe.md" ] && has_recipe=true
  has_journal=false; [ -f "$l_dir/journal.md" ] && has_journal=true
  has_report=false; [ -f "$l_dir/report.md" ] && has_report=true

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
