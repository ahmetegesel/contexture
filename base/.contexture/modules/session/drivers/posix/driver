  printf '{"unit":"%s","lane":"%s","recipe_present":%s,"journal_present":%s,"report_present":%s,"line_counts":{},"last_activity":"%s"}\n' \
    "$esc_unit" "$esc_lane" "$has_recipe" "$has_journal" "$has_report" "$today"
  return 0
}

lane_close() {
  unit="${1:-}"
  lane="${2:-}"
  verdict="${3:-COMPLETE}"
  resolution="${4:-lane closed}"
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.close: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.close: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  cur_anc=$(grep '^current_anchor:' "$s_dir/state.md" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"
  today=$(date +%Y-%m-%d)
  receipt_slug="$today-$lane-closed"
  receipt_what="lane $lane: $verdict ($resolution)"

  printf '\n@entry %s\n  ANCHOR: %s\n  WHAT: "%s"\n  THREAD: none\n' "$receipt_slug" "$cur_anc" "$receipt_what" >> "$s_dir/journal.md"

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_slug=$(escape_json "$receipt_slug")
  esc_what=$(escape_json "$receipt_what")
  printf '{"unit":"%s","lane":"%s","status":"RESOLVED","receipt_entry":{"slug":"%s","what":"%s"}}\n' \
    "$esc_unit" "$esc_lane" "$esc_slug" "$esc_what"
  return 0
}

resolve_ref() {
  unit="${1:-}"
  ref="${2:-}"
  if [ -z "$unit" ] || [ -z "$ref" ]; then
    printf 'resolve.ref: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "resolve.ref: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi

  # the typed forms (task#slug, finding#NAME, entry#slug, lane#<lane>/report#<claim>)
  # and the legacy file forms (backlog.md#slug, knowledge.md#NAME, journal.md#slug,
  # lanes/<lane>/report.md#<claim>) name the same entities
  entity_type=""
  entity_id=""
  lane_id=""
  case "$ref" in
    task#*|backlog#*|backlog.md#*) entity_type="task"; entity_id="${ref#*#}"; target_file="$s_dir/backlog.md" ;;
    finding#*|knowledge#*|knowledge.md#*) entity_type="finding"; entity_id="${ref#*#}"; target_file="$s_dir/knowledge.md" ;;
    entry#*|journal#*|journal.md#*) entity_type="entry"; entity_id="${ref#*#}"; target_file="$s_dir/journal.md" ;;
    lane#*/report#*)
      rr_rest="${ref#lane#}"
      lane_id="${rr_rest%%/report#*}"
      entity_id="${rr_rest#*/report#}"
      entity_type="lane_report"
      ;;
    lanes/*/report.md#*|lanes/*/report#*)
      rr_rest="${ref#lanes/}"
      lane_id="${rr_rest%%/*}"
      entity_id="${ref##*#}"
      entity_type="lane_report"
      ;;
  esac
  if [ -z "$entity_type" ] || [ -z "$entity_id" ]; then
    printf "resolve.ref: error: unsupported ref format: '%s' (ERR_INVALID_ARGUMENT)\n" "$ref" >&2
    return 1
  fi
  if [ "$entity_type" = "lane_report" ]; then
    if ! slug_valid "$lane_id"; then
      printf "resolve.ref: error: unsupported ref format: '%s' (ERR_INVALID_ARGUMENT)\n" "$ref" >&2
      return 1
    fi
    target_file="$s_dir/lanes/$lane_id/report.md"
  fi
  if [ ! -f "$target_file" ]; then
    printf "resolve.ref: error: reference '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$ref" "$unit" >&2
    return 1
  fi

  awk -v unit="$unit" -v full_ref="$ref" -v etype="$entity_type" -v eid="$entity_id" -v lane="$lane_id" '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function escape_json(s,    r) {
      r = bs_double(s); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); gsub(/\t/, "\\t", r); return r;
    }
    function head_id(line,   w, n, t) {
      n = split(line, w, /[ \t]+/)
      return w[2]
    }
    function is_head(line,   t) {
      if (etype == "task") return (line ~ /^@task[ \t]/ && head_id(line) == eid)
      if (etype == "finding") return (line ~ /^@finding[ \t]/ && head_id(line) == eid)
      if (etype == "entry") return (line ~ /^@entry[ \t]/ && head_id(line) == eid)
      t = line; sub(/[ \t\r]+$/, "", t)
      return (t == "@" eid || (line ~ /^@claim[ \t]/ && head_id(line) == eid))
    }
    { L[NR] = $0 }
    END {
      # the last occurrence answers, as entry.show reads a legacy repeated slug
      found = 0
      for (i = 1; i <= NR; i++) if (is_head(L[i])) found = i
      if (!found) exit 1
      e = found + 1
      while (e <= NR && L[e] !~ /^@[A-Za-z]/) e++
      e--
      block = ""
      for (i = found; i <= e; i++) block = block L[i] "\n"
      sum = ""; fref = ""; tstatus = ""; tobj = ""; ewhat = ""; insum = 0
      for (i = found + 1; i <= e; i++) {
        v = L[i]
        if (v ~ /^[ ]{2}SUMMARY ::/) { insum = 1; continue }
        if (insum && v ~ /^[ ]{4}/) { l = substr(v, 5); sum = (sum == "" ? l : sum "\n" l); continue }
        insum = 0
        if (v ~ /^[ ]{2}REF:[ ]*/) { sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2); fref = v }
        else if (v ~ /^[ ]{2}STATUS:[ ]*/) { sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/[ \t]+$/, "", v); tstatus = v }
        else if (v ~ /^[ ]{2}OBJECTIVE:[ ]*/) { sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/[ \t]+$/, "", v); if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2); tobj = v }
        else if (v ~ /^[ ]{2}WHAT:[ ]*/) { sub(/^[ ]{2}WHAT:[ ]*/, "", v); sub(/[ \t]+$/, "", v); if (v ~ /^".*"$/) v = substr(v, 2, length(v) - 2); ewhat = v }
      }
      if (etype == "finding") {
        tgt = sprintf("{\"name\":\"%s\",\"summary\":\"%s\",\"ref\":\"%s\"}", escape_json(eid), escape_json(sum), escape_json(fref))
      } else if (etype == "task") {
        tgt = sprintf("{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\"}", escape_json(eid), escape_json(tstatus), escape_json(tobj))
      } else if (etype == "entry") {
        tgt = sprintf("{\"slug\":\"%s\",\"what\":\"%s\"}", escape_json(eid), escape_json(ewhat))
      } else {
        tgt = sprintf("{\"lane\":\"%s\",\"claim\":\"%s\"}", escape_json(lane), escape_json(eid))
      }
      printf "{\"unit\":\"%s\",\"ref\":\"%s\",\"entity_type\":\"%s\",\"target\":%s,\"block\":\"%s\"}\n",
        escape_json(unit), escape_json(full_ref), etype, tgt, escape_json(block)
    }
  ' "$target_file"
  if [ $? -ne 0 ]; then
    printf "resolve.ref: error: reference '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$ref" "$unit" >&2
    return 1
  fi
  return 0
}

search_query() {
  unit="${1:-}"
  query="${2:-}"
  if [ $# -ge 2 ]; then shift 2; else shift $#; fi
  sq_limit=20
  sq_entity=""
  sq_mode="exact"
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *)
        printf "search.query: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$sq_a" >&2
        return 1
        ;;
    esac
  done
  if [ -z "$unit" ] || [ -z "$query" ]; then
    printf 'search.query: error: missing required arguments (unit, query) (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  case "$sq_limit" in
    ""|*[!0-9]*) printf "search.query: error: --limit takes a positive number: '%s' (ERR_INVALID_ARGUMENT)\n" "$sq_limit" >&2; return 1 ;;
  esac
  [ "$sq_limit" -ge 1 ] || { printf 'search.query: error: --limit takes a positive number (ERR_INVALID_ARGUMENT)\n' >&2; return 1; }
  case "$sq_entity" in
    ""|all|session|task|entry|finding|lane|lane_entry) ;;
    *) printf "search.query: error: unknown entity type '%s' (session, task, entry, finding, lane, lane_entry, all) (ERR_INVALID_ARGUMENT)\n" "$sq_entity" >&2; return 1 ;;
  esac
  # the posix driver searches by exact substring; the ranked modes belong to indexed drivers;
  # the awk runs in the C locale so the case rule (ASCII letters fold) holds on every awk
  case "$sq_mode" in
    exact) ;;
    hybrid|trigram) printf "search.query: error: mode '%s' is not supported by the posix driver; it searches exact substrings (ERR_CAPABILITY_UNSUPPORTED)\n" "$sq_mode" >&2; return 1 ;;
    *) printf "search.query: error: unknown mode '%s' (exact, hybrid, trigram) (ERR_INVALID_ARGUMENT)\n" "$sq_mode" >&2; return 1 ;;
  esac
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "search.query: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi

  set --
  for sq_f in state backlog knowledge journal; do
    [ -f "$s_dir/$sq_f.md" ] && set -- "$@" "$s_dir/$sq_f.md"
  done
  if [ -d "$s_dir/lanes" ]; then
    for sq_l in "$s_dir"/lanes/*; do
      [ -d "$sq_l" ] || continue
      for sq_f in recipe journal report; do
        [ -f "$sq_l/$sq_f.md" ] && set -- "$@" "$sq_l/$sq_f.md"
      done
    done
  fi

  if [ $# -eq 0 ]; then
    SQ_QUERY="$query" LC_ALL=C awk -v unit="$unit" -v limit="$sq_limit" -v entity="$sq_entity" -f "$SCRIPT_DIR/search.awk" /dev/null
  else
    SQ_QUERY="$query" LC_ALL=C awk -v unit="$unit" -v limit="$sq_limit" -v entity="$sq_entity" -f "$SCRIPT_DIR/search.awk" "$@"
  fi
  return 0
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

# every method: argv = the method and its identifiers; the free-text fields arrive on
# stdin as the payload (payload_load, pget); the single-document writes read raw stdin
case "$cmd" in
  capability)
    capability
    ;;
  storage.health)
    storage_health
    ;;
  artifact.read)
    artifact_read "$@"
    ;;
  artifact.write)
    artifact_write "$@"
    ;;
  artifact.list)
    artifact_list "$@"
    ;;
  session.create)
    session_create "$@"
    ;;
  session.init)
    payload_load; pget p_obj objective
    session_init "${1:-}" "${p_obj:-new unit}"
    ;;
  session.load)
    session_load "$@"
    ;;
  session.board)
    session_board "$@"
    ;;
  session.stamp)
    payload_load; pget p_att attention
    session_stamp "${1:-}" "${p_att:-session stamp}"
    ;;
  session.pointer)
    payload_load; pget p_ptr pointer
    session_pointer "${1:-}" "$p_ptr"
    ;;
  session.refs)
    session_refs "$@"
    ;;
  session.close)
    session_close "$@"
    ;;
  session.list)
    session_list "$@"
    ;;
  session.audit)
    session_audit "$@"
    ;;
  task.add)
    payload_load; pget p_obj objective; pget p_desc desc; pget p_crit criteria; pget p_det details; pget p_refs refs
    task_add "${1:-}" "${2:-}" "$p_obj" "$p_desc" "$p_crit" "$p_det" "$p_refs"
    ;;
  task.update)
    for tu_a in "$@"; do
      case "$tu_a" in
        --*) printf 'task.update: error: invalid argument: %s (ERR_INVALID_ARGUMENT)\n' "$tu_a" >&2; exit 1 ;;
      esac
    done
    payload_load; pget p_obj objective; pget p_desc desc; pget p_crit criteria; pget p_det details
    task_update "${1:-}" "${2:-}" "$p_obj" "$p_desc" "$p_crit" "$p_det"
    ;;
  task.start)
    payload_load; pget p_ptr pointer
    task_start "${1:-}" "${2:-}" "$p_ptr"
    ;;
  task.complete)
    payload_load; pget p_ev evidence
    task_complete "${1:-}" "${2:-}" "${p_ev:-verified}"
    ;;
  task.reopen)
    task_reopen "$@"
    ;;
  task.drop)
    payload_load; pget p_rsn reason
    task_drop "${1:-}" "${2:-}" "${p_rsn:-Deprecating task}"
    ;;
  task.list)
    task_list "$@"
    ;;
  task.show)
    task_show "$@"
    ;;
  entry.record)
    payload_load; pget p_what what; pget p_grp group; pget p_th thread; pget p_cl closes; pget p_ref ref
    entry_record "${1:-}" "${2:-}" "$p_what" "$p_grp" "${p_th:-none}" "$p_cl" "$p_ref"
    ;;
  entry.show)
    entry_show "$@"
    ;;
  entry.list)
    entry_list "$@"
    ;;
  entry.anchors)
    entry_anchors "$@"
    ;;
  finding.add)
    payload_load; pget p_sum summary; pget p_ref ref; pget p_sup supersedes
    finding_add "${1:-}" "${2:-}" "$p_sum" "$p_ref" "$p_sup"
    ;;
  finding.show)
    finding_show "$@"
    ;;
  finding.list)
    finding_list "$@"
    ;;
  finding.update)
    payload_load; pget p_sum summary; pget p_ref ref
    finding_update "${1:-}" "${2:-}" "$p_sum" "$p_ref"
    ;;
  finding.supersede)
    payload_load; pget p_sum summary; pget p_ref ref
    finding_supersede "${1:-}" "${2:-}" "${3:-}" "$p_sum" "$p_ref"
    ;;
  finding.drop)
    finding_drop "$@"
    ;;
  lane.create)
    payload_load; pget p_goal goal; pget p_rcp recipe
    lane_create "${1:-}" "${2:-}" "$p_goal" "$p_rcp"
    ;;
  lane.record)
    payload_load; pget p_what what; pget p_th thread
    lane_record "${1:-}" "${2:-}" "${3:-}" "$p_what" "${p_th:-none}"
    ;;
  lane.report)
    lane_report "$@"
    ;;
  lane.show)
    lane_show "$@"
    ;;
  lane.status)
    lane_status "$@"
    ;;
  lane.close)
    payload_load; pget p_res resolution
    lane_close "${1:-}" "${2:-}" "${3:-COMPLETE}" "${p_res:-lane closed}"
    ;;
  resolve.ref)
    resolve_ref "$@"
    ;;
  search.query)
    payload_load; pget p_q query
    sq_u="${1:-}"
    [ $# -gt 0 ] && shift
    search_query "$sq_u" "$p_q" "$@"
    ;;
  *)
    printf "posix-driver: error: unknown subsystem or method '%s' (ERR_CAPABILITY_UNSUPPORTED)\n" "$cmd" >&2
    exit 2
    ;;
esac
