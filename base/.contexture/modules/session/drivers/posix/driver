    for s_path in "$s_root"/*; do
      [ -d "$s_path" ] || continue
      u=$(basename "$s_path")
      slug_valid "$u" || continue
      st_file="$s_path/state.md"
      # a unit without a state carries no status (it is neither ACTIVE nor CLOSED)
      st=""
      if [ -f "$st_file" ]; then
        st=$(awk '/^status:/ { v = $0; sub(/^status:[ \t]*/, "", v); sub(/[ \t\r]+$/, "", v); print v; exit }' "$st_file")
