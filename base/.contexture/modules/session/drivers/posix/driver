    }
    BEGIN {
      found = 0; in_target = 0; anchor = ""; what = ""; group = ""; thread = "";
      closed = 0; closed_by = ""; close_reason = "";
      cur_entry = "";
    }
    /^@entry[ ]+/ {
      line = $0; sub(/^@entry[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_entry = line;
      if (cur_entry == target) {
        found = 1; in_target = 1;
      } else {
        in_target = 0;
      }
      next;
    }
    in_target && /^[ ]{2}ANCHOR:[ ]*/ {
      v = $0; sub(/^[ ]{2}ANCHOR:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
