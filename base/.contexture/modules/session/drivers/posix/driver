#!/bin/sh
# driver: the zero-dependency POSIX storage driver (contract 2, docs/the-engine.md, The
# storage contract). The record lives as markdown files under .contexture/sessions/<unit>/
# (state.md, backlog.md, knowledge.md, journal.md, lanes/<lane>/recipe.md, journal.md,
# report.md), and this driver is the only code that touches them. It answers the 38 record
# functions (argv identifiers, the escaped key=value payload on stdin with indexed list
# keys, one compact JSON answer in the contract key order, one fixed stderr line per
# refusal) through awk programs beside it: canon.awk (the canonical renderer and the JSON
# string form), model.awk (the parse rules into typed items holding all of their content,
# the derived fields, the JSON of the schemas), ops.awk (the functions: the record rules, the
# append rule, a touched item rewritten canonical in place), search.awk (the exact rule over
# the rendered text). Every item reads in the canonical layout; a file keeps its bytes until
# a write touches one of its items. It keeps
# the six corpus methods of v0.54.0 byte for byte (corpus.store).
#
# Writes: the unit lock (.contexture/tmp/locks/<unit>.lock) is held from the read to the
# last rename, every changed file is staged beside the sessions folder and renamed into
# place (one mv per file, each replaced file hard-linked into the stage first so a failed
# rename or an interrupt rolls the earlier ones back), and the answer prints only after
# every file landed; a refusal stages nothing. Every awk runs in the C locale (bytes) and takes every value through the
# environment or a file, never through awk -v.

set -u

SCRIPT_DIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
LC_ALL=C
export LC_ALL

find_workspace_root() {
  curr="$PWD"
  while [ -n "$curr" ] && [ "$curr" != "/" ]; do
    if [ -d "$curr/.contexture" ]; then
      printf '%s\n' "$curr"
      return 0
    fi
    curr=$(dirname "$curr")
  done
  printf '%s\n' "$PWD"
}

get_tmp_dir() {
  ws=$(find_workspace_root)
  if [ -d "$ws/.contexture/tmp" ] && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  elif mkdir -p "$ws/.contexture/tmp" 2>/dev/null && [ -w "$ws/.contexture/tmp" ]; then
    printf '%s/.contexture/tmp\n' "$ws"
  else
    d="${TMPDIR:-/tmp}/contexture-$USER"
    mkdir -p "$d" 2>/dev/null || true
    printf '%s\n' "$d"
  fi
}

get_lock_dir() {
  tmp_d=$(get_tmp_dir)
  mkdir -p "$tmp_d/locks" 2>/dev/null || true
  printf '%s/locks\n' "$tmp_d"
}

escape_json() {
  # every escape is written by split and concatenation (bs_double, sjoin), never by a gsub
  # replacement: awk builds read a backslash inside a replacement differently (busybox awk
  # and gawk --posix yield one backslash from four, Debian's busybox awk drops the backslash
  # before a quote, r, or t)
  printf '%s' "$1" | awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    function sjoin(s, sep, lit,    n, p, i, o) { n = split(s, p, sep); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o lit p[i]; return o }
    BEGIN { ORS="" }
    {
      if (NR > 1) printf "\\n";
      s = bs_double($0);
      s = sjoin(s, "[\"]", "\\" "\"");
      s = sjoin(s, "[\r]", "\\" "r");
      s = sjoin(s, "[\t]", "\\" "t");
      printf "%s", s;
    }
  '
}

# The corpus store (capability corpus.store): the agent-facing doc corpus beside the
# record, a doc keyed by (repo, slug) and kept verbatim, its canonical address
# docs/<repo>/<slug>.md. The posix layout is the reference serialization: the files at
# <root>/docs/<repo>/<slug>.md, exactly as the docs verbs read them, so corpus.mount
# answers with the workspace root and copies nothing. The driver never parses a doc; the
# grammar stays in the docs verbs. No change log here (corpus.changelog is a store
# driver's): the posix corpus delta is git, so --op and --head are checked and ignored
# and corpus.changes refuses. Every message names the doc as <repo>/<slug>, never a path.
corpus_key_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

# corpus_keys <method> <repo> <slug>: both keys valid, else rc 1 with the method named
corpus_keys() {
  if [ -z "$2" ] || [ -z "$3" ]; then
    printf '%s: error: missing required arguments (repo, slug) (ERR_INVALID_ARGUMENT)\n' "$1" >&2
    return 1
  fi
  corpus_key_valid "$2" || { printf "%s: error: malformed repo '%s' (ERR_INVALID_ARGUMENT)\n" "$1" "$2" >&2; return 1; }
  corpus_key_valid "$3" || { printf "%s: error: malformed slug '%s' (ERR_INVALID_ARGUMENT)\n" "$1" "$3" >&2; return 1; }
  return 0
}

# corpus_flags <method> <default op> [flags]: --create, --op=<op>, --head=<sha>|none, bounded
# tokens only; sets CF_CREATE and CF_OP; an unknown flag or a malformed token refuses rc 1
corpus_flags() {
  cf_m="$1"; CF_OP="$2"; CF_CREATE=0
  shift 2
  for cf_a in "$@"; do
    case "$cf_a" in
      --create)
        [ "$cf_m" = corpus.write ] || { printf "%s: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$cf_a" >&2; return 1; }
        CF_CREATE=1 ;;
      --op=*)
        CF_OP="${cf_a#--op=}"
        case "$CF_OP" in
          new|write|header|rule|pitfall|entry|section|replace|remove|ids) ;;
          *) printf "%s: error: unknown op '%s' (new, write, header, rule, pitfall, entry, section, replace, remove, ids) (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$CF_OP" >&2; return 1 ;;
        esac
        ;;
      --head=*)
        cf_h="${cf_a#--head=}"
        case "$cf_h" in
          none) ;;
          ""|*[!0-9a-fA-F]*) printf "%s: error: --head takes a commit id or none: '%s' (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$cf_h" >&2; return 1 ;;
        esac
        ;;
      *) printf "%s: error: unknown argument '%s' (ERR_INVALID_ARGUMENT)\n" "$cf_m" "$cf_a" >&2; return 1 ;;
    esac
  done
  return 0
}

# corpus.list [<repo>]: one <repo>/<slug> line per doc, in the bytewise order of the docs'
# canonical addresses (docs/<repo>/<slug>.md, the order a C-locale glob of the files
# gives, so one-two sorts before one); an empty corpus
# lists nothing (rc 0); a named repo the corpus lacks refuses rc 1. A doc is a regular
# file at depth two under docs/ whose folder and base name are valid keys (the guides at
# depth one, temps, and dot files are never docs). Both path parts are globbed, so every
# name is read from the folder entries as stored and a repo filter keeps the exact repo:
# a literal folder name would open a case twin on a case-insensitive filesystem
corpus_list() {
  if [ $# -gt 1 ]; then
    printf 'corpus.list: error: takes at most one argument, the repo (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  cl_repo="${1:-}"
  if [ -n "$cl_repo" ] && ! corpus_key_valid "$cl_repo"; then
    printf "corpus.list: error: malformed repo '%s' (ERR_INVALID_ARGUMENT)\n" "$cl_repo" >&2
    return 1
  fi
  ws=$(find_workspace_root)
  cl_out=$(
    set -- "$ws"/docs/*/*.md
    for cl_f in "$@"; do
      [ -f "$cl_f" ] || continue
      cl_s=${cl_f##*/}; cl_s=${cl_s%.md}
      cl_r=${cl_f%/*}; cl_r=${cl_r##*/}
      [ -z "$cl_repo" ] || [ "$cl_r" = "$cl_repo" ] || continue
      corpus_key_valid "$cl_r" && corpus_key_valid "$cl_s" && printf '%s/%s.md\n' "$cl_r" "$cl_s"
    done | LC_ALL=C sort | sed 's/\.md$//'
  )
  if [ -n "$cl_repo" ] && [ -z "$cl_out" ]; then
    printf "corpus.list: error: repo '%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$cl_repo" >&2
    return 1
  fi
  [ -n "$cl_out" ] && printf '%s\n' "$cl_out"
  return 0
}

# corpus_exact <repo> <slug>: rc 0 when the corpus lists exactly <repo>/<slug>, else rc 1.
# The listing reads every name from the folder entries as stored, so a case twin that a
# case-insensitive filesystem would open for a stored doc never matches: read and remove
# act on the exact key alone, as a store driver's lookup does
corpus_exact() {
  corpus_list 2>/dev/null | CE_KEY="$1/$2" awk '$0 == ENVIRON["CE_KEY"] { f = 1; exit } END { exit !f }'
}

# corpus.read <repo> <slug>: the doc byte for byte; rc 1 when absent (a case twin of a
# stored key is absent)
corpus_read() {
  if [ $# -gt 2 ]; then
    printf 'corpus.read: error: takes two arguments, repo and slug (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  corpus_keys corpus.read "${1:-}" "${2:-}" || return 1
  ws=$(find_workspace_root)
  cr_f="$ws/docs/$1/$2.md"
  if ! corpus_exact "$1" "$2"; then
    printf "corpus.read: error: doc '%s/%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$1" "$2" >&2
    return 1
  fi
  cat "$cr_f" || { printf "corpus.read: error: doc '%s/%s' is unreadable (ERR_STORAGE_READ)\n" "$1" "$2" >&2; return 2; }
  return 0
}

# corpus_twin <repo> <slug>: the key of a doc that folds onto <repo>/<slug> under ASCII case
# without matching it exactly (its repo alone, or its slug inside the same repo), else
# nothing: keys differing only by case never coexist, since a case-insensitive filesystem
# holds them in one file and a store's mount would fold them into one
corpus_twin() {
  corpus_list 2>/dev/null | CT_KEY="$1/$2" LC_ALL=C awk -F/ '
    BEGIN {
      k = ENVIRON["CT_KEY"]; p = index(k, "/")
      r = substr(k, 1, p - 1); s = substr(k, p + 1); lr = tolower(r); ls = tolower(s)
    }
    $0 != k && tolower($1) == lr && ($1 != r || tolower($2) == ls) { print; exit }'
}

# corpus.write <repo> <slug> [--create] [--op=<op>] [--head=<sha>|none]: the whole doc raw on
# stdin replaces the stored one (a new doc when absent, its repo folder made on demand);
# --create refuses an existing doc rc 1; a key folding onto another doc's or repo's under
# ASCII case refuses rc 1, nothing written, and that pass runs before the --create probe,
# so a stored doc's case twin is refused before the probe's file test; a same-directory temp moved over
# the doc, so a failed write leaves the old doc whole and prints no success (rc 2)
corpus_write() {
  cw_repo="${1:-}"; cw_slug="${2:-}"
  if [ $# -ge 2 ]; then shift 2; else shift $#; fi
  corpus_keys corpus.write "$cw_repo" "$cw_slug" || return 1
  corpus_flags corpus.write write "$@" || return 1
  ws=$(find_workspace_root)
  cw_twin=$(corpus_twin "$cw_repo" "$cw_slug")
  if [ -n "$cw_twin" ]; then
    printf "corpus.write: error: doc '%s/%s' folds onto '%s' under ASCII case; keys differing only by case never coexist (ERR_ENTITY_EXISTS)\n" "$cw_repo" "$cw_slug" "$cw_twin" >&2
    return 1
  fi
  cw_f="$ws/docs/$cw_repo/$cw_slug.md"
  if [ "$CF_CREATE" -eq 1 ] && [ -e "$cw_f" ]; then
    printf "corpus.write: error: doc '%s/%s' already exists in the corpus (ERR_ENTITY_EXISTS)\n" "$cw_repo" "$cw_slug" >&2
    return 1
  fi
  if ! mkdir -p "$ws/docs/$cw_repo" 2>/dev/null; then
    printf "corpus.write: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cw_repo" "$cw_slug" >&2
    return 2
  fi
  cw_tmp=$(mktemp "$cw_f.XXXXXX" 2>/dev/null) || {
    printf "corpus.write: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cw_repo" "$cw_slug" >&2
    return 2
  }
  # a doc is an ordinary file of the tree: the umask's file mode, never the temp's 0600
  chmod "$(umask -S | tr -d x)" "$cw_tmp" 2>/dev/null || true
  if ! cat > "$cw_tmp" || ! mv -f "$cw_tmp" "$cw_f" 2>/dev/null; then
    rm -f "$cw_tmp"
    printf "corpus.write: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cw_repo" "$cw_slug" >&2
    return 2
  fi
  printf '{"status":"ok","repo":"%s","slug":"%s","op":"%s"}\n' "$(escape_json "$cw_repo")" "$(escape_json "$cw_slug")" "$CF_OP"
  return 0
}

# corpus.remove <repo> <slug> [--op=<op>] [--head=<sha>|none]: removes the doc, and its repo
# folder when that empties; rc 1 when absent (a case twin of a stored key is absent, and
# the stored doc stays)
corpus_remove() {
  cx_repo="${1:-}"; cx_slug="${2:-}"
  if [ $# -ge 2 ]; then shift 2; else shift $#; fi
  corpus_keys corpus.remove "$cx_repo" "$cx_slug" || return 1
  corpus_flags corpus.remove remove "$@" || return 1
  ws=$(find_workspace_root)
  cx_f="$ws/docs/$cx_repo/$cx_slug.md"
  if ! corpus_exact "$cx_repo" "$cx_slug"; then
    printf "corpus.remove: error: doc '%s/%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$cx_repo" "$cx_slug" >&2
    return 1
  fi
  if ! rm -f "$cx_f" 2>/dev/null || [ -e "$cx_f" ]; then
    printf "corpus.remove: error: the storage write of doc '%s/%s' failed (ERR_STORAGE_WRITE)\n" "$cx_repo" "$cx_slug" >&2
    return 2
  fi
  rmdir "$ws/docs/$cx_repo" 2>/dev/null || true
  printf '{"status":"ok","repo":"%s","slug":"%s","op":"%s"}\n' "$(escape_json "$cx_repo")" "$(escape_json "$cx_slug")" "$CF_OP"
  return 0
}

# corpus.mount <dest> [<repo>]: one line, the root under which every doc reads at
# docs/<repo>/<slug>.md; <dest> is the empty folder the caller made (a store driver fills
# it and prints it; the caller removes it); posix prints the workspace root and writes
# nothing; a named repo the corpus lacks refuses rc 1, as corpus.list does
corpus_mount() {
  cm_dest="${1:-}"; cm_repo="${2:-}"
  if [ $# -gt 2 ]; then
    printf 'corpus.mount: error: takes the destination folder and at most a repo (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  if [ -z "$cm_dest" ] || [ ! -d "$cm_dest" ]; then
    printf 'corpus.mount: error: the destination must be an existing empty folder the caller made (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  if [ -n "$(ls -A "$cm_dest" 2>/dev/null)" ]; then
    printf 'corpus.mount: error: the destination folder is not empty (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  if [ -n "$cm_repo" ]; then
    corpus_list "$cm_repo" > /dev/null 2>&1 || {
      if corpus_key_valid "$cm_repo"; then
        printf "corpus.mount: error: repo '%s' not found in the corpus (ERR_ENTITY_NOT_FOUND)\n" "$cm_repo" >&2
      else
        printf "corpus.mount: error: malformed repo '%s' (ERR_INVALID_ARGUMENT)\n" "$cm_repo" >&2
      fi
      return 1
    }
  fi
  find_workspace_root
  return 0
}

# corpus.changes: the change log belongs to a store driver (corpus.changelog); the posix
# corpus delta is git, so the method refuses without reading its head payload
corpus_changes() {
  printf 'corpus.changes: error: the posix driver keeps no corpus change log; its corpus delta is git (ERR_CAPABILITY_UNSUPPORTED)\n' >&2
  return 1
}

# ==============================================================================
# The record functions (contract 2)
# ==============================================================================
FN=""
SCR=""
STAGE=""
PX_LOCK=""
PC_ON=0
PC_N=0
px_cleanup() {
  # a commit cut short (a failed rename, an interrupt) rolls back what it renamed, so a
  # write lands whole or not at all (R20); the backups live in the stage, removed after
  [ "$PC_ON" -eq 1 ] && pc_rollback
  [ -n "$SCR" ] && rm -rf "$SCR"
  [ -n "$STAGE" ] && rm -rf "$STAGE"
  [ -n "$PX_LOCK" ] && rm -rf "$PX_LOCK" 2>/dev/null
  [ -n "$PAYLOAD_FILE" ] && rm -f "$PAYLOAD_FILE"
  return 0
}
PAYLOAD_FILE=""
trap px_cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# refuse <rc> <CODE> <message>: the one fixed stderr line of a refusal
refuse() {
  printf '%s: error: %s (%s)\n' "$FN" "$3" "$2" >&2
  exit "$1"
}

ident_valid() {
  case "$1" in
    ""|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) return 1 ;;
  esac
  return 0
}

# the entry slug and the finding NAME a read addresses: the legacy shapes stay addressable
name_valid() {
  case "$1" in
    ""|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac
  return 0
}

# px_mkdtemp <parent> <prefix>: a fresh private folder (mkdir is atomic; the name carries the
# pid and a counter), POSIX tools alone, no mktemp
px_mkdtemp() {
  pm_n=0
  while [ "$pm_n" -lt 100 ]; do
    pm_d="$1/$2.$$.$pm_n"
    if mkdir -m 700 "$pm_d" 2>/dev/null; then printf '%s\n' "$pm_d"; return 0; fi
    pm_n=$((pm_n + 1))
  done
  return 1
}

px_init() {
  WS=$(find_workspace_root)
  SESS="$WS/.contexture/sessions"
  tmp_d=$(get_tmp_dir)
  SCR=$(px_mkdtemp "$tmp_d" posix) || refuse 2 ERR_STORAGE_WRITE "cannot create the driver's scratch folder"
  : > "$SCR/man"
  : > "$SCR/files"
  : > "$SCR/err"
}

want_unit() {
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  ident_valid "$1" || refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$1'"
}

# held <unit>: the store holds the unit (its folder holds a state)
held() { [ -f "$SESS/$1/state.md" ]; }

want_held() {
  want_unit "$1"
  held "$1" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$1' not found"
}

# the manifest: F lines (key, path) with the sizes one wc answers, U lines per unit held,
# L lines per lane of a unit (a lane folder holding at least one artifact), in bytewise
# order (the C locale's glob)
man_file() {
  if [ -f "$2" ]; then
    printf 'F\t%s\t%s\n' "$1" "$2" >> "$SCR/man"
    printf '%s\n' "$2" >> "$SCR/files"
  fi
}

man_unit() {
  mu_d="$SESS/$1"
  [ -f "$mu_d/state.md" ] || return 0
  printf 'U\t%s\n' "$1" >> "$SCR/man"
  man_file "$1|state" "$mu_d/state.md"
  case " $2 " in *" backlog "*) man_file "$1|backlog" "$mu_d/backlog.md" ;; esac
  case " $2 " in *" knowledge "*) man_file "$1|knowledge" "$mu_d/knowledge.md" ;; esac
  case " $2 " in *" journal "*) man_file "$1|journal" "$mu_d/journal.md" ;; esac
  if [ -d "$mu_d/lanes" ]; then
    for mu_l in "$mu_d"/lanes/*; do
      [ -d "$mu_l" ] || continue
      mu_n=${mu_l##*/}
      ident_valid "$mu_n" || continue
      # a lane is its artifacts (end review item 8): a folder holding no recipe, journal,
      # or report is no lane, whatever other files it holds (lane.get refuses it, every
      # listing skips it, lane.create of the name lands beside those files)
      [ -f "$mu_l/recipe.md" ] || [ -f "$mu_l/journal.md" ] || [ -f "$mu_l/report.md" ] || continue
      printf 'L\t%s\t%s\n' "$1" "$mu_n" >> "$SCR/man"
      case " $2 " in
        *" lanes "*|*" lane:$mu_n "*)
          man_file "$1|lane/$mu_n/recipe" "$mu_l/recipe.md"
          man_file "$1|lane/$mu_n/journal" "$mu_l/journal.md"
          man_file "$1|lane/$mu_n/report" "$mu_l/report.md"
          ;;
      esac
    done
  fi
}

# man_all_units [<parts>]: every unit the store holds, bytewise
man_all_units() {
  [ -d "$SESS" ] || return 0
  for ma_d in "$SESS"/*; do
    [ -d "$ma_d" ] || continue
    ma_u=${ma_d##*/}
    ident_valid "$ma_u" || continue
    man_unit "$ma_u" "${1:-}"
  done
}

man_sizes() {
  : > "$SCR/sizes"
  [ -s "$SCR/files" ] || return 0
  set --
  while IFS= read -r ms_p; do set -- "$@" "$ms_p"; done < "$SCR/files"
  wc -c "$@" > "$SCR/sizes" 2>/dev/null || refuse 2 ERR_STORAGE_READ "cannot read the unit's artifacts"
}

payload_stage() {
  PAYLOAD_FILE="$SCR/payload"
  cat > "$PAYLOAD_FILE" || refuse 2 ERR_STORAGE_READ "cannot read the payload"
}

# px_awk <program files...>: one awk run over the manifest; its refusal passes through
px_awk() {
  man_sizes
  PX_FN="$FN" PX_UNIT="${PX_UNIT:-}" PX_MAN="$SCR/man" PX_SIZES="$SCR/sizes" PX_PAY="${PAYLOAD_FILE:-}" \
    PX_ERR="$SCR/err" PX_STAGE="${STAGE:-}" PX_OUT="${PX_OUT:-}" \
    awk -f "$SCRIPT_DIR/canon.awk" -f "$SCRIPT_DIR/model.awk" -f "$SCRIPT_DIR/ops.awk"
  pa_rc=$?
  if [ "$pa_rc" -ne 0 ]; then
    if [ -s "$SCR/err" ]; then cat "$SCR/err" >&2; else printf '%s: error: the record engine failed (rc %s) (ERR_STORAGE_READ)\n' "$FN" "$pa_rc" >&2; pa_rc=2; fi
    exit "$pa_rc"
  fi
}

px_lock() {
  pl_dir=$(get_lock_dir)
  pl_t="$pl_dir/$1.lock"
  pl_n=0
  while [ "$pl_n" -lt 50 ]; do
    if mkdir "$pl_t" 2>/dev/null; then PX_LOCK="$pl_t"; return 0; fi
    pl_n=$((pl_n + 1))
    sleep 0.1 2>/dev/null || sleep 1
  done
  refuse 2 ERR_STORAGE_LOCKED "the unit lock of '$1' is held (5 s timeout)"
}

px_stage() {
  mkdir -p "$SESS" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "cannot create the sessions folder"
  STAGE=$(px_mkdtemp "$SESS" .stage) || refuse 2 ERR_STORAGE_WRITE "cannot stage the write"
  PX_OUT="$SCR/answer"
}

# the commit's undo log: PC_K_<n> (f a file replaced or created, d a folder created),
# PC_P_<n> its path, PC_B_<n> the backup of the file it replaced ("" when it was new)
pc_note() {
  PC_N=$((PC_N + 1))
  eval "PC_K_$PC_N=\$1; PC_P_$PC_N=\$2; PC_B_$PC_N=\${3:-}"
}

# pc_dir <folder>: the folder made when absent, noted so a rollback removes it again
pc_dir() {
  [ -d "$1" ] && return 0
  pd_up=$(dirname "$1")
  pc_dir "$pd_up" || return 1
  pc_note d "$1"
  mkdir "$1" 2>/dev/null || [ -d "$1" ] || return 1
}

# pc_backup <path>: a hard link of the file about to be replaced or removed, kept in the
# stage (the same filesystem), a copy where the link is refused; prints the backup path
pc_backup() {
  [ -f "$1" ] || { printf '\n'; return 0; }
  pb_b="$STAGE/.bak.$((PC_N + 1))"
  ln "$1" "$pb_b" 2>/dev/null || cp -p "$1" "$pb_b" 2>/dev/null || return 1
  printf '%s\n' "$pb_b"
}

# pc_rollback: every noted step undone, the last first: a replaced file gets its backup
# back, a created file and a created folder go
pc_rollback() {
  PC_ON=0
  while [ "$PC_N" -gt 0 ]; do
    eval "pr_k=\$PC_K_$PC_N; pr_p=\$PC_P_$PC_N; pr_b=\$PC_B_$PC_N"
    case "$pr_k" in
      f) if [ -n "$pr_b" ]; then mv -f "$pr_b" "$pr_p" 2>/dev/null; else rm -f "$pr_p" 2>/dev/null; fi ;;
      d) rmdir "$pr_p" 2>/dev/null ;;
    esac
    PC_N=$((PC_N - 1))
  done
}

# px_commit <unit folder>: every staged step applied in manifest order (one mv per file, a
# removal, a folder), then the answer; each replaced or removed file is backed up first, so a
# failed step (rc 2 ERR_STORAGE_WRITE, no answer) or an interrupt rolls every earlier step
# back and the unit reads as before (R20)
px_commit() {
  pc_ud=$1
  PC_ON=1
  if [ -f "$STAGE/manifest" ]; then
    while IFS='	' read -r pc_src pc_rel; do
      case "$pc_src" in
        d) pc_dir "$pc_ud/$pc_rel" || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed" ;;
        -)
          [ -f "$pc_ud/$pc_rel" ] || continue
          pc_b=$(pc_backup "$pc_ud/$pc_rel") || refuse 2 ERR_STORAGE_WRITE "the storage removal of $pc_rel failed"
          # noted before the step: an interrupt landing right after it still undoes it
          pc_note f "$pc_ud/$pc_rel" "$pc_b"
          rm -f "$pc_ud/$pc_rel" 2>/dev/null && [ ! -f "$pc_ud/$pc_rel" ] || refuse 2 ERR_STORAGE_WRITE "the storage removal of $pc_rel failed"
          ;;
        *)
          pc_dir "$(dirname "$pc_ud/$pc_rel")" || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed"
          pc_b=$(pc_backup "$pc_ud/$pc_rel") || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed"
          pc_note f "$pc_ud/$pc_rel" "$pc_b"
          mv -f "$STAGE/$pc_src" "$pc_ud/$pc_rel" 2>/dev/null || refuse 2 ERR_STORAGE_WRITE "the storage write of $pc_rel failed"
          ;;
      esac
    done < "$STAGE/manifest"
  fi
  PC_ON=0
  cat "$SCR/answer"
}

# px_extra <n> <argv...>: no argument beyond the n the function takes
px_extra() {
  pe_n=$1
  shift
  [ $# -le "$pe_n" ] || refuse 1 ERR_INVALID_ARGUMENT "unexpected argument '$(eval "printf '%s' \"\${$((pe_n + 1))}\"")'"
}

px_args() {
  PX_NA=0
  export PX_NA
  for pa_a in "$@"; do
    PX_NA=$((PX_NA + 1))
    eval "PX_A$PX_NA=\$pa_a; export PX_A$PX_NA"
  done
}

# rec_read <function> <unit> <parts> <argv after the unit...>: a read of one held unit
rec_read() {
  FN=$1; want_held "$2"
  PX_UNIT=$2; export PX_UNIT
  man_unit "$2" "$3"
  shift 3
  px_args "$@"
  px_awk
}

# rec_write <function> <unit> <parts> <argv after the unit...>: a write of one held unit
rec_write() {
  FN=$1; want_held "$2"
  PX_UNIT=$2; export PX_UNIT
  rw_parts=$3
  shift 3
  px_args "$@"
  payload_stage
  px_lock "$PX_UNIT"
  px_stage
  man_unit "$PX_UNIT" "$rw_parts"
  px_awk
  px_commit "$SESS/$PX_UNIT"
}

capability() {
  printf '{"driver":"posix","version":"2.0.0","contract":"2","functions":["capability","storage.health","session.create","session.list","session.load","session.refload","session.board","session.audit","session.stamp","session.next","session.refs","session.close","session.reopen","session.units","session.refs_to","task.add","task.update","task.start","task.complete","task.reopen","task.drop","task.list","task.get","entry.record","entry.get","entry.list","entry.closure","finding.add","finding.update","finding.supersede","finding.drop","finding.get","finding.list","lane.create","lane.record","lane.write_report","lane.get","search.query","corpus.list","corpus.read","corpus.write","corpus.remove","corpus.mount","corpus.changes"],"search_modes":["exact"],"optional":["corpus.store"]}\n'
}

storage_health() {
  sh_health="ok"
  if [ ! -d "$SESS" ]; then
    sh_health="degraded"
    sh_detail="sessions directory does not exist yet (will be created on bootstrap)"
  elif [ ! -w "$SESS" ]; then
    sh_health="error"
    sh_detail="sessions directory is not writable"
  else
    sh_detail="sessions directory writable, unlocked"
    if [ -d "$SESS/.lock" ]; then
      sh_health="locked"
      sh_detail="storage lock active"
    fi
  fi
  man_all_units ""
  PX_HEALTH=$sh_health PX_DETAIL=$sh_detail px_awk
}

search_query() {
  want_unit "${1:-}"
  sq_u=$1
  shift
  sq_limit=20
  sq_entity=all
  sq_mode=exact
  for sq_a in "$@"; do
    case "$sq_a" in
      --limit=*) sq_limit="${sq_a#--limit=}" ;;
      --entity=*) sq_entity="${sq_a#--entity=}" ;;
      --mode=*) sq_mode="${sq_a#--mode=}" ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$sq_a'" ;;
    esac
  done
  case "$sq_limit" in
    ""|*[!0-9]*|0) refuse 1 ERR_INVALID_ARGUMENT "--limit takes a positive number: '$sq_limit'" ;;
  esac
  case "$sq_entity" in
    all|session|task|entry|finding|lane|lane_entry) ;;
    *) refuse 1 ERR_INVALID_ARGUMENT "unknown entity type '$sq_entity' (session, task, entry, finding, lane, lane_entry, all)" ;;
  esac
  case "$sq_mode" in
    ""|[!a-z]*|*[!a-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed mode '$sq_mode'" ;;
  esac
  held "$sq_u" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sq_u' not found"
  payload_stage
  # the searched text is the rendered one: the unit parsed whole, every item's canonical span
  man_unit "$sq_u" "backlog knowledge journal lanes"
  man_sizes
  PX_PAY="$PAYLOAD_FILE" PX_ERR="$SCR/err" PX_MAN="$SCR/man" PX_SIZES="$SCR/sizes" SQ_UNIT="$sq_u" SQ_LIMIT="$sq_limit" SQ_ENTITY="$sq_entity" SQ_MODE="$sq_mode" \
    awk -f "$SCRIPT_DIR/canon.awk" -f "$SCRIPT_DIR/model.awk" -f "$SCRIPT_DIR/search.awk" < /dev/null > "$SCR/answer"
  sq_rc=$?
  if [ "$sq_rc" -ne 0 ]; then
    if [ -s "$SCR/err" ]; then cat "$SCR/err" >&2; else printf '%s: error: the search failed (rc %s) (ERR_STORAGE_READ)\n' "$FN" "$sq_rc" >&2; sq_rc=2; fi
    exit "$sq_rc"
  fi
  cat "$SCR/answer"
}

# session.create <unit> | objective, repos (list), attention
session_create() {
  FN=session.create
  want_unit "${1:-}"
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  payload_stage
  px_lock "$PX_UNIT"
  [ -e "$SESS/$PX_UNIT" ] && refuse 1 ERR_ENTITY_EXISTS "unit '$PX_UNIT' already exists"
  px_stage
  px_awk
  mkdir "$SESS/$PX_UNIT" 2>/dev/null || refuse 1 ERR_ENTITY_EXISTS "unit '$PX_UNIT' already exists"
  pc_note d "$SESS/$PX_UNIT"
  px_commit "$SESS/$PX_UNIT"
}

# session.load <unit>: the unit and every unit its ref_sessions name
session_load() {
  FN=session.load
  want_held "${1:-}"
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  man_unit "$1" ""
  FN=state.refs
  sl_refs=$(px_awk)
  FN=session.load
  : > "$SCR/man"; : > "$SCR/files"
  man_unit "$1" "backlog knowledge journal"
  for sl_r in $sl_refs; do
    ident_valid "$sl_r" || continue
    [ "$sl_r" = "$1" ] && continue
    man_unit "$sl_r" "backlog knowledge journal"
  done
  px_awk
}

session_refload() {
  FN=session.refload
  [ $# -ge 1 ] || refuse 1 ERR_INVALID_ARGUMENT "missing the unit"
  for sr_u in "$@"; do
    want_unit "$sr_u"
    held "$sr_u" || refuse 1 ERR_ENTITY_NOT_FOUND "unit '$sr_u' not found"
  done
  PX_UNIT=$1; export PX_UNIT
  for sr_u in "$@"; do
    grep -q "^U	$sr_u\$" "$SCR/man" || man_unit "$sr_u" "backlog knowledge journal"
  done
  shift
  px_args "$@"
  px_awk
}

session_refs() {
  FN=session.refs
  want_held "${1:-}"
  sf_u=$1
  shift
  for sf_r in "$@"; do
    ident_valid "$sf_r" || refuse 1 ERR_INVALID_ARGUMENT "malformed unit '$sf_r'"
  done
  PX_UNIT=$sf_u; export PX_UNIT
  px_args "$@"
  payload_stage
  px_lock "$sf_u"
  px_stage
  man_all_units ""
  px_awk
  px_commit "$SESS/$sf_u"
}

session_units() {
  FN=session.units
  [ -n "${1:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the repo"
  case "$1" in
    [!A-Za-z0-9._-]*|*[!A-Za-z0-9._/-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed repo '$1'" ;;
  esac
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  man_all_units ""
  px_awk
}

session_refs_to() {
  FN=session.refs_to
  want_unit "${1:-}"
  px_extra 1 "$@"
  PX_UNIT=$1; export PX_UNIT
  man_all_units ""
  px_awk
}

# lane_doc <function> <unit> <lane> <recipe|report>: lane.create or lane.write_report, the
# document raw on stdin
lane_doc() {
  FN=$1; want_held "${2:-}"
  [ -n "${3:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
  ident_valid "$3" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$3'"
  PX_UNIT=$2; export PX_UNIT
  px_args "$3"
  px_lock "$PX_UNIT"
  px_stage
  cat > "$STAGE/doc" || refuse 2 ERR_STORAGE_READ "cannot read the document"
  PX_DOCSIZE=$(wc -c < "$STAGE/doc" | tr -d ' '); export PX_DOCSIZE
  man_unit "$PX_UNIT" ""
  px_awk
  px_commit "$SESS/$PX_UNIT"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
FN=$cmd

case "$cmd" in
  capability) capability; exit 0 ;;
  corpus.list) corpus_list "$@"; exit $? ;;
  corpus.read) corpus_read "$@"; exit $? ;;
  corpus.write) corpus_write "$@"; exit $? ;;
  corpus.remove) corpus_remove "$@"; exit $? ;;
  corpus.mount) corpus_mount "$@"; exit $? ;;
  corpus.changes) corpus_changes; exit $? ;;
esac

px_init

case "$cmd" in
  storage.health)
    px_extra 0 "$@"
    storage_health
    ;;
  session.create) session_create "$@" ;;
  session.list)
    px_extra 0 "$@"
    man_all_units ""
    px_awk
    ;;
  session.load) session_load "$@" ;;
  session.refload) session_refload "$@" ;;
  session.board)
    px_extra 1 "$@"
    rec_read "$cmd" "${1:-}" "backlog journal"
    ;;
  session.audit)
    px_extra 1 "$@"
    rec_read "$cmd" "${1:-}" "backlog journal"
    ;;
  session.stamp)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "journal"
    ;;
  session.next)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "backlog"
    ;;
  session.close)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "backlog journal"
    ;;
  session.reopen)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" ""
    ;;
  session.refs) session_refs "$@" ;;
  session.units) session_units "$@" ;;
  session.refs_to) session_refs_to "$@" ;;
  task.add|task.update|task.start|task.complete|task.reopen|task.drop|task.get)
    px_extra 2 "$@"
    FN=$cmd
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the task slug"
    ident_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed task slug '$2'"
    case "$cmd" in
      task.get) rec_read "$cmd" "$1" "backlog" "$2" ;;
      task.complete|task.drop) rec_write "$cmd" "$1" "backlog journal" "$2" ;;
      *) rec_write "$cmd" "$1" "backlog" "$2" ;;
    esac
    ;;
  task.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      TODO|IN_PROGRESS|DONE|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "task.list takes TODO, IN_PROGRESS, DONE, or all: '${2:-}'" ;;
    esac
    rec_read "$cmd" "$1" "backlog" "$2"
    ;;
  entry.record)
    px_extra 1 "$@"
    rec_write "$cmd" "${1:-}" "journal"
    ;;
  entry.get|entry.closure)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the entry slug"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed entry slug '$2'"
    rec_read "$cmd" "$1" "journal" "$2"
    ;;
  entry.list)
    want_unit "${1:-}"
    el_u=$1
    shift
    for el_a in "$@"; do
      case "$el_a" in
        --anchor=A[0-9]*) case "${el_a#--anchor=A}" in *[!0-9]*) refuse 1 ERR_INVALID_ARGUMENT "--anchor takes A<N>: '$el_a'" ;; esac ;;
        --group=?*) case "${el_a#--group=}" in [!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) refuse 1 ERR_INVALID_ARGUMENT "malformed group in '$el_a'" ;; esac ;;
        *) refuse 1 ERR_INVALID_ARGUMENT "unknown option '$el_a'" ;;
      esac
    done
    rec_read "$cmd" "$el_u" "journal" "$@"
    ;;
  finding.add|finding.update|finding.drop|finding.get)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the finding NAME"
    name_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$2'"
    case "$cmd" in
      finding.get) rec_read "$cmd" "$1" "knowledge" "$2" ;;
      *) rec_write "$cmd" "$1" "knowledge" "$2" ;;
    esac
    ;;
  finding.supersede)
    px_extra 3 "$@"
    want_unit "${1:-}"
    for fs_n in "${2:-}" "${3:-}"; do
      [ -n "$fs_n" ] || refuse 1 ERR_INVALID_ARGUMENT "finding.supersede takes the unit, OLD, and NEW"
      name_valid "$fs_n" || refuse 1 ERR_INVALID_ARGUMENT "malformed finding NAME '$fs_n'"
    done
    rec_write "$cmd" "$1" "knowledge" "$2" "$3"
    ;;
  finding.list)
    px_extra 2 "$@"
    want_unit "${1:-}"
    case "${2:-}" in
      active|all) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "finding.list takes active or all: '${2:-}'" ;;
    esac
    rec_read "$cmd" "$1" "knowledge" "$2"
    ;;
  lane.create|lane.write_report)
    px_extra 2 "$@"
    lane_doc "$cmd" "${1:-}" "${2:-}"
    ;;
  lane.record)
    px_extra 2 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    ident_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    rec_write "$cmd" "$1" "lane:$2" "$2"
    ;;
  lane.get)
    px_extra 3 "$@"
    want_unit "${1:-}"
    [ -n "${2:-}" ] || refuse 1 ERR_INVALID_ARGUMENT "missing the lane"
    ident_valid "$2" || refuse 1 ERR_INVALID_ARGUMENT "malformed lane '$2'"
    case "${3:-}" in
      recipe|journal|report) ;;
      *) refuse 1 ERR_INVALID_ARGUMENT "lane.get takes recipe, journal, or report: '${3:-}'" ;;
    esac
    rec_read "$cmd" "$1" "lane:$2" "$2" "$3"
    ;;
  search.query) search_query "$@" ;;
  *) refuse 2 ERR_CAPABILITY_UNSUPPORTED "unknown function '$cmd'" ;;
esac
exit 0
