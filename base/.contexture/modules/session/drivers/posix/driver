      cur_finding = line;
      if (cur_finding == target) {
        found = 1; in_target = 1;
      } else {
        in_target = 0;
      }
      next;
    }
    in_target && /^[ ]{2}REF:[ ]*/ {
      in_summary = 0; v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      ref = v; next;
    }
    in_target && /^[ ]{2}SUMMARY ::/ { in_summary = 1; next; }
    in_target && in_summary && /^[ ]{4}/ {
      line = substr($0, 5);
      summary = (summary == "" ? line : summary "\n" line);
      next;
    }
    /^[ ]{2}SUPERSEDES:[ ]*/ {
      v = $0; sub(/^[ ]{2}SUPERSEDES:[ ]*/, "", v); sub(/[ (].*$/, "", v);
      if (v == target) superseded_by = cur_finding;
      next;
    }
    END {
      if (!found) exit 1;
      printf "{\"unit\":\"%s\",\"finding\":{\"name\":\"%s\",\"summary\":\"%s\",\"ref\":\"%s\",\"superseded_by\":\"%s\"}}\n",
        escape_json(unit), escape_json(target), escape_json(summary), escape_json(ref), escape_json(superseded_by);
    }
  ' "$knowledge"
  return $?
}

finding_list() {
  unit="${1:-}"
  active_only="${2:-}"
  if [ -z "$unit" ]; then
    printf 'finding.list: error: missing session unit parameter (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "finding.list: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  knowledge="$s_dir/knowledge.md"
  awk -v unit="$unit" '
    function escape_json(s,    r) {
      r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN { count = 0; cur_name = ""; cur_summary = ""; cur_ref = ""; cur_sup = ""; in_summary = 0; }
    function flush() {
      if (cur_name == "") return;
      count++; n[count] = cur_name; sum[count] = cur_summary; rf[count] = cur_ref; sup[count] = cur_sup;
      cur_name = ""; cur_summary = ""; cur_ref = ""; cur_sup = ""; in_summary = 0;
    }
    /^@finding[ ]+/ {
      flush();
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_name = line; next;
    }
    /^[ ]{2}SUPERSEDES:[ ]*/ {
      in_summary = 0; v = $0; sub(/^[ ]{2}SUPERSEDES:[ ]*/, "", v); sub(/[ (].*$/, "", v);
      cur_sup = v; next;
    }
    /^[ ]{2}REF:[ ]*/ {
      in_summary = 0; v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      cur_ref = v; next;
    }
    /^[ ]{2}SUMMARY ::/ { in_summary = 1; next; }
    in_summary && /^[ ]{4}/ {
      line = substr($0, 5);
      cur_summary = (cur_summary == "" ? line : cur_summary "\n" line);
      next;
    }
    END {
      flush();
      printf "{\"unit\":\"%s\",\"findings\":[", escape_json(unit);
      for (i = 1; i <= count; i++) {
        printf "{\"name\":\"%s\",\"summary\":\"%s\",\"ref\":\"%s\"", escape_json(n[i]), escape_json(sum[i]), escape_json(rf[i]);
        if (sup[i] != "") printf ",\"supersedes\":\"%s\"", escape_json(sup[i]);
        printf "}";
        if (i < count) printf ",";
      }
      printf "]}\n";
    }
  ' "$knowledge"
  return 0
}

lane_create() {
  unit="${1:-}"
  lane="${2:-}"
  goal="${3:-}"
  recipe_body="${4:-}"
  if [ -z "$unit" ] || [ -z "$lane" ] || [ -z "$goal" ]; then
    printf 'lane.create: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "lane.create: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi
  l_dir="$s_dir/lanes/$lane"
  mkdir -p "$l_dir" || return 2

  if [ -n "$recipe_body" ]; then
    printf '%s\n' "$recipe_body" > "$l_dir/recipe.md"
  else
    cat > "$l_dir/recipe.md" <<EOF
# recipe grammar
blocks at column 0; fields indent 2; tasks indent 4;

@context: "subagent lane: $lane"

MISSION
  GOAL: "$goal"
EOF
  fi

  cat > "$l_dir/journal.md" <<'EOF'
# journal grammar
blocks at column 0; fields indent 2;
EOF

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  printf '{"unit":"%s","lane":"%s","status":"CREATED"}\n' "$esc_unit" "$esc_lane"
  return 0
}

lane_record() {
  unit="${1:-}"
  lane="${2:-}"
  slug="${3:-}"
  what="${4:-}"
  thread="${5:-none}"
  if [ -z "$unit" ] || [ -z "$lane" ] || [ -z "$slug" ] || [ -z "$what" ]; then
    printf 'lane.record: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.record: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  printf '\n@entry %s\n  WHAT: "%s"\n  THREAD: %s\n' "$slug" "$what" "$thread" >> "$l_dir/journal.md"

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_slug=$(escape_json "$slug")
  esc_what=$(escape_json "$what")
  printf '{"unit":"%s","lane":"%s","entry":{"slug":"%s","what":"%s"}}\n' "$esc_unit" "$esc_lane" "$esc_slug" "$esc_what"
  return 0
}

lane_report() {
  unit="${1:-}"
  lane="${2:-}"
  report_body="${3:-}"
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.report: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.report: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  rep_file="$l_dir/report.md"
  if [ -n "$report_body" ]; then
    printf '%s\n' "$report_body" > "$rep_file"
  else
    if [ -f "$rep_file" ]; then
      report_body=$(cat "$rep_file")
    else
      report_body=""
    fi
  fi

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_rep=$(escape_json "$report_body")
  printf '{"unit":"%s","lane":"%s","report":"%s"}\n' "$esc_unit" "$esc_lane" "$esc_rep"
  return 0
}

lane_show() {
  unit="${1:-}"
  lane="${2:-}"
  artifact="${3:-report}"
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.show: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.show: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  case "$artifact" in
    recipe*) target_file="$l_dir/recipe.md" ;;
    journal*) target_file="$l_dir/journal.md" ;;
    report*) target_file="$l_dir/report.md" ;;
    *) target_file="$l_dir/report.md" ;;
  esac
  content=""
  [ -f "$target_file" ] && content=$(cat "$target_file")
  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_art=$(escape_json "$artifact")
  esc_cnt=$(escape_json "$content")
  printf '{"unit":"%s","lane":"%s","artifact":"%s","content":"%s"}\n' "$esc_unit" "$esc_lane" "$esc_art" "$esc_cnt"
  return 0
}

lane_status() {
  unit="${1:-}"
  lane="${2:-}"
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.status: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.status: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  has_recipe=false; [ -f "$l_dir/recipe.md" ] && has_recipe=true
  has_journal=false; [ -f "$l_dir/journal.md" ] && has_journal=true
  has_report=false; [ -f "$l_dir/report.md" ] && has_report=true

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  today=$(date +%Y-%m-%d)
  printf '{"unit":"%s","lane":"%s","recipe_present":%s,"journal_present":%s,"report_present":%s,"line_counts":{},"last_activity":"%s"}\n' \
    "$esc_unit" "$esc_lane" "$has_recipe" "$has_journal" "$has_report" "$today"
  return 0
}

lane_close() {
  unit="${1:-}"
  lane="${2:-}"
  verdict="${3:-COMPLETE}"
  resolution="${4:-lane closed}"
  if [ -z "$unit" ] || [ -z "$lane" ]; then
    printf 'lane.close: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  l_dir="$s_dir/lanes/$lane"
  if [ ! -d "$l_dir" ]; then
    printf "lane.close: error: lane '%s' not found in session '%s' (ERR_ENTITY_NOT_FOUND)\n" "$lane" "$unit" >&2
    return 1
  fi
  cur_anc=$(grep '^current_anchor:' "$s_dir/state.md" | head -n 1 | sed 's/^current_anchor:[ ]*//;s/[ \t]*$//')
  [ -z "$cur_anc" ] && cur_anc="A1"
  today=$(date +%Y-%m-%d)
  receipt_slug="$today-$lane-closed"
  receipt_what="lane $lane: $verdict ($resolution)"

  printf '\n@entry %s\n  ANCHOR: %s\n  WHAT: "%s"\n  THREAD: none\n' "$receipt_slug" "$cur_anc" "$receipt_what" >> "$s_dir/journal.md"

  esc_unit=$(escape_json "$unit")
  esc_lane=$(escape_json "$lane")
  esc_slug=$(escape_json "$receipt_slug")
  esc_what=$(escape_json "$receipt_what")
  printf '{"unit":"%s","lane":"%s","status":"RESOLVED","receipt_entry":{"slug":"%s","what":"%s"}}\n' \
    "$esc_unit" "$esc_lane" "$esc_slug" "$esc_what"
  return 0
}

resolve_ref() {
  unit="${1:-}"
  ref="${2:-}"
  if [ -z "$unit" ] || [ -z "$ref" ]; then
    printf 'resolve.ref: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "resolve.ref: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi

  file_part="${ref%%#*}"
  symbol_part="${ref#*#}"
  if [ "$file_part" = "$ref" ]; then
    symbol_part=""
  fi

  case "$file_part" in
    knowledge*|*knowledge*)
      target_file="$s_dir/knowledge.md"
      entity_type="finding"
      entity_id="$symbol_part"
      ;;
    backlog*|*backlog*)
      target_file="$s_dir/backlog.md"
      entity_type="task"
      entity_id="$symbol_part"
      ;;
    journal*|*journal*)
      target_file="$s_dir/journal.md"
      entity_type="entry"
      entity_id="$symbol_part"
      ;;
    lanes/*)
      target_file="$s_dir/$file_part"
      [ ! -f "$target_file" ] && [ -f "$target_file.md" ] && target_file="$target_file.md"
      entity_type="lane_report"
      entity_id="$symbol_part"
      ;;
    *)
      printf "resolve.ref: error: unsupported ref format: '%s' (ERR_INVALID_ARGUMENT)\n" "$ref" >&2
      return 1
      ;;
  esac

  if [ ! -f "$target_file" ]; then
    printf "resolve.ref: error: target file '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$target_file" >&2
    return 1
  fi

  awk -v unit="$unit" -v full_ref="$ref" -v etype="$entity_type" -v eid="$entity_id" '
    function escape_json(s,    r) {
      r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN { found = 0; in_ent = 0; in_sum = 0; sum = ""; fref = ""; tstatus = ""; tobj = ""; ewhat = ""; }
    etype == "finding" && /^@finding[ ]+/ {
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == eid) {
        found = 1; in_ent = 1;
      } else in_ent = 0;
      next;
    }
    etype == "finding" && in_ent && /^[ ]{2}SUMMARY ::/ { in_sum = 1; next; }
    etype == "finding" && in_ent && in_sum && /^[ ]{4}/ {
      l = substr($0, 5); sum = (sum == "" ? l : sum "\n" l); next;
    }
    etype == "finding" && in_ent && /^[ ]{2}REF:[ ]*/ {
      v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      fref = v; next;
    }
    etype == "task" && /^@task[ ]+/ {
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == eid) {
        found = 1; in_ent = 1;
      } else in_ent = 0;
      next;
    }
    etype == "task" && in_ent && /^[ ]{2}STATUS:[ ]*/ {
      v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      tstatus = v; next;
    }
    etype == "task" && in_ent && /^[ ]{2}OBJECTIVE:[ ]*/ {
      v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      tobj = v; next;
    }
    etype == "entry" && /^@entry[ ]+/ {
      line = $0; sub(/^@entry[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      if (line == eid) {
        found = 1; in_ent = 1;
      } else in_ent = 0;
      next;
    }
    etype == "entry" && in_ent && /^[ ]{2}WHAT:[ ]*/ {
      v = $0; sub(/^[ ]{2}WHAT:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      ewhat = v; next;
    }
    END {
      if (!found) exit 1;
      if (etype == "finding") {
        printf "{\"unit\":\"%s\",\"ref\":\"%s\",\"entity_type\":\"%s\",\"target\":{\"name\":\"%s\",\"summary\":\"%s\",\"ref\":\"%s\"}}\n",
          escape_json(unit), escape_json(full_ref), escape_json(etype), escape_json(eid), escape_json(sum), escape_json(fref);
      } else if (etype == "task") {
        printf "{\"unit\":\"%s\",\"ref\":\"%s\",\"entity_type\":\"%s\",\"target\":{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\"}}\n",
          escape_json(unit), escape_json(full_ref), escape_json(etype), escape_json(eid), escape_json(tstatus), escape_json(tobj);
      } else if (etype == "entry") {
        printf "{\"unit\":\"%s\",\"ref\":\"%s\",\"entity_type\":\"%s\",\"target\":{\"slug\":\"%s\",\"what\":\"%s\"}}\n",
          escape_json(unit), escape_json(full_ref), escape_json(etype), escape_json(eid), escape_json(ewhat);
      } else {
        printf "{\"unit\":\"%s\",\"ref\":\"%s\",\"entity_type\":\"%s\",\"target\":{\"ref\":\"%s\"}}\n",
          escape_json(unit), escape_json(full_ref), escape_json(etype), escape_json(full_ref);
      }
    }
  ' "$target_file"
  if [ $? -ne 0 ]; then
    printf "resolve.ref: error: entity '%s' not found in '%s' (ERR_ENTITY_NOT_FOUND)\n" "$eid" "$ref" >&2
    return 1
  fi
  return 0
}

search_query() {
  unit="${1:-}"
  query="${2:-}"
  if [ -z "$unit" ] || [ -z "$query" ]; then
    printf 'search.query: error: missing required arguments (ERR_INVALID_ARGUMENT)\n' >&2
    return 1
  fi
  s_dir=$(get_session_dir "$unit")
  if [ ! -d "$s_dir" ]; then
    printf "search.query: error: session '%s' not found (ERR_ENTITY_NOT_FOUND)\n" "$unit" >&2
    return 1
  fi

  files=""
  [ -f "$s_dir/knowledge.md" ] && files="$files $s_dir/knowledge.md"
  [ -f "$s_dir/backlog.md" ] && files="$files $s_dir/backlog.md"
  [ -f "$s_dir/journal.md" ] && files="$files $s_dir/journal.md"
  [ -f "$s_dir/state.md" ] && files="$files $s_dir/state.md"
  if [ -d "$s_dir/lanes" ]; then
    for lf in "$s_dir"/lanes/*/*.md; do
      [ -f "$lf" ] && files="$files $lf"
    done
  fi

  awk -v unit="$unit" -v query="$query" -f "$SCRIPT_DIR/search.awk" $files
  return 0
}

