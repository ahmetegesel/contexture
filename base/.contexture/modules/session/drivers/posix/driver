    return 1
  fi
  awk -v unit="$unit" -v filter="$status_filter" '
    function escape_json(s,    r) {
      r = s; gsub(/\\/, "\\\\", r); gsub(/"/, "\\\"", r); gsub(/\n/, "\\n", r); gsub(/\r/, "\\r", r); return r;
    }
    BEGIN {
      count = 0; cur_slug = ""; cur_status = "TODO"; cur_obj = "";
    }
    function flush() {
      if (cur_slug == "") return;
      if (filter == "" || filter == "all" || tolower(cur_status) == tolower(filter)) {
        count++; s[count] = cur_slug; st[count] = cur_status; obj[count] = cur_obj;
      }
      cur_slug = ""; cur_status = "TODO"; cur_obj = "";
    }
    /^@task[ ]+/ {
      flush();
      line = $0; sub(/^@task[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      cur_slug = line;
      next;
    }
    /^[ ]{2}STATUS:[ ]*/ {
      v = $0; sub(/^[ ]{2}STATUS:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      cur_status = v;
      next;
    }
    /^[ ]{2}OBJECTIVE:[ ]*/ {
      v = $0; sub(/^[ ]{2}OBJECTIVE:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      cur_obj = v;
      next;
    }
    END {
      flush();
      printf "{\"unit\":\"%s\",\"tasks\":[", escape_json(unit);
      for (i = 1; i <= count; i++) {
        printf "{\"slug\":\"%s\",\"status\":\"%s\",\"objective\":\"%s\"}", escape_json(s[i]), escape_json(st[i]), escape_json(obj[i]);
        if (i < count) printf ",";
      }
      printf "]}\n";
    }
  ' "$s_dir/backlog.md"
  return 0
}

task_show() {
