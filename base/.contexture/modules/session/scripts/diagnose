#!/bin/sh
# summary: session diagnostics: configuration, storage driver, and storage health
# usage: ctx session diagnose [--json]
# help: inspect workspace session configuration, the resolved storage driver and its
# help: capability descriptor (the contract, the functions, the search modes, the
# help: optional capabilities), and the storage backend health (storage.health).

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

format="text"
for arg in "$@"; do
  case "$arg" in
    --json)
      format="json"
      ;;
    --help|-h)
      printf 'usage: ctx session diagnose [--json]\n'
      printf 'inspect session configuration, resolved storage driver, capabilities, and health\n'
      exit 0
      ;;
    *)
      printf 'ctx session diagnose: unrecognized option: %s\n' "$arg" >&2
      exit 1
      ;;
  esac
done

if [ ! -x "$VB_RESOLVER" ]; then
  printf 'ctx session diagnose: driver-resolver not found at %s\n' "$VB_RESOLVER" >&2
  exit 2
fi

root="${CTX_ROOT:-$PWD}"
ctx_dir="$root/.contexture"

# 1. Config status
config_file="$ctx_dir/config"
config_status="absent"
config_driver=""
if [ -f "$config_file" ]; then
  config_status="present"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      session.storage.driver*=*|session.storage.driver*:*|storage.driver*=*|storage.driver*:*)
        val=${line#*=}
        [ "$val" = "$line" ] && val=${line#*:}
        val=${val%%#*}
        config_driver=$(printf '%s\n' "$val" | tr -d '[:space:]')
        ;;
    esac
  done < "$config_file"
fi

# 2. Driver resolution
if [ -n "${CTX_STORAGE_DRIVER:-}" ]; then
  driver_name="$CTX_STORAGE_DRIVER"
  driver_source="environment (CTX_STORAGE_DRIVER)"
elif [ -n "$config_driver" ]; then
  driver_name="$config_driver"
  driver_source="config (.contexture/config)"
else
  driver_name="posix"
  driver_source="default (posix)"
fi

# 3. The descriptor: the resolver's handshake read (capability), never a record read
vb_tmp
driver_status="ok"
driver_err=""
if "$VB_RESOLVER" capability < /dev/null > "$VB_DIR/cap" 2> "$VB_DIR/caperr"; then
  :
else
  driver_status="error"
  driver_err=$(cat "$VB_DIR/caperr" "$VB_DIR/cap")
fi

# 4. Storage health: the driver reports its own backend (storage.health)
vb_call storage.health
if [ "$VB_RC" -eq 0 ]; then
  health_line=$(vb_render health)
else
  health_line=$(printf 'error\tthe storage driver did not report its health\tabsent\t0')
fi
tab=$(printf '\t')
health_status=${health_line%%"$tab"*}
rest=${health_line#*"$tab"}
health_detail=${rest%%"$tab"*}
rest=${rest#*"$tab"}
health_store=${rest%%"$tab"*}
active_count=${rest#*"$tab"}

# jstr <text>: one JSON string in the contract form
jstr() {
  JS_V="$1" awk 'BEGIN {
    s = ENVIRON["JS_V"]
    n = split(s, P, /\\/); o = (n ? P[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" P[i]
    n = split(o, Q, /"/); o = (n ? Q[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\"" Q[i]
    gsub(/\t/, "\\t", o); gsub(/\r/, "\\r", o)
    n = split(o, L, "\n"); r = (n ? L[1] : ""); for (i = 2; i <= n; i++) r = r "\\" "n" L[i]
    printf "\"%s\"", r
  }'
}

if [ "$format" = "json" ]; then
  if [ "$driver_status" = ok ]; then desc=$(cat "$VB_DIR/cap"); else desc=null; fi
  printf '{"workspace_root":%s,"config":{"status":%s,"driver":%s},"driver":{"name":%s,"source":%s,"status":%s,"descriptor":%s},"storage":{"health":%s,"detail":%s,"store":%s,"active_units":%s}}\n' \
    "$(jstr "$root")" "$(jstr "$config_status")" "$(jstr "${config_driver:-none}")" \
    "$(jstr "$driver_name")" "$(jstr "$driver_source")" "$(jstr "$driver_status")" "$desc" \
    "$(jstr "$health_status")" "$(jstr "$health_detail")" "$(jstr "$health_store")" "${active_count:-0}"
else
  printf 'ctx session: storage and configuration diagnostics\n'
  printf '  workspace root:  %s\n' "$root"
  printf '  configuration:   %s' "$config_status"
  if [ -n "$config_driver" ]; then
    printf ' (session.storage.driver = %s)\n' "$config_driver"
  else
    printf '\n'
  fi
  printf '  storage driver:  %s (source: %s)\n' "$driver_name" "$driver_source"
  if [ "$driver_status" = "ok" ]; then
    printf '  driver status:   ok\n'
    awk -f "$VB_JSON" < "$VB_DIR/cap" | RV_VIEW=diagnose awk -f "$VB_RENDER"
  else
    printf '  driver status:   error (%s)\n' "$driver_err"
  fi
  printf '  storage health:  %s (%s)\n' "$health_status" "$health_detail"
  printf '  active units:    %d\n' "${active_count:-0}"
fi
