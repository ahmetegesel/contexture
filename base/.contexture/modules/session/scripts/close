#!/bin/sh
# summary: mark the unit CLOSED; warns on open tasks and audit findings, never refuses for them
# usage: ctx session close <slug>
# help: the unit lifecycle ends; closure and supersession by reference only
# help: exit codes: 0 unit marked CLOSED; 1 unit not found or bad slug
# help: example: ctx session close my-unit
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$dir/record" close "$@"
