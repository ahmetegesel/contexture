#!/bin/sh
# summary: mark the unit CLOSED; warns on open tasks and audit findings, never refuses for them
# usage: ctx session close <slug>
# help: the storage driver closes the unit and answers its audit and open tasks (session.close); base prints their warnings on stderr, then the close hooks fire; the unit lifecycle ends; closure and supersession by reference only
# help: exit codes: 0 unit marked CLOSED; 1 unit not found, already CLOSED, or bad slug
# help: example: ctx session close my-unit

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx session close <session-slug>\n' >&2
  printf 'help: ctx session help\n' >&2
  exit 1
}

case "${1:-}" in
  --help|-h|help) printf 'usage: ctx session close <session-slug>\n'; exit 0 ;;
esac
[ $# -eq 1 ] || usage
vb_slug_ok "$1" || usage
vb_call session.close "$1"
vb_ok
vb_render close
vb_hook close CTX_UNIT "$1" || { printf 'ERROR: close point failed (block hook)\n' >&2; exit 1; }
exit 0
