#!/bin/sh
# summary: finding operations (add, show, update, supersede, drop, list)
# usage: ctx session finding <subcommand> <unit> [args...]
# help: subcommands:
# help:   add <unit> <NAME> --summary="..." [--ref=...] [--supersedes=...]
# help:   show <unit> <NAME> [--json]
# help:   update <unit> <NAME> [--summary="..."] [--ref=...]
# help:   supersede <unit> <old-name> <new-name> --summary="..." [--ref=...]
# help:   drop <unit> <NAME>
# help:   list <unit> [--active-only] [--json]
# help: stdin fallback: raw @finding block piping supported
# help: the writes refuse a CLOSED unit with rc 1 before any driver call; a NAME the knowledge already carries is refused (rc 1, ERR_ENTITY_EXISTS), a missing predecessor too (ERR_ENTITY_NOT_FOUND)

set -u

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
resolver="$dir/driver-resolver"
if [ ! -x "$resolver" ]; then
  if [ -n "${CTX_MODULE_DIR:-}" ] && [ -x "$CTX_MODULE_DIR/scripts/driver-resolver" ]; then
    resolver="$CTX_MODULE_DIR/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver"
  fi
fi

# The driver transport (docs/the-engine.md): argv carries the method and its bounded
# identifiers; every free-text field travels on stdin as payload lines key=value, the
# value escaped (backslash, newline, tab, carriage return as \\, \n, \t, \r); pline
# writes one line, exact (a trailing newline survives).
pline() {
  printf '%s=' "$1"
  printf '%sx' "$2" | awk '
    function bs_double(s,    n, p, i, o) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; return o }
    BEGIN { ORS = "" }
    { $0 = bs_double($0); gsub(/\t/, "\\t"); gsub(/\r/, "\\r"); out = out (NR > 1 ? "\\n" : "") $0 }
    END { sub(/x$/, "", out); print out "\n" }'
}

# unit_closed <unit>: rc0 when the unit's state reads status: CLOSED (a closed unit takes
# no writes: the refusal is the verb's, before any driver write)
unit_closed() {
  "$resolver" artifact.read "$1" state 2>/dev/null | awk '/^status:[ \t]*CLOSED[ \t\r]*$/ { c = 1 } END { exit !c }'
}

refuse_closed() {
  if unit_closed "$1"; then
    printf 'ERROR: unit is CLOSED: %s (a closed unit takes no writes)\n' "$1" >&2
    exit 1
  fi
}

# the dialect is LF: a carriage return in a field would poison the record for the grammar
# verbs, which refuse CR on read; the refusal is the verb's, before any driver write
CR_CHAR=$(printf '\r')
refuse_cr() {
  for cr_v in "$@"; do
    case "$cr_v" in
      *"$CR_CHAR"*)
        printf 'ERROR: embedded carriage return in a field value (the dialect is LF)\n' >&2
        exit 1
        ;;
    esac
  done
}

# a one-line field (written as one line of its block) takes no newline: a column-0
# continuation would break the block grammar; the block scalars keep their newlines;
# refuse_nl <field> <value> [<field> <value> ...], before any driver write
NL_CHAR='
'
refuse_nl() {
  while [ $# -ge 2 ]; do
    case "$2" in
      *"$NL_CHAR"*)
        printf 'ERROR: embedded newline in %s (one line)\n' "$1" >&2
        exit 1
        ;;
    esac
    shift 2
  done
}

if [ $# -eq 0 ]; then
  printf 'usage: ctx session finding <subcommand> <unit> [args...]\n' >&2
  printf 'subcommands: add, show, update, supersede, drop, list\n' >&2
  exit 1
fi

case "$1" in
  --help|-h|help)
    printf 'usage: ctx session finding <subcommand> <unit> [args...]\n'
    printf 'subcommands:\n'
    printf '  add <unit> <NAME> --summary="..." [--ref=...] [--supersedes=...]\n'
    printf '  show <unit> <NAME> [--json]\n'
    printf '  update <unit> <NAME> [--summary="..."] [--ref=...]\n'
    printf '  supersede <unit> <old-name> <new-name> --summary="..." [--ref=...]\n'
    printf '  drop <unit> <NAME>\n'
    printf '  list <unit> [--active-only] [--json]\n'
    exit 0
    ;;
esac

subcmd="$1"
shift
case "${1:-}" in
  --help|-h) "$0" --help | awk -v s="$subcmd" 'NR == 1 || $1 == s'; exit 0 ;;
esac

# parse_stdin_finding <field>: one field of a raw @finding block on stdin (name, summary,
# ref, supersedes), multi-line values exact; no shell evaluation of the block text
parse_stdin_finding() {
  awk -v want="$1" '
    BEGIN { in_target = 0; in_sum = 0; name = ""; sum = ""; ref = ""; sup = ""; }
    /^@finding[ ]+/ {
      line = $0; sub(/^@finding[ ]+/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line);
      name = line; in_target = 1; next;
    }
    in_target && /^[ ]{2}REF:[ ]*/ {
      in_sum = 0; v = $0; sub(/^[ ]{2}REF:[ ]*/, "", v); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
      if (substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") v = substr(v, 2, length(v) - 2);
      ref = v; next;
    }
    in_target && /^[ ]{2}SUPERSEDES:[ ]*/ {
      in_sum = 0; v = $0; sub(/^[ ]{2}SUPERSEDES:[ ]*/, "", v); sub(/[ (].*$/, "", v);
      sup = v; next;
    }
    in_target && /^[ ]{2}SUMMARY ::/ { in_sum = 1; next; }
    in_target && in_sum && /^[ ]{4}/ {
      line = substr($0, 5);
      sum = (sum == "" ? line : sum "\n" line);
      next;
    }
    in_target && /^[ \t]*$/ { in_sum = 0; }
    END {
      if (want == "name") printf "%s", name;
      else if (want == "summary") printf "%s", sum;
      else if (want == "ref") printf "%s", ref;
      else if (want == "supersedes") printf "%s", sup;
    }
  '
}

validate_finding_name() {
  case "$1" in
    *[!A-Z0-9_]*|"")
      printf "finding: error: finding name '%s' must be uppercase alphanumeric and underscores only\n" "$1" >&2
      return 1
      ;;
  esac
  return 0
}

case "$subcmd" in
  add)
    [ $# -gt 0 ] || { printf 'finding add: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    name=""
    if [ $# -gt 0 ] && [ "$(printf '%s' "$1" | cut -c1-2)" != "--" ]; then
      name="$1"; shift
    fi
    summary=""
    ref=""
    supersedes=""
    json_out=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --summary=*) summary="${1#--summary=}" ;;
        -s) shift; [ $# -gt 0 ] && summary="$1" ;;
        --ref=*) ref="${1#--ref=}" ;;
        -r) shift; [ $# -gt 0 ] && ref="$1" ;;
        --supersedes=*) supersedes="${1#--supersedes=}" ;;
        --json) json_out=1 ;;
        *) [ -z "$name" ] && name="$1" ;;
      esac
      shift
    done
    if [ -z "$summary" ] && [ ! -t 0 ]; then
      stdin_content=$(cat)
      if [ -n "$stdin_content" ]; then
        [ -z "$name" ] && name=$(printf '%s\n' "$stdin_content" | parse_stdin_finding name)
        [ -z "$summary" ] && summary=$(printf '%s\n' "$stdin_content" | parse_stdin_finding summary)
        [ -z "$ref" ] && ref=$(printf '%s\n' "$stdin_content" | parse_stdin_finding ref)
        [ -z "$supersedes" ] && supersedes=$(printf '%s\n' "$stdin_content" | parse_stdin_finding supersedes)
      fi
    fi
    if [ -z "$name" ]; then
      printf 'finding add: error: missing finding name\n' >&2
      exit 1
    fi
    validate_finding_name "$name" || exit 1
    if [ -z "$summary" ]; then
      printf 'finding add: error: missing required --summary parameter\n' >&2
      exit 1
    fi
    refuse_closed "$unit"
    refuse_cr "$summary" "$ref" "$supersedes"
    refuse_nl --ref "$ref" --supersedes "$supersedes"
    out=$({ pline summary "$summary"; pline ref "$ref"; pline supersedes "$supersedes"; } | "$resolver" finding.add "$unit" "$name")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      printf 'finding added: %s\n' "$name"
    fi
    exit 0
    ;;

  show)
    [ $# -gt 0 ] || { printf 'finding show: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    [ $# -gt 0 ] || { printf 'finding show: error: missing finding name\n' >&2; exit 1; }
    name="$1"; shift
    json_out=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) json_out=1 ;;
      esac
      shift
    done
    out=$("$resolver" finding.show "$unit" "$name")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      # the readable block, every JSON escape decoded
      printf '%s\n' "$out" | awk '
        function jstr(s, pos,   out, c, e, i, n) {
          out = ""
          n = length(s)
          for (i = pos; i <= n; i++) {
            c = substr(s, i, 1)
            if (c == "\\") {
              i++
              e = substr(s, i, 1)
              if (e == "n") out = out "\n"
              else if (e == "t") out = out "\t"
              else if (e == "r") out = out "\r"
              else out = out e
              continue
            }
            if (c == "\"") { JEND = i; return out }
            out = out c
          }
          JEND = n
          return out
        }
        function jval(s, key,   p) {
          p = index(s, "\"" key "\":\"")
          if (p == 0) return ""
          return jstr(s, p + length(key) + 4)
        }
        {
          line = $0
          t = index(line, "\"finding\":{")
          if (t > 0) line = substr(line, t)
          printf "@finding %s\n", jval(line, "name")
          sb = jval(line, "superseded_by")
          if (sb != "") printf "  SUPERSEDED_BY: %s\n", sb
          rf = jval(line, "ref")
          if (rf != "") printf "  REF: \"%s\"\n", rf
          sm = jval(line, "summary")
          if (sm != "") {
            gsub(/\n/, "\n    ", sm)
            printf "  SUMMARY ::\n    %s\n", sm
          }
        }
      '
    fi
    exit 0
    ;;

  update)
    [ $# -gt 0 ] || { printf 'finding update: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    [ $# -gt 0 ] || { printf 'finding update: error: missing finding name\n' >&2; exit 1; }
    name="$1"; shift
    summary=""
    ref=""
    json_out=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --summary=*) summary="${1#--summary=}" ;;
        -s) shift; [ $# -gt 0 ] && summary="$1" ;;
        --ref=*) ref="${1#--ref=}" ;;
        -r) shift; [ $# -gt 0 ] && ref="$1" ;;
        --json) json_out=1 ;;
      esac
      shift
    done
    if [ -z "$summary" ] && [ -z "$ref" ] && [ ! -t 0 ]; then
      stdin_content=$(cat)
      if [ -n "$stdin_content" ]; then
        [ -z "$summary" ] && summary=$(printf '%s\n' "$stdin_content" | parse_stdin_finding summary)
        [ -z "$ref" ] && ref=$(printf '%s\n' "$stdin_content" | parse_stdin_finding ref)
      fi
    fi
    refuse_closed "$unit"
    refuse_cr "$summary" "$ref"
    refuse_nl --ref "$ref"
    out=$({ pline summary "$summary"; pline ref "$ref"; } | "$resolver" finding.update "$unit" "$name")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      printf 'finding updated: %s\n' "$name"
    fi
    exit 0
    ;;

  supersede)
    [ $# -gt 0 ] || { printf 'finding supersede: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    [ $# -gt 0 ] || { printf 'finding supersede: error: missing old finding name\n' >&2; exit 1; }
    old_name="$1"; shift
    [ $# -gt 0 ] || { printf 'finding supersede: error: missing new finding name\n' >&2; exit 1; }
    new_name="$1"; shift
    summary=""
    ref=""
    json_out=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --summary=*) summary="${1#--summary=}" ;;
        -s) shift; [ $# -gt 0 ] && summary="$1" ;;
        --ref=*) ref="${1#--ref=}" ;;
        -r) shift; [ $# -gt 0 ] && ref="$1" ;;
        --json) json_out=1 ;;
      esac
      shift
    done
    validate_finding_name "$new_name" || exit 1
    if [ -z "$summary" ]; then
      printf 'finding supersede: error: missing required --summary parameter\n' >&2
      exit 1
    fi
    refuse_closed "$unit"
    refuse_cr "$summary" "$ref"
    refuse_nl --ref "$ref"
    out=$({ pline summary "$summary"; pline ref "$ref"; } | "$resolver" finding.supersede "$unit" "$old_name" "$new_name")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      printf 'finding superseded: %s by %s\n' "$old_name" "$new_name"
    fi
    exit 0
    ;;

  drop)
    [ $# -gt 0 ] || { printf 'finding drop: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    [ $# -gt 0 ] || { printf 'finding drop: error: missing finding name\n' >&2; exit 1; }
    name="$1"; shift
    refuse_closed "$unit"
    out=$("$resolver" finding.drop "$unit" "$name")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    printf 'finding dropped: %s\n' "$name"
    exit 0
    ;;

  list)
    [ $# -gt 0 ] || { printf 'finding list: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    active_only=""
    json_out=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --active-only) active_only="active" ;;
        --json) json_out=1 ;;
      esac
      shift
    done
    out=$("$resolver" finding.list "$unit" "$active_only")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      printf '%s\n' "$out" | awk '
        # walk a JSON string from the character after its opening quote, honoring
        # backslash escapes; leaves JEND at the closing quote
        function jstr(s, pos,   out, c, e, i, n) {
          out = ""
          n = length(s)
          for (i = pos; i <= n; i++) {
            c = substr(s, i, 1)
            if (c == "\\") {
              i++
              e = substr(s, i, 1)
              if (e == "n" || e == "t") out = out " "
              else out = out e
              continue
            }
            if (c == "\"") { JEND = i; return out }
            out = out c
          }
          JEND = n
          return out
        }
        {
          line = $0
          while ((p = index(line, "\"name\":\"")) > 0) {
            n = jstr(line, p + 8)
            rest = substr(line, JEND + 1)
            q = index(rest, "\"summary\":\"")
            if (q == 0) break
            sm = jstr(rest, q + 11)
            printf "  %s: %s\n", n, sm
            line = substr(rest, JEND + 1)
          }
        }
      '
    fi
    exit 0
    ;;

  *)
    unit="$subcmd"
    if [ $# -eq 0 ]; then
      exec "$0" list "$unit"
    else
      exec "$0" show "$unit" "$@"
    fi
    ;;
esac
