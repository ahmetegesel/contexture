#!/bin/sh
# summary: finding operations (add, show, update, supersede, drop, list)
# usage: ctx session finding <subcommand> <unit> [args...]
# help: subcommands:
# help:   add <unit> <NAME> --summary="..." [--ref=...]... [--supersedes=...]
# help:   show <unit> <NAME> [--json]
# help:   update <unit> <NAME> [--summary="..."] [--ref=...]...
# help:   supersede <unit> <old-name> <new-name> --summary="..." [--ref=...]...
# help:   drop <unit> <NAME>
# help:   list <unit> [--active-only] [--json]
# help: --ref repeats (one REF line each); an update with --ref replaces the list
# help: update takes its fields from the flags alone (stdin is not read); an update with no field refuses rc 1 (ERR_INVALID_ARGUMENT), an empty --summary carrying no field
# help: the storage driver holds the record rules: a CLOSED unit refuses every write; a NAME the knowledge already carries is refused (rc 1, ERR_ENTITY_EXISTS), a missing predecessor too (ERR_ENTITY_NOT_FOUND); a new NAME is upper case letters, digits, and underscores

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

help_table() {
  printf 'usage: ctx session finding <subcommand> <unit> [args...]\n'
  printf 'subcommands:\n'
  printf '  add <unit> <NAME> --summary="..." [--ref=...] [--supersedes=...]\n'
  printf '  show <unit> <NAME> [--json]\n'
  printf '  update <unit> <NAME> [--summary="..."] [--ref=...]\n'
  printf '  update reads no stdin; an update with no field refuses rc 1 (ERR_INVALID_ARGUMENT)\n'
  printf '  supersede <unit> <old-name> <new-name> --summary="..." [--ref=...]\n'
  printf '  drop <unit> <NAME>\n'
  printf '  list <unit> [--active-only] [--json]\n'
}

validate_finding_name() {
  case "$1" in
    *[!A-Z0-9_]*|"")
      printf "finding: error: finding name '%s' must be uppercase alphanumeric and underscores only\n" "$1" >&2
      return 1
      ;;
  esac
  return 0
}

# a NAME a read or an update addresses: the legacy lowercase names stay addressable
read_name() {
  case "$1" in
    ""|[!A-Za-z0-9_]*|*[!A-Za-z0-9_-]*)
      printf "finding: error: malformed finding NAME '%s' (ERR_INVALID_ARGUMENT)\n" "$1" >&2
      exit 1
      ;;
  esac
}

if [ $# -eq 0 ]; then
  printf 'usage: ctx session finding <subcommand> <unit> [args...]\n' >&2
  printf 'subcommands: add, show, update, supersede, drop, list\n' >&2
  exit 1
fi

case "$1" in
  --help|-h|help) help_table; exit 0 ;;
esac

subcmd="$1"
shift
case "${1:-}" in
  --help|-h) help_table | awk -v s="$subcmd" 'NR == 1 || $1 == s'; exit 0 ;;
esac

summary=""; has_summary=0
supersedes=""
json_out=0
nref=0
REFS_FILE=""

# add_ref <value>: one --ref, kept in order
add_ref() {
  vb_tmp
  REFS_FILE="$VB_DIR/refs"
  nref=$((nref + 1))
  eval "REF_$nref=\$1"
}

refs_payload() {
  set --
  i=0
  while [ "$i" -lt "$nref" ]; do
    i=$((i + 1))
    eval "set -- \"\$@\" \"\$REF_$i\""
  done
  vb_list refs "$@"
}

check_refs() {
  i=0
  while [ "$i" -lt "$nref" ]; do
    i=$((i + 1))
    eval "rv=\$REF_$i"
    vb_refuse_cr "$rv"
    vb_refuse_nl --ref "$rv"
    vb_ref_ok finding "$rv"
  done
}

# parse_flags <label> <args...>: --summary, --ref (repeatable), --supersedes (add), --json
parse_flags() {
  pf_label=$1
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --summary=*) summary="${1#--summary=}"; has_summary=1 ;;
      -s) shift; [ $# -gt 0 ] && { summary="$1"; has_summary=1; } ;;
      --ref=*) add_ref "${1#--ref=}" ;;
      -r) shift; [ $# -gt 0 ] && add_ref "$1" ;;
      --supersedes=*)
        [ "$pf_label" = "finding add" ] || vb_unknown "$pf_label" "$1"
        supersedes="${1#--supersedes=}" ;;
      --json) json_out=1 ;;
      *) vb_unknown "$pf_label" "$1" ;;
    esac
    shift
  done
}

case "$subcmd" in
  add)
    [ $# -gt 0 ] || { printf 'finding add: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "finding $subcmd" "$unit"
    name=""
    if [ $# -gt 0 ]; then
      case "$1" in -*) ;; *) name="$1"; shift ;; esac
    fi
    parse_flags "finding add" "$@"
    if [ -z "$name" ]; then
      printf 'finding add: error: missing finding name\n' >&2
      exit 1
    fi
    validate_finding_name "$name" || exit 1
    if [ -z "$summary" ]; then
      printf 'finding add: error: missing required --summary parameter\n' >&2
      exit 1
    fi
    vb_refuse_cr "$summary" "$supersedes"
    check_refs
    vb_refuse_nl --supersedes "$supersedes"
    vb_kv summary "$summary"
    refs_payload
    [ -n "$supersedes" ] && vb_kv supersedes "$supersedes"
    vb_call finding.add "$unit" "$name"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else printf 'finding added: %s\n' "$name"; fi
    exit 0
    ;;

  show)
    [ $# -gt 0 ] || { printf 'finding show: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "finding $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'finding show: error: missing finding name\n' >&2; exit 1; }
    name="$1"; shift
    read_name "$name"
    for a in "$@"; do
      case "$a" in
        --json) json_out=1 ;;
        *) vb_unknown "finding show" "$a" ;;
      esac
    done
    vb_call finding.get "$unit" "$name"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else vb_render finding_show; fi
    exit 0
    ;;

  update)
    [ $# -gt 0 ] || { printf 'finding update: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "finding $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'finding update: error: missing finding name\n' >&2; exit 1; }
    name="$1"; shift
    read_name "$name"
    parse_flags "finding update" "$@"
    vb_refuse_cr "$summary"
    check_refs
    # an update carrying no field refuses before any call (D26): the flags are its only
    # input (stdin is not read, D1), and an empty --summary carries no field
    if [ -z "$summary" ] && [ "$nref" -eq 0 ]; then
      printf 'finding update: error: no field to update (give --summary or --ref) (ERR_INVALID_ARGUMENT)\n' >&2
      exit 1
    fi
    [ -n "$summary" ] && vb_kv summary "$summary"
    [ "$nref" -gt 0 ] && refs_payload
    vb_call finding.update "$unit" "$name"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else printf 'finding updated: %s\n' "$name"; fi
    exit 0
    ;;

  supersede)
    [ $# -gt 0 ] || { printf 'finding supersede: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "finding $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'finding supersede: error: missing old finding name\n' >&2; exit 1; }
    old_name="$1"; shift
    [ $# -gt 0 ] || { printf 'finding supersede: error: missing new finding name\n' >&2; exit 1; }
    new_name="$1"; shift
    parse_flags "finding supersede" "$@"
    read_name "$old_name"
    validate_finding_name "$new_name" || exit 1
    if [ -z "$summary" ]; then
      printf 'finding supersede: error: missing required --summary parameter\n' >&2
      exit 1
    fi
    vb_refuse_cr "$summary"
    check_refs
    vb_kv summary "$summary"
    refs_payload
    vb_call finding.supersede "$unit" "$old_name" "$new_name"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else printf 'finding superseded: %s by %s\n' "$old_name" "$new_name"; fi
    exit 0
    ;;

  drop)
    [ $# -gt 0 ] || { printf 'finding drop: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "finding $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'finding drop: error: missing finding name\n' >&2; exit 1; }
    name="$1"; shift
    read_name "$name"
    for a in "$@"; do
      case "$a" in
        --json) json_out=1 ;;
        *) vb_unknown "finding drop" "$a" ;;
      esac
    done
    vb_call finding.drop "$unit" "$name"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else printf 'finding dropped: %s\n' "$name"; fi
    exit 0
    ;;

  list)
    [ $# -gt 0 ] || { printf 'finding list: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "finding $subcmd" "$unit"
    which=all
    for a in "$@"; do
      case "$a" in
        --active-only) which=active ;;
        --json) json_out=1 ;;
        *) vb_unknown "finding list" "$a" ;;
      esac
    done
    vb_call finding.list "$unit" "$which"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else vb_render finding_list; fi
    exit 0
    ;;

  *)
    unit="$subcmd"
    if [ $# -eq 0 ]; then
      exec sh "$0" list "$unit"
    else
      exec sh "$0" show "$unit" "$@"
    fi
    ;;
esac
