#!/bin/sh
# summary: set the read-only reference sessions (templates/state.md); zero sessions clears
# usage: ctx session refs <slug> [<session> ...]
# help: sets ref_sessions in state.md; every named session must exist and differ from the unit; zero sessions clears
# help: exit codes: 0 reference sessions updated; 1 target session does not exist or matches unit
# help: example: ctx session refs my-unit ref-session-1 ref-session-2
# help: example: ctx session refs my-unit
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$dir/record" refs "$@"
