#!/bin/sh
# summary: record an append-only journal event with auto-injected date and anchor
# usage: ctx session record <unit> --what="..." [--group=...] [--thread=...] [--rhythm="<name> <N> <GATE>"] [--ref=...]... [--closes=...]... [--supersedes=...]... [--knowledge] [--slug=...]
# help: records an append-only journal event; the storage driver injects the active anchor and composes the slug from the local date and time (entry.record)
# help: options:
# help:   --what="..."         event description (required)
# help:   --group=...          topic group token
# help:   --thread=...         what the unit awaits (default: none)
# help:   --rhythm="..."       the process in force: <name> <N> <GATE>, a step and gate of .contexture/rhythms/<name>.md
# help:   --ref="..."          grounding reference: <target>#<symbol> or a whole target path holding a / (a root-level file as ./<file>), one token without blanks or double quotes; repeatable, one REF line each
# help:   --closes="<slug> (<verdict>: <reason>)"   closes journal entry targets (one or more slugs before the parenthesis); the verdict done, superseded, dropped, or folded; repeatable, one CLOSES line each
# help:   --supersedes="<slug> (<verdict>: <reason>)"   supersedes journal entry targets, the same form; repeatable, one SUPERSEDES line each
# help:   --knowledge          flag for harvest
# help:   --slug=...           override entry slug (today's date prefixed when it carries none)
# help: a closer takes only the explicit form: a bare target list, a missing or unknown verdict, an empty reason, or a reason holding a parenthesis refuses rc 1 (ERR_INVALID_ARGUMENT) naming the form; every closer target must name an entry the journal holds; a CLOSED unit and a slug the journal holds refuse rc 1
# help: every flag value is one line: an embedded newline or carriage return refuses before any write

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

case "${1:-}" in
  --help|-h|help)
    [ $# -eq 1 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac
if [ $# -eq 0 ]; then
  printf 'usage: ctx session record <unit> --what="..." [flags...]\n' >&2
  exit 1
fi
case "${2:-}" in
  --help|-h)
    [ $# -eq 2 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac

unit=$1
shift
vb_slug_ok "$unit" || { printf 'usage: ctx session record <unit> --what="..." [flags...]\n' >&2; exit 1; }

what=""; has_what=0
group=""
thread="none"
rhythm=""
knowledge=false
slug=""
nref=0
ncl=0

# every flag value, in order, for the one-line checks
nval=0
keep() { nval=$((nval + 1)); eval "VAL_$nval=\$1"; }
closer() { ncl=$((ncl + 1)); eval "CL_KIND_$ncl=\$1; CL_VAL_$ncl=\$2"; keep "$2"; }
ref() { nref=$((nref + 1)); eval "REF_$nref=\$1"; keep "$1"; }

need() { [ $# -ge 2 ] || fail "record: error: $1 needs a value (ERR_INVALID_ARGUMENT)"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --what=*) what="${1#--what=}"; has_what=1; keep "$what" ;;
    --what|-w) need "$@"; shift; what="$1"; has_what=1; keep "$what" ;;
    --group=*) group="${1#--group=}"; keep "$group" ;;
    --group|-g) need "$@"; shift; group="$1"; keep "$group" ;;
    --thread=*) thread="${1#--thread=}"; keep "$thread" ;;
    --thread|-t) need "$@"; shift; thread="$1"; keep "$thread" ;;
    --rhythm=*) rhythm="${1#--rhythm=}"; keep "$rhythm" ;;
    --rhythm) need "$@"; shift; rhythm="$1"; keep "$rhythm" ;;
    --ref=*) ref "${1#--ref=}" ;;
    --ref|-r) need "$@"; shift; ref "$1" ;;
    --closes=*) closer CLOSES "${1#--closes=}" ;;
    --closes) need "$@"; shift; closer CLOSES "$1" ;;
    --supersedes=*) closer SUPERSEDES "${1#--supersedes=}" ;;
    --supersedes) need "$@"; shift; closer SUPERSEDES "$1" ;;
    --knowledge|-k) knowledge=true ;;
    --slug=*) slug="${1#--slug=}"; keep "$slug" ;;
    --slug) need "$@"; shift; slug="$1"; keep "$slug" ;;
    *) vb_unknown record "$1" ;;
  esac
  shift
done

# the dialect is LF, and every record flag value is one line of the entry block
i=0
while [ "$i" -lt "$nval" ]; do
  i=$((i + 1))
  eval "v=\$VAL_$i"
  vb_has_cr "$v" && fail "ERROR: embedded carriage return in a record flag value (the dialect is LF)"
done
i=0
while [ "$i" -lt "$nval" ]; do
  i=$((i + 1))
  eval "v=\$VAL_$i"
  vb_has_nl "$v" && fail "ERROR: embedded newline in a record flag value (one line)"
done

[ "$has_what" -eq 1 ] && [ -n "$what" ] || fail "record: error: missing required --what parameter (ERR_INVALID_ARGUMENT)"

if [ -n "$group" ]; then
  vb_slug_ok "$group" || fail "ERROR: GROUP malformed: $group (letters, digits, underscore, dash; starts alphanumeric)"
fi
case "$thread" in
  ""|true|false) fail "ERROR: THREAD malformed: [$thread] (what the unit awaits, or none)" ;;
esac

dateslug_ok() {
  printf '%s\n' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-zA-Z0-9_-]+[a-zA-Z0-9]$'
}

if [ -n "$rhythm" ]; then
  # <name> <N> <GATE>: the step and its gate as .contexture/rhythms/<name>.md declares them
  set -f
  # shellcheck disable=SC2086
  set -- $rhythm
  set +f
  [ $# -eq 3 ] || fail "ERROR: RHYTHM malformed: $rhythm (the shape: <name> <N> <GATE>)"
  rname=$1; rstep=$2; rgate=$3
  vb_slug_ok "$rname" || fail "ERROR: RHYTHM name malformed: $rname"
  case "$rstep" in ""|*[!0-9]*) fail "ERROR: RHYTHM step malformed: $rstep" ;; esac
  [ "$rstep" -ge 1 ] || fail "ERROR: RHYTHM step malformed: $rstep"
  printf '%s\n' "$rgate" | grep -Eq '^[A-Z][A-Z_+]*$' || fail "ERROR: RHYTHM gate malformed: $rgate"
  rpath=".contexture/rhythms/$rname.md"
  [ -f "$rpath" ] || fail "ERROR: no such rhythm: $rpath"
  g=$(RS_STEP=$rstep awk '
    /^[ \t]*[0-9]+\.[ \t]*[A-Z][A-Z_+]*[ \t]*:/ {
      s = $0; sub(/^[ \t]+/, "", s); n = s; sub(/\..*$/, "", n)
      if (n + 0 == ENVIRON["RS_STEP"] + 0) { sub(/^[0-9]+\.[ \t]*/, "", s); sub(/[ \t]*:.*$/, "", s); print s; exit }
    }' "$rpath")
  [ -n "$g" ] || fail "ERROR: RHYTHM step $rstep not in $rpath"
  [ "$g" = "$rgate" ] || fail "ERROR: RHYTHM step $rstep of $rname reads $g, not $rgate"
fi

# a REF names its target in one of the two pointer shapes: <target>#<symbol> or a whole
# target path (lanes/<lane>/recipe), one token (end review item 6)
i=0
while [ "$i" -lt "$nref" ]; do
  i=$((i + 1))
  eval "r=\$REF_$i"
  vb_ref_ok record "$r"
done

today=$(vb_today)
if [ -n "$slug" ]; then
  printf '%s\n' "$slug" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}-' || slug="$today-$slug"
  dateslug_ok "$slug" || fail "ERROR: malformed entry slug: $slug (a date-slug like 2026-09-17-example)"
fi

# the closers (B10, end review item 5): only the explicit form <slug> (<verdict>: <reason>),
# one or more date-slug targets before the parenthesis, a verdict of done, superseded,
# dropped, or folded, and a non-empty reason holding no parenthesis; a bare target list
# refuses (the law puts the resolution in the closer, never a copy of the WHAT)
closer_fail() {
  fail "record: error: --$(printf '%s' "$1" | tr 'A-Z' 'a-z') takes <slug> (<verdict>: <reason>) with a verdict of done, superseded, dropped, or folded and a non-empty reason; $3: '$2' (ERR_INVALID_ARGUMENT)"
}
i=0
while [ "$i" -lt "$ncl" ]; do
  i=$((i + 1))
  eval "k=\$CL_KIND_$i; val=\$CL_VAL_$i"
  case "$val" in
    *'('*) ;;
    *) closer_fail "$k" "$val" "no (<verdict>: <reason>) given" ;;
  esac
  ts=${val%%(*}
  inner=${val#*(}
  case "$inner" in *')'*) ;; *) closer_fail "$k" "$val" "an unclosed reason" ;; esac
  after=${inner#*)}
  inner=${inner%%)*}
  case "$after" in
    *')'*|*'('*) closer_fail "$k" "$val" "a closer reason holds no parenthesis" ;;
    *[!' 	']*) closer_fail "$k" "$val" "text after the reason" ;;
  esac
  case "$inner" in *'('*) closer_fail "$k" "$val" "a closer reason holds no parenthesis" ;; esac
  case "$inner" in *:*) ;; *) closer_fail "$k" "$val" "no verdict before the reason" ;; esac
  verdict=$(printf '%s' "${inner%%:*}" | sed 's/^[ 	]*//; s/[ 	]*$//')
  reason=$(printf '%s' "${inner#*:}" | sed 's/^[ 	]*//; s/[ 	]*$//')
  case "$verdict" in
    done|superseded|dropped|folded) ;;
    *) closer_fail "$k" "$val" "unknown verdict '$verdict'" ;;
  esac
  [ -n "$reason" ] || closer_fail "$k" "$val" "an empty reason"
  case "$ts" in *' - '*|*'	-	'*|*' -	'*|*'	- '*) closer_fail "$k" "$val" "the legacy spaced-hyphen delimiter" ;; esac
  set -f
  # shellcheck disable=SC2086
  set -- $ts
  set +f
  [ $# -ge 1 ] || closer_fail "$k" "$val" "no target slug"
  for t in "$@"; do
    dateslug_ok "$t" || closer_fail "$k" "$val" "the target '$t' is not a date-slug like 2026-09-17-example"
  done
  eval "CL_V_$i=\$verdict; CL_R_$i=\$reason"
  eval "CL_TN_$i=$#"
  j=0
  for t in "$@"; do
    j=$((j + 1))
    eval "CL_T_${i}_$j=\$t"
  done
done

vb_kv what "$what"
[ -n "$group" ] && vb_kv group "$group"
vb_kv thread "$thread"
[ -n "$rhythm" ] && vb_kv rhythm "$rhythm"
vb_kv knowledge "$knowledge"
set --
i=0
while [ "$i" -lt "$nref" ]; do i=$((i + 1)); eval "set -- \"\$@\" \"\$REF_$i\""; done
vb_list refs "$@"
vb_kv closers.count "$ncl"
i=0
while [ "$i" -lt "$ncl" ]; do
  i=$((i + 1))
  eval "k=\$CL_KIND_$i; v=\$CL_V_$i; r=\$CL_R_$i; tn=\$CL_TN_$i"
  vb_kv "closers.$i.kind" "$k"
  vb_kv "closers.$i.targets.count" "$tn"
  j=0
  while [ "$j" -lt "$tn" ]; do
    j=$((j + 1))
    eval "t=\$CL_T_${i}_$j"
    vb_kv "closers.$i.targets.$j" "$t"
  done
  vb_kv "closers.$i.verdict" "$v"
  vb_kv "closers.$i.reason" "$r"
done
[ -n "$slug" ] && vb_kv slug "$slug"
vb_kv date "$today"
vb_kv epoch "$(vb_epoch)"
vb_call entry.record "$unit"
vb_ok
printf 'recorded entry: %s\n' "$(vb_field entry.slug)"
