#!/bin/sh
# summary: the load map plus one page; keep calling until a page reads complete
# usage: ctx session load <slug> [<page>]
# usage: ctx session load refs <ref_1> ... <ref_N> [<page>]
# help: sections in BIOS order: state, backlog, knowledge, the live journal (the board view), declared ref_sessions read-only, then the write-scope trailer; a page ends before the block that would pass the line target (about 500) or the byte budget (about 40KB), never mid-body; a single over-budget block renders whole on its own page; the backlog section renders DONE task blocks compactly (the @task line, STATUS, OBJECTIVE, DESCRIPTION; REFS, ACCEPTANCE CRITERIA, and IMPLEMENTATION DETAILS drop; the record is never edited); a unit the store lacks is fatal rc=1 with zero stdout; missing backlog, knowledge, or journal warns on stderr (the artifact and its unit named, never a storage location) and prints a placeholder; the refs form streams the named sessions alone, read-only, and fires no load hooks
# help: the storage driver answers the unit whole (session.load, or session.refload for the refs form) and base renders and pages it
# help: exit codes: 0 page loaded; 1 missing unit or invalid argument
# help: example: ctx session load my-unit
# help: example: ctx session load my-unit 2

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx session load <session-slug> [<page>]\n' >&2
  printf '       ctx session load refs <ref_1> ... <ref_N> [<page>]\n' >&2
  printf 'help: ctx session help\n' >&2
  exit 1
}

ref_hint() {
  printf 'to read a reference session: ctx session load refs <ref-slug>\n' >&2
  usage
}

is_num() {
  case "$1" in ""|*[!0-9]*) return 1 ;; esac
  return 0
}

case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac
[ $# -ge 1 ] || usage

page=1
if [ "$1" = refs ]; then
  form=refs
  shift
  [ $# -ge 1 ] || usage
  # a trailing number is the page
  eval "last=\${$#}"
  if is_num "$last"; then
    [ "$last" -ge 1 ] 2>/dev/null || usage
    page=$last
    n=$(($# - 1))
  else
    n=$#
  fi
  [ "$n" -ge 1 ] || usage
  args=""
  i=0
  for a in "$@"; do
    i=$((i + 1))
    [ "$i" -le "$n" ] || continue
    vb_slug_ok "$a" || usage
    is_num "$a" && usage
    args="$args $a"
  done
  # the slugs are checked, so the list splits on blanks alone
  set -- $args
  refstr="$*"
  vb_call session.refload "$@"
  if [ "$VB_RC" -eq 1 ]; then
    for r in "$@"; do
      if vb_err_has "unit '$r' not found"; then
        printf 'ERROR: no such session: %s\n' "$r" >&2
        exit 1
      fi
    done
  fi
  vb_ok
  awk -f "$VB_JSON" < "$VB_DIR/ans" > "$VB_DIR/flat" || exit 2
  RV_VIEW=refload awk -f "$VB_RENDER" < "$VB_DIR/flat" > "$VB_DIR/lines" || exit 1
  slug=""
else
  form=main
  [ $# -le 2 ] || usage
  slug=$1
  vb_slug_ok "$slug" || usage
  if [ $# -eq 2 ]; then
    is_num "$2" || ref_hint
    [ "$2" -ge 1 ] 2>/dev/null || usage
    page=$2
  fi
  vb_call session.load "$slug"
  if [ "$VB_RC" -eq 1 ] && vb_err_has "unit '$slug' not found"; then
    printf 'ERROR: missing state: unit %s\n' "$slug" >&2
    exit 1
  fi
  vb_ok
  awk -f "$VB_JSON" < "$VB_DIR/ans" > "$VB_DIR/flat" || exit 2
  RV_VIEW=load awk -f "$VB_RENDER" < "$VB_DIR/flat" > "$VB_DIR/lines" || exit 1
  refstr=""
fi

# the pages (the v0.54.0 algorithm unchanged): a page never spans sections; within a
# section it ends before the block whose addition would pass LINE_TARGET lines or
# BYTE_BUDGET bytes; a page always holds its first block whole; blocks start at a
# section's first line and at every @entry, @finding, @task, and @anchor line
LD_FORM=$form LD_SLUG=$slug LD_PAGE=$page LD_REFS=$refstr awk '
function hooks_ready(   bin) {
  if (!("CTX_BIN" in ENVIRON)) return 0
  bin = ENVIRON["CTX_BIN"]
  if (bin == "") return 0
  return (system("test -x \"" bin "\"") == 0)
}

function fire_hooks(point, args,   bin) {
  if (!hooks_ready()) return 0
  bin = ENVIRON["CTX_BIN"]
  return system("\"" bin "\" _hooks " point args)
}

function fail(msg) {
  print msg > "/dev/stderr"
  exit 1
}

function add(line, sec,   first) {
  total++
  L[total] = line
  S[total] = sec
  first = !(sec in secstart)
  if (first) {
    nsec++
    seclist[nsec] = sec
    secstart[sec] = total
  }
  secend[sec] = total
  B[total] = (first || line ~ /^@(entry|finding|task|anchor) /) ? 1 : 0
}

function compute_pages(   start, end, j, k, pl, pb, bl, bblk) {
  cum[0] = 0
  for (j = 1; j <= total; j++) cum[j] = cum[j - 1] + length(L[j]) + 1
  npages = 0
  start = 1
  while (start <= total) {
    npages++
    end = total
    for (j = start + 1; j <= total; j++) {
      if (S[j] != S[start]) {
        end = j - 1
        break
      }
    }
    for (j = start + 1; j <= end; j++) {
      if (!B[j]) continue
      pl = j - start
      pb = cum[j - 1] - cum[start - 1]
      k = j + 1
      while (k <= end && !B[k]) k++
      bl = k - j
      bblk = cum[k - 1] - cum[j - 1]
      if (pl + bl > LINE_TARGET || pb + bblk > BYTE_BUDGET) {
        end = j - 1
        break
      }
    }
    pstart[npages] = start
    pend[npages] = end
    psec[npages] = S[start]
    start = end + 1
  }
}

function print_map(   si, s, pf, pl, pi, span) {
  for (si = 1; si <= nsec; si++) {
    s = seclist[si]
    pf = 0
    pl = 0
    for (pi = 1; pi <= npages; pi++) {
      if (psec[pi] == s) {
        if (pf == 0) pf = pi
        pl = pi
      }
    }
    span = (pf == pl) ? ("page " pf) : ("pages " pf "-" pl)
    printf "  %s: lines %d-%d | %s\n", s, secstart[s], secend[s], span
  }
}

function page_header(form, page,   ps, label, w) {
  ps = pstart[page]
  label = S[ps]
  if (ps != secstart[label]) {
    split(L[ps], w, /[ \t]+/)
    label = w[1] " " w[2]
  }
  printf "[load %s | %s | page %d/%d | from %s]\n", form, psec[page], page, npages, label
}

function page_body(page,   i) {
  for (i = pstart[page]; i <= pend[page]; i++) print L[i]
}

BEGIN {
  LINE_TARGET = 500
  BYTE_BUDGET = 40960
  form = ENVIRON["LD_FORM"]
  slug = ENVIRON["LD_SLUG"]
  page = ENVIRON["LD_PAGE"] + 0
  refstr = ENVIRON["LD_REFS"]
  repos = ""
  while ((getline ln) > 0) {
    if (substr(ln, 1, 7) == "\001repos\t") { repos = substr(ln, 8); continue }
    t = index(ln, "\t")
    add(substr(ln, t + 1), substr(ln, 1, t - 1))
  }
  if (total == 0) fail("ERROR: nothing to load")
  compute_pages()
  if (page > npages) fail("ERROR: page out of range: " page " (1-" npages ")")

  if (form == "refs") {
    if (page < npages) printf "REF LOAD INCOMPLETE (page %d of %d): keep reading the ref\n", page, npages
    else printf "REF LOAD COMPLETE: pages %d/%d\n", npages, npages
    printf "session-load refs %s: %d lines, %d pages\n", refstr, total, npages
    print_map()
    printf "WRITE SCOPE: none; ref sessions READ-ONLY\n"
    print ""
    page_header("refs", page)
    page_body(page)
    if (page < npages) printf "keep reading: ctx session load refs %s %d (%d pages remain)\n", refstr, page + 1, npages - page
    else printf "ref load complete: pages %d/%d\n", npages, npages
    exit 0
  }

  fflush()
  if (fire_hooks("load-pre", " CTX_UNIT \"" slug "\" CTX_LOAD_FORM main CTX_LOAD_PAGE " page) != 0)
    fail("ERROR: load-pre point failed (block hook)")
  if (page < npages) {
    printf "LOAD INCOMPLETE (page %d of %d): keep calling until a page reads complete; do not start work from a partial record\n", page, npages
  } else {
    printf "LOAD COMPLETE: pages %d/%d; stamp the receipt: ctx session stamp %s \"<the loaded set + ref_sessions + the git state>\"\n", npages, npages, slug
  }
  fflush()
  if (fire_hooks("load-post", " CTX_UNIT \"" slug "\" CTX_LOAD_FORM main CTX_LOAD_PAGE " page) != 0)
    fail("ERROR: load-post point failed (block hook)")
  printf "session-load %s: %d lines, %d pages\n", slug, total, npages
  print_map()
  printf "WRITE SCOPE: unit %s + repos: [%s]; ref sessions READ-ONLY\n", slug, repos
  print ""
  page_header(slug, page)
  page_body(page)
  if (page < npages) printf "keep reading: ctx session load %s %d (%d pages remain)\n", slug, page + 1, npages - page
  else printf "load complete: pages %d/%d\n", npages, npages
  exit 0
}' < "$VB_DIR/lines"
