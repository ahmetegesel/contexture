#!/usr/bin/awk -f
# summary: the session audit: closures, entry grammar, the backlog and state cross-checks; prints the open thread tail
# usage: ctx session audit <slug>
# help: the repair instrument: fix what it flags, fill what is missing; rc=1 on dangling or slugless closers, dateless entry slugs, inline markers on @entry lines, bracketed field lines, unharvested KNOWLEDGE flags, DONE tasks without their backlog/<slug>: DONE event, IN_PROGRESS tasks absent from state.md, and entries dated at or after ENF_FROM missing THREAD; each finding is flagged by slug (some also by line); a legacy duplicate entry slug prints as a LEGACY DUPLICATE SLUG warning and leaves rc unchanged; when the run is clean, also prints the open thread tail with its targets; the tail is a display, never an enforcement: a thread paused stays open; an unreadable sibling skips its check quietly
# help: exit codes: 0 session audit clean (open thread tail printed if any); 1 grammar, closure, or consistency findings detected
# help: example: ctx session audit my-unit

# The record IO: every session artifact is read and written through the configured
# storage driver (artifact.read, artifact.write, artifact.list, session.list) by artifact
# key (state, backlog, knowledge, journal, lane/<lane>/<recipe|journal|report>); a fetched
# artifact lands in a scratch file under .contexture/tmp, removed at exit. disp() names an
# artifact in a message as <artifact>: unit <u> (a lane artifact as lane <l> <artifact>),
# never a storage location.
function disp(u, key,   l, a) {
  if (key ~ /^lane\//) {
    l = substr(key, 6)
    a = l
    sub(/\/.*$/, "", l)
    sub(/^[^\/]*\//, "", a)
    return "lane " l " " a ": unit " u
  }
  return key ": unit " u
}

function rec_q(s) {
  gsub(/'/, "'\\''", s)
  return "'" s "'"
}

function rec_resolver(   md) {
  if (REC_RESOLVER != "") return REC_RESOLVER
  md = (("CTX_MODULE_DIR" in ENVIRON) && ENVIRON["CTX_MODULE_DIR"] != "") ? ENVIRON["CTX_MODULE_DIR"] : ".contexture/modules/session"
  REC_RESOLVER = md "/scripts/driver-resolver"
  return REC_RESOLVER
}

function rec_scratch(   cmd, d) {
  if (REC_DIR != "") return REC_DIR
  system("mkdir -p .contexture/tmp")
  cmd = "mktemp -d .contexture/tmp/rec.XXXXXX 2>/dev/null"
  d = ""
  if ((cmd | getline d) <= 0) d = ""
  close(cmd)
  if (d == "") {
    print "ERROR: cannot create a scratch folder under .contexture/tmp" > "/dev/stderr"
    exit 2
  }
  REC_DIR = d
  return d
}

# rec_call(args, out): one driver call, stdout to the out file; rc 0 ok, 1 absent or
# refused; a storage failure (rc 2) is fatal and its diagnostic passes through
function rec_call(args, out,   e, rc, line) {
  e = out ".err"
  rc = system(rec_q(rec_resolver()) " " args " > " rec_q(out) " 2> " rec_q(e))
  if (rc == 0 || rc == 1) return rc
  while ((getline line < e) > 0) print line > "/dev/stderr"
  close(e)
  print "ERROR: the storage driver failed (rc=" rc "): " args > "/dev/stderr"
  exit 2
}

# rec_fetch(u, key): the artifact's scratch copy, "" when the driver reports it absent
function rec_fetch(u, key,   f, k) {
  k = u SUBSEP key
  if (k in REC_CACHE) return REC_CACHE[k]
  REC_N++
  f = rec_scratch() "/a" REC_N
  if (rec_call("artifact.read " rec_q(u) " " rec_q(key), f) == 0) {
    REC_CACHE[k] = f
    return f
  }
  REC_CACHE[k] = ""
  return ""
}

function rec_exists(u, key) {
  return (rec_fetch(u, key) != "")
}

# rec_put(u, key, file): the file becomes the artifact, atomically, through the driver
function rec_put(u, key, file,   rc) {
  close(file)
  rc = system(rec_q(rec_resolver()) " artifact.write " rec_q(u) " " rec_q(key) " < " rec_q(file))
  if (rc != 0) {
    print "ERROR: the storage driver refused writing " key " of " u " (rc=" rc ")" > "/dev/stderr"
    exit (rc == 1) ? 1 : 2
  }
  REC_CACHE[u SUBSEP key] = file
}

# rec_new(): a fresh scratch file name for a write
function rec_new() {
  REC_N++
  return rec_scratch() "/w" REC_N
}

# rec_units(U): every unit the store holds, in its listing order (bytewise by name);
# returns the count, 0 when the store holds none
function rec_units(U,   f, line, n, rest, p, u) {
  REC_N++
  f = rec_scratch() "/l" REC_N
  if (rec_call("session.list", f) != 0) return 0
  n = 0
  while ((getline line < f) > 0) {
    rest = line
    while ((p = index(rest, "\"unit\":\"")) > 0) {
      rest = substr(rest, p + 8)
      u = substr(rest, 1, index(rest, "\"") - 1)
      n++
      U[n] = u
    }
  }
  close(f)
  return n
}

# rec_list(u, K): the artifact keys the unit holds (artifact.list), count returned
function rec_list(u, K,   f, line, n) {
  REC_N++
  f = rec_scratch() "/k" REC_N
  if (rec_call("artifact.list " rec_q(u), f) != 0) return 0
  n = 0
  while ((getline line < f) > 0) {
    if (line == "") continue
    n++
    K[n] = line
  }
  close(f)
  return n
}

function rec_cleanup() {
  if (REC_DIR != "") system("rm -rf " rec_q(REC_DIR))
  REC_DIR = ""
}

function usage() {
  print "Usage: ctx session audit <session-slug>" > "/dev/stderr"
  print "help: ctx session help" > "/dev/stderr"
  fatal = 1
  exit 1
}

BEGIN {
  if (ARGC != 2 || refs != "" || refs_only != "") usage()
  slug = ARGV[1]
  if (slug !~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/) usage()
  journal_file = rec_fetch(slug, "journal")
  if (journal_file == "") {
    print "ERROR: missing " disp(slug, "journal") > "/dev/stderr"
    fatal = 1
    exit 1
  }

  ARGV[1] = journal_file
  # an absent sibling reads as an empty name: its getline fails and its check skips quietly
  backlogs = rec_fetch(slug, "backlog")
  states = rec_fetch(slug, "state")
  ENF_FROM = "2026-09-18"
}

/^@entry / {
  if ($2 in entries) {
    # a legacy shape, legitimate when written: reported, never failing; closers resolve
    # it by position, and the append guard refuses any new duplicate
    print "LEGACY DUPLICATE SLUG at line " NR ": " $2 " (first at line " entry_line[$2] "; warning: a closer closes the occurrences before it)"
  }
  entries[$2] = 1
  entry_line[$2] = NR
  last_entry = $2
  if ($2 !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-zA-Z0-9_-]+[a-zA-Z0-9]$/) {
    print "DATELESS SLUG at line " NR ": " $2
    bad++
  }
  if ($0 ~ /\[(THREAD|KNOWLEDGE|RHYTHM):/) {
    print "INLINE MARKER at line " NR ": " $2
    bad++
  }
}

/^  \[(THREAD|KNOWLEDGE|GROUP|RHYTHM|REF|CLOSES|SUPERSEDES):/ {
  print "BRACKETED FIELD at line " NR ": " substr($0, 3)
  bad++
}

/^  THREAD: / {
  v = $0
  sub(/^  THREAD: /, "", v)
  sub(/[ \t\r]+$/, "", v)
  hasthread[last_entry] = 1
  if (v != "none") {
    threaded[NR] = last_entry
    thtarget[NR] = v
  }
}

/^  KNOWLEDGE: true[ \t]*$/ {
  knowledge[last_entry] = entry_line[last_entry]
}

$1 == "CLOSES:" || $1 == "SUPERSEDES:" {
  line = $0
  sub(/^.*(CLOSES|SUPERSEDES):[ \t]*/, "", line)
  sub(/[ \t]+-[ \t]+.*$/, "", line)
  sub(/[ \t]+\(.*$/, "", line)
  n = split(line, words, /[ \t]+/)
  found = 0
  for (i = 1; i <= n; i++) {
    if (words[i] ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-zA-Z0-9_-]+[a-zA-Z0-9]$/) {
      targets[words[i]] = NR
      closed[words[i]] = 1
      found = 1
    }
  }
  if (found == 0) {
    print "SLUGLESS CLOSER at line " NR ": no valid date-slug target"
    bad++
  }
}

{ jtext = jtext "\n" $0 }

END {
  if (fatal) { rec_cleanup(); exit 1 }
  dangling_count = 0
  for (t in targets) {
    if (!(t in entries)) {
      print "DANGLING CLOSER at line " targets[t] ": " t
      dangling_count++
    }
  }

  for (e in knowledge) {
    if (!(e in closed)) {
      print "UNHARVESTED KNOWLEDGE at line " knowledge[e] ": " e
      bad++
    }
  }

  bloaded = 0
  while (backlogs != "" && (getline line < backlogs) > 0) {
    bloaded = 1
    if (line ~ /^@task[ \t]/) {
      cur = line
      sub(/^@task[ \t]+/, "", cur)
      sub(/[ \t]+.*$/, "", cur)
    } else if (line ~ /^  STATUS:[ \t]/) {
      st = line
      sub(/^  STATUS:[ \t]+/, "", st)
      sub(/[ \t]+.*$/, "", st)
      if (cur != "") {
        if (st == "DONE") done[cur] = 1
        else if (st == "IN_PROGRESS") inp[cur] = 1
      }
    }
  }
  if (backlogs != "") close(backlogs)

  sloaded = 0
  statetext = ""
  while (states != "" && (getline line < states) > 0) {
    sloaded = 1
    statetext = statetext " " line
  }
  if (states != "") close(states)

  if (bloaded) {
    for (t in done) {
      if (index(jtext, "backlog/" t ": DONE") == 0) {
        print "DONE WITHOUT EVENT (backlog/" t ": DONE): " t
        bad++
      }
    }
  }
  if (sloaded) {
    for (t in inp) {
      if (index(statetext, t) == 0) {
        print "IN_PROGRESS ABSENT FROM STATE: " t
        bad++
      }
    }
  }

  for (e in entries) {
    if (e ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-zA-Z0-9_-]+[a-zA-Z0-9]$/ && substr(e, 1, 10) >= ENF_FROM && !(e in hasthread)) {
      print "MISSING THREAD at line " entry_line[e] ": " e " (declare THREAD: <what it awaits> | none)"
      bad++
    }
  }

  if (bad > 0 || dangling_count > 0) {
    rec_cleanup()
    exit 1
  }
  tail = 0
  for (l = 1; l <= NR; l++) {
    if (l in threaded && !(threaded[l] in closed)) {
      if (tail == 0) {
        print "OPEN THREADS (awaiting resolution):"
      }
      print "  line " l ": " threaded[l] " (" thtarget[l] ")"
      tail++
    }
  }
  if (tail == 0) {
    print "open threads: none"
  }
  rec_cleanup()
}
