#!/usr/bin/awk -f
# summary: every ACTIVE unit at a glance
# usage: ctx session active
# help: no arguments: every ACTIVE unit (slug, current_anchor, next_action, objective verbatim) then the closed count; a store not created yet prints "no sessions yet" rc=0; an argument refuses rc=1
# help: exit codes: 0 every active unit printed (or "no sessions yet"); 1 an argument was passed
# help: example: ctx session active
# Walks the units the storage driver lists (session.list, bytewise by
# name) and reads each state through the driver; for each ACTIVE unit
# prints the slug, current_anchor, next_action, and objective verbatim
# (quotes kept, continuation lines included), then the closed count,
# derived as the count of units holding a state minus the ACTIVE count. A state whose status is neither exact ACTIVE nor CLOSED, or an
# unreadable state, warns on stderr and counts as closed, so nothing
# vanishes silently. A store not created yet (storage.health degraded) prints
# "no sessions yet" rc=0; an argument refuses rc=1 with zero stdout.

# The record IO: every session artifact is read and written through the configured
# storage driver (artifact.read, artifact.write, artifact.list, session.list) by artifact
# key (state, backlog, knowledge, journal, lane/<lane>/<recipe|journal|report>); a fetched
# artifact lands in a scratch file under .contexture/tmp, removed at exit. disp() names an
# artifact in a message as <artifact>: unit <u> (a lane artifact as lane <l> <artifact>),
# never a storage location.
function disp(u, key,   l, a) {
  if (key ~ /^lane\//) {
    l = substr(key, 6)
    a = l
    sub(/\/.*$/, "", l)
    sub(/^[^\/]*\//, "", a)
    return "lane " l " " a ": unit " u
  }
  return key ": unit " u
}

function rec_q(s) {
  gsub(/'/, "'\\''", s)
  return "'" s "'"
}

function rec_resolver(   md) {
  if (REC_RESOLVER != "") return REC_RESOLVER
  md = (("CTX_MODULE_DIR" in ENVIRON) && ENVIRON["CTX_MODULE_DIR"] != "") ? ENVIRON["CTX_MODULE_DIR"] : ".contexture/modules/session"
  REC_RESOLVER = md "/scripts/driver-resolver"
  return REC_RESOLVER
}

function rec_scratch(   cmd, d) {
  if (REC_DIR != "") return REC_DIR
  system("mkdir -p .contexture/tmp")
  cmd = "mktemp -d .contexture/tmp/rec.XXXXXX 2>/dev/null"
  d = ""
  if ((cmd | getline d) <= 0) d = ""
  close(cmd)
  if (d == "") {
    print "ERROR: cannot create a scratch folder under .contexture/tmp" > "/dev/stderr"
    exit 2
  }
  REC_DIR = d
  return d
}

# rec_call(args, out): one driver call, stdout to the out file; rc 0 ok, 1 absent or
# refused; a storage failure (rc 2) is fatal and its diagnostic passes through
function rec_call(args, out,   e, rc, line) {
  e = out ".err"
  rc = system(rec_q(rec_resolver()) " " args " > " rec_q(out) " 2> " rec_q(e))
  if (rc == 0 || rc == 1) return rc
  while ((getline line < e) > 0) print line > "/dev/stderr"
  close(e)
  print "ERROR: the storage driver failed (rc=" rc "): " args > "/dev/stderr"
  exit 2
}

# rec_fetch(u, key): the artifact's scratch copy, "" when the driver reports it absent
function rec_fetch(u, key,   f, k) {
  k = u SUBSEP key
  if (k in REC_CACHE) return REC_CACHE[k]
  REC_N++
  f = rec_scratch() "/a" REC_N
  if (rec_call("artifact.read " rec_q(u) " " rec_q(key), f) == 0) {
    REC_CACHE[k] = f
    return f
  }
  REC_CACHE[k] = ""
  return ""
}

function rec_exists(u, key) {
  return (rec_fetch(u, key) != "")
}

# rec_put(u, key, file): the file becomes the artifact, atomically, through the driver
function rec_put(u, key, file,   rc) {
  close(file)
  rc = system(rec_q(rec_resolver()) " artifact.write " rec_q(u) " " rec_q(key) " < " rec_q(file))
  if (rc != 0) {
    print "ERROR: the storage driver refused writing " key " of " u " (rc=" rc ")" > "/dev/stderr"
    exit (rc == 1) ? 1 : 2
  }
  REC_CACHE[u SUBSEP key] = file
}

# rec_new(): a fresh scratch file name for a write
function rec_new() {
  REC_N++
  return rec_scratch() "/w" REC_N
}

# rec_units(U): every unit the store holds, in its listing order (bytewise by name);
# returns the count, 0 when the store holds none
function rec_units(U,   f, line, n, rest, p, u) {
  REC_N++
  f = rec_scratch() "/l" REC_N
  if (rec_call("session.list", f) != 0) return 0
  n = 0
  while ((getline line < f) > 0) {
    rest = line
    while ((p = index(rest, "\"unit\":\"")) > 0) {
      rest = substr(rest, p + 8)
      u = substr(rest, 1, index(rest, "\"") - 1)
      n++
      U[n] = u
    }
  }
  close(f)
  return n
}

# rec_list(u, K): the artifact keys the unit holds (artifact.list), count returned
function rec_list(u, K,   f, line, n) {
  REC_N++
  f = rec_scratch() "/k" REC_N
  if (rec_call("artifact.list " rec_q(u), f) != 0) return 0
  n = 0
  while ((getline line < f) > 0) {
    if (line == "") continue
    n++
    K[n] = line
  }
  close(f)
  return n
}

function rec_cleanup() {
  if (REC_DIR != "") system("rm -rf " rec_q(REC_DIR))
  REC_DIR = ""
}

function store_absent(   f, line, absent) {
  f = rec_new()
  absent = 0
  if (rec_call("storage.health", f) == 0) {
    while ((getline line < f) > 0) if (index(line, "\"health\":\"degraded\"") > 0) absent = 1
    close(f)
  }
  return absent
}

function usage() {
  print "Usage: ctx session active" > "/dev/stderr"
  print "help: ctx session help" > "/dev/stderr"
  exit 1
}

BEGIN {
  if (ARGC > 1) usage()
  nall = rec_units(U)
  # a store not created yet (storage.health degraded) has no sessions at all
  if (nall == 0 && store_absent()) {
    print "no sessions yet"
    exit 0
  }

  nactive = 0
  ntotal = 0
  first = 1
  for (ui = 1; ui <= nall; ui++) {
    u = U[ui]
    state = rec_fetch(u, "state")
    if (state == "") continue
    ntotal++
    status = ""
    anchor = ""
    nl = 0
    ol = 0
    cur = ""
    while ((r = (getline line < state)) > 0) {
      if (line ~ /^[ \t]*$/) {
        cur = ""
        continue
      }
      if (line ~ /^[ \t]/) {
        if (cur == "next_action") {
          nl++
          nxt[nl] = line
        } else if (cur == "objective") {
          ol++
          obj[ol] = line
        }
        continue
      }
      if (line ~ /^status:[ \t]*/) {
        status = line
        sub(/^status:[ \t]*/, "", status)
        sub(/[ \t\r]+$/, "", status)
        cur = "status"
      } else if (line ~ /^current_anchor:[ \t]*/) {
        anchor = line
        cur = "current_anchor"
      } else if (line ~ /^next_action:[ \t]*/) {
        nl = 1
        nxt[nl] = line
        cur = "next_action"
      } else if (line ~ /^objective:[ \t]*/) {
        ol = 1
        obj[ol] = line
        cur = "objective"
      } else {
        cur = ""
      }
    }
    close(state)

    if (r < 0) {
      print "WARNING: unreadable " disp(u, "state") > "/dev/stderr"
      continue
    }

    if (status == "ACTIVE") {
      slug = u
      if (first == 0) print ""
      first = 0
      nactive++
      print slug
      if (anchor != "") print "  " anchor
      for (i = 1; i <= nl; i++) print "  " nxt[i]
      for (i = 1; i <= ol; i++) print "  " obj[i]
    } else if (status != "CLOSED") {
      print "WARNING: unrecognized status [" status "] in " disp(u, "state") > "/dev/stderr"
    }
  }

  if (nactive == 0) print "no active sessions"
  print "closed: " (ntotal - nactive)
  exit 0
}

END {
  rec_cleanup()
}
