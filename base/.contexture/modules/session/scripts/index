#!/usr/bin/awk -f
# summary: the rhythm index from .contexture/rhythms/ as name (path) | use when | activation
# usage: ctx session index
# help: no arguments: reads .contexture/rhythms/*.md; an argument refuses rc=1
# help: exit codes: 0 rhythm index printed; 1 unexpected argument passed
# help: example: ctx session index

function usage() {
  print "Usage: ctx session index" > "/dev/stderr"
  print "help: ctx session help" > "/dev/stderr"
  exit 1
}

function emit() {
  if (name != "")
    printf "%s (%s) | use when: %s | activation: %s\n",
           name, src, (use == "" ? "(missing)" : use),
           (act == "" ? "propose" : act)
}

function process(path,   line) {
  name = ""; use = ""; act = ""; src = path
  while ((getline line < path) > 0) {
    if (line ~ /^@rhythm /) {
      name = line
      sub(/^@rhythm[[:space:]]+/, "", name)
    } else if (line ~ /^  use when:/) {
      use = line
      sub(/^  use when:[[:space:]]*/, "", use)
    } else if (line ~ /^  activation:/) {
      act = line
      sub(/^  activation:[[:space:]]*/, "", act)
    }
  }
  close(path)
  emit()
}

BEGIN {
  if (ARGC > 1) usage()
  if (system("test -d .contexture/rhythms") != 0) {
    print "ERROR: missing rhythms directory: .contexture/rhythms" > "/dev/stderr"
    exit 1
  }
  cmd = "ls .contexture/rhythms/*.md 2>/dev/null"
  while ((cmd | getline fname) > 0) {
    process(fname)
  }
  close(cmd)
  exit 0
}
