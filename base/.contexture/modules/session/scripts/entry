#!/bin/sh
# summary: journal entry operations (show, list, closure)
# usage: ctx session entry <subcommand> <unit> [args...]
# help: subcommands:
# help:   show <unit> <slug> [--json]
# help:   list <unit> [--anchor=A<N>] [--group=...] [--json]
# help:   closure <unit> <slug> [--json]
# help: show prints the entry's stored block (the last occurrence of a repeated legacy slug); list prints one line per entry occurrence; closure prints whether the entry is closed and every later closer naming it (positional: a closer closes the occurrences before it)

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

help_table() {
  printf 'usage: ctx session entry <subcommand> <unit> [args...]\n'
  printf 'subcommands:\n'
  printf '  show <unit> <slug> [--json]\n'
  printf '  list <unit> [--anchor=A<N>] [--group=...] [--json]\n'
  printf '  closure <unit> <slug> [--json]\n'
}

if [ $# -eq 0 ]; then
  printf 'usage: ctx session entry <subcommand> <unit> [args...]\n' >&2
  printf 'subcommands: show, list, closure\n' >&2
  exit 1
fi

case "$1" in
  --help|-h|help) help_table; exit 0 ;;
esac

subcmd="$1"
shift
case "${1:-}" in
  --help|-h) help_table | awk -v s="$subcmd" 'NR == 1 || $1 == s'; exit 0 ;;
esac

case "$subcmd" in
  show|closure)
    [ $# -gt 0 ] || { printf 'entry %s: error: missing unit argument\n' "$subcmd" >&2; exit 1; }
    unit="$1"; shift
    vb_unit "entry $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'entry %s: error: missing entry slug\n' "$subcmd" >&2; exit 1; }
    slug="$1"; shift
    json_out=0
    for a in "$@"; do
      case "$a" in
        --json) json_out=1 ;;
        *) vb_unknown "entry $subcmd" "$a" ;;
      esac
    done
    if [ "$subcmd" = show ]; then vb_call entry.get "$unit" "$slug"; else vb_call entry.closure "$unit" "$slug"; fi
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json
    elif [ "$subcmd" = show ]; then vb_render entry_show
    else vb_render closure
    fi
    exit 0
    ;;

  list)
    [ $# -gt 0 ] || { printf 'entry list: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "entry $subcmd" "$unit"
    json_out=0
    anchor_filter=""
    group_filter=""
    for a in "$@"; do
      case "$a" in
        --json) json_out=1 ;;
        --anchor=*) anchor_filter="${a#--anchor=}" ;;
        --group=*) group_filter="${a#--group=}" ;;
        *) vb_unknown "entry list" "$a" ;;
      esac
    done
    # the filters are the driver's (entry.list --anchor, --group), so text and JSON agree
    set --
    [ -n "$anchor_filter" ] && set -- "$@" "--anchor=$anchor_filter"
    [ -n "$group_filter" ] && set -- "$@" "--group=$group_filter"
    vb_call entry.list "$unit" "$@"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else vb_render entry_list; fi
    exit 0
    ;;

  *)
    unit="$subcmd"
    if [ $# -eq 0 ]; then
      exec sh "$0" list "$unit"
    else
      exec sh "$0" show "$unit" "$@"
    fi
    ;;
esac
