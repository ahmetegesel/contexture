#!/bin/sh
# summary: journal entry operations (show, list)
# usage: ctx session entry <subcommand> <unit> [args...]
# help: subcommands:
# help:   show <unit> <slug> [--json]
# help:   list <unit> [--anchor=A<N>] [--group=...] [--json]

set -u

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
resolver="$dir/driver-resolver"
if [ ! -x "$resolver" ]; then
  if [ -n "${CTX_MODULE_DIR:-}" ] && [ -x "$CTX_MODULE_DIR/scripts/driver-resolver" ]; then
    resolver="$CTX_MODULE_DIR/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver"
  fi
fi

if [ $# -eq 0 ]; then
  printf 'usage: ctx session entry <subcommand> <unit> [args...]\n' >&2
  printf 'subcommands: show, list\n' >&2
  exit 1
fi

case "$1" in
  --help|-h|help)
    printf 'usage: ctx session entry <subcommand> <unit> [args...]\n'
    printf 'subcommands:\n'
    printf '  show <unit> <slug> [--json]\n'
    printf '  list <unit> [--anchor=A<N>] [--group=...] [--json]\n'
    exit 0
    ;;
esac

subcmd="$1"
shift
case "${1:-}" in
  --help|-h) "$0" --help | awk -v s="$subcmd" 'NR == 1 || $1 == s'; exit 0 ;;
esac

case "$subcmd" in
  show)
    [ $# -gt 0 ] || { printf 'entry show: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    [ $# -gt 0 ] || { printf 'entry show: error: missing entry slug\n' >&2; exit 1; }
    slug="$1"; shift
    json_out=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) json_out=1 ;;
      esac
      shift
    done
    out=$("$resolver" entry.show "$unit" "$slug")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      # the readable block, every JSON escape decoded
      printf '%s\n' "$out" | awk '
        # jstr(s, pos): the JSON string whose first character sits at pos (after the
        # opening quote), escapes decoded (\" \\ \/ \n \t \r); JEND lands on the closing quote
        function jstr(s, pos,   out, c, e, i, n) {
          out = ""
          n = length(s)
          for (i = pos; i <= n; i++) {
            c = substr(s, i, 1)
            if (c == "\\") {
              i++
              e = substr(s, i, 1)
              if (e == "n") out = out "\n"
              else if (e == "t") out = out "\t"
              else if (e == "r") out = out "\r"
              else out = out e
              continue
            }
            if (c == "\"") { JEND = i; return out }
            out = out c
          }
          JEND = n
          return out
        }
        # jval(s, key): the decoded string value of the first "key":"..." in s, "" when absent
        function jval(s, key,   p) {
          p = index(s, "\"" key "\":\"")
          if (p == 0) return ""
          return jstr(s, p + length(key) + 4)
        }
        {
          line = $0
          t = index(line, "\"entry\":{")
          if (t > 0) line = substr(line, t)
          printf "@entry %s\n", jval(line, "slug")
          anc = jval(line, "anchor")
          if (anc != "") printf "  ANCHOR: %s\n", anc
          w = jval(line, "what")
          if (w != "") printf "  WHAT: \"%s\"\n", w
          g = jval(line, "group")
          if (g != "") printf "  GROUP: %s\n", g
          th = jval(line, "thread")
          if (th != "") printf "  THREAD: %s\n", th
        }
      '
    fi
    exit 0
    ;;

  list)
    [ $# -gt 0 ] || { printf 'entry list: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    json_out=0
    anchor_filter=""
    group_filter=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --json) json_out=1 ;;
        --anchor=*) anchor_filter="${1#--anchor=}" ;;
        --group=*) group_filter="${1#--group=}" ;;
      esac
      shift
    done
    # the filters are the driver's (entry.list --anchor, --group), so text and JSON agree
    set --
    [ -n "$anchor_filter" ] && set -- "$@" "--anchor=$anchor_filter"
    [ -n "$group_filter" ] && set -- "$@" "--group=$group_filter"
    out=$("$resolver" entry.list "$unit" "$@")
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    if [ "$json_out" -eq 1 ]; then
      printf '%s\n' "$out"
    else
      printf '%s\n' "$out" | awk '
        # jstr(s, pos): the JSON string whose first character sits at pos (after the
        # opening quote), escapes decoded (\" \\ \/ \n \t \r); JEND lands on the closing quote
        function jstr(s, pos,   out, c, e, i, n) {
          out = ""
          n = length(s)
          for (i = pos; i <= n; i++) {
            c = substr(s, i, 1)
            if (c == "\\") {
              i++
              e = substr(s, i, 1)
              if (e == "n") out = out "\n"
              else if (e == "t") out = out "\t"
              else if (e == "r") out = out "\r"
              else out = out e
              continue
            }
            if (c == "\"") { JEND = i; return out }
            out = out c
          }
          JEND = n
          return out
        }
        # jval(s, key): the decoded string value of the first "key":"..." in s, "" when absent
        function jval(s, key,   p) {
          p = index(s, "\"" key "\":\"")
          if (p == 0) return ""
          return jstr(s, p + length(key) + 4)
        }
        {
          line = $0
          # a raw {"slug":" never occurs inside a JSON string (its quotes would be escaped)
          while ((p = index(line, "{\"slug\":\"")) > 0) {
            line = substr(line, p + 1)
            q = index(substr(line, 2), "{\"slug\":\"")
            item = (q > 0) ? substr(line, 1, q) : line
            printf "  [%s] %s: %s\n", jval(item, "anchor"), jval(item, "slug"), jval(item, "what")
          }
        }
      '
    fi
    exit 0
    ;;

  *)
    unit="$subcmd"
    if [ $# -eq 0 ]; then
      exec "$0" list "$unit"
    else
      exec "$0" show "$unit" "$@"
    fi
    ;;
esac
