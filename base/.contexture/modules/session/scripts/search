#!/bin/sh
# summary: universal search across session records and artifacts
# usage: ctx session search <unit> "<query>" --mode=MODE [options]
# help: searches session records (tasks, entries, findings, lanes) for query terms
# help: options:
# help:   --json              output JSON format
# help:   --limit=N           maximum number of results returned (default 20)
# help:   --mode=MODE         the search mode, required (no default): exact, the one mode every driver implements (a case-insensitive ASCII substring of one line, one row per matching entity and section, total_matches counting those rows), or a ranked mode the configured driver declares (ctx session diagnose lists the declared modes); a search without --mode refuses rc 1 naming the declared modes, and a mode the driver does not declare refuses rc 1 naming them too
# help:   --entity=TYPE       filter by entity type (session, task, entry, finding, lane, lane_entry, all)
# help: every driver returns the same keys per result: entity_type, entity_id, section, snippet, score (0 for exact); an empty query refuses rc 1 (ERR_INVALID_ARGUMENT)

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

if [ $# -eq 0 ]; then
  printf 'usage: ctx session search <unit> "<query>" --mode=MODE [options]\n' >&2
  printf 'options: --mode=MODE (required), --json, --limit=N, --entity=TYPE\n' >&2
  exit 1
fi

case "$1" in
  --help|-h|help)
    printf 'usage: ctx session search <unit> "<query>" --mode=MODE [options]\n'
    printf 'searches session records (tasks, entries, findings, lanes) for query terms\n'
    printf 'options:\n'
    printf '  --json              output JSON format\n'
    printf '  --limit=N           maximum number of results returned (default 20)\n'
    printf '  --mode=MODE         the search mode, required: exact or a mode the configured driver declares (ctx session diagnose lists them)\n'
    printf '  --entity=TYPE       filter by entity type (session, task, entry, finding, lane, lane_entry, all)\n'
    exit 0
    ;;
esac

unit="$1"
vb_unit search "$unit"
shift

if [ $# -eq 0 ]; then
  printf 'search: error: query string required\n' >&2
  exit 1
fi

query="$1"
shift

vb_refuse_cr "$query"
if [ -z "$(printf '%s' "$query" | tr -d ' \t')" ]; then
  printf 'search.query: error: empty query (ERR_INVALID_ARGUMENT)\n' >&2
  exit 1
fi

json_out=0
limit=""
entity=""
mode=""

while [ $# -gt 0 ]; do
  case "$1" in
    --json) json_out=1 ;;
    --limit=*) limit="${1#--limit=}" ;;
    -l) shift; [ $# -gt 0 ] && limit="$1" ;;
    --mode=*) mode="${1#--mode=}" ;;
    --entity=*) entity="${1#--entity=}" ;;
    *) printf "search: error: unknown option '%s' (ERR_INVALID_ARGUMENT)\n" "$1" >&2; exit 1 ;;
  esac
  shift
done

if [ -n "$limit" ]; then
  case "$limit" in
    *[!0-9]*|0*) printf "search: error: --limit takes a positive number: '%s' (ERR_INVALID_ARGUMENT)\n" "$limit" >&2; exit 1 ;;
  esac
fi
if [ -n "$entity" ]; then
  case "$entity" in
    all|session|task|entry|finding|lane|lane_entry) ;;
    *) printf "search: error: unknown entity type '%s' (session, task, entry, finding, lane, lane_entry, all) (ERR_INVALID_ARGUMENT)\n" "$entity" >&2; exit 1 ;;
  esac
fi
if [ -n "$mode" ]; then
  case "$mode" in
    [!a-z]*|*[!a-z0-9_-]*) printf "search: error: malformed mode '%s' (ERR_INVALID_ARGUMENT)\n" "$mode" >&2; exit 1 ;;
  esac
else
  # no default mode (end review item 2): the refusal names the modes the configured driver
  # declares, read from its descriptor (the resolver's handshake read, never a record read)
  vb_tmp
  if "$VB_RESOLVER" capability < /dev/null > "$VB_DIR/cap" 2> "$VB_DIR/caperr"; then
    modes=$(awk -f "$VB_JSON" < "$VB_DIR/cap" | awk '
      /^search_modes\.[0-9]+=/ { v = $0; sub(/^[^=]*=/, "", v); o = o (o == "" ? "" : ", ") v }
      END { print (o == "" ? "none" : o) }')
  else
    modes="unknown (the driver's descriptor did not answer)"
  fi
  printf "search: error: --mode is required: exact or a mode the configured driver declares; declared modes: %s (ERR_INVALID_ARGUMENT)\n" "$modes" >&2
  exit 1
fi

set --
[ -n "$limit" ] && set -- "$@" "--limit=$limit"
[ -n "$entity" ] && set -- "$@" "--entity=$entity"
set -- "$@" "--mode=$mode"
vb_kv query "$query"
vb_call search.query "$unit" "$@"
vb_ok

if [ "$json_out" -eq 1 ]; then
  vb_json
else
  vb_render search RV_UNIT="$unit" RV_QUERY="$query"
fi
exit 0
