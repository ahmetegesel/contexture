#!/bin/sh
# summary: resolve abstract entity references (task#slug, finding#NAME, entry#slug, lane#slug/report#claim)
# usage: ctx session resolve <unit> <ref> [--json]
# help: resolves domain references and normalizes legacy file-based references
# help: arguments:
# help:   <unit>      session unit slug
# help:   <ref>       abstract entity reference (task#slug, finding#NAME, entry#slug, lane#slug/report#claim); the legacy file forms (backlog.md#slug, knowledge.md#NAME, journal.md#slug, lanes/<lane>/report.md#claim) resolve the same entities
# help: the text view prints the entity block verbatim (the item's span, its trailing separator included; a report claim from its @<claim> line to the next column-0 @ line); --json prints the storage function's answer (task.get, finding.get, entry.get, or lane.get)
# help:   --json      output JSON format

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

if [ $# -lt 2 ]; then
  if [ $# -gt 0 ]; then
    case "$1" in
      --help|-h|help)
        printf 'usage: ctx session resolve <unit> <ref> [--json]\n'
        printf 'resolves abstract entity references (task#slug, finding#NAME, entry#slug, lane#slug/report#claim)\n'
        printf 'options:\n'
        printf '  --json      output JSON format\n'
        exit 0
        ;;
    esac
  fi
  printf 'usage: ctx session resolve <unit> <ref> [--json]\n' >&2
  exit 1
fi

unit="$1"
vb_unit resolve "$unit"
shift
ref="$1"
shift

json_out=0
for a in "$@"; do
  case "$a" in
    --json) json_out=1 ;;
    *) vb_unknown resolve "$a" ;;
  esac
done

unsupported() {
  printf "resolve: error: unsupported ref format: '%s' (ERR_INVALID_ARGUMENT)\n" "$ref" >&2
  exit 1
}

kind=""
id=""
lane=""
case "$ref" in
  task#*|backlog#*|backlog.md#*) kind=task; id="${ref#*#}" ;;
  finding#*|knowledge#*|knowledge.md#*) kind=finding; id="${ref#*#}" ;;
  entry#*|journal#*|journal.md#*) kind=entry; id="${ref#*#}" ;;
  lane#*/report#*)
    rest="${ref#lane#}"
    lane="${rest%%/report#*}"
    id="${rest#*/report#}"
    kind=claim
    ;;
  lanes/*/report.md#*|lanes/*/report#*)
    rest="${ref#lanes/}"
    lane="${rest%%/*}"
    id="${ref##*#}"
    kind=claim
    ;;
esac
[ -n "$kind" ] && [ -n "$id" ] || unsupported
[ "$kind" = claim ] && { vb_slug_ok "$lane" || unsupported; }

case "$kind" in
  task) vb_call task.get "$unit" "$id" ;;
  finding) vb_call finding.get "$unit" "$id" ;;
  entry) vb_call entry.get "$unit" "$id" ;;
  claim) vb_call lane.get "$unit" "$lane" report ;;
esac
if [ "$VB_RC" -eq 1 ] && vb_err_has "ERR_ENTITY_NOT_FOUND" && ! vb_err_has "unit '$unit' not found"; then
  printf "resolve: error: reference '%s' not found in unit '%s' (ERR_ENTITY_NOT_FOUND)\n" "$ref" "$unit" >&2
  exit 1
fi
if [ "$VB_RC" -eq 1 ] && vb_err_has "ERR_INVALID_ARGUMENT"; then
  unsupported
fi
vb_ok

if [ "$json_out" -eq 1 ]; then
  # a claim the report lacks refuses in both views
  if [ "$kind" = claim ]; then
    vb_render resolve RV_KIND="$kind" RV_CLAIM="$id" RV_REF="$ref" RV_UNIT="$unit" > /dev/null || exit 1
  fi
  vb_json
  exit 0
fi
vb_render resolve RV_KIND="$kind" RV_CLAIM="$id" RV_REF="$ref" RV_UNIT="$unit"
