#!/bin/sh
# summary: resolve abstract entity references (task#slug, finding#NAME, entry#slug, lane#slug/report#claim)
# usage: ctx session resolve <unit> <ref> [--json]
# help: resolves domain references and normalizes legacy file-based references
# help: arguments:
# help:   <unit>      session unit slug
# help:   <ref>       abstract entity reference (task#slug, finding#NAME, entry#slug, lane#slug/report#claim); the legacy file forms (backlog.md#slug, knowledge.md#NAME, journal.md#slug, lanes/<lane>/report.md#claim) resolve the same entities
# help: the text view prints the entity block verbatim; --json returns the target fields and the block
# help:   --json      output JSON format

set -u

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
resolver="$dir/driver-resolver"
if [ ! -x "$resolver" ]; then
  if [ -n "${CTX_MODULE_DIR:-}" ] && [ -x "$CTX_MODULE_DIR/scripts/driver-resolver" ]; then
    resolver="$CTX_MODULE_DIR/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver"
  fi
fi

if [ $# -lt 2 ]; then
  if [ $# -gt 0 ]; then
    case "$1" in
      --help|-h|help)
        printf 'usage: ctx session resolve <unit> <ref> [--json]\n'
        printf 'resolves abstract entity references (task#slug, finding#NAME, entry#slug, lane#slug/report#claim)\n'
        printf 'options:\n'
        printf '  --json      output JSON format\n'
        exit 0
        ;;
    esac
  fi
  printf 'usage: ctx session resolve <unit> <ref> [--json]\n' >&2
  exit 1
fi

unit="$1"
shift
ref="$1"
shift

json_out=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json_out=1 ;;
  esac
  shift
done

out=$("$resolver" resolve.ref "$unit" "$ref")
rc=$?
if [ "$rc" -ne 0 ]; then
  exit "$rc"
fi

if [ "$json_out" -eq 1 ]; then
  printf '%s\n' "$out"
else
  # the text view prints the entity block verbatim (the driver returns it whole)
  printf '%s\n' "$out" | awk '
        # jstr(s, pos): the JSON string whose first character sits at pos (after the
        # opening quote), escapes decoded (\" \\ \/ \n \t \r); JEND lands on the closing quote
        function jstr(s, pos,   out, c, e, i, n) {
          out = ""
          n = length(s)
          for (i = pos; i <= n; i++) {
            c = substr(s, i, 1)
            if (c == "\\") {
              i++
              e = substr(s, i, 1)
              if (e == "n") out = out "\n"
              else if (e == "t") out = out "\t"
              else if (e == "r") out = out "\r"
              else out = out e
              continue
            }
            if (c == "\"") { JEND = i; return out }
            out = out c
          }
          JEND = n
          return out
        }
        # jval(s, key): the decoded string value of the first "key":"..." in s, "" when absent
        function jval(s, key,   p) {
          p = index(s, "\"" key "\":\"")
          if (p == 0) return ""
          return jstr(s, p + length(key) + 4)
        }
        {
          line = $0
          p = index(line, "\"block\":\"")
          if (p > 0) {
            printf "%s", jstr(line, p + 9)
            next
          }
          print line
        }
      '
fi
exit 0
