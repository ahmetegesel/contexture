#!/bin/sh
# summary: the live board: unclosed journal entries with complete bodies, then the open tasks and the open threads
# usage: ctx session board <slug>
# help: one form: the slug names the unit whose board the storage driver returns (session.board); each tail is silent when empty; missing journal is fatal rc=1 with zero stdout; missing backlog warns on stderr and prints no tail
# help: exit codes: 0 live board printed; 1 missing journal or invalid unit slug
# help: example: ctx session board my-unit

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx session board <session-slug>\n' >&2
  printf 'help: ctx session help\n' >&2
  exit 1
}

case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac
[ $# -eq 1 ] || usage
vb_slug_ok "$1" || usage

vb_call session.board "$1"
if [ "$VB_RC" -ne 0 ]; then
  # an absent journal (or unit) keeps the v0.54.0 message
  if [ "$VB_RC" -eq 1 ] && { vb_err_has "artifact 'journal' not found" || vb_err_has "unit '$1' not found"; }; then
    printf 'ERROR: missing journal: unit %s\n' "$1" >&2
    exit 1
  fi
  vb_through
fi
vb_render board
