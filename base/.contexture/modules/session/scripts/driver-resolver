#!/bin/sh
# driver-resolver: the session module's compatibility wrapper around the storage
# module's resolver. The storage module owns driver resolution and the capability
# handshake; this path stays for the callers that name it (the session and lane verb
# libraries, the docs module, and the suites), so every module resolves the configured
# driver through the storage module.
#
# Standardized exit codes:
#   0: success
#   1: semantic or validation error (ERR_INVALID_ARGUMENT)
#   2: storage or driver error (ERR_DRIVER_NOT_FOUND, ERR_CAPABILITY_UNSUPPORTED, ERR_DRIVER_PROTOCOL)

set -u

WDIR=$(CDPATH="" cd "$(dirname "$0")" && pwd)
WRESOLVER="$WDIR/../../storage/scripts/driver-resolver"
if [ -x "$WRESOLVER" ]; then
  exec "$WRESOLVER" "$@"
fi
if [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/.contexture/modules/storage/scripts/driver-resolver" ]; then
  exec "$CTX_ROOT/.contexture/modules/storage/scripts/driver-resolver" "$@"
fi
if [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/base/.contexture/modules/storage/scripts/driver-resolver" ]; then
  exec "$CTX_ROOT/base/.contexture/modules/storage/scripts/driver-resolver" "$@"
fi
printf 'driver-resolver: ERROR: the storage module resolver is not installed beside the session module (ERR_DRIVER_NOT_FOUND)\n' >&2
exit 2
