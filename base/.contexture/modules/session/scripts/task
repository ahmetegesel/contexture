#!/bin/sh
# summary: task operations (add, update, start, complete, reopen, drop, list, show)
# usage: ctx session task <subcommand> <unit> [args...]
# help: subcommands:
# help:   add <unit> <slug> --objective="..." [--desc="..."] [--criteria="..."] [--details="..."] [--refs="..."]
# help:   update <unit> <slug> [--objective="..."] [--desc="..."] [--criteria="..."] [--details="..."] [--refs="..."]
# help:   start <unit> <slug> [--pointer="..."]
# help:   complete <unit> <slug> --evidence="..."
# help:   reopen <unit> <slug>
# help:   drop <unit> <slug> [--reason="..."]
# help:   list <unit> [--status=todo|progress|done|all] [--json]
# help:   show <unit> <slug> [--json]
# help: --refs takes the references blank or comma separated (brackets optional); an update with --refs replaces the list, --refs="" clears it
# help: the storage driver holds the record rules: a CLOSED unit refuses every write; start moves only a TODO task, complete a TODO or IN_PROGRESS task, reopen an IN_PROGRESS or DONE task; drop refuses an IN_PROGRESS task next_action names; start and the pointer it writes must name every IN_PROGRESS task; complete and drop write their receipt entry (backlog/<slug>: DONE (<evidence>), DROPPED (<reason>)) in the same write
# help: add, start, complete, reopen, and drop fire the task-landing hooks (CTX_ACT add, start, complete, reopen, or drop; CTX_SLUGS the task)
# help: a malformed slug (letters, digits, underscore, dash; starts alphanumeric) refuses rc 1 before any driver call

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

help_table() {
  printf 'usage: ctx session task <subcommand> <unit> [args...]\n'
  printf 'subcommands:\n'
  printf '  add <unit> <slug> --objective="..." [--desc="..."] [--criteria="..."] [--details="..."] [--refs="..."]\n'
  printf '  update <unit> <slug> [--objective="..."] [--desc="..."] [--criteria="..."] [--details="..."] [--refs="..."]\n'
  printf '  start <unit> <slug> [--pointer="..."]\n'
  printf '  complete <unit> <slug> --evidence="..."\n'
  printf '  reopen <unit> <slug>\n'
  printf '  drop <unit> <slug> [--reason="..."]\n'
  printf '  list <unit> [--status=todo|progress|done|all] [--json]\n'
  printf '  show <unit> <slug> [--json]\n'
}

require_slug() {
  if ! vb_slug_ok "$1"; then
    printf "task: error: malformed task slug '%s' (letters, digits, underscore, dash; starts alphanumeric) (ERR_INVALID_ARGUMENT)\n" "$1" >&2
    exit 1
  fi
}

# the status filter vocabulary, one home for every driver: todo, progress, done, all (and
# the canonical spellings) map to TODO, IN_PROGRESS, DONE, and every status
map_status() {
  case "$1" in
    ""|all|ALL) printf 'all' ;;
    todo|TODO) printf 'TODO' ;;
    progress|in_progress|IN_PROGRESS) printf 'IN_PROGRESS' ;;
    done|DONE) printf 'DONE' ;;
    *) return 1 ;;
  esac
}

# landing <act>: the task-landing hooks of a task write
landing() {
  vb_hook task-landing CTX_UNIT "$unit" CTX_ACT "$1" CTX_SLUGS "$slug" || {
    printf 'ERROR: task-landing point failed (block hook)\n' >&2
    exit 1
  }
}

# the refs list of --refs: every element one reference without a blank, bracket, or comma
refs_payload() {
  set -f
  old_ifs=$IFS
  IFS='
'
  # shellcheck disable=SC2046
  set -- $(vb_refs_split "$1")
  IFS=$old_ifs
  set +f
  vb_list refs "$@"
}

if [ $# -eq 0 ]; then
  printf 'usage: ctx session task <subcommand> <unit> [args...]\n' >&2
  printf 'subcommands: add, update, start, complete, reopen, drop, list, show\n' >&2
  exit 1
fi

case "$1" in
  --help|-h|help) help_table; exit 0 ;;
esac

subcmd="$1"
shift
case "${1:-}" in
  --help|-h) help_table | awk -v s="$subcmd" 'NR == 1 || $1 == s'; exit 0 ;;
esac

unit=""
slug=""
objective=""; has_objective=0
desc=""; has_desc=0
criteria=""; has_criteria=0
details=""; has_details=0
refs=""; has_refs=0
pointer=""; has_pointer=0
evidence=""
reason="task dropped"
status_filter=""
json_out=0

case "$subcmd" in
  add|update)
    [ $# -gt 0 ] || { printf 'task %s: error: missing unit argument\n' "$subcmd" >&2; exit 1; }
    unit="$1"; shift
    vb_unit "task $subcmd" "$unit"
    if [ $# -gt 0 ]; then
      case "$1" in -*) ;; *) slug="$1"; shift ;; esac
    fi
    while [ $# -gt 0 ]; do
      case "$1" in
        --objective=*) objective="${1#--objective=}"; has_objective=1 ;;
        -o) shift; [ $# -gt 0 ] && { objective="$1"; has_objective=1; } ;;
        --desc=*|--description=*) desc="${1#*=}"; has_desc=1 ;;
        -d) shift; [ $# -gt 0 ] && { desc="$1"; has_desc=1; } ;;
        --criteria=*) criteria="${1#--criteria=}"; has_criteria=1 ;;
        -c) shift; [ $# -gt 0 ] && { criteria="$1"; has_criteria=1; } ;;
        --details=*) details="${1#--details=}"; has_details=1 ;;
        --refs=*) refs="${1#--refs=}"; has_refs=1 ;;
        -r) shift; [ $# -gt 0 ] && { refs="$1"; has_refs=1; } ;;
        --json) json_out=1 ;;
        *) vb_unknown "task $subcmd" "$1" ;;
      esac
      shift
    done
    if [ -z "$slug" ]; then
      printf 'task %s: error: missing task slug\n' "$subcmd" >&2
      exit 1
    fi
    require_slug "$slug"
    if [ "$subcmd" = add ] && [ -z "$objective" ]; then
      printf 'task add: error: missing required --objective parameter\n' >&2
      exit 1
    fi
    vb_refuse_cr "$objective" "$desc" "$criteria" "$details" "$refs"
    vb_refuse_nl --objective "$objective" --refs "$refs"
    if [ "$subcmd" = add ]; then
      vb_kv objective "$objective"
      [ -n "$desc" ] && vb_kv desc "$desc"
      [ -n "$criteria" ] && vb_kv criteria "$criteria"
      [ -n "$details" ] && vb_kv details "$details"
      refs_payload "$refs"
      vb_call task.add "$unit" "$slug"
      vb_ok
      if [ "$json_out" -eq 1 ]; then vb_json; else printf 'task added: %s (TODO)\n' "$slug"; fi
      landing add
    else
      [ "$has_objective" -eq 1 ] && [ -n "$objective" ] && vb_kv objective "$objective"
      [ -n "$desc" ] && vb_kv desc "$desc"
      [ -n "$criteria" ] && vb_kv criteria "$criteria"
      [ -n "$details" ] && vb_kv details "$details"
      [ "$has_refs" -eq 1 ] && refs_payload "$refs"
      vb_call task.update "$unit" "$slug"
      vb_ok
      if [ "$json_out" -eq 1 ]; then vb_json; else printf 'task updated: %s\n' "$slug"; fi
    fi
    exit 0
    ;;

  start|complete|reopen|drop|show)
    [ $# -gt 0 ] || { printf 'task %s: error: missing unit argument\n' "$subcmd" >&2; exit 1; }
    unit="$1"; shift
    vb_unit "task $subcmd" "$unit"
    [ $# -gt 0 ] || { printf 'task %s: error: missing task slug\n' "$subcmd" >&2; exit 1; }
    slug="$1"; shift
    npos=0
    while [ $# -gt 0 ]; do
      case "$subcmd:$1" in
        start:--pointer=*) pointer="${1#--pointer=}"; has_pointer=1 ;;
        start:-p) shift; [ $# -gt 0 ] && { pointer="$1"; has_pointer=1; } ;;
        complete:--evidence=*) evidence="${1#--evidence=}" ;;
        complete:-e) shift; [ $# -gt 0 ] && evidence="$1" ;;
        drop:--reason=*) reason="${1#--reason=}" ;;
        drop:-r) shift; [ $# -gt 0 ] && reason="$1" ;;
        *:--json) json_out=1 ;;
        *:-*) vb_unknown "task $subcmd" "$1" ;;
        start:*|complete:*|drop:*)
          # one positional value stands for the flag (the v0.54.0 form); a second refuses
          npos=$((npos + 1))
          [ "$npos" -eq 1 ] || vb_unknown "task $subcmd" "$1"
          case "$subcmd" in
            start) [ "$has_pointer" -eq 1 ] || { pointer="$1"; has_pointer=1; } ;;
            complete) [ -n "$evidence" ] || evidence="$1" ;;
            drop) [ -n "$1" ] && reason="$1" ;;
          esac
          ;;
        *) vb_unknown "task $subcmd" "$1" ;;
      esac
      shift
    done
    require_slug "$slug"
    case "$subcmd" in
      start)
        vb_refuse_cr "$pointer"
        vb_refuse_nl --pointer "$pointer"
        [ "$has_pointer" -eq 1 ] && [ -n "$pointer" ] && vb_kv pointer "$pointer"
        vb_call task.start "$unit" "$slug"
        vb_ok
        if [ "$json_out" -eq 1 ]; then vb_json; else printf 'task started: %s (IN_PROGRESS)\n' "$slug"; fi
        landing start
        ;;
      complete)
        if [ -z "$evidence" ]; then
          printf 'task complete: error: missing required --evidence parameter\n' >&2
          exit 1
        fi
        vb_refuse_cr "$evidence"
        vb_refuse_nl --evidence "$evidence"
        vb_kv evidence "$evidence"
        vb_kv date "$(vb_today)"
        vb_call task.complete "$unit" "$slug"
        vb_ok
        if [ "$json_out" -eq 1 ]; then vb_json; else printf 'task completed: %s (DONE)\n' "$slug"; fi
        landing complete
        ;;
      reopen)
        vb_call task.reopen "$unit" "$slug"
        vb_ok
        if [ "$json_out" -eq 1 ]; then vb_json; else printf 'task reopened: %s (TODO)\n' "$slug"; fi
        landing reopen
        ;;
      drop)
        vb_refuse_cr "$reason"
        vb_refuse_nl --reason "$reason"
        vb_kv reason "$reason"
        vb_kv date "$(vb_today)"
        vb_call task.drop "$unit" "$slug"
        vb_ok
        if [ "$json_out" -eq 1 ]; then vb_json; else printf 'task dropped: %s\n' "$slug"; fi
        landing drop
        ;;
      show)
        vb_call task.get "$unit" "$slug"
        vb_ok
        if [ "$json_out" -eq 1 ]; then vb_json; else vb_render task_show; fi
        ;;
    esac
    exit 0
    ;;

  list)
    [ $# -gt 0 ] || { printf 'task list: error: missing unit argument\n' >&2; exit 1; }
    unit="$1"; shift
    vb_unit "task $subcmd" "$unit"
    while [ $# -gt 0 ]; do
      case "$1" in
        --status=*) status_filter="${1#--status=}" ;;
        -s) shift; [ $# -gt 0 ] && status_filter="$1" ;;
        --json) json_out=1 ;;
        *) vb_unknown "task list" "$1" ;;
      esac
      shift
    done
    if ! canon=$(map_status "$status_filter"); then
      printf "task list: error: unknown status '%s' (todo, progress, done, all) (ERR_INVALID_ARGUMENT)\n" "$status_filter" >&2
      exit 1
    fi
    vb_call task.list "$unit" "$canon"
    vb_ok
    if [ "$json_out" -eq 1 ]; then vb_json; else vb_render task_list; fi
    exit 0
    ;;

  *)
    printf "task: error: unknown subcommand '%s' (add, update, start, complete, reopen, drop, list, show) (ERR_INVALID_ARGUMENT)\n" "$subcmd" >&2
    exit 1
    ;;
esac
