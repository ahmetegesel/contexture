#!/bin/sh
# summary: stamp the new period: bump the session anchor and append its anchor line
# usage: ctx session stamp <slug>
# help: the storage driver moves current_anchor from A<N> to A<N+1> and appends the anchor line with its number and today's date, @anchor A<N+1> <date>, in one atomic write (session.stamp); prints the transition; the anchor carries no receipt text: a text argument refuses rc=1 (ERR_INVALID_ARGUMENT) naming the form ctx session stamp <unit>
# help: exit codes: 0 anchor bumped and transition printed; 1 a text argument, a missing or CLOSED unit; 2 a malformed stored anchor
# help: example: ctx session stamp my-unit

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx session stamp <session-slug>\n' >&2
  printf 'help: ctx session help\n' >&2
  exit 1
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac
[ $# -ge 1 ] || usage
slug=$1
vb_slug_ok "$slug" || usage
# the anchor is period ordering alone (end review item 7): no receipt text reaches it
if [ $# -gt 1 ]; then
  printf "stamp: error: stamp takes the unit alone (ctx session stamp <unit>): the anchor carries its number and date, no receipt text; unexpected argument '%s' (ERR_INVALID_ARGUMENT)\n" "$2" >&2
  exit 1
fi

vb_kv date "$(vb_today)"
vb_call session.stamp "$slug"
if [ "$VB_RC" -eq 1 ] && vb_err_has "unit '$slug' not found"; then
  fail "ERROR: missing state: unit $slug"
fi
vb_ok
cur=$(vb_field current_anchor)
prev=$(vb_field previous_anchor)
vb_hook stamp CTX_UNIT "$slug" CTX_ANCHOR "$cur" || fail "ERROR: stamp point failed (block hook)"
printf 'transition: %s -> %s\n' "$prev" "$cur"
