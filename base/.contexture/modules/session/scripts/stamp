#!/bin/sh
# summary: bump the session anchor and append the load receipt
# usage: ctx session stamp <slug> "<attention>"
# help: the storage driver moves current_anchor from A<N> to A<N+1> and appends the anchor receipt in one atomic write (session.stamp); prints the transition; an empty, whitespace-only, or newline-carrying attention refuses rc=1 before any write; a CLOSED unit refuses rc=1 and a malformed stored anchor rc=2
# help: exit codes: 0 anchor bumped and transition printed; 1 empty attention, a missing or CLOSED unit; 2 a malformed stored anchor
# help: example: ctx session stamp my-unit "loaded state, backlog, knowledge, journal; git clean"

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx session stamp <session-slug> "<attention>"\n' >&2
  printf 'help: ctx session help\n' >&2
  exit 1
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac
[ $# -eq 2 ] || usage
slug=$1
attention=$2
vb_slug_ok "$slug" || usage
[ -n "$attention" ] || fail "ERROR: empty attention"
vb_has_nl "$attention" && fail "ERROR: embedded newline in attention"
vb_has_cr "$attention" && fail "ERROR: embedded carriage return in attention (the dialect is LF)"
case "$attention" in
  *[!"$VB_CR"' 	']*) ;;
  *) fail "ERROR: whitespace-only attention" ;;
esac

vb_kv attention "$attention"
vb_call session.stamp "$slug"
if [ "$VB_RC" -eq 1 ] && vb_err_has "unit '$slug' not found"; then
  fail "ERROR: missing state: unit $slug"
fi
vb_ok
cur=$(vb_field current_anchor)
prev=$(vb_field previous_anchor)
vb_hook stamp CTX_UNIT "$slug" CTX_ANCHOR "$cur" || fail "ERROR: stamp point failed (block hook)"
printf 'transition: %s -> %s\n' "$prev" "$cur"
