#!/usr/bin/awk -f
# summary: create the unit folder, state at A0 folded to A1, the three artifacts; prints the state and "next: declare the first task"
# usage: ctx session bootstrap <slug> "<objective>" [<repos>]
# help: validates every argument before any filesystem write; refusals rc=1 with zero partial writes (existing slug, malformed slug, empty objective, embedded newline or carriage return, extra arguments)
# help: objective must be in double quotes without embedded quotes; optional repos is a comma-separated list of repository names
# help: exit codes: 0 unit created at A1; 1 unit exists, missing arguments, or malformed input
# help: example: ctx session bootstrap my-feature "Implement feature X"
# The state grammar cannot carry brackets or quotes in repos, or quotes in
# the objective: those values are refused naming the character.

function usage() {
  print "Usage: ctx session bootstrap <slug> \"<objective>\" [<repos>]" > "/dev/stderr"
  print "help: ctx session help" > "/dev/stderr"
  exit 1
}

function fail(msg) {
  print msg > "/dev/stderr"
  exit 1
}

function gitstate(   tag, cmd, line, rc, first) {
  tag = "session-bootstrap-git-rc"
  cmd = "git -C . status -sb 2>/dev/null; echo \"" tag "=$?\""
  rc = ""
  first = ""
  while ((cmd | getline line) > 0) {
    if (line ~ ("^" tag "=[0-9]+$")) {
      rc = substr(line, length(tag) + 2)
      continue
    }
    if (first == "") first = line
  }
  close(cmd)
  if (rc != "0" || first == "") return "none"
  sub(/^##[ \t]*/, "", first)
  if (first == "") return "none"
  return first
}

# The record IO: every session artifact is read and written through the configured
# storage driver (artifact.read, artifact.write, artifact.list, session.list) by artifact
# key (state, backlog, knowledge, journal, lane/<lane>/<recipe|journal|report>); a fetched
# artifact lands in a scratch file under .contexture/tmp, removed at exit. disp() names an
# artifact in a message the way the record grammar reads it; it builds a display string,
# never a path any code opens.
function disp(u, key,   l) {
  if (key ~ /^lane\//) {
    l = key
    sub(/^lane\//, "", l)
    return ".contexture/sessions/" u "/lanes/" l ".md"
  }
  return ".contexture/sessions/" u "/" key ".md"
}

function rec_q(s) {
  gsub(/'/, "'\\''", s)
  return "'" s "'"
}

function rec_resolver(   md) {
  if (REC_RESOLVER != "") return REC_RESOLVER
  md = (("CTX_MODULE_DIR" in ENVIRON) && ENVIRON["CTX_MODULE_DIR"] != "") ? ENVIRON["CTX_MODULE_DIR"] : ".contexture/modules/session"
  REC_RESOLVER = md "/scripts/driver-resolver"
  return REC_RESOLVER
}

function rec_scratch(   cmd, d) {
  if (REC_DIR != "") return REC_DIR
  system("mkdir -p .contexture/tmp")
  cmd = "mktemp -d .contexture/tmp/rec.XXXXXX 2>/dev/null"
  d = ""
  if ((cmd | getline d) <= 0) d = ""
  close(cmd)
  if (d == "") {
    print "ERROR: cannot create a scratch folder under .contexture/tmp" > "/dev/stderr"
    exit 2
  }
  REC_DIR = d
  return d
}

# rec_call(args, out): one driver call, stdout to the out file; rc 0 ok, 1 absent or
# refused; a storage failure (rc 2) is fatal and its diagnostic passes through
function rec_call(args, out,   e, rc, line) {
  e = out ".err"
  rc = system(rec_q(rec_resolver()) " " args " > " rec_q(out) " 2> " rec_q(e))
  if (rc == 0 || rc == 1) return rc
  while ((getline line < e) > 0) print line > "/dev/stderr"
  close(e)
  print "ERROR: the storage driver failed (rc=" rc "): " args > "/dev/stderr"
  exit 2
}

# rec_fetch(u, key): the artifact's scratch copy, "" when the driver reports it absent
function rec_fetch(u, key,   f, k) {
  k = u SUBSEP key
  if (k in REC_CACHE) return REC_CACHE[k]
  REC_N++
  f = rec_scratch() "/a" REC_N
  if (rec_call("artifact.read " rec_q(u) " " rec_q(key), f) == 0) {
    REC_CACHE[k] = f
    return f
  }
  REC_CACHE[k] = ""
  return ""
}

function rec_exists(u, key) {
  return (rec_fetch(u, key) != "")
}

# rec_put(u, key, file): the file becomes the artifact, atomically, through the driver
function rec_put(u, key, file,   rc) {
  close(file)
  rc = system(rec_q(rec_resolver()) " artifact.write " rec_q(u) " " rec_q(key) " < " rec_q(file))
  if (rc != 0) {
    print "ERROR: the storage driver refused writing " key " of " u " (rc=" rc ")" > "/dev/stderr"
    exit (rc == 1) ? 1 : 2
  }
  REC_CACHE[u SUBSEP key] = file
}

# rec_new(): a fresh scratch file name for a write
function rec_new() {
  REC_N++
  return rec_scratch() "/w" REC_N
}

# rec_units(U): every unit the store holds, in its listing order (bytewise by name);
# returns the count, 0 when the store holds none
function rec_units(U,   f, line, n, rest, p, u) {
  REC_N++
  f = rec_scratch() "/l" REC_N
  if (rec_call("session.list", f) != 0) return 0
  n = 0
  while ((getline line < f) > 0) {
    rest = line
    while ((p = index(rest, "\"unit\":\"")) > 0) {
      rest = substr(rest, p + 8)
      u = substr(rest, 1, index(rest, "\"") - 1)
      n++
      U[n] = u
    }
  }
  close(f)
  return n
}

# rec_list(u, K): the artifact keys the unit holds (artifact.list), count returned
function rec_list(u, K,   f, line, n) {
  REC_N++
  f = rec_scratch() "/k" REC_N
  if (rec_call("artifact.list " rec_q(u), f) != 0) return 0
  n = 0
  while ((getline line < f) > 0) {
    if (line == "") continue
    n++
    K[n] = line
  }
  close(f)
  return n
}

function rec_cleanup() {
  if (REC_DIR != "") system("rm -rf " rec_q(REC_DIR))
  REC_DIR = ""
}

function write_state(anchor,   tmp) {
  tmp = rec_new()
  print "status: ACTIVE" > tmp
  print "current_anchor: " anchor > tmp
  print "next_action: \"backlog the first task\"" > tmp
  print "objective: \"" objective "\"" > tmp
  print "repos: [" repos "]" > tmp
  close(tmp)
  rec_put(slug, "state", tmp)
  return tmp
}

function touch(key,   tmp) {
  tmp = rec_new()
  printf "" > tmp
  close(tmp)
  rec_put(slug, key, tmp)
}

BEGIN {
  if (ARGC < 3 || ARGC > 4) usage()
  slug = ARGV[1]
  if (slug !~ /^[A-Za-z0-9][A-Za-z0-9_-]*$/) usage()
  objective = ARGV[2]
  if (objective == "") fail("ERROR: empty objective")
  if (index(objective, "\n") > 0) fail("ERROR: embedded newline in objective")
  if (index(objective, "\r") > 0) fail("ERROR: embedded carriage return in objective (the dialect is LF)")
  if (objective ~ /^[ \t\r]+$/) fail("ERROR: whitespace-only objective")
  if (objective ~ /["']/) fail("ERROR: quote in objective: " substr(objective, match(objective, /["']/), 1))
  repos = ""
  if (ARGC == 4) {
    repos = ARGV[3]
    if (index(repos, "\n") > 0) fail("ERROR: embedded newline in repos")
    if (index(repos, "\r") > 0) fail("ERROR: embedded carriage return in repos (the dialect is LF)")
    if (repos ~ /^[ \t\r]+$/) repos = ""
    if (repos ~ /[][]/) fail("ERROR: bracket in repos: " substr(repos, match(repos, /[][]/), 1))
    if (repos ~ /["']/) fail("ERROR: quote in repos: " substr(repos, match(repos, /["']/), 1))
  }

  # the unit's storage: session.create refuses a unit the store already holds
  REC_N++
  created = rec_scratch() "/c" REC_N
  if (rec_call("session.create " rec_q(slug), created) != 0) fail("ERROR: session exists: .contexture/sessions/" slug)

  write_state("A0")

  touch("backlog")
  touch("knowledge")
  touch("journal")

  attention = "fresh unit; objective: " objective "; git: " gitstate()
  journal = rec_new()
  print "@anchor A1 (\"continues A0\", attention: " attention ")" > journal
  close(journal)
  rec_put(slug, "journal", journal)

  state = write_state("A1")

  while ((getline line < state) > 0) print line
  close(state)
  print "next: declare the first task"
  exit 0
}

END {
  rec_cleanup()
}
