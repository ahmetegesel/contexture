#!/bin/sh
# summary: create the unit: state at A1 with its first anchor, an empty backlog and knowledge; prints the state and "next: declare the first task"
# usage: ctx session bootstrap <slug> "<objective>" [<repos>]
# help: validates every argument before any write; refusals rc=1 with zero partial writes (existing slug, malformed slug, empty objective, embedded newline or carriage return, extra arguments)
# help: the objective is one line (an embedded double or single quote is text); optional repos is a comma-separated list of repository names
# help: the storage driver creates the unit whole (session.create) with the A1 attention base composes (fresh unit; objective: <objective>; git: <the branch line of git status>)
# help: exit codes: 0 unit created at A1; 1 unit exists, missing arguments, or malformed input
# help: example: ctx session bootstrap my-feature "Implement feature X"

. "$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)/verb.sh"

usage() {
  printf 'Usage: ctx session bootstrap <slug> "<objective>" [<repos>]\n' >&2
  printf 'help: ctx session help\n' >&2
  exit 1
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

# the branch line of git status, "none" outside a repository
gitstate() {
  gs=$(git -C . status -sb 2>/dev/null) || { printf 'none\n'; return 0; }
  gs=$(printf '%s\n' "$gs" | sed -n '1p')
  gs=${gs#\#\#}
  gs=$(printf '%s' "$gs" | sed 's/^[ 	]*//')
  [ -n "$gs" ] || gs=none
  printf '%s\n' "$gs"
}

case "${1:-}" in
  --help|-h) [ $# -eq 1 ] && { vb_verb_help session "$0"; exit 0; } ;;
esac
[ $# -ge 2 ] && [ $# -le 3 ] || usage
slug=$1
objective=$2
vb_slug_ok "$slug" || usage
[ -n "$objective" ] || fail "ERROR: empty objective"
vb_has_nl "$objective" && fail "ERROR: embedded newline in objective"
vb_has_cr "$objective" && fail "ERROR: embedded carriage return in objective (the dialect is LF)"
case "$objective" in
  *[!"$VB_CR"' 	']*) ;;
  *) fail "ERROR: whitespace-only objective" ;;
esac
repos=""
if [ $# -eq 3 ]; then
  repos=$3
  vb_has_nl "$repos" && fail "ERROR: embedded newline in repos"
  vb_has_cr "$repos" && fail "ERROR: embedded carriage return in repos (the dialect is LF)"
  case "$repos" in *[!' 	']*) ;; *) repos="" ;; esac
  c=$(printf '%s\n' "$repos" | awk '{ if (match($0, /[][]/)) print substr($0, RSTART, 1) }')
  [ -n "$c" ] && fail "ERROR: bracket in repos: $c"
  c=$(printf '%s\n' "$repos" | awk '{ if (match($0, /["\047]/)) print substr($0, RSTART, 1) }')
  [ -n "$c" ] && fail "ERROR: quote in repos: $c"
fi

# the repos list: comma separated, each name trimmed, an empty name dropped
set --
if [ -n "$repos" ]; then
  old_ifs=$IFS
  set -f
  IFS=','
  for r in $repos; do
    r=$(printf '%s' "$r" | sed 's/^[ 	]*//; s/[ 	]*$//')
    [ -n "$r" ] && set -- "$@" "$r"
  done
  IFS=$old_ifs
  set +f
fi

vb_kv objective "$objective"
vb_list repos "$@"
vb_kv attention "fresh unit; objective: $objective; git: $(gitstate)"
vb_call session.create "$slug"
if [ "$VB_RC" -eq 1 ] && vb_err_has "ERR_ENTITY_EXISTS"; then
  fail "ERROR: session exists: unit $slug"
fi
vb_ok
RV_PATH=state vb_render state RV_PATH=state
printf 'next: declare the first task\n'
