#!/bin/sh
# summary: view or update subagent lane report artifact
# usage: ctx lane report <unit> <lane-slug> [--body="..." | stdin] [--json]
# help: reads or writes the subagent lane report.md
# help: options:
# help:   --body="..."         report content to write
# help:   --json               output JSON format
# help: stdin fallback: pipe report markdown on stdin to write (any size; the body reaches the driver on stdin)
# help: a write into a CLOSED unit refuses rc 1
# help: scripted reads: ctx lane show <unit> <lane-slug> report never reads stdin; with no --body, report reads stdin whenever stdin is not a terminal, so under an open pipe it waits for the writer to close

set -u

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
resolver="$dir/../../session/scripts/driver-resolver"
if [ ! -x "$resolver" ]; then
  if [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/.contexture/modules/session/scripts/driver-resolver"
  elif [ -n "${CTX_ROOT:-}" ] && [ -x "$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver" ]; then
    resolver="$CTX_ROOT/base/.contexture/modules/session/scripts/driver-resolver"
  fi
fi

# The driver transport (docs/the-engine.md): argv carries the method and its bounded
# identifiers; every free-text field travels on stdin as payload lines key=value, the
# value escaped (backslash, newline, tab, carriage return as \\, \n, \t, \r); pline
# writes one line, exact (a trailing newline survives).
pline() {
  printf '%s=' "$1"
  printf '%sx' "$2" | awk '
    BEGIN { ORS = "" }
    { gsub(/\\/, "\\\\"); gsub(/\t/, "\\t"); gsub(/\r/, "\\r"); out = out (NR > 1 ? "\\n" : "") $0 }
    END { sub(/x$/, "", out); print out "\n" }'
}

# a closed unit takes no writes: the refusal is the verb's, before any driver write
refuse_closed() {
  if "$resolver" artifact.read "$1" state 2>/dev/null | awk '/^status:[ \t]*CLOSED[ \t\r]*$/ { c = 1 } END { exit !c }'; then
    printf 'ERROR: unit is CLOSED: %s (a closed unit takes no writes)\n' "$1" >&2
    exit 1
  fi
}

if [ $# -lt 2 ]; then
  if [ $# -gt 0 ]; then
    case "$1" in
      --help|-h|help)
        printf 'usage: ctx lane report <unit> <lane-slug> [--body="..." | stdin] [--json]\n'
        printf 'reads or writes the subagent lane report.md\n'
        printf 'scripted reads: ctx lane show <unit> <lane-slug> report (never reads stdin); report with no --body reads stdin whenever stdin is not a terminal\n'
        exit 0
        ;;
    esac
  fi
  printf 'usage: ctx lane report <unit> <lane-slug> [--body="..." | stdin] [--json]\n' >&2
  exit 1
fi

unit="$1"
shift
lane="$1"
shift

body=""
json_out=0

while [ $# -gt 0 ]; do
  case "$1" in
    --body=*) body="${1#--body=}" ;;
    -b) shift; [ $# -gt 0 ] && body="$1" ;;
    --json) json_out=1 ;;
  esac
  shift
done

if [ -z "$body" ] && [ ! -t 0 ]; then
  body=$(cat)
fi

# the report travels raw on the driver's stdin (any size; argv carries only identifiers)
if [ -n "$body" ]; then
  refuse_closed "$unit"
  out=$(printf '%s\n' "$body" | "$resolver" lane.report "$unit" "$lane" --write)
else
  out=$("$resolver" lane.report "$unit" "$lane")
fi
rc=$?
if [ "$rc" -ne 0 ]; then
  exit "$rc"
fi

if [ "$json_out" -eq 1 ]; then
  printf '%s\n' "$out"
else
  printf '%s\n' "$out" | awk -v key='report' '
    # decode the JSON string value of key in linear passes: escaped backslashes and
    # quotes are parked on control bytes first, so the first raw quote left is the
    # closing one; then every escape the drivers emit is restored
    {
      p = index($0, "\"" key "\":\"")
      if (p == 0) { print; next }
      v = substr($0, p + length(key) + 4)
      gsub(/\\\\/, "\001", v)
      gsub(/\\"/, "\002", v)
      q = index(v, "\"")
      if (q > 0) v = substr(v, 1, q - 1)
      gsub(/\\n/, "\n", v)
      gsub(/\\t/, "\t", v)
      gsub(/\\r/, "\r", v)
      gsub(/\002/, "\"", v)
      gsub(/\001/, "\\", v)
      printf "%s\n", v
    }
  '
fi
exit 0
