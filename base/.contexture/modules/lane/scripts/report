#!/bin/sh
# summary: view or update subagent lane report artifact
# usage: ctx lane report <unit> <lane-slug> [--body="..." | stdin] [--json]
# help: reads or writes the subagent lane report (lane.get report, lane.write_report)
# help: options:
# help:   --body="..."         report content to write
# help:   --json               output JSON format
# help: stdin fallback: pipe report markdown on stdin to write (any size; the body reaches the driver on stdin, normalized to end with one newline)
# help: a write prints one line with the stored size; a write into a CLOSED unit refuses rc 1
# help: scripted reads: ctx lane show <unit> <lane-slug> report never reads stdin; with no --body, report reads stdin whenever stdin is not a terminal, so under an open pipe it waits for the writer to close

. "$(CDPATH= cd -- "$(dirname -- "$0")/../../session/lib" && pwd)/verb.sh"

if [ $# -lt 2 ]; then
  if [ $# -gt 0 ]; then
    case "$1" in
      --help|-h|help)
        printf 'usage: ctx lane report <unit> <lane-slug> [--body="..." | stdin] [--json]\n'
        printf 'reads or writes the subagent lane report\n'
        printf 'scripted reads: ctx lane show <unit> <lane-slug> report (never reads stdin); report with no --body reads stdin whenever stdin is not a terminal\n'
        exit 0
        ;;
    esac
  fi
  printf 'usage: ctx lane report <unit> <lane-slug> [--body="..." | stdin] [--json]\n' >&2
  exit 1
fi

unit="$1"
vb_unit "lane report" "$unit"
shift
lane="$1"
vb_lane "lane report" "$lane"
shift

body=""
json_out=0

while [ $# -gt 0 ]; do
  case "$1" in
    --body=*) body="${1#--body=}" ;;
    -b) shift; [ $# -gt 0 ] && body="$1" ;;
    --json) json_out=1 ;;
    *) vb_unknown "lane report" "$1" ;;
  esac
  shift
done

vb_tmp
if [ -z "$body" ] && [ ! -t 0 ]; then
  body=$(cat)
fi

# the report travels raw on the driver's stdin (any size; argv carries only identifiers),
# ending with exactly one newline (B13)
if [ -n "$body" ]; then
  printf '%s\n' "$body" > "$VB_DIR/doc"
  vb_call_doc "$VB_DIR/doc" lane.write_report "$unit" "$lane"
  vb_ok
  if [ "$json_out" -eq 1 ]; then vb_json; else printf 'lane report written: %s in %s (%s bytes)\n' "$lane" "$unit" "$(vb_field bytes)"; fi
  exit 0
fi
vb_call lane.get "$unit" "$lane" report
vb_ok
if [ "$json_out" -eq 1 ]; then vb_json; else vb_render lane_doc; fi
exit 0
