#!/bin/sh
# summary: record subagent lane journal events isolated from main session journal
# usage: ctx lane record <unit> <lane-slug> --what="..." [--slug=...] [--thread=...] [--ref=...]...
# help: appends an append-only event to the subagent lane journal (lane.record); the storage driver composes the slug from the local date and time, a second event in the same second taking a suffix
# help: options:
# help:   --what="..."         event description (required)
# help:   --slug=...           override entry slug (default auto-generated with date)
# help:   --thread=...         what the lane awaits (default: none)
# help:   --ref="..."          grounding reference; repeatable, one REF line each
# help: a CLOSED unit refuses rc 1; a slug the lane journal already carries refuses rc 1 (ERR_ENTITY_EXISTS); an absent lane refuses rc 1 (create it with ctx lane create)

. "$(CDPATH= cd -- "$(dirname -- "$0")/../../session/lib" && pwd)/verb.sh"

if [ $# -lt 2 ]; then
  if [ $# -gt 0 ]; then
    case "$1" in
      --help|-h|help)
        printf 'usage: ctx lane record <unit> <lane-slug> --what="..." [--slug=...] [--thread=...] [--ref=...]\n'
        printf 'appends an append-only event to the subagent lane journal\n'
        exit 0
        ;;
    esac
  fi
  printf 'usage: ctx lane record <unit> <lane-slug> --what="..." [--slug=...] [--thread=...] [--ref=...]\n' >&2
  exit 1
fi

unit="$1"
vb_unit "lane record" "$unit"
shift
lane="$1"
vb_lane "lane record" "$lane"
shift

what=""
slug=""
thread="none"
json_out=0
nref=0
npos=0

while [ $# -gt 0 ]; do
  case "$1" in
    --what=*) what="${1#--what=}" ;;
    -w) shift; [ $# -gt 0 ] && what="$1" ;;
    --slug=*) slug="${1#--slug=}" ;;
    -s) shift; [ $# -gt 0 ] && slug="$1" ;;
    --thread=*) thread="${1#--thread=}" ;;
    -t) shift; [ $# -gt 0 ] && thread="$1" ;;
    --ref=*) nref=$((nref + 1)); eval "REF_$nref=\${1#--ref=}" ;;
    -r) shift; [ $# -gt 0 ] && { nref=$((nref + 1)); eval "REF_$nref=\$1"; } ;;
    --json) json_out=1 ;;
    -*) vb_unknown "lane record" "$1" ;;
    *)
      # one positional value stands for --what (the v0.54.0 form); a second refuses
      npos=$((npos + 1))
      [ "$npos" -eq 1 ] || vb_unknown "lane record" "$1"
      [ -z "$what" ] && what="$1"
      ;;
  esac
  shift
done

if [ -z "$what" ]; then
  printf 'lane record: error: missing required --what parameter\n' >&2
  exit 1
fi

vb_refuse_cr "$what" "$thread" "$slug"
vb_refuse_nl --what "$what" --thread "$thread" --slug "$slug"
set --
i=0
while [ "$i" -lt "$nref" ]; do
  i=$((i + 1))
  eval "r=\$REF_$i"
  vb_refuse_cr "$r"
  vb_refuse_nl --ref "$r"
  vb_ref_ok "lane record" "$r"
  set -- "$@" "$r"
done
if [ -n "$slug" ] && ! vb_slug_ok "$slug"; then
  printf "lane record: error: malformed entry slug '%s' (ERR_INVALID_ARGUMENT)\n" "$slug" >&2
  exit 1
fi

vb_kv what "$what"
vb_kv thread "$thread"
vb_list refs "$@"
[ -n "$slug" ] && vb_kv slug "$slug"
vb_kv date "$(vb_today)"
vb_kv epoch "$(vb_epoch)"
vb_call lane.record "$unit" "$lane"
vb_ok

if [ "$json_out" -eq 1 ]; then
  vb_json
else
  printf 'lane entry recorded: %s in %s/%s\n' "$(vb_field entry.slug)" "$unit" "$lane"
fi
exit 0
