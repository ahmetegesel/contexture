#!/bin/sh
# summary: display subagent lane artifacts (recipe, journal, report)
# usage: ctx lane show <unit> <lane-slug> [recipe|journal|report] [--json]
# help: displays specified artifact from subagent lane container (defaults to report); the storage driver answers the document or the journal (lane.get) and the text view prints it as stored, its trailing newlines collapsed to one
# help: arguments:
# help:   <unit>        session unit slug
# help:   <lane-slug>   subagent lane slug
# help:   [artifact]    artifact name: report (default), recipe, or journal
# help:   --json        output JSON format

. "$(CDPATH= cd -- "$(dirname -- "$0")/../../session/lib" && pwd)/verb.sh"

if [ $# -lt 2 ]; then
  if [ $# -gt 0 ]; then
    case "$1" in
      --help|-h|help)
        printf 'usage: ctx lane show <unit> <lane-slug> [recipe|journal|report] [--json]\n'
        printf 'displays specified artifact from subagent lane container (defaults to report)\n'
        exit 0
        ;;
    esac
  fi
  printf 'usage: ctx lane show <unit> <lane-slug> [recipe|journal|report] [--json]\n' >&2
  exit 1
fi

unit="$1"
vb_unit "lane show" "$unit"
shift
lane="$1"
vb_lane "lane show" "$lane"
shift

artifact="report"
json_out=0

while [ $# -gt 0 ]; do
  case "$1" in
    --json) json_out=1 ;;
    recipe*) artifact=recipe ;;
    journal*) artifact=journal ;;
    report*) artifact=report ;;
    *) vb_unknown "lane show" "$1" ;;
  esac
  shift
done

vb_call lane.get "$unit" "$lane" "$artifact"
vb_ok

if [ "$json_out" -eq 1 ]; then
  vb_json
elif [ "$artifact" = journal ]; then
  vb_render lane_journal
else
  vb_render lane_doc
fi
exit 0
