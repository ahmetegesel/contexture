#!/bin/sh
# package-install: the package overlay installer, the private core script behind
# ctx package install <package>, which execs it with CTX_ROOT set to its own
# workspace. Run it only on the human's go at the act. Usage: package-install
# <package-root>; CTX_ROOT names the workspace (default: the package root's ../..).
#
# The overlay scope: the package's .contexture/extensions tree, and nothing
# else. A package path under .contexture outside extensions refuses as a core
# path; a path outside the extension root refuses; the core is never written.
# The package manifest at the package root (the file "manifest", read through
# the private ctx _package reader) declares the summary, the package version,
# the kind (feature|driver), the parts, and, for a driver package, its driver
# name. The installer refuses a package without a manifest and a manifest whose
# declared parts do not match the payload: every declared part must exist, every
# payload file must sit under a declared part, every module folder with a
# manifest or scripts must be declared as a module part, and a driver path must
# match the declared driver. The installed set is recorded under
# .contexture/extensions/.state/<package>.files: one "file <mode> <cksum>
# <workspace path>" line per installed path, a "law <workspace path>" line per
# installed law fragment, a "module <installed name> <original name>" line per
# installed module, and the package, version, kind, and driver lines.
#
# Install names: a payload module installs under its own name, or under the alias
# CTX_PACKAGE_AS names (space separated <module>=<alias> pairs, which ctx package
# install --as=<module>=<alias> sets); a module the pairs do not name keeps the alias
# the install record's module line holds, so a re-install without the flags keeps
# every alias, and a module whose data this package kept at an uninstall returns under
# the name it was kept under, taking the kept declaration back in its record phase (a
# rollback restores it), so its verbs read the kept keys; an --as naming another name for
# it refuses naming the kept one. The module's files land under modules/<alias>/, its laws and hooks go
# with them, and the module's namespace is the alias, its folder's name, and so is its
# storage root: a root its data file declares applies only under its own name. A name
# collision without an alias refuses naming --as, and so does a storage root another
# installed module resolves to; the installer never picks a name.
#
# Refusals (rc 1): a malformed package, module, or driver name; a missing or
# malformed package manifest; a declared part missing or outside the payload; a
# payload file outside the declared parts; a module folder not declared as a
# module part; a feature package carrying a driver path; a driver path not
# matching the manifest; a path that escapes or carries blanks; a payload file
# outside the extension root; a core path; an existing file no package recorded;
# a path another package recorded; a module name against a builtin (unit,
# run, lane, rhythm, store), a workspace module, or a reserved name; a module name another
# package's kept data holds; a storage root another installed module resolves to, kept data
# holds, or two modules of the package share; a re-install that would leave an installed
# module's data undeclared while it holds a key (an --as moving it, a version dropping it);
# a module returning over this package's kept data without a data file, or under other
# storage roots than the kept declaration's;
# a driver name against the
# core posix driver or a driver that already resolves ahead of the extension
# root; a malformed module manifest; a driver part
# without an executable.
# A re-install of this package's recorded files is an update: changed files
# update, files the new source drops are removed when unchanged and preserved
# (and kept recorded) when changed. Part hooks run after the overlay and the
# record, in module-name order. rc 2: no workspace or engine, a read-only
# extension root (nothing is written), an I/O failure (the install rolls back
# whole: every moved file restored or removed, the record restored, and every
# folder the install made removed, so a failed fresh install leaves the tree as it
# found it and its retry proceeds), a failing part hook, or a failing compose (the
# overlay and its record are in place; the law layer is stale).
#
# A driver package moves the record (docs/the-engine.md, Moving a record between backends).
# Before anything is written: no CTX_STORAGE_ variable, one driver package at a time, the
# readiness probe, the driver settings (CTX_PACKAGE_DRIVER_CONFIG, one <key>=<value> per line,
# checked against the incoming part's config schema), the run folder in the drawer's scratch,
# the move state with crash recovery, and the old copy answer (CTX_PACKAGE_OLD, backup or
# delete, else asked at a terminal or refused). An install while posix is configured then lands
# the overlay and its record (with a format line), runs the behavior test, writes the settings,
# runs the driver's prepare hook, and moves every namespace into the driver under the storage
# moving freeze (preflight, the take, copy, the storage.driver switch, check); any failure or
# signal through the check unwinds it all, rc 2 (or 129, 130, 143); past the check the old
# copy step, the release, and the driver's finish hook only warn when they fail. A reinstall of
# the configured driver at the recorded format is a plain update guarded by a dump compare; at
# another format the record moves out through posix and back in. The shared steps are the
# configuration library's driver run section.
set -u

err() { printf 'package-install: %s\n' "$*" >&2; }
die() { _die_rc=$1; shift; err "$*"; exit "$_die_rc"; }

mode_of() { ls -ld "$1" 2>/dev/null | awk '{print $1}' | cut -c2-10; }
cksum_of() { cksum < "$1" 2>/dev/null | awk '{print $1 ":" $2}'; }

record_has() {
  [ "${have_record:-0}" -eq 1 ] || return 1
  awk -v p="$1" '$1 == "file" && $4 == p { found = 1 } END { exit(found ? 0 : 1) }' "$state_file"
}

record_has_prefix() {
  [ "${have_record:-0}" -eq 1 ] || return 1
  awk -v p="$1" '$1 == "file" && index($4, p) == 1 { found = 1 } END { exit(found ? 0 : 1) }' "$state_file"
}

record_field() {
  [ "${have_record:-0}" -eq 1 ] || return 1
  awk -v p="$1" -v n="$2" '$1 == "file" && $4 == p { print $n; exit }' "$state_file"
}

other_has() {
  [ -d "$state_root" ] || return 1
  for _oh in "$state_root"/*.files; do
    [ -f "$_oh" ] || continue
    [ "$_oh" = "$state_file" ] && continue
    if awk -v p="$1" '$1 == "file" && $4 == p { found = 1 } END { exit(found ? 0 : 1) }' "$_oh"; then
      _ohn=${_oh##*/}
      printf '%s\n' "${_ohn%.files}"
      return 0
    fi
  done
  return 1
}

other_has_prefix() {
  [ -d "$state_root" ] || return 1
  for _op in "$state_root"/*.files; do
    [ -f "$_op" ] || continue
    [ "$_op" = "$state_file" ] && continue
    if awk -v p="$1" '$1 == "file" && index($4, p) == 1 { found = 1 } END { exit(found ? 0 : 1) }' "$_op"; then
      _opn=${_op##*/}
      printf '%s\n' "${_opn%.files}"
      return 0
    fi
  done
  return 1
}

[ $# -eq 1 ] || { err "usage: package-install <package-root>"; exit 1; }
[ -d "$1" ] || die 1 "no package root at $1"
pkg_root=$(CDPATH= cd -- "$1" 2>/dev/null && pwd) || die 2 "cannot resolve $1"
pkg_name=${pkg_root##*/}
case "$pkg_name" in
  ""|.*) die 1 "malformed package name '$pkg_name' (letters, digits, dot, underscore, hyphen; not starting with a dot)" ;;
esac
case "$pkg_name" in
  *[!A-Za-z0-9._-]*) die 1 "malformed package name '$pkg_name' (letters, digits, dot, underscore, hyphen; not starting with a dot)" ;;
esac

if [ -n "${CTX_ROOT:-}" ]; then
  [ -d "$CTX_ROOT" ] || die 2 "CTX_ROOT names no directory: $CTX_ROOT"
  ws_root=$(CDPATH= cd -- "$CTX_ROOT" 2>/dev/null && pwd) || die 2 "cannot resolve CTX_ROOT"
else
  case "$pkg_root" in
    */.contexture/plugins/*)
      ws_root=$(CDPATH= cd -- "${pkg_root%/.contexture/plugins/*}" 2>/dev/null && pwd) || die 2 "cannot locate the workspace root (run .contexture/ctx package install <package> or set CTX_ROOT)"
      ;;
    *)
      ws_root=$(CDPATH= cd -- "$pkg_root/../.." 2>/dev/null && pwd) || die 2 "cannot locate the workspace root (run .contexture/ctx package install <package> or set CTX_ROOT)"
      ;;
  esac
fi
ctx_bin=$ws_root/.contexture/ctx
[ -x "$ctx_bin" ] || die 2 "no engine at $ctx_bin (adopt the base first)"
ext_root=$ws_root/.contexture/extensions
state_root=$ext_root/.state
state_file=$state_root/$pkg_name.files
stash_uninstall=$state_root/$pkg_name.uninstall

if [ -e "$pkg_root/.contexture" ] && [ ! -d "$pkg_root/.contexture" ]; then
  die 1 "malformed package: .contexture is not a directory"
fi
if [ -d "$pkg_root/.contexture" ]; then
  for _e in "$pkg_root/.contexture"/* "$pkg_root/.contexture"/.[!.]* "$pkg_root/.contexture"/..?*; do
    [ -e "$_e" ] || continue
    _b=${_e##*/}
    [ "$_b" = extensions ] && continue
    case "$_b" in
      ctx|storage|modules|rhythms|sessions|units|laws|tmp|ONBOARDING.md)
        die 1 "core path refused: .contexture/$_b (a package overlays .contexture/extensions/ only)" ;;
      *)
        die 1 "path outside the extension root: .contexture/$_b (a package overlays .contexture/extensions/ only)" ;;
    esac
  done
fi
payload_root=$pkg_root/.contexture/extensions
[ -d "$payload_root" ] || die 1 "no .contexture/extensions payload in $pkg_root"
for _phk in probe install uninstall; do
  if [ -e "$pkg_root/hooks/$_phk" ] && [ ! -f "$pkg_root/hooks/$_phk" ]; then
    die 1 "malformed package hook: hooks/$_phk is not a regular file"
  fi
done

if [ -d "$ext_root" ]; then
  [ -w "$ext_root" ] && [ -x "$ext_root" ] || die 2 "the extension root is not writable: .contexture/extensions (nothing written)"
else
  [ -d "$ws_root/.contexture" ] || die 2 "no .contexture drawer at $ws_root (adopt the base first)"
  [ -w "$ws_root/.contexture" ] && [ -x "$ws_root/.contexture" ] || die 2 "the drawer is not writable, so the extension root cannot be created (nothing written)"
fi
if [ -e "$state_root" ]; then
  [ -d "$state_root" ] || die 1 "the install record area is not a directory: .contexture/extensions/.state"
  [ -w "$state_root" ] && [ -x "$state_root" ] || die 2 "the install record area is not writable: .contexture/extensions/.state (nothing written)"
fi

have_record=0
if [ -e "$state_file" ]; then
  [ -f "$state_file" ] || die 1 "the install record is not a regular file: .contexture/extensions/.state/$pkg_name.files"
  have_record=1
fi

tmp_base=${TMPDIR:-/tmp}
if mkdir -p "$ws_root/.contexture/tmp" 2>/dev/null && [ -d "$ws_root/.contexture/tmp" ] && [ -w "$ws_root/.contexture/tmp" ]; then
  tmp_base=$ws_root/.contexture/tmp
fi
scratch=$(mktemp -d "$tmp_base/pkg-install.XXXXXX") || die 2 "cannot create a scratch folder"
trap 'rm -rf "$scratch"' EXIT
trap 'rm -rf "$scratch"; exit 130' INT
trap 'rm -rf "$scratch"; exit 143' TERM

pkg_manifest=$pkg_root/manifest
[ -f "$pkg_manifest" ] || die 1 "no package manifest at $pkg_root/manifest (a package declares summary, version, kind, and parts)"
if ! "$ctx_bin" _package "$pkg_manifest" validate >/dev/null 2>"$scratch/pkgmf.err"; then
  die 1 "malformed package manifest: $(cat "$scratch/pkgmf.err")"
fi
pkg_summary=$("$ctx_bin" _package "$pkg_manifest" summary) || die 1 "cannot read the package summary"
pkg_version=$("$ctx_bin" _package "$pkg_manifest" version) || die 1 "cannot read the package version"
pkg_kind=$("$ctx_bin" _package "$pkg_manifest" kind) || die 1 "cannot read the package kind"
pkg_driver=$("$ctx_bin" _package "$pkg_manifest" driver) || die 1 "cannot read the package driver name"
pkg_format=$("$ctx_bin" _package "$pkg_manifest" format) || die 1 "cannot read the package storage format"
"$ctx_bin" _package "$pkg_manifest" parts > "$scratch/parts" || die 1 "cannot read the package parts"
[ -s "$scratch/parts" ] || die 1 "the package manifest declares no parts"
case "${CTX_PACKAGE_OLD:-}" in
  ""|backup|delete) ;;
  *) die 1 "malformed old copy answer '${CTX_PACKAGE_OLD:-}' (backup or delete)" ;;
esac
if [ "$pkg_kind" != driver ] && [ -n "${CTX_PACKAGE_DRIVER_CONFIG:-}" ]; then
  die 1 "--driver-config sets a driver package's setting, and '$pkg_name' is a feature package"
fi
if [ "$pkg_kind" = driver ]; then
  case "$0" in */*) pi_home=${0%/*} ;; *) pi_home=. ;; esac
  pi_lib=""
  for _c in "$pi_home/config-lib" "$ws_root/.contexture/config-lib"; do
    if [ -f "$_c" ]; then pi_lib=$_c; break; fi
  done
  [ -n "$pi_lib" ] || die 2 "the configuration library is not installed beside the installer"
  . "$pi_lib"
  DL_WS=$ws_root DL_LABEL=package-install DL_BIN=$ctx_bin DL_SCR=$scratch DL_PKG=$pkg_name DL_PKG_ROOT=$pkg_root DL_ANSWER=${CTX_PACKAGE_OLD:-}
  dl_init
fi

if ( cd "$payload_root" && find . ! -type d ! -type f -print ) > "$scratch/specials" 2>/dev/null; then
  [ -s "$scratch/specials" ] && die 1 "the package carries a non-regular file: $(head -n 1 "$scratch/specials") (only files and directories install)"
else
  die 2 "cannot read the package payload"
fi
if ! ( cd "$payload_root" && find . -type f -print ) > "$scratch/files.raw" 2>/dev/null; then
  die 2 "cannot list the package payload"
fi
sed 's|^\./||' "$scratch/files.raw" | LC_ALL=C sort > "$scratch/files" || die 2 "cannot list the package payload"
[ -s "$scratch/files" ] || die 1 "the .contexture/extensions payload is empty"

case "$(awk -F/ '$1 == "modules" && NF == 2 { print; exit }' "$scratch/files")" in
  "") ;;
  *) die 1 "malformed payload path: $(awk -F/ '$1 == "modules" && NF == 2 { print; exit }' "$scratch/files") (a module is a folder)" ;;
esac
case "$(awk -F/ '$1 == "storage" && NF < 3 { print; exit }' "$scratch/files")" in
  "") ;;
  *) die 1 "malformed payload path: $(awk -F/ '$1 == "storage" && NF < 3 { print; exit }' "$scratch/files") (a driver sits under storage/drivers/)" ;;
esac

while IFS=' ' read -r ptype ppath; do
  [ -n "$ppath" ] || die 1 "the package manifest carries an empty part"
  pp_src=$payload_root/$ppath
  [ -e "$pp_src" ] || die 1 "declared part is missing: $ptype $ppath"
  case "$ptype" in
    module) [ -d "$pp_src" ] || die 1 "the module part is not a folder: $ppath" ;;
    laws) [ -f "$pp_src" ] || [ -d "$pp_src" ] || die 1 "the laws part is neither a file nor a folder: $ppath" ;;
  esac
done < "$scratch/parts"

while IFS= read -r rel; do
  covered=0
  while IFS=' ' read -r ptype ppath; do
    case "$rel" in
      "$ppath"|"$ppath"/*) covered=1; break ;;
    esac
  done < "$scratch/parts"
  [ "$covered" -eq 1 ] || die 1 "payload path outside the declared parts: $rel"
done < "$scratch/files"

awk -F/ '$1 == "modules" && NF >= 3 { print $2 }' "$scratch/files" | LC_ALL=C sort -u > "$scratch/modules"
awk -F/ '$1 == "storage" && $2 == "drivers" && NF >= 3 { print $3 }' "$scratch/files" | LC_ALL=C sort -u > "$scratch/drivers"

# the install names, "<original> <installed>" per payload module: the CTX_PACKAGE_AS pairs
# first, then the record's module lines for a module the pairs do not name
: > "$scratch/aliases"
for _pair in ${CTX_PACKAGE_AS:-}; do
  case "$_pair" in
    ?*=?*) ;;
    *) die 1 "malformed --as '$_pair' (--as=<module>=<alias>)" ;;
  esac
  _am=${_pair%%=*}
  _aa=${_pair#*=}
  grep -Fqx -- "$_am" "$scratch/modules" || die 1 "--as names no module of the package: '$_am'"
  awk -v m="$_am" '$1 == m { f = 1 } END { exit(f ? 0 : 1) }' "$scratch/aliases" && die 1 "--as names the module '$_am' twice"
  printf '%s %s\n' "$_am" "$_aa" >> "$scratch/aliases"
done
if [ "$have_record" -eq 1 ]; then
  awk '$1 == "module" && NF == 3 { print $3 " " $2 }' "$state_file" | while read -r _am _aa; do
    grep -Fqx -- "$_am" "$scratch/modules" || continue
    awk -v m="$_am" '$1 == m { f = 1 } END { exit(f ? 0 : 1) }' "$scratch/aliases" && continue
    printf '%s %s\n' "$_am" "$_aa"
  done >> "$scratch/aliases"
fi
# the package's kept data, "<original> <kept name>" per kept declaration whose origin names
# this package: a payload module returns under the name its data was kept under, read as a
# record's module line is, and an --as naming another name for it refuses naming the kept one;
# a returning module must carry a data file, and the storage root check below holds it to the
# kept roots, so the return never takes a declaration away from keys its verbs cannot read
kept_back_refuse() {
  _krv=$(awk '$1 == "version" && NF == 2 { print $2; exit }' "$kept_root/$2/origin" 2>/dev/null)
  die 1 "module '$1' returns over the data kept under '$2', but $3, so its verbs would not read the kept keys; install the version that kept it (${_krv:-unknown}), or delete the kept data first: ctx package uninstall $pkg_name --delete-data"
}
kept_root=$state_root/retained
: > "$scratch/kept_own"
if [ -d "$kept_root" ]; then
  for _ko in "$kept_root"/*/origin; do
    [ -f "$_ko" ] || continue
    _kn=${_ko%/origin}
    _kn=${_kn##*/}
    awk -v p="$pkg_name" -v k="$_kn" '
      $1 == "package" && NF == 2 && pk == "" { pk = $2 }
      $1 == "module" && NF == 3 && $2 == k && m == "" { m = $3 }
      END { if (pk == p && m != "") print m " " k }' "$_ko" 2>/dev/null
  done > "$scratch/kept_own"
fi
: > "$scratch/kept_return"
while read -r _km _kn; do
  grep -Fqx -- "$_km" "$scratch/modules" || continue
  _ka=$(awk -v m="$_km" '$1 == m { print $2; exit }' "$scratch/aliases")
  if [ -z "$_ka" ]; then
    printf '%s %s\n' "$_km" "$_kn" >> "$scratch/aliases"
  elif [ "$_ka" != "$_kn" ]; then
    die 1 "module '$_km' has kept data under the name '$_kn', so it returns under that name: --as=$_km=$_kn (or delete the kept data first: ctx package uninstall $pkg_name --delete-data)"
  fi
  grep -Fqx "modules/$_km/data" "$scratch/files" || kept_back_refuse "$_km" "$_kn" "this version carries no data file for it"
  printf '%s %s\n' "$_km" "$_kn" >> "$scratch/kept_return"
done < "$scratch/kept_own"
awk 'FILENAME == ARGV[1] { n[$1] = $2; next } { print $0 " " (($0 in n) ? n[$0] : $0) }' "$scratch/aliases" "$scratch/modules" > "$scratch/inames"
_dup=$(awk '{ print $2 }' "$scratch/inames" | LC_ALL=C sort | uniq -d | head -n 1)
[ -z "$_dup" ] || die 1 "two modules of the package would install as '$_dup' (name each with its own --as=<module>=<name>)"

# a re-install never leaves an installed module's data undeclared: a data carrying module the
# record names whose installed name no payload module with a data file takes again (an --as
# moving it, a version dropping it or its data file) refuses while its namespace holds a key
# or its key count fails, since its data would be neither listed nor moved
clear_bin=$ws_root/.contexture/storage/scripts/store-clear
if [ "$have_record" -eq 1 ]; then
  awk '
    $1 == "module" && NF == 3 { orig[$2] = $3; next }
    $1 == "file" {
      n = split($4, a, "/")
      if (n == 5 && a[1] == ".contexture" && a[2] == "extensions" && a[3] == "modules" && a[5] == "data") d[a[4]] = 1
    }
    END { for (m in d) print m " " ((m in orig) ? orig[m] : m) }' "$state_file" | LC_ALL=C sort > "$scratch/data_now"
  while read -r _dn _do; do
    [ -f "$ext_root/modules/$_dn/data" ] || continue
    _keeps=$(awk -v n="$_dn" '$2 == n { print $1; exit }' "$scratch/inames")
    if [ -n "$_keeps" ] && grep -Fqx "modules/$_keeps/data" "$scratch/files"; then
      continue
    fi
    if _dc=$(CTX_ROOT=$ws_root "$clear_bin" count "$_dn" 2>/dev/null) && [ -n "$_dc" ]; then :; else _dc=unknown; fi
    [ "$_dc" != 0 ] || continue
    case "$_dc" in
      unknown) _dk="key count unknown" ;;
      1) _dk="1 key" ;;
      *) _dk="$_dc keys" ;;
    esac
    die 1 "the re-install would leave the data of module '$_do' (namespace '$_dn', $_dk) undeclared; uninstall the package with --keep-data or --delete-data as the human answers, then install it"
  done < "$scratch/data_now"
fi
# the destination of every payload path: modules/<original>/... lands at modules/<installed>/...
awk 'FILENAME == ARGV[1] { n[$1] = $2; next }
  { split($0, a, "/"); d = $0
    if (a[1] == "modules" && (a[2] in n)) d = "modules/" n[a[2]] substr($0, length(a[2]) + 9)
    print $0 "\t" d }' "$scratch/inames" "$scratch/files" > "$scratch/map"

if [ "$pkg_kind" = driver ]; then
  [ "$(cat "$scratch/drivers" 2>/dev/null)" = "$pkg_driver" ] || die 1 "the driver part storage/drivers/$pkg_driver does not match the payload"
else
  [ -s "$scratch/drivers" ] && die 1 "a feature package carries no driver part"
fi

while read -r mname_o mname; do
  case "$mname" in
    ""|[!abcdefghijklmnopqrstuvwxyz0123456789]*|*[!abcdefghijklmnopqrstuvwxyz0123456789._-]*)
      die 1 "malformed module name '$mname': a module name is lowercase letters, digits, dot, underscore, and dash, starting with a letter or digit" ;;
  esac
  if "$ctx_bin" _builtin "$mname" >/dev/null 2>&1; then
    die 1 "module name '$mname' collides with a builtin (install it under another name: --as=$mname_o=<name>)"
  fi
  if [ -f "$payload_root/modules/$mname_o/module" ] || [ -d "$payload_root/modules/$mname_o/scripts" ]; then
    grep -Fqx "module modules/$mname_o" "$scratch/parts" || die 1 "module '$mname_o' is not declared as a module part"
  fi
  if "$ctx_bin" _reserved "$mname" >/dev/null 2>&1; then
    die 1 "module name '$mname' is a reserved name (install it under another name: --as=$mname_o=<name>)"
  fi
  if [ -e "$ws_root/.contexture/modules/$mname" ]; then
    die 1 "module name '$mname' collides with a workspace module (install it under another name: --as=$mname_o=<name>)"
  fi
  if [ -e "$kept_root/$mname" ]; then
    _kp=$(awk '$1 == "package" && NF == 2 { print $2; exit }' "$kept_root/$mname/origin" 2>/dev/null)
    _km=$(awk -v k="$mname" '$1 == "module" && NF == 3 && $2 == k { print $3; exit }' "$kept_root/$mname/origin" 2>/dev/null)
    if [ "$_kp" != "$pkg_name" ] || [ "$_km" != "$mname_o" ]; then
      die 1 "module name '$mname' holds data that package '${_kp:-unknown}' kept at its uninstall (install it under another name: --as=$mname_o=<name>)"
    fi
  fi
  if [ -e "$ext_root/modules/$mname" ]; then
    if record_has_prefix ".contexture/extensions/modules/$mname/"; then
      :
    elif other=$(other_has_prefix ".contexture/extensions/modules/$mname/"); then
      die 1 "another package's module: .contexture/extensions/modules/$mname (recorded by $other; install it under another name: --as=$mname_o=<name>)"
    else
      die 1 "existing non-recorded file: .contexture/extensions/modules/$mname (uninstall or remove it first)"
    fi
  fi
  mdir=$payload_root/modules/$mname_o
  if [ -f "$mdir/module" ]; then
    if ! "$ctx_bin" _module "$mdir/module" validate >/dev/null 2>"$scratch/moderr"; then
      die 1 "malformed module '$mname_o': $(cat "$scratch/moderr")"
    fi
  elif [ -d "$mdir/scripts" ]; then
    die 1 "module '$mname_o' ships scripts/ without a module file"
  fi
done < "$scratch/inames"

# the storage roots: a payload module with a data file stores under the root it declares
# (its namespace when none is declared), or under its installed name when it installs under
# an alias; the storage core's data reader answers both, over a scratch copy of the payload's
# data files under their installed names beside their module lines, and over the workspace;
# a root or fallback root another installed module resolves to (this package's own modules
# aside), or two modules of the package share, refuses naming --as, since an alias moves it.
# Either listing leaving a module out refuses, since an unread root cannot be checked: the
# payload's rc 1 (a malformed data file of the package), the workspace's rc 2, a module this
# package itself installed aside (its replaced copy takes no part, so a re-install repairs it)
sd_bin=$ws_root/.contexture/storage/scripts/store-data
sd_why() { awk 'index($0, "store-data: ") == 1 { print substr($0, 13); exit }' "$1"; }
if [ -x "$sd_bin" ] && grep -q '^modules/[^/]*/data$' "$scratch/files"; then
  sd_ws=$scratch/roots
  mkdir -p "$sd_ws/.contexture/modules" "$sd_ws/.contexture/extensions/.state" || die 2 "cannot stage the storage root check"
  while read -r mname_o mname; do
    [ -f "$payload_root/modules/$mname_o/data" ] || continue
    mkdir -p "$sd_ws/.contexture/extensions/modules/$mname" \
      && cp "$payload_root/modules/$mname_o/data" "$sd_ws/.contexture/extensions/modules/$mname/data" \
      && printf 'module %s %s\n' "$mname" "$mname_o" >> "$sd_ws/.contexture/extensions/.state/$pkg_name.files" \
      || die 2 "cannot stage the storage root check"
  done < "$scratch/inames"
  CTX_STORE_WORKSPACE=$sd_ws "$sd_bin" --list > "$scratch/roots.new" 2> "$scratch/roots.new.err"
  sd_rc=$?
  if [ "$sd_rc" -ne 0 ]; then
    [ "$sd_rc" -eq 1 ] || sd_rc=2
    die "$sd_rc" "a module data file of the package cannot be read, so its storage roots cannot be checked ($(sd_why "$scratch/roots.new.err"))"
  fi
  : > "$scratch/own"
  if [ "$have_record" -eq 1 ]; then
    awk '$1 == "file" { n = split($4, a, "/"); if (n >= 5 && a[1] == ".contexture" && a[2] == "extensions" && a[3] == "modules") print a[4] }' "$state_file" > "$scratch/own"
  fi
  awk '{ print $2 }' "$scratch/kept_return" >> "$scratch/own"
  CTX_STORE_WORKSPACE=$ws_root "$sd_bin" --retained > "$scratch/kept_rows" 2>/dev/null || :
  CTX_STORE_WORKSPACE=$ws_root "$sd_bin" --list > "$scratch/roots.old" 2> "$scratch/roots.old.err"
  sd_rc=$?
  if [ "$sd_rc" -ne 0 ]; then
    _left=$(awk '
      FILENAME == ARGV[1] { own[$0] = 1; next }
      index($0, "store-data: ") != 1 { next }
      {
        m = substr($0, 13)
        if (index(m, "namespace \047") == 1) {
          ns = substr(m, 12)
          ns = substr(ns, 1, index(ns, "\047") - 1)
          if (ns in own) next
        }
        print m
        exit
      }' "$scratch/own" "$scratch/roots.old.err")
    # kept data whose declaration the reader refuses has one repair: its package's return
    _lns=$(printf '%s\n' "$_left" | awk -v q="'" 'index($0, "namespace " q) == 1 { s = substr($0, 12); print substr(s, 1, index(s, q) - 1); exit }')
    _lkp=""
    [ -z "$_lns" ] || [ ! -f "$kept_root/$_lns/data" ] || _lkp=$(awk -F '\t' -v n="$_lns" '$1 == n { print $2; exit }' "$scratch/kept_rows")
    _lwhy=${_left#*"': "}
    [ -z "$_lkp" ] || die 2 "the data package '$_lkp' kept under namespace '$_lns' has a declaration the storage core cannot read ($_lwhy), so the storage roots cannot be checked; install $_lkp again to take it back, which repairs it"
    if [ "$sd_rc" -ne 1 ] || [ -n "$_left" ]; then
      die 2 "a module data file of the workspace cannot be read, so the storage roots cannot be checked (${_left:-$(sd_why "$scratch/roots.old.err")}); fix that module's data file first"
    fi
  fi
  # sd_row <namespace> <listing>: the namespace's roots in a listing, the fallback root after
  # the root, quoted and joined for a line, or nothing when the listing left it out
  sd_row() { awk -F '\t' -v n="$1" '$1 == n { s = $2; for (i = 3; i <= NF; i++) s = s "\047 and \047" $i; print s; exit }' "$2"; }
  # a returning module keeps the kept roots, the fallback root among them; a kept declaration
  # the reader cannot read gives no row, and the return then repairs it
  while read -r _km _kn; do
    _kr=$(sd_row "$_kn" "$scratch/roots.old")
    _nr=$(sd_row "$_kn" "$scratch/roots.new")
    [ -z "$_kr" ] || [ "$_kr" = "$_nr" ] || kept_back_refuse "$_km" "$_kn" "this version stores it under '$_nr' where the kept data lies under '$_kr'"
  done < "$scratch/kept_return"
  _clash=$(awk '
    FILENAME == ARGV[1] { own[$0] = 1; next }
    FILENAME == ARGV[2] { orig[$2] = $1; next }
    FILENAME == ARGV[3] {
      n = split($0, f, /\t/)
      if (f[1] in own) next
      for (i = 2; i <= n; i++) if (f[i] != "") held[f[i]] = f[1]
      next
    }
    {
      n = split($0, f, /\t/)
      for (i = 2; i <= n; i++) {
        if (f[i] == "") continue
        if (f[i] in held) { print orig[f[1]] "\t" f[i] "\t" held[f[i]]; exit }
        if (f[i] in mine) { print orig[f[1]] "\t" f[i] "\t@" mine[f[i]]; exit }
      }
      for (i = 2; i <= n; i++) if (f[i] != "") mine[f[i]] = orig[f[1]]
    }' "$scratch/own" "$scratch/inames" "$scratch/roots.old" "$scratch/roots.new")
  if [ -n "$_clash" ]; then
    _tab=$(printf '\t')
    _cm=${_clash%%"$_tab"*}
    _cr=${_clash#*"$_tab"}
    _co=${_cr#*"$_tab"}
    _cr=${_cr%%"$_tab"*}
    _ckp=$(awk -F '\t' -v n="$_co" '$1 == n { print $2; exit }' "$scratch/kept_rows")
    case "$_co" in
      @*) die 1 "two modules of the package would store under the root '$_cr', '${_co#@}' and '$_cm' (install one under another name: --as=$_cm=<name>)" ;;
      *)
        [ -z "$_ckp" ] || die 1 "module '$_cm' would store under the root '$_cr', which holds the data of namespace '$_co' that package '$_ckp' kept at its uninstall (install it under another name: --as=$_cm=<name>)"
        die 1 "module '$_cm' would store under the root '$_cr', which the installed module '$_co' stores under (install it under another name: --as=$_cm=<name>)"
        ;;
    esac
  fi
fi

while IFS= read -r dname; do
  case "$dname" in
    ""|.*) die 1 "malformed driver name '$dname'" ;;
  esac
  case "$dname" in
    *[!A-Za-z0-9._-]*) die 1 "malformed driver name '$dname' (letters, digits, dot, underscore, hyphen)" ;;
  esac
  [ "$dname" = posix ] && die 1 "driver name 'posix' collides with the core posix driver"
  if [ -e "$ws_root/.contexture/storage/drivers/$dname" ]; then
    die 1 "driver name '$dname' already resolves in the core"
  fi
  if [ -e "$ws_root/.contexture/drivers/$dname" ]; then
    die 1 "driver name '$dname' already resolves in the workspace"
  fi
  for _md in "$ws_root"/.contexture/modules/*/drivers/"$dname"; do
    [ -e "$_md" ] || continue
    die 1 "driver name '$dname' already resolves in a module"
  done
  if [ -e "$ext_root/storage/drivers/$dname" ]; then
    if record_has_prefix ".contexture/extensions/storage/drivers/$dname/"; then
      :
    elif other=$(other_has_prefix ".contexture/extensions/storage/drivers/$dname/"); then
      die 1 "another package's driver: .contexture/extensions/storage/drivers/$dname (recorded by $other)"
    else
      die 1 "existing non-recorded file: .contexture/extensions/storage/drivers/$dname (uninstall or remove it first)"
    fi
  fi
  if [ -f "$payload_root/storage/drivers/$dname" ]; then
    [ -x "$payload_root/storage/drivers/$dname" ] || die 1 "driver '$dname' has no executable at storage/drivers/$dname"
  else
    [ -x "$payload_root/storage/drivers/$dname/driver" ] || die 1 "driver '$dname' has no executable at storage/drivers/$dname/driver"
  fi
done < "$scratch/drivers"

: > "$scratch/newpaths"
while IFS='	' read -r src rel; do
  for _r in "$src" "$rel"; do
    case "$_r" in
      ""|/*) die 1 "malformed payload path '$_r'" ;;
    esac
    case "$_r" in
      *[[:space:]]*|*[[:cntrl:]]*) die 1 "malformed payload path '$_r' (no blanks or control characters)" ;;
    esac
    case "/$_r/" in
      */../*|*/./*) die 1 "malformed payload path '$_r' (no . or .. segment)" ;;
      */.state/*) die 1 "the install record area is reserved: $_r" ;;
    esac
  done
  rel_ws=.contexture/extensions/$rel
  target=$ext_root/$rel
  p=$target
  while :; do
    p=$(dirname "$p")
    [ "$p" = "$ext_root" ] && break
    [ "$p" = "$ws_root" ] && break
    if [ -e "$p" ] && [ ! -d "$p" ]; then
      die 1 "path conflict: ${p#"$ws_root"/} is not a directory"
    fi
  done
  if [ -e "$target" ]; then
    if [ -d "$target" ]; then
      die 1 "path conflict: $rel_ws is a directory (the package installs a file there)"
    fi
    if record_has "$rel_ws"; then
      :
    elif other=$(other_has "$rel_ws"); then
      die 1 "another package's file: $rel_ws (recorded by $other)"
    else
      die 1 "existing non-recorded file: $rel_ws (uninstall or remove it first)"
    fi
  fi
  printf '%s\n' "$rel_ws" >> "$scratch/newpaths"
done < "$scratch/map"

# make_dir <folder>: mkdir -p, noting every folder it creates so a rollback removes them
# again (and only them): a failed fresh install leaves the tree as it found it
: > "$scratch/made"
make_dir() {
  _md=$1
  while [ -n "$_md" ] && [ ! -e "$_md" ]; do
    printf '%s\n' "$_md" >> "$scratch/made"
    _md=${_md%/*}
  done
  mkdir -p "$1"
}

stage=$state_root/.stage.$$
record_phase=0
uninstall_phase=0
rollback() {
  _rb=$1
  _rbrc=${2:-2}
  trap '' HUP INT TERM
  [ -z "${DL_TOKEN:-}" ] || dl_release
  if [ -f "$scratch/moved" ]; then
    while IFS= read -r _t; do
      _p=${_t#"$ws_root"/}
      if [ -f "$stage/.backup/$_p" ]; then
        mv -f "$stage/.backup/$_p" "$_t" 2>/dev/null
      else
        rm -f "$_t" 2>/dev/null
      fi
    done < "$scratch/moved"
  fi
  if [ -f "$scratch/removed" ]; then
    while IFS= read -r _t; do
      _p=${_t#"$ws_root"/}
      [ -f "$stage/.backup/$_p" ] && mv -f "$stage/.backup/$_p" "$_t" 2>/dev/null
    done < "$scratch/removed"
  fi
  if [ "$record_phase" -eq 1 ]; then
    if [ -f "$stage/.backup/.record" ]; then
      mv -f "$stage/.backup/.record" "$state_file" 2>/dev/null
    else
      rm -f "$state_file" 2>/dev/null
    fi
  fi
  if [ "$uninstall_phase" -eq 1 ]; then
    if [ -f "$stage/.backup/.uninstall" ]; then
      mv -f "$stage/.backup/.uninstall" "$stash_uninstall" 2>/dev/null
    else
      rm -f "$stash_uninstall" 2>/dev/null
    fi
  fi
  if [ -s "$scratch/kept_back" ]; then
    mkdir -p "$kept_root" 2>/dev/null
    while IFS= read -r _k; do
      mv "$stage/.backup/.kept/$_k" "$kept_root/$_k" 2>/dev/null
    done < "$scratch/kept_back"
  fi
  rm -rf "$stage" 2>/dev/null
  LC_ALL=C sort -ru "$scratch/made" | while IFS= read -r _d; do
    rmdir "$_d" 2>/dev/null
  done
  die "$_rbrc" "$_rb"
}

# The driver package run (docs/the-engine.md, Moving a record between backends). Before
# anything is written: no storage variable, one driver package at a time, the readiness
# probe, the driver settings, the run folder in the drawer's scratch, the move state with crash
# recovery, the path, and the old copy answer; then a reinstall's freeze and dump before the
# files land, or a format change's move out with the installed code. After the overlay, its
# record, and its stash: the behavior test, then the move in or the reinstall's dump after;
# any failure through the verify unwinds in reverse, a signal stopping the held step first;
# past the verify nothing unwinds.
dl_keep=0
dl_mode=""
dl_phase=""
dl_step=""
dl_why=""
dl_part=$ext_root/storage/drivers/$pkg_driver
in_prep=0
in_copy=0
in_switch=0
dl_warns=""

dl_exit() {
  rm -rf "$scratch"
  [ "$dl_keep" -eq 1 ] || dl_run_drop
}

# driver_setting_ok <key> <value> <what>: the key one the incoming part's config schema
# declares and the value of its type, else a refusal rc 1 naming <what>
driver_setting_ok() {
  _row=$(awk -F '\t' -v k="$1" '$1 == k { print; exit }' "$scratch/dcfg.rows")
  [ -n "$_row" ] || die 1 "$3: the '$pkg_driver' driver's config schema declares no key '$1'"
  _t=$(printf '%s\n' "$_row" | awk -F '\t' '{ print $3 }')
  _one=$(printf '%s\n' "$_row" | LC_ALL=C awk "$CFG_ESC_AWK"'BEGIN { FS = "\t" } { print cfg_unesc($4) }')
  _min=$(printf '%s\n' "$_row" | awk -F '\t' '{ print $5 }')
  _max=$(printf '%s\n' "$_row" | awk -F '\t' '{ print $6 }')
  if ! { cfg_validate_str package-install "the value of '$1'" "$2" && cfg_schema_validate_value "$_t" "$_one" "$_min" "$_max" "$2" package-install "$1"; } 2> "$scratch/dcfg.err"; then
    die 1 "$3: $(sed -n '1s/^package-install: error: //p' "$scratch/dcfg.err")"
  fi
}

driver_settings_read() {
  : > "$scratch/dcfg.rows"
  _cf=$payload_root/storage/drivers/$pkg_driver/config
  if [ -f "$_cf" ]; then
    cfg_schema_parse "$_cf" package-install > "$scratch/dcfg.rows" 2> "$scratch/dcfg.err" \
      || die 1 "the '$pkg_driver' driver's config schema cannot be read: $(dl_first "$scratch/dcfg.err")"
  fi
  printf '%s' "${CTX_PACKAGE_DRIVER_CONFIG:-}" > "$scratch/dcfg.given"
  : > "$scratch/dcfg.set"
  while IFS= read -r _pair || [ -n "$_pair" ]; do
    [ -n "$_pair" ] || continue
    _k=${_pair%%=*}
    _val=${_pair#*=}
    awk -F '\t' -v k="$_k" '$1 == k { f = 1 } END { exit(f ? 0 : 1) }' "$scratch/dcfg.set" \
      && die 1 "--driver-config names the key '$_k' twice; give the one value the human chose"
    driver_setting_ok "$_k" "$_val" "--driver-config=$_k=$_val"
    printf '%s\t%s\n' "$_k" "$_val" >> "$scratch/dcfg.set"
  done < "$scratch/dcfg.given"
}

# driver_settings_settle: a reinstall at the configured driver's format changes no setting
# (its driver holds the record); otherwise a required setting with no default that neither the
# flags nor the configuration give is asked at a terminal or refused naming its flag
driver_settings_settle() {
  if [ "$dl_mode" = plain ]; then
    while IFS='	' read -r _k _val; do
      _cur=$(cfg_get "storage.$_k" "$ws_root/.contexture" 2>/dev/null)
      [ "$_cur" = "$_val" ] || die 1 "--driver-config=$_k=$_val changes a setting of the configured driver '$pkg_driver', which holds the record: uninstall $pkg_name, then install it with --driver-config=$_k=$_val"
    done < "$scratch/dcfg.set"
    return 0
  fi
  for _k in $(awk -F '\t' '$2 == "required" && $7 == "0" { print $1 }' "$scratch/dcfg.rows"); do
    awk -F '\t' -v k="$_k" '$1 == k { f = 1 } END { exit(f ? 0 : 1) }' "$scratch/dcfg.set" && continue
    _cur=$(cfg_get "storage.$_k" "$ws_root/.contexture" 2>/dev/null) && [ -n "$_cur" ] && continue
    _val=$(cfg_answer_value package-install "installing '$pkg_name' needs the '$pkg_driver' driver's setting '$_k', which has no default" "--driver-config=$_k=<value>") || exit $?
    driver_setting_ok "$_k" "$_val" "the answer for '$_k'"
    printf '%s\t%s\n' "$_k" "$_val" >> "$scratch/dcfg.set"
  done
}

# driver_behavior: the storage core's behavior test on the installed part, in the foreground
# (a background job ignores an interrupt from its start), its one verdict line in dl_why
driver_behavior() {
  ( cd "$ws_root" || exit 2
    unset CTX_DIR
    CTX_ROOT=$ws_root
    export CTX_ROOT
    exec "$DL_CORE/driver-behavior" "$dl_part" ) < /dev/null > "$scratch/behavior.out" 2> "$scratch/behavior.err"
  _br=$?
  case "$_br" in
    0) return 0 ;;
    129|130|143) on_sig "$_br" ;;
  esac
  dl_why=$(dl_first "$scratch/behavior.out")
  [ "$dl_why" != "it gave no reason" ] || dl_why="it answered rc $_br: $(dl_first "$scratch/behavior.err")"
  return 1
}

# driver_dump <before|after>: every namespace scanned through the configured driver into the
# run folder; dl_why names a failure
driver_dump() {
  dl_namespaces "$scratch/dump.ns" || { dl_why="the namespaces cannot be listed"; return 2; }
  mkdir -p "$DL_RUN/$1" || { dl_why="the run folder cannot be written"; return 2; }
  for _ns in $(cat "$scratch/dump.ns"); do
    dl_held "$DL_RUN/$1/$_ns" "$scratch/dump.err" dl_core_exec - 0 driver-resolver store.scan "$_ns" \
      || { dl_why="namespace '$_ns' cannot be read: $(dl_first "$scratch/dump.err")"; return 2; }
  done
}

# dl_carried <run subfolder>: the keys a move copied, summed over its namespaces
dl_carried() {
  cat "$1"/copied.* 2>/dev/null | awk '{ n += $1 } END { print n + 0 }'
}

plain_fail() {
  trap '' HUP INT TERM
  dl_phase=unwinding
  rollback "the update failed at $1 ($2); its files are rolled back and the record reads as before" 2
}

in_unwind() {
  dl_unwound=""
  [ "$in_switch" -eq 0 ] || dl_conf_revert storage.driver
  if [ "$in_copy" -eq 1 ]; then
    dl_written "$DL_RUN/in"
    if dl_move "$DL_RUN/in" unwind "$pkg_driver"; then
      dl_unwound=$(dl_unwound "$DL_SCR/move.out")
    else
      dl_unwound="the unwind of the copy stopped ($(dl_first "$DL_SCR/move.err"))"
    fi
  fi
  dl_release
  if [ "$in_prep" -eq 1 ] && ! dl_hook "$dl_part" cleanup "$pkg_version" in; then
    dl_err "the driver's cleanup failed ($DL_LINE)"
  fi
  dl_conf_back || dl_err "the workspace configuration cannot be put back"
}

in_fail() {
  trap '' HUP INT TERM
  dl_phase=unwinding
  in_unwind
  if [ "$dl_mode" = upgrade ]; then
    rollback "the update's move in failed at $dl_step ($dl_why)${dl_unwound:+; unwound: $dl_unwound}; the record reads from posix, verified, and $pkg_name stays installed at $dl_old_version, not configured" 2
  fi
  rollback "the install failed at $dl_step ($dl_why)${dl_unwound:+; unwound: $dl_unwound}; the install is undone" 2
}

# dl_unfinished: one warning per step past the verify that did not run
dl_unfinished() {
  [ -s "$DL_RUN/pending" ] || return 0
  grep -qx retire "$DL_RUN/pending" && dl_err "warning: the old copy step did not run: posix still holds the moved records; install $pkg_name again to finish it"
  grep -qx finish "$DL_RUN/pending" && dl_err "warning: the driver's finish did not run; install $pkg_name again to finish it"
  return 0
}

on_sig() {
  trap '' HUP INT TERM
  _sig=$1
  dl_stop
  case "$dl_phase" in
    plain-pre)
      dl_release
      die "$_sig" "stopped by a signal before the update's files landed; nothing changed"
      ;;
    out)
      dl_phase=unwinding
      dl_out_unwind
      die "$_sig" "stopped by a signal during the update's move out${DL_UNWOUND:+; unwound: $DL_UNWOUND}; $pkg_name stays installed at $dl_old_version and configured"
      ;;
    out-past)
      dl_release
      die "$_sig" "stopped by a signal after the update's move out passed its verify: the record reads from posix and $pkg_name stays installed at $dl_old_version, not configured; install it again to move the record back in"
      ;;
    plain-post)
      dl_phase=unwinding
      rollback "stopped by a signal during the update; its files are rolled back and the record reads as before" "$_sig"
      ;;
    in)
      dl_phase=unwinding
      in_unwind
      rollback "stopped by a signal during $dl_step${dl_unwound:+; unwound: $dl_unwound}; the install is undone" "$_sig"
      ;;
    past)
      dl_release
      dl_keep=1
      dl_err "stopped by a signal after the move passed its verify: the record reads from the '$pkg_driver' driver"
      dl_unfinished
      exit "$_sig"
      ;;
    unwinding) ;;
    *) exit "$_sig" ;;
  esac
}

driver_traps() {
  trap 'on_sig 129' HUP
  trap 'on_sig 130' INT
  trap 'on_sig 143' TERM
}

driver_pre() {
  driver_traps
  _v=$(dl_env_vars)
  [ -z "$_v" ] || die 1 "the environment sets $_v; a storage variable can point a driver elsewhere, so unset it and run again"
  _o=$(dl_driver_pkgs | awk -v p="$pkg_name" '$1 != p { print $1; exit }')
  [ -z "$_o" ] || die 1 "the driver package '$_o' is installed, and one driver package is installed at a time: uninstall it first (ctx package uninstall $_o)"
  if [ -f "$pkg_root/hooks/probe" ]; then
    ( cd "$ws_root" || exit 2
      CTX_ROOT=$ws_root
      CTX_BIN=$ctx_bin
      CTX_PACKAGE_NAME=$pkg_name
      CTX_PACKAGE_ROOT=$pkg_root
      CTX_PACKAGE_VERSION=$pkg_version
      LC_ALL=C
      export CTX_ROOT CTX_BIN CTX_PACKAGE_NAME CTX_PACKAGE_ROOT CTX_PACKAGE_VERSION LC_ALL
      [ ! -x "$pkg_root/hooks/probe" ] || exec "$pkg_root/hooks/probe" < /dev/null
      exec sh "$pkg_root/hooks/probe" < /dev/null ) > "$scratch/probe" 2>&1
    _pr=$?
    case "$_pr" in
      0) ;;
      1|3) die 1 "the package's readiness probe answers that this host cannot run it: $(dl_first "$scratch/probe")" ;;
      *) die 2 "the package's readiness probe failed (rc $_pr): $(dl_first "$scratch/probe")" ;;
    esac
  fi
  driver_settings_read
  dl_run_make || die 2 "the drawer's scratch folder cannot hold the driver run, and a driver run never uses the system temp (nothing written)"
  trap 'dl_exit' EXIT
  dl_recover || exit $?
  dl_conf=$(cfg_effective_driver "$ws_root/.contexture")
  if [ "$have_record" -eq 1 ] && [ "$dl_conf" = "$pkg_driver" ]; then
    dl_old_format=$(awk '$1 == "format" && NF == 2 { print $2; exit }' "$state_file")
    dl_old_format=${dl_old_format:-0}
    dl_old_version=$(awk '$1 == "version" && NF == 2 { print $2; exit }' "$state_file")
    if [ "$dl_old_format" = "$pkg_format" ]; then dl_mode=plain; else dl_mode=upgrade; fi
  else
    case "$dl_conf" in
      posix|"$pkg_driver") ;;
      *) die 1 "the configured storage driver is '$dl_conf', not posix, so the record cannot move from posix into '$pkg_driver'" ;;
    esac
    dl_mode=in
  fi
  driver_settings_settle
  case "$dl_mode" in
    in)
      dl_count posix "$scratch/old.counts" || die 2 "the namespaces cannot be listed, so the record cannot be counted"
      dl_ask "$scratch/old.counts" "installing '$pkg_name' moves the record from posix into the '$pkg_driver' driver and leaves its old posix copy" || exit $?
      ;;
    upgrade)
      dl_count "$pkg_driver" "$scratch/old.counts" || die 2 "the namespaces cannot be listed, so the record cannot be counted"
      dl_ask "$scratch/old.counts" "updating '$pkg_name' from storage format $dl_old_format to $pkg_format moves the record out through posix and leaves the '$pkg_driver' driver's old storage, the old copy" || exit $?
      ;;
  esac
  case "$dl_mode" in
    plain)
      dl_phase=plain-pre
      dl_take "$pkg_driver" "$pkg_driver" || die 2 "the update cannot take the storage moving freeze: $(dl_first "$DL_SCR/take.err")"
      if ! driver_dump before; then
        dl_release
        die 2 "the update's dump before its files land failed: $dl_why; nothing changed"
      fi
      dl_phase=plain-post
      ;;
    upgrade)
      dl_phase=out
      if ! dl_out "$pkg_driver"; then
        _step=$DL_STEP
        _why=$DL_LINE
        trap '' HUP INT TERM
        dl_phase=unwinding
        dl_out_unwind
        die 2 "the update's move out failed at $_step ($_why)${DL_UNWOUND:+; unwound: $DL_UNWOUND}; $pkg_name stays installed at $dl_old_version and configured"
      fi
      dl_phase=out-past
      printf '%s\n' "$DL_OUT_LINES"
      dl_release || dl_err "warning: the move out's freeze cannot be released ($(dl_first "$DL_SCR/release.err"))"
      _ans=$DL_ANSWER
      [ -n "$_ans" ] || { [ "$(dl_carried "$DL_RUN/out")" -eq 0 ] && _ans=delete || _ans=backup; }
      if ! dl_finish_out "$pkg_driver" "$dl_old_version" "$_ans"; then
        die 2 "the update moved the record out through posix and verified it, but the old version's finish failed ($DL_LINE), so the new version was not installed: $pkg_name stays installed at $dl_old_version, not configured; uninstall it with the human's answer to finish the old copy, then install it"
      fi
      printf "package-install: the '%s' driver's old storage %s\n" "$pkg_driver" "$DL_DONE"
      dl_phase=in
      ;;
    in)
      dl_phase=in
      ;;
  esac
}

# driver_post: after the overlay, its record, and its stash: the reinstall's behavior test and
# dump after, compared namespace by namespace, or the move in through the check
driver_post() {
  if [ "$dl_mode" = plain ]; then
    dl_step="the behavior test"
    driver_behavior || plain_fail "$dl_step" "$dl_why"
    dl_step="the dump after its files landed"
    driver_dump after || plain_fail "$dl_step" "$dl_why"
    for _ns in $(cat "$scratch/dump.ns"); do
      cmp -s "$DL_RUN/before/$_ns" "$DL_RUN/after/$_ns" \
        || plain_fail "the compare" "namespace '$_ns' reads differently through the new version, so a format change went unmarked or its reads changed"
    done
    dl_release || dl_err "warning: the update's freeze cannot be released ($(dl_first "$DL_SCR/release.err"))"
    dl_phase=done
    return 0
  fi
  dl_step="the behavior test"
  driver_behavior || in_fail
  dl_step="the driver settings"
  dl_conf_save || { dl_why="the workspace configuration cannot be saved in the run folder"; in_fail; }
  while IFS='	' read -r _k _val; do
    dl_conf_set "storage.$_k" "$_val" || { dl_why=$(dl_first "$DL_SCR/conf.err"); in_fail; }
  done < "$scratch/dcfg.set"
  dl_step="the driver's prepare"
  dl_hook "$dl_part" prepare "$pkg_version" in
  _hr=$?
  case "$_hr" in
    0) in_prep=1 ;;
    1) dl_why="it refused: $DL_LINE"; in_fail ;;
    *) dl_why="it failed (rc $_hr): $DL_LINE"; in_fail ;;
  esac
  dl_step="the preflight"
  dl_move "$DL_RUN/in" preflight posix "$pkg_driver" || { dl_why=$(dl_first "$DL_SCR/move.err"); in_fail; }
  dl_step="the freeze"
  dl_take posix "$pkg_driver" || { dl_why=$(dl_first "$DL_SCR/take.err"); in_fail; }
  dl_step="the copy"
  in_copy=1
  dl_move "$DL_RUN/in" copy posix "$pkg_driver" || { dl_why=$(dl_first "$DL_SCR/move.err"); in_fail; }
  cp "$DL_SCR/move.out" "$scratch/copy.lines"
  grep ': note: ' "$DL_SCR/move.err" > "$scratch/copy.notes" 2>/dev/null
  dl_step="the switch"
  { printf '%s %s %s\n' "$pkg_name" "$pkg_driver" "$pkg_version" > "$DL_RUN/run" \
    && printf 'check\nretire\nfinish\n' > "$DL_RUN/pending"; } 2> /dev/null \
    || { dl_why="the run folder cannot be written"; in_fail; }
  in_switch=1
  dl_conf_set storage.driver "$pkg_driver" || { dl_why=$(dl_first "$DL_SCR/conf.err"); in_fail; }
  dl_step="the check"
  dl_move "$DL_RUN/in" check posix || { dl_why=$(dl_first "$DL_SCR/move.err"); in_fail; }
  printf 'retire\nfinish\n' > "$DL_RUN/pending"
  dl_keep=1
  dl_phase=past
  cat "$scratch/copy.notes" >&2
  cat "$scratch/copy.lines"
}

# driver_past: past the verify, nothing unwinds: the old copy step under the still held
# freeze (the posix records saved into the run's backup or deleted, as the human answered),
# the release, and the driver's finish; a step that fails warns naming how to finish it
driver_past() {
  [ "$dl_mode" != plain ] || return 0
  _ans=${DL_ANSWER:-backup}
  if dl_move "$DL_RUN/in" retire posix "$_ans" "$DL_STAMP"; then
    sed -n '$p' "$DL_SCR/move.out"
    grep -vx retire "$DL_RUN/pending" > "$DL_RUN/pending.new"
    mv -f "$DL_RUN/pending.new" "$DL_RUN/pending"
  else
    dl_err "the old copy step failed: $(dl_first "$DL_SCR/move.err")"
  fi
  dl_release || dl_err "warning: the move's freeze cannot be released ($(dl_first "$DL_SCR/release.err"))"
  if dl_hook "$dl_part" finish "$pkg_version" in; then
    grep -vx finish "$DL_RUN/pending" > "$DL_RUN/pending.new"
    mv -f "$DL_RUN/pending.new" "$DL_RUN/pending"
  else
    dl_err "the driver's finish failed: $DL_LINE"
  fi
  if [ -s "$DL_RUN/pending" ]; then
    dl_unfinished
  else
    dl_keep=0
  fi
  dl_phase=done
}

if [ "$pkg_kind" = driver ]; then
  driver_pre
fi

make_dir "$state_root" || rollback "cannot create .contexture/extensions/.state"
rm -rf "$stage"
mkdir -p "$stage" || rollback "cannot create the install staging folder"

: > "$scratch/plan"
while IFS='	' read -r src rel; do
  mkdir -p "$stage/$(dirname "$rel")" || rollback "cannot stage $rel"
  cp -p "$payload_root/$src" "$stage/$rel" || rollback "cannot stage $rel"
  m=$(mode_of "$stage/$rel")
  c=$(cksum_of "$stage/$rel")
  if [ -z "$m" ] || [ -z "$c" ]; then
    rollback "cannot read the mode or checksum of $rel"
  fi
  printf '%s %s %s\n' "$rel" "$m" "$c" >> "$scratch/plan"
done < "$scratch/map"
if [ -f "$pkg_root/hooks/uninstall" ]; then
  cp -p "$pkg_root/hooks/uninstall" "$stage/.uninstall" || rollback "cannot stage hooks/uninstall"
fi

: > "$scratch/stale"
if [ "$have_record" -eq 1 ]; then
  awk '$1 == "file" { print $4 }' "$state_file" | while IFS= read -r _p; do
    grep -Fqx "$_p" "$scratch/newpaths" && continue
    printf '%s\n' "$_p"
  done > "$scratch/stale"
fi
: > "$scratch/stale_remove"
: > "$scratch/stale_keep"
while IFS= read -r _p; do
  _t=$ws_root/$_p
  [ -e "$_t" ] || continue
  if [ -d "$_t" ] || [ ! -f "$_t" ]; then
    printf '%s\n' "$_p" >> "$scratch/stale_keep"
    continue
  fi
  _om=$(record_field "$_p" 2)
  _oc=$(record_field "$_p" 3)
  _cm=$(mode_of "$_t")
  _cc=$(cksum_of "$_t")
  if [ "$_cm" = "$_om" ] && [ "$_cc" = "$_oc" ]; then
    printf '%s\n' "$_p" >> "$scratch/stale_remove"
  else
    printf '%s\n' "$_p" >> "$scratch/stale_keep"
  fi
done < "$scratch/stale"

: > "$scratch/laws"
while read -r mname_o mname; do
  if grep -Fqx "modules/$mname_o/laws" "$scratch/files" 2>/dev/null; then
    printf '.contexture/extensions/modules/%s/laws\n' "$mname" >> "$scratch/laws"
  fi
done < "$scratch/inames"
while IFS=' ' read -r ptype ppath; do
  [ "$ptype" = laws ] || continue
  awk -F '\t' -v p="$ppath" '$1 == p || index($1, p "/") == 1 { print ".contexture/extensions/" $2 }' "$scratch/map" >> "$scratch/laws"
done < "$scratch/parts"
LC_ALL=C sort -u "$scratch/laws" -o "$scratch/laws"

added=0
updated=0
while read -r rel _m _c; do
  if record_has ".contexture/extensions/$rel"; then
    updated=$((updated + 1))
  else
    added=$((added + 1))
  fi
done < "$scratch/plan"
stale_removed=$(grep -c . "$scratch/stale_remove" 2>/dev/null || true)
stale_kept=$(grep -c . "$scratch/stale_keep" 2>/dev/null || true)
[ -n "$stale_removed" ] || stale_removed=0
[ -n "$stale_kept" ] || stale_kept=0

mkdir -p "$stage/.backup"
: > "$scratch/moved"
: > "$scratch/removed"
while read -r rel _m _c; do
  t=$ext_root/$rel
  make_dir "$(dirname "$t")" || rollback "cannot create the directory for $rel"
  if [ -e "$t" ]; then
    mkdir -p "$stage/.backup/.contexture/extensions/$(dirname "$rel")" || rollback "cannot back up $rel"
    cp -p "$t" "$stage/.backup/.contexture/extensions/$rel" || rollback "cannot back up $rel"
  fi
  mv -f "$stage/$rel" "$t" || rollback "cannot install $rel"
  printf '%s\n' "$t" >> "$scratch/moved"
done < "$scratch/plan"
while IFS= read -r _p; do
  _t=$ws_root/$_p
  mkdir -p "$stage/.backup/$(dirname "$_p")" || rollback "cannot back up $_p"
  cp -p "$_t" "$stage/.backup/$_p" || rollback "cannot back up $_p"
  rm -f "$_t" || rollback "cannot remove the stale file $_p"
  printf '%s\n' "$_t" >> "$scratch/removed"
done < "$scratch/stale_remove"

if [ "$have_record" -eq 1 ]; then
  cp -p "$state_file" "$stage/.backup/.record" || rollback "cannot back up the install record"
fi
record_phase=1
{
  printf 'package %s\n' "$pkg_name"
  printf 'version %s\n' "$pkg_version"
  printf 'kind %s\n' "$pkg_kind"
  [ -n "$pkg_driver" ] && printf 'driver %s\n' "$pkg_driver"
  [ -n "$pkg_format" ] && printf 'format %s\n' "$pkg_format"
  while read -r mname_o mname; do
    printf 'module %s %s\n' "$mname" "$mname_o"
  done < "$scratch/inames"
  while read -r rel _m _c; do
    printf 'file %s %s .contexture/extensions/%s\n' "$_m" "$_c" "$rel"
  done < "$scratch/plan"
  while IFS= read -r _p; do
    awk -v p="$_p" '$1 == "file" && $4 == p { print; exit }' "$state_file"
  done < "$scratch/stale_keep"
  while IFS= read -r _law; do
    printf 'law %s\n' "$_law"
  done < "$scratch/laws"
  while IFS= read -r _p; do
    awk -v p="$_p" '$1 == "law" && $2 == p { print; exit }' "$state_file"
  done < "$scratch/stale_keep"
} > "$stage/.record" || rollback "cannot write the install record"
mv -f "$stage/.record" "$state_file" || rollback "cannot write the install record"
if [ -f "$stash_uninstall" ]; then
  cp -p "$stash_uninstall" "$stage/.backup/.uninstall" || rollback "cannot back up the uninstall hook"
fi
uninstall_phase=1
if [ -f "$stage/.uninstall" ]; then
  mv -f "$stage/.uninstall" "$stash_uninstall" || rollback "cannot stash the uninstall hook"
elif [ -e "$stash_uninstall" ]; then
  rm -f "$stash_uninstall" || rollback "cannot remove the dropped uninstall hook"
fi
# the returning modules take their kept data back: each kept declaration leaves the record
# area now that the module's own data file declares the namespace, restored by a rollback
: > "$scratch/kept_back"
if [ -s "$scratch/kept_return" ]; then
  mkdir -p "$stage/.backup/.kept" || rollback "cannot take back the kept data"
  while read -r _km _kn; do
    mv "$kept_root/$_kn" "$stage/.backup/.kept/$_kn" || rollback "cannot take back the kept data of '$_kn'"
    printf '%s\n' "$_kn" >> "$scratch/kept_back"
  done < "$scratch/kept_return"
  rmdir "$kept_root" 2>/dev/null
fi
if [ "$pkg_kind" = driver ]; then
  driver_post
fi
rm -rf "$stage"

# prune the folders the stale removals emptied (bottom-up), stopping at the extension
# root: a later re-install of a dropped module must not collide with its empty folders,
# while a preserved file or any content outside the package keeps its folder
: > "$scratch/prune"
while IFS= read -r _p; do
  printf '%s\n' "$(dirname "$ws_root/$_p")" >> "$scratch/prune"
done < "$scratch/stale_remove"
if [ -s "$scratch/prune" ]; then
  LC_ALL=C sort -ru "$scratch/prune" | while IFS= read -r _d; do
    _dd=$_d
    while [ -n "$_dd" ] && [ "$_dd" != "/" ] && [ "$_dd" != "$ext_root" ] && [ "$_dd" != "$state_root" ]; do
      rmdir "$_dd" 2>/dev/null || break
      _dd=$(dirname "$_dd")
    done
  done
fi

while IFS= read -r _p; do
  printf 'package-install: preserved %s (changed since install; still recorded)\n' "$_p"
done < "$scratch/stale_keep"

if [ "$pkg_kind" = driver ]; then
  driver_past
fi

while read -r mname_o mname; do
  hook=$ext_root/modules/$mname/install
  [ -f "$hook" ] || continue
  ( cd "$ws_root" && CTX_ROOT=$ws_root CTX_PACKAGE_ROOT=$pkg_root CTX_BIN=$ctx_bin CTX_PACKAGE_NAME=$pkg_name CTX_PACKAGE_VERSION=$pkg_version LC_ALL=C export CTX_ROOT CTX_PACKAGE_ROOT CTX_BIN CTX_PACKAGE_NAME CTX_PACKAGE_VERSION LC_ALL && exec sh "$hook" < /dev/null )
  _hr=$?
  [ "$_hr" -eq 0 ] || die 2 "the '$mname' module's install hook failed (rc $_hr); the overlay and its record are in place"
done < "$scratch/inames"

if [ -f "$pkg_root/hooks/install" ]; then
  ( cd "$ws_root" && CTX_ROOT=$ws_root CTX_PACKAGE_ROOT=$pkg_root CTX_BIN=$ctx_bin CTX_PACKAGE_NAME=$pkg_name CTX_PACKAGE_VERSION=$pkg_version LC_ALL=C export CTX_ROOT CTX_PACKAGE_ROOT CTX_BIN CTX_PACKAGE_NAME CTX_PACKAGE_VERSION LC_ALL && if [ -x "$pkg_root/hooks/install" ]; then exec "$pkg_root/hooks/install" < /dev/null; else exec sh "$pkg_root/hooks/install" < /dev/null; fi )
  _hr=$?
  [ "$_hr" -eq 0 ] || die 2 "the '$pkg_name' package's install hook failed (rc $_hr); the overlay and its record are in place"
fi

# the law layer: every package version and law fragment feeds the generated layer's
# sources hash, so recompose through ctx compose after the record lands and the hooks
# run; a boot then reads the set this install just changed.
"$ctx_bin" compose || die 2 "the law layer did not recompose; run .contexture/ctx compose and fix what it names (the overlay and its record are in place)"

while read -r _km _kn; do
  if [ "$_km" = "$_kn" ]; then
    printf 'package-install: took back the kept data of %s\n' "$_kn"
  else
    printf 'package-install: took back the kept data of %s (module %s under its kept name)\n' "$_kn" "$_km"
  fi
done < "$scratch/kept_return"
dl_said=""
case "$dl_mode" in
  in|upgrade) dl_said="; the record reads from the '$pkg_driver' driver" ;;
  plain) dl_said="; the record reads as before" ;;
esac
printf 'package-install: installed %s (%s) into .contexture/extensions (%s files: %s added, %s updated; %s stale removed, %s preserved)%s\n' \
  "$pkg_name" "$pkg_summary" "$((added + updated))" "$added" "$updated" "$stale_removed" "$stale_kept" "$dl_said"
exit 0
