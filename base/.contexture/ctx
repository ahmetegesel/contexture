#!/bin/sh
# ctx: the workspace module engine: discovery, assembly, dispatch, run, hooks
# Zero-install: POSIX /bin/sh, awk, and core OS utilities only.
#
# Usage: ctx [help [--all]] | ctx run <cmd> [args...] | ctx compose [--check] |
#        ctx package install|uninstall|list|catalog|info [<package>] | ctx search "<query>" [flags] |
#        ctx <module> [args...]
# The help output is the contract surface; this header never prints.
#
# Maintainer note (off-path, never taught by help or top docs):
# discovery reads .contexture/modules/<name>/ and .contexture/extensions/modules/<name>/;
# the directory name is the module name. The workspace modules list first, then the
# extension modules; an extension name colliding with a workspace module, a builtin
# (unit, run, lane, rhythm, store), or a reserved name is warned and skipped, never a silent
# shadow (the package installer refuses the collision; the engine only reports it).
# The builtin set is read through is_builtin and the private reader ctx _builtin <name>
# (rc0 for a builtin, rc1 otherwise); the standard module folder is the manifest ("module"), the
# typed-block law fragment ("laws"), the store declaration ("data"), the
# optional part hooks ("install" and "uninstall"), scripts/, hooks/, and
# filters/. The manifest carries "# summary: <line>" (the engine's listing),
# "# version: <token>" (the installer's), and a "# description:" hash block
# last (the compose's preamble); a "# requires:" line is reserved and refused.
# The private reader ctx _module <file> validate|summary|version|description
# is the one module-file parser; ctx _package <file> validate|summary|version|kind|parts|driver|format|category|pitch|when|needs|tags|description
# is the one package-manifest parser (the package root's manifest: summary, version,
# kind feature|driver, the repeated part lines, a driver name and a storage format
# version for the driver kind, and optional category, pitch, when, needs, tags, and trailing description block;
# requires is reserved and refused); ctx _reserved <name> answers the engine's reserved set
# (rc0 reserved, rc1 not) for the package installer and the composer; ctx _builtin <name>
# answers the engine's builtin set (unit, run, lane, rhythm, store; rc0 builtin, rc1 not) for the
# package installer and the composer, so discovery, the builtins, and both readers agree;
# discovery validates every
# manifest and skips a malformed one with a warning. scripts/<verb> files are verbs named by file name,
# marked by their own "# summary:" header, with repeatable "# usage:" and
# "# help:" detail lines. A scripts file without a summary is private and
# ignored. A module file without a summary warns and skips; a scripts/
# directory without a module file warns and skips; a directory with neither
# (a filter-only or hook-only module) is legal, silent, and unlisted.
# Reserved names are the unit verb set plus refresh, run, hooks, compose, package, search, and the
# retired record verbs (append, amend, query, flip, drop, next, resolve, which print
# their replacement); the builtin unit, run, lane, rhythm, and store are allowed. A duplicate verb shadows: first file name
# wins with a warning. Help is engine-owned (no help script): ctx help,
# ctx help --all, ctx <module> help, ctx <module> help <verb>, and bare
# ctx <module> (module table, rc0). Dispatch validates the verb engine-side
# (unknown rc1, module help on stderr), chdirs to the workspace root, and
# execs scripts/<verb> with the remaining argv, exporting CTX_ROOT,
# CTX_MODULE_DIR, CTX_BIN, CTX_SCRATCH_ROOT (one per-verb scratch root under
# the drawer; a dead root is swept on the next dispatch), and LC_ALL=C. Hooks are files under
# modules/*/hooks/ declaring "# ctx-hook: <point>" and optionally
# "# ctx-hook-mode: block"; the engine runs them in module-name (LC_ALL=C)
# then file-name order. Filters live under modules/run/filters/ (scanned
# first) and modules/*/filters/ (name-sorted after); a later match warns as
# a shadow unless its header carries "# ctx-filter-priority: over". The
# built-in run owns the compaction selection body; runner notices read
# [ctx: ...]. The built-in compose execs the core's private composer
# (.contexture/laws/compose) before discovery, the built-in package group
# execs the private .contexture/package-install or package-uninstall, and the built-in
# search runs every module's search verb as a bounded child and groups the answers.

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$dir/.." && pwd)
modules_root="$dir/modules"
extension_modules_root="$dir/extensions/modules"
ctx_bin="$dir/ctx"
[ -f "$dir/config-lib" ] && . "$dir/config-lib"

ctx_err() {
  printf 'ctx: %s\n' "$*" >&2
}

# ---------------------------------------------------------------------------
# per-verb scratch: every dispatch names one root under the drawer and exports
# it as CTX_SCRATCH_ROOT; a verb's scratch lives inside it and the verb removes
# it on return. A root left by a SIGKILLed verb is swept by the next dispatch
# when the pid in its name is gone (kill -0).
verb_scratch() {
  vs_base="$root/.contexture/tmp"
  mkdir -p "$vs_base" 2>/dev/null || return 0
  for vs_d in "$vs_base"/verb.*; do
    [ -d "$vs_d" ] || continue
    vs_n=${vs_d##*/}
    vs_p=${vs_n#verb.}
    vs_p=${vs_p%%.*}
    case "$vs_p" in
      ""|*[!0-9]*) continue ;;
    esac
    kill -0 "$vs_p" 2>/dev/null || rm -rf "$vs_d" 2>/dev/null
  done
  CTX_SCRATCH_ROOT="$vs_base/verb.$$.$(date +%s 2>/dev/null || printf '%s' "$$")"
  export CTX_SCRATCH_ROOT
}

header_field() {
  # first value of a header line, trimmed of surrounding whitespace
  hf_prefix="# $2: "
  while IFS= read -r hf_line || [ -n "$hf_line" ]; do
    case "$hf_line" in
      "$hf_prefix"*)
        hf_value=${hf_line#"$hf_prefix"}
        hf_value=${hf_value#"${hf_value%%[![:space:]]*}"}
        hf_value=${hf_value%"${hf_value##*[![:space:]]}"}
        printf '%s\n' "$hf_value"
        return 0
        ;;
    esac
  done < "$1"
  return 0
}

header_values() {
  # every value of a header line, in file order, trimmed
  hv_prefix="# $2: "
  while IFS= read -r hv_line || [ -n "$hv_line" ]; do
    case "$hv_line" in
      "$hv_prefix"*)
        hv_value=${hv_line#"$hv_prefix"}
        hv_value=${hv_value#"${hv_value%%[![:space:]]*}"}
        hv_value=${hv_value%"${hv_value##*[![:space:]]}"}
        printf '%s\n' "$hv_value"
        ;;
    esac
  done < "$1"
}

# ---------------------------------------------------------------------------
# module-file: the standard folder's manifest reader. The grammar:
#   # summary: <one line>              required; the engine's listing
#   # version: <one token>             optional; the installer's
#   # description:                     optional; the compose's preamble
#   # <text>                           the description body, to the end of the file
#   # requires: ...                    reserved; refused
# A bare # line before the description is a comment; any other "# <key>:"
# line is an unknown field and refuses. The description block runs to EOF and
# takes only "#" and "# <text>" lines, so it must stand last. ctx _module
# answers validate, summary, version, and description for the compose and the
# installer; discovery calls the same parser on every module file.

module_file_parse() {
  mf_file=$1
  mf_summary=""
  mf_version=""
  mf_desc=""
  mf_seen_summary=0
  mf_seen_version=0
  mf_seen_desc=0
  mf_lineno=0
  MF_ERROR=""
  mf_cr=$(printf '\r')
  if [ ! -f "$mf_file" ]; then
    MF_ERROR="no module file at $mf_file"
    return 1
  fi
  while IFS= read -r mf_line || [ -n "$mf_line" ]; do
    mf_lineno=$((mf_lineno + 1))
    mf_line=${mf_line%"$mf_cr"}
    if [ "$mf_seen_desc" -eq 1 ]; then
      case "$mf_line" in
        '#') mf_desc="$mf_desc
" ;;
        '# '*) mf_desc="$mf_desc${mf_line#'# '}
" ;;
        *) MF_ERROR="line $mf_lineno: the description block takes only # lines to the end of the file"
           return 1 ;;
      esac
      continue
    fi
    case "$mf_line" in
      ''|[[:space:]]*)
        continue
        ;;
      '# summary: '*)
        [ "$mf_seen_summary" -eq 0 ] || { MF_ERROR="line $mf_lineno: duplicate # summary:"; return 1; }
        mf_summary=${mf_line#'# summary: '}
        mf_summary=${mf_summary#"${mf_summary%%[![:space:]]*}"}
        mf_summary=${mf_summary%"${mf_summary##*[![:space:]]}"}
        [ -n "$mf_summary" ] || { MF_ERROR="line $mf_lineno: the summary is empty"; return 1; }
        mf_seen_summary=1
        ;;
      '# summary:')
        MF_ERROR="line $mf_lineno: the summary is empty"
        return 1
        ;;
      '# version: '*)
        [ "$mf_seen_version" -eq 0 ] || { MF_ERROR="line $mf_lineno: duplicate # version:"; return 1; }
        mf_version=${mf_line#'# version: '}
        mf_version=${mf_version#"${mf_version%%[![:space:]]*}"}
        mf_version=${mf_version%"${mf_version##*[![:space:]]}"}
        case "$mf_version" in
          ''|*[!A-Za-z0-9._+-]*)
            MF_ERROR="line $mf_lineno: malformed version '$mf_version' (one token of letters, digits, dot, underscore, plus, or hyphen)"
            return 1
            ;;
        esac
        mf_seen_version=1
        ;;
      '# version:')
        MF_ERROR="line $mf_lineno: the version is empty"
        return 1
        ;;
      '# requires:'*)
        MF_ERROR="line $mf_lineno: requires is reserved and refused"
        return 1
        ;;
      '# description:')
        [ "$mf_seen_desc" -eq 0 ] || { MF_ERROR="line $mf_lineno: duplicate # description:"; return 1; }
        mf_seen_desc=1
        ;;
      '# description: '*)
        MF_ERROR="line $mf_lineno: the description marker carries no value"
        return 1
        ;;
      '# summary:'*|'# version:'*|'# requires:'*|'# description:'*)
        MF_ERROR="line $mf_lineno: malformed field line (expected '# <field>: <value>')"
        return 1
        ;;
      '# '*)
        mf_key=${mf_line#'# '}
        case "$mf_key" in
          [A-Za-z]*:*)
            mf_key=${mf_key%%:*}
            case "$mf_key" in
              *[!A-Za-z0-9_-]*) ;;
              *) MF_ERROR="line $mf_lineno: unknown field '$mf_key'"; return 1 ;;
            esac
            ;;
        esac
        ;;
      '#')
        continue
        ;;
      *)
        MF_ERROR="line $mf_lineno: not a # header line"
        return 1
        ;;
    esac
  done < "$mf_file"
  [ "$mf_seen_summary" -eq 1 ] || { MF_ERROR="the module file carries no # summary: line"; return 1; }
  return 0
}

module_reader() {
  if [ $# -ne 2 ]; then
    ctx_err "_module: usage: ctx _module <file> validate|summary|version|description"
    exit 1
  fi
  if ! module_file_parse "$1"; then
    printf 'module-file: error: %s\n' "$MF_ERROR" >&2
    exit 1
  fi
  case "$2" in
    validate) exit 0 ;;
    summary) printf '%s\n' "$mf_summary" ;;
    version) printf '%s\n' "$mf_version" ;;
    description) printf '%s' "$mf_desc" ;;
    *) ctx_err "_module: unknown field: $2"; exit 1 ;;
  esac
  exit 0
}

# ---------------------------------------------------------------------------
# package-file: the package root's manifest reader. The grammar:
#   # summary: <one line>              required; the package's one-line description
#   # version: <one token>             required; the package version (install, upgrade)
#   # kind: feature|driver             required; the two package kinds
#   # part: <type> <path>              repeatable; at least one
#   # driver: <name>                   required exactly when kind is driver
#   # format: <positive whole number>  required exactly when kind is driver; the storage format version
#   # category: <token>               optional; lowercase slug [a-z][a-z0-9-]*
#   # pitch: <one line>                optional; adopter-facing value pitch
#   # when: <one line>                 optional; when to install
#   # needs: <one line>                optional; host prerequisites summary
#   # tags: <tok> [<tok>...]           optional; space-separated lowercase tags [a-z0-9][a-z0-9-]*
#   # description:                     optional; multi-line # block, MUST stand last
#   # requires: ...                    reserved; refused
# The part types are module, driver, laws, rhythms, hooks, and filters; a part path
# is relative to the package's .contexture/extensions tree (the install path). A
# module part is one folder under modules/, a driver part is storage/drivers/<name>,
# and a rhythms part is under rhythms/. A bare # line is a comment; any other
# "# <key>:" line is an unknown field and refuses. ctx _package answers validate,
# summary, version, kind, parts, driver, format, category, pitch, when, needs, tags,
# and description.

package_file_parse() {
  pf_file=$1
  pf_summary=""
  pf_version=""
  pf_kind=""
  pf_driver=""
  pf_format=""
  pf_format_line=0
  pf_parts=""
  pf_category=""
  pf_pitch=""
  pf_when=""
  pf_needs=""
  pf_tags=""
  pf_desc=""
  pf_seen_summary=0
  pf_seen_version=0
  pf_seen_kind=0
  pf_seen_driver=0
  pf_seen_category=0
  pf_seen_pitch=0
  pf_seen_when=0
  pf_seen_needs=0
  pf_seen_tags=0
  pf_seen_desc=0
  pf_part_count=0
  PF_ERROR=""
  pf_lineno=0
  pf_cr=$(printf '\r')
  if [ ! -f "$pf_file" ]; then
    PF_ERROR="no package manifest at $pf_file"
    return 1
  fi
  while IFS= read -r pf_line || [ -n "$pf_line" ]; do
    pf_lineno=$((pf_lineno + 1))
    pf_line=${pf_line%"$pf_cr"}
    if [ "$pf_seen_desc" -eq 1 ]; then
      case "$pf_line" in
        '#') pf_desc="$pf_desc
" ;;
        '# '*) pf_desc="$pf_desc${pf_line#'# '}
" ;;
        *) PF_ERROR="line $pf_lineno: the description block takes only # lines to the end of the file"
           return 1 ;;
      esac
      continue
    fi
    case "$pf_line" in
      ''|[[:space:]]*)
        continue
        ;;
      '# summary: '*)
        [ "$pf_seen_summary" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # summary:"; return 1; }
        pf_summary=${pf_line#'# summary: '}
        pf_summary=$(printf '%s' "$pf_summary" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$pf_summary" ] || { PF_ERROR="line $pf_lineno: the summary is empty"; return 1; }
        pf_seen_summary=1
        ;;
      '# summary:')
        PF_ERROR="line $pf_lineno: the summary is empty"
        return 1
        ;;
      '# version: '*)
        [ "$pf_seen_version" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # version:"; return 1; }
        pf_version=${pf_line#'# version: '}
        pf_version=$(printf '%s' "$pf_version" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$pf_version" in
          ''|*[!A-Za-z0-9._+-]*)
            PF_ERROR="line $pf_lineno: malformed version '$pf_version' (one token of letters, digits, dot, underscore, plus, or hyphen)"
            return 1
            ;;
        esac
        pf_seen_version=1
        ;;
      '# version:')
        PF_ERROR="line $pf_lineno: the version is empty"
        return 1
        ;;
      '# kind: '*)
        [ "$pf_seen_kind" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # kind:"; return 1; }
        pf_kind=${pf_line#'# kind: '}
        pf_kind=$(printf '%s' "$pf_kind" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$pf_kind" in
          feature|driver) ;;
          *) PF_ERROR="line $pf_lineno: kind '$pf_kind' is not feature or driver"; return 1 ;;
        esac
        pf_seen_kind=1
        ;;
      '# kind:')
        PF_ERROR="line $pf_lineno: the kind is empty"
        return 1
        ;;
      '# part: '*)
        pf_rest=${pf_line#'# part: '}
        case "$pf_rest" in
          *' '*) pf_ptype=${pf_rest%% *}; pf_ppath=${pf_rest#* } ;;
          *) PF_ERROR="line $pf_lineno: a part line takes <type> <path>"; return 1 ;;
        esac
        case "$pf_ppath" in
          *' '*) PF_ERROR="line $pf_lineno: a part path is one token"; return 1 ;;
        esac
        case "$pf_ptype" in
          module|driver|laws|rhythms|hooks|filters) ;;
          *) PF_ERROR="line $pf_lineno: unknown part type '$pf_ptype'"; return 1 ;;
        esac
        case "$pf_ppath" in
          ""|/*) PF_ERROR="line $pf_lineno: a part path is relative to .contexture/extensions"; return 1 ;;
        esac
        case "$pf_ppath" in
          *[!A-Za-z0-9._/-]*) PF_ERROR="line $pf_lineno: malformed part path '$pf_ppath'"; return 1 ;;
        esac
        case "/$pf_ppath/" in
          */../*|*/./*) PF_ERROR="line $pf_lineno: a part path holds no . or .. segment"; return 1 ;;
        esac
        case "$pf_ppath" in
          */|*//*) PF_ERROR="line $pf_lineno: a part path holds no empty segment"; return 1 ;;
        esac
        case "$pf_ptype" in
          module)
            case "$pf_ppath" in
              modules/*/*) PF_ERROR="line $pf_lineno: a module part is one folder under modules/"; return 1 ;;
              modules/*) ;;
              *) PF_ERROR="line $pf_lineno: a module part is modules/<name>"; return 1 ;;
            esac
            ;;
          driver)
            case "$pf_ppath" in
              storage/drivers/*/*) PF_ERROR="line $pf_lineno: a driver part is one folder under storage/drivers/"; return 1 ;;
              storage/drivers/*) ;;
              *) PF_ERROR="line $pf_lineno: a driver part is storage/drivers/<name>"; return 1 ;;
            esac
            ;;
          rhythms)
            case "$pf_ppath" in
              rhythms|rhythms/*) ;;
              *) PF_ERROR="line $pf_lineno: a rhythms part is under rhythms/"; return 1 ;;
            esac
            ;;
        esac
        if printf '%s\n' "$pf_parts" | awk -v p="$pf_ppath" '$2 == p { found = 1 } END { exit(found ? 0 : 1) }'; then
          PF_ERROR="line $pf_lineno: duplicate part path '$pf_ppath'"
          return 1
        fi
        pf_parts="$pf_parts$pf_ptype $pf_ppath
"
        pf_part_count=$((pf_part_count + 1))
        ;;
      '# part:')
        PF_ERROR="line $pf_lineno: a part line takes <type> <path>"
        return 1
        ;;
      '# driver: '*)
        [ "$pf_seen_driver" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # driver:"; return 1; }
        pf_driver=${pf_line#'# driver: '}
        pf_driver=$(printf '%s' "$pf_driver" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$pf_driver" in
          ''|.*|*[!A-Za-z0-9._-]*)
            PF_ERROR="line $pf_lineno: malformed driver name '$pf_driver' (letters, digits, dot, underscore, hyphen; not starting with a dot)"
            return 1
            ;;
        esac
        pf_seen_driver=1
        ;;
      '# driver:')
        PF_ERROR="line $pf_lineno: the driver name is empty"
        return 1
        ;;
      '# format: '*)
        [ "$pf_format_line" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # format:"; return 1; }
        pf_format=${pf_line#'# format: '}
        pf_format=$(printf '%s' "$pf_format" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$pf_format" in
          '') PF_ERROR="line $pf_lineno: the format is empty"; return 1 ;;
          *[!0-9]*|0*[1-9]*) PF_ERROR="line $pf_lineno: malformed format '$pf_format' (a positive whole number)"; return 1 ;;
          0*) PF_ERROR="line $pf_lineno: the format is zero (a positive whole number)"; return 1 ;;
        esac
        pf_format_line=$pf_lineno
        ;;
      '# format:')
        PF_ERROR="line $pf_lineno: the format is empty"
        return 1
        ;;
      '# category: '*)
        [ "$pf_seen_category" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # category:"; return 1; }
        pf_category=${pf_line#'# category: '}
        pf_category=$(printf '%s' "$pf_category" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$pf_category" in
          ''|[!a-z]*|*[!a-z0-9-]*)
            PF_ERROR="line $pf_lineno: malformed category '$pf_category' (lowercase letters, digits, and hyphens, starting with a letter)"
            return 1
            ;;
        esac
        pf_seen_category=1
        ;;
      '# category:')
        PF_ERROR="line $pf_lineno: the category is empty"
        return 1
        ;;
      '# pitch: '*)
        [ "$pf_seen_pitch" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # pitch:"; return 1; }
        pf_pitch=${pf_line#'# pitch: '}
        pf_pitch=$(printf '%s' "$pf_pitch" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$pf_pitch" ] || { PF_ERROR="line $pf_lineno: the pitch is empty"; return 1; }
        pf_seen_pitch=1
        ;;
      '# pitch:')
        PF_ERROR="line $pf_lineno: the pitch is empty"
        return 1
        ;;
      '# when: '*)
        [ "$pf_seen_when" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # when:"; return 1; }
        pf_when=${pf_line#'# when: '}
        pf_when=$(printf '%s' "$pf_when" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$pf_when" ] || { PF_ERROR="line $pf_lineno: the when field is empty"; return 1; }
        pf_seen_when=1
        ;;
      '# when:')
        PF_ERROR="line $pf_lineno: the when field is empty"
        return 1
        ;;
      '# needs: '*)
        [ "$pf_seen_needs" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # needs:"; return 1; }
        pf_needs=${pf_line#'# needs: '}
        pf_needs=$(printf '%s' "$pf_needs" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$pf_needs" ] || { PF_ERROR="line $pf_lineno: the needs field is empty"; return 1; }
        pf_seen_needs=1
        ;;
      '# needs:')
        PF_ERROR="line $pf_lineno: the needs field is empty"
        return 1
        ;;
      '# tags: '*)
        [ "$pf_seen_tags" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # tags:"; return 1; }
        pf_tags_raw=${pf_line#'# tags: '}
        pf_tags_raw=$(printf '%s' "$pf_tags_raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ -n "$pf_tags_raw" ] || { PF_ERROR="line $pf_lineno: the tags field is empty"; return 1; }
        case "$pf_tags_raw" in
          *[!a-z0-9\	\ -]*)
            PF_ERROR="line $pf_lineno: malformed tags (lowercase letters, digits, and hyphens, space-separated)"
            return 1
            ;;
        esac
        pf_tags=""
        for pf_t in $pf_tags_raw; do
          case "$pf_t" in
            ''|[!a-z0-9]*)
              PF_ERROR="line $pf_lineno: malformed tag '$pf_t' (lowercase letters, digits, and hyphens, starting with a letter or digit)"
              return 1
              ;;
          esac
          case " $pf_tags " in
            *" $pf_t "*)
              PF_ERROR="line $pf_lineno: duplicate tag '$pf_t'"
              return 1
              ;;
          esac
          pf_tags="${pf_tags:+$pf_tags }$pf_t"
        done
        [ -n "$pf_tags" ] || { PF_ERROR="line $pf_lineno: the tags field is empty"; return 1; }
        pf_seen_tags=1
        ;;
      '# tags:')
        PF_ERROR="line $pf_lineno: the tags field is empty"
        return 1
        ;;
      '# description:')
        [ "$pf_seen_desc" -eq 0 ] || { PF_ERROR="line $pf_lineno: duplicate # description:"; return 1; }
        pf_seen_desc=1
        ;;
      '# description: '*)
        PF_ERROR="line $pf_lineno: the description marker carries no value"
        return 1
        ;;
      '# requires:'*)
        PF_ERROR="line $pf_lineno: requires is reserved and refused"
        return 1
        ;;
      '# summary:'*|'# version:'*|'# kind:'*|'# part:'*|'# driver:'*|'# format:'*|'# category:'*|'# pitch:'*|'# when:'*|'# needs:'*|'# tags:'*|'# description:'*)
        PF_ERROR="line $pf_lineno: malformed field line (expected '# <field>: <value>')"
        return 1
        ;;
      '# '*)
        pf_key=${pf_line#'# '}
        case "$pf_key" in
          [A-Za-z]*:*)
            pf_key=${pf_key%%:*}
            case "$pf_key" in
              *[!A-Za-z0-9_-]*) ;;
              *) PF_ERROR="line $pf_lineno: unknown field '$pf_key'"; return 1 ;;
            esac
            ;;
        esac
        ;;
      '#')
        continue
        ;;
      *)
        PF_ERROR="line $pf_lineno: not a # header line"
        return 1
        ;;
    esac
  done < "$pf_file"
  [ "$pf_seen_summary" -eq 1 ] || { PF_ERROR="the package manifest carries no # summary: line"; return 1; }
  [ "$pf_seen_version" -eq 1 ] || { PF_ERROR="the package manifest carries no # version: line"; return 1; }
  [ "$pf_seen_kind" -eq 1 ] || { PF_ERROR="the package manifest carries no # kind: line"; return 1; }
  [ "$pf_part_count" -ge 1 ] || { PF_ERROR="the package manifest declares no # part: line"; return 1; }
  if [ "$pf_kind" = driver ]; then
    [ "$pf_seen_driver" -eq 1 ] || { PF_ERROR="a driver package carries no # driver: line"; return 1; }
    [ "$pf_format_line" -gt 0 ] || { PF_ERROR="a driver package carries no # format: line"; return 1; }
    pf_dcount=$(printf '%s\n' "$pf_parts" | awk '$1 == "driver" { n++ } END { print n + 0 }')
    [ "$pf_dcount" -eq 1 ] || { PF_ERROR="a driver package declares exactly one driver part"; return 1; }
    pf_dpath=$(printf '%s\n' "$pf_parts" | awk '$1 == "driver" { print $2; exit }')
    [ "$pf_dpath" = "storage/drivers/$pf_driver" ] || { PF_ERROR="the driver part is storage/drivers/$pf_driver"; return 1; }
  else
    [ "$pf_seen_driver" -eq 0 ] || { PF_ERROR="a feature package carries no # driver: line"; return 1; }
    [ "$pf_format_line" -eq 0 ] || { PF_ERROR="line $pf_format_line: a feature package carries no # format: line"; return 1; }
    pf_dcount=$(printf '%s\n' "$pf_parts" | awk '$1 == "driver" { n++ } END { print n + 0 }')
    [ "$pf_dcount" -eq 0 ] || { PF_ERROR="a feature package carries no driver part"; return 1; }
  fi
  return 0
}

package_reader() {
  if [ $# -ne 2 ]; then
    ctx_err "_package: usage: ctx _package <file> validate|summary|version|kind|parts|driver|format|category|pitch|when|needs|tags|description"
    exit 1
  fi
  if ! package_file_parse "$1"; then
    printf 'package-file: error: %s\n' "$PF_ERROR" >&2
    exit 1
  fi
  case "$2" in
    validate) exit 0 ;;
    summary) printf '%s\n' "$pf_summary" ;;
    version) printf '%s\n' "$pf_version" ;;
    kind) printf '%s\n' "$pf_kind" ;;
    driver) printf '%s\n' "$pf_driver" ;;
    format) printf '%s\n' "$pf_format" ;;
    parts) printf '%s' "$pf_parts" ;;
    category) printf '%s\n' "$pf_category" ;;
    pitch) printf '%s\n' "$pf_pitch" ;;
    when) printf '%s\n' "$pf_when" ;;
    needs) printf '%s\n' "$pf_needs" ;;
    tags) printf '%s\n' "$pf_tags" ;;
    description) printf '%s' "$pf_desc" ;;
    *) ctx_err "_package: unknown field: $2"; exit 1 ;;
  esac
  exit 0
}

# ---------------------------------------------------------------------------
# reserved names: the unit verb set (its scripts own the list) plus
# refresh, run, hooks, compose, and package, and the retired record verbs (append, amend, query,
# flip, drop, next, resolve: a static list, so no module can claim a retired name and a
# retired call prints its replacement); the builtin unit, run, lane, rhythm, and store are allowed
# (read through is_builtin, never a literal set at the sites)

# retired_replacement <verb>: the replacement of a retired record verb
retired_replacement() {
  case "$1" in
    append) printf 'use record, task add, finding add' ;;
    amend) printf 'use task update' ;;
    query) printf 'use entry show, entry list, entry closure, finding show, get, search, list, refs-to, lane show' ;;
    flip) printf 'use task start, complete, reopen' ;;
    drop) printf 'use task drop' ;;
    next) printf 'use list (the next task is derived from the backlog)' ;;
    resolve) printf 'use get <unit>/<kind>/<id>, the path everything after unit# in an address' ;;
    *) return 1 ;;
  esac
}

# summary_files <scripts-dir>: extension-less, non-hidden script names carrying a
# "# summary: " header, one per line in glob order; private files are left out
summary_files() {
  sf_dir=$1
  [ -d "$sf_dir" ] || return 0
  set --
  for sf_f in "$sf_dir"/*; do
    [ -f "$sf_f" ] || continue
    sf_b=${sf_f##*/}
    case "$sf_b" in
      ""|.*|*[[:space:]]*) continue ;;
    esac
    set -- "$@" "$sf_f"
  done
  [ $# -gt 0 ] || return 0
  LC_ALL=C awk '
    function base(p,   n, a) { n = split(p, a, "/"); return a[n] }
    FNR == 1 {
      if (NR > 1 && ok) print prev
      prev = base(FILENAME)
      ok = 0
      seen_summary = 0
    }
    !seen_summary && /^# summary: / {
      seen_summary = 1
      v = $0
      sub(/^# summary: /, "", v)
      gsub(/^[[:space:]]+/, "", v)
      gsub(/[[:space:]]+$/, "", v)
      if (v != "") ok = 1
    }
    END { if (ok) print prev }
  ' "$@"
}

unit_verbs=""
unit_verbs_loaded=0

load_unit_verbs() {
  if [ "$unit_verbs_loaded" -eq 1 ]; then
    return 0
  fi
  unit_verbs_loaded=1
  verbs=""
  sd="$modules_root/unit/scripts"
  if [ -d "$sd" ]; then
    while IFS= read -r b; do
      [ -n "$b" ] || continue
      verbs="$verbs $b"
    done <<EOF
$(summary_files "$sd")
EOF
  fi
  unit_verbs="help${verbs}"
}

is_reserved() {
  case "$1" in
    refresh|run|hooks|compose|package|search|config|append|amend|query|flip|drop|next|resolve)
      return 0
      ;;
  esac
  case " $unit_verbs " in
    *" $1 "*)
      return 0
      ;;
  esac
  return 1
}

# is_builtin <name>: the shipped builtin modules, the one set discovery exempts
# from the reserved names and skips in the extension root; the private reader
# ctx _builtin (beside _reserved) answers it for the package installer and the
# composer, so no site carries the names as its own literal
is_builtin() {
  case "$1" in
    unit|run|lane|rhythm|store)
      return 0
      ;;
  esac
  return 1
}

# module_name_ok <name>: rc 0 for a module name of lowercase letters, digits, dot,
# underscore, and dash, starting with a letter or digit, the namespace token rule (a
# module's namespace is its name); every letter is spelled, since a range follows the
# caller's locale
module_name_rule="a module name is lowercase letters, digits, dot, underscore, and dash, starting with a letter or digit"
module_name_ok() {
  case "$1" in
    ""|[!abcdefghijklmnopqrstuvwxyz0123456789]*|*[!abcdefghijklmnopqrstuvwxyz0123456789._-]*) return 1 ;;
  esac
  return 0
}

# ---------------------------------------------------------------------------
# discovery

scan_module_dirs() {
  # every module candidate directory in discovery order: the workspace modules
  # (name-sorted), then the extension modules (name-sorted); reserved and
  # hidden names stay out silently (the listing path owns the warnings); an
  # extension name that collides with a workspace module or a builtin is
  # never scanned twice
  [ -d "$modules_root" ] || [ -d "$extension_modules_root" ] || return 0
  load_unit_verbs
  ws=""
  if [ -d "$modules_root" ]; then
    for d in "$modules_root"/*/; do
      [ -d "$d" ] || continue
      bn=${d%/}
      bn=${bn##*/}
      case "$bn" in
        ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin)
          continue
          ;;
      esac
      module_name_ok "$bn" || continue
      if is_reserved "$bn" && ! is_builtin "$bn"; then
        continue
      fi
      ws="$ws $bn"
    done
  fi
  ext=""
  if [ -d "$extension_modules_root" ]; then
    for d in "$extension_modules_root"/*/; do
      [ -d "$d" ] || continue
      bn=${d%/}
      bn=${bn##*/}
      case "$bn" in
        ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin)
          continue
          ;;
      esac
      module_name_ok "$bn" || continue
      case " $ws " in
        *" $bn "*) continue ;;
      esac
      is_builtin "$bn" && continue
      is_reserved "$bn" && continue
      ext="$ext $bn"
    done
  fi
  [ -z "$ws" ] || printf '%s\n' $ws | LC_ALL=C sort
  [ -z "$ext" ] || printf '%s\n' $ext | LC_ALL=C sort
}

module_names() {
  # listed modules in discovery order: the workspace modules first, then the
  # extension modules; a broken shape warns and skips; an extension module
  # colliding with a workspace module, a builtin, or a reserved name warns and
  # skips (the package installer refuses the collision; the engine never
  # shadows silently)
  [ -d "$modules_root" ] || [ -d "$extension_modules_root" ] || return 0
  load_unit_verbs
  ws=""
  ws_all=""
  if [ -d "$modules_root" ]; then
    for d in "$modules_root"/*/; do
      [ -d "$d" ] || continue
      n=${d%/}
      n=${n##*/}
      case "$n" in
        ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin)
          continue
          ;;
      esac
      if ! module_name_ok "$n"; then
        ctx_err "skipping module $n: $module_name_rule"
        continue
      fi
      if is_reserved "$n" && ! is_builtin "$n"; then
        ctx_err "reserved name refused (shadow): $n"
        continue
      fi
      # every workspace candidate holds the name, even a broken or unlisted one,
      # so an extension module can never take it and then resolve to this directory
      ws_all="$ws_all $n"
      if [ -f "$d/module" ]; then
        if [ -z "$(header_field "$d/module" summary)" ]; then
          ctx_err "skipping module $n: module file has no summary"
          continue
        fi
        if ! module_file_parse "$d/module"; then
          ctx_err "skipping module $n: $MF_ERROR"
          continue
        fi
      elif [ -d "$d/scripts" ]; then
        ctx_err "skipping module $n: scripts/ without a module file"
        continue
      else
        continue
      fi
      ws="$ws $n"
    done
  fi
  ext=""
  if [ -d "$extension_modules_root" ]; then
    for d in "$extension_modules_root"/*/; do
      [ -d "$d" ] || continue
      n=${d%/}
      n=${n##*/}
      case "$n" in
        ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin)
          continue
          ;;
      esac
      if ! module_name_ok "$n"; then
        ctx_err "skipping module $n: $module_name_rule"
        continue
      fi
      if is_builtin "$n"; then
        ctx_err "skipping extension module $n: collides with a builtin"
        continue
      fi
      case " $ws_all " in
        *" $n "*)
          ctx_err "skipping extension module $n: collides with a workspace module"
          continue
          ;;
      esac
      if is_reserved "$n"; then
        ctx_err "reserved name refused (shadow): $n"
        continue
      fi
      if [ -f "$d/module" ]; then
        if [ -z "$(header_field "$d/module" summary)" ]; then
          ctx_err "skipping module $n: module file has no summary"
          continue
        fi
        if ! module_file_parse "$d/module"; then
          ctx_err "skipping module $n: $MF_ERROR"
          continue
        fi
      elif [ -d "$d/scripts" ]; then
        ctx_err "skipping module $n: scripts/ without a module file"
        continue
      else
        continue
      fi
      ext="$ext $n"
    done
  fi
  [ -z "$ws" ] || printf '%s\n' $ws | LC_ALL=C sort
  [ -z "$ext" ] || printf '%s\n' $ext | LC_ALL=C sort
}

module_dir() {
  # the directory of a listed module: the workspace root shadows the extension
  # root, so a name in both resolves to the workspace module
  if [ -d "$modules_root/$1" ]; then
    printf '%s\n' "$modules_root/$1"
    return 0
  fi
  if [ -d "$extension_modules_root/$1" ]; then
    printf '%s\n' "$extension_modules_root/$1"
    return 0
  fi
  return 1
}

verb_names() {
  # a module's verbs: extension-less scripts carrying a "# summary:" header,
  # name-sorted (LC_ALL=C); private files are ignored; a duplicate verb
  # shadows with a warning and the first file name wins; help stays
  # engine-owned
  sd="$1/scripts"
  [ -d "$sd" ] || return 0
  raw=$(summary_files "$sd")
  [ -n "$raw" ] || return 0
  raw=$(printf '%s\n' $raw | LC_ALL=C sort)
  out=""
  seen=""
  for b in $raw; do
    case " $seen " in
      *" $b "*)
        ctx_err "duplicate verb shadowed: ${1##*/}: $b (first file name wins)"
        continue
        ;;
    esac
    if [ "$b" = "help" ]; then
      ctx_err "help is engine-owned; ignoring scripts/help in ${1##*/}"
      continue
    fi
    seen="$seen $b"
    out="$out $b"
  done
  [ -n "$out" ] || return 0
  printf '%s\n' ${out# }
}

module_summary() {
  header_field "$1/module" summary
}

verb_summary() {
  header_field "$1/scripts/$2" summary
}

verb_detail() {
  header_values "$1/scripts/$2" "$3"
}

verb_exists() {
  case "${1##*/}" in
    unit)
      case "$2" in
        help) return 1 ;;
      esac
      load_unit_verbs
      case " $unit_verbs " in
        *" $2 "*) return 0 ;;
      esac
      return 1
      ;;
  esac
  for v in $(verb_names "$1"); do
    if [ "$v" = "$2" ]; then
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# assembly: help is engine-owned

# module_alias_of <name>: "<original> <package>" when the module of that installed name was
# installed under an alias (an install record's module line), nothing otherwise; silent on an
# absent or unreadable record area, as the compose treats one; discovery never reads it
module_alias_of() {
  [ -d "$dir/extensions/.state" ] || return 0
  for mao_f in "$dir"/extensions/.state/*.files; do
    [ -f "$mao_f" ] && [ -r "$mao_f" ] || continue
    mao_o=$(awk -v n="$1" '$1 == "module" && NF == 3 && $2 == n && $3 != n { print $3; exit }' "$mao_f" 2>/dev/null)
    [ -n "$mao_o" ] || continue
    mao_p=$(awk '$1 == "package" { print $2; exit }' "$mao_f" 2>/dev/null)
    if [ -z "$mao_p" ]; then mao_p=${mao_f##*/}; mao_p=${mao_p%.files}; fi
    printf '%s %s\n' "$mao_o" "$mao_p"
    return 0
  done
  return 0
}

# module_alias_note <name>: " (alias of <original> from package <package>)" for an aliased
# module, nothing otherwise
module_alias_note() {
  set -- $(module_alias_of "$1")
  [ $# -eq 2 ] && printf ' (alias of %s from package %s)' "$1" "$2"
  return 0
}

show_top_help() {
  cat <<'EOF'
ctx: the workspace command binder

usage:
  ctx                              this summary
  ctx help [--all]                 this summary; --all also prints every module's help block
  ctx run <cmd> [args...]          run a command through stream compaction; the command's exit code is preserved
  cmd | ctx run                    pipe form: compact a stream
  ctx compose [--check]            compose the generated law layer, or verify it current; --check writes nothing
EOF
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$config_load_line" "$config_get_line" "$config_schema_line" \
    "$package_install_line" "$package_uninstall_line" "$package_list_line" "$package_catalog_line" "$package_info_line" "$search_line"
  cat <<'EOF'
  ctx <module> [args...]           dispatch to a module: arguments, streams, and exit code pass through
  ctx <module> help [<verb>]       the module's verb table; one verb's detail with <verb>
EOF
  printf '\nmodules:\n'
  mods=$(module_names)
  if [ -z "$mods" ]; then
    printf '  (none discovered)\n'
    return 0
  fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf '  %-10s %s%s\n' "$n" "$(module_summary "$(module_dir "$n")")" "$(module_alias_note "$n")"
  done <<EOF
$mods
EOF
  return 0
}

show_module_help() {
  m=$(module_dir "$1") || m="$modules_root/$1"
  printf 'ctx %s: %s%s\n\n' "$1" "$(module_summary "$m")" "$(module_alias_note "$1")"
  printf 'usage:\n'
  printf '  ctx %s <verb> [args...]\n' "$1"
  printf '  ctx %s help [<verb>]\n' "$1"
  verbs=$(verb_names "$m")
  printf '\nverbs:\n'
  if [ -z "$verbs" ]; then
    printf '  (none)\n'
    return 0
  fi
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    printf '  %-10s %s\n' "$v" "$(verb_summary "$m" "$v")"
  done <<EOF
$verbs
EOF
  printf '\ndetail: ctx %s help <verb>\n' "$1"
  return 0
}

show_verb_help() {
  m=$(module_dir "$1") || m="$modules_root/$1"
  printf 'ctx %s %s: %s\n' "$1" "$2" "$(verb_summary "$m" "$2")"
  usages=$(verb_detail "$m" "$2" usage)
  if [ -n "$usages" ]; then
    printf '\nusage:\n'
    printf '%s\n' "$usages" | while IFS= read -r l; do
      [ -n "$l" ] && printf '  %s\n' "$l"
    done
  fi
  helps=$(verb_detail "$m" "$2" help)
  if [ -n "$helps" ]; then
    printf '\nhelp:\n'
    printf '%s\n' "$helps" | while IFS= read -r l; do
      [ -n "$l" ] && printf '  %s\n' "$l"
    done
  fi
  return 0
}

show_module_help_blocks() {
  mods=$(module_names)
  [ -n "$mods" ] || return 0
  if ! cd "$root"; then
    ctx_err "cannot enter workspace root: $root"
    return 1
  fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf '\nmodule %s:\n' "$n"
    show_module_help "$n"
  done <<EOF
$mods
EOF
  return 0
}

# ---------------------------------------------------------------------------
# built-in run: the selection body (one home). Labels and usage always read
# ctx run; bracketed operational notices read [ctx: ...]. The
# COMPACT_DISABLE and COMPACT_DEBUG contracts are unchanged.
run_body() {
  set -e
  run_label="ctx run"
  run_usage_line="usage: ctx run [--filter=NAME] [--stats] [--diagnose] [cmd [args...]]"

  MODULES_DIR="$dir/modules"
  FILTERS_DIR="$MODULES_DIR/run/filters"

  if [ ! -d "$FILTERS_DIR" ]; then
    if [ -d "./.contexture/modules/run/filters" ]; then
      FILTERS_DIR="./.contexture/modules/run/filters"
    fi
  fi

  # Sanctioned scratch: workspace .contexture/tmp when writable, else TMPDIR.
  # Capture names are removed before the command runs (see Step 1).
  compact_tmpdir="${TMPDIR:-/tmp}"
  ctx_root_tmp="$root/.contexture/tmp"
  if [ -d "$root/.contexture" ] && mkdir -p "$ctx_root_tmp" 2>/dev/null && [ -d "$ctx_root_tmp" ] && [ -w "$ctx_root_tmp" ]; then
    compact_tmpdir="$ctx_root_tmp"
  fi

  diagnose_run() {
    printf 'ctx run: runner compaction diagnostics\n'
    printf '  workspace root:  %s\n' "$root"
    if [ -w "$compact_tmpdir" ]; then
      printf '  temp directory:  %s (writable)\n' "$compact_tmpdir"
      printf '  capture mode:    anonymous (names removed before the command)\n'
    else
      printf '  temp directory:  %s (not writable)\n' "$compact_tmpdir"
      printf '  capture mode:    anonymous (names removed before the command)\n'
    fi
    printf '  bypass config:   COMPACT_DISABLE=%s COMPACT_DEBUG=%s\n' "${COMPACT_DISABLE:-0}" "${COMPACT_DEBUG:-0}"
    bf=""
    if [ -d "$FILTERS_DIR" ]; then
      for f in "$FILTERS_DIR"/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        name=${name%.awk}
        bf="$bf $name"
      done
    fi
    printf '  builtin filters:%s\n' "${bf:- (none)}"
    mf_count=0
    for bn in $(filter_module_names); do
      fd=$(module_dir "$bn") || continue
      if [ -d "$fd/filters" ]; then
        wf=""
        for f in "$fd/filters"/*; do
          [ -f "$f" ] || continue
          name=$(basename "$f")
          name=${name%.awk}
          wf="$wf $name"
          mf_count=$((mf_count + 1))
        done
        printf '  module filters (%s):%s\n' "$bn" "$wf"
      fi
    done
    if [ "$mf_count" -eq 0 ]; then
      printf '  module filters:  (none)\n'
    fi
  }

  explicit_filter=""
  stats=0
  debug=0
  if [ "${COMPACT_DEBUG:-0}" = "1" ]; then
    debug=1
  fi

  # Emit the captured command stderr: whole on failure or empty stdout,
  # tail-capped with its own notice otherwise
  emit_stderr() {
    if [ -z "$stderr_input" ]; then
      return 0
    fi
    if [ "$cmd_status" -ne 0 ] || [ -z "$raw_input" ]; then
      printf "%s\n" "$stderr_input" >&2
      return 0
    fi
    stderr_lines=$(printf "%s\n" "$stderr_input" | wc -l | tr -d ' ')
    if [ "$stderr_lines" -le 10 ]; then
      printf "%s\n" "$stderr_input" >&2
    else
      printf "[ctx: stderr capped: showing the last 10 of %s lines; COMPACT_DISABLE=1 for the full stream]\n" "$stderr_lines" >&2
      printf "%s\n" "$stderr_input" | tail -n 10 >&2
    fi
  }

  # Read the first value of a filter header directive, trimmed of surrounding
  # whitespace so an invisible blank never silently disables it
  directive_value() {
    sed -n "s/^# $1: //p" "$2" | head -n 1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
  }

  # Module directories whose filters/ folders merge after the run module's own:
  # the workspace modules first (name-sorted, LC_ALL=C), then the extension
  # modules; whitespace names never form; an extension name colliding with a
  # workspace module or a builtin is skipped, never scanned twice
  filter_module_names() {
    [ -d "$modules_root" ] || [ -d "$extension_modules_root" ] || return 0
    load_unit_verbs
    ws=""
    if [ -d "$modules_root" ]; then
      for fd in "$modules_root"/*/; do
        [ -d "$fd" ] || continue
        bn=${fd%/}
        bn=${bn##*/}
        case "$bn" in
          ""|.*|*[[:space:]]*|run|_hooks|_module|_package|_reserved|_builtin)
            continue
            ;;
        esac
        if is_reserved "$bn"; then
          continue
        fi
        ws="$ws $bn"
      done
    fi
    ext=""
    if [ -d "$extension_modules_root" ]; then
      for fd in "$extension_modules_root"/*/; do
        [ -d "$fd" ] || continue
        bn=${fd%/}
        bn=${bn##*/}
        case "$bn" in
          ""|.*|*[[:space:]]*|_hooks|_module|_package|_reserved|_builtin)
            continue
            ;;
        esac
        case " $ws " in
          *" $bn "*) continue ;;
        esac
        is_builtin "$bn" && continue
        if is_reserved "$bn"; then
          continue
        fi
        ext="$ext $bn"
      done
    fi
    [ -z "$ws" ] || printf '%s\n' $ws | LC_ALL=C sort
    [ -z "$ext" ] || printf '%s\n' $ext | LC_ALL=C sort
    return 0
  }

  # The explicit --filter= name resolves over the run module first, then the
  # modules in name order: the same scan order as command and signature
  locate_filter() {
    if [ -d "$FILTERS_DIR" ]; then
      if [ -f "$FILTERS_DIR/$1.awk" ]; then
        printf '%s\n' "$FILTERS_DIR/$1.awk"
        return 0
      fi
      if [ -f "$FILTERS_DIR/$1" ]; then
        printf '%s\n' "$FILTERS_DIR/$1"
        return 0
      fi
    fi
    for bn in $(filter_module_names); do
      fd=$(module_dir "$bn") || continue
      if [ -f "$fd/filters/$1.awk" ]; then
        printf '%s\n' "$fd/filters/$1.awk"
        return 0
      fi
      if [ -f "$fd/filters/$1" ]; then
        printf '%s\n' "$fd/filters/$1"
        return 0
      fi
    done
    return 1
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf '%s\n' "$run_usage_line"
        printf 'env: COMPACT_DISABLE=1 bypasses compaction; COMPACT_DEBUG=1 reports the selection\n'
        exit 0
        ;;
      --diagnose)
        diagnose_run
        exit 0
        ;;
      --stats)
        stats=1
        shift
        ;;
      --filter=*)
        explicit_filter="${1#--filter=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        printf '%s: unrecognized option: %s\n' "$run_label" "$1" >&2
        exit 1
        ;;
      *)
        break
        ;;
    esac
  done

  # Explicit bypass: raw execution, command exit code intact
  if [ "${COMPACT_DISABLE:-0}" = "1" ]; then
    if [ "$debug" -eq 1 ]; then
      printf "[ctx: debug: bypassed (COMPACT_DISABLE=1)]\n" >&2
    fi
    if [ $# -gt 0 ]; then
      rc=0
      "$@" || rc=$?
      exit "$rc"
    fi
    cat
    exit 0
  fi

  # Step 1: Ingest input (from command execution or standard input)
  cmd_status=0
  stderr_input=""
  stdout_tmp=""
  stderr_tmp=""

  # The capture files live in the sanctioned scratch dir but their names are
  # removed before the command runs. The open handles keep them alive; with no
  # directory entry a recursive search cannot reach the command's own output.
  # The kernel reclaims the inode when the last handle closes, even after a
  # kill, so no cleanup trap is needed once the names are gone.
  cleanup_capture() {
    [ -z "$stdout_tmp" ] || rm -f "$stdout_tmp"
    [ -z "$stderr_tmp" ] || rm -f "$stderr_tmp"
  }

  if [ $# -gt 0 ]; then
    # Command wrapper mode: stdout and stderr captured separately, exit code kept
    trap cleanup_capture EXIT
    stdout_tmp=$(mktemp "$compact_tmpdir/compact-stdout.XXXXXX") || {
      printf '%s: cannot create a capture file in %s\n' "$run_label" "$compact_tmpdir" >&2
      exit 2
    }
    stderr_tmp=$(mktemp "$compact_tmpdir/compact-stderr.XXXXXX") || {
      printf '%s: cannot create a capture file in %s\n' "$run_label" "$compact_tmpdir" >&2
      exit 2
    }
    exec 3>"$stdout_tmp" 4<"$stdout_tmp" 5>"$stderr_tmp" 6<"$stderr_tmp"
    rm -f "$stdout_tmp" "$stderr_tmp"
    stdout_tmp=""
    stderr_tmp=""
    trap - EXIT
    rc=0
    ( exec 4<&- 6<&-; "$@" >&3 ) 2>&5 || rc=$?
    cmd_status=$rc
    exec 3>&- 5>&-
    raw_input=$(cat <&4)
    stderr_input=$(cat <&6)
    exec 4<&- 6<&-
  else
    # Stdin pipe mode
    raw_input=$(cat)
  fi

  # If both streams are empty, exit cleanly preserving command exit code
  if [ -z "$raw_input" ] && [ -z "$stderr_input" ]; then
    exit "$cmd_status"
  fi

  # Step 1b: Strip ANSI escape sequences before selection and filtering;
  # raw bytes stay untouched for the fail-safe comparison
  esc=$(printf '\033')
  clean_input="$raw_input"
  case "$raw_input" in
    *"$esc"*)
      clean_input=$(printf "%s\n" "$raw_input" | awk '{gsub(/\033\[[0-9;]*[a-zA-Z]/, ""); print}')
      ;;
  esac

  # Step 2: Discover and select filter
  selected_filter=""
  default_filter=""

  if [ -n "$explicit_filter" ]; then
    candidate=$(locate_filter "$explicit_filter") || candidate=""
    if [ -n "$candidate" ]; then
      selected_filter="$candidate"
    else
      printf '%s: filter not found: %s in %s\n' "$run_label" "$explicit_filter" "$FILTERS_DIR" >&2
      if [ -n "$raw_input" ]; then
        printf "%s\n" "$raw_input"
      fi
      emit_stderr
      exit "$cmd_status"
    fi
    if [ "$debug" -eq 1 ]; then
      printf "[ctx: debug: selected %s (explicit)]\n" "$(basename "$selected_filter")" >&2
    fi
  else
    # Runner mode selects by command identity first: the wrapped command line
    # is the signal, never the output sample
    if [ $# -gt 0 ]; then
      cmd_line=""
      cmd_first=1
      for arg in "$@"; do
        if [ "$cmd_first" -eq 1 ]; then
          arg=$(basename "$arg")
          cmd_first=0
        fi
        cmd_line="$cmd_line $arg"
      done
      cmd_line=${cmd_line# }

      if [ -d "$FILTERS_DIR" ]; then
        for f in "$FILTERS_DIR"/*.awk; do
          [ -f "$f" ] || continue
          pat=$(directive_value command "$f")
          [ -n "$pat" ] || continue
          if printf "%s\n" "$cmd_line" | COMPACT_PAT="$pat" awk '$0 ~ ENVIRON["COMPACT_PAT"] {found=1; exit} END{exit !found}' 2>/dev/null; then
            if [ -z "$selected_filter" ]; then
              selected_filter="$f"
              if [ "$debug" -eq 1 ]; then
                printf "[ctx: debug: selected %s (command match: %s)]\n" "$(basename "$f")" "$cmd_line" >&2
              fi
            else
              printf "[ctx: shadow warning: %s and %s both claim: %s]\n" "$(basename "$selected_filter")" "$(basename "$f")" "$cmd_line" >&2
            fi
          fi
        done
      fi

      # Module filters merge after the run module's own (name-sorted modules):
      # first match wins; a later module match warns as shadow unless its
      # header carries "# ctx-filter-priority: over", which replaces the
      # selection
      if [ -d "$modules_root" ] || [ -d "$extension_modules_root" ]; then
        for bn in $(filter_module_names); do
          fd=$(module_dir "$bn") || continue
          for f in "$fd/filters"/*.awk; do
            [ -f "$f" ] || continue
            pat=$(directive_value command "$f")
            [ -n "$pat" ] || continue
            if printf "%s\n" "$cmd_line" | COMPACT_PAT="$pat" awk '$0 ~ ENVIRON["COMPACT_PAT"] {found=1; exit} END{exit !found}' 2>/dev/null; then
              prio=$(directive_value ctx-filter-priority "$f")
              rel="$bn/$(basename "$f")"
              if [ "$prio" = "over" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (command match: %s, priority over)]\n" "$rel" "$cmd_line" >&2
                fi
              elif [ -z "$selected_filter" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (command match: %s)]\n" "$rel" "$cmd_line" >&2
                fi
              else
                printf "[ctx: shadow warning: %s and %s both claim: %s]\n" "$(basename "$selected_filter")" "$rel" "$cmd_line" >&2
              fi
            fi
          done
        done
      fi
    fi

    if [ -z "$selected_filter" ]; then
      # Zero-parameter auto-discovery: sample stream head and check signatures
      sample=$(printf "%s\n" "$clean_input" | sed 40q)

      if [ -d "$FILTERS_DIR" ]; then
        for f in "$FILTERS_DIR"/*.awk; do
          [ -f "$f" ] || continue
          pat=$(directive_value match "$f")
          if [ -n "$pat" ]; then
            if printf "%s\n" "$sample" | COMPACT_PAT="$pat" awk 'BEGIN{rc=1} $0 ~ ENVIRON["COMPACT_PAT"] {rc=0; exit} END{exit rc}' 2>/dev/null; then
              selected_filter="$f"
              if [ "$debug" -eq 1 ]; then
                printf "[ctx: debug: selected %s (signature match: %s)]\n" "$(basename "$f")" "$pat" >&2
                match_line=$(printf "%s\n" "$sample" | COMPACT_PAT="$pat" awk '$0 ~ ENVIRON["COMPACT_PAT"] {print; exit}' 2>/dev/null)
                if [ -n "$match_line" ]; then
                  printf "[ctx: debug: matched line: %s]\n" "$match_line" >&2
                fi
              fi
              break
            fi
          elif grep -q '^# default' "$f" 2>/dev/null; then
            default_filter="$f"
          fi
        done
      fi

      # Module signature merge after the run module's own: same first-match,
      # shadow, and priority rules as the command loop
      if [ -d "$modules_root" ] || [ -d "$extension_modules_root" ]; then
        for bn in $(filter_module_names); do
          fd=$(module_dir "$bn") || continue
          for f in "$fd/filters"/*.awk; do
            [ -f "$f" ] || continue
            pat=$(directive_value match "$f")
            [ -n "$pat" ] || continue
            if printf "%s\n" "$sample" | COMPACT_PAT="$pat" awk 'BEGIN{rc=1} $0 ~ ENVIRON["COMPACT_PAT"] {rc=0; exit} END{exit rc}' 2>/dev/null; then
              prio=$(directive_value ctx-filter-priority "$f")
              rel="$bn/$(basename "$f")"
              if [ "$prio" = "over" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (signature match: %s, priority over)]\n" "$rel" "$pat" >&2
                fi
              elif [ -z "$selected_filter" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (signature match: %s)]\n" "$rel" "$pat" >&2
                fi
              else
                printf "[ctx: shadow warning: %s and %s both claim: %s]\n" "$(basename "$selected_filter")" "$rel" "$pat" >&2
              fi
            fi
          done
        done
      fi

      if [ -z "$selected_filter" ]; then
        selected_filter="$default_filter"
        if [ "$debug" -eq 1 ] && [ -n "$selected_filter" ]; then
          printf "[ctx: debug: selected %s (default)]\n" "$(basename "$selected_filter")" >&2
        fi
      fi

      # Module default fallback: fills an empty selection only; defaults
      # never shadow a match, so priority does not apply here
      if [ -z "$selected_filter" ] && { [ -d "$modules_root" ] || [ -d "$extension_modules_root" ]; }; then
        for bn in $(filter_module_names); do
          fd=$(module_dir "$bn") || continue
          for f in "$fd/filters"/*.awk; do
            [ -f "$f" ] || continue
            if grep -q '^# default' "$f" 2>/dev/null; then
              selected_filter="$f"
              if [ "$debug" -eq 1 ]; then
                printf "[ctx: debug: selected %s (module default)]\n" "$bn/$(basename "$f")" >&2
              fi
              break 2
            fi
          done
        done
      fi
    fi
  fi

  # Merge stderr for filters that declare it (compiler-style tools)
  stream_mode=""
  if [ -n "$selected_filter" ] && [ -f "$selected_filter" ]; then
    stream_mode=$(directive_value stream "$selected_filter")
  fi
  if [ "$stream_mode" = "merged" ] && [ -n "$stderr_input" ]; then
    if [ -n "$raw_input" ]; then
      raw_input=$(printf "%s\n%s" "$raw_input" "$stderr_input")
    else
      raw_input="$stderr_input"
    fi
    stderr_input=""
    clean_input="$raw_input"
    case "$raw_input" in
      *"$esc"*)
        clean_input=$(printf "%s\n" "$raw_input" | awk '{gsub(/\033\[[0-9;]*[a-zA-Z]/, ""); print}')
        ;;
    esac
  fi

  # If still no filter found, fallback to raw input
  if [ -z "$selected_filter" ] || [ ! -f "$selected_filter" ]; then
    if [ -n "$raw_input" ]; then
      printf "%s\n" "$raw_input"
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Empty stdout with no merged filter: stderr is the whole output
  if [ -z "$raw_input" ]; then
    emit_stderr
    exit "$cmd_status"
  fi

  # Step 3: Execute filter and apply fail-safe and recovery guards
  filtered_output=$(printf "%s\n" "$clean_input" | awk -v COMPACT_EXIT="$cmd_status" -f "$selected_filter" 2>/dev/null) || true

  raw_bytes=$(printf "%s\n" "$raw_input" | wc -c | tr -d ' ')
  clean_bytes=$(printf "%s\n" "$clean_input" | wc -c | tr -d ' ')
  out_bytes=$(printf "%s\n" "$filtered_output" | wc -c | tr -d ' ')
  filter_name=$(basename "$selected_filter")

  # A notice is a marker line: an elision, collapse, or recovery pointer; the
  # marker vocabulary keeps bracketed data lines from reading as notices
  notice_state=$(printf "%s\n" "$filtered_output" | awk '
    /^[ \t]*\.\.\. \(/ { notice = 1; next }
    /^[ \t]*\[[^]]*(collapsed|elided|repeated|capped|COMPACT_DISABLE)[^]]*\]/ { notice = 1; next }
    /^[ \t]*$/ { next }
    { other = 1 }
    END { printf "%d %d\n", notice + 0, (other ? 0 : 1) }
  ')
  has_notice=${notice_state% *}
  notice_only=${notice_state#* }

  # A format-only filter declares that its marker-less reductions are layout,
  # never lost content
  format_only=""
  if [ -f "$selected_filter" ]; then
    format_only=$(directive_value format-only "$selected_filter")
  fi

  # Universal fail-safe: pass raw input if the filter produced empty output
  if [ -z "$filtered_output" ]; then
    printf "%s\n" "$raw_input"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (fail-safe passthrough: %d bytes)]\n" "$filter_name" "$raw_bytes" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Notice-only output: the filter is signaling (a false-green guard, for
  # example); pass it through, never revert the signal to raw
  if [ "$notice_only" -eq 1 ]; then
    printf "%s\n" "$filtered_output"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (notice-only output passed through)]\n" "$filter_name" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Byte fail-safe: pass raw input if the filter grew the stream
  if [ "$out_bytes" -gt "$raw_bytes" ]; then
    printf "%s\n" "$raw_input"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (fail-safe passthrough: %d bytes)]\n" "$filter_name" "$raw_bytes" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Recovery: a shrinking filter without a notice either truncated silently or
  # only reformatted; format-only filters declare that, everything else goes raw
  if [ "$out_bytes" -lt "$clean_bytes" ] && [ "$has_notice" -eq 0 ] && [ -z "$format_only" ]; then
    printf "%s\n" "$raw_input"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (recovery fallback: %d -> %d bytes, no notice)]\n" "$filter_name" "$clean_bytes" "$out_bytes" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  printf "%s\n" "$filtered_output"

  if [ "$stats" -eq 1 ]; then
    pct=0
    if [ "$raw_bytes" -gt 0 ]; then
      pct=$(( (raw_bytes - out_bytes) * 100 / raw_bytes ))
    fi
    printf "[ctx: %s, %d -> %d bytes (%d%% reduction)]\n" "$filter_name" "$raw_bytes" "$out_bytes" "$pct" >&2
  fi

  emit_stderr
  exit "$cmd_status"
}

# ---------------------------------------------------------------------------
# internal hook engine: ctx _hooks <point> [<ENVNAME> <value>]...
# Hidden and unlisted. Hook files under modules/*/hooks/ declare
# "# ctx-hook: <point>" and optionally "# ctx-hook-mode: block"; discovery
# runs in module-name order (LC_ALL=C) then file-name order. CWD is the
# workspace root; each hook gets CTX_HOOK_POINT and the passed context
# exported. Default mode warns on a non-zero hook and continues (point rc
# unaffected); block mode stops the point at the first failing hook and
# fails rc=1. Zero hooks for the point = silent rc=0.
run_hooks() {
  if [ $# -lt 1 ]; then
    ctx_err "_hooks: missing point"
    exit 1
  fi
  point=$1
  shift
  while [ $# -gt 0 ]; do
    name=$1
    if [ $# -lt 2 ]; then
      ctx_err "_hooks: context name without value: $name"
      exit 1
    fi
    case "$name" in
      [A-Za-z_]*)
        case "$name" in
          *[!A-Za-z0-9_]*)
            ctx_err "_hooks: malformed context name: $name"
            exit 1
            ;;
        esac
        ;;
      *)
        ctx_err "_hooks: malformed context name: $name"
        exit 1
        ;;
    esac
    export "$name=$2"
    shift 2
  done
  CTX_HOOK_POINT=$point
  export CTX_HOOK_POINT

  if ! cd "$root"; then
    ctx_err "cannot enter workspace root: $root"
    exit 1
  fi

  for n in $(scan_module_dirs); do
    [ -n "$n" ] || continue
    nd=$(module_dir "$n") || continue
    hd="$nd/hooks"
    [ -d "$hd" ] || continue
    for h in $(hook_files "$hd"); do
      [ -n "$h" ] || continue
      hp=$(header_field "$h" ctx-hook)
      [ -n "$hp" ] || continue
      if [ "$hp" != "$point" ]; then
        continue
      fi
      hmode=$(header_field "$h" ctx-hook-mode)
      hrc=0
      if [ -x "$h" ]; then
        "$h" || hrc=$?
      else
        sh "$h" || hrc=$?
      fi
      if [ "$hrc" -ne 0 ]; then
        if [ "$hmode" = "block" ]; then
          ctx_err "hook blocked the point at $point: $n: ${h##*/} (rc=$hrc)"
          exit 1
        fi
        ctx_err "hook failed at $point: $n: ${h##*/} (rc=$hrc); continuing"
      fi
    done
  done
  return 0
}

hook_files() {
  # hook files of one module, file-name sorted (LC_ALL=C); hidden and
  # whitespace names never form
  hd=$1
  for h in "$hd"/*; do
    [ -f "$h" ] || continue
    b=${h##*/}
    case "$b" in
      ""|.*|*[[:space:]]*)
        continue
        ;;
    esac
    printf '%s\n' "$h"
  done | LC_ALL=C sort
}

# ---------------------------------------------------------------------------
# compose: the builtin over the core's private composer, answered before
# discovery so no discovery warning reaches its stderr; argv, streams, and the
# exit code pass through the exec, and only a sole --help or -h is its own

compose_builtin() {
  if [ $# -eq 1 ]; then
    case "$1" in
      --help|-h)
        cat <<'EOF'
usage: ctx compose [--check]
composes the generated law layer from the core law source and the laws of the effective modules, or verifies it current; --check writes nothing and reads a stale layer as rc 1
exit codes: 0 current or composed; 1 stale under --check, or a content refusal; 2 an I/O refusal or a missing composer
EOF
        exit 0
        ;;
    esac
  fi
  if [ ! -f "$dir/laws/compose" ]; then
    ctx_err "compose: missing composer: .contexture/laws/compose"
    exit 2
  fi
  exec sh "$dir/laws/compose" "$@"
}

# ---------------------------------------------------------------------------
# package: the builtin group over the core's private package installer and
# uninstaller, answered before discovery (a broken module never blocks the
# install that fixes it); its sub-verb table is this case, never a module's
# scripts; the verb resolves the package, refuses before the run with one
# line, and runs the private script from the workspace root with CTX_ROOT set
# to this engine's root, so every line, exit code, and record passes through;
# on success it writes (install) or removes (uninstall) the package's line in the
# workspace configuration, and the bare install installs every declared package

package_install_line="  ctx package install [<package>]  install or update a package (a catalog name or a package root path; --as=<module>=<alias> renames a module), or bare every declared one, on the human's explicit go at the act"
package_uninstall_line="  ctx package uninstall <package>  remove an installed package (its name or its package root path), on the human's explicit go at the act"
package_list_line="  ctx package list                 the declared packages against the installed ones: versions, modules, aliases, and drift; read only"
package_catalog_line="  ctx package catalog [--names] [--no-probe] [--json]  list available catalog packages with value, install status, and host readiness; read only"
package_info_line="  ctx package info <package> [--no-probe] [--json]     show one package's metadata, parts, install status, and host readiness; read only"

show_package_help() {
  printf "ctx package: install or remove a package through the core package installer, each only on the human's explicit go at the act, which the verb never checks, or inspect the declared, installed, and catalog packages\n\n"
  printf 'usage:\n%s\n%s\n%s\n%s\n%s\n' "$package_install_line" "$package_uninstall_line" "$package_list_line" "$package_catalog_line" "$package_info_line"
  printf "  ctx package <sub-verb> --help    one sub-verb's detail\n"
}

show_package_verb_help() {
  case "$1" in
    install)
      cat <<'EOF'
usage: ctx package install [<package>] [--as=<module>=<alias>]...
installs or updates the package into this workspace's extension root through the core package installer, records it, runs its lifecycle actions, and recomposes the law layer
<package>: a catalog name (letters, digits, dot, underscore, hyphen; not starting with a dot) resolves .contexture/plugins/<name> (falling back to plugins/<name>) at the workspace root; a value holding a slash is a package root path, read from the working folder; either way the package lands in the workspace this engine serves
bare: ctx package install with no package installs every package the workspace configuration declares (one package.<name>: <source> [--as=<module>=<alias>]... line each) and the install record lacks, each with its declared flags; nothing pending prints one line rc 0; a configuration line is never a go, the bare install is itself the act
an install writes its package.<name> line (the source as given, a path inside the workspace relative to its root, and every alias the record holds), and an uninstall removes it
--as=<module>=<alias> (repeatable, one per module): installs that module of the package under the alias, its folder, laws, lifecycle scripts, namespace, and storage root taking the alias (a root its data file declares applies only under its own name), recorded so a re-install without the flag keeps it; a module name, or a storage root another installed module resolves to, that collides refuses naming --as, and the installer never picks a name itself
an install runs only on the human's explicit go at the act; this verb checks no go: the gate binds the act, never the doorway
exit codes: 0 installed or updated; 1 a refusal (a usage error, a malformed name, no such package, a collision); 2 an environment or I/O failure (a missing installer, a read-only extension root, a failed lifecycle action or recompose)
EOF
      ;;
    uninstall)
      cat <<'EOF'
usage: ctx package uninstall <package>
removes an installed package from this workspace's extension root through the core package uninstaller, running its uninstall actions first and preserving a file changed after install, then recomposes the law layer and removes the package's package.<name> line from the workspace configuration
<package>: the installed package's name (its .contexture/plugins/<name> or plugins/<name> folder, when present, passes as the package root); a value holding a slash is a package root path, read from the working folder; either way the package leaves the workspace this engine serves
an uninstall runs only on the human's explicit go at the act; this verb checks no go: the gate binds the act, never the doorway
exit codes: 0 removed; 1 a refusal (a usage error, a malformed name, a package not installed); 2 an environment or I/O failure (a missing uninstaller, a read-only root, a failed lifecycle action or recompose)
EOF
      ;;
    list)
      cat <<'EOF'
usage: ctx package list
prints one line per package the workspace configuration declares or the install records hold, in name order: installed with its version and modules (an alias read as <alias> (alias of <module>)), or declared and not installed; then one closing line counting the declared, the installed, and the drift
drift: a package declared but not installed, installed but not declared, or installed at a version other than its declared source's; a record without module lines reads as plainly installed, never an error
read only: it writes nothing and installs nothing, and needs no go
exit codes: 0 the listing; 1 an argument; 2 an install record area or record that exists but cannot be read
EOF
      ;;
    catalog)
      cat <<'EOF'
usage: ctx package catalog [--names] [--no-probe] [--json]
lists available catalog packages from .contexture/plugins/ (falling back to plugins/) with metadata, install status, and host readiness, sorted by name; read only
--names: print sorted catalog package names, one per line, without probing (cannot combine with --json)
--no-probe: skip readiness probes and mark each package skipped
--json: emit one compact JSON object on stdout
read only: it writes nothing and installs nothing, and needs no go
exit codes: 0 the catalog listing (even when empty or when probes report partial, unmet, or error); 1 a bad flag or unexpected argument; 2 an install record area or record that exists but cannot be read
EOF
      ;;
    info)
      cat <<'EOF'
usage: ctx package info <package> [--no-probe] [--json]
shows one package's manifest metadata, parts, install status, and host readiness; read only
<package>: a catalog name (resolving .contexture/plugins/<name> then plugins/<name>) or a package root path holding a slash
--no-probe: skip the readiness probe
--json: emit one compact JSON object on stdout
read only: it writes nothing and installs nothing, and needs no go
exit codes: 0 info printed (even when probe is partial, unmet, or error); 1 a bad flag, missing package, or malformed manifest; 2 a path failure or an unreadable install record area or record
EOF
      ;;
  esac
}

# the package declarations: one package.<name>: <source> [--as=<module>=<alias>]... line per
# package in the workspace configuration, the intent beside the install record; read by
# their own reader (the configuration's value reader strips blanks and quotes, while a
# source and its flags are tokens), written by ctx package install and removed by ctx
# package uninstall; a configuration line is never a go, only the bare install acts on them
pkg_conf=$dir/config

# pkg_decl_lines: every package line as "<name> <source> [<flag>...]", a token starting
# with # and the rest of its line dropped as a comment, in file order
pkg_decl_lines() {
  [ -f "$pkg_conf" ] || return 0
  LC_ALL=C awk '
    { sub(/\r$/, "") }
    /^[ \t]*package\.[^: \t]+[ \t]*:/ {
      c = index($0, ":")
      k = substr($0, 1, c - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", k)
      o = substr(k, 9)
      n = split(substr($0, c + 1), t, /[ \t]+/)
      for (i = 1; i <= n; i++) {
        if (t[i] == "") continue
        if (substr(t[i], 1, 1) == "#") break
        o = o " " t[i]
      }
      print o
    }' "$pkg_conf"
}

# pkg_decl_write <name> [<value>]: the package.<name> line set to <value> in its place (or
# appended), or removed when no value is given; every other line kept byte for byte, the
# file made when absent and replaced whole, never half written; a removal the file holds no
# line for writes nothing, so an absent file stays absent
pkg_decl_write() {
  if ! command -v cfg_set_raw >/dev/null 2>&1; then
    ctx_err "package: missing internal config library"
    return 2
  fi
  if [ $# -gt 1 ]; then
    cfg_set_raw "package.$1" "$2" "$dir"
  else
    cfg_unset "package.$1" "$dir"
  fi
}

# package_as_ok <flag>: rc 0 for one --as=<module>=<alias> flag, both sides module names;
# else rc 1 with the refusal's message on stdout
package_as_ok() {
  pao_pair=${1#--as=}
  case "$1" in
    --as=?*=?*) ;;
    *) printf "malformed --as '%s' (--as=<module>=<alias>)" "$1"; return 1 ;;
  esac
  for pao_n in "${pao_pair%%=*}" "${pao_pair#*=}"; do
    case "$pao_n" in
      .*) pao_n="" ;;
    esac
    if [ -z "$pao_n" ] || ! module_name_ok "$pao_n"; then
      printf "malformed --as '%s': %s" "$1" "$module_name_rule"
      return 1
    fi
  done
  return 0
}

# package_catalog_dir <name>: resolve a bare catalog package name, checking
# .contexture/plugins/<name> before ./plugins/<name>; prints the resolved path
# rc 0, or returns 1 if absent in both.
package_catalog_dir() {
  if [ -d "$dir/plugins/$1" ]; then
    printf '%s\n' "$dir/plugins/$1"
    return 0
  fi
  if [ -d "$root/plugins/$1" ]; then
    printf '%s\n' "$root/plugins/$1"
    return 0
  fi
  return 1
}

# package_catalog_names: list catalog package names across .contexture/plugins and
# ./plugins matching the package name rule and carrying a manifest file, sorted LC_ALL=C.
package_catalog_names() {
  for pcn_base in "$dir/plugins" "$root/plugins"; do
    [ -d "$pcn_base" ] || continue
    for pcn_d in "$pcn_base"/*; do
      [ -d "$pcn_d" ] || continue
      pcn_b=${pcn_d##*/}
      case "$pcn_b" in
        ""|.*|*[!A-Za-z0-9._-]*) continue ;;
      esac
      [ -f "$pcn_d/manifest" ] || continue
      printf '%s\n' "$pcn_b"
    done
  done | LC_ALL=C sort -u
}

# package_run_probe <name> <pkg_root> <version> <no_probe>: sets PR_STATUS, PR_CODE,
# PR_DETAIL, and PR_LINES. Runs <pkg_root>/hooks/probe non-interactively (< /dev/null)
# from $root; absent probe defaults to ready (0).
package_run_probe() {
  pr_name=$1
  pr_pkg=$2
  pr_ver=$3
  pr_skip=$4
  PR_STATUS="ready"
  PR_CODE="0"
  PR_DETAIL=""
  PR_LINES=""
  if [ "$pr_skip" -eq 1 ]; then
    PR_STATUS="skipped"
    PR_CODE=""
    return 0
  fi
  pr_hook=$pr_pkg/hooks/probe
  [ -f "$pr_hook" ] || return 0
  pr_out=""
  pr_tmp_dir="$root/.contexture/tmp"
  if mkdir -p "$pr_tmp_dir" 2>/dev/null && [ -d "$pr_tmp_dir" ] && [ -w "$pr_tmp_dir" ]; then
    pr_out=$(mktemp "$pr_tmp_dir/pkg-probe.$$.XXXXXX" 2>/dev/null) || pr_out=""
  fi
  if [ -z "$pr_out" ]; then
    pr_out=$(mktemp "${TMPDIR:-/tmp}/pkg-probe.$$.XXXXXX" 2>/dev/null) || pr_out=""
  fi
  if [ -z "$pr_out" ]; then
    PR_STATUS="error"
    PR_CODE="2"
    PR_DETAIL="cannot create probe capture file"
    PR_LINES=$PR_DETAIL
    return 0
  fi
  ( cd "$root" || exit 2
    CTX_ROOT=$root
    CTX_BIN=$ctx_bin
    CTX_PACKAGE_NAME=$pr_name
    CTX_PACKAGE_ROOT=$pr_pkg
    CTX_PACKAGE_VERSION=$pr_ver
    LC_ALL=C
    export CTX_ROOT CTX_BIN CTX_PACKAGE_NAME CTX_PACKAGE_ROOT CTX_PACKAGE_VERSION LC_ALL
    if [ -x "$pr_hook" ]; then
      exec "$pr_hook" < /dev/null
    else
      exec sh "$pr_hook" < /dev/null
    fi ) > "$pr_out" 2>&1
  PR_CODE=$?
  case "$PR_CODE" in
    0) PR_STATUS="ready" ;;
    1) PR_STATUS="unmet" ;;
    3) PR_STATUS="partial" ;;
    *) PR_STATUS="error" ;;
  esac
  PR_LINES=$(awk '{ sub(/\r$/, ""); print }' "$pr_out" 2>/dev/null)
  PR_DETAIL=$(awk '/[^[:space:]]/ { sub(/\r$/, ""); print; exit }' "$pr_out" 2>/dev/null)
  rm -f "$pr_out" 2>/dev/null
  return 0
}

# package_run <install|uninstall> <package root or name> <as pairs>: one private script run
# as a child from the workspace root, its streams and exit code passed through
package_run() {
  ( cd "$root" || exit 2
    CTX_ROOT=$root
    CTX_PACKAGE_AS=$3
    export CTX_ROOT CTX_PACKAGE_AS
    exec sh "$dir/package-$1" "$2" )
}

# package_declared_install: the bare install, every declared package not yet installed, each
# with its declared flags, after every pending line passed its checks; nothing pending prints
# one plain line rc 0, and the first failure stops naming the package
package_declared_install() {
  pdi_all=$(pkg_decl_lines) || { ctx_err "package install: cannot read the workspace configuration"; exit 2; }
  if [ -z "$pdi_all" ]; then
    printf 'package install: no package is declared (the workspace configuration holds no package.<name> line)\n'
    exit 0
  fi
  pdi_plan=""
  pdi_nl='
'
  pdi_seen=" "
  while read -r pdi_name pdi_src pdi_flags; do
    case "$pdi_name" in
      ""|.*|*[!A-Za-z0-9._-]*) ctx_err "package install: malformed declared package name 'package.$pdi_name' (letters, digits, dot, underscore, hyphen; not starting with a dot)"; exit 1 ;;
    esac
    case "$pdi_seen" in
      *" $pdi_name "*) ctx_err "package install: package '$pdi_name' is declared twice in the workspace configuration"; exit 1 ;;
    esac
    pdi_seen="$pdi_seen$pdi_name "
    [ -f "$dir/extensions/.state/$pdi_name.files" ] && continue
    case "$pdi_src" in
      "") ctx_err "package install: package.$pdi_name declares no source"; exit 1 ;;
      /*) pdi_root=$pdi_src ;;
      */*) pdi_root=$root/$pdi_src ;;
      .*|*[!A-Za-z0-9._-]*) ctx_err "package install: package.$pdi_name: malformed source '$pdi_src'"; exit 1 ;;
      *)
        if ! pdi_root=$(package_catalog_dir "$pdi_src"); then
          ctx_err "package install: package.$pdi_name: no package at $pdi_src"
          exit 1
        fi
        ;;
    esac
    [ -d "$pdi_root" ] || { ctx_err "package install: package.$pdi_name: no package at $pdi_src"; exit 1; }
    pdi_root=$(CDPATH= cd -- "$pdi_root" 2>/dev/null && pwd) || { ctx_err "package install: package.$pdi_name: cannot resolve $pdi_src"; exit 2; }
    [ "${pdi_root##*/}" = "$pdi_name" ] || { ctx_err "package install: package.$pdi_name names the package '${pdi_root##*/}' at $pdi_src"; exit 1; }
    pdi_as=""
    for pdi_f in $pdi_flags; do
      if ! pdi_msg=$(package_as_ok "$pdi_f"); then
        ctx_err "package install: package.$pdi_name: $pdi_msg"
        exit 1
      fi
      pdi_as="${pdi_as:+$pdi_as }${pdi_f#--as=}"
    done
    pdi_plan="$pdi_plan$pdi_name	$pdi_root	$pdi_as$pdi_nl"
  done <<EOF
$pdi_all
EOF
  if [ -z "$pdi_plan" ]; then
    printf 'package install: nothing to install: every declared package is installed\n'
    exit 0
  fi
  [ -f "$dir/package-install" ] || { ctx_err "package install: missing package installer"; exit 2; }
  pdi_tab=$(printf '\t')
  while IFS="$pdi_tab" read -r pdi_name pdi_root pdi_as; do
    [ -n "$pdi_name" ] || continue
    package_run install "$pdi_root" "$pdi_as"
    pdi_rc=$?
    if [ "$pdi_rc" -ne 0 ]; then
      ctx_err "package install: the declared package '$pdi_name' did not install (rc $pdi_rc); the packages before it stay installed"
      exit "$pdi_rc"
    fi
  done <<EOF
$pdi_plan
EOF
  exit 0
}

# package_list: the declared packages against the installed ones, read only: one line per
# package in name order, then the closing count; a version differing from the declared
# source's manifest, a declared package not installed, and an installed one not declared
# read as drift; an install record area or record that exists but cannot be read refuses rc 2
# with one line, never answering that nothing is installed
package_list() {
  pl_state=$dir/extensions/.state
  if [ -e "$pl_state" ] && { [ ! -d "$pl_state" ] || [ ! -r "$pl_state" ] || [ ! -x "$pl_state" ]; }; then
    ctx_err "package list: the install record area cannot be read"
    exit 2
  fi
  for pl_f in "$pl_state"/*.files; do
    [ -e "$pl_f" ] || continue
    if [ ! -f "$pl_f" ] || [ ! -r "$pl_f" ]; then
      pl_b=${pl_f##*/}
      ctx_err "package list: the install record of '${pl_b%.files}' cannot be read"
      exit 2
    fi
  done
  pl_decl=$(pkg_decl_lines 2>/dev/null)
  pl_names=$(
    { printf '%s\n' "$pl_decl" | awk 'NF { print $1 }'
      for pl_f in "$dir"/extensions/.state/*.files; do
        [ -f "$pl_f" ] || continue
        pl_b=${pl_f##*/}
        printf '%s\n' "${pl_b%.files}"
      done
    } | LC_ALL=C sort -u)
  if [ -z "$pl_names" ]; then
    printf 'package list: no package is declared or installed\n'
    exit 0
  fi
  pl_nd=0; pl_ni=0; pl_nx=0
  while IFS= read -r pl_n; do
    [ -n "$pl_n" ] || continue
    pl_src=$(printf '%s\n' "$pl_decl" | awk -v n="$pl_n" '$1 == n { print ($2 == "" ? "-" : $2); exit }')
    pl_rec=$dir/extensions/.state/$pl_n.files
    [ -z "$pl_src" ] || pl_nd=$((pl_nd + 1))
    if [ ! -f "$pl_rec" ]; then
      pl_nx=$((pl_nx + 1))
      printf '%s: declared, not installed (drift)\n' "$pl_n"
      continue
    fi
    pl_ni=$((pl_ni + 1))
    pl_ver=$(awk '$1 == "version" { print $2; exit }' "$pl_rec" 2>/dev/null)
    pl_mods=$(awk '
      $1 == "module" && NF == 3 { m[++n] = ($2 == $3) ? $2 : $2 " (alias of " $3 ")"; any = 1; next }
      $1 == "file" { k = split($4, a, "/"); if (k >= 5 && a[1] == ".contexture" && a[2] == "extensions" && a[3] == "modules" && !(a[4] in seen)) { seen[a[4]] = 1; f[++nf] = a[4] } }
      END {
        if (any) { for (i = 1; i <= n; i++) o = o (i > 1 ? ", " : "") m[i] }
        else { for (i = 1; i <= nf; i++) o = o (i > 1 ? ", " : "") f[i] }
        print o
      }' "$pl_rec" 2>/dev/null)
    pl_line="$pl_n: installed${pl_ver:+ $pl_ver}"
    if [ -z "$pl_src" ]; then
      pl_line="$pl_line, not declared (drift)"
      pl_nx=$((pl_nx + 1))
    else
      pl_line="$pl_line, declared"
      case "$pl_src" in
        /*) pl_root=$pl_src ;;
        */*) pl_root=$root/$pl_src ;;
        *) pl_root=$(package_catalog_dir "$pl_src" 2>/dev/null) || pl_root="" ;;
      esac
      pl_sv=""
      [ -n "$pl_root" ] && [ -f "$pl_root/manifest" ] && pl_sv=$("$ctx_bin" _package "$pl_root/manifest" version 2>/dev/null)
      if [ -n "$pl_sv" ] && [ -n "$pl_ver" ] && [ "$pl_sv" != "$pl_ver" ]; then
        pl_line="$pl_line, the declared source holds $pl_sv (drift)"
        pl_nx=$((pl_nx + 1))
      fi
    fi
    printf '%s%s\n' "$pl_line" "${pl_mods:+; modules: $pl_mods}"
  done <<EOF
$pl_names
EOF
  printf 'package list: %s declared, %s installed, %s drift\n' "$pl_nd" "$pl_ni" "$pl_nx"
  exit 0
}

# package_catalog: read-only catalog listing with optional --names, --no-probe, --json.
package_catalog() {
  pc_names_only=0
  pc_noprobe=0
  pc_json=0
  for pc_a in "$@"; do
    case "$pc_a" in
      --names) pc_names_only=1 ;;
      --no-probe) pc_noprobe=1 ;;
      --json) pc_json=1 ;;
      -*) ctx_err "package catalog: unknown option '$pc_a' (ctx package catalog [--names] [--no-probe] [--json])"; exit 1 ;;
      *) ctx_err "package catalog: unexpected argument '$pc_a' (ctx package catalog [--names] [--no-probe] [--json])"; exit 1 ;;
    esac
  done
  if [ "$pc_names_only" -eq 1 ] && [ "$pc_json" -eq 1 ]; then
    ctx_err "package catalog: --names and --json cannot be used together"
    exit 1
  fi
  if [ "$pc_names_only" -eq 0 ]; then
    pc_state=$dir/extensions/.state
    if [ -e "$pc_state" ] && { [ ! -d "$pc_state" ] || [ ! -r "$pc_state" ] || [ ! -x "$pc_state" ]; }; then
      ctx_err "package catalog: the install record area cannot be read"
      exit 2
    fi
    for pc_f in "$pc_state"/*.files; do
      [ -e "$pc_f" ] || continue
      if [ ! -f "$pc_f" ] || [ ! -r "$pc_f" ]; then
        pc_b=${pc_f##*/}
        ctx_err "package catalog: the install record of '${pc_b%.files}' cannot be read"
        exit 2
      fi
    done
    pc_decl=$(pkg_decl_lines 2>/dev/null)
  fi
  pc_cand=$(package_catalog_names)
  if [ "$pc_names_only" -eq 1 ]; then
    while IFS= read -r pc_n; do
      [ -n "$pc_n" ] || continue
      pc_pkg=$(package_catalog_dir "$pc_n") || continue
      if ! package_file_parse "$pc_pkg/manifest"; then
        ctx_err "package catalog: skipping '$pc_n': $PF_ERROR"
        continue
      fi
      printf '%s\n' "$pc_n"
    done <<EOF
$pc_cand
EOF
    exit 0
  fi
  pc_count=0; pc_inst_count=0; pc_ready=0; pc_partial=0; pc_unmet=0; pc_err=0
  pc_jrows=""
  while IFS= read -r pc_n; do
    [ -n "$pc_n" ] || continue
    pc_pkg=$(package_catalog_dir "$pc_n") || continue
    if ! package_file_parse "$pc_pkg/manifest"; then
      ctx_err "package catalog: skipping '$pc_n': $PF_ERROR"
      continue
    fi
    pc_count=$((pc_count + 1))
    pc_rec=$dir/extensions/.state/$pc_n.files
    pc_inst=0; pc_iver=""
    if [ -f "$pc_rec" ]; then
      pc_inst=1
      pc_inst_count=$((pc_inst_count + 1))
      pc_iver=$(awk '$1 == "version" { print $2; exit }' "$pc_rec" 2>/dev/null)
    fi
    pc_is_decl=0
    if printf '%s\n' "$pc_decl" | awk -v n="$pc_n" '$1 == n { f = 1; exit } END { exit(f ? 0 : 1) }'; then
      pc_is_decl=1
    fi
    package_run_probe "$pc_n" "$pc_pkg" "$pf_version" "$pc_noprobe"
    case "$PR_STATUS" in
      ready) pc_ready=$((pc_ready + 1)) ;;
      partial) pc_partial=$((pc_partial + 1)) ;;
      unmet) pc_unmet=$((pc_unmet + 1)) ;;
      error) pc_err=$((pc_err + 1)) ;;
    esac
    pc_pitch=${pf_pitch:-$pf_summary}
    if [ "$pc_json" -eq 1 ]; then
      pc_jrow=$(PC_NAME="$pc_n" PC_VER="$pf_version" PC_KIND="$pf_kind" PC_DRV="$pf_driver" \
        PC_CAT="$pf_category" PC_SUM="$pf_summary" PC_PITCH="$pc_pitch" PC_WHEN="$pf_when" \
        PC_NEEDS="$pf_needs" PC_TAGS="$pf_tags" PC_INST="$pc_inst" PC_IVER="$pc_iver" \
        PC_DECL="$pc_is_decl" PC_PSTATUS="$PR_STATUS" PC_PCODE="$PR_CODE" PC_PDETAIL="$PR_DETAIL" \
        LC_ALL=C awk '
        function jq(s,   n, p, o, i, c, r) {
          n = split(s, p, /\\/)
          o = (n ? p[1] : "")
          for (i = 2; i <= n; i++) o = o "\\\\" p[i]
          n = split(o, p, /"/)
          o = (n ? p[1] : "")
          for (i = 2; i <= n; i++) o = o "\\\"" p[i]
          if (o ~ /[[:cntrl:]]/) {
            r = ""
            for (i = 1; i <= length(o); i++) {
              c = substr(o, i, 1)
              if (c ~ /[[:cntrl:]]/ && (c in ORD)) {
                if (ORD[c] == 10) r = r "\\n"
                else if (ORD[c] == 9) r = r "\\t"
                else if (ORD[c] == 13) r = r "\\r"
                else r = r sprintf("\\u%04x", ORD[c])
              } else r = r c
            }
            o = r
          }
          return "\"" o "\""
        }
        function jopt(s) { return (s == "" ? "null" : jq(s)) }
        BEGIN {
          for (i = 1; i < 32; i++) ORD[sprintf("%c", i)] = i
          ORD[sprintf("%c", 127)] = 127
          nt = split(ENVIRON["PC_TAGS"], T, / /)
          tarr = "["
          for (i = 1; i <= nt; i++) if (T[i] != "") tarr = tarr (tarr == "[" ? "" : ",") jq(T[i])
          tarr = tarr "]"
          inst = (ENVIRON["PC_INST"] == "1" ? "true" : "false")
          decl = (ENVIRON["PC_DECL"] == "1" ? "true" : "false")
          pcode = (ENVIRON["PC_PCODE"] == "" ? "null" : ENVIRON["PC_PCODE"])
          printf "{\"name\":%s,\"version\":%s,\"kind\":%s,\"driver\":%s,\"category\":%s,\"summary\":%s,\"pitch\":%s,\"when\":%s,\"needs\":%s,\"tags\":%s,\"installed\":%s,\"installed_version\":%s,\"declared\":%s,\"probe\":{\"status\":%s,\"code\":%s,\"detail\":%s}}", \
            jq(ENVIRON["PC_NAME"]), jq(ENVIRON["PC_VER"]), jq(ENVIRON["PC_KIND"]), jopt(ENVIRON["PC_DRV"]), \
            jopt(ENVIRON["PC_CAT"]), jq(ENVIRON["PC_SUM"]), jq(ENVIRON["PC_PITCH"]), jopt(ENVIRON["PC_WHEN"]), \
            jopt(ENVIRON["PC_NEEDS"]), tarr, inst, jopt(ENVIRON["PC_IVER"]), decl, \
            jq(ENVIRON["PC_PSTATUS"]), pcode, jq(ENVIRON["PC_PDETAIL"])
        }')
      pc_jrows="${pc_jrows:+$pc_jrows,}$pc_jrow"
    else
      if [ "$pc_inst" -eq 1 ]; then
        pc_st="installed${pc_iver:+ $pc_iver}"
      elif [ "$pc_is_decl" -eq 1 ]; then
        pc_st="declared, not installed"
      else
        pc_st="not installed"
      fi
      printf '%s (%s, %s%s) [%s] [probe: %s]\n' "$pc_n" "$pf_version" "$pf_kind" "${pf_category:+, $pf_category}" "$pc_st" "$PR_STATUS"
      printf '  %s\n' "$pc_pitch"
      [ -z "$pf_needs" ] || printf '  needs: %s\n' "$pf_needs"
      if [ "$PR_STATUS" = error ]; then
        printf '  probe: rc %s%s\n' "$PR_CODE" "${PR_DETAIL:+: $PR_DETAIL}"
      elif [ -n "$PR_DETAIL" ]; then
        printf '  probe: %s\n' "$PR_DETAIL"
      fi
    fi
  done <<EOF
$pc_cand
EOF
  if [ "$pc_json" -eq 1 ]; then
    printf '{"packages":[%s]}\n' "$pc_jrows"
    exit 0
  fi
  if [ "$pc_count" -eq 0 ]; then
    printf 'package catalog: no catalog packages found (.contexture/plugins/ and plugins/ hold none)\n'
    exit 0
  fi
  if [ "$pc_noprobe" -eq 1 ]; then
    printf 'package catalog: %s packages (%s installed, probes skipped)\n' "$pc_count" "$pc_inst_count"
  else
    pc_err_note=""
    [ "$pc_err" -eq 0 ] || pc_err_note=", $pc_err error"
    printf 'package catalog: %s packages (%s installed, %s ready, %s partial, %s unmet%s)\n' \
      "$pc_count" "$pc_inst_count" "$pc_ready" "$pc_partial" "$pc_unmet" "$pc_err_note"
  fi
  exit 0
}

# package_info: read-only detailed inspection of one catalog or path package.
package_info() {
  pi_noprobe=0
  pi_json=0
  pi_target=""
  pi_has_target=0
  for pi_a in "$@"; do
    case "$pi_a" in
      --no-probe) pi_noprobe=1 ;;
      --json) pi_json=1 ;;
      -*) ctx_err "package info: unknown option '$pi_a' (ctx package info <package> [--no-probe] [--json])"; exit 1 ;;
      *)
        if [ "$pi_has_target" -eq 1 ]; then
          ctx_err "package info: unexpected argument '$pi_a' (ctx package info <package> [--no-probe] [--json])"
          exit 1
        fi
        pi_target=$pi_a
        pi_has_target=1
        ;;
    esac
  done
  if [ "$pi_has_target" -eq 0 ]; then
    ctx_err "package info: usage: ctx package info <package> [--no-probe] [--json]"
    exit 1
  fi
  pi_state=$dir/extensions/.state
  if [ -e "$pi_state" ] && { [ ! -d "$pi_state" ] || [ ! -r "$pi_state" ] || [ ! -x "$pi_state" ]; }; then
    ctx_err "package info: the install record area cannot be read"
    exit 2
  fi
  case "$pi_target" in
    */*)
      if [ ! -d "$pi_target" ]; then
        ctx_err "package info: no package root at $pi_target"
        exit 1
      fi
      pi_pkg=$(CDPATH= cd -- "$pi_target" 2>/dev/null && pwd) || {
        ctx_err "package info: cannot resolve $pi_target"
        exit 2
      }
      pi_name=${pi_pkg##*/}
      case "$pi_name" in
        ""|.*|*[!A-Za-z0-9._-]*)
          ctx_err "package info: malformed package name '$pi_name' (letters, digits, dot, underscore, hyphen; not starting with a dot)"
          exit 1
          ;;
      esac
      ;;
    ""|.*|*[!A-Za-z0-9._-]*)
      ctx_err "package info: malformed package name '$pi_target' (letters, digits, dot, underscore, hyphen; not starting with a dot)"
      exit 1
      ;;
    *)
      pi_name=$pi_target
      if ! pi_pkg=$(package_catalog_dir "$pi_name"); then
        ctx_err "package info: no package at .contexture/plugins/$pi_name or plugins/$pi_name (name a package root path, a value holding a slash, instead)"
        exit 1
      fi
      ;;
  esac
  pi_rec=$pi_state/$pi_name.files
  if [ -e "$pi_rec" ] && { [ ! -f "$pi_rec" ] || [ ! -r "$pi_rec" ]; }; then
    ctx_err "package info: the install record of '$pi_name' cannot be read"
    exit 2
  fi
  if ! package_file_parse "$pi_pkg/manifest"; then
    ctx_err "package info: malformed package manifest: $PF_ERROR"
    exit 1
  fi
  pi_inst=0; pi_iver=""
  if [ -f "$pi_rec" ]; then
    pi_inst=1
    pi_iver=$(awk '$1 == "version" { print $2; exit }' "$pi_rec" 2>/dev/null)
  fi
  pi_decl=$(pkg_decl_lines 2>/dev/null)
  pi_is_decl=0
  if printf '%s\n' "$pi_decl" | awk -v n="$pi_name" '$1 == n { f = 1; exit } END { exit(f ? 0 : 1) }'; then
    pi_is_decl=1
  fi
  pi_hooks=""
  for pi_hk in probe install uninstall; do
    [ -f "$pi_pkg/hooks/$pi_hk" ] && pi_hooks="${pi_hooks:+$pi_hooks }$pi_hk"
  done
  package_run_probe "$pi_name" "$pi_pkg" "$pf_version" "$pi_noprobe"
  if [ "$pi_json" -eq 1 ]; then
    PI_NAME="$pi_name" PI_VER="$pf_version" PI_KIND="$pf_kind" PI_DRV="$pf_driver" PI_FMT="$pf_format" \
      PI_CAT="$pf_category" PI_SUM="$pf_summary" PI_PITCH="$pf_pitch" PI_WHEN="$pf_when" \
      PI_NEEDS="$pf_needs" PI_TAGS="$pf_tags" PI_PARTS="$pf_parts" PI_DESC="$pf_desc" \
      PI_HAS_DESC="$pf_seen_desc" PI_INST="$pi_inst" PI_IVER="$pi_iver" PI_DECL="$pi_is_decl" \
      PI_HOOKS="$pi_hooks" PI_PSTATUS="$PR_STATUS" PI_PCODE="$PR_CODE" PI_PLINES="$PR_LINES" \
      LC_ALL=C awk '
      function jq(s,   n, p, o, i, c, r) {
        n = split(s, p, /\\/)
        o = (n ? p[1] : "")
        for (i = 2; i <= n; i++) o = o "\\\\" p[i]
        n = split(o, p, /"/)
        o = (n ? p[1] : "")
        for (i = 2; i <= n; i++) o = o "\\\"" p[i]
        if (o ~ /[[:cntrl:]]/) {
          r = ""
          for (i = 1; i <= length(o); i++) {
            c = substr(o, i, 1)
            if (c ~ /[[:cntrl:]]/ && (c in ORD)) {
              if (ORD[c] == 10) r = r "\\n"
              else if (ORD[c] == 9) r = r "\\t"
              else if (ORD[c] == 13) r = r "\\r"
              else r = r sprintf("\\u%04x", ORD[c])
            } else r = r c
          }
          o = r
        }
        return "\"" o "\""
      }
      function jopt(s) { return (s == "" ? "null" : jq(s)) }
      BEGIN {
        for (i = 1; i < 32; i++) ORD[sprintf("%c", i)] = i
        ORD[sprintf("%c", 127)] = 127
        nt = split(ENVIRON["PI_TAGS"], T, / /)
        tarr = "["
        for (i = 1; i <= nt; i++) if (T[i] != "") tarr = tarr (tarr == "[" ? "" : ",") jq(T[i])
        tarr = tarr "]"
        nh = split(ENVIRON["PI_HOOKS"], H, / /)
        harr = "["
        for (i = 1; i <= nh; i++) if (H[i] != "") harr = harr (harr == "[" ? "" : ",") jq(H[i])
        harr = harr "]"
        np = split(ENVIRON["PI_PARTS"], P, /\n/)
        parr = "["
        for (i = 1; i <= np; i++) {
          if (P[i] == "") continue
          split(P[i], Q, / /)
          parr = parr (parr == "[" ? "" : ",") "{\"type\":" jq(Q[1]) ",\"path\":" jq(Q[2]) "}"
        }
        parr = parr "]"
        desc = ENVIRON["PI_DESC"]
        sub(/\n$/, "", desc)
        jdesc = (ENVIRON["PI_HAS_DESC"] == "1" ? jq(desc) : "null")
        pl = ENVIRON["PI_PLINES"]
        sub(/\n$/, "", pl)
        larr = "["
        if (pl != "") {
          nl = split(pl, L, /\n/)
          for (i = 1; i <= nl; i++) larr = larr (i > 1 ? "," : "") jq(L[i])
        }
        larr = larr "]"
        inst = (ENVIRON["PI_INST"] == "1" ? "true" : "false")
        decl = (ENVIRON["PI_DECL"] == "1" ? "true" : "false")
        pcode = (ENVIRON["PI_PCODE"] == "" ? "null" : ENVIRON["PI_PCODE"])
        printf "{\"name\":%s,\"version\":%s,\"kind\":%s,\"driver\":%s,\"format\":%s,\"category\":%s,\"summary\":%s,\"pitch\":%s,\"when\":%s,\"needs\":%s,\"tags\":%s,\"parts\":%s,\"description\":%s,\"installed\":%s,\"installed_version\":%s,\"declared\":%s,\"lifecycle\":%s,\"probe\":{\"status\":%s,\"code\":%s,\"lines\":%s}}\n", \
          jq(ENVIRON["PI_NAME"]), jq(ENVIRON["PI_VER"]), jq(ENVIRON["PI_KIND"]), jopt(ENVIRON["PI_DRV"]), \
          (ENVIRON["PI_FMT"] == "" ? "null" : ENVIRON["PI_FMT"]), \
          jopt(ENVIRON["PI_CAT"]), jq(ENVIRON["PI_SUM"]), jopt(ENVIRON["PI_PITCH"]), jopt(ENVIRON["PI_WHEN"]), \
          jopt(ENVIRON["PI_NEEDS"]), tarr, parr, jdesc, inst, jopt(ENVIRON["PI_IVER"]), decl, harr, \
          jq(ENVIRON["PI_PSTATUS"]), pcode, larr
      }'
    exit 0
  fi
  pi_root_prefix=${root%/}
  pi_dir_prefix=${dir%/}
  case "$pi_pkg" in
    "$root") pi_root_disp="." ;;
    "$pi_dir_prefix"/*)
      if [ -n "$pi_dir_prefix" ]; then
        pi_root_disp=".contexture/${pi_pkg#"$pi_dir_prefix"/}"
      else
        pi_root_disp=${pi_pkg#/}
      fi
      ;;
    "$pi_root_prefix"/*) pi_root_disp=${pi_pkg#"$pi_root_prefix"/} ;;
    *) pi_root_disp=$pi_pkg ;;
  esac
  printf 'package: %s\n' "$pi_name"
  printf 'root: %s\n' "$pi_root_disp"
  printf 'version: %s\n' "$pf_version"
  printf 'kind: %s\n' "$pf_kind"
  [ -z "$pf_driver" ] || printf 'driver: %s\n' "$pf_driver"
  [ -z "$pf_format" ] || printf 'format: %s\n' "$pf_format"
  [ -z "$pf_category" ] || printf 'category: %s\n' "$pf_category"
  printf 'summary: %s\n' "$pf_summary"
  [ -z "$pf_pitch" ] || printf 'pitch: %s\n' "$pf_pitch"
  [ -z "$pf_when" ] || printf 'when: %s\n' "$pf_when"
  [ -z "$pf_needs" ] || printf 'needs: %s\n' "$pf_needs"
  if [ -n "$pf_tags" ]; then
    pi_tags_csv=$(printf '%s' "$pf_tags" | awk '{ for (i = 1; i <= NF; i++) o = o (i > 1 ? ", " : "") $i; print o }')
    printf 'tags: %s\n' "$pi_tags_csv"
  fi
  pi_parts_csv=$(printf '%s' "$pf_parts" | awk 'NF { o = o (o == "" ? "" : ", ") $1 ": " $2 } END { print o }')
  printf 'parts (under .contexture/extensions/): %s\n' "$pi_parts_csv"
  if [ "$pi_inst" -eq 1 ]; then
    pi_st="installed${pi_iver:+ $pi_iver}"
    [ "$pi_is_decl" -eq 1 ] && pi_st="$pi_st, declared"
    if [ -n "$pi_iver" ] && [ "$pi_iver" != "$pf_version" ]; then
      pi_st="$pi_st, catalog holds $pf_version"
    fi
  elif [ "$pi_is_decl" -eq 1 ]; then
    pi_st="declared, not installed"
  else
    pi_st="not installed"
  fi
  printf 'status: %s\n' "$pi_st"
  if [ "$PR_STATUS" = error ]; then
    printf 'probe: error (rc %s)\n' "$PR_CODE"
  else
    printf 'probe: %s\n' "$PR_STATUS"
  fi
  if [ -n "$PR_LINES" ]; then
    while IFS= read -r pi_pl; do
      printf '  %s\n' "$pi_pl"
    done <<EOF
$PR_LINES
EOF
  fi
  if [ "$pf_seen_desc" -eq 1 ]; then
    printf 'description:\n'
    if [ -n "$pf_desc" ]; then
      printf '%s' "$pf_desc" | while IFS= read -r pi_dl; do
        printf '  %s\n' "$pi_dl"
      done
    fi
  fi
  exit 0
}

package_builtin() {
  case "${1:-}" in
    ""|help|--help|-h)
      if [ $# -gt 1 ]; then
        ctx_err "package: $1 takes no argument; ctx package <sub-verb> --help prints one sub-verb's detail"
        exit 1
      fi
      show_package_help
      exit 0
      ;;
    install|uninstall|list|catalog|info) ;;
    *)
      ctx_err "package: unknown sub-verb: $1 (ctx package install, ctx package uninstall, ctx package list, ctx package catalog, or ctx package info)"
      exit 1
      ;;
  esac
  pk_verb=$1
  shift
  if [ $# -eq 1 ]; then
    case "$1" in
      --help|-h)
        show_package_verb_help "$pk_verb"
        exit 0
        ;;
    esac
  fi
  if [ "$pk_verb" = list ]; then
    if [ $# -ne 0 ]; then
      ctx_err "package list: takes no argument (ctx package list --help prints its detail)"
      exit 1
    fi
    package_list
  fi
  if [ "$pk_verb" = catalog ]; then
    package_catalog "$@"
  fi
  if [ "$pk_verb" = info ]; then
    package_info "$@"
  fi
  # the install aliases: every --as=<module>=<alias> before the one argument rule, each
  # module and alias a module name, no module and no alias twice; they reach the private
  # installer as CTX_PACKAGE_AS, space separated <module>=<alias> pairs
  pk_as=""
  pk_as_seen=" "
  pk_n=$#
  while [ "$pk_n" -gt 0 ]; do
    pk_a=$1
    shift
    pk_n=$((pk_n - 1))
    case "$pk_a" in
      --as=*)
        if [ "$pk_verb" != install ]; then
          ctx_err "package $pk_verb: --as names an install alias; an uninstall takes the installed package alone"
          exit 1
        fi
        if ! pk_msg=$(package_as_ok "$pk_a"); then
          ctx_err "package install: $pk_msg"
          exit 1
        fi
        pk_pair=${pk_a#--as=}
        pk_m=${pk_pair%%=*}
        pk_al=${pk_pair#*=}
        case "$pk_as_seen" in
          *" m:$pk_m "*) ctx_err "package install: --as names the module '$pk_m' twice"; exit 1 ;;
          *" a:$pk_al "*) ctx_err "package install: --as names the alias '$pk_al' twice"; exit 1 ;;
        esac
        pk_as_seen="$pk_as_seen m:$pk_m a:$pk_al "
        pk_as="${pk_as:+$pk_as }$pk_m=$pk_al"
        ;;
      *) set -- "$@" "$pk_a" ;;
    esac
  done
  if [ "$pk_verb" = install ] && [ $# -eq 0 ] && [ -z "$pk_as" ]; then
    package_declared_install
  fi
  if [ $# -ne 1 ]; then
    ctx_err "package $pk_verb: usage: ctx package $pk_verb <package>"
    exit 1
  fi
  case "$1" in
    */*)
      if [ ! -d "$1" ]; then
        ctx_err "package $pk_verb: no package root at $1"
        exit 1
      fi
      pk_arg=$(CDPATH= cd -- "$1" 2>/dev/null && pwd) || {
        ctx_err "package $pk_verb: cannot resolve $1"
        exit 2
      }
      ;;
    ""|.*|*[!A-Za-z0-9._-]*)
      ctx_err "package $pk_verb: malformed package name '$1' (letters, digits, dot, underscore, hyphen; not starting with a dot)"
      exit 1
      ;;
    *)
      if pk_arg=$(package_catalog_dir "$1"); then
        :
      elif [ "$pk_verb" = install ]; then
        ctx_err "package install: no package at .contexture/plugins/$1 or plugins/$1 (name a package root path, a value holding a slash, instead)"
        exit 1
      else
        pk_arg=$1
      fi
      ;;
  esac
  pk_script=$dir/package-$pk_verb
  if [ ! -f "$pk_script" ]; then
    ctx_err "package $pk_verb: missing package ${pk_verb}er"
    exit 2
  fi
  for pk_pair in $pk_as; do
    pk_m=${pk_pair%%=*}
    if [ ! -d "$pk_arg/.contexture/extensions/modules/$pk_m" ]; then
      ctx_err "package install: --as names no module of the package: '$pk_m'"
      exit 1
    fi
  done
  if [ ! -d "$root" ]; then
    ctx_err "package $pk_verb: cannot enter workspace root: $root"
    exit 2
  fi
  package_run "$pk_verb" "$pk_arg" "$pk_as"
  pk_rc=$?
  [ "$pk_rc" -eq 0 ] || exit "$pk_rc"
  # the declaration follows the act: an install writes its package.<name> line (the source as
  # given, a path inside the workspace kept relative to its root, and every alias the record
  # now holds), an uninstall removes it
  pk_name=${pk_arg##*/}
  if [ "$pk_verb" = uninstall ]; then
    pkg_decl_write "$pk_name" || { ctx_err "package uninstall: removed, but the workspace configuration's package.$pk_name line could not be removed"; exit 2; }
    exit 0
  fi
  case "$1" in
    */*)
      case "$pk_arg" in
        "$root"/*) pk_src="./${pk_arg#"$root"/}" ;;
        *) pk_src=$pk_arg ;;
      esac
      ;;
    *) pk_src=$1 ;;
  esac
  pk_flags=$(awk '$1 == "module" && NF == 3 && $2 != $3 { printf " --as=%s=%s", $3, $2 }' "$dir/extensions/.state/$pk_name.files" 2>/dev/null)
  pkg_decl_write "$pk_name" "$pk_src$pk_flags" || { ctx_err "package install: installed, but the workspace configuration's package.$pk_name line could not be written"; exit 2; }
  exit 0
}

# ---------------------------------------------------------------------------
# search: the builtin fan-out over every module that carries a verb named search, answered
# before discovery prints a warning (the discovery runs quiet, as every builtin's does);
# each module's search runs as a child with the shared flags only, bounded in time, and
# its answer is checked before it is trusted; one group per module, no ranking across them

search_line="  ctx search \"<query>\" [flags]     search every module that carries a search verb, one group per module; ctx search --modes lists modes; ctx search config manages search settings"

search_help() {
  cat <<'EOF'
usage: ctx search "<query>" [--type=<type>] [--mode=<mode>] [--limit=N] [--json] [--module=<name>]
       ctx search --modes [--json]
       ctx search config <subcommand> [args...]
runs every module that carries a verb named search, in discovery order, with the shared flags only (a module's own scope flags are never forwarded), and prints one group per module: its rows (type, address, snippet, read, label), failed with its reason, or not searched; no ranking crosses modules, and zero hits is an answer; a query cannot begin with a dash, which reads as a flag and refuses (no end of options marker, a stated limit)
--limit= is a positive whole number per module (default 20); --mode= takes exact, the one registered mode and the default (ctx search --modes lists it); --type= passes to every module; --module=<name> searches one module; only the --flag=value form is taken
each module runs bounded by search.timeout in the workspace configuration (a positive whole number of seconds, default 10); a module past it is stopped with every descendant one process snapshot finds, and reads failed (a process forked after the snapshot, or reparented before it by a double fork, may escape, a stated limit)
ctx search config manages search settings (load, get, set, unset, schema) in the workspace configuration; to search for the literal word 'config', put a flag first (for example, ctx search --mode=exact config)
exit codes: 0 every searched module answered (zero hits included, or no module carries a search verb); 1 a bad argument; 2 a module failed, the other groups still printed
EOF
}

search_refuse() {
  printf 'ctx search: %s\n' "$1" >&2
  exit 1
}

# search_timeout: the bound in seconds from the search.timeout line of the workspace
# configuration via config-lib; 10 when absent or empty
search_timeout() {
  if ! command -v cfg_get >/dev/null 2>&1; then
    printf 'ctx search: missing internal config library\n' >&2
    return 2
  fi
  st_v=$(cfg_get search.timeout "$dir")
  st_rc=$?
  if [ "$st_rc" -eq 2 ]; then
    exit 2
  elif [ "$st_rc" -ne 0 ] || [ -z "$st_v" ]; then
    st_v=10
  fi
  case "$st_v" in
    *[!0-9]*|0*) search_refuse "search.timeout takes a positive whole number of seconds: '$st_v'" ;;
  esac
  printf '%s\n' "$st_v"
}

# search_modes_list: the mode registry, one name TAB description line per mode, through the
# storage core's resolver; rc 2 with its one line when it cannot answer
search_modes_list() {
  sm_r="$dir/storage/scripts/driver-resolver"
  if [ ! -x "$sm_r" ]; then
    printf 'ctx search: the storage core resolver is missing, so the mode registry cannot answer\n' >&2
    return 2
  fi
  ( cd "$root" && CTX_ROOT=$root && export CTX_ROOT && exec "$sm_r" modes < /dev/null )
}

# search_tree <pid>: the pid and every descendant, from one ps snapshot
search_tree() {
  ps -A -o pid= -o ppid= 2>/dev/null | awk -v r="$1" '
    { P[$1] = $2 }
    END {
      S[r] = 1
      do { c = 0; for (p in P) if (!(p in S) && (P[p] in S)) { S[p] = 1; c = 1 } } while (c)
      for (p in S) printf "%s ", p
    }'
}

# search_stop <pid>: the pid and every descendant from one snapshot, TERM then KILL 0.2 s
# later, then reaped; the caller discards stderr, where a shell reports a signalled job
search_stop() {
  ss_set=$(search_tree "$1")
  # shellcheck disable=SC2086
  kill -TERM $ss_set 2>/dev/null
  sleep 0.2 2>/dev/null || sleep 1
  # shellcheck disable=SC2086
  kill -KILL $ss_set 2>/dev/null
  wait "$1"
}

# search_abort <rc>: a hangup, interrupt, or termination of the run stops the running child
# with every descendant (a background child ignores an interrupt) and removes the run's
# scratch before the engine exits
search_abort() {
  trap - HUP INT TERM
  [ -z "$sc_pid" ] || { search_stop "$sc_pid"; } 2>/dev/null
  rm -rf "$root/.contexture/tmp/verb.$$.search-"* "$CTX_SCRATCH_ROOT" 2>/dev/null
  exit "$1"
}

# search_child <module> <module dir> <args>...: one module's search run as a child with
# the dispatch exports, its own scratch root, no stdin, and the fan-out marker; its stdout
# and stderr land in files, never a pipe a survivor could hold; past the
# bound the child and every descendant are stopped (TERM, then KILL); SC_ROOT, SC_RC (empty
# when it was stopped)
search_child() {
  sc_m=$1; sc_md=$2
  shift 2
  search_n=$((search_n + 1))
  # the child owns its scratch root (a verb may remove it on return), so its streams and
  # its exit code land in a sibling folder; both names carry this engine's pid, so the
  # dead pid sweep removes what a SIGKILL leaves
  SC_ROOT="$root/.contexture/tmp/verb.$$.search-$search_n.io"
  sc_scratch="$root/.contexture/tmp/verb.$$.search-$search_n"
  rm -rf "$SC_ROOT" "$sc_scratch" 2>/dev/null
  mkdir -p "$SC_ROOT" "$sc_scratch" || { SC_RC=""; return 1; }
  (
    cd "$root" || exit 2
    CTX_ROOT=$root CTX_MODULE_DIR=$sc_md CTX_BIN=$ctx_bin CTX_SCRATCH_ROOT=$sc_scratch CTX_SEARCH_FANOUT=1 LC_ALL=C
    export CTX_ROOT CTX_MODULE_DIR CTX_BIN CTX_SCRATCH_ROOT CTX_SEARCH_FANOUT LC_ALL
    if [ -x "$sc_md/scripts/search" ]; then "$sc_md/scripts/search" "$@"; else sh "$sc_md/scripts/search" "$@"; fi
    printf '%s\n' "$?" > "$SC_ROOT/rc"
  ) < /dev/null > "$SC_ROOT/out" 2> "$SC_ROOT/err" &
  sc_pid=$!
  sc_t=0
  while [ ! -f "$SC_ROOT/rc" ] && kill -0 "$sc_pid" 2>/dev/null && [ "$sc_t" -lt "$search_ticks" ]; do
    sleep "$search_tick" 2>/dev/null || sleep 1
    sc_t=$((sc_t + 1))
  done
  if [ ! -f "$SC_ROOT/rc" ] && kill -0 "$sc_pid" 2>/dev/null; then
    { search_stop "$sc_pid"; } 2>/dev/null
  else
    wait "$sc_pid" 2>/dev/null
  fi
  sc_pid=""
  SC_RC=""
  [ -f "$SC_ROOT/rc" ] && SC_RC=$(cat "$SC_ROOT/rc")
  return 0
}

# the group program: the flat lines (json.awk) of one module's answer on stdin; with
# SG_CHECK it prints the first defect of the answer (a missing total or rows, a row missing a
# shared field, a row of another module) or nothing; else it prints the group, as JSON
# (SG_JSON=1) or as text. A string value is re-encoded from the flattener's payload escape.
search_group_awk='
function jq(s,   n, p, o, i, c, r) {
  n = split(s, p, /"/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\"" p[i]
  if (o ~ /[[:cntrl:]]/) {
    r = ""
    for (i = 1; i <= length(o); i++) { c = substr(o, i, 1); if (c ~ /[[:cntrl:]]/ && (c in ORD)) r = r sprintf("\\u%04x", ORD[c]); else r = r c }
    o = r
  }
  return "\"" o "\""
}
function txt(s,   n, p, i, o) { n = split(s, p, /\\\\/); o = ""; for (i = 1; i <= n; i++) { gsub(/\\[ntr]/, " ", p[i]); o = o (i > 1 ? "\\" : "") p[i] }; return o }
BEGIN { for (i = 1; i < 32; i++) ORD[sprintf("%c", i)] = i; ORD[sprintf("%c", 127)] = 127; split("module container type id address snippet read label", K, " "); NK = 8 }
{
  if ($0 ~ /^rows#[0-9]+$/) { NR_ = substr($0, 6) + 0; HAS_ROWS = 1; next }
  if ($0 ~ /^total:[0-9]+$/) { TOTAL = substr($0, 7) + 0; HAS_TOTAL = 1; next }
  if (index($0, "mode=") == 1) { MODE = substr($0, 6); next }
  eq = index($0, "=")
  if (eq == 0) next
  path = substr($0, 1, eq - 1)
  if (path !~ /^rows\.[0-9]+\.[a-z_]+$/) next
  split(path, P, ".")
  V[P[2] + 0, P[3]] = substr($0, eq + 1)
  HAS[P[2] + 0, P[3]] = 1
}
END {
  m = ENVIRON["SG_MODULE"]
  if (ENVIRON["SG_CHECK"] == "1") {
    if (!HAS_TOTAL) { print "the answer carries no total"; exit }
    if (!HAS_ROWS) { print "the answer carries no rows"; exit }
    for (i = 1; i <= NR_; i++) {
      for (k = 1; k <= 7; k++) if (!HAS[i, K[k]]) { print "row " i " carries no " K[k]; exit }
      if (V[i, "module"] != m) { print "row " i " names module " V[i, "module"]; exit }
    }
    exit
  }
  if (MODE == "") MODE = ENVIRON["SG_ASKED"]
  if (ENVIRON["SG_JSON"] == "1") {
    printf "{\"module\":%s,%s\"status\":\"ok\",\"mode\":%s,\"total\":%d,\"rows\":[", jq(m), (ENVIRON["SG_ALIAS"] != "" ? "\"alias\":" jq(ENVIRON["SG_ALIAS"]) "," : ""), jq(MODE), TOTAL
    for (i = 1; i <= NR_; i++) {
      printf "%s{", (i > 1 ? "," : "")
      f = 0
      for (k = 1; k <= NK; k++) if (HAS[i, K[k]]) { printf "%s\"%s\":%s", (f ? "," : ""), K[k], jq(V[i, K[k]]); f = 1 }
      printf "}"
    }
    printf "]}"
    exit
  }
  printf "%s%s: %d of %d", m, (ENVIRON["SG_ALIAS"] != "" ? " (alias of " ENVIRON["SG_ALIAS"] ")" : ""), NR_, TOTAL
  printf "\n"
  for (i = 1; i <= NR_; i++) {
    printf "  %s %s%s: %s\n", txt(V[i, "type"]), txt(V[i, "address"]), (HAS[i, "label"] ? " [" txt(V[i, "label"]) "]" : ""), txt(V[i, "snippet"])
    printf "    read: %s\n", txt(V[i, "read"])
  }
}'

search_builtin() {
  if [ $# -eq 1 ]; then
    case "$1" in --help|-h) search_help; exit 0 ;; esac
  fi
  if [ "${1:-}" = "config" ]; then
    shift
    if ! command -v config_owner_verb >/dev/null 2>&1; then
      ctx_err "search config: missing internal config library"
      exit 2
    fi
    CTX_DIR=$dir CTX_ROOT=$root config_owner_verb search "ctx search config" "" "$@"
    exit $?
  fi
  sb_q=""; sb_qset=0; sb_type=""; sb_mode=exact; sb_limit=20; sb_json=0; sb_module=""; sb_modset=0; sb_modes=0; sb_flags=0
  for sb_a in "$@"; do
    case "$sb_a" in
      --type=*) sb_type=${sb_a#--type=}; sb_flags=1 ;;
      --mode=*) sb_mode=${sb_a#--mode=}; sb_flags=1 ;;
      --limit=*) sb_limit=${sb_a#--limit=}; sb_flags=1 ;;
      --module=*) sb_module=${sb_a#--module=}; sb_modset=1; sb_flags=1 ;;
      --json) sb_json=1 ;;
      --modes) sb_modes=1 ;;
      -*) search_refuse "unknown option '$sb_a' (the --flag=value forms: --type=, --mode=, --limit=, --module=, and --json; or --modes)" ;;
      *)
        [ "$sb_qset" -eq 0 ] || search_refuse "unexpected argument '$sb_a' (one query)"
        sb_q=$sb_a; sb_qset=1
        ;;
    esac
  done
  if [ "$sb_modes" -eq 1 ]; then
    [ "$sb_qset" -eq 0 ] && [ "$sb_flags" -eq 0 ] || search_refuse "--modes takes no query and no flag but --json"
    sb_reg=$(search_modes_list) || exit 2
    if [ "$sb_json" -eq 1 ]; then
      printf '%s\n' "$sb_reg" | awk -F '\t' '
        function jq(s, n, p, o, i) { n = split(s, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; n = split(o, p, /"/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\"" p[i]; return "\"" o "\"" }
        $1 != "" { o = o (o == "" ? "" : ",") "{\"name\":" jq($1) ",\"description\":" jq($2) "}" }
        END { print "[" o "]" }'
    else
      printf '%s\n' "$sb_reg" | awk -F '\t' '$1 != "" { printf "%-10s %s\n", $1, $2 }'
    fi
    exit 0
  fi
  [ "$sb_qset" -eq 1 ] || search_refuse "a query is required: ctx search \"<query>\" (or ctx search --modes)"
  sb_cr=$(printf '\r')
  case "$sb_q" in *"$sb_cr"*) search_refuse "a carriage return in the query" ;; esac
  case "$sb_q" in *"
"*) search_refuse "a newline in the query (one line)" ;; esac
  case "$sb_q" in *[![:space:]]*) ;; *) search_refuse "empty query" ;; esac
  case "$sb_limit" in ""|*[!0-9]*|0*) search_refuse "--limit takes a positive whole number: '$sb_limit'" ;; esac
  case "$sb_mode" in ""|[!a-z]*|*[!a-z0-9_-]*) search_refuse "malformed mode '$sb_mode'" ;; esac
  case "$sb_type" in *[!A-Za-z0-9_.-]*) search_refuse "malformed type '$sb_type'" ;; esac
  if [ "$sb_mode" != exact ]; then
    sb_reg=$(search_modes_list) || exit 2
    printf '%s\n' "$sb_reg" | awk -F '\t' -v m="$sb_mode" '$1 == m { f = 1 } END { exit !f }' ||
      search_refuse "mode '$sb_mode' is not registered; registered modes: $(printf '%s\n' "$sb_reg" | awk -F '\t' '$1 != "" { o = o (o == "" ? "" : ", ") $1 } END { print o }')"
  fi
  sb_timeout=$(search_timeout) || exit $?
  if sleep 0.1 2>/dev/null; then search_tick=0.1; search_ticks=$((sb_timeout * 10)); else search_tick=1; search_ticks=$sb_timeout; fi
  sb_json_awk="$dir/storage/scripts/json.awk"
  [ -f "$sb_json_awk" ] || { printf 'ctx search: the storage core flattener is missing\n' >&2; exit 2; }

  # discovery, quiet: every listed module in discovery order, then whether it carries search
  sb_mods=$(module_names 2>/dev/null)
  if [ "$sb_modset" -eq 1 ]; then
    [ -n "$sb_module" ] || search_refuse "--module= names no module"
    if ! printf '%s\n' "$sb_mods" | grep -qxF -- "$sb_module"; then
      # an origin name: the one module installed under an alias of it answers for it
      sb_by=""
      for sb_c in $sb_mods; do
        sb_o=$(module_alias_of "$sb_c")
        [ "${sb_o%% *}" = "$sb_module" ] && sb_by="$sb_by${sb_by:+ }$sb_c"
      done
      case "$sb_by" in
        "") search_refuse "unknown module $sb_module" ;;
        *" "*) search_refuse "module $sb_module is installed under several aliases ($sb_by); name one" ;;
      esac
      sb_module=$sb_by
    fi
    verb_exists "$(module_dir "$sb_module")" search 2>/dev/null || search_refuse "module $sb_module carries no search verb"
    sb_mods=$sb_module
  fi
  if ! cd "$root"; then
    printf 'ctx search: cannot enter workspace root: %s\n' "$root" >&2
    exit 2
  fi
  verb_scratch
  search_n=0
  sc_pid=""
  trap 'search_abort 129' HUP
  trap 'search_abort 130' INT
  trap 'search_abort 143' TERM
  set -- "$sb_q"
  [ -z "$sb_type" ] || set -- "$@" "--type=$sb_type"
  set -- "$@" "--mode=$sb_mode" "--limit=$sb_limit" --json
  sb_groups=""; sb_text=""; sb_searched=0; sb_failed=0; sb_fnames=""; sb_none=0; sb_nnames=""; sb_errs=""
  sb_nl='
'
  for sb_m in $sb_mods; do
    sb_md=$(module_dir "$sb_m") || continue
    sb_alias=$(module_alias_of "$sb_m")
    sb_alias=${sb_alias%% *}
    sb_akey=""
    [ -z "$sb_alias" ] || sb_akey="\"alias\":\"$sb_alias\","
    if ! verb_exists "$sb_md" search 2>/dev/null; then
      sb_none=$((sb_none + 1)); sb_nnames="$sb_nnames${sb_nnames:+, }$sb_m"
      sb_groups="$sb_groups${sb_groups:+,}{\"module\":\"$sb_m\",$sb_akey\"status\":\"not searched\"}"
      continue
    fi
    sb_searched=$((sb_searched + 1))
    search_child "$sb_m" "$sb_md" "$@"
    sb_reason=""
    if [ -z "$SC_RC" ]; then
      sb_reason="no answer within the bound of $sb_timeout s (search.timeout)"
    elif [ "$SC_RC" != 0 ]; then
      sb_reason=$(head -n 1 "$SC_ROOT/err" 2>/dev/null)
      [ -n "$sb_reason" ] || sb_reason="the search exited $SC_RC"
    elif ! awk -f "$sb_json_awk" < "$SC_ROOT/out" > "$SC_ROOT/flat" 2> "$SC_ROOT/flat.err"; then
      sb_reason="malformed answer: $(head -n 1 "$SC_ROOT/flat.err" 2>/dev/null)"
    else
      sb_reason=$(SG_CHECK=1 SG_MODULE=$sb_m awk "$search_group_awk" < "$SC_ROOT/flat")
    fi
    if [ -n "$sb_reason" ]; then
      sb_failed=$((sb_failed + 1)); sb_fnames="$sb_fnames${sb_fnames:+, }$sb_m"
      sb_g=$(printf '%s' "$sb_reason" | SG_MODULE=$sb_m SG_AKEY=$sb_akey awk '{ r = r $0 } END { n = split(r, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; n = split(o, p, /"/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\"" p[i]; gsub(/[[:cntrl:]]/, " ", o); printf "{\"module\":\"%s\",%s\"status\":\"failed\",\"error\":\"%s\"}", ENVIRON["SG_MODULE"], ENVIRON["SG_AKEY"], o }')
      sb_groups="$sb_groups${sb_groups:+,}$sb_g"
      sb_text="$sb_text$sb_m${sb_alias:+ (alias of $sb_alias)}: failed: $sb_reason$sb_nl"
    else
      sb_groups="$sb_groups${sb_groups:+,}$(SG_JSON=1 SG_MODULE=$sb_m SG_ALIAS=$sb_alias SG_ASKED=$sb_mode awk "$search_group_awk" < "$SC_ROOT/flat")"
      sb_text="$sb_text$(SG_MODULE=$sb_m SG_ALIAS=$sb_alias SG_ASKED=$sb_mode awk "$search_group_awk" < "$SC_ROOT/flat")$sb_nl"
      [ -s "$SC_ROOT/err" ] && sb_errs="$sb_errs$(awk -v m="$sb_m" '{ print m ": " $0 }' "$SC_ROOT/err")$sb_nl"
    fi
    rm -rf "$SC_ROOT" "$root/.contexture/tmp/verb.$$.search-$search_n" 2>/dev/null
  done
  rm -rf "$CTX_SCRATCH_ROOT" 2>/dev/null
  if [ "$sb_json" -eq 1 ]; then
    printf '{"query":%s,"groups":[%s]}\n' "$(printf '%s' "$sb_q" | awk 'BEGIN { for (i = 1; i < 32; i++) ORD[sprintf("%c", i)] = i; ORD[sprintf("%c", 127)] = 127 } { r = r $0 } END { n = split(r, p, /\\/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\\" p[i]; n = split(o, p, /"/); o = (n ? p[1] : ""); for (i = 2; i <= n; i++) o = o "\\" "\"" p[i]; r = ""; for (i = 1; i <= length(o); i++) { c = substr(o, i, 1); r = r ((c in ORD) ? sprintf("\\u%04x", ORD[c]) : c) }; printf "\"%s\"", r }')" "$sb_groups"
  else
    printf '%s' "$sb_text"
    printf 'searched %s, failed %s%s, not searched %s%s' "$sb_searched" "$sb_failed" "${sb_fnames:+ ($sb_fnames)}" "$sb_none" "${sb_nnames:+ ($sb_nnames)}"
    [ "$sb_searched" -gt 0 ] || printf ': no module carries a search verb'
    printf '\n'
  fi
  [ -z "$sb_errs" ] || printf '%s' "$sb_errs" >&2
  [ "$sb_failed" -eq 0 ] || exit 2
  exit 0
}

# ---------------------------------------------------------------------------
# config: read-only workspace configuration assembly, answered before discovery
# so a broken module never blocks inspecting configuration. Mutations belong
# to each owning domain verb (ctx store config, ctx search config, ctx package,
# and each module's ctx <module> config).

config_load_line="  ctx config load [--module=<ns>] [--json]  assemble effective workspace configuration; read only"
config_get_line="  ctx config get <ns>.<key>        read one effective configuration value; read only"
config_schema_line="  ctx config schema [<ns>] [--json]  show declared configuration schemas; read only"

show_config_help() {
  cat <<'EOF'
ctx config: inspect effective workspace configuration and declared schemas (read only)

usage:
  ctx config load [--module=<ns>] [--json]  assemble effective workspace configuration; unset keys without defaults are omitted
  ctx config get <ns>.<key>                 read one effective configuration value by <namespace>.<key>
  ctx config schema [<ns>] [--json]         show declared configuration schemas across core and modules
  ctx config help [<sub-verb>]              show this summary or one sub-verb's detail

notes:
  ctx config is read only; change settings through their owning verbs:
  ctx store config, ctx search config, ctx package, or ctx <module> config
EOF
}

show_config_verb_help() {
  case "$1" in
    load)
      cat <<'EOF'
usage: ctx config load [--module=<ns>] [--json]
assembles effective workspace configuration from declared schemas and the workspace configuration; unset keys without defaults are omitted and package declarations are excluded
--module=<ns>: limit output to one configuration namespace
--json: emit one compact JSON object on stdout
exit codes: 0 assembled (warnings for undeclared or legacy keys print on stderr without failing); 1 bad flag, unknown namespace, or malformed schema; 2 unreadable configuration or schema
EOF
      ;;
    get)
      cat <<'EOF'
usage: ctx config get <namespace>.<key>
reads one effective configuration value from the workspace configuration or its schema default; package declarations are managed by ctx package list
exit codes: 0 value printed; 1 unknown namespace, unknown key, unset key without default, or package.* query; 2 unreadable configuration
EOF
      ;;
    schema)
      cat <<'EOF'
usage: ctx config schema [<namespace>] [--json]
shows declared configuration schemas, types, bounds, defaults, and descriptions across core and discovered modules
--json: emit one compact JSON object on stdout
exit codes: 0 schemas printed; 1 bad flag, unknown namespace, or malformed schema; 2 unreadable schema
EOF
      ;;
    help)
      cat <<'EOF'
usage: ctx config help [<sub-verb>]
prints the ctx config command summary or detail for one sub-verb (load, get, schema, help)
exit codes: 0 help printed; 1 unknown sub-verb or extra argument
EOF
      ;;
    *)
      ctx_err "config help: unknown sub-verb '$1' (load, get, schema, or help)"
      return 1
      ;;
  esac
  return 0
}

config_builtin() {
  case "${1:-}" in
    ""|--help|-h)
      if [ $# -gt 1 ]; then
        ctx_err "config: $1 takes no argument; ctx config help <sub-verb> prints one sub-verb's detail"
        exit 1
      fi
      show_config_help
      exit 0
      ;;
    help)
      shift
      if [ $# -eq 1 ]; then
        case "$1" in
          --help|-h)
            show_config_verb_help help
            exit 0
            ;;
        esac
      fi
      if [ $# -eq 0 ]; then
        show_config_help
        exit 0
      fi
      if [ $# -gt 1 ]; then
        ctx_err "config help: takes at most one sub-verb name"
        exit 1
      fi
      show_config_verb_help "$1" || exit 1
      exit 0
      ;;
    set|unset)
      ctx_err "config $1: ctx config is read only; use the owning domain verb: ctx store config, ctx search config, ctx package, or ctx <module> config"
      exit 1
      ;;
    load|get|schema)
      ;;
    *)
      ctx_err "config: unknown sub-verb: $1 (ctx config load, ctx config get, ctx config schema, or ctx config help)"
      exit 1
      ;;
  esac

  if ! command -v cfg_assembly_load >/dev/null 2>&1; then
    ctx_err "config: missing internal config library"
    exit 2
  fi

  cb_verb=$1
  shift
  if [ $# -eq 1 ]; then
    case "$1" in
      --help|-h)
        show_config_verb_help "$cb_verb"
        exit 0
        ;;
    esac
  fi

  case "$cb_verb" in
    load)
      cb_mod=""
      cb_json=0
      for cb_a in "$@"; do
        case "$cb_a" in
          --module=)
            ctx_err "config load: --module= names no namespace"
            exit 1
            ;;
          --module=*)
            cb_mod=$cb_a
            ;;
          --json)
            cb_json=1
            ;;
          -*)
            ctx_err "config load: unknown option '$cb_a' (ctx config load [--module=<ns>] [--json])"
            exit 1
            ;;
          *)
            ctx_err "config load: unexpected argument '$cb_a' (ctx config load [--module=<ns>] [--json])"
            exit 1
            ;;
        esac
      done
      set -- "ctx config" "$dir"
      [ -z "$cb_mod" ] || set -- "$@" "$cb_mod"
      [ "$cb_json" -eq 0 ] || set -- "$@" --json
      cfg_assembly_load "$@"
      exit $?
      ;;
    get)
      if [ $# -ne 1 ]; then
        ctx_err "config get: usage: ctx config get <namespace>.<key>"
        exit 1
      fi
      case "$1" in
        -*)
          ctx_err "config get: unknown option '$1' (ctx config get <namespace>.<key>)"
          exit 1
          ;;
      esac
      cfg_assembly_get "ctx config" "$dir" "$1"
      exit $?
      ;;
    schema)
      cfg_assembly_schema "ctx config" "$dir" "$@"
      exit $?
      ;;
  esac
}

# ---------------------------------------------------------------------------
# top-level dispatch

if [ $# -eq 0 ]; then
  show_top_help
  exit 0
fi

case "$1" in
  --help|-h)
    if [ $# -ne 1 ]; then
      ctx_err "unknown command: $1"
      exit 1
    fi
    show_top_help
    exit 0
    ;;
  help)
    shift
    if [ $# -eq 0 ]; then
      show_top_help
      exit 0
    fi
    if [ $# -eq 1 ] && [ "$1" = "--all" ]; then
      show_top_help
      if ! show_module_help_blocks; then
        exit 1
      fi
      exit 0
    fi
    ctx_err "help accepts only --all as an extra argument"
    exit 1
    ;;
  run)
    shift
    run_body "$@"
    ;;
  compose)
    shift
    compose_builtin "$@"
    ;;
  package)
    shift
    package_builtin "$@"
    ;;
  search)
    shift
    search_builtin "$@"
    ;;
  config)
    shift
    config_builtin "$@"
    ;;
  _hooks)
    shift
    run_hooks "$@"
    exit 0
    ;;
  _module)
    shift
    module_reader "$@"
    ;;
  _package)
    shift
    package_reader "$@"
    ;;
  _reserved)
    shift
    if [ $# -ne 1 ]; then
      ctx_err "_reserved: usage: ctx _reserved <name>"
      exit 1
    fi
    load_unit_verbs
    if is_reserved "$1"; then
      exit 0
    fi
    exit 1
    ;;
  _builtin)
    shift
    if [ $# -ne 1 ]; then
      ctx_err "_builtin: usage: ctx _builtin <name>"
      exit 1
    fi
    if is_builtin "$1"; then
      exit 0
    fi
    exit 1
    ;;
esac

target=$1
shift

# discovery warnings (reserved, broken shapes) surface on every dispatch attempt
mods=$(module_names)

# the record's namespace moved at the unit module: the old target is gone, never an
# alias (the break is named; the help lists ctx unit)
if [ "$target" = "session" ]; then
  printf 'ctx session retired: use ctx unit\n' >&2
  exit 1
fi

# ctx adopts the workspace root before dispatch (the engine contract)
if ! cd "$root"; then
  ctx_err "cannot enter workspace root: $root"
  exit 1
fi

found_target=""
while IFS= read -r n; do
  [ -n "$n" ] || continue
  if [ "$n" = "$target" ]; then
    found_target=$n
    break
  fi
done <<EOF
$mods
EOF

if [ -z "$found_target" ]; then
  ctx_err "unknown command: $target"
  exit 1
fi

md=$(module_dir "$found_target") || {
  ctx_err "unknown command: $target"
  exit 1
}

# bare ctx <module> prints the module help rc0
if [ $# -eq 0 ]; then
  show_module_help "$found_target"
  exit 0
fi

case "$1" in
  help|--help|-h)
    shift
    if [ $# -eq 0 ]; then
      show_module_help "$found_target"
      exit 0
    fi
    if [ $# -eq 1 ] && verb_exists "$md" "$1"; then
      show_verb_help "$found_target" "$1"
      exit 0
    fi
    if [ $# -eq 1 ] && [ "$found_target" = unit ] && repl=$(retired_replacement "$1"); then
      printf 'ctx unit %s retired: %s\n' "$1" "$repl" >&2
      exit 1
    fi
    ctx_err "unknown verb: $1"
    show_module_help "$found_target" >&2
    exit 1
    ;;
  --diagnose)
    shift
    if verb_exists "$md" "diagnose"; then
      CTX_ROOT="$root"
      CTX_MODULE_DIR="$md"
      CTX_BIN="$ctx_bin"
      export CTX_ROOT CTX_MODULE_DIR CTX_BIN
      LC_ALL=C
      export LC_ALL
      exec "$md/scripts/diagnose" "$@"
    fi
    ctx_err "$found_target does not support --diagnose"
    exit 1
    ;;
esac

verb=$1
if [ "$found_target" = unit ] && repl=$(retired_replacement "$verb"); then
  printf 'ctx unit %s retired: %s\n' "$verb" "$repl" >&2
  exit 1
fi
if ! verb_exists "$md" "$verb"; then
  ctx_err "unknown verb: $verb"
  show_module_help "$found_target" >&2
  exit 1
fi
shift

# --help and -h after an awk verb print the verb's help table (the table ctx <module>
# help <verb> prints): an awk interpreter reads a leading dash argument as its own option,
# so the verb itself would never see it; shell verbs answer their own --help
case "${1:-}" in
  --help|-h)
    if [ $# -eq 1 ] && head -n 1 "$md/scripts/$verb" | grep -q '^#!.*awk'; then
      show_verb_help "$found_target" "$verb"
      exit 0
    fi
    ;;
esac

CTX_ROOT="$root"
CTX_MODULE_DIR="$md"
CTX_BIN="$ctx_bin"
export CTX_ROOT CTX_MODULE_DIR CTX_BIN
LC_ALL=C
export LC_ALL
verb_scratch
exec "$md/scripts/$verb" "$@"
