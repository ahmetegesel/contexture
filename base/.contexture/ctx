#!/bin/sh
# ctx: the workspace module engine: discovery, assembly, dispatch, run, hooks
# Zero-install: POSIX /bin/sh, awk, and core OS utilities only.
#
# Usage: ctx [help [--all]] | ctx run <cmd> [args...] | ctx <module> [args...]
# The help output is the contract surface; this header never prints.
#
# Maintainer note (off-path, never taught by help or top docs):
# discovery reads .contexture/modules/<name>/; the directory name is the
# module name. The module file is literally named "module" and carries
# "# summary: <line>"; scripts/<verb> files are verbs named by file name,
# marked by their own "# summary:" header, with repeatable "# usage:" and
# "# help:" detail lines. A scripts file without a summary is private and
# ignored. A module file without a summary warns and skips; a scripts/
# directory without a module file warns and skips; a directory with neither
# (a filter-only or hook-only module) is legal, silent, and unlisted.
# Reserved names are the session verb set plus run and hooks; the builtin
# session and run are allowed. A duplicate verb shadows: first file name
# wins with a warning. Help is engine-owned (no help script): ctx help,
# ctx help --all, ctx <module> help, ctx <module> help <verb>, and bare
# ctx <module> (module table, rc0). Dispatch validates the verb engine-side
# (unknown rc1, module help on stderr), chdirs to the workspace root, and
# execs scripts/<verb> with the remaining argv, exporting CTX_ROOT,
# CTX_MODULE_DIR, CTX_BIN, and LC_ALL=C. Hooks are files under
# modules/*/hooks/ declaring "# ctx-hook: <point>" and optionally
# "# ctx-hook-mode: block"; the engine runs them in module-name (LC_ALL=C)
# then file-name order. Filters live under modules/run/filters/ (scanned
# first) and modules/*/filters/ (name-sorted after); a later match warns as
# a shadow unless its header carries "# ctx-filter-priority: over". The
# built-in run owns the compaction selection body; runner notices read
# [ctx: ...].

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$dir/.." && pwd)
modules_root="$dir/modules"
ctx_bin="$dir/ctx"

ctx_err() {
  printf 'ctx: %s\n' "$*" >&2
}

header_field() {
  # first value of a header line, trimmed of surrounding whitespace
  sed -n "s/^# $2: //p" "$1" | head -n 1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

header_values() {
  # every value of a header line, in file order, trimmed
  sed -n "s/^# $2: //p" "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# ---------------------------------------------------------------------------
# reserved names: the session verb set (its scripts own the list) plus
# refresh, run, and hooks; the builtin session and run are allowed

session_verbs=""
session_verbs_loaded=0

load_session_verbs() {
  if [ "$session_verbs_loaded" -eq 1 ]; then
    return 0
  fi
  session_verbs_loaded=1
  verbs=""
  sd="$modules_root/session/scripts"
  if [ -d "$sd" ]; then
    for f in "$sd"/*; do
      [ -f "$f" ] || continue
      b=${f##*/}
      case "$b" in
        ""|.*|*[[:space:]]*)
          continue
          ;;
      esac
      [ -n "$(header_field "$f" summary)" ] || continue
      verbs="$verbs $b"
    done
  fi
  session_verbs="help${verbs}"
}

is_reserved() {
  case "$1" in
    refresh|run|hooks)
      return 0
      ;;
  esac
  case " $session_verbs " in
    *" $1 "*)
      return 0
      ;;
  esac
  return 1
}

# ---------------------------------------------------------------------------
# discovery

scan_module_dirs() {
  # every module candidate directory, name-sorted; reserved and hidden names
  # stay out silently (the listing path owns the warnings)
  [ -d "$modules_root" ] || return 0
  load_session_verbs
  for d in "$modules_root"/*/; do
    [ -d "$d" ] || continue
    bn=${d%/}
    bn=${bn##*/}
    case "$bn" in
      ""|.*|*[[:space:]]*|_hooks)
        continue
        ;;
    esac
    if is_reserved "$bn" && [ "$bn" != "session" ] && [ "$bn" != "run" ]; then
      continue
    fi
    printf '%s\n' "$bn"
  done | LC_ALL=C sort
}

module_names() {
  # listed modules: a module file with a "# summary:" line; broken shapes
  # warn and skip, filter-only and hook-only directories stay unlisted
  [ -d "$modules_root" ] || return 0
  load_session_verbs
  for d in "$modules_root"/*/; do
    [ -d "$d" ] || continue
    n=${d%/}
    n=${n##*/}
    case "$n" in
      ""|.*|*[[:space:]]*|_hooks)
        continue
        ;;
    esac
    if is_reserved "$n" && [ "$n" != "session" ] && [ "$n" != "run" ]; then
      ctx_err "reserved name refused (shadow): $n"
      continue
    fi
    if [ -f "$d/module" ]; then
      if [ -z "$(header_field "$d/module" summary)" ]; then
        ctx_err "skipping module $n: module file has no summary"
        continue
      fi
    elif [ -d "$d/scripts" ]; then
      ctx_err "skipping module $n: scripts/ without a module file"
      continue
    else
      continue
    fi
    printf '%s\n' "$n"
  done | LC_ALL=C sort
}

verb_names() {
  # a module's verbs: extension-less scripts carrying a "# summary:" header,
  # name-sorted (LC_ALL=C); private files are ignored; a duplicate verb
  # shadows with a warning and the first file name wins; help stays
  # engine-owned
  sd="$1/scripts"
  [ -d "$sd" ] || return 0
  raw=""
  for f in "$sd"/*; do
    [ -f "$f" ] || continue
    b=${f##*/}
    case "$b" in
      ""|.*|*[[:space:]]*)
        continue
        ;;
    esac
    [ -n "$(header_field "$f" summary)" ] || continue
    raw="$raw $b"
  done
  [ -n "$raw" ] || return 0
  raw=$(printf '%s\n' ${raw# } | LC_ALL=C sort)
  out=""
  seen=""
  for b in $raw; do
    case " $seen " in
      *" $b "*)
        ctx_err "duplicate verb shadowed: ${1##*/}: $b (first file name wins)"
        continue
        ;;
    esac
    if [ "$b" = "help" ]; then
      ctx_err "help is engine-owned; ignoring scripts/help in ${1##*/}"
      continue
    fi
    seen="$seen $b"
    out="$out $b"
  done
  [ -n "$out" ] || return 0
  printf '%s\n' ${out# }
}

module_summary() {
  header_field "$1/module" summary
}

verb_summary() {
  header_field "$1/scripts/$2" summary
}

verb_detail() {
  header_values "$1/scripts/$2" "$3"
}

verb_exists() {
  for v in $(verb_names "$1"); do
    if [ "$v" = "$2" ]; then
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# assembly: help is engine-owned

show_top_help() {
  cat <<'EOF'
ctx: the workspace command binder

usage:
  ctx                              this summary
  ctx help [--all]                 this summary; --all also prints every module's help block
  ctx run <cmd> [args...]          run a command through stream compaction; the command's exit code is preserved
  cmd | ctx run                    pipe form: compact a stream
  ctx <module> [args...]           dispatch to a module: arguments, streams, and exit code pass through
  ctx <module> help [<verb>]       the module's verb table; one verb's detail with <verb>
EOF
  printf '\nmodules:\n'
  mods=$(module_names)
  if [ -z "$mods" ]; then
    printf '  (none discovered)\n'
    return 0
  fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf '  %-10s %s\n' "$n" "$(module_summary "$modules_root/$n")"
  done <<EOF
$mods
EOF
  return 0
}

show_module_help() {
  m="$modules_root/$1"
  printf 'ctx %s: %s\n\n' "$1" "$(module_summary "$m")"
  printf 'usage:\n'
  printf '  ctx %s <verb> [args...]\n' "$1"
  printf '  ctx %s help [<verb>]\n' "$1"
  verbs=$(verb_names "$m")
  printf '\nverbs:\n'
  if [ -z "$verbs" ]; then
    printf '  (none)\n'
    return 0
  fi
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    printf '  %-10s %s\n' "$v" "$(verb_summary "$m" "$v")"
  done <<EOF
$verbs
EOF
  printf '\ndetail: ctx %s help <verb>\n' "$1"
  return 0
}

show_verb_help() {
  m="$modules_root/$1"
  printf 'ctx %s %s: %s\n' "$1" "$2" "$(verb_summary "$m" "$2")"
  usages=$(verb_detail "$m" "$2" usage)
  if [ -n "$usages" ]; then
    printf '\nusage:\n'
    printf '%s\n' "$usages" | while IFS= read -r l; do
      [ -n "$l" ] && printf '  %s\n' "$l"
    done
  fi
  helps=$(verb_detail "$m" "$2" help)
  if [ -n "$helps" ]; then
    printf '\nhelp:\n'
    printf '%s\n' "$helps" | while IFS= read -r l; do
      [ -n "$l" ] && printf '  %s\n' "$l"
    done
  fi
  return 0
}

show_module_help_blocks() {
  mods=$(module_names)
  [ -n "$mods" ] || return 0
  if ! cd "$root"; then
    ctx_err "cannot enter workspace root: $root"
    return 1
  fi
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    printf '\nmodule %s:\n' "$n"
    show_module_help "$n"
  done <<EOF
$mods
EOF
  return 0
}

# ---------------------------------------------------------------------------
# built-in run: the selection body (one home). Labels and usage always read
# ctx run; bracketed operational notices read [ctx: ...]. The
# COMPACT_DISABLE and COMPACT_DEBUG contracts are unchanged.
run_body() {
  set -e
  run_label="ctx run"
  run_usage_line="usage: ctx run [--filter=NAME] [--stats] [--diagnose] [cmd [args...]]"

  MODULES_DIR="$dir/modules"
  FILTERS_DIR="$MODULES_DIR/run/filters"

  if [ ! -d "$FILTERS_DIR" ]; then
    if [ -d "./.contexture/modules/run/filters" ]; then
      FILTERS_DIR="./.contexture/modules/run/filters"
    fi
  fi

  # Sanctioned scratch: workspace .contexture/tmp when writable, else TMPDIR
  compact_tmpdir="${TMPDIR:-/tmp}"
  ctx_root_tmp="$root/.contexture/tmp"
  if [ -d "$root/.contexture" ] && mkdir -p "$ctx_root_tmp" 2>/dev/null && [ -d "$ctx_root_tmp" ] && [ -w "$ctx_root_tmp" ]; then
    compact_tmpdir="$ctx_root_tmp"
  fi

  diagnose_run() {
    printf 'ctx run: runner compaction diagnostics\n'
    printf '  workspace root:  %s\n' "$root"
    if [ -w "$compact_tmpdir" ]; then
      printf '  temp directory:  %s (writable)\n' "$compact_tmpdir"
    else
      printf '  temp directory:  %s (not writable)\n' "$compact_tmpdir"
    fi
    printf '  bypass config:   COMPACT_DISABLE=%s COMPACT_DEBUG=%s\n' "${COMPACT_DISABLE:-0}" "${COMPACT_DEBUG:-0}"
    printf '  builtin filters: %s\n' "$FILTERS_DIR"
    if [ -d "$FILTERS_DIR" ]; then
      bf=""
      for f in "$FILTERS_DIR"/*; do
        [ -f "$f" ] || continue
        name=$(basename "$f")
        name=${name%.awk}
        bf="$bf $name"
      done
      printf '    filters:%s\n' "$bf"
    else
      printf '    (none)\n'
    fi
    mf_count=0
    for bn in $(filter_module_names); do
      if [ -d "$MODULES_DIR/$bn/filters" ]; then
        wf=""
        for f in "$MODULES_DIR/$bn/filters"/*; do
          [ -f "$f" ] || continue
          name=$(basename "$f")
          name=${name%.awk}
          wf="$wf $name"
          mf_count=$((mf_count + 1))
        done
        printf '  module filters (%s):%s\n' "$bn" "$wf"
      fi
    done
    if [ "$mf_count" -eq 0 ]; then
      printf '  module filters:  (none)\n'
    fi
  }

  explicit_filter=""
  stats=0
  debug=0
  if [ "${COMPACT_DEBUG:-0}" = "1" ]; then
    debug=1
  fi

  # Emit the captured command stderr: whole on failure or empty stdout,
  # tail-capped with its own notice otherwise
  emit_stderr() {
    if [ -z "$stderr_input" ]; then
      return 0
    fi
    if [ "$cmd_status" -ne 0 ] || [ -z "$raw_input" ]; then
      printf "%s\n" "$stderr_input" >&2
      return 0
    fi
    stderr_lines=$(printf "%s\n" "$stderr_input" | wc -l | tr -d ' ')
    if [ "$stderr_lines" -le 10 ]; then
      printf "%s\n" "$stderr_input" >&2
    else
      printf "[ctx: stderr capped: showing the last 10 of %s lines; COMPACT_DISABLE=1 for the full stream]\n" "$stderr_lines" >&2
      printf "%s\n" "$stderr_input" | tail -n 10 >&2
    fi
  }

  # Read the first value of a filter header directive, trimmed of surrounding
  # whitespace so an invisible blank never silently disables it
  directive_value() {
    sed -n "s/^# $1: //p" "$2" | head -n 1 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
  }

  # Name-sorted module directories (LC_ALL=C) other than run, whose filters/
  # folders merge after the run module's own; whitespace names never form
  filter_module_names() {
    [ -d "$MODULES_DIR" ] || return 0
    load_session_verbs
    for fd in "$MODULES_DIR"/*/; do
      [ -d "$fd" ] || continue
      bn=${fd%/}
      bn=${bn##*/}
      case "$bn" in
        ""|.*|*[[:space:]]*|run|_hooks)
          continue
          ;;
      esac
      if is_reserved "$bn"; then
        continue
      fi
      printf '%s\n' "$bn"
    done | LC_ALL=C sort
    return 0
  }

  # The explicit --filter= name resolves over the run module first, then the
  # modules in name order: the same scan order as command and signature
  locate_filter() {
    if [ -d "$FILTERS_DIR" ]; then
      if [ -f "$FILTERS_DIR/$1.awk" ]; then
        printf '%s\n' "$FILTERS_DIR/$1.awk"
        return 0
      fi
      if [ -f "$FILTERS_DIR/$1" ]; then
        printf '%s\n' "$FILTERS_DIR/$1"
        return 0
      fi
    fi
    for bn in $(filter_module_names); do
      if [ -f "$MODULES_DIR/$bn/filters/$1.awk" ]; then
        printf '%s\n' "$MODULES_DIR/$bn/filters/$1.awk"
        return 0
      fi
      if [ -f "$MODULES_DIR/$bn/filters/$1" ]; then
        printf '%s\n' "$MODULES_DIR/$bn/filters/$1"
        return 0
      fi
    done
    return 1
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf '%s\n' "$run_usage_line"
        printf 'env: COMPACT_DISABLE=1 bypasses compaction; COMPACT_DEBUG=1 reports the selection\n'
        exit 0
        ;;
      --diagnose)
        diagnose_run
        exit 0
        ;;
      --stats)
        stats=1
        shift
        ;;
      --filter=*)
        explicit_filter="${1#--filter=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        printf '%s: unrecognized option: %s\n' "$run_label" "$1" >&2
        exit 1
        ;;
      *)
        break
        ;;
    esac
  done

  # Explicit bypass: raw execution, command exit code intact
  if [ "${COMPACT_DISABLE:-0}" = "1" ]; then
    if [ "$debug" -eq 1 ]; then
      printf "[ctx: debug: bypassed (COMPACT_DISABLE=1)]\n" >&2
    fi
    if [ $# -gt 0 ]; then
      rc=0
      "$@" || rc=$?
      exit "$rc"
    fi
    cat
    exit 0
  fi

  # Step 1: Ingest input (from command execution or standard input)
  cmd_status=0
  stderr_input=""
  stdout_tmp=""
  stderr_tmp=""



  cleanup() {
    if [ -n "$stdout_tmp" ]; then
      rm -f "$stdout_tmp"
    fi
    if [ -n "$stderr_tmp" ]; then
      rm -f "$stderr_tmp"
    fi
  }

  if [ $# -gt 0 ]; then
    # Command wrapper mode: stdout and stderr captured separately, exit code kept
    trap cleanup EXIT
    stdout_tmp=$(mktemp "$compact_tmpdir/compact-stdout.XXXXXX")
    stderr_tmp=$(mktemp "$compact_tmpdir/compact-stderr.XXXXXX")
    rc=0
    ( "$@" >"$stdout_tmp" 2>"$stderr_tmp" ) || rc=$?
    cmd_status=$rc
    raw_input=$(cat "$stdout_tmp")
    stderr_input=$(cat "$stderr_tmp")
    rm -f "$stdout_tmp" "$stderr_tmp"
    stdout_tmp=""
    stderr_tmp=""
  else
    # Stdin pipe mode
    raw_input=$(cat)
  fi

  # If both streams are empty, exit cleanly preserving command exit code
  if [ -z "$raw_input" ] && [ -z "$stderr_input" ]; then
    exit "$cmd_status"
  fi

  # Step 1b: Strip ANSI escape sequences before selection and filtering;
  # raw bytes stay untouched for the fail-safe comparison
  esc=$(printf '\033')
  clean_input="$raw_input"
  case "$raw_input" in
    *"$esc"*)
      clean_input=$(printf "%s\n" "$raw_input" | awk '{gsub(/\033\[[0-9;]*[a-zA-Z]/, ""); print}')
      ;;
  esac

  # Step 2: Discover and select filter
  selected_filter=""
  default_filter=""

  if [ -n "$explicit_filter" ]; then
    candidate=$(locate_filter "$explicit_filter") || candidate=""
    if [ -n "$candidate" ]; then
      selected_filter="$candidate"
    else
      printf '%s: filter not found: %s in %s\n' "$run_label" "$explicit_filter" "$FILTERS_DIR" >&2
      if [ -n "$raw_input" ]; then
        printf "%s\n" "$raw_input"
      fi
      emit_stderr
      exit "$cmd_status"
    fi
    if [ "$debug" -eq 1 ]; then
      printf "[ctx: debug: selected %s (explicit)]\n" "$(basename "$selected_filter")" >&2
    fi
  else
    # Runner mode selects by command identity first: the wrapped command line
    # is the signal, never the output sample
    if [ $# -gt 0 ]; then
      cmd_line=""
      cmd_first=1
      for arg in "$@"; do
        if [ "$cmd_first" -eq 1 ]; then
          arg=$(basename "$arg")
          cmd_first=0
        fi
        cmd_line="$cmd_line $arg"
      done
      cmd_line=${cmd_line# }

      if [ -d "$FILTERS_DIR" ]; then
        for f in "$FILTERS_DIR"/*.awk; do
          [ -f "$f" ] || continue
          pat=$(directive_value command "$f")
          [ -n "$pat" ] || continue
          if printf "%s\n" "$cmd_line" | COMPACT_PAT="$pat" awk '$0 ~ ENVIRON["COMPACT_PAT"] {found=1; exit} END{exit !found}' 2>/dev/null; then
            if [ -z "$selected_filter" ]; then
              selected_filter="$f"
              if [ "$debug" -eq 1 ]; then
                printf "[ctx: debug: selected %s (command match: %s)]\n" "$(basename "$f")" "$cmd_line" >&2
              fi
            else
              printf "[ctx: shadow warning: %s and %s both claim: %s]\n" "$(basename "$selected_filter")" "$(basename "$f")" "$cmd_line" >&2
            fi
          fi
        done
      fi

      # Module filters merge after the run module's own (name-sorted modules):
      # first match wins; a later module match warns as shadow unless its
      # header carries "# ctx-filter-priority: over", which replaces the
      # selection
      if [ -d "$MODULES_DIR" ]; then
        for bn in $(filter_module_names); do
          for f in "$MODULES_DIR/$bn/filters"/*.awk; do
            [ -f "$f" ] || continue
            pat=$(directive_value command "$f")
            [ -n "$pat" ] || continue
            if printf "%s\n" "$cmd_line" | COMPACT_PAT="$pat" awk '$0 ~ ENVIRON["COMPACT_PAT"] {found=1; exit} END{exit !found}' 2>/dev/null; then
              prio=$(directive_value ctx-filter-priority "$f")
              rel="$bn/$(basename "$f")"
              if [ "$prio" = "over" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (command match: %s, priority over)]\n" "$rel" "$cmd_line" >&2
                fi
              elif [ -z "$selected_filter" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (command match: %s)]\n" "$rel" "$cmd_line" >&2
                fi
              else
                printf "[ctx: shadow warning: %s and %s both claim: %s]\n" "$(basename "$selected_filter")" "$rel" "$cmd_line" >&2
              fi
            fi
          done
        done
      fi
    fi

    if [ -z "$selected_filter" ]; then
      # Zero-parameter auto-discovery: sample stream head and check signatures
      sample=$(printf "%s\n" "$clean_input" | sed 40q)

      if [ -d "$FILTERS_DIR" ]; then
        for f in "$FILTERS_DIR"/*.awk; do
          [ -f "$f" ] || continue
          pat=$(directive_value match "$f")
          if [ -n "$pat" ]; then
            if printf "%s\n" "$sample" | COMPACT_PAT="$pat" awk 'BEGIN{rc=1} $0 ~ ENVIRON["COMPACT_PAT"] {rc=0; exit} END{exit rc}' 2>/dev/null; then
              selected_filter="$f"
              if [ "$debug" -eq 1 ]; then
                printf "[ctx: debug: selected %s (signature match: %s)]\n" "$(basename "$f")" "$pat" >&2
                match_line=$(printf "%s\n" "$sample" | COMPACT_PAT="$pat" awk '$0 ~ ENVIRON["COMPACT_PAT"] {print; exit}' 2>/dev/null)
                if [ -n "$match_line" ]; then
                  printf "[ctx: debug: matched line: %s]\n" "$match_line" >&2
                fi
              fi
              break
            fi
          elif grep -q '^# default' "$f" 2>/dev/null; then
            default_filter="$f"
          fi
        done
      fi

      # Module signature merge after the run module's own: same first-match,
      # shadow, and priority rules as the command loop
      if [ -d "$MODULES_DIR" ]; then
        for bn in $(filter_module_names); do
          for f in "$MODULES_DIR/$bn/filters"/*.awk; do
            [ -f "$f" ] || continue
            pat=$(directive_value match "$f")
            [ -n "$pat" ] || continue
            if printf "%s\n" "$sample" | COMPACT_PAT="$pat" awk 'BEGIN{rc=1} $0 ~ ENVIRON["COMPACT_PAT"] {rc=0; exit} END{exit rc}' 2>/dev/null; then
              prio=$(directive_value ctx-filter-priority "$f")
              rel="$bn/$(basename "$f")"
              if [ "$prio" = "over" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (signature match: %s, priority over)]\n" "$rel" "$pat" >&2
                fi
              elif [ -z "$selected_filter" ]; then
                selected_filter="$f"
                if [ "$debug" -eq 1 ]; then
                  printf "[ctx: debug: selected %s (signature match: %s)]\n" "$rel" "$pat" >&2
                fi
              else
                printf "[ctx: shadow warning: %s and %s both claim: %s]\n" "$(basename "$selected_filter")" "$rel" "$pat" >&2
              fi
            fi
          done
        done
      fi

      if [ -z "$selected_filter" ]; then
        selected_filter="$default_filter"
        if [ "$debug" -eq 1 ] && [ -n "$selected_filter" ]; then
          printf "[ctx: debug: selected %s (default)]\n" "$(basename "$selected_filter")" >&2
        fi
      fi

      # Module default fallback: fills an empty selection only; defaults
      # never shadow a match, so priority does not apply here
      if [ -z "$selected_filter" ] && [ -d "$MODULES_DIR" ]; then
        for bn in $(filter_module_names); do
          for f in "$MODULES_DIR/$bn/filters"/*.awk; do
            [ -f "$f" ] || continue
            if grep -q '^# default' "$f" 2>/dev/null; then
              selected_filter="$f"
              if [ "$debug" -eq 1 ]; then
                printf "[ctx: debug: selected %s (module default)]\n" "$bn/$(basename "$f")" >&2
              fi
              break 2
            fi
          done
        done
      fi
    fi
  fi

  # Merge stderr for filters that declare it (compiler-style tools)
  stream_mode=""
  if [ -n "$selected_filter" ] && [ -f "$selected_filter" ]; then
    stream_mode=$(directive_value stream "$selected_filter")
  fi
  if [ "$stream_mode" = "merged" ] && [ -n "$stderr_input" ]; then
    if [ -n "$raw_input" ]; then
      raw_input=$(printf "%s\n%s" "$raw_input" "$stderr_input")
    else
      raw_input="$stderr_input"
    fi
    stderr_input=""
    clean_input="$raw_input"
    case "$raw_input" in
      *"$esc"*)
        clean_input=$(printf "%s\n" "$raw_input" | awk '{gsub(/\033\[[0-9;]*[a-zA-Z]/, ""); print}')
        ;;
    esac
  fi

  # If still no filter found, fallback to raw input
  if [ -z "$selected_filter" ] || [ ! -f "$selected_filter" ]; then
    if [ -n "$raw_input" ]; then
      printf "%s\n" "$raw_input"
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Empty stdout with no merged filter: stderr is the whole output
  if [ -z "$raw_input" ]; then
    emit_stderr
    exit "$cmd_status"
  fi

  # Step 3: Execute filter and apply fail-safe and recovery guards
  filtered_output=$(printf "%s\n" "$clean_input" | awk -v COMPACT_EXIT="$cmd_status" -f "$selected_filter" 2>/dev/null) || true

  raw_bytes=$(printf "%s\n" "$raw_input" | wc -c | tr -d ' ')
  clean_bytes=$(printf "%s\n" "$clean_input" | wc -c | tr -d ' ')
  out_bytes=$(printf "%s\n" "$filtered_output" | wc -c | tr -d ' ')
  filter_name=$(basename "$selected_filter")

  # A notice is a marker line: an elision, collapse, or recovery pointer; the
  # marker vocabulary keeps bracketed data lines from reading as notices
  notice_state=$(printf "%s\n" "$filtered_output" | awk '
    /^[ \t]*\.\.\. \(/ { notice = 1; next }
    /^[ \t]*\[[^]]*(collapsed|elided|repeated|capped|COMPACT_DISABLE)[^]]*\]/ { notice = 1; next }
    /^[ \t]*$/ { next }
    { other = 1 }
    END { printf "%d %d\n", notice + 0, (other ? 0 : 1) }
  ')
  has_notice=${notice_state% *}
  notice_only=${notice_state#* }

  # A format-only filter declares that its marker-less reductions are layout,
  # never lost content
  format_only=""
  if [ -f "$selected_filter" ]; then
    format_only=$(directive_value format-only "$selected_filter")
  fi

  # Universal fail-safe: pass raw input if the filter produced empty output
  if [ -z "$filtered_output" ]; then
    printf "%s\n" "$raw_input"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (fail-safe passthrough: %d bytes)]\n" "$filter_name" "$raw_bytes" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Notice-only output: the filter is signaling (a false-green guard, for
  # example); pass it through, never revert the signal to raw
  if [ "$notice_only" -eq 1 ]; then
    printf "%s\n" "$filtered_output"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (notice-only output passed through)]\n" "$filter_name" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Byte fail-safe: pass raw input if the filter grew the stream
  if [ "$out_bytes" -gt "$raw_bytes" ]; then
    printf "%s\n" "$raw_input"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (fail-safe passthrough: %d bytes)]\n" "$filter_name" "$raw_bytes" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  # Recovery: a shrinking filter without a notice either truncated silently or
  # only reformatted; format-only filters declare that, everything else goes raw
  if [ "$out_bytes" -lt "$clean_bytes" ] && [ "$has_notice" -eq 0 ] && [ -z "$format_only" ]; then
    printf "%s\n" "$raw_input"
    if [ "$stats" -eq 1 ]; then
      printf "[ctx: %s (recovery fallback: %d -> %d bytes, no notice)]\n" "$filter_name" "$clean_bytes" "$out_bytes" >&2
    fi
    emit_stderr
    exit "$cmd_status"
  fi

  printf "%s\n" "$filtered_output"

  if [ "$stats" -eq 1 ]; then
    pct=0
    if [ "$raw_bytes" -gt 0 ]; then
      pct=$(( (raw_bytes - out_bytes) * 100 / raw_bytes ))
    fi
    printf "[ctx: %s, %d -> %d bytes (%d%% reduction)]\n" "$filter_name" "$raw_bytes" "$out_bytes" "$pct" >&2
  fi

  emit_stderr
  exit "$cmd_status"
}

# ---------------------------------------------------------------------------
# internal hook engine: ctx _hooks <point> [<ENVNAME> <value>]...
# Hidden and unlisted. Hook files under modules/*/hooks/ declare
# "# ctx-hook: <point>" and optionally "# ctx-hook-mode: block"; discovery
# runs in module-name order (LC_ALL=C) then file-name order. CWD is the
# workspace root; each hook gets CTX_HOOK_POINT and the passed context
# exported. Default mode warns on a non-zero hook and continues (point rc
# unaffected); block mode stops the point at the first failing hook and
# fails rc=1. Zero hooks for the point = silent rc=0.
run_hooks() {
  if [ $# -lt 1 ]; then
    ctx_err "_hooks: missing point"
    exit 1
  fi
  point=$1
  shift
  while [ $# -gt 0 ]; do
    name=$1
    if [ $# -lt 2 ]; then
      ctx_err "_hooks: context name without value: $name"
      exit 1
    fi
    case "$name" in
      [A-Za-z_]*)
        case "$name" in
          *[!A-Za-z0-9_]*)
            ctx_err "_hooks: malformed context name: $name"
            exit 1
            ;;
        esac
        ;;
      *)
        ctx_err "_hooks: malformed context name: $name"
        exit 1
        ;;
    esac
    export "$name=$2"
    shift 2
  done
  CTX_HOOK_POINT=$point
  export CTX_HOOK_POINT

  if ! cd "$root"; then
    ctx_err "cannot enter workspace root: $root"
    exit 1
  fi

  for n in $(scan_module_dirs); do
    [ -n "$n" ] || continue
    hd="$modules_root/$n/hooks"
    [ -d "$hd" ] || continue
    for h in $(hook_files "$hd"); do
      [ -n "$h" ] || continue
      hp=$(header_field "$h" ctx-hook)
      [ -n "$hp" ] || continue
      if [ "$hp" != "$point" ]; then
        continue
      fi
      hmode=$(header_field "$h" ctx-hook-mode)
      hrc=0
      if [ -x "$h" ]; then
        "$h" || hrc=$?
      else
        sh "$h" || hrc=$?
      fi
      if [ "$hrc" -ne 0 ]; then
        if [ "$hmode" = "block" ]; then
          ctx_err "hook blocked the point at $point: $n: ${h##*/} (rc=$hrc)"
          exit 1
        fi
        ctx_err "hook failed at $point: $n: ${h##*/} (rc=$hrc); continuing"
      fi
    done
  done
  return 0
}

hook_files() {
  # hook files of one module, file-name sorted (LC_ALL=C); hidden and
  # whitespace names never form
  hd=$1
  for h in "$hd"/*; do
    [ -f "$h" ] || continue
    b=${h##*/}
    case "$b" in
      ""|.*|*[[:space:]]*)
        continue
        ;;
    esac
    printf '%s\n' "$h"
  done | LC_ALL=C sort
}

# ---------------------------------------------------------------------------
# top-level dispatch

if [ $# -eq 0 ]; then
  show_top_help
  exit 0
fi

case "$1" in
  --help|-h)
    if [ $# -ne 1 ]; then
      ctx_err "unknown command: $1"
      exit 1
    fi
    show_top_help
    exit 0
    ;;
  help)
    shift
    if [ $# -eq 0 ]; then
      show_top_help
      exit 0
    fi
    if [ $# -eq 1 ] && [ "$1" = "--all" ]; then
      show_top_help
      if ! show_module_help_blocks; then
        exit 1
      fi
      exit 0
    fi
    ctx_err "help accepts only --all as an extra argument"
    exit 1
    ;;
  run)
    shift
    run_body "$@"
    ;;
  _hooks)
    shift
    run_hooks "$@"
    exit 0
    ;;
esac

target=$1
shift

# discovery warnings (reserved, broken shapes) surface on every dispatch attempt
mods=$(module_names)

# ctx adopts the workspace root before dispatch (the engine contract)
if ! cd "$root"; then
  ctx_err "cannot enter workspace root: $root"
  exit 1
fi

found_target=""
while IFS= read -r n; do
  [ -n "$n" ] || continue
  if [ "$n" = "$target" ]; then
    found_target=$n
    break
  fi
done <<EOF
$mods
EOF

if [ -z "$found_target" ]; then
  ctx_err "unknown command: $target"
  exit 1
fi

md="$modules_root/$found_target"

# bare ctx <module> prints the module help rc0
if [ $# -eq 0 ]; then
  show_module_help "$found_target"
  exit 0
fi

case "$1" in
  help|--help|-h)
    shift
    if [ $# -eq 0 ]; then
      show_module_help "$found_target"
      exit 0
    fi
    if [ $# -eq 1 ] && verb_exists "$md" "$1"; then
      show_verb_help "$found_target" "$1"
      exit 0
    fi
    ctx_err "unknown verb: $1"
    show_module_help "$found_target" >&2
    exit 1
    ;;
  --diagnose)
    shift
    if verb_exists "$md" "diagnose"; then
      CTX_ROOT="$root"
      CTX_MODULE_DIR="$md"
      CTX_BIN="$ctx_bin"
      export CTX_ROOT CTX_MODULE_DIR CTX_BIN
      LC_ALL=C
      export LC_ALL
      exec "$md/scripts/diagnose" "$@"
    fi
    ctx_err "$found_target does not support --diagnose"
    exit 1
    ;;
esac

verb=$1
if ! verb_exists "$md" "$verb"; then
  ctx_err "unknown verb: $verb"
  show_module_help "$found_target" >&2
  exit 1
fi
shift

# --help and -h after an awk verb print the verb's help table (the table ctx <module>
# help <verb> prints): an awk interpreter reads a leading dash argument as its own option,
# so the verb itself would never see it; shell verbs answer their own --help
case "${1:-}" in
  --help|-h)
    if [ $# -eq 1 ] && head -n 1 "$md/scripts/$verb" | grep -q '^#!.*awk'; then
      show_verb_help "$found_target" "$verb"
      exit 0
    fi
    ;;
esac

CTX_ROOT="$root"
CTX_MODULE_DIR="$md"
CTX_BIN="$ctx_bin"
export CTX_ROOT CTX_MODULE_DIR CTX_BIN
LC_ALL=C
export LC_ALL
exec "$md/scripts/$verb" "$@"
