#!/bin/sh
# summary: create a subagent lane from its brief parameters
# usage: ctx lane create <unit> <lane-slug> --goal="..." --branch="..." --writes="..." --scope="..."... --report="..."... [--ref=...]... [--task=backlog#<slug>]... [--decision=journal#<slug>]... [--rhythm="<name> <N> <GATE>"] [--fact="..."]... [--substrate="..."]
# help: the dispatcher's act: the verb composes the lane's recipe from the brief parameters, stores it with an empty lane journal (lane.create), and prints the dispatch prompt; each flag takes --name=value or --name value
# help: options:
# help:   --goal="..."         required: the deliverable or decision the lane feeds, and where it stops; the one aim every step serves
# help:   --branch="..."       required: the checkout or worktree and its branch, at a commit; where the subagent reads, edits, and commits
# help:   --writes="..."       required: read only, or the roots it edits and how it commits; the write scope, so an edit outside it is drift
# help:   --scope="..."        required, repeatable: a step or question with its exit condition, in order; the verb numbers the steps, so a value carries no number
# help:   --report="..."       required, repeatable: a section the report owes, its name and what it carries; the dispatcher reads only the report
# help:   --ref=...            repeatable: a pointer the subagent reads at boot, <target>#<symbol> or a whole target path holding a / and ending in a name; the brief slices context, never dumps it
# help:   --task=backlog#<slug>   repeatable: a backlog task the lane works; its specification stands in the task
# help:   --decision=journal#<slug>   repeatable: a journal entry holding a decision the lane honors
# help:   --rhythm="<name> <N> <GATE>"   the process in force, checked by the rule ctx unit record checks a rhythm by
# help:   --fact="..."         repeatable: one isolated constraint from the dispatcher's context, kept one per line
# help:   --substrate="..."    where code, tests, and commits land, and what stays untouched (a worktree lane)
# help: stdin is never read: the brief comes only as flags, and the verb writes the fixed blocks itself (the boundary, the boot, the journal, and the report), so no dispatcher forgets them
# help: every value is one line of valid UTF-8 (a newline, a carriage return, or another byte refuses naming the flag); an empty value counts as missing; a flag that is not repeatable given twice refuses; a missing required flag refuses naming each with its purpose; a refusal writes nothing
# help: an existing lane refuses rc 1 (ERR_ENTITY_EXISTS) with its recipe unchanged; a CLOSED unit refuses rc 1; no task, entry, or ref is looked up
# help: example: ctx lane create my-unit gather-cache --goal="map the cache callers for the cache task; stop at the report" --branch="the workspace checkout on main at abc1234" --writes="read only" --scope="list every caller of the cache; done when each names its file and symbol" --report="CALLERS: each caller with its file and symbol"
# help: the dispatch prompt it prints, its three lines quoted (a re-dispatch fills <unit> and <lane>): "You are a dispatched subagent working lane <lane> of unit <unit>. Your full brief is the lane recipe: read it first and follow it exactly: .contexture/ctx lane show <unit> <lane> recipe" "Hard rules: never use /tmp or any path outside the workspace; scratch only under .contexture/tmp/<lane>/; a harness permission prompt for a path outside the workspace is the signal to stop and report, never an ask to reach. Every shell command runs through .contexture/ctx run; never leave a background process running when you finish; a command that hangs is stopped, never abandoned. The record only through ctx: your record writes are your lane journal and your report, plus only what the recipe's write scope adds." "Return a short summary only; the report carries the substance."

unit_lib="${CTX_ROOT:-.}/.contexture/modules/unit/lib/verb.sh"
[ -f "$unit_lib" ] || unit_lib="${CTX_ROOT:-.}/base/.contexture/modules/unit/lib/verb.sh"
VB_SELF="$unit_lib"
. "$unit_lib"
# the brief comes only as flags: no command below reads the caller's stdin
exec < /dev/null

fail() {
  printf 'lane create: error: %s (ERR_INVALID_ARGUMENT)\n' "$1" >&2
  exit 1
}

case "${1:-}" in
  --help|-h|help) [ $# -eq 1 ] && { vb_verb_help lane "$0"; exit 0; } ;;
esac
case "${3:-}" in
  --help|-h|help) [ $# -eq 3 ] && { vb_verb_help lane "$0"; exit 0; } ;;
esac
if [ $# -lt 2 ]; then
  printf 'usage: ctx lane create <unit> <lane-slug> --goal=... --branch=... --writes=... --scope=... --report=... [optional flags] (ctx lane help create)\n' >&2
  exit 1
fi
unit=$1
lane=$2
shift 2
vb_unit "lane create" "$unit"
vb_lane "lane create" "$lane"

for f in goal branch writes rhythm substrate scope report ref task decision fact; do
  eval "n_$f=0; v_$f="
done
nval=0
keep() { nval=$((nval + 1)); eval "VALF_$nval=\$1; VAL_$nval=\$2"; }
once() {
  [ -n "$2" ] || return 0
  eval "o_n=\$n_$1"
  [ "$o_n" -eq 0 ] || fail "--$1 given twice; it takes one value"
  eval "n_$1=1; v_$1=\$2"
  keep "$1" "$2"
}
many() {
  [ -n "$2" ] || return 0
  eval "m_n=\$((n_$1 + 1))"
  eval "n_$1=\$m_n; v_$1_$m_n=\$2"
  keep "$1" "$2"
}
need() { [ $# -ge 2 ] || fail "$1 needs a value"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --goal=*|--branch=*|--writes=*|--rhythm=*|--substrate=*) f=${1%%=*}; once "${f#--}" "${1#*=}" ;;
    --goal|--branch|--writes|--rhythm|--substrate) need "$@"; f=${1#--}; shift; once "$f" "$1" ;;
    --scope=*|--report=*|--ref=*|--task=*|--decision=*|--fact=*) f=${1%%=*}; many "${f#--}" "${1#*=}" ;;
    --scope|--report|--ref|--task|--decision|--fact) need "$@"; f=${1#--}; shift; many "$f" "$1" ;;
    *) vb_unknown "lane create" "$1" ;;
  esac
  shift
done

missing=""
for f in goal branch writes scope report; do
  eval "c=\$n_$f"
  [ "$c" -eq 0 ] || continue
  case $f in
    goal) p="the deliverable or decision the lane feeds, and where it stops" ;;
    branch) p="the checkout or worktree and its branch, at a commit" ;;
    writes) p="read only, or the roots it edits and how it commits" ;;
    scope) p="a step or question with its exit condition" ;;
    report) p="a section the report owes: its name and what it carries" ;;
  esac
  missing="${missing:+$missing, }--$f ($p)"
done
[ -z "$missing" ] || fail "missing $missing; the brief comes only as flags, stdin is never read: ctx lane help create"

i=0
while [ "$i" -lt "$nval" ]; do
  i=$((i + 1))
  eval "f=\$VALF_$i; v=\$VAL_$i"
  vb_has_cr "$v" && fail "--$f holds a carriage return; the dialect is LF"
  vb_has_nl "$v" && fail "--$f holds a newline; each value is one line"
  VB_V="$v" LC_ALL=C awk "$VB_UTF8_AWK"'BEGIN { if (!utf8_ok(ENVIRON["VB_V"])) exit 3 }'
  case $? in
    0) ;;
    3) fail "$f is not valid UTF-8" ;;
    *) printf 'lane create: error: cannot check the value of --%s\n' "$f" >&2; exit 2 ;;
  esac
done

i=0
while [ "$i" -lt "$n_ref" ]; do
  i=$((i + 1))
  eval "v=\$v_ref_$i"
  vb_ref_ok "lane create" "$v"
done
i=0
while [ "$i" -lt "$n_task" ]; do
  i=$((i + 1))
  eval "v=\$v_task_$i"
  case "$v" in backlog#*) vb_slug_ok "${v#backlog#}" && continue ;; esac
  fail "malformed task '$v': a task is backlog#<slug>"
done
i=0
while [ "$i" -lt "$n_decision" ]; do
  i=$((i + 1))
  eval "v=\$v_decision_$i"
  case "$v" in journal#*) vb_slug_ok "${v#journal#}" && continue ;; esac
  fail "malformed decision '$v': a decision is journal#<slug>"
done
if [ -n "$v_rhythm" ]; then
  vb_rhythm_ok "$v_rhythm"
fi

fill() {
  sed -e "s|@UNIT@|$unit|g" -e "s|@LANE@|$lane|g"
}
joined() {
  j_out=""
  j_i=0
  eval "j_n=\$n_$1"
  while [ "$j_i" -lt "$j_n" ]; do
    j_i=$((j_i + 1))
    eval "j_v=\$v_$1_$j_i"
    j_out="${j_out:+$j_out, }$j_v"
  done
  printf '%s' "$j_out"
}
lines() {
  l_i=0
  eval "l_n=\$n_$1"
  while [ "$l_i" -lt "$l_n" ]; do
    l_i=$((l_i + 1))
    eval "l_v=\$v_$1_$l_i"
    if [ "$2" = numbered ]; then printf '  %s. %s\n' "$l_i" "$l_v"; else printf '  %s\n' "$l_v"; fi
  done
}

vb_tmp
{
  printf '@recipe %s\n  UNIT: %s\n  LANE: %s\n  BRANCH: %s\n' "$lane" "$unit" "$lane" "$v_branch"
  if [ -n "$v_rhythm" ]; then printf '  RHYTHM: %s\n' "$v_rhythm"; fi
  if [ "$n_task" -gt 0 ]; then printf '  TASKS: %s\n' "$(joined task)"; fi
  if [ "$n_decision" -gt 0 ]; then printf '  DECISIONS: %s\n' "$(joined decision)"; fi
  printf '\nGOAL ::\n  %s\n' "$v_goal"
  if [ "$n_ref" -gt 0 ]; then printf '\nREFS ::\n'; lines ref; fi
  printf '\nSCOPE ::\n'
  lines scope numbered
  if [ "$n_fact" -gt 0 ]; then printf '\nFACTS ::\n'; lines fact; fi
  if [ -n "$v_substrate" ]; then printf '\nSUBSTRATE ::\n  %s\n' "$v_substrate"; fi
  printf '\n'
  fill <<'EOF'
BOUNDARY (hard rules) ::
  1. never use /tmp or any path outside the workspace; scratch only under .contexture/tmp/@LANE@/; a harness permission prompt for a path outside the workspace is the signal to stop and report, never an ask to reach
  2. every shell command runs through the runner: .contexture/ctx run <cmd>, or piped through it; never leave a background process running when you finish; a command that hangs is stopped, never abandoned
  3. the record only through ctx: your record writes are your lane journal (ctx lane record @UNIT@ @LANE@) and your report (ctx lane report @UNIT@ @LANE@), plus only what the write scope adds
EOF
  printf '  4. write scope: %s\n' "$v_writes"
  fill <<'EOF'
  5. a decision within this recipe is yours: decide it and journal it; a wall or a decision beyond it is drift: stop and report, never improvise past it

BOOT (read only, before any work) ::
  the loader's law layer and both overlays (AGENTS.md, AGENTS.workspace.md, AGENTS.local.md); ctx unit load @UNIT@ until a page reads complete; this recipe (ctx lane show @UNIT@ @LANE@ recipe); every REF it names. Your first lane journal entry is the load receipt: the refs loaded ride as --ref lines on that entry, never one per line inside the WHAT; an unresolved REF is a brief defect: stop and report it.

JOURNAL ::
  ctx lane record @UNIT@ @LANE@ at action granularity as things happen: every command whose result is not obvious, every claim, decision point, and drift notice; each WHAT carries the action, its result, and why the next step follows; an entry awaiting an act outside the lane carries --thread.

REPORT (ctx lane report @UNIT@ @LANE@, the body on stdin; self-sufficient: the dispatcher reads only the report) ::
  @report @LANE@
  VERDICT: done, partial, or drifted, with one line why
EOF
  lines report
  printf '  The report and the journal land no matter the outcome; return a short summary only.\n'
} > "$VB_DIR/doc" || { printf 'lane create: error: cannot stage the recipe\n' >&2; exit 2; }

vb_call_doc "$VB_DIR/doc" lane.create "$unit" "$lane"
vb_ok
printf 'lane created: %s in %s\n\n' "$lane" "$unit"
printf "dispatch prompt (the subagent's launch message; never stored):\n"
fill <<'EOF'
You are a dispatched subagent working lane @LANE@ of unit @UNIT@. Your full brief is the lane recipe: read it first and follow it exactly: .contexture/ctx lane show @UNIT@ @LANE@ recipe
Hard rules: never use /tmp or any path outside the workspace; scratch only under .contexture/tmp/@LANE@/; a harness permission prompt for a path outside the workspace is the signal to stop and report, never an ask to reach. Every shell command runs through .contexture/ctx run; never leave a background process running when you finish; a command that hangs is stopped, never abandoned. The record only through ctx: your record writes are your lane journal and your report, plus only what the recipe's write scope adds.
Return a short summary only; the report carries the substance.
EOF
