#!/bin/sh
# summary: search the ideas, one row per matching idea
# usage: ctx ideas search "<query>" [--type=idea] [--mode=<m>] [--limit=<n>] [--json]
# help: the shared search syntax: a case-insensitive substring of one line of an idea, every status searched; each row is type idea with its address ideas#<id> and its read ctx ideas get <id>
# help: --limit is a positive whole number, default 20, and the total counts every match before it; --mode defaults to exact, the one mode the module answers; --json answers {query, mode, total, rows}, each row {module, container, type, id, address, snippet, read}
# help: zero hits is an answer, rc 0 total 0; a type other than idea, a mode the module cannot answer, or an unknown flag refuses rc 1 (ERR_INVALID_ARGUMENT) on a direct call, while under ctx search the type answers zero hits and the mode falls back to exact
# help: example: ctx ideas search "driver"
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$dir/ideas" search "$@"
